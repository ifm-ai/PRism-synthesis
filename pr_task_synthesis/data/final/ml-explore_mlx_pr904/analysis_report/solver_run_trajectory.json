              "command": "export LD_LIBRARY_PATH=/workspace/python/mlx/lib:$LD_LIBRARY_PATH && python3 -c \"\nimport sys\nsys.path.insert(0, '/workspace/python')\nimport mlx.core as mx\nimport math\n\n# float16 max is about 65504\n# For a normal distribution, values beyond ~8 sigma are extremely rare\n# (probability < 1e-15)\n# So we can safely clip to something like 8 * sqrt(2) * erfinv_max\n\n# The issue is that erfinv can produce very large values when input is close to ±1\n# We need to clip the final output to prevent overflow\n\n# For float16, max is 65504\n# For bfloat16, max is about 3.4e38\n\n# A safe approach: clip the erfinv input to avoid extreme outputs\n# erf(6) is extremely close to 1, so erfinv values beyond ~6 are very rare\n\n# Actually, let's think about this differently:\n# normal = sqrt(2) * erfinv(x) where x is in (-1, 1)\n# For float16, we need |normal| < 65504\n# So |erfinv(x)| < 65504 / sqrt(2) ≈ 46319\n\n# The safest approach is to clip the final result to the max representable value\n# minus some margin\n\nfloat16_max = 65504.0\nbfloat16_max = 3.3895313892515355e+38  # approximate\n\nprint('float16 max:', float16_max)\nprint('bfloat16 max:', bfloat16_max)\nprint('float16 max / sqrt(2):', float16_max / math.sqrt(2))\nprint('bfloat16 max / sqrt(2):', bfloat16_max / math.sqrt(2))\n\n# Alternative: use a sigma-based clip\n# P(|X| > 8) for standard normal is about 1e-15\n# So for 10000 samples, we'd expect essentially no values beyond 8 sigma\nprint()\nprint('8 sigma for std normal:', 8)\nprint('10 sigma for std normal:', 10)\n\"\n",
