              "file": "bpfman-api/src/bin/rpc/main.rs",
              "patch": "Index: bpfman-api/src/bin/rpc/main.rs\n===================================================================\n--- bpfman-api/src/bin/rpc/main.rs\t\n+++ bpfman-api/src/bin/rpc/main.rs\t\n@@ -1,47 +1,88 @@\n // SPDX-License-Identifier: Apache-2.0\n // Copyright Authors of bpfman\n-use std::path::PathBuf;\n+use std::{env, path::PathBuf, str::FromStr};\n \n use clap::{Args, Parser};\n+use log::debug;\n+use systemd_journal_logger::{connected_to_journal, JournalLog};\n \n use crate::serve::serve;\n \n mod rpc;\n mod serve;\n mod storage;\n \n #[derive(Parser, Debug)]\n #[command(long_about = \"A rpc server proxy for the bpfman library\")]\n #[command(name = \"bpfman-rpc\")]\n pub(crate) struct Rpc {\n     /// Optional: Enable CSI support. Only supported when run in a Kubernetes\n     /// environment with bpfman-agent.\n     #[clap(long, verbatim_doc_comment)]\n     pub(crate) csi_support: bool,\n     /// Optional: Shutdown after N seconds of inactivity. Use 0 to disable.\n     #[clap(long, verbatim_doc_comment, default_value = \"15\")]\n     pub(crate) timeout: u64,\n     #[clap(long, default_value = \"/run/bpfman-sock/bpfman.sock\")]\n     /// Optional: Configure the location of the bpfman unix socket.\n     pub(crate) socket_path: PathBuf,\n }\n \n #[derive(Args, Debug)]\n #[command(disable_version_flag = true)]\n pub(crate) struct ServiceArgs {\n     /// Optional: Shutdown after N seconds of inactivity. Use 0 to disable.\n     #[clap(long, verbatim_doc_comment, default_value = \"15\")]\n     pub(crate) timeout: u64,\n     #[clap(long, default_value = \"/run/bpfman-sock/bpfman.sock\")]\n     /// Optional: Configure the location of the bpfman unix socket.\n     pub(crate) socket_path: PathBuf,\n }\n \n+fn init_logging() {\n+    if connected_to_journal() {\n+        match JournalLog::new() {\n+            Ok(logger) => {\n+                if let Err(e) = logger\n+                    .with_extra_fields(vec![(\"BINARY\", \"bpfman-rpc\")])\n+                    .install()\n+                {\n+                    eprintln!(\"Failed to initialize journald logger: {}\", e);\n+                } else {\n+                    debug!(\"Log using journald\");\n+                }\n+            }\n+            Err(e) => {\n+                eprintln!(\"Failed to create journald logger: {}\", e);\n+            }\n+        }\n+        manage_journal_log_level();\n+    } else {\n+        if let Err(e) = env_logger::try_init() {\n+            eprintln!(\"Failed to initialize env_logger: {}\", e);\n+        } else {\n+            debug!(\"Log using env_logger\");\n+        }\n+    }\n+}\n+\n+fn manage_journal_log_level() {\n+    log::set_max_level(log::LevelFilter::Error);\n+    if let Ok(rust_log) = env::var(\"RUST_LOG\") {\n+        match log::LevelFilter::from_str(&rust_log) {\n+            Ok(value) => log::set_max_level(value),\n+            Err(e) => eprintln!(\"Invalid RUST_LOG value: {}\", e),\n+        }\n+    }\n+}\n+\n #[tokio::main]\n async fn main() -> anyhow::Result<()> {\n+    init_logging();\n+    \n     let args = Rpc::parse();\n     //TODO https://github.com/bpfman/bpfman/issues/881\n     serve(args.csi_support, args.timeout, &args.socket_path).await?;\n \n     Ok(())\n }\n",
              "additions": 42,
              "deletions": 1,
              "status": "modified"
            },
