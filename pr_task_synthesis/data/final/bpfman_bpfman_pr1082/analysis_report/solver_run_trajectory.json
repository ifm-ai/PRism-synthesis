y will be manually created in the case where bpfman\n58:     // is not being run as a service.\n59:     //\n60:     // ConfigurationDirectory: /etc/bpfman/\n61:     pub(crate) const CFGDIR_MODE: u32 = 0o6750;\n62:     pub(crate) const CFGDIR: &str = \"/etc/bpfman\";\n63:     pub(crate) const CFGDIR_STATIC_PROGRAMS: &str = \"/etc/bpfman/programs.d\";\n64:     pub(crate) const CFGPATH_BPFMAN_CONFIG: &str = \"/etc/bpfman/bpfman.toml\";\n65: \n66:     // RuntimeDirectory: /run/bpfman/\n67:     pub(crate) const RTDIR_MODE: u32 = 0o6770;\n68:     pub(crate) const RTDIR: &str = \"/run/bpfman\";\n69:     pub(crate) const RTDIR_XDP_DISPATCHER: &str = \"/run/bpfman/dispatchers/xdp\";\n70:     pub(crate) const RTDIR_TC_INGRESS_DISPATCHER: &str = \"/run/bpfman/dispatchers/tc-ingress\";\n71:     pub(crate) const RTDIR_TC_EGRESS_DISPATCHER: &str = \"/run/bpfman/dispatchers/tc-egress\";\n72:     pub(crate) const RTDIR_FS: &str = \"/run/bpfman/fs\";\n73:     pub(crate) const RTDIR_FS_TC_INGRESS: &str = \"/run/bpfman/fs/tc-ingress\";\n74:     pub(crate) const RTDIR_FS_TC_EGRESS: &str = \"/run/bpfman/fs/tc-egress\";\n75:     pub(crate) const RTDIR_FS_XDP: &str = \"/run/bpfman/fs/xdp\";\n76:     pub(crate) const RTDIR_FS_MAPS: &str = \"/run/bpfman/fs/maps\";\n77:     pub(crate) const RTDIR_PROGRAMS: &str = \"/run/bpfman/programs\";\n78:     // The TUF repository is used to store Rekor and Fulcio public keys.\n79:     pub(crate) const RTDIR_TUF: &str = \"/run/bpfman/tuf\";\n80:     // StateDirectory: /var/lib/bpfman/\n81:     pub(crate) const STDIR_MODE: u32 = 0o6770;\n82:     pub(crate) const STDIR: &str = \"/var/lib/bpfman\";\n83:     #[cfg(not(test))]\n84:     pub(crate) const STDIR_DB: &str = \"/var/lib/bpfman/db\";\n85: }\n86: \n87: #[cfg(not(test))]\n88: pub(crate) fn get_db_config() -> SledConfig {\n89:     SledConfig::default().path(STDIR_DB)\n90: }\n91: \n92: #[cfg(test)]\n93: pub(crate) fn get_db_config() -> SledConfig {\n94:     SledConfig::default().temporary(true)\n95: }\n96: \n97: /// Loads an ebpf program.\n98: pub async fn add_program(mut program: Program) -> Result<Program, BpfmanError> {\n99:     let (config, root_db) = &setup().await?;\n100:     let mut image_manager = init_image_manager().await;\n101:     // This is only required in the add_program api\n102:     program.get_data_mut().load(root_db)?;\n103: \n104:     let map_owner_id = program.get_data().get_map_owner_id()?;\n105:     // Set map_pin_path if we're using another program's maps\n106:     if let Some(map_owner_id) = map_owner_id {\n107:         let map_pin_path = is_map_owner_id_valid(root_db, map_owner_id)?;\n108:         program.get_data_mut().set_map_pin_path(&map_pin_path)?;\n109:     }\n110: \n111:     program\n112:         .get_data_mut()\n113:         .set_program_bytes(root_db, &mut image_manager)\n114:         .await?;\n115: \n116:     let result = match program {\n117:         Program::Xdp(_) | Program::Tc(_) => {\n118:             program.set_if_index(get_ifindex(&program.if_name().unwrap())?)?;\n119: \n120:             add_multi_attach_program(root_db, &mut program, &mut image_manager, config).await\n121:         }\n122:         Program::Tracepoint(_)\n123:         | Program::Kprobe(_)\n124:         | Program::Uprobe(_)\n125:         | Program::Fentry(_)\n126:         | Program::Fexit(_) => add_single_attach_program(root_db, &mut program),\n127:         Program::Unsupported(_) => panic!(\"Cannot add unsupported program\"),\n128:     };\n129: \n130:     match result {\n131:         Ok(id) => {\n132:             info!(\n133:                 \"Added {} program with name: {} and id: {id}\",\n134:                 program.kind(),\n135:                 program.get_data().get_name()?\n136:             );\n137: \n138:             // Now that program is successfully loaded, update the id, maps hash table,\n139:             // and allow access to all maps by bpfman group members.\n140:             save_map(root_db, &mut program, id, map_owner_id)?;\n141: \n142:             // Swap the db tree to be persisted with the unique program ID generated\n143:             // by the kernel.\n144:             program.get_data_mut().swap_tree(root_db, id)?;\n145: \n146:             Ok(program)\n147:         }\n148:         Err(e) => {\n149:             // Cleanup any directories associated with the map_pin_path.\n150:             // map_pin_path may or may not exist depending on where the original\n151:             // error occured, so don't error if not there and preserve original error.\n152:             if let Some(pin_path) = program.get_data().get_map_pin_path()? {\n153:                 let _ = cleanup_map_pin_path(&pin_path, map_owner_id);\n154:             }\n155: \n156:             // Cleanup any program that failed to create. Ignore any delete errors.\n157:             let _ = program.delete(root_db);\n158: \n159:             Err(e)\n160:         }\n161:     }\n162: }\n163: \n164: /// Unloads and ebpf program.\n165: pub async fn remove_program(id: u32) -> Result<(), BpfmanError> {\n166:     let (config, root_db) = &setup().await?;\n167: \n168:     info!(\"Removing program with id: {id}\");\n169:     let prog = match get(root_db, &id) {\n170:         Some(p) => p,\n171:         None => {\n172:             return Err(BpfmanError::Error(format!(\n173:                 \"Program {0} does not exist or was not created by bpfman\",\n174:                 id,\n175:             )));\n176:         }\n177:     };\n178: \n179:     let map_owner_id = prog.get_data().get_map_owner_id()?;\n180: \n181:     match prog {\n182:         Program::Xdp(_) | Program::Tc(_) => {\n183:             let did = prog\n184:                 .dispatcher_id()?\n185:                 .ok_or(BpfmanError::DispatcherNotRequired)?;\n186:             let program_type = prog.kind();\n187:             let if_index = prog.if_index()?;\n188:             let if_name = prog.if_name().unwrap();\n189:             let direction = prog.direction()?;\n190: \n191:             prog.delete(root_db)\n192:                 .map_err(BpfmanError::BpfmanProgramDeleteError)?;\n193: \n194:             remove_multi_attach_program(\n195:                 root_db,\n196:                 config,\n197:                 did,\n198:                 program_type,\n199:                 if_index,\n200:                 if_name,\n201:                 direction,\n202:             )\n203:             .await?\n204:         }\n205:         Program::Tracepoint(_)\n206:         | Program::Kprobe(_)\n207:         | Program::Uprobe(_)\n208:         | Program::Fentry(_)\n209:         | Program::Fexit(_)\n210:         | Program::Unsupported(_) => {\n211:             prog.delete(root_db)\n212:                 .map_err(BpfmanError::BpfmanProgramDeleteError)?;\n213:         }\n214:     }\n215: \n216:     delete_map(root_db, id, map_owner_id)?;\n217: \n218:     Ok(())\n219: }\n220: \n221: /// Lists the currently loaded ebpf programs.\n222: pub async fn list_programs(filter: ListFilter) -> Result<Vec<Program>, BpfmanError> {\n223:     let (_, root_db) = &setup().await?;\n224: \n225:     debug!(\"BpfManager::list_programs()\");\n226: \n227:     // Get an iterator for the bpfman load programs, a hash map indexed by program id.\n228:     let mut bpfman_progs: HashMap<u32, Program> = get_programs_iter(root_db).collect();\n229: \n230:     // Call Aya to get ALL the loaded eBPF programs, and loop through each one.\n231:     Ok(loaded_programs()\n232:         .filter_map(|p| p.ok())\n233:         .map(|prog| {\n234:             let prog_id = prog.id();\n235: \n236:             // If the program was loaded by bpfman (check the hash map), then use it.\n237:             // Otherwise, convert the data returned from Aya into an Unsupported Program Object.\n238:             match bpfman_progs.remove(&prog_id) {\n239:                 Some(p) => p.to_owned(),\n240:                 None => {\n241:                     let db_tree = root_db\n242:                         .open_tree(prog_id.to_string())\n243:                         .expect(\"Unable to open program database tree for listing programs\");\n244: \n245:                     let mut data = ProgramData::new_empty(db_tree);\n246:                     if let Err(e) = data.set_kernel_info(&prog) {\n247:                         warn!(\"Unable to set kernal info for prog {prog_id}, error: {e}\");\n248:                     };\n249: \n250:                     Program::Unsupported(data)\n251:                 }\n252:             }\n253:         })\n254:         .filter(|p| filter.matches(p))\n255:         .collect())\n256: }\n257: \n258: /// Fetches more information regarding a currently loaded ebpf program.\n259: pub async fn get_program(id: u32) -> Result<Program, BpfmanError> {\n260:     let (_, root_db) = &setup().await?;\n261: \n262:     debug!(\"Getting program with id: {id}\");\n263:     // If the program was loaded by bpfman, then use it.\n264:     // Otherwise, call Aya to get ALL the loaded eBPF programs, and convert the data\n265:     // returned from Aya into an Unsupported Program Object.\n266:     match get(root_db, &id) {\n267:         Some(p) => Ok(p.to_owned()),\n268:         None => loaded_programs()\n269:             .find_map(|p| {\n270:                 let prog = p.ok()?;\n271:                 if prog.id() == id {\n272:                     let db_tree = root_db\n273:                         .open_tree(prog.id().to_string())\n274:                         .expect(\"Unable to open program database tree for listing programs\");\n275: \n276:                     let mut data = ProgramData::new_empty(db_tree);\n277:                     data.set_kernel_info(&prog)\n278:                         .expect(\"unable to set kernel info\");\n279: \n280:                     Some(Program::Unsupported(data))\n281:                 } else {\n282:                     None\n283:                 }\n284:             })\n285:             .ok_or(BpfmanError::Error(format!(\n286:                 \"Program {0} does not exist\",\n287:                 id\n288:             ))),\n289:     }\n290: }\n291: \n292: /// Pulls an ebpf bytecode image from a remote OCI container registry.\n293: pub async fn pull_bytecode(image: BytecodeImage) -> anyhow::Result<()> {\n294:     let (_, root_db) = &setup().await?;\n295:     let image_manager = &mut init_image_manager().await;\n296: \n297:     image_manager\n298:         .get_image(\n299:             root_db,\n300:             &image.image_url,\n301:             image.image_pull_policy.clone(),\n302:             image.username.clone(),\n303:             image.password.clone(),\n304:         )\n305:         .await?;\n306:     Ok(())\n307: }\n308: \n309: pub(crate) async fn init_database(sled_config: SledConfig) -> Result<Db, BpfmanError> {\n310:     let database_config = open_config_file().database().to_owned().unwrap_or_default();\n311:     for _ in 1..database_config.max_retries {\n312:         if let Ok(db) = sled_config.open() {\n313:             debug!(\"Successfully opened database\");\n314:             return Ok(db);\n315:         } else {\n316:             info!(\n317:                 \"Database lock is already held, retrying after {} milliseconds\",\n318:                 database_config.millisec_delay\n319:             );\n320:             sleep(Duration::from_millis(database_config.millisec_delay)).await;\n321:         }\n322:     }\n323:     Err(BpfmanError::DatabaseLockError)\n324: }\n325: \n326: // Make sure to call init_image_manger if the command requires interaction with\n327: // an OCI based container registry. It should ONLY be used where needed, to\n328: // explicitly control when bpfman blocks for network calls to both sigstore's\n329: // cosign tuf registries and container registries.\n330: pub(crate) async fn init_image_manager() -> ImageManager {\n331:     let config = open_config_file();\n332:     ImageManager::new(config.signing().as_ref().map_or(true, |s| s.allow_unsigned))\n333:         .await\n334:         .expect(\"failed to initialize image manager\")\n335: }\n336: \n337: fn get_dispatcher(id: &DispatcherId, root_db: &Db) -> Option<Dispatcher> {\n338:     let tree_name_prefix = match id {\n339:         DispatcherId::Xdp(DispatcherInfo(if_index, _)) => {\n340:             format!(\"{}_{}\", XDP_DISPATCHER_PREFIX, if_index)\n341:         }\n342:         DispatcherId::Tc(DispatcherInfo(if_index, Some(direction))) => {\n343:             format!(\"{}_{}_{}\", TC_DISPATCHER_PREFIX, if_index, direction)\n344:         }\n345:         _ => {\n346:             return None;\n347:         }\n348:     };\n349: \n350:     root_db\n351:         .tree_names()\n352:         .into_iter()\n353:         .find(|p| bytes_to_string(p).contains(&tree_name_prefix))\n354:         .map(|p| {\n355:             let tree = root_db.open_tree(p).expect(\"unable to open database tree\");\n356:             Dispatcher::new_from_db(tree)\n357:         })\n358: }\n359: \n360: /// Returns the number of extension programs currently attached to the dispatcher that\n361: /// would be used to attach the provided [`Program`].\n362: fn num_attached_programs(did: &DispatcherId, root_db: &Db) -> usize {\n363:     if let Some(d) = get_dispatcher(did, root_db) {\n364:         d.num_extensions()\n365:     } else {\n366:         0\n367:     }\n368: }\n369: \n370: fn get(root_db: &Db, id: &u32) -> Option<Program> {\n371:     let prog_tree: sled::IVec = (PROGRAM_PREFIX.to_string() + &id.to_string())\n372:         .as_bytes()\n373:         .into();\n374:     if root_db.tree_names().contains(&prog_tree) {\n375:         let tree = root_db\n376:             .open_tree(prog_tree)\n377:             .expect(\"unable to open database tree\");\n378:         Some(Program::new_from_db(*id, tree).expect(\"Failed to build program from database\"))\n379:     } else {\n380:         None\n381:     }\n382: }\n383: \n384: fn filter(\n385:     root_db: &'_ Db,\n386:     program_type: ProgramType,\n387:     if_index: Option<u32>,\n388:     direction: Option<Direction>,\n389: ) -> impl Iterator<Item = Program> + '_ {\n390:     root_db\n391:         .tree_names()\n392:         .into_iter()\n393:         .filter(|p| bytes_to_string(p).contains(PROGRAM_PREFIX))\n394:         .map(|p| {\n395:             let id = bytes_to_string(&p)\n396:                 .split('_')\n397:                 .last()\n398:                 .unwrap()\n399:                 .parse::<u32>()\n400:                 .unwrap();\n401:             let tree = root_db.open_tree(p).expect(\"unable to open database tree\");\n402:             Program::new_from_db(id, tree).expect(\"Failed to build program from database\")\n403:         })\n404:         .filter(move |p| {\n405:             p.kind() == program_type\n406:                 && p.if_index().unwrap() == if_index\n407:                 && p.direction().unwrap() == direction\n408:         })\n409: }\n410: \n411: // Adds a new program and sets the positions of programs that are to be attached via a dispatcher.\n412: // Positions are set based on order of priority. Ties are broken based on:\n413: // - Already attached programs are preferred\n414: // - Program name. Lowest lexical order wins.\n415: fn add_and_set_program_positions(root_db: &Db, program: Program) {\n416:     let program_type = program.kind();\n417:     let if_index = program.if_index().unwrap();\n418:     let direction = program.direction().unwrap();\n419: \n420:     let mut extensions =\n421:         filter(root_db, program_type, if_index, direction).collect::<Vec<Program>>();\n422: \n423:     extensions.sort_by_key(|b| {\n424:         (\n425:             b.priority().unwrap(),\n426:             b.attached(),\n427:             b.get_data().get_name().unwrap().to_owned(),\n428:         )\n429:     });\n430:     for (i, v) in extensions.iter_mut().enumerate() {\n431:         v.set_position(i).expect(\"unable to set program position\");\n432:     }\n433: }\n434: \n435: // Sets the positions of programs that are to be attached via a dispatcher.\n436: // Positions are set based on order of priority. Ties are broken based on:\n437: // - Already attached programs are preferred\n438: // - Program name. Lowest lexical order wins.\n439: fn set_program_positions(\n440:     root_db: &Db,\n441:     program_type: ProgramType,\n442:     if_index: u32,\n443:     direction: Option<Direction>,\n444: ) {\n445:     let mut extensions =\n446:         filter(root_db, program_type, Some(if_index), direction).collect::<Vec<Program>>();\n447: \n448:     extensions.sort_by_key(|b| {\n449:         (\n450:             b.priority().unwrap(),\n451:             b.attached(),\n452:             b.get_data().get_name().unwrap().to_owned(),\n453:         )\n454:     });\n455:     for (i, v) in extensions.iter_mut().enumerate() {\n456:         v.set_position(i).expect(\"unable to set program position\");\n457:     }\n458: }\n459: \n460: fn get_programs_iter(root_db: &Db) -> impl Iterator<Item = (u32, Program)> + '_ {\n461:     root_db\n462:         .tree_names()\n463:         .into_iter()\n464:         .filter(|p| bytes_to_string(p).contains(PROGRAM_PREFIX))\n465:         .map(|p| {\n466:             let id = bytes_to_string(&p)\n467:                 .split('_')\n468:                 .last()\n469:                 .unwrap()\n470:                 .parse::<u32>()\n471:                 .unwrap();\n472:             let tree = root_db.open_tree(p).expect(\"unable to open database tree\");\n473:             (\n474:                 id,\n475:                 Program::new_from_db(id, tree).expect(\"Failed to build program from database\"),\n476:             )\n477:         })\n478: }\n479: \n480: async fn setup() -> Result<(Config, Db), BpfmanError> {\n481:     initialize_bpfman()?;\n482: \n483:     Ok((\n484:         open_config_file(),\n485:         init_database(get_db_config())\n486:             .await\n487:             .expect(\"Unable to open root database\"),\n488:     ))\n489: }\n490: \n491: async fn add_multi_attach_program(\n492:     root_db: &Db,\n493:     program: &mut Program,\n494:     image_manager: &mut ImageManager,\n495:     config: &Config,\n496: ) -> Result<u32, BpfmanError> {\n497:     debug!(\"BpfManager::add_multi_attach_program()\");\n498:     let name = &program.get_data().get_name()?;\n499: \n500:     // This load is just to verify the BPF Function Name is valid.\n501:     // The actual load is performed in the XDP or TC logic.\n502:     // don't pin maps here.\n503:     let mut ext_loader = BpfLoader::new()\n504:         .allow_unsupported_maps()\n505:         .extension(name)\n506:         .load(&program.get_data().get_program_bytes()?)?;\n507: \n508:     match ext_loader.program_mut(name) {\n509:         Some(_) => Ok(()),\n510:         None => Err(BpfmanError::BpfFunctionNameNotValid(name.to_owned())),\n511:     }?;\n512: \n513:     let did = program\n514:         .dispatcher_id()?\n515:         .ok_or(BpfmanError::DispatcherNotRequired)?;\n516: \n517:     let next_available_id = num_attached_programs(&did, root_db);\n518:     if next_available_id >= 10 {\n519:         return Err(BpfmanError::TooManyPrograms);\n520:     }\n521: \n522:     debug!(\"next_available_id={next_available_id}\");\n523: \n524:     let program_type = program.kind();\n525:     let if_index = program.if_index()?;\n526:     let if_name = program.if_name().unwrap().to_string();\n527:     let direction = program.direction()?;\n528: \n529:     add_and_set_program_positions(root_db, program.clone());\n530: \n531:     let mut programs: Vec<Program> =\n532:         filter(root_db, program_type, if_index, direction).collect::<Vec<Program>>();\n533: \n534:     let old_dispatcher = get_dispatcher(&did, root_db);\n535: \n536:     let if_config = if let Some(ref i) = config.interfaces() {\n537:         i.get(&if_name)\n538:     } else {\n539:         None\n540:     };\n541:     let next_revision = if let Some(ref old) = old_dispatcher {\n542:         old.next_revision()\n543:     } else {\n544:         1\n545:     };\n546: \n547:     Dispatcher::new(\n548:         root_db,\n549:         if_config,\n550:         &mut programs,\n551:         next_revision,\n552:         old_dispatcher,\n553:         image_manager,\n554:     )\n555:     .await\n556:     .or_else(|e| {\n557:         // If kernel ID was never set there's no pins to cleanup here so just continue\n558:         if program.get_data().get_id().is_ok() {\n559:             program\n560:                 .delete(root_db)\n561:                 .map_err(BpfmanError::BpfmanProgramDeleteError)?;\n562:         }\n563:         Err(e)\n564:     })?;\n565: \n566:     let id = program.get_data().get_id()?;\n567:     program.set_attached();\n568: \n569:     Ok(id)\n570: }\n571: \n572: pub(crate) fn add_single_attach_program(root_db: &Db, p: &mut Program) -> Result<u32, BpfmanError> {\n573:     debug!(\"BpfManager::add_single_attach_program()\");\n574:     let name = &p.get_data().get_name()?;\n575:     let mut bpf = BpfLoader::new();\n576: \n577:     let data = &p.get_data().get_global_data()?;\n578:     for (key, value) in data {\n579:         bpf.set_global(key, value.as_slice(), true);\n580:     }\n581: \n582:     // If map_pin_path is set already it means we need to use a pin\n583:     // path which should already exist on the system.\n584:     if let Some(map_pin_path) = p.get_data().get_map_pin_path()? {\n585:         debug!(\n586:             \"single-attach program {name} is using maps from {:?}\",\n587:             map_pin_path\n588:         );\n589:         bpf.map_pin_path(map_pin_path);\n590:     }\n591: \n592:     let mut loader = bpf\n593:         .allow_unsupported_maps()\n594:         .load(&p.get_data().get_program_bytes()?)?;\n595: \n596:     let raw_program = loader\n597:         .program_mut(name)\n598:         .ok_or(BpfmanError::BpfFunctionNameNotValid(name.to_owned()))?;\n599: \n600:     let res = match p {\n601:         Program::Tracepoint(ref mut program) => {\n602:             let tracepoint = program.get_tracepoint()?;\n603:             let parts: Vec<&str> = tracepoint.split('/').collect();\n604:             if parts.len() != 2 {\n605:                 return Err(BpfmanError::InvalidAttach(\n606:                     program.get_tracepoint()?.to_string(),\n607:                 ));\n608:             }\n609:             let category = parts[0].to_owned();\n610:             let name = parts[1].to_owned();\n611: \n612:             let tracepoint: &mut TracePoint = raw_program.try_into()?;\n613: \n614:             tracepoint.load()?;\n615:             program\n616:                 .get_data_mut()\n617:                 .set_kernel_info(&tracepoint.info()?)?;\n618: \n619:             let id = program.data.get_id()?;\n620: \n621:             let link_id = tracepoint.attach(&category, &name)?;\n622: \n623:             let owned_link: TracePointLink = tracepoint.take_link(link_id)?;\n624:             let fd_link: FdLink = owned_link\n625:                 .try_into()\n626:                 .expect(\"unable to get owned tracepoint attach link\");\n627: \n628:             fd_link\n629:                 .pin(format!(\"{RTDIR_FS}/prog_{}_link\", id))\n630:                 .map_err(BpfmanError::UnableToPinLink)?;\n631: \n632:             tracepoint\n633:                 .pin(format!(\"{RTDIR_FS}/prog_{}\", id))\n634:                 .map_err(BpfmanError::UnableToPinProgram)?;\n635: \n636:             Ok(id)\n637:         }\n638:         Program::Kprobe(ref mut program) => {\n639:             let requested_probe_type = match program.get_retprobe()? {\n640:                 true => Kretprobe,\n641:                 false => Kprobe,\n642:             };\n643: \n644:             if requested_probe_type == Kretprobe && program.get_offset()? != 0 {\n645:                 return Err(BpfmanError::Error(format!(\n646:                     \"offset not allowed for {Kretprobe}\"\n647:                 )));\n648:             }\n649: \n650:             let kprobe: &mut KProbe = raw_program.try_into()?;\n651:             kprobe.load()?;\n652: \n653:             // verify that the program loaded was the same type as the\n654:             // user requested\n655:             let loaded_probe_type = ProbeType::from(kprobe.kind());\n656:             if requested_probe_type != loaded_probe_type {\n657:                 return Err(BpfmanError::Error(format!(\n658:                     \"expected {requested_probe_type}, loaded program is {loaded_probe_type}\"\n659:                 )));\n660:             }\n661: \n662:             program.get_data_mut().set_kernel_info(&kprobe.info()?)?;\n663: \n664:             let id = program.data.get_id()?;\n665: \n666:             let link_id = kprobe.attach(program.get_fn_name()?, program.get_offset()?)?;\n667: \n668:             let owned_link: KProbeLink = kprobe.take_link(link_id)?;\n669:             let fd_link: FdLink = owned_link\n670:                 .try_into()\n671:                 .expect(\"unable to get owned kprobe attach link\");\n672: \n673:             fd_link\n674:                 .pin(format!(\"{RTDIR_FS}/prog_{}_link\", id))\n675:                 .map_err(BpfmanError::UnableToPinLink)?;\n676: \n677:             kprobe\n678:                 .pin(format!(\"{RTDIR_FS}/prog_{}\", id))\n679:                 .map_err(BpfmanError::UnableToPinProgram)?;\n680: \n681:             Ok(id)\n682:         }\n683:         Program::Uprobe(ref mut program) => {\n684:             let requested_probe_type = match program.get_retprobe()? {\n685:                 true => Uretprobe,\n686:                 false => Uprobe,\n687:             };\n688: \n689:             let uprobe: &mut UProbe = raw_program.try_into()?;\n690:             uprobe.load()?;\n691: \n692:             // verify that the program loaded was the same type as the\n693:             // user requested\n694:             let loaded_probe_type = ProbeType::from(uprobe.kind());\n695:             if requested_probe_type != loaded_probe_type {\n696:                 return Err(BpfmanError::Error(format!(\n697:                     \"expected {requested_probe_type}, loaded program is {loaded_probe_type}\"\n698:                 )));\n699:             }\n700: \n701:             program.get_data_mut().set_kernel_info(&uprobe.info()?)?;\n702: \n703:             let id = program.data.get_id()?;\n704: \n705:             let program_pin_path = format!(\"{RTDIR_FS}/prog_{}\", id);\n706:             let fn_name = program.get_fn_name()?;\n707: \n708:             uprobe\n709:                 .pin(program_pin_path.clone())\n710:                 .map_err(BpfmanError::UnableToPinProgram)?;\n711: \n712:             match program.get_container_pid()? {\n713:                 None => {\n714:                     // Attach uprobe in same container as the bpfman process\n715:                     let link_id = uprobe.attach(\n716:                         fn_name.as_deref(),\n717:                         program.get_offset()?,\n718:                         program.get_target()?,\n719:                         None,\n720:                     )?;\n721: \n722:                     let owned_link: UProbeLink = uprobe.take_link(link_id)?;\n723:                     let fd_link: FdLink = owned_link\n724:                         .try_into()\n725:                         .expect(\"unable to get owned uprobe attach link\");\n726: \n727:                     fd_link\n728:                         .pin(format!(\"{RTDIR_FS}/prog_{}_link\", id))\n729:                         .map_err(BpfmanError::UnableToPinLink)?;\n730:                 }\n731:                 Some(p) => {\n732:                     // Attach uprobe in different container from the bpfman process\n733:                     let offset = program.get_offset()?.to_string();\n734:                     let container_pid = p.to_string();\n735:                     let mut prog_args = vec![\n736:                         \"uprobe\".to_string(),\n737:                         \"--program-pin-path\".to_string(),\n738:                         program_pin_path,\n739:                         \"--offset\".to_string(),\n740:                         offset,\n741:                         \"--target\".to_string(),\n742:                         program.get_target()?.to_string(),\n743:                         \"--container-pid\".to_string(),\n744:                         container_pid,\n745:                     ];\n746: \n747:                     if let Some(fn_name) = &program.get_fn_name()? {\n748:                         prog_args.extend([\"--fn-name\".to_string(), fn_name.to_string()])\n749:                     }\n750: \n751:                     if program.get_retprobe()? {\n752:                         prog_args.push(\"--retprobe\".to_string());\n753:                     }\n754: \n755:                     if let Some(pid) = program.get_pid()? {\n756:                         prog_args.extend([\"--pid\".to_string(), pid.to_string()])\n757:                     }\n758: \n759:                     debug!(\"calling bpfman-ns to attach uprobe in pid: {:?}\", p);\n760: \n761:                     // Figure out where the bpfman-ns binary is located\n762:                     let bpfman_ns_path = if Path::new(\"./target/debug/bpfman-ns\").exists() {\n763:                         // If we're running natively from the bpfman\n764:                         // directory, use the binary in the target/debug\n765:                         // directory\n766:                         \"./target/debug/bpfman-ns\"\n767:                     } else if Path::new(\"./bpfman-ns\").exists() {\n768:                         // If we're running on kubernetes, the bpfman-ns\n769:                         // binary will be in the current directory\n770:                         \"./bpfman-ns\"\n771:                     } else {\n772:                         // look for bpfman-ns in the PATH\n773:                         \"bpfman-ns\"\n774:                     };\n775: \n776:                     let output = std::process::Command::new(bpfman_ns_path)\n777:                         .args(prog_args)\n778:                         .output();\n779: \n780:                     match output {\n781:                         Ok(o) => {\n782:                             if !o.status.success() {\n783:                                 info!(\n784:                                     \"Error from bpfman-ns: {:?}\",\n785:                                     get_error_msg_from_stderr(&o.stderr)\n786:                                 );\n787:                                 return Err(BpfmanError::ContainerAttachError {\n788:                                     program_type: \"uprobe\".to_string(),\n789:                                     container_pid: program.get_container_pid()?.unwrap(),\n790:                                 });\n791:                             };\n792:                         }\n793:                         Err(e) => {\n794:                             info!(\"bpfman-ns returned error: {:?}\", e);\n795:                             return Err(BpfmanError::ContainerAttachError {\n796:                                 program_type: \"uprobe\".to_string(),\n797:                                 container_pid: program.get_container_pid()?.unwrap(),\n798:                             });\n799:                         }\n800:                     };\n801:                 }\n802:             };\n803: \n804:             Ok(id)\n805:         }\n806:         Program::Fentry(ref mut program) => {\n807:             let fn_name = program.get_fn_name()?;\n808:             let btf = Btf::from_sys_fs()?;\n809:             let fentry: &mut FEntry = raw_program.try_into()?;\n810:             fentry\n811:                 .load(&fn_name, &btf)\n812:                 .map_err(BpfmanError::BpfProgramError)?;\n813:             program.get_data_mut().set_kernel_info(&fentry.info()?)?;\n814: \n815:             let id = program.data.get_id()?;\n816:             let link_id = fentry.attach()?;\n817:             let owned_link: FEntryLink = fentry.take_link(link_id)?;\n818:             let fd_link: FdLink = owned_link.into();\n819:             fd_link\n820:                 .pin(format!(\"{RTDIR_FS}/prog_{}_link\", id))\n821:                 .map_err(BpfmanError::UnableToPinLink)?;\n822: \n823:             fentry\n824:                 .pin(format!(\"{RTDIR_FS}/prog_{}\", id))\n825:                 .map_err(BpfmanError::UnableToPinProgram)?;\n826: \n827:             Ok(id)\n828:         }\n829:         Program::Fexit(ref mut program) => {\n830:             let fn_name = program.get_fn_name()?;\n831:             let btf = Btf::from_sys_fs()?;\n832:             let fexit: &mut FExit = raw_program.try_into()?;\n833:             fexit\n834:                 .load(&fn_name, &btf)\n835:                 .map_err(BpfmanError::BpfProgramError)?;\n836:             program.get_data_mut().set_kernel_info(&fexit.info()?)?;\n837: \n838:             let id = program.data.get_id()?;\n839:             let link_id = fexit.attach()?;\n840:             let owned_link: FExitLink = fexit.take_link(link_id)?;\n841:             let fd_link: FdLink = owned_link.into();\n842:             fd_link\n843:                 .pin(format!(\"{RTDIR_FS}/prog_{}_link\", id))\n844:                 .map_err(BpfmanError::UnableToPinLink)?;\n845: \n846:             fexit\n847:                 .pin(format!(\"{RTDIR_FS}/prog_{}\", id))\n848:                 .map_err(BpfmanError::UnableToPinProgram)?;\n849: \n850:             Ok(id)\n851:         }\n852:         _ => panic!(\"not a supported single attach program\"),\n853:     };\n854: \n855:     match res {\n856:         Ok(id) => {\n857:             // If this program is the map(s) owner pin all maps (except for .rodata and .bss) by name.\n858:             if p.get_data().get_map_pin_path()?.is_none() {\n859:                 let map_pin_path = calc_map_pin_path(id);\n860:                 p.get_data_mut().set_map_pin_path(&map_pin_path)?;\n861:                 create_map_pin_path(&map_pin