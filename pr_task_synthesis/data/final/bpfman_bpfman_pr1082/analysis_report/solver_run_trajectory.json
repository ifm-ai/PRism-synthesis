  let mut programs: Vec<Program> = filter(root_db, program_type, if_index, direction).collect();\n916: \n917:     let if_config = if let Some(ref i) = config.interfaces() {\n918:         i.get(&if_name)\n919:     } else {\n920:         None\n921:     };\n922:     let next_revision = if let Some(ref old) = old_dispatcher {\n923:         old.next_revision()\n924:     } else {\n925:         1\n926:     };\n927:     debug!(\"next_revision = {next_revision}\");\n928: \n929:     Dispatcher::new(\n930:         root_db,\n931:         if_config,\n932:         &mut programs,\n933:         next_revision,\n934:         old_dispatcher,\n935:         &mut image_manager,\n936:     )\n937:     .await?;\n938: \n939:     Ok(())\n940: }\n941: \n942: // This function checks to see if the user provided map_owner_id is valid.\n943: fn is_map_owner_id_valid(root_db: &Db, map_owner_id: u32) -> Result<PathBuf, BpfmanError> {\n944:     let map_pin_path = calc_map_pin_path(map_owner_id);\n945:     let name: &sled::IVec = &format!(\"{}{}\", MAP_PREFIX, map_owner_id).as_bytes().into();\n946: \n947:     if root_db.tree_names().contains(name) {\n948:         // Return the map_pin_path\n949:         return Ok(map_pin_path);\n950:     }\n951:     Err(BpfmanError::Error(\n952:         \"map_owner_id does not exists\".to_string(),\n953:     ))\n954: }\n955: \n956: // This function is called if the program's map directory was created,\n957: // but the eBPF program failed to load. save_map() has not been called,\n958: // so self.maps has not been updated for this program.\n959: // If the user provided a ID of program to share a map with,\n960: // then map the directory is still in use and there is nothing to do.\n961: // Otherwise, the map directory was created so it must\n962: // deleted.\n963: fn cleanup_map_pin_path(map_pin_path: &Path, map_owner_id: Option<u32>) -> Result<(), BpfmanError> {\n964:     if map_owner_id.is_none() && map_pin_path.exists() {\n965:         let _ = remove_dir_all(map_pin_path)\n966:             .map_err(|e| BpfmanError::Error(format!(\"can't delete map dir: {e}\")));\n967:         Ok(())\n968:     } else {\n969:         Ok(())\n970:     }\n971: }\n972: \n973: // This function writes the map to the map hash table. If this eBPF\n974: // program is the map owner, then a new entry is add to the map hash\n975: // table and permissions on the directory are updated to grant bpfman\n976: // user group access to all the maps in the directory. If this eBPF\n977: // program is not the owner, then the eBPF program ID is added to\n978: // the Used-By array.\n979: fn save_map(\n980:     root_db: &Db,\n981:     program: &mut Program,\n982:     id: u32,\n983:     map_owner_id: Option<u32>,\n984: ) -> Result<(), BpfmanError> {\n985:     let data = program.get_data_mut();\n986: \n987:     match map_owner_id {\n988:         Some(m) => {\n989:             if let Some(map) = get_map(m, root_db) {\n990:                 push_maps_used_by(map.clone(), id)?;\n991:                 let used_by = get_maps_used_by(map)?;\n992: \n993:                 // This program has no been inserted yet, so set map_used_by to\n994:                 // newly updated list.\n995:                 data.set_maps_used_by(used_by.clone())?;\n996: \n997:                 // Update all the programs using the same map with the updated map_used_by.\n998:                 for used_by_id in used_by.iter() {\n999:                     if let Some(mut program) = get(root_db, used_by_id) {\n1000:                         program.get_data_mut().set_maps_used_by(used_by.clone())?;\n1001:                     }\n1002:                 }\n1003:             } else {\n1004:                 return Err(BpfmanError::Error(\n1005:                     \"map_owner_id does not exist\".to_string(),\n1006:                 ));\n1007:             }\n1008:         }\n1009:         None => {\n1010:             let db_tree = root_db\n1011:                 .open_tree(format!(\"{}{}\", MAP_PREFIX, id))\n1012:                 .expect(\"Unable to open map db tree\");\n1013: \n1014:             set_maps_used_by(db_tree, vec![id])?;\n1015: \n1016:             // Update this program with the updated map_used_by\n1017:             data.set_maps_used_by(vec![id])?;\n1018: \n1019:             // Set the permissions on the map_pin_path directory.\n1020:             if let Some(map_pin_path) = data.get_map_pin_path()? {\n1021:                 if let Some(path) = map_pin_path.to_str() {\n1022:                     debug!(\"bpf set dir permissions for {}\", path);\n1023:                     set_dir_permissions(path, MAPS_MODE);\n1024:                 } else {\n1025:                     return Err(BpfmanError::Error(format!(\n1026:                         \"invalid map_pin_path {} for {}\",\n1027:                         map_pin_path.display(),\n1028:                         id\n1029:                     )));\n1030:                 }\n1031:             } else {\n1032:                 return Err(BpfmanError::Error(format!(\n1033:                     \"map_pin_path should be set for {}\",\n1034:                     id\n1035:                 )));\n1036:             }\n1037:         }\n1038:     }\n1039: \n1040:     Ok(())\n1041: }\n1042: \n1043: // This function cleans up a map entry when an eBPF program is\n1044: // being unloaded. If the eBPF program is the map owner, then\n1045: // the map is removed from the hash table and the associated\n1046: // directory is removed. If this eBPF program is referencing a\n1047: // map from another eBPF program, then this eBPF programs ID\n1048: // is removed from the UsedBy array.\n1049: fn delete_map(root_db: &Db, id: u32, map_owner_id: Option<u32>) -> Result<(), BpfmanError> {\n1050:     let index = match map_owner_id {\n1051:         Some(i) => i,\n1052:         None => id,\n1053:     };\n1054: \n1055:     if let Some(map) = get_map(index, root_db) {\n1056:         let mut used_by = get_maps_used_by(map.clone())?;\n1057: \n1058:         if let Some(index) = used_by.iter().position(|value| *value == id) {\n1059:             used_by.swap_remove(index);\n1060:         }\n1061: \n1062:         clear_maps_used_by(map.clone());\n1063:         set_maps_used_by(map.clone(), used_by.clone())?;\n1064: \n1065:         if used_by.is_empty() {\n1066:             let path: PathBuf = calc_map_pin_path(index);\n1067:             // No more programs using this map, so remove the entry from the map list.\n1068:             root_db\n1069:                 .drop_tree(MAP_PREFIX.to_string() + &index.to_string())\n1070:                 .expect(\"unable to drop maps tree\");\n1071:             remove_dir_all(path)\n1072:                 .map_err(|e| BpfmanError::Error(format!(\"can't delete map dir: {e}\")))?;\n1073:         } else {\n1074:             // Update all the programs still using the same map with the updated map_used_by.\n1075:             for id in used_by.iter() {\n1076:                 if let Some(mut program) = get(root_db, id) {\n1077:                     program.get_data_mut().set_maps_used_by(used_by.clone())?;\n1078:                 }\n1079:             }\n1080:         }\n1081:     } else {\n1082:         return Err(BpfmanError::Error(\n1083:             \"map_pin_path does not exists\".to_string(),\n1084:         ));\n1085:     }\n1086: \n1087:     Ok(())\n1088: }\n1089: \n1090: // map_pin_path is a the directory the maps are located. Currently, it\n1091: // is a fixed bpfman location containing the map_index, which is a ID.\n1092: // The ID is either the programs ID, or the ID of another program\n1093: // that map_owner_id references.\n1094: pub(crate) fn calc_map_pin_path(id: u32) -> PathBuf {\n1095:     PathBuf::from(format!(\"{RTDIR_FS_MAPS}/{}\", id))\n1096: }\n1097: \n1098: // Create the map_pin_path for a given program.\n1099: pub(crate) fn create_map_pin_path(p: &Path) -> Result<(), BpfmanError> {\n1100:     create_dir_all(p).map_err(|e| BpfmanError::Error(format!(\"can't create map dir: {e}\")))\n1101: }\n1102: \n1103: // set_maps_used_by differs from other setters in that it's explicitly idempotent.\n1104: pub(crate) fn set_maps_used_by(db_tree: sled::Tree, ids: Vec<u32>) -> Result<(), BpfmanError> {\n1105:     ids.iter().enumerate().try_for_each(|(i, v)| {\n1106:         sled_insert(\n1107:             &db_tree,\n1108:             format!(\"{MAPS_USED_BY_PREFIX}{i}\").as_str(),\n1109:             &v.to_ne_bytes(),\n1110:         )\n1111:     })\n1112: }\n1113: \n1114: // set_maps_used_by differs from other setters in that it's explicitly idempotent.\n1115: fn push_maps_used_by(db_tree: sled::Tree, id: u32) -> Result<(), BpfmanError> {\n1116:     let existing_maps_used_by = get_maps_used_by(db_tree.clone())?;\n1117: \n1118:     sled_insert(\n1119:         &db_tree,\n1120:         format!(\"{MAPS_USED_BY_PREFIX}{}\", existing_maps_used_by.len() + 1).as_str(),\n1121:         &id.to_ne_bytes(),\n1122:     )\n1123: }\n1124: \n1125: fn get_maps_used_by(db_tree: sled::Tree) -> Result<Vec<u32>, BpfmanError> {\n1126:     db_tree\n1127:         .scan_prefix(MAPS_USED_BY_PREFIX)\n1128:         .map(|n| n.map(|(_, v)| bytes_to_u32(v.to_vec())))\n1129:         .map(|n| {\n1130:             n.map_err(|e| {\n1131:                 BpfmanError::DatabaseError(\"Failed to get maps used by\".to_string(), e.to_string())\n1132:             })\n1133:         })\n1134:         .collect()\n1135: }\n1136: \n1137: pub(crate) fn clear_maps_used_by(db_tree: sled::Tree) {\n1138:     db_tree.scan_prefix(MAPS_USED_BY_PREFIX).for_each(|n| {\n1139:         db_tree\n1140:             .remove(n.unwrap().0)\n1141:             .expect(\"unable to clear maps used by\");\n1142:     });\n1143: }\n1144: \n1145: fn get_map(id: u32, root_db: &Db) -> Option<sled::Tree> {\n1146:     root_db\n1147:         .tree_names()\n1148:         .into_iter()\n1149:         .find(|n| bytes_to_string(n) == format!(\"{}{}\", MAP_PREFIX, id))\n1150:         .map(|n| root_db.open_tree(n).expect(\"unable to open map tree\"))\n1151: }\n\n(End of file - total 1151 lines)\n</content>",
