_file_permissions(path: &Path, mode: u32) {\n57:     // Set the permissions on the file based on input\n58:     if (set_permissions(path, std::fs::Permissions::from_mode(mode))).is_err() {\n59:         debug!(\n60:             \"Unable to set permissions on file {}. Continuing\",\n61:             path.to_path_buf().display()\n62:         );\n63:     }\n64: }\n65: \n66: pub fn set_dir_permissions(directory: &str, mode: u32) {\n67:     // Iterate through the files in the provided directory\n68:     let entries = std::fs::read_dir(directory).unwrap();\n69:     for file in entries.flatten() {\n70:         // Set the permissions on the file based on input\n71:         set_file_permissions(&file.path(), mode);\n72:     }\n73: }\n74: \n75: pub fn create_bpffs(directory: &str) -> anyhow::Result<()> {\n76:     debug!(\"Creating bpffs at {directory}\");\n77:     let flags = MsFlags::MS_NOSUID | MsFlags::MS_NODEV | MsFlags::MS_NOEXEC | MsFlags::MS_RELATIME;\n78:     mount::<str, str, str, str>(None, directory, Some(\"bpf\"), flags, None)\n79:         .with_context(|| format!(\"unable to create bpffs at {directory}\"))\n80: }\n81: \n82: pub(crate) fn should_map_be_pinned(name: &str) -> bool {\n83:     !(name.contains(\".rodata\") || name.contains(\".bss\") || name.contains(\".data\"))\n84: }\n85: \n86: pub(crate) fn bytes_to_u32(bytes: Vec<u8>) -> u32 {\n87:     u32::from_ne_bytes(\n88:         bytes\n89:             .try_into()\n90:             .expect(\"unable to marshall &[u8] to &[u8; 4]\"),\n91:     )\n92: }\n93: \n94: pub(crate) fn bytes_to_u16(bytes: Vec<u8>) -> u16 {\n95:     u16::from_ne_bytes(\n96:         bytes\n97:             .try_into()\n98:             .expect(\"unable to marshall &[u8] to &[u8; 4]\"),\n99:     )\n100: }\n101: \n102: pub(crate) fn bytes_to_i32(bytes: Vec<u8>) -> i32 {\n103:     i32::from_ne_bytes(\n104:         bytes\n105:             .try_into()\n106:             .expect(\"unable to marshall &[u8] to &[u8; 4]\"),\n107:     )\n108: }\n109: \n110: pub(crate) fn bytes_to_string(bytes: &[u8]) -> String {\n111:     String::from_utf8(bytes.to_vec()).expect(\"failed to convert &[u8] to string\")\n112: }\n113: \n114: pub(crate) fn bytes_to_bool(bytes: Vec<u8>) -> bool {\n115:     i8::from_ne_bytes(\n116:         bytes\n117:             .try_into()\n118:             .expect(\"unable to marshall &[u8] to &[i8; 1]\"),\n119:     ) != 0\n120: }\n121: \n122: pub(crate) fn bytes_to_usize(bytes: Vec<u8>) -> usize {\n123:     usize::from_ne_bytes(\n124:         bytes\n125:             .try_into()\n126:             .expect(\"unable to marshall &[u8] to &[u8; 8]\"),\n127:     )\n128: }\n129: \n130: pub(crate) fn bytes_to_u64(bytes: Vec<u8>) -> u64 {\n131:     u64::from_ne_bytes(\n132:         bytes\n133:             .try_into()\n134:             .expect(\"unable to marshall &[u8] to &[u8; 8]\"),\n135:     )\n136: }\n137: \n138: // Sled in memory database helper functions which help with error handling and\n139: // data marshalling.\n140: \n141: pub(crate) fn sled_get(db_tree: &Tree, key: &str) -> Result<Vec<u8>, BpfmanError> {\n142:     db_tree\n143:         .get(key)\n144:         .map_err(|e| {\n145:             BpfmanError::DatabaseError(\n146:                 format!(\n147:                     \"Unable to get database entry {key} from tree {}\",\n148:                     bytes_to_string(&db_tree.name())\n149:                 ),\n150:                 e.to_string(),\n151:             )\n152:         })?\n153:         .map(|v| v.to_vec())\n154:         .ok_or(BpfmanError::DatabaseError(\n155:             format!(\n156:                 \"Database entry {key} does not exist in tree {:?}\",\n157:                 bytes_to_string(&db_tree.name())\n158:             ),\n159:             \"\".to_string(),\n160:         ))\n161: }\n162: \n163: pub(crate) fn sled_get_option(db_tree: &Tree, key: &str) -> Result<Option<Vec<u8>>, BpfmanError> {\n164:     db_tree\n165:         .get(key)\n166:         .map_err(|e| {\n167:             BpfmanError::DatabaseError(\n168:                 format!(\n169:                     \"Unable to get database entry {key} from tree {}\",\n170:                     bytes_to_string(&db_tree.name()),\n171:                 ),\n172:                 e.to_string(),\n173:             )\n174:         })\n175:         .map(|v| v.map(|v| v.to_vec()))\n176: }\n177: \n178: pub(crate) fn sled_insert(db_tree: &Tree, key: &str, value: &[u8]) -> Result<(), BpfmanError> {\n179:     db_tree.insert(key, value).map(|_| ()).map_err(|e| {\n180:         BpfmanError::DatabaseError(\n181:             format!(\n182:                 \"Unable to insert database entry {key} into tree {:?}\",\n183:                 db_tree.name()\n184:             ),\n185:             e.to_string(),\n186:         )\n187:     })\n188: }\n189: \n190: // Helper function to get the error message from stderr\n191: pub(crate) fn get_error_msg_from_stderr(stderr: &[u8]) -> String {\n192:     // Convert to lines\n193:     let stderr_lines = String::from_utf8_lossy(stderr)\n194:         .split('\\n')\n195:         .map(|s| s.to_string())\n196:         .collect::<Vec<String>>();\n197: \n198:     // Remove empty lines\n199:     let stderr_lines = stderr_lines\n200:         .iter()\n201:         .filter(|s| !s.is_empty())\n202:         .map(|s| s.to_string())\n203:         .collect::<Vec<String>>();\n204: \n205:     // return the last line if it exists, otherwise return \"No message\"\n206:     stderr_lines\n207:         .last()\n208:         .unwrap_or(&\"No message\".to_string())\n209:         .to_string()\n210: }\n211: \n212: pub(crate) fn open_config_file() -> Config {\n213:     if let Ok(c) = std::fs::read_to_string(CFGPATH_BPFMAN_CONFIG) {\n214:         c.parse().unwrap_or_else(|_| {\n215:             warn!(\"Unable to parse config file, using defaults\");\n216:             Config::default()\n217:         })\n218:     } else {\n219:         warn!(\"Unable to read config file, using defaults\");\n220:         Config::default()\n221:     }\n222: }\n223: \n224: fn has_cap(cset: caps::CapSet, cap: caps::Capability) {\n225:     info!(\"Has {}: {}\", cap, caps::has_cap(None, cset, cap).unwrap());\n226: }\n227: \n228: fn is_bpffs_mounted() -> Result<bool, anyhow::Error> {\n229:     let file = File::open(\"/proc/mounts\").context(\"Failed to open /proc/mounts\")?;\n230:     let reader = BufReader::new(file);\n231:     for l in reader.lines() {\n232:         match l {\n233:             Ok(line) => {\n234:                 let parts: Vec<&str> = line.split(' ').collect();\n235:                 if parts.len() != 6 {\n236:                     bail!(\"expected 6 parts in proc mount\")\n237:                 }\n238:                 if parts[0] == \"none\" && parts[1].contains(\"bpfman\") && parts[2] == \"bpf\" {\n239:                     return Ok(true);\n240:                 }\n241:             }\n242:             Err(e) => bail!(\"problem reading lines {}\", e),\n243:         }\n244:     }\n245:     Ok(false)\n246: }\n247: \n248: pub(crate) fn initialize_bpfman() -> anyhow::Result<()> {\n249:     if connected_to_journal() {\n250:         // If bpfman is running as a service, log to journald.\n251:         JournalLog::new()?\n252:             .with_extra_fields(vec![(\"VERSION\", env!(\"CARGO_PKG_VERSION\"))])\n253:             .install()\n254:             .unwrap();\n255:         manage_journal_log_level();\n256:         debug!(\"Log using journald\");\n257:     } else {\n258:         // Ignore error if already initialized.\n259:         let _ = env_logger::try_init();\n260:         debug!(\"Log using env_logger\");\n261:     }\n262: \n263:     has_cap(caps::CapSet::Effective, caps::Capability::CAP_BPF);\n264:     has_cap(caps::CapSet::Effective, caps::Capability::CAP_SYS_ADMIN);\n265: \n266:     setrlimit(Resource::RLIMIT_MEMLOCK, RLIM_INFINITY, RLIM_INFINITY).unwrap();\n267: \n268:     // Create directories associated with bpfman\n269:     create_dir_all(RTDIR).context(\"unable to create runtime directory\")?;\n270:     create_dir_all(RTDIR_FS).context(\"unable to create mountpoint\")?;\n271:     create_dir_all(RTDIR_TC_INGRESS_DISPATCHER).context(\"unable to create dispatcher directory\")?;\n272:     create_dir_all(RTDIR_TC_EGRESS_DISPATCHER).context(\"unable to create dispatcher directory\")?;\n273:     create_dir_all(RTDIR_XDP_DISPATCHER).context(\"unable to create dispatcher directory\")?;\n274:     create_dir_all(RTDIR_PROGRAMS).context(\"unable to create programs directory\")?;\n275: \n276:     if !is_bpffs_mounted()? {\n277:         create_bpffs(RTDIR_FS)?;\n278:     }\n279:     create_dir_all(RTDIR_FS_XDP).context(\"unable to create xdp dispatcher directory\")?;\n280:     create_dir_all(RTDIR_FS_TC_INGRESS)\n281:         .context(\"unable to create tc ingress dispatcher directory\")?;\n282:     create_dir_all(RTDIR_FS_TC_EGRESS)\n283:         .context(\"unable to create tc egress dispatcher directory\")?;\n284:     create_dir_all(RTDIR_FS_MAPS).context(\"unable to create maps directory\")?;\n285:     create_dir_all(RTDIR_TUF).context(\"unable to create TUF directory\")?;\n286: \n287:     create_dir_all(STDIR).context(\"unable to create state directory\")?;\n288: \n289:     create_dir_all(CFGDIR_STATIC_PROGRAMS).context(\"unable to create static programs directory\")?;\n290: \n291:     set_dir_permissions(CFGDIR, CFGDIR_MODE);\n292:     set_dir_permissions(RTDIR, RTDIR_MODE);\n293:     set_dir_permissions(STDIR, STDIR_MODE);\n294: \n295:     Ok(())\n296: }\n297: \n298: fn manage_journal_log_level() {\n299:     // env_logger uses the environment variable RUST_LOG to set the log\n300:     // level. Parse RUST_LOG to set the log level for journald.\n301:     log::set_max_level(log::LevelFilter::Error);\n302:     if env::var(BPFMAN_ENV_LOG_LEVEL).is_ok() {\n303:         let rust_log = log::LevelFilter::from_str(&env::var(BPFMAN_ENV_LOG_LEVEL).unwrap());\n304:         match rust_log {\n305:             Ok(value) => log::set_max_level(value),\n306:       