            "output": "<path>/workspace/bpfman-api/src/bin/rpc/serve.rs</path>\n<type>file</type>\n<content>\n1: // SPDX-License-Identifier: Apache-2.0\n2: // Copyright Authors of bpfman\n3: \n4: use std::{\n5:     fs::{create_dir_all, remove_file},\n6:     os::unix::prelude::{FromRawFd, IntoRawFd},\n7:     path::Path,\n8: };\n9: \n10: use anyhow::{anyhow, Context};\n11: use bpfman::utils::{set_file_permissions, SOCK_MODE};\n12: use bpfman_api::v1::bpfman_server::BpfmanServer;\n13: use libsystemd::activation::IsType;\n14: use log::{debug, error, info};\n15: use tokio::{\n16:     join,\n17:     net::UnixListener,\n18:     signal::unix::{signal, SignalKind},\n19:     sync::broadcast,\n20:     task::{JoinHandle, JoinSet},\n21: };\n22: use tokio_stream::wrappers::UnixListenerStream;\n23: use tonic::transport::Server;\n24: \n25: use crate::{rpc::BpfmanLoader, storage::StorageManager};\n26: \n27: pub(crate) const RTDIR_SOCK: &str = \"/run/bpfman-sock\";\n28: // The CSI socket must be in it's own sub directory so we can easily create a dedicated\n29: // K8s volume mount for it.\n30: pub(crate) const RTDIR_BPFMAN_CSI: &str = \"/run/bpfman/csi\";\n31: \n32: pub async fn serve(csi_support: bool, timeout: u64, socket_path: &Path) -> anyhow::Result<()> {\n33:     let (shutdown_tx, shutdown_rx1) = broadcast::channel(32);\n34:     let shutdown_rx3 = shutdown_tx.subscribe();\n35:     let shutdown_handle = tokio::spawn(shutdown_handler(timeout, shutdown_tx));\n36: \n37:     let loader = BpfmanLoader::new();\n38:     let service = BpfmanServer::new(loader);\n39: \n40:     let mut listeners: Vec<_> = Vec::new();\n41: \n42:     let handle = serve_unix(socket_path, service.clone(), shutdown_rx1).await?;\n43:     listeners.push(handle);\n44: \n45:     if csi_support {\n46:         create_dir_all(RTDIR_BPFMAN_CSI).context(\"unable to create CSI directory\")?;\n47:         create_dir_all(RTDIR_SOCK).context(\"unable to create socket directory\")?;\n48:         let storage_manager = StorageManager::new();\n49:         let storage_manager_handle =\n50:             tokio::spawn(async move { storage_manager.run(shutdown_rx3).await });\n51:         let (_, res_storage, _) = join!(\n52:             join_listeners(listeners),\n53:             storage_manager_handle,\n54:             shutdown_handle\n55:         );\n56:         if let Some(e) = res_storage.err() {\n57:             return Err(e.into());\n58:         }\n59:     } else {\n60:         let (_, res) = join!(join_listeners(listeners), shutdown_handle);\n61:         if let Some(e) = res.err() {\n62:             return Err(e.into());\n63:         }\n64:     }\n65: \n66:     Ok(())\n67: }\n68: \n69: pub(crate) async fn shutdown_handler(timeout: u64, shutdown_tx: broadcast::Sender<()>) {\n70:     let mut joinset = JoinSet::new();\n71:     if timeout > 0 {\n72:         info!(\"Using inactivity timer of {} seconds\", timeout);\n73:         let duration: std::time::Duration = std::time::Duration::from_secs(timeout);\n74:         joinset.spawn(Box::pin(tokio::time::sleep(duration)));\n75:     } else {\n76:         info!(\"Using no inactivity timer\");\n77:     }\n78:     let mut sigint = signal(SignalKind::interrupt()).unwrap();\n79:     joinset.spawn(async move {\n80:         sigint.recv().await;\n81:         debug!(\"Received SIGINT\");\n82:     });\n83: \n84:     let mut sigterm = signal(SignalKind::terminate()).unwrap();\n85:     joinset.spawn(async move {\n86:         sigterm.recv().await;\n87:         debug!(\"Received SIGTERM\");\n88:     });\n89: \n90:     joinset.join_next().await;\n91:     shutdown_tx.send(()).unwrap();\n92: }\n93: \n94: async fn join_listeners(listeners: Vec<JoinHandle<()>>) {\n95:     for listener in listeners {\n96:         match listener.await {\n97:             Ok(()) => {}\n98:             Err(e) => eprintln!(\"Error = {e:?}\"),\n99:         }\n100:     }\n101: }\n102: \n103: async fn serve_unix(\n104:     path: &Path,\n105:     service: BpfmanServer<BpfmanLoader>,\n106:     mut shutdown_channel: broadcast::Receiver<()>,\n107: ) -> anyhow::Result<JoinHandle<()>> {\n108:     let uds_stream = if let Ok(stream) = systemd_unix_stream() {\n109:         stream\n110:     } else {\n111:         std_unix_stream(path).await?\n112:     };\n113: \n114:     let serve = Server::builder()\n115:         .add_service(service)\n116:         .serve_with_incoming_shutdown(uds_stream, async move {\n117:             match shutdown_channel.recv().await {\n118:                 Ok(()) => debug!(\"Unix Socket: Received shutdown signal\"),\n119:                 Err(e) => error!(\"Error receiving shutdown signal {:?}\", e),\n120:             };\n121:         });\n122: \n123:     let socket_path = path.to_path_buf();\n124:     Ok(tokio::spawn(async move {\n125:         info!(\"Listening on {}\", socket_path.to_path_buf().display());\n126:         if let Err(e) = serve.await {\n127:             eprintln!(\"Error = {e:?}\");\n128:         }\n129:         info!(\n130:             \"Shutdown Unix Handler {}\",\n131:             socket_path.to_path_buf().display()\n132:         );\n133:     }))\n134: }\n135: \n136: fn systemd_unix_stream() -> anyhow::Result<UnixListenerStream> {\n137:     let listen_fds = libsystemd::activation::receive_descriptors(true)?;\n138:     if listen_fds.len() == 1 {\n139:         if let Some(fd) = listen_fds.first() {\n140:             if !fd.is_unix() {\n141:                 return Err(anyhow!(\"Wrong Socket\"));\n142:             }\n143:             let std_listener =\n144:                 unsafe { std::os::unix::net::UnixListener::from_raw_fd(fd.clone().into_raw_fd()) };\n145:             std_listener.set_nonblocking(true)?;\n146:             let tokio_listener = UnixListener::from_std(std_listener)?;\n147:             info!(\"Using a Unix socket from systemd\");\n148:             return Ok(UnixListenerStream::new(tokio_listener));\n149:         }\n150:     }\n151: \n152:     Err(anyhow!(\"Unable to retrieve fd from systemd\"))\n153: }\n154: \n155: async fn std_unix_stream(path: &Path) -> anyhow::Result<UnixListenerStream> {\n156:     // Listen on Unix socket\n157:     if path.exists() {\n158:         // Attempt to remove the socket, since bind fails if it exists\n159:         remove_file(path)?;\n160:     }\n161: \n162:     let uds = UnixListener::bind(path)?;\n163:     let stream = UnixListenerStream::new(uds);\n164:     // Always set the file permissions of our listening socket.\n165:     set_file_permissions(path, SOCK_MODE);\n166: \n167:     info!(\"Using default Unix socket\");\n168:     Ok(stream)\n169: }\n\n(End of file - total 169 lines)\n</content>",
