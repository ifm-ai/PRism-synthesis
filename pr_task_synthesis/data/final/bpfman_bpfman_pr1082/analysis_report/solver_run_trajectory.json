              "file": "bpfman/src/bin/cli/main.rs",
              "patch": "Index: bpfman/src/bin/cli/main.rs\n===================================================================\n--- bpfman/src/bin/cli/main.rs\t\n+++ bpfman/src/bin/cli/main.rs\t\n@@ -1,40 +1,83 @@\n // SPDX-License-Identifier: Apache-2.0\n // Copyright Authors of bpfman\n \n+use std::{env, str::FromStr};\n+\n use anyhow::anyhow;\n use args::Commands;\n use clap::Parser;\n use get::execute_get;\n use list::execute_list;\n+use log::debug;\n+use systemd_journal_logger::{connected_to_journal, JournalLog};\n use unload::execute_unload;\n \n mod args;\n mod get;\n mod image;\n mod list;\n mod load;\n mod table;\n mod unload;\n \n+fn init_logging() {\n+    if connected_to_journal() {\n+        match JournalLog::new() {\n+            Ok(logger) => {\n+                if let Err(e) = logger\n+                    .with_extra_fields(vec![(\"BINARY\", \"bpfman\")])\n+                    .install()\n+                {\n+                    eprintln!(\"Failed to initialize journald logger: {}\", e);\n+                } else {\n+                    debug!(\"Log using journald\");\n+                }\n+            }\n+            Err(e) => {\n+                eprintln!(\"Failed to create journald logger: {}\", e);\n+            }\n+        }\n+        manage_journal_log_level();\n+    } else {\n+        if let Err(e) = env_logger::try_init() {\n+            eprintln!(\"Failed to initialize env_logger: {}\", e);\n+        } else {\n+            debug!(\"Log using env_logger\");\n+        }\n+    }\n+}\n+\n+fn manage_journal_log_level() {\n+    log::set_max_level(log::LevelFilter::Error);\n+    if let Ok(rust_log) = env::var(\"RUST_LOG\") {\n+        match log::LevelFilter::from_str(&rust_log) {\n+            Ok(value) => log::set_max_level(value),\n+            Err(e) => eprintln!(\"Invalid RUST_LOG value: {}\", e),\n+        }\n+    }\n+}\n+\n #[tokio::main]\n async fn main() -> anyhow::Result<()> {\n+    init_logging();\n+    \n     let cli = crate::args::Cli::parse();\n \n     cli.command.execute().await\n }\n \n impl Commands {\n     pub(crate) async fn execute(&self) -> Result<(), anyhow::Error> {\n         match self {\n             Commands::Load(l) => l.execute().await,\n             Commands::Unload(args) => execute_unload(args).await,\n             Commands::List(args) => execute_list(args).await,\n             Commands::Get(args) => execute_get(args)\n                 .await\n                 .map_err(|e| anyhow!(\"get error: {e}\")),\n             Commands::Image(i) => i.execute().await,\n         }?;\n \n         Ok(())\n     }\n }\n",
