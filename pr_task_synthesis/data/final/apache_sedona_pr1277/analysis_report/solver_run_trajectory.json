            "output": "<path>/workspace/spark/common/src/test/scala/org/apache/sedona/sql/functions/STS2CellIDs.scala</path>\n<type>file</type>\n<content>\n1: /*\n2:  * Licensed to the Apache Software Foundation (ASF) under one\n3:  * or more contributor license agreements.  See the NOTICE file\n4:  * distributed with this work for additional information\n5:  * regarding copyright ownership.  The ASF licenses this file\n6:  * to you under the Apache License, Version 2.0 (the\n7:  * \"License\"); you may not use this file except in compliance\n8:  * with the License.  You may obtain a copy of the License at\n9:  *\n10:  *   http://www.apache.org/licenses/LICENSE-2.0\n11:  *\n12:  * Unless required by applicable law or agreed to in writing,\n13:  * software distributed under the License is distributed on an\n14:  * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\n15:  * KIND, either express or implied.  See the License for the\n16:  * specific language governing permissions and limitations\n17:  * under the License.\n18:  */\n19: package org.apache.sedona.sql.functions\n20: \n21: import org.apache.sedona.sql.{GeometrySample, TestBaseScala}\n22: import org.apache.spark.sql.functions.{col, expr, lit, monotonically_increasing_id}\n23: import org.scalatest.{GivenWhenThen, Matchers}\n24: \n25: import scala.collection.mutable\n26: \n27: class STS2CellIDs extends TestBaseScala with Matchers with GeometrySample with GivenWhenThen {\n28:   import sparkSession.implicits._\n29: \n30:   describe(\"should pass ST_S2CellIDs\"){\n31: \n32:     it(\"should return null while using ST_S2CellIDs when geometry is empty\") {\n33:       val geometryTable = sparkSession.sparkContext.parallelize(1 to 10).toDF()\n34:         .withColumn(\"geom\", lit(null))\n35: \n36:       When(\"using ST_MakePolygon on null geometries\")\n37:       val geometryTableWithCellIDs = geometryTable\n38:         .withColumn(\"cell_ids\", expr(\"ST_S2CellIDs(geom, 4)\"))\n39:         .select(\"cell_ids\").collect().filter(\n40:         r => r.get(0)!= null\n41:       )\n42: \n43:       Then(\"no exception should be raised\")\n44:       require(geometryTableWithCellIDs.isEmpty)\n45:     }\n46: \n47:     it(\"should correctly return array of cell ids use of ST_S2CellIDs\"){\n48:       Given(\"DataFrame with valid Geometries\")\n49:       val geometryTable = Seq(\n50:         \"POINT(1 2)\",\n51:         \"LINESTRING(-5 8, -6 1, -8 6, -2 5, -6 1, -5 8)\",\n52:         \"POLYGON ((75 29, 77 29, 77 29, 75 29))\"\n53: \n54:       ).map(geom => Tuple1(wktReader.read(geom))).toDF(\"geom\")\n55: \n56:       When(\"generate ST_S2CellIDs from those geometries\")\n57:       val geometryDfWithCellIDs = geometryTable\n58:         .withColumn(\"cell_ids\", expr(\"ST_S2CellIDs(geom, 5)\"))\n59: \n60:       Then(\"valid should have list of Long type cell ids returned\")\n61:       geometryDfWithCellIDs.select(\"cell_ids\").collect().foreach(\n62:         r => require(r.get(0).isInstanceOf[mutable.WrappedArray[Long]] && r.size > 0)\n63:       )\n64:     }\n65: \n66:     it(\"use ST_S2CellIDs for spatial join\") {\n67:       Given(\"DataFrame with valid line strings\")\n68:       val polygonDf = sparkSession.read.format(\"csv\").option(\"delimiter\", \"\\t\").option(\"header\", \"false\").load(geojsonInputLocation)\n69:         .select(expr(\"ST_GeomFromGeoJSON(_c0)\").as(\"countyshape\"))\n70:         .select(\n71:         monotonically_increasing_id.as(\"id\"),\n72:         col(\"countyshape\").as(\"geom\")\n73:       ).limit(100)\n74:       val rightPolygons = polygonDf.filter(\"id > 50\")\n75:       rightPolygons.createOrReplaceTempView(\"rights\")\n76:       // generate a sub list of polygons\n77:       val leftPolygons = polygonDf.filter(\"id <= 50\")\n78:       leftPolygons.createOrReplaceTempView(\"lefts\")\n79:       When(\"generate the cellIds for both set of polygons, and explode into separate rows, join them by cellIds\")\n80:       val joinedDf = sparkSession.sql(\n81:         \"\"\"\n82:           |with lcs as (\n83:           | select id, geom, explode(ST_S2CellIDs(geom, 15)) as cellId from lefts\n84:           |)\n85:           |, rcs as (\n86:           | select id, geom, explode(ST_S2CellIDs(geom, 15)) as cellId from rights\n87:           |)\n88:           |select sum(if(ST_Intersects(lcs.geom, rcs.geom), 1, 0)) count_true_positive, count(1) count_positive from lcs join rcs on lcs.cellId = rcs.cellId\n89:           |\"\"\".stripMargin\n90:       )\n91:       Then(\"the geoms joined by cell ids should all really intersect in this case.\" +\n92:         \"Note that, cellIds equal doesn't necessarily mean the geoms intersect.\" +\n93:         \"If a coordinate fall on the border of 2 cells, S2 cover it with both cells. Use s2_intersects to filter out false positives\")\n94:       val res = joinedDf.collect()(0)\n95:       require(\n96:         res.get(1).asInstanceOf[Long] == 48\n97:       )\n98:       require(\n99:         res.get(0) == res.get(1)\n100:       )\n101:     }\n102:   }\n103: }\n\n(End of file - total 103 lines)\n</content>",
