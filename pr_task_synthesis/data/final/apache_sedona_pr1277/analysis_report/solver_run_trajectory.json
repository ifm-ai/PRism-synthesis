lection implementations into single Geometry types (Polygon, LineString, Point)\n876:         List<Geometry> geoms = GeomUtils.extractGeometryCollection(input);\n877:         for (Geometry geom : geoms) {\n878:             if (geom instanceof Polygon) {\n879:                 cellIds.addAll(H3Utils.polygonToCells((Polygon) geom, level, fullCover));\n880:             } else if (geom instanceof LineString) {\n881:                 cellIds.addAll(H3Utils.lineStringToCells((LineString) geom, level, fullCover));\n882:             } else if (geom instanceof Point){\n883:                 cellIds.add(H3Utils.coordinateToCell(geom.getCoordinate(), level));\n884:             } else {\n885:                 // if not type of polygon, point or lienSting, we cover its MBR\n886:                 cellIds.addAll(H3Utils.polygonToCells((Polygon)geom.getEnvelope(), level, fullCover));\n887:             }\n888:         }\n889:         return cellIds.toArray(new Long[0]);\n890:     }\n891: \n892:     /**\n893:      * return the distance between 2 cells, if the native h3 function doesn't work, use our approximation function for shortest path and use the size - 1 as distance\n894:      * @param cell1 source cell\n895:      * @param cell2 destination cell\n896:      * @return\n897:      */\n898:     public static long h3CellDistance(long cell1, long cell2) {\n899:         int resolution = H3Utils.h3.getResolution(cell1);\n900:         if (resolution != H3Utils.h3.getResolution(cell2)) {\n901:             throw new IllegalArgumentException(\"The argument cells should be of the same resolution\");\n902:         }\n903:         try {\n904:             return H3Utils.h3.gridDistance(cell1, cell2);\n905:         } catch (H3Exception e) {\n906:             // approximate if the original function hit error\n907:             return H3Utils.approxPathCells(\n908:                     H3Utils.cellToCoordinate(cell1),\n909:                     H3Utils.cellToCoordinate(cell2),\n910:                     resolution,\n911:                     true\n912:             ).size() - 1;\n913:         }\n914:     }\n915: \n916:     /**\n917:      * get the neighbor cells of the input cell by h3.gridDisk function\n918:      * @param cell: original cell\n919:      * @param k: the k number of rings spread from the original cell\n920:      * @param exactDistance: if exactDistance is true, it will only return the cells on the exact kth ring, else will return all 0 - kth neighbors\n921:      * @return\n922:      */\n923:     public static Long[] h3KRing(long cell, int k, boolean exactDistance) {\n924:         Set<Long> cells = new LinkedHashSet<>(H3Utils.h3.gridDisk(cell, k));\n925:         if (exactDistance && k > 0) {\n926:             List<Long> tbdCells = H3Utils.h3.gridDisk(cell, k - 1);\n927:             tbdCells.forEach(cells::remove);\n928:         }\n929:         return cells.toArray(new Long[0]);\n930:     }\n931: \n932:     /**\n933:      * get the neighbor cells of the input cell by h3.gridDisk function\n934:      * @param cells: the set of cells\n935:      * @return Multiple Polygons reversed\n936:      */\n937:     public static Geometry h3ToGeom(long[] cells) {\n938:         GeometryFactory geomFactory = new GeometryFactory();\n939:         Collection<Long> h3 = Arrays.stream(cells).boxed().collect(Collectors.toList());\n940:         return geomFactory.createMultiPolygon(\n941:                 H3Utils.h3.cellsToMultiPolygon(h3, true).stream().map(\n942:                         shellHoles -> {\n943:                             List<LinearRing> rings = shellHoles.stream().map(\n944:                                     shell -> geomFactory.createLinearRing(shell.stream().map(latLng -> new Coordinate(latLng.lng, latLng.lat)).toArray(Coordinate[]::new))\n945:                             ).collect(Collectors.toList());\n946:                             LinearRing shell = rings.remove(0);\n947:                             if (rings.isEmpty()) {\n948:                                 return geomFactory.createPolygon(shell);\n949:                             } else {\n950:                                 return geomFactory.createPolygon(shell, rings.toArray(new LinearRing[0]));\n951:                             }\n952:                         }\n953:                 ).toArray(Polygon[]::new)\n954:         );\n955:     }\n956: \n957:     // create static function named simplifyPreserveTopology\n958:     public static Geometry simplifyPreserveTopology(Geometry geometry, double distanceTolerance) {\n959:         return TopologyPreservingSimplifier.simplify(geometry, distanceTolerance);\n\n(Showing lines 840-959 of 1466. Use offset=960 to continue.)\n</content>",
