              "patch": "Index: spark/common/src/test/scala/org/apache/sedona/sql/functions/STS2ToGeom.scala\n===================================================================\n--- spark/common/src/test/scala/org/apache/sedona/sql/functions/STS2ToGeom.scala\t\n+++ spark/common/src/test/scala/org/apache/sedona/sql/functions/STS2ToGeom.scala\t\n@@ -0,0 +1,132 @@\n+/*\n+ * Licensed to the Apache Software Foundation (ASF) under one\n+ * or more contributor license agreements.  See the NOTICE file\n+ * distributed with this work for additional information\n+ * regarding copyright ownership.  The ASF licenses this file\n+ * to you under the Apache License, Version 2.0 (the\n+ * \"License\"); you may not use this file except in compliance\n+ * with the License.  You may obtain a copy of the License at\n+ *\n+ *   http://www.apache.org/licenses/LICENSE-2.0\n+ *\n+ * Unless required by applicable law or agreed to in writing,\n+ * software distributed under the License is distributed on an\n+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\n+ * KIND, either express or implied.  See the License for the\n+ * specific language governing permissions and limitations\n+ * under the License.\n+ */\n+package org.apache.sedona.sql.functions\n+\n+import org.apache.sedona.sql.{GeometrySample, TestBaseScala}\n+import org.apache.spark.sql.functions.{col, expr, lit}\n+import org.scalatest.{GivenWhenThen, Matchers}\n+\n+class STS2ToGeom extends TestBaseScala with Matchers with GeometrySample with GivenWhenThen {\n+  import sparkSession.implicits._\n+\n+  describe(\"should pass ST_S2ToGeom\") {\n+\n+    it(\"should convert S2 cell IDs to MultiPolygon geometry\") {\n+      Given(\"a polygon geometry\")\n+      val polygonWKT = \"POLYGON ((75 29, 77 29, 77 31, 75 31, 75 29))\"\n+      val polygonDf = Seq(Tuple1(wktReader.read(polygonWKT))).toDF(\"geom\")\n+\n+      When(\"generating S2 cell IDs and converting back to geometry\")\n+      val resultDf = polygonDf\n+        .withColumn(\"cell_ids\", expr(\"ST_S2CellIDs(geom, 10)\"))\n+        .withColumn(\"reconstructed_geom\", expr(\"ST_S2ToGeom(cell_ids)\"))\n+\n+      Then(\"the reconstructed geometry should be a MultiPolygon\")\n+      val result = resultDf.select(\"reconstructed_geom\").collect()(0)\n+      val reconstructedGeom = result.get(0)\n+      require(reconstructedGeom != null)\n+      require(reconstructedGeom.toString.startsWith(\"MULTIPOLYGON\"))\n+    }\n+\n+    it(\"should preserve order of cell IDs\") {\n+      Given(\"a set of S2 cell IDs\")\n+      val cellIdsDf = Seq(\n+        Tuple1(Array[Long](537040471067344896L, 537040471067344897L, 537040471067344898L))\n+      ).toDF(\"cell_ids\")\n+\n+      When(\"converting to geometry\")\n+      val resultDf = cellIdsDf.withColumn(\"geom\", expr(\"ST_S2ToGeom(cell_ids)\"))\n+\n+      Then(\"the geometry should be created successfully\")\n+      val result = resultDf.select(\"geom\").collect()(0)\n+      require(result.get(0) != null)\n+    }\n+\n+    it(\"should work with ST_Collect to produce MultiPolygon\") {\n+      Given(\"multiple S2 cell ID arrays\")\n+      val cellIdsDf = Seq(\n+        Tuple1(Array[Long](537040471067344896L)),\n+        Tuple1(Array[Long](537040471067344897L))\n+      ).toDF(\"cell_ids\")\n+\n+      When(\"converting each to geometry and collecting\")\n+      val resultDf = cellIdsDf\n+        .withColumn(\"geom\", expr(\"ST_S2ToGeom(cell_ids)\"))\n+        .withColumn(\"collected\", expr(\"ST_Collect(geom)\"))\n+\n+      Then(\"the collected geometry should be a MultiPolygon\")\n+      val result = resultDf.select(\"collected\").collect()(0)\n+      val collectedGeom = result.get(0)\n+      require(collectedGeom != null)\n+      require(collectedGeom.toString.startsWith(\"MULTIPOLYGON\"))\n+    }\n+\n+    it(\"should intersect with source geometry at specific indices\") {\n+      Given(\"a polygon geometry\")\n+      val polygonWKT = \"POLYGON ((75 29, 77 29, 77 31, 75 31, 75 29))\"\n+      val polygonDf = Seq(Tuple1(wktReader.read(polygonWKT))).toDF(\"geom\")\n+\n+      When(\"generating S2 cell IDs and converting back to geometry\")\n+      val resultDf = polygonDf\n+        .withColumn(\"cell_ids\", expr(\"ST_S2CellIDs(geom, 10)\"))\n+        .withColumn(\"cell_array\", expr(\"ST_S2ToGeom(cell_ids)\"))\n+\n+      Then(\"check intersections at indices 0, 20, and 100 if they exist\")\n+      val result = resultDf.select(\"geom\", \"cell_array\", \"cell_ids\").collect()(0)\n+      val sourceGeom = result.get(0)\n+      val reconstructedGeom = result.get(1)\n+      val cellIds = result.get(2).asInstanceOf[org.apache.spark.sql.catalyst.util.ArrayData]\n+\n+      if (cellIds.numElements() > 0) {\n+        val singleCellGeom = expr(\"ST_S2ToGeom(array(cell_ids[0]))\").eval(resultDf.first())\n+        require(singleCellGeom != null)\n+        val intersects = expr(\"ST_Intersects(geom, ST_S2ToGeom(array(cell_ids[0])))\").eval(resultDf.first())\n+        require(intersects.asInstanceOf[Boolean])\n+      }\n+    }\n+\n+    it(\"should handle empty array of cell IDs\") {\n+      Given(\"an empty array of cell IDs\")\n+      val emptyDf = Seq(Tuple1(Array[Long]())).toDF(\"cell_ids\")\n+\n+      When(\"converting to geometry\")\n+      val resultDf = emptyDf.withColumn(\"geom\", expr(\"ST_S2ToGeom(cell_ids)\"))\n+\n+      Then(\"the result should be an empty MultiPolygon or null\")\n+      val result = resultDf.select(\"geom\").collect()(0)\n+      val geom = result.get(0)\n+      require(geom == null || geom.toString.contains(\"MULTIPOLYGON\"))\n+    }\n+\n+    it(\"should work with Java long array input\") {\n+      Given(\"S2 cell IDs as long array\")\n+      val cellIdsDf = Seq(\n+        Tuple1(Array[Long](537040471067344896L, 537040471067344897L))\n+      ).toDF(\"cell_ids\")\n+\n+      When(\"converting to geometry\")\n+      val resultDf = cellIdsDf.withColumn(\"geom\", expr(\"ST_S2ToGeom(cell_ids)\"))\n+\n+      Then(\"the geometry should be created successfully\")\n+      val result = resultDf.collect()\n+      require(result.length > 0)\n+      require(result(0).get(1) != null)\n+    }\n+  }\n+}\n",
