ine.getCoordinates()));\n49:     }\n50: \n51:     public static S2Loop toS2Loop(LinearRing ring) {\n52:         return new S2Loop(\n53:                 Orientation.isCCW(ring.getCoordinates()) ? toS2Points(ring.getCoordinates()) : toS2Points(ring.reverse().getCoordinates())\n54:         );\n55:     }\n56: \n57:     public static S2Polygon toS2Polygon(Polygon polygon) {\n58:         List<LinearRing> rings = new ArrayList<>();\n59:         rings.add(polygon.getExteriorRing());\n60:         for (int i = 0; i < polygon.getNumInteriorRing(); i++){\n61:             rings.add(polygon.getInteriorRingN(i));\n62:         }\n63:         List<S2Loop> s2Loops = rings.stream().map(\n64:                 S2Utils::toS2Loop\n65:         ).collect(Collectors.toList());\n66:         return new S2Polygon(s2Loops);\n67:     }\n68: \n69:     public static List<S2CellId> s2RegionToCellIDs(S2Region region, int minLevel, int maxLevel, int maxNum) {\n70:         S2RegionCoverer.Builder coverBuilder = S2RegionCoverer.builder();\n71:         coverBuilder.setMinLevel(minLevel);\n72:         coverBuilder.setMaxLevel(maxLevel);\n73:         coverBuilder.setMaxCells(maxNum);\n74:         return coverBuilder.build().getCovering(region).cellIds();\n75:     }\n76: \n77:     public static S2CellId coordinateToCellID(Coordinate coordinate, int level) {\n78:         return S2CellId.fromPoint(S2Utils.toS2Point(coordinate)).parent(level);\n79:     }\n80: \n81:     public static List<S2CellId> roundCellsToSameLevel(List<S2CellId> cellIDs, int level) {\n82:         Set<Long> results = new HashSet<>();\n83:         for (S2CellId cellID : cellIDs) {\n84:             if (cellID.level() > level) {\n85:                 results.add(cellID.parent(level).id());\n86:             } else if(cellID.level() < level) {\n87:                 for (S2CellId c = cellID.childBegin(level); !c.equals(cellID.childEnd(level)); c = c.next()) {\n88:                     results.add(c.id());\n89:                 }\n90:             } else {\n91:                 results.add(cellID.id());\n92:             }\n93:         }\n94:         return results.stream().map(S2CellId::new).collect(Collectors.toList());\n95:     }\n96: \n97:     public static Polygon toJTSPolygon(S2CellId cellId) {\n98:         S2LatLngRect bound = new S2Cell(cellId).getRectBound();\n99:         Coordinate[] coords = new Coordinate[5];\n100:         int[] iters = new int[] {0, 1, 2, 3, 0};\n101:         for (int i = 0;i < 5; i++) {\n102:             coords[i] = new Coordinate(bound.getVertex(iters[i]).lngDegrees(), bound.getVertex(iters[i]).latDegrees());\n103:         }\n104:         return new GeometryFactory().createPolygon(coords);\n105:     }\n106: \n107:     public static S2Region toS2Region(Geometry geom) throws IllegalArgumentException {\n108:         if (geom instanceof Polygon) {\n109:             return S2Utils.toS2Polygon((Polygon) geom);\n110:         } else if (geom instanceof LineString) {\n111:             return S2Utils.toS2PolyLine((LineString) geom);\n112:         }\n113:         throw new IllegalArgumentException(\n114:                 \"only object of Polygon, LinearRing, LineString type can be converted to S2Region\"\n115:         );\n116:     }\n117: }\n\n(End of file - total 117 lines)\n</content>",
