              "oldString": "    /**\n     * Convert S2 cell IDs to polygon geometries\n     * @param cells array of S2 cell IDs\n     * @return MultiPolygon geometry representing all cells\n     */\n    public static Geometry s2ToGeom(long[] cells) {\n        GeometryFactory geomFactory = new GeometryFactory();\n        List<Polygon> polygons = new ArrayList<>();\n        for (long cellId : cells) {\n            S2CellId id = new S2CellId(cellId);\n            Polygon polygon = S2Utils.toJTSPolygon(id);\n            polygons.add(polygon);\n        }\n        return geomFactory.createMultiPolygon(polygons.toArray(new Polygon[0]));\n    }",
              "newString": "    /**\n     * Convert S2 cell IDs to polygon geometries\n     * @param cells array of S2 cell IDs\n     * @return MultiPolygon geometry representing all cells\n     */\n    public static Geometry s2ToGeom(long[] cells) {\n        GeometryFactory geomFactory = new GeometryFactory();\n        List<Polygon> polygons = new ArrayList<>();\n        for (long cellId : cells) {\n            S2CellId id = new S2CellId(cellId);\n            Polygon polygon = S2Utils.toJTSPolygon(id);\n            polygons.add(polygon);\n        }\n        return geomFactory.createMultiPolygon(polygons.toArray(new Polygon[0]));\n    }\n\n    /**\n     * Convert S2 cell IDs to polygon geometries (boxed Long array variant)\n     * @param cells array of S2 cell IDs\n     * @return MultiPolygon geometry representing all cells\n     */\n    public static Geometry s2ToGeom(Long[] cells) {\n        return s2ToGeom(Arrays.stream(cells).mapToLong(Long::longValue).toArray());\n    }"
