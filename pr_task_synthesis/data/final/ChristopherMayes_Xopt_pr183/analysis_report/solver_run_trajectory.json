          "state": {
            "status": "completed",
            "input": {
              "content": "\"\"\"\nTest that CNSGAGenerator maintains population_size regardless of:\n- How data is added or evaluated\n- Multiple calls to generate(n)\n- Chunked evaluations\n- Adding DataFrames with duplicate/non-unique indices\n\"\"\"\nimport pandas as pd\nimport numpy as np\nfrom xopt.generators.ga.cnsga import CNSGAGenerator\nfrom xopt.resources.test_functions.tnk import tnk_vocs\n\n\ndef test_population_size_maintained():\n    \"\"\"Test that population stays at exactly population_size\"\"\"\n    population_size = 32\n    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n    \n    # Generate initial candidates\n    n_generate = 10\n    candidates = generator.generate(n_generate)\n    assert len(candidates) == n_generate\n    \n    # Population should still be None (not created until data is added)\n    assert generator.population is None\n    \n    # Create evaluated data\n    df = pd.DataFrame(candidates)\n    df[\"y1\"] = np.random.rand(len(df))\n    df[\"y2\"] = np.random.rand(len(df))\n    df[\"c1\"] = np.random.rand(len(df))\n    df[\"c2\"] = np.random.rand(len(df))\n    \n    # Add data - should create population\n    generator.add_data(df)\n    assert generator.population is not None\n    assert len(generator.population) == population_size, \\\n        f\"Population size {len(generator.population)} != {population_size}\"\n    \n    print(\"✓ Initial population created with correct size\")\n\n\ndef test_chunked_evaluation():\n    \"\"\"Test that chunked evaluations don't cause population to exceed limit\"\"\"\n    population_size = 32\n    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n    \n    # Generate more than population_size candidates\n    n_generate = 50\n    all_candidates = []\n    for _ in range(5):\n        candidates = generator.generate(n_generate // 5)\n        all_candidates.extend(candidates)\n    \n    # Create evaluated data\n    df = pd.DataFrame(all_candidates)\n    df[\"y1\"] = np.random.rand(len(df))\n    df[\"y2\"] = np.random.rand(len(df))\n    df[\"c1\"] = np.random.rand(len(df))\n    df[\"c2\"] = np.random.rand(len(df))\n    \n    # Add data in chunks\n    chunk_size = 10\n    for i in range(0, len(df), chunk_size):\n        chunk = df.iloc[i:i+chunk_size]\n        generator.add_data(chunk)\n        \n        # Population should never exceed limit\n        if generator.population is not None:\n            assert len(generator.population) == population_size, \\\n                f\"After chunk {i}, population size {len(generator.population)} != {population_size}\"\n    \n    print(\"✓ Chunked evaluation maintains population size\")\n\n\ndef test_duplicate_index_addition():\n    \"\"\"Test that adding DataFrames with duplicate indices doesn't cause issues\"\"\"\n    population_size = 32\n    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n    \n    # Generate and add initial population\n    candidates = generator.generate(population_size)\n    df = pd.DataFrame(candidates)\n    df[\"y1\"] = np.random.rand(len(df))\n    df[\"y2\"] = np.random.rand(len(df))\n    df[\"c1\"] = np.random.rand(len(df))\n    df[\"c2\"] = np.random.rand(len(df))\n    generator.add_data(df)\n    \n    assert len(generator.population) == population_size\n    \n    # Now add data with duplicate indices (all set to same value)\n    new_candidates = generator.generate(10)\n    new_df = pd.DataFrame(new_candidates)\n    new_df[\"y1\"] = np.random.rand(len(new_df))\n    new_df[\"y2\"] = np.random.rand(len(new_df))\n    new_df[\"c1\"] = np.random.rand(len(new_df))\n    new_df[\"c2\"] = np.random.rand(len(new_df))\n    \n    # Set all indices to the same value (duplicate indices)\n    new_df.index = [0] * len(new_df)\n    \n    # This should NOT raise an exception and should maintain population size\n    try:\n        generator.add_data(new_df)\n        assert len(generator.population) == population_size, \\\n            f\"After duplicate index addition, population size {len(generator.population)} != {population_size}\"\n        print(\"✓ Duplicate index addition handled correctly\")\n    except Exception as e:\n        raise AssertionError(f\"Adding duplicate index DataFrame raised exception: {e}\")\n\n\ndef test_multiple_duplicate_additions():\n    \"\"\"Test multiple additions of duplicate-index DataFrames\"\"\"\n    population_size = 32\n    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n    \n    # Generate and add initial population\n    candidates = generator.generate(population_size)\n    df = pd.DataFrame(candidates)\n    df[\"y1\"] = np.random.rand(len(df))\n    df[\"y2\"] = np.random.rand(len(df))\n    df[\"c1\"] = np.random.rand(len(df))\n    df[\"c2\"] = np.random.rand(len(df))\n    generator.add_data(df)\n    \n    # Add multiple DataFrames with duplicate indices\n    for iteration in range(5):\n        new_candidates = generator.generate(10)\n        new_df = pd.DataFrame(new_candidates)\n        new_df[\"y1\"] = np.random.rand(len(new_df))\n        new_df[\"y2\"] = np.random.rand(len(new_df))\n        new_df[\"c1\"] = np.random.rand(len(new_df))\n        new_df[\"c2\"] = np.random.rand(len(new_df))\n        \n        # Set all indices to the same value\n        new_df.index = [iteration] * len(new_df)\n        \n        generator.add_data(new_df)\n        assert len(generator.population) == population_size, \\\n            f\"After iteration {iteration}, population size {len(generator.population)} != {population_size}\"\n    \n    print(\"✓ Multiple duplicate index additions handled correctly\")\n\n\ndef test_mixed_operations():\n    \"\"\"Test a sequence of generate, chunked evaluate, and duplicate index additions\"\"\"\n    population_size = 32\n    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n    \n    # Phase 1: Generate and add initial population\n    candidates = generator.generate(population_size)\n    df = pd.DataFrame(candidates)\n    df[\"y1\"] = np.random.rand(len(df))\n    df[\"y2\"] = np.random.rand(len(df))\n    df[\"c1\"] = np.random.rand(len(df))\n    df[\"c2\"] = np.random.rand(len(df))\n    generator.add_data(df)\n    assert len(generator.population) == population_size\n    \n    # Phase 2: Generate more and add in chunks\n    for _ in range(3):\n        more_candidates = generator.generate(20)\n        more_df = pd.DataFrame(more_candidates)\n        more_df[\"y1\"] = np.random.rand(len(more_df))\n        more_df[\"y2\"] = np.random.rand(len(more_df))\n        more_df[\"c1\"] = np.random.rand(len(more_df))\n        more_df[\"c2\"] = np.random.rand(len(more_df))\n        \n        # Add in chunks of 5\n        for i in range(0, len(more_df), 5):\n            chunk = more_df.iloc[i:i+5]\n            generator.add_data(chunk)\n            if generator.population is not None:\n                assert len(generator.population) == population_size\n    \n    # Phase 3: Add DataFrames with duplicate indices\n    for dup_value in [100, 200, 300]:\n        dup_candidates = generator.generate(15)\n        dup_df = pd.DataFrame(dup_candidates)\n        dup_df[\"y1\"] = np.random.rand(len(dup_df))\n        dup_df[\"y2\"] = np.random.rand(len(dup_df))\n        dup_df[\"c1\"] = np.random.rand(len(dup_df))\n        dup_df[\"c2\"] = np.random.rand(len(dup_df))\n        dup_df.index = [dup_value] * len(dup_df)\n        \n        generator.add_data(dup_df)\n        assert len(generator.population) == population_size\n    \n    # Phase 4: Verify generator can still produce valid candidates\n    final_candidates = generator.generate(5)\n    assert len(final_candidates) == 5\n    for candidate in final_candidates:\n        assert \"x1\" in candidate\n        assert \"x2\" in candidate\n    \n    print(\"✓ Mixed operations maintain population size and generator functionality\")\n\n\ndef test_generate_after_population_reset():\n    \"\"\"Test that generate works correctly after population is established\"\"\"\n    population_size = 32\n    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n    \n    # Create initial population\n    candidates = generator.generate(population_size)\n    df = pd.DataFrame(candidates)\n    df[\"y1\"] = np.random.rand(len(df))\n    df[\"y2\"] = np.random.rand(len(df))\n    df[\"c1\"] = np.random.rand(len(df))\n    df[\"c2\"] = np.random.rand(len(df))\n    generator.add_data(df)\n    \n    # Generate new candidates\n    new_candidates = generator.generate(10)\n    assert len(new_candidates) == 10\n    \n    # Verify candidates are within bounds\n    for candidate in new_candidates:\n        assert 0 <= candidate[\"x1\"] <= 3.14159\n        assert 0 <= candidate[\"x2\"] <= 3.14159\n    \n    print(\"✓ Generate works correctly after population is established\")\n\n\nif __name__ == \"__main__\":\n    test_population_size_maintained()\n    test_chunked_evaluation()\n    test_duplicate_index_addition()\n    test_multiple_duplicate_additions()\n    test_mixed_operations()\n    test_generate_after_population_reset()\n    print(\"\\n✅ All tests passed!\")\n",
              "filePath": "/workspace/test_population_fix.py"
