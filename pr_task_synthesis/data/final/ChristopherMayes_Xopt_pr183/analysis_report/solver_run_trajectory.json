f._toolbox = cnsga_toolbox(self.vocs, selection=\"auto\")\n54: \n55:         if self.population_file is not None:\n56:             self.load_population_csv(self.population_file)\n57: \n58:         if self.output_path is not None:\n59:             assert os.path.isdir(self.output_path), \"Output directory does not exist\"\n60: \n61:         # if data is not None:\n62:         #    self.population = cnsga_select(data, n_pop, vocs, self.toolbox)\n63: \n64:     def create_children(self) -> List[Dict]:\n65:         # No population, so create random children\n66:         if self.population is None:\n67:             # Special case when pop is loaded from file\n68:             if self._loaded_population is None:\n69:                 return self.vocs.random_inputs(self.n_pop, include_constants=False)\n70:             else:\n71:                 pop = self._loaded_population\n72:         else:\n73:             pop = self.population\n74: \n75:         # Use population to create children\n76:         inputs = cnsga_variation(\n77:             pop,\n78:             self.vocs,\n79:             self._toolbox,\n80:             crossover_probability=self.crossover_probability,\n81:             mutation_probability=self.mutation_probability,\n82:         )\n83:         return inputs.to_dict(orient=\"records\")\n84: \n85:     def add_data(self, new_data: pd.DataFrame):\n86:         if new_data is not None:\n87:             self._offspring = pd.concat([self._offspring, new_data])\n88: \n89:             # Next generation\n90:             if len(self._offspring) >= self.n_pop:\n91:                 candidates = pd.concat([self.population, self._offspring])\n92:                 self.population = cnsga_select(\n93:                     candidates, self.n_pop, self.vocs, self._toolbox\n94:                 )\n95: \n96:                 if self.output_path is not None:\n97:                     self.write_offspring()\n98:                     self.write_population()\n99: \n100:                 self._children = []  # reset children\n101:                 self._offspring = None  # reset offspring\n102: \n103:     def generate(self, n_candidates) -> list[dict]:\n104:         \"\"\"\n105:         generate `n_candidates` candidates\n106: \n107:         \"\"\"\n108: \n109:         # Make sure we have enough children to fulfill the request\n110:         while len(self._children) < n_candidates:\n111:             self._children.extend(self.create_children())\n112: \n113:         return [self._children.pop() for _ in range(n_candidates)]\n114: \n115:     def write_offspring(self, filename=None):\n116:         \"\"\"\n117:         Write the current offspring to a CSV file.\n118: \n119:         Similar to write_population\n120:         \"\"\"\n121:         if self._offspring is None:\n122:             logger.warning(\"No offspring to write\")\n123:             return\n124: \n125:         if filename is None:\n126:             filename = f\"{self.name}_offspring_{xopt.utils.isotime(include_microseconds=True)}.csv\"\n127:             filename = os.path.join(self.output_path, filename)\n128: \n129:         self._offspring.to_csv(filename, index_label=\"xopt_index\")\n130: \n131:     def write_population(self, filename=None):\n132:         \"\"\"\n133:         Write the current population to a CSV file.\n134: \n135:         Similar to write_offspring\n136:         \"\"\"\n137:         if self.population is None:\n138:             logger.warning(\"No population to write\")\n139:             return\n140: \n141:         if filename is None:\n142:             filename = f\"{self.name}_population_{xopt.utils.isotime(include_microseconds=True)}.csv\"\n143:             filename = os.path.join(self.output_path, filename)\n144: \n145:         self.population.to_csv(filename, index_label=\"xopt_index\")\n146: \n147:     def load_population_csv(self, filename):\n148:         \"\"\"\n149:         Read a population from a CSV file.\n150:         These will be reverted back to children for re-evaluation.\n151:         \"\"\"\n152:         pop = pd.read_csv(filename, index_col=\"xopt_index\")\n153:         self._loaded_population = pop\n154:         # This is a list of dicts\n155:         self._children = self.vocs.convert_dataframe_to_inputs(\n156:             pop[self.vocs.variable_names], include_constants=False\n157:         ).to_dict(orient=\"records\")\n158:         logger.info(f\"Loaded population of len {len(pop)} from file: {filename}\")\n159: \n160:     @property\n161:     def n_pop(self):\n162:         \"\"\"\n163:         Convenience name for `options.population_size`\n164:         \"\"\"\n165:         return self.population_size\n166: \n167: \n168: def uniform(low, up, size=None):\n169:     \"\"\" \"\"\"\n170:     try:\n171:         return [random.uniform(a, b) for a, b in zip(low, up)]\n172:     except TypeError:\n173:         return [random.uniform(a, b) for a, b in zip([low] * size, [up] * size)]\n174: \n175: \n176: def cnsga_toolbox(vocs, selection=\"auto\"):\n177:     \"\"\"\n178:     Creates a DEAP toolbox from VOCS dict for use with cnsga.\n179: \n180:     Selection options:\n181: \n182:     nsga2: Standard NSGA2 [Deb2002] selection\n183:     nsga3: NSGA3 [Deb2014] selection\n184:     spea2: SPEA-II [Zitzler2001] selection\n185:     auto: will choose nsga2 for <= 2 objectives, otherwise nsga3\n186: \n187: \n188:     See DEAP code for details.\n189: \n190:     \"\"\"\n191: \n192:     var, obj, con = vocs.variables, vocs.objectives, vocs.constraints\n193:     n_var = len(var)\n194:     n_obj = len(obj)\n195:     n_con = len(con)\n196: \n197:     var_labels = vocs.variable_names\n198:     obj_labels = vocs.objective_names\n199: \n200:     bound_low, bound_up = vocs.bounds\n201:     # DEAP does not like arrays, needs tuples.\n202:     bound_low = tuple(bound_low)\n203:     bound_up = tuple(bound_up)\n204: \n205:     # creator should assign already weighted values (for minimization)\n206:     weights = tuple([-1] * n_obj)\n207: \n208:     # Create MyFitness\n209:     if \"MyFitness\" in dir(deap_creator):\n210:         del deap_creator.MyFitness\n211: \n212:     if n_con == 0:\n213:         # Normal Fitness class\n214:         deap_creator.create(\n215:             \"MyFitness\", deap_base.Fitness, weights=weights, labels=obj_labels\n216:         )\n217:     else:\n218:         # Fitness with Constraints\n219:         deap_creator.create(\n220:             \"MyFitness\",\n221:             FitnessWithConstraints,\n222:             weights=weights,\n223:             n_constraints=n_con,\n224:             labels=obj_labels,\n225:         )\n226: \n227:     # Create Individual. Check if exists first.\n228:     if \"Individual\" in dir(deap_creator):\n229:         del deap_creator.Individual\n230:     deap_creator.create(\n231:         \"Individual\",\n232:         array.array,\n233:         typecode=\"d\",\n234:         fitness=deap_creator.MyFitness,\n235:         labels=var_labels,\n236:     )\n237: \n238:     # Make toolbox\n239:     toolbox = deap_base.Toolbox()\n240: \n241:     # Register individual and population creation routines\n242:     # No longer needed\n243:     # toolbox.register('attr_float', uniform, bound_low, bound_up)\n244:     # toolbox.register('individual', deap_tools.initIterate, creator.Individual, toolbox.attr_float)\n245:     # toolbox.register('population', deap_tools.initRepeat, list, toolbox.individual)\n246: \n247:     # Register mate and mutate functions\n248:     toolbox.register(\n249:         \"mate\",\n250:         deap_tools.cxSimulatedBinaryBounded,\n251:         low=bound_low,\n252:         up=bound_up,\n253:         eta=20.0,\n254:     )\n255:     toolbox.register(\n256:         \"mutate\",\n257:         deap_tools.mutPolynomialBounded,\n258:         low=bound_low,\n259:         up=bound_up,\n260:         eta=20.0,\n261:         indpb=1.0 / n_var,\n262:     )\n263: \n264:     # Register NSGA selection algorithm.\n265:     # NSGA-III should be better for 3 or more objectives\n266:     if selection == \"auto\":\n267:         selection = \"nsga2\"\n268:         # TODO: fix this\n269:         # if len(obj#) <= 2:\n270:         #     select#ion = 'nsga2'\n271:         # else# :\n272:         #     selection='nsga3'\n273: \n274:     if selection == \"nsga2\":\n275:         toolbox.register(\"select\", deap_tools.selNSGA2)\n276: \n277:     elif selection == \"spea2\":\n278:         toolbox.register(\"select\", deap_tools.selSPEA2)\n279: \n280:     else:\n281:         raise ValueError(f\"Invalid selection algorithm: {selection}\")\n282: \n283:     logger.info(\n284:         f\"Created toolbox with {n_var} variables, {n_con} constraints, and {n_obj} objectives.\"\n285:     )\n286:     logger.info(f\"    Using selection algorithm: {selection}\")\n287: \n288:     return toolbox\n289: \n290: \n291: def pop_from_data(data, vocs):\n292:     \"\"\"\n293:     Return a list of DEAP deap_creator.Individual from a dataframe\n294:     \"\"\"\n295:     ix = data.index.to_numpy()\n296:     v = vocs.variable_data(data).to_numpy()\n297:     o = vocs.objective_data(data).to_numpy()\n298:     c = vocs.constraint_data(data).to_numpy()\n299: \n300:     pop = list(map(deap_creator.Individual, v))\n301:     for i, ind in enumerate(pop):\n302:         ind.fitness.values = tuple(o[i, :])\n303:         if c.size:\n304:             ind.fitness.cvalues = tuple(c[i, :])\n305: \n306:         ind.index = ix[i]\n307: \n308:     return pop\n309: \n310: \n311: def cnsga_select(data, n, vocs, toolbox):\n312:     \"\"\"\n313:     Applies DEAP's select algorithm to the population in data.\n314: \n315:     Note that this can be slow for large populations:\n316:         NSGA2: Order(M N^2) for M objectives, N individuals\n317:     \"\"\"\n318:     pop = pop_from_data(data, vocs)\n319:     selected = toolbox.select(pop, n)  # Order(n^2)\n320:     return data.loc[[ind.index for ind in selected]]\n321: \n322: \n323: def cnsga_variation(\n324:     data, vocs, toolbox, crossover_probability=0.9, mutation_probability=1.0\n325: ):\n326:     \"\"\"\n327:     Varies the population (from variables in data) by applying crossover and mutation\n328:     using DEAP's varAnd algorithm.\n329: \n330:     Returns an input dataframe with the new individuals to evaluate.\n331: \n332:     See: https://deap.readthedocs.io/en/master/api/algo.html#deap.algorithms.varAnd\n333:     \"\"\"\n334:     v = vocs.variable_data(data).to_numpy()\n335:     pop = list(map(deap_creator.Individual, v))\n336: \n337:     children = deap_algorithms.varAnd(\n338:         pop, toolbox, crossover_probability, mutation_probability\n339:     )\n340:     vecs = [[float(x) for x in child] for child in children]\n341: \n342:     return vocs.convert_dataframe_to_inputs(\n343:         pd.DataFrame(vecs, columns=vocs.variable_names), include_constants=False\n344:     )\n\n(End of file - total 344 lines)\n</content>",
