              "patch": "Index: tests/generators/ga/test_cnsga.py\n===================================================================\n--- tests/generators/ga/test_cnsga.py\t\n+++ tests/generators/ga/test_cnsga.py\t\n@@ -1,80 +1,180 @@\n+import pandas as pd\n+import numpy as np\n from xopt.base import Xopt\n from xopt.evaluator import Evaluator\n from xopt.generators.ga.cnsga import CNSGAGenerator\n from xopt.resources.test_functions.tnk import evaluate_TNK, tnk_vocs\n \n \n def test_cnsga():\n     X = Xopt(\n         generator=CNSGAGenerator(vocs=tnk_vocs),\n         evaluator=Evaluator(function=evaluate_TNK),\n         vocs=tnk_vocs,\n         max_evaluations=5,\n     )\n     X.run()\n \n \n def test_cnsga_from_yaml():\n     YAML = \"\"\"\n     max_evaluations: 10\n     dump_file: null\n     data: null\n     generator:\n         name: cnsga\n         population_size: 8\n         population_file: null\n \n     evaluator:\n         function: xopt.resources.test_functions.tnk.evaluate_TNK\n         function_kwargs:\n             sleep: 0\n             random_sleep: 0.1\n \n     vocs:\n         variables:\n             x1: [0, 3.14159]\n             x2: [0, 3.14159]\n         objectives: {y1: MINIMIZE, y2: MINIMIZE}\n         constraints:\n             c1: [GREATER_THAN, 0]\n             c2: [LESS_THAN, 0.5]\n         constants: {a: dummy_constant}\n     \"\"\"\n \n     X = Xopt(YAML)\n     # Patch in generator\n     X.run()\n     assert len(X.data) == 10\n     assert all(~X.data[\"xopt_error\"])\n \n \n def test_cnsga_no_constraints():\n     YAML = \"\"\"\n     max_evaluations: 10\n     dump_file: null\n     data: null\n     generator:\n         name: cnsga\n         population_size: 8\n         population_file: null\n \n     evaluator:\n         function: xopt.resources.test_functions.tnk.evaluate_TNK\n         function_kwargs:\n             sleep: 0\n             random_sleep: 0.1\n \n     vocs:\n         variables:\n             x1: [0, 3.14159]\n             x2: [0, 3.14159]\n         objectives: {y1: MINIMIZE, y2: MINIMIZE}\n         constraints: {}\n         constants: {a: dummy_constant}\n     \"\"\"\n \n     X = Xopt(YAML)\n     # Patch in generator\n     X.run()\n     assert len(X.data) == 10\n     assert all(~X.data[\"xopt_error\"])\n+\n+\n+def test_cnsga_population_size_with_duplicate_indices():\n+    \"\"\"\n+    Test that CNSGAGenerator maintains exactly population_size rows regardless of\n+    duplicate indices in added DataFrames.\n+    \n+    This tests the fix for using .iloc instead of .loc in cnsga_select to avoid\n+    selecting multiple rows for a single index label.\n+    \"\"\"\n+    population_size = 32\n+    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n+    \n+    # Generate initial candidates\n+    candidates = generator.generate(population_size)\n+    df = pd.DataFrame(candidates)\n+    \n+    # Add mock objective and constraint values\n+    df[\"y1\"] = np.random.rand(len(df))\n+    df[\"y2\"] = np.random.rand(len(df))\n+    df[\"c1\"] = np.random.rand(len(df))\n+    df[\"c2\"] = np.random.rand(len(df))\n+    \n+    # Add data - should create population\n+    generator.add_data(df)\n+    assert generator.population is not None\n+    assert len(generator.population) == population_size, \\\n+        f\"Initial population size {len(generator.population)} != {population_size}\"\n+    \n+    # Add data with duplicate indices (all set to same value)\n+    new_candidates = generator.generate(10)\n+    new_df = pd.DataFrame(new_candidates)\n+    new_df[\"y1\"] = np.random.rand(len(new_df))\n+    new_df[\"y2\"] = np.random.rand(len(new_df))\n+    new_df[\"c1\"] = np.random.rand(len(new_df))\n+    new_df[\"c2\"] = np.random.rand(len(new_df))\n+    \n+    # Set all indices to the same value (duplicate indices)\n+    new_df.index = [0] * len(new_df)\n+    \n+    # This should NOT raise an exception and should maintain population size\n+    generator.add_data(new_df)\n+    assert len(generator.population) == population_size, \\\n+        f\"After duplicate index addition, population size {len(generator.population)} != {population_size}\"\n+    \n+    # Add multiple DataFrames with duplicate indices\n+    for dup_value in [100, 200, 300]:\n+        dup_candidates = generator.generate(15)\n+        dup_df = pd.DataFrame(dup_candidates)\n+        dup_df[\"y1\"] = np.random.rand(len(dup_df))\n+        dup_df[\"y2\"] = np.random.rand(len(dup_df))\n+        dup_df[\"c1\"] = np.random.rand(len(dup_df))\n+        dup_df[\"c2\"] = np.random.rand(len(dup_df))\n+        dup_df.index = [dup_value] * len(dup_df)\n+        \n+        generator.add_data(dup_df)\n+        assert len(generator.population) == population_size, \\\n+            f\"After iteration {dup_value}, population size {len(generator.population)} != {population_size}\"\n+    \n+    # Verify generator can still produce valid candidates\n+    final_candidates = generator.generate(5)\n+    assert len(final_candidates) == 5\n+    for candidate in final_candidates:\n+        assert \"x1\" in candidate\n+        assert \"x2\" in candidate\n+\n+\n+def test_cnsga_chunked_evaluation():\n+    \"\"\"\n+    Test that chunked evaluations don't cause population to exceed limit.\n+    \"\"\"\n+    population_size = 32\n+    generator = CNSGAGenerator(vocs=tnk_vocs, population_size=population_size)\n+    \n+    # Generate more than population_size candidates\n+    n_generate = 50\n+    all_candidates = []\n+    for _ in range(5):\n+        candidates = generator.generate(n_generate // 5)\n+        all_candidates.extend(candidates)\n+    \n+    # Create evaluated data\n+    df = pd.DataFrame(all_candidates)\n+    df[\"y1\"] = np.random.rand(len(df))\n+    df[\"y2\"] = np.random.rand(len(df))\n+    df[\"c1\"] = np.random.rand(len(df))\n+    df[\"c2\"] = np.random.rand(len(df))\n+    \n+    # Add data in chunks\n+    chunk_size = 10\n+    for i in range(0, len(df), chunk_size):\n+        chunk = df.iloc[i:i+chunk_size]\n+        generator.add_data(chunk)\n+        \n+        # Population should never exceed limit\n+        if generator.population is not None:\n+            assert len(generator.population) == population_size, \\\n+                f\"After chunk {i}, population size {len(generator.population)} != {population_size}\"\n",
