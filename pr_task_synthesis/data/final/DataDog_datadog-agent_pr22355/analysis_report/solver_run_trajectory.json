              "oldString": "// returns any of the existing references for the imageID. Returns empty if the\n// ID is not referenced.\nfunc (images *knownImages) getAReference(imageID string) string {\n\tfor ref := range images.namesByID[imageID] {\n\t\treturn ref\n\t}\n\n\treturn \"\"\n}",
              "newString": "// returns any of the existing references for the imageID. Returns empty if the\n// ID is not referenced.\nfunc (images *knownImages) getAReference(imageID string) string {\n\tfor ref := range images.namesByID[imageID] {\n\t\treturn ref\n\t}\n\n\treturn \"\"\n}\n\n// getPreferredName returns the most user-friendly name for an image.\n// Priority: repo digest > repo tag > raw image ID\nfunc (images *knownImages) getPreferredName(imageID string) string {\n\t// First, try to get a repo digest (most preferred)\n\trepoDigests := images.getRepoDigests(imageID)\n\tif len(repoDigests) > 0 {\n\t\t// Return the first repo digest\n\t\treturn repoDigests[0]\n\t}\n\n\t// Second, try to get a repo tag\n\trepoTags := images.getRepoTags(imageID)\n\tif len(repoTags) > 0 {\n\t\t// Return the first repo tag\n\t\treturn repoTags[0]\n\t}\n\n\t// Fall back to raw image ID\n\treturn imageID\n}\n\n// isNameMoreReadable returns true if newName is more readable than oldName.\n// A name is considered more readable if it doesn't contain a raw sha256 string.\nfunc isNameMoreReadable(oldName, newName string) bool {\n\t// If the old name contains sha256 and the new one doesn't, the new one is more readable\n\tif strings.Contains(oldName, \"sha256:\") && !strings.Contains(newName, \"sha256:\") {\n\t\treturn true\n\t}\n\treturn false\n}"
