              "file": "comp/core/workloadmeta/collectors/internal/containerd/image_test.go",
              "patch": "Index: comp/core/workloadmeta/collectors/internal/containerd/image_test.go\n===================================================================\n--- comp/core/workloadmeta/collectors/internal/containerd/image_test.go\t\n+++ comp/core/workloadmeta/collectors/internal/containerd/image_test.go\t\n@@ -1,174 +1,329 @@\n // Unless explicitly stated otherwise all files in this repository are licensed\n // under the Apache License Version 2.0.\n // This product includes software developed at Datadog (https://www.datadoghq.com/).\n // Copyright 2016-present Datadog, Inc.\n \n //go:build containerd\n \n package containerd\n \n import (\n \t\"testing\"\n \n \t\"github.com/DataDog/datadog-agent/comp/core/workloadmeta\"\n \t\"github.com/opencontainers/go-digest\"\n \tocispec \"github.com/opencontainers/image-spec/specs-go/v1\"\n \t\"github.com/stretchr/testify/assert\"\n )\n \n func TestKnownImages(t *testing.T) {\n \timages := newKnownImages()\n \n \timageID := \"sha256:92ca512c4cbb8a0909f903979610d5ee300ee26ce2898040c99606d1de46fce1\"\n \trepoTag := \"gcr.io/datadoghq/agent:7.42.0\"\n \trepoDigest := \"gcr.io/datadoghq/agent@sha256:3a19076bfee70900a600b8e3ee2cc30d5101d1d3d2b33654f1a316e596eaa4e0\"\n \n \t// Add a reference. The image name is an ID.\n \timages.addReference(imageID, imageID)\n \tgotID, found := images.getImageID(imageID)\n \tassert.True(t, found)\n \tassert.Equal(t, imageID, gotID)\n \tassert.Empty(t, images.getRepoTags(imageID))\n \tassert.Empty(t, images.getRepoDigests(imageID))\n \tassert.NotEmpty(t, images.getAReference(imageID))\n \n \t// Add another reference to the same image. The name is a repo tag.\n \timages.addReference(repoTag, imageID)\n \tgotID, found = images.getImageID(repoTag)\n \tassert.True(t, found)\n \tassert.Equal(t, imageID, gotID)\n \tassert.Equal(t, []string{repoTag}, images.getRepoTags(imageID))\n \tassert.Empty(t, images.getRepoDigests(imageID))\n \tassert.NotEmpty(t, images.getAReference(imageID))\n \n \t// Add another reference to the same image. The name is a repo digest.\n \timages.addReference(repoDigest, imageID)\n \tgotID, found = images.getImageID(repoDigest)\n \tassert.True(t, found)\n \tassert.Equal(t, imageID, gotID)\n \tassert.Equal(t, []string{repoTag}, images.getRepoTags(imageID))\n \tassert.Equal(t, []string{repoDigest}, images.getRepoDigests(imageID))\n \tassert.NotEmpty(t, images.getAReference(imageID))\n \n \t// Delete the reference that is an ID.\n \timages.deleteReference(imageID, imageID)\n \t_, found = images.getImageID(imageID)\n \tassert.False(t, found)\n \tassert.Equal(t, []string{repoTag}, images.getRepoTags(imageID))\n \tassert.Equal(t, []string{repoDigest}, images.getRepoDigests(imageID))\n \tassert.NotEmpty(t, images.getAReference(imageID))\n \n \t// Delete the reference that is a repo tag.\n \timages.deleteReference(repoTag, imageID)\n \t_, found = images.getImageID(repoTag)\n \tassert.False(t, found)\n \tassert.Empty(t, images.getRepoTags(imageID))\n \tassert.Equal(t, []string{repoDigest}, images.getRepoDigests(imageID))\n \tassert.NotEmpty(t, images.getAReference(imageID))\n \n \t// Delete the reference that is a repo digest.\n \timages.deleteReference(repoDigest, imageID)\n \t_, found = images.getImageID(repoDigest)\n \tassert.False(t, found)\n \tassert.Empty(t, images.getRepoTags(imageID))\n \tassert.Empty(t, images.getRepoDigests(imageID))\n \tassert.Empty(t, images.getAReference(imageID))\n }\n \n func TestGetLayersWithHistory(t *testing.T) {\n \t// Create a new image\n \timageConfig := ocispec.Image{\n \t\tHistory: []ocispec.History{\n \t\t\t{\n \t\t\t\tEmptyLayer: false,\n \t\t\t\tComment:    \"not-empty1\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: true,\n \t\t\t\tComment:    \"empty1\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: true,\n \t\t\t\tComment:    \"empty2\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: false,\n \t\t\t\tComment:    \"not-empty2\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: true,\n \t\t\t\tComment:    \"empty3\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: false,\n \t\t\t\tComment:    \"not-empty3\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: true,\n \t\t\t\tComment:    \"empty4\",\n \t\t\t},\n \t\t\t{\n \t\t\t\tEmptyLayer: true,\n \t\t\t\tComment:    \"empty5\",\n \t\t\t},\n \t\t},\n \t}\n \n \tmanifest := ocispec.Manifest{\n \t\tLayers: []ocispec.Descriptor{\n \t\t\t{\n \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\t\tDigest:    digest.FromString(\"foo\"),\n \t\t\t\tSize:      1,\n \t\t\t},\n \t\t\t{\n \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\t\tDigest:    digest.FromString(\"bar\"),\n \t\t\t\tSize:      2,\n \t\t\t},\n \t\t\t{\n \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\t\tDigest:    digest.FromString(\"baz\"),\n \t\t\t\tSize:      3,\n \t\t\t},\n \t\t\t{\n \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\t\tDigest:    digest.FromString(\"bow\"),\n \t\t\t\tSize:      4,\n \t\t\t},\n \t\t},\n \t}\n \n \tlayers := getLayersWithHistory(imageConfig, manifest)\n \tassert.Equal(t, []workloadmeta.ContainerImageLayer{\n \t\t{\n \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\tDigest:    digest.FromString(\"foo\").String(),\n \t\t\tSizeBytes: 1,\n \t\t\tHistory: &ocispec.History{\n \t\t\t\tComment: \"not-empty1\",\n \t\t\t},\n \t\t},\n \t\t{\n \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\tDigest:    digest.FromString(\"bar\").String(),\n \t\t\tSizeBytes: 2,\n \t\t\tHistory: &ocispec.History{\n \t\t\t\tComment: \"not-empty2\",\n \t\t\t},\n \t\t},\n \t\t{\n \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\tDigest:    digest.FromString(\"baz\").String(),\n \t\t\tSizeBytes: 3,\n \t\t\tHistory: &ocispec.History{\n \t\t\t\tComment: \"not-empty3\",\n \t\t\t},\n \t\t},\n \t\t{\n \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n \t\t\tDigest:    digest.FromString(\"bow\").String(),\n \t\t\tSizeBytes: 4,\n \t\t},\n \t}, layers)\n }\n+\n+func TestGetPreferredName(t *testing.T) {\n+\timages := newKnownImages()\n+\n+\timageID := \"sha256:92ca512c4cbb8a0909f903979610d5ee300ee26ce2898040c99606d1de46fce1\"\n+\trepoTag := \"gcr.io/datadoghq/agent:7.42.0\"\n+\trepoDigest := \"gcr.io/datadoghq/agent@sha256:3a19076bfee70900a600b8e3ee2cc30d5101d1d3d2b33654f1a316e596eaa4e0\"\n+\n+\t// Test 1: Only image ID - should return image ID\n+\timages.addReference(imageID, imageID)\n+\tpreferredName := images.getPreferredName(imageID)\n+\tassert.Equal(t, imageID, preferredName)\n+\n+\t// Test 2: Add repo tag - should prefer repo tag over image ID\n+\timages.addReference(repoTag, imageID)\n+\tpreferredName = images.getPreferredName(imageID)\n+\tassert.Equal(t, repoTag, preferredName)\n+\n+\t// Test 3: Add repo digest - should prefer repo digest over repo tag\n+\timages.addReference(repoDigest, imageID)\n+\tpreferredName = images.getPreferredName(imageID)\n+\tassert.Equal(t, repoDigest, preferredName)\n+\n+\t// Test 4: Remove repo digest - should fall back to repo tag\n+\timages.deleteReference(repoDigest, imageID)\n+\tpreferredName = images.getPreferredName(imageID)\n+\tassert.Equal(t, repoTag, preferredName)\n+\n+\t// Test 5: Remove repo tag - should fall back to image ID\n+\timages.deleteReference(repoTag, imageID)\n+\tpreferredName = images.getPreferredName(imageID)\n+\tassert.Equal(t, imageID, preferredName)\n+}\n+\n+func TestIsNameMoreReadable(t *testing.T) {\n+\ttests := []struct {\n+\t\tname     string\n+\t\toldName  string\n+\t\tnewName  string\n+\t\texpected bool\n+\t}{\n+\t\t{\n+\t\t\tname:     \"old is raw ID, new is repo tag - more readable\",\n+\t\t\toldName:  \"sha256:abc123\",\n+\t\t\tnewName:  \"gcr.io/datadoghq/agent:7\",\n+\t\t\texpected: true,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"old is raw ID, new is repo digest - more readable\",\n+\t\t\toldName:  \"sha256:abc123\",\n+\t\t\tnewName:  \"gcr.io/datadoghq/agent@sha256:def456\",\n+\t\t\texpected: true,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"both are raw IDs - not more readable\",\n+\t\t\toldName:  \"sha256:abc123\",\n+\t\t\tnewName:  \"sha256:def456\",\n+\t\t\texpected: false,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"old doesn't have sha256, new doesn't - not more readable\",\n+\t\t\toldName:  \"gcr.io/datadoghq/agent:7\",\n+\t\t\tnewName:  \"gcr.io/datadoghq/agent:latest\",\n+\t\t\texpected: false,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"old is repo tag, new is raw ID - not more readable\",\n+\t\t\toldName:  \"gcr.io/datadoghq/agent:7\",\n+\t\t\tnewName:  \"sha256:abc123\",\n+\t\t\texpected: false,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"old is repo digest, new is repo tag - more readable\",\n+\t\t\toldName:  \"gcr.io/datadoghq/agent@sha256:abc123\",\n+\t\t\tnewName:  \"gcr.io/datadoghq/agent:7\",\n+\t\t\texpected: true,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"old is repo tag, new is repo digest - not more readable\",\n+\t\t\toldName:  \"gcr.io/datadoghq/agent:7\",\n+\t\t\tnewName:  \"gcr.io/datadoghq/agent@sha256:abc123\",\n+\t\t\texpected: false,\n+\t\t},\n+\t\t{\n+\t\t\tname:     \"both are repo digests - not more readable\",\n+\t\t\toldName:  \"gcr.io/datadoghq/agent@sha256:abc123\",\n+\t\t\tnewName:  \"gcr.io/datadoghq/agent@sha256:def456\",\n+\t\t\texpected: false,\n+\t\t},\n+\t}\n+\n+\tfor _, tt := range tests {\n+\t\tt.Run(tt.name, func(t *testing.T) {\n+\t\t\tresult := isNameMoreReadable(tt.oldName, tt.newName)\n+\t\t\tassert.Equal(t, tt.expected, result)\n+\t\t})\n+\t}\n+}\n+\n+func TestImageAggregation(t *testing.T) {\n+\timages := newKnownImages()\n+\n+\timageID := \"sha256:92ca512c4cbb8a0909f903979610d5ee300ee26ce2898040c99606d1de46fce1\"\n+\trepoTag1 := \"gcr.io/datadoghq/agent:7.42.0\"\n+\trepoTag2 := \"gcr.io/datadoghq/agent:latest\"\n+\trepoDigest := \"gcr.io/datadoghq/agent@sha256:3a19076bfee70900a600b8e3ee2cc30d5101d1d3d2b33654f1a316e596eaa4e0\"\n+\n+\t// Simulate receiving multiple references for the same image\n+\t// This can happen during initial collection when containerd reports the same image\n+\t// with different names\n+\timages.addReference(imageID, imageID)\n+\timages.addReference(repoTag1, imageID)\n+\timages.addReference(repoTag2, imageID)\n+\timages.addReference(repoDigest, imageID)\n+\n+\t// Verify all references are tracked\n+\tassert.Equal(t, imageID, images.idsByName[imageID])\n+\tassert.Equal(t, imageID, images.idsByName[repoTag1])\n+\tassert.Equal(t, imageID, images.idsByName[repoTag2])\n+\tassert.Equal(t, imageID, images.idsByName[repoDigest])\n+\n+\t// Verify all names are associated with the image ID\n+\tassert.Len(t, images.namesByID[imageID], 4)\n+\n+\t// Verify repo tags are collected\n+\trepoTags := images.getRepoTags(imageID)\n+\tassert.Len(t, repoTags, 2)\n+\tassert.Contains(t, repoTags, repoTag1)\n+\tassert.Contains(t, repoTags, repoTag2)\n+\n+\t// Verify repo digests are collected\n+\trepoDigests := images.getRepoDigests(imageID)\n+\tassert.Len(t, repoDigests, 1)\n+\tassert.Contains(t, repoDigests, repoDigest)\n+\n+\t// Verify preferred name is the repo digest (highest priority)\n+\tpreferredName := images.getPreferredName(imageID)\n+\tassert.Equal(t, repoDigest, preferredName)\n+\n+\t// Simulate removing the repo digest\n+\timages.deleteReference(repoDigest, imageID)\n+\n+\t// Now preferred name should be a repo tag\n+\tpreferredName = images.getPreferredName(imageID)\n+\t// Could be either tag, but should be one of them\n+\tassert.Contains(t, []string{repoTag1, repoTag2}, preferredName)\n+\n+\t// Remove all tags\n+\timages.deleteReference(repoTag1, imageID)\n+\timages.deleteReference(repoTag2, imageID)\n+\n+\t// Now preferred name should be the raw image ID\n+\tpreferredName = images.getPreferredName(imageID)\n+\tassert.Equal(t, imageID, preferredName)\n+}\n",
