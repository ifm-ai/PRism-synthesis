            "output": "<path>/workspace/comp/core/workloadmeta/collectors/internal/containerd/image.go</path>\n<type>file</type>\n<content>\n1: // Unless explicitly stated otherwise all files in this repository are licensed\n2: // under the Apache License Version 2.0.\n3: // This product includes software developed at Datadog (https://www.datadoghq.com/).\n4: // Copyright 2016-present Datadog, Inc.\n5: \n6: //go:build containerd\n7: \n8: package containerd\n9: \n10: import (\n11: \t\"context\"\n12: \t\"encoding/json\"\n13: \t\"fmt\"\n14: \t\"strings\"\n15: \n16: \t\"github.com/DataDog/datadog-agent/comp/core/workloadmeta\"\n17: \t\"github.com/DataDog/datadog-agent/comp/core/workloadmeta/collectors/util\"\n18: \t\"github.com/DataDog/datadog-agent/pkg/util/log\"\n19: \n20: \t\"github.com/containerd/containerd\"\n21: \t\"github.com/containerd/containerd/api/events\"\n22: \t\"github.com/containerd/containerd/content\"\n23: \tcontainerdevents \"github.com/containerd/containerd/events\"\n24: \t\"github.com/containerd/containerd/images\"\n25: \t\"github.com/containerd/containerd/namespaces\"\n26: \tocispec \"github.com/opencontainers/image-spec/specs-go/v1\"\n27: \t\"google.golang.org/protobuf/proto\"\n28: )\n29: \n30: const imageTopicPrefix = \"/images/\"\n31: \n32: // We cannot get all the information that we need from a single call to\n33: // containerd. This type stores the information that we need to know about the\n34: // images that we have already processed.\n35: //\n36: // Things to take into account:\n37: //\n38: // - Events from containerd only include an image name, and it does not always\n39: // correspond to an image ID. When a delete event arrives it'll contain a name,\n40: // but we won't be able to access the ID because the image is already gone,\n41: // that's why we need to keep the IDs => names relationships.\n42: //\n43: // - An image ID can be referenced by multiple names.\n44: //\n45: // - A name can have multiple formats:\n46: //   - image ID: starts with \"sha256:\"\n47: //   - repo digest. They contain \"@sha256:\". Example: gcr.io/datadoghq/agent@sha256:3a19076bfee70900a600b8e3ee2cc30d5101d1d3d2b33654f1a316e596eaa4e0\n48: //   - repo tag. Example: gcr.io/datadoghq/agent:7\n49: type knownImages struct {\n50: \t// Store IDs and names in both directions for efficient access.\n51: \tidsByName       map[string]string              // map name => ID\n52: \tnamesByID       map[string]map[string]struct{} // map ID => set of names\n53: \trepoTagsByID    map[string]map[string]struct{} // map ID => set of repo tags\n54: \trepoDigestsByID map[string]map[string]struct{} // map ID => set of repo digests\n55: }\n56: \n57: func newKnownImages() *knownImages {\n58: \treturn &knownImages{\n59: \t\tidsByName:       make(map[string]string),\n60: \t\tnamesByID:       make(map[string]map[string]struct{}),\n61: \t\trepoTagsByID:    make(map[string]map[string]struct{}),\n62: \t\trepoDigestsByID: make(map[string]map[string]struct{}),\n63: \t}\n64: }\n65: \n66: func (images *knownImages) addReference(imageName string, imageID string) {\n67: \tpreviousIDReferenced, found := images.idsByName[imageName]\n68: \tif found && previousIDReferenced != imageID {\n69: \t\timages.deleteReference(imageName, previousIDReferenced)\n70: \t}\n71: \n72: \timages.idsByName[imageName] = imageID\n73: \n74: \tif images.namesByID[imageID] == nil {\n75: \t\timages.namesByID[imageID] = make(map[string]struct{})\n76: \t}\n77: \timages.namesByID[imageID][imageName] = struct{}{}\n78: \n79: \tif isAnImageID(imageName) {\n80: \t\treturn\n81: \t}\n82: \n83: \tif isARepoDigest(imageName) {\n84: \t\tif images.repoDigestsByID[imageID] == nil {\n85: \t\t\timages.repoDigestsByID[imageID] = make(map[string]struct{})\n86: \t\t}\n87: \t\timages.repoDigestsByID[imageID][imageName] = struct{}{}\n88: \t\treturn\n89: \t}\n90: \n91: \t// The name is not an image ID or a repo digest, so it has to be a repo tag\n92: \tif images.repoTagsByID[imageID] == nil {\n93: \t\timages.repoTagsByID[imageID] = make(map[string]struct{})\n94: \t}\n95: \n96: \timages.repoTagsByID[imageID][imageName] = struct{}{}\n97: }\n98: \n99: func (images *knownImages) deleteReference(imageName string, imageID string) {\n100: \tdelete(images.idsByName, imageName)\n101: \n102: \tif images.namesByID[imageID] != nil {\n103: \t\tdelete(images.namesByID[imageID], imageName)\n104: \t}\n105: \n106: \tif isAnImageID(imageName) {\n107: \t\treturn\n108: \t}\n109: \n110: \tif isARepoDigest(imageName) {\n111: \t\tif images.repoDigestsByID[imageID] == nil {\n112: \t\t\treturn\n113: \t\t}\n114: \t\tdelete(images.repoDigestsByID[imageID], imageName)\n115: \t\tif len(images.repoDigestsByID[imageID]) == 0 {\n116: \t\t\tdelete(images.repoDigestsByID, imageID)\n117: \t\t}\n118: \t\treturn\n119: \t}\n120: \n121: \t// The name is not an image ID or a repo digest, so it has to be a repo tag\n122: \tif images.repoTagsByID[imageID] == nil {\n123: \t\treturn\n124: \t}\n125: \tdelete(images.repoTagsByID[imageID], imageName)\n126: \tif len(images.repoTagsByID[imageID]) == 0 {\n127: \t\tdelete(images.repoTagsByID, imageID)\n128: \t}\n129: }\n130: \n131: func (images *knownImages) getImageID(imageName string) (string, bool) {\n132: \tid, found := images.idsByName[imageName]\n133: \treturn id, found\n134: }\n135: \n136: func (images *knownImages) getRepoTags(imageID string) []string {\n137: \tvar res []string\n138: \tfor repoTag := range images.repoTagsByID[imageID] {\n139: \t\tres = append(res, repoTag)\n140: \t}\n141: \treturn res\n142: }\n143: \n144: func (images *knownImages) getRepoDigests(imageID string) []string {\n145: \tvar res []string\n146: \tfor repoDigest := range images.repoDigestsByID[imageID] {\n147: \t\tres = append(res, repoDigest)\n148: \t}\n149: \treturn res\n150: }\n151: \n152: // returns any of the existing references for the imageID. Returns empty if the\n153: // ID is not referenced.\n154: func (images *knownImages) getAReference(imageID string) string {\n155: \tfor ref := range images.namesByID[imageID] {\n156: \t\treturn ref\n157: \t}\n158: \n159: \treturn \"\"\n160: }\n161: \n162: func isImageTopic(topic string) bool {\n163: \treturn strings.HasPrefix(topic, imageTopicPrefix)\n164: }\n165: \n166: func isAnImageID(imageName string) bool {\n167: \treturn strings.HasPrefix(imageName, \"sha256\")\n168: }\n169: \n170: func isARepoDigest(imageName string) bool {\n171: \treturn strings.Contains(imageName, \"@sha256:\")\n172: }\n173: \n174: func (c *collector) handleImageEvent(ctx context.Context, containerdEvent *containerdevents.Envelope) error {\n175: \tswitch containerdEvent.Topic {\n176: \tcase imageCreationTopic:\n177: \t\tevent := &events.ImageCreate{}\n178: \t\tif err := proto.Unmarshal(containerdEvent.Event.GetValue(), event); err != nil {\n179: \t\t\treturn fmt.Errorf(\"error unmarshaling containerd event: %w\", err)\n180: \t\t}\n181: \n182: \t\treturn c.handleImageCreateOrUpdate(ctx, containerdEvent.Namespace, event.Name, nil)\n183: \n184: \tcase imageUpdateTopic:\n185: \t\tevent := &events.ImageUpdate{}\n186: \t\tif err := proto.Unmarshal(containerdEvent.Event.GetValue(), event); err != nil {\n187: \t\t\treturn fmt.Errorf(\"error unmarshaling containerd event: %w\", err)\n188: \t\t}\n189: \n190: \t\treturn c.handleImageCreateOrUpdate(ctx, containerdEvent.Namespace, event.Name, nil)\n191: \n192: \tcase imageDeletionTopic:\n193: \t\tc.handleImagesMut.Lock()\n194: \n195: \t\tevent := &events.ImageDelete{}\n196: \t\tif err := proto.Unmarshal(containerdEvent.Event.GetValue(), event); err != nil {\n197: \t\t\tc.handleImagesMut.Unlock()\n198: \t\t\treturn fmt.Errorf(\"error unmarshaling containerd event: %w\", err)\n199: \t\t}\n200: \n201: \t\timageID, found := c.knownImages.getImageID(event.Name)\n202: \t\tif !found {\n203: \t\t\tc.handleImagesMut.Unlock()\n204: \t\t\treturn nil\n205: \t\t}\n206: \n207: \t\tc.knownImages.deleteReference(event.Name, imageID)\n208: \n209: \t\tif ref := c.knownImages.getAReference(imageID); ref != \"\" {\n210: \t\t\t// Image is still referenced by a different name, so don't delete\n211: \t\t\t// the image, but we need to update its repo tags and digest tags.\n212: \t\t\t// Updating workloadmeta entities directly is not thread-safe,\n213: \t\t\t// that's why we generate an update event here.\n214: \t\t\tc.handleImagesMut.Unlock()\n215: \t\t\treturn c.handleImageCreateOrUpdate(ctx, containerdEvent.Namespace, ref, nil)\n216: \t\t}\n217: \n218: \t\tc.store.Notify([]workloadmeta.CollectorEvent{\n219: \t\t\t{\n220: \t\t\t\tType:   workloadmeta.EventTypeUnset,\n221: \t\t\t\tSource: workloadmeta.SourceRuntime,\n222: \t\t\t\tEntity: &workloadmeta.ContainerImageMetadata{\n223: \t\t\t\t\tEntityID: workloadmeta.EntityID{\n224: \t\t\t\t\t\tKind: workloadmeta.KindContainerImageMetadata,\n225: \t\t\t\t\t\tID:   imageID,\n226: \t\t\t\t\t},\n227: \t\t\t\t},\n228: \t\t\t},\n229: \t\t})\n230: \n231: \t\tc.handleImagesMut.Unlock()\n232: \t\treturn nil\n233: \tdefault:\n234: \t\treturn fmt.Errorf(\"unknown containerd image event topic %s, ignoring\", containerdEvent.Topic)\n235: \t}\n236: }\n237: \n238: func (c *collector) handleImageCreateOrUpdate(ctx context.Context, namespace string, imageName string, bom *workloadmeta.SBOM) error {\n239: \timg, err := c.containerdClient.Image(namespace, imageName)\n240: \tif err != nil {\n241: \t\treturn fmt.Errorf(\"error getting image: %w\", err)\n242: \t}\n243: \n244: \treturn c.notifyEventForImage(ctx, namespace, img, bom)\n245: }\n246: \n247: func (c *collector) notifyEventForImage(ctx context.Context, namespace string, img containerd.Image, sbom *workloadmeta.SBOM) error {\n248: \tc.handleImagesMut.Lock()\n249: \tdefer c.handleImagesMut.Unlock()\n250: \n251: \tctxWithNamespace := namespaces.WithNamespace(ctx, namespace)\n252: \n253: \t// Build initial workloadmeta.ContainerImageMetadata from manifest and image\n254: \tmanifest, err := images.Manifest(ctxWithNamespace, img.ContentStore(), img.Target(), img.Platform())\n255: \tif err != nil {\n256: \t\treturn fmt.Errorf(\"error getting image manifest: %w\", err)\n257: \t}\n258: \n259: \ttotalSizeBytes := manifest.Config.Size\n260: \tfor _, layer := range manifest.Layers {\n261: \t\ttotalSizeBytes += layer.Size\n262: \t}\n263: \n264: \twlmImage := workloadmeta.ContainerImageMetadata{\n265: \t\tEntityID: workloadmeta.EntityID{\n266: \t\t\tKind: workloadmeta.KindContainerImageMetadata,\n267: \t\t\tID:   manifest.Config.Digest.String(),\n268: \t\t},\n269: \t\tEntityMeta: workloadmeta.EntityMeta{\n270: \t\t\tName:      img.Name(),\n271: \t\t\tNamespace: namespace,\n272: \t\t},\n273: \t\tMediaType: manifest.MediaType,\n274: \t\tSBOM:      sbom,\n275: \t\tSizeBytes: totalSizeBytes,\n276: \t}\n277: \tc.knownImages.addReference(wlmImage.Name, wlmImage.ID)\n278: \n279: \t// Fill image based on manifest and config, we are not failing if this step fails\n280: \t// as we can live without layers or labels\n281: \tif err := extractFromConfigBlob(ctxWithNamespace, img, manifest, &wlmImage); err != nil {\n282: \t\tlog.Infof(\"failed to get image config for image: %s, layers and labels will be missing: %v\", img.Name(), err)\n283: \t}\n284: \n285: \twlmImage.RepoTags = c.knownImages.getRepoTags(wlmImage.ID)\n286: \twlmImage.RepoDigests = c.knownImages.getRepoDigests(wlmImage.ID)\n287: \n288: \t// We can get \"create\" events for images that already exist. That happens\n289: \t// when the same image is referenced with different names. For example,\n290: \t// datadog/agent:latest and datadog/agent:7 might refer to the same image.\n291: \t// Also, in some environments (at least with Kind), pulling an image like\n292: \t// datadog/agent:latest creates several events: in one of them the image\n293: \t// name is a digest, in other is something with the same format as\n294: \t// datadog/agent:7, and sometimes there's a temporary name prefixed with\n295: \t// \"import-\".\n296: \t// When that happens, give precedence to the name with repo and tag instead\n297: \t// of the name that includes a digest. This is just to show names that are\n298: \t// more user-friendly (the digests are already present in other attributes\n299: \t// like ID, and repo digest).\n300: \texistingImg, err := c.store.GetImage(wlmImage.ID)\n301: \tif err == nil {\n302: \t\tif strings.Contains(wlmImage.Name, \"sha256:\") && !strings.Contains(existingImg.Name, \"sha256:\") {\n303: \t\t\twlmImage.Name = existingImg.Name\n304: \t\t}\n305: \t}\n306: \n307: \tif wlmImage.SBOM == nil {\n308: \t\twlmImage.SBOM = &workloadmeta.SBOM{\n309: \t\t\tStatus: workloadmeta.Pending,\n310: \t\t}\n311: \t}\n312: \n313: \t// The CycloneDX should contain the RepoTags and RepoDigests but the scanner might\n314: \t// not be able to inject them. For example, if we use the scanner from filesystem or\n315: \t// if the `imgMeta` object does not contain all the metadata when it is sent.\n316: \t// We add them here to make sure they are present.\n317: \twlmImage.SBOM = util.UpdateSBOMRepoMetadata(wlmImage.SBOM, wlmImage.RepoTags, wlmImage.RepoDigests)\n318: \n319: \tc.store.Notify([]workloadmeta.CollectorEvent{\n320: \t\t{\n321: \t\t\tType:   workloadmeta.EventTypeSet,\n322: \t\t\tSource: workloadmeta.SourceRuntime,\n323: \t\t\tEntity: &wlmImage,\n324: \t\t},\n325: \t})\n326: \n327: \treturn nil\n328: }\n329: \n330: func extractFromConfigBlob(ctx context.Context, img containerd.Image, manifest ocispec.Manifest, outImage *workloadmeta.ContainerImageMetadata) error {\n331: \t// First extract platform from Config descriptor\n332: \textractPlatform(manifest.Config.Platform, outImage)\n333: \n334: \timageConfigBlob, err := content.ReadBlob(ctx, img.ContentStore(), manifest.Config)\n335: \tif err != nil {\n336: \t\treturn fmt.Errorf(\"error getting image config: %w\", err)\n337: \t}\n338: \n339: \tvar ocispecImage ocispec.Image\n340: \tif err = json.Unmarshal(imageConfigBlob, &ocispecImage); err != nil {\n341: \t\treturn fmt.Errorf(\"error while unmarshaling image config: %w\", err)\n342: \t}\n343: \n344: \t// If we are able to read config, override with values from config if any\n345: \textractPlatform(&ocispecImage.Platform, outImage)\n346: \n347: \toutImage.Layers = getLayersWithHistory(ocispecImage, manifest)\n348: \toutImage.Labels = getImageLabels(img, ocispecImage)\n349: \treturn nil\n350: }\n351: \n352: func extractPlatform(platform *ocispec.Platform, outImage *workloadmeta.ContainerImageMetadata) {\n353: \tif platform == nil {\n354: \t\treturn\n355: \t}\n356: \n357: \tif platform.Architecture != \"\" {\n358: \t\toutImage.Architecture = platform.Architecture\n359: \t}\n360: \n361: \tif platform.OS != \"\" {\n362: \t\toutImage.OS = platform.OS\n363: \t}\n364: \n365: \tif platform.OSVersion != \"\" {\n366: \t\toutImage.OSVersion = platform.OSVersion\n367: \t}\n368: \n369: \tif platform.Variant != \"\" {\n370: \t\toutImage.Variant = platform.Variant\n371: \t}\n372: }\n373: \n374: func getLayersWithHistory(ocispecImage ocispec.Image, manifest ocispec.Manifest) []workloadmeta.ContainerImageLayer {\n375: \tvar layers []workloadmeta.ContainerImageLayer\n376: \n377: \t// The layers in the manifest don't include the history, and the only way to\n378: \t// match the history with each layer is to rely on the order and take into\n379: \t// account that some history objects don't have an associated layer\n380: \t// (emptyLayer = true).\n381: \t// History is optional in OCI Spec, so we have no guarantee to be able to get it.\n382: \n383: \thistoryIndex := 0\n384: \tfor _, manifestLayer := range manifest.Layers {\n385: \t\t// Look for next history point with emptyLayer = false\n386: \t\thistoryFound := false\n387: \t\tfor ; historyIndex < len(ocispecImage.History); historyIndex++ {\n388: \t\t\tif !ocispecImage.History[historyIndex].EmptyLayer {\n389: \t\t\t\thistoryFound = true\n390: \t\t\t\tbreak\n391: \t\t\t}\n392: \t\t}\n393: \n394: \t\tlayer := workloadmeta.ContainerImageLayer{\n395: \t\t\tMediaType: manifestLayer.MediaType,\n396: \t\t\tDigest:    manifestLayer.Digest.String(),\n397: \t\t\tSizeBytes: manifestLayer.Size,\n398: \t\t\tURLs:      manifestLayer.URLs,\n399: \t\t}\n400: \t\tif historyFound {\n401: \t\t\tlayer.History = &ocispecImage.History[historyIndex]\n402: \t\t\thistoryIndex++\n403: \t\t}\n404: \n405: \t\tlayers = append(layers, layer)\n406: \t}\n407: \n408: \treturn layers\n409: }\n410: \n411: func getImageLabels(img containerd.Image, ocispecImage ocispec.Image) map[string]string {\n412: \t// Labels() does not return the labels set in the Dockerfile. They are in\n413: \t// the config descriptor.\n414: \t// When running on Kubernetes Labels() only returns io.cri-containerd\n415: \t// labels.\n416: \tlabels := map[string]string{}\n417: \n418: \tfor labelName, labelValue := range img.Labels() {\n419: \t\tlabels[labelName] = labelValue\n420: \t}\n421: \n422: \tfor labelName, labelValue := range ocispecImage.Config.Labels {\n423: \t\tlabels[labelName] = labelValue\n424: \t}\n425: \n426: \treturn labels\n427: }\n\n(End of file - total 427 lines)\n</content>",
