timages.addReference(repoDigest, imageID)\n46: \tgotID, found = images.getImageID(repoDigest)\n47: \tassert.True(t, found)\n48: \tassert.Equal(t, imageID, gotID)\n49: \tassert.Equal(t, []string{repoTag}, images.getRepoTags(imageID))\n50: \tassert.Equal(t, []string{repoDigest}, images.getRepoDigests(imageID))\n51: \tassert.NotEmpty(t, images.getAReference(imageID))\n52: \n53: \t// Delete the reference that is an ID.\n54: \timages.deleteReference(imageID, imageID)\n55: \t_, found = images.getImageID(imageID)\n56: \tassert.False(t, found)\n57: \tassert.Equal(t, []string{repoTag}, images.getRepoTags(imageID))\n58: \tassert.Equal(t, []string{repoDigest}, images.getRepoDigests(imageID))\n59: \tassert.NotEmpty(t, images.getAReference(imageID))\n60: \n61: \t// Delete the reference that is a repo tag.\n62: \timages.deleteReference(repoTag, imageID)\n63: \t_, found = images.getImageID(repoTag)\n64: \tassert.False(t, found)\n65: \tassert.Empty(t, images.getRepoTags(imageID))\n66: \tassert.Equal(t, []string{repoDigest}, images.getRepoDigests(imageID))\n67: \tassert.NotEmpty(t, images.getAReference(imageID))\n68: \n69: \t// Delete the reference that is a repo digest.\n70: \timages.deleteReference(repoDigest, imageID)\n71: \t_, found = images.getImageID(repoDigest)\n72: \tassert.False(t, found)\n73: \tassert.Empty(t, images.getRepoTags(imageID))\n74: \tassert.Empty(t, images.getRepoDigests(imageID))\n75: \tassert.Empty(t, images.getAReference(imageID))\n76: }\n77: \n78: func TestGetLayersWithHistory(t *testing.T) {\n79: \t// Create a new image\n80: \timageConfig := ocispec.Image{\n81: \t\tHistory: []ocispec.History{\n82: \t\t\t{\n83: \t\t\t\tEmptyLayer: false,\n84: \t\t\t\tComment:    \"not-empty1\",\n85: \t\t\t},\n86: \t\t\t{\n87: \t\t\t\tEmptyLayer: true,\n88: \t\t\t\tComment:    \"empty1\",\n89: \t\t\t},\n90: \t\t\t{\n91: \t\t\t\tEmptyLayer: true,\n92: \t\t\t\tComment:    \"empty2\",\n93: \t\t\t},\n94: \t\t\t{\n95: \t\t\t\tEmptyLayer: false,\n96: \t\t\t\tComment:    \"not-empty2\",\n97: \t\t\t},\n98: \t\t\t{\n99: \t\t\t\tEmptyLayer: true,\n100: \t\t\t\tComment:    \"empty3\",\n101: \t\t\t},\n102: \t\t\t{\n103: \t\t\t\tEmptyLayer: false,\n104: \t\t\t\tComment:    \"not-empty3\",\n105: \t\t\t},\n106: \t\t\t{\n107: \t\t\t\tEmptyLayer: true,\n108: \t\t\t\tComment:    \"empty4\",\n109: \t\t\t},\n110: \t\t\t{\n111: \t\t\t\tEmptyLayer: true,\n112: \t\t\t\tComment:    \"empty5\",\n113: \t\t\t},\n114: \t\t},\n115: \t}\n116: \n117: \tmanifest := ocispec.Manifest{\n118: \t\tLayers: []ocispec.Descriptor{\n119: \t\t\t{\n120: \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n121: \t\t\t\tDigest:    digest.FromString(\"foo\"),\n122: \t\t\t\tSize:      1,\n123: \t\t\t},\n124: \t\t\t{\n125: \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n126: \t\t\t\tDigest:    digest.FromString(\"bar\"),\n127: \t\t\t\tSize:      2,\n128: \t\t\t},\n129: \t\t\t{\n130: \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n131: \t\t\t\tDigest:    digest.FromString(\"baz\"),\n132: \t\t\t\tSize:      3,\n133: \t\t\t},\n134: \t\t\t{\n135: \t\t\t\tMediaType: ocispec.MediaTypeImageLayer,\n136: \t\t\t\tDigest:    digest.FromString(\"bow\"),\n137: \t\t\t\tSize:      4,\n138: \t\t\t},\n139: \t\t},\n140: \t}\n141: \n142: \tlayers := getLayersWithHistory(imageConfig, manifest)\n143: \tassert.Equal(t, []workloadmeta.ContainerImageLayer{\n144: \t\t{\n145: \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n146: \t\t\tDigest:    digest.FromString(\"foo\").String(),\n147: \t\t\tSizeBytes: 1,\n148: \t\t\tHistory: &ocispec.History{\n149: \t\t\t\tComment: \"not-empty1\",\n150: \t\t\t},\n151: \t\t},\n152: \t\t{\n153: \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n154: \t\t\tDigest:    digest.FromString(\"bar\").String(),\n155: \t\t\tSizeBytes: 2,\n156: \t\t\tHistory: &ocispec.History{\n157: \t\t\t\tComment: \"not-empty2\",\n158: \t\t\t},\n159: \t\t},\n160: \t\t{\n161: \t\t\tMediaType: ocispec.MediaTypeImageLayer,\n162: \t\t\tDigest:    digest.FromString(\"baz\").String(),\n163: \t\t\tSizeBytes: 3,\n16