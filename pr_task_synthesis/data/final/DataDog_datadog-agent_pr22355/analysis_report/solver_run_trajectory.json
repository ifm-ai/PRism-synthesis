            "output": "<path>/workspace/comp/core/workloadmeta/collectors/internal/containerd/containerd.go</path>\n<type>file</type>\n<content>\n1: // Unless explicitly stated otherwise all files in this repository are licensed\n2: // under the Apache License Version 2.0.\n3: // This product includes software developed at Datadog (https://www.datadoghq.com/).\n4: // Copyright 2016-present Datadog, Inc.\n5: \n6: //go:build containerd\n7: \n8: // Package containerd implements the containerd Workloadmeta collector.\n9: package containerd\n10: \n11: import (\n12: \t\"context\"\n13: \t\"errors\"\n14: \t\"fmt\"\n15: \t\"sync\"\n16: \t\"time\"\n17: \n18: \t\"github.com/containerd/containerd\"\n19: \tcontainerdevents \"github.com/containerd/containerd/events\"\n20: \t\"go.uber.org/fx\"\n21: \n22: \t\"github.com/DataDog/datadog-agent/comp/core/workloadmeta\"\n23: \t\"github.com/DataDog/datadog-agent/pkg/config\"\n24: \tagentErrors \"github.com/DataDog/datadog-agent/pkg/errors\"\n25: \t\"github.com/DataDog/datadog-agent/pkg/sbom\"\n26: \t\"github.com/DataDog/datadog-agent/pkg/sbom/scanner\"\n27: \t\"github.com/DataDog/datadog-agent/pkg/status/health\"\n28: \tcutil \"github.com/DataDog/datadog-agent/pkg/util/containerd\"\n29: \t\"github.com/DataDog/datadog-agent/pkg/util/containers\"\n30: \t\"github.com/DataDog/datadog-agent/pkg/util/log\"\n31: )\n32: \n33: const (\n34: \tcollectorID   = \"containerd\"\n35: \tcomponentName = \"workloadmeta-containerd\"\n36: \n37: \tcontainerCreationTopic = \"/containers/create\"\n38: \tcontainerUpdateTopic   = \"/containers/update\"\n39: \tcontainerDeletionTopic = \"/containers/delete\"\n40: \n41: \timageCreationTopic = \"/images/create\"\n42: \timageUpdateTopic   = \"/images/update\"\n43: \timageDeletionTopic = \"/images/delete\"\n44: \n45: \t// These are not all the task-related topics, but enough to detect changes\n46: \t// in the state of the container (only need to know if it's running or not).\n47: \n48: \t// TaskStartTopic represents task start events\n49: \tTaskStartTopic = \"/tasks/start\"\n50: \t// TaskOOMTopic represents task oom events\n51: \tTaskOOMTopic = \"/tasks/oom\"\n52: \t// TaskExitTopic represents task exit events\n53: \tTaskExitTopic = \"/tasks/exit\"\n54: \t// TaskDeleteTopic represents task delete events\n55: \tTaskDeleteTopic = \"/tasks/delete\"\n56: \t// TaskPausedTopic represents task paused events\n57: \tTaskPausedTopic = \"/tasks/paused\"\n58: \t// TaskResumedTopic represents task resumed events\n59: \tTaskResumedTopic = \"/tasks/resumed\"\n60: )\n61: \n62: // containerdTopics includes the containerd topics that we want to subscribe to\n63: var containerdTopics = []string{\n64: \tcontainerCreationTopic,\n65: \tcontainerUpdateTopic,\n66: \tcontainerDeletionTopic,\n67: \timageCreationTopic,\n68: \timageUpdateTopic,\n69: \timageDeletionTopic,\n70: \tTaskStartTopic,\n71: \tTaskOOMTopic,\n72: \tTaskExitTopic,\n73: \tTaskDeleteTopic,\n74: \tTaskPausedTopic,\n75: \tTaskResumedTopic,\n76: }\n77: \n78: type exitInfo struct {\n79: \texitCode *uint32\n80: \texitTS   time.Time\n81: }\n82: \n83: type collector struct {\n84: \tid                     string\n85: \tstore                  workloadmeta.Component\n86: \tcatalog                workloadmeta.AgentType\n87: \tcontainerdClient       cutil.ContainerdItf\n88: \tfilterPausedContainers *containers.Filter\n89: \teventsChan             <-chan *containerdevents.Envelope\n90: \terrorsChan             <-chan error\n91: \n92: \t// Container exit info (mainly exit code and exit timestamp) are attached to the corresponding task events.\n93: \t// contToExitInfo caches the exit info of a task to enrich the container deletion event when it's received later.\n94: \tcontToExitInfo map[string]*exitInfo\n95: \n96: \tknownImages *knownImages\n97: \n98: \t// Images are updated from 2 goroutines: the one that handles containerd\n99: \t// events, and the one that extracts SBOMS.\n100: \t// This mutex is used to handle images one at a time to avoid\n101: \t// inconsistencies like trying to set an SBOM for an image that is being\n102: \t// deleted.\n103: \thandleImagesMut sync.Mutex\n104: \n105: \t// SBOM Scanning\n106: \tsbomScanner *scanner.Scanner //nolint: unused\n107: \tscanOptions sbom.ScanOptions //nolint: unused\n108: }\n109: \n110: // NewCollector returns a new containerd collector provider and an error\n111: func NewCollector() (workloadmeta.CollectorProvider, error) {\n112: \treturn workloadmeta.CollectorProvider{\n113: \t\tCollector: &collector{\n114: \t\t\tid:             collectorID,\n115: \t\t\tcatalog:        workloadmeta.NodeAgent | workloadmeta.ProcessAgent,\n116: \t\t\tcontToExitInfo: make(map[string]*exitInfo),\n117: \t\t\tknownImages:    newKnownImages(),\n118: \t\t},\n119: \t}, nil\n120: }\n121: \n122: // GetFxOptions returns the FX framework options for the collector\n123: func GetFxOptions() fx.Option {\n124: \treturn fx.Provide(NewCollector)\n125: }\n126: \n127: func (c *collector) Start(ctx context.Context, store workloadmeta.Component) error {\n128: \tif !config.IsFeaturePresent(config.Containerd) {\n129: \t\treturn agentErrors.NewDisabled(componentName, \"Agent is not running on containerd\")\n130: \t}\n131: \n132: \tc.store = store\n133: \n134: \tvar err error\n135: \tc.containerdClient, err = cutil.NewContainerdUtil()\n136: \tif err != nil {\n137: \t\treturn err\n138: \t}\n139: \n140: \tif err = c.startSBOMCollection(ctx); err != nil {\n141: \t\treturn err\n142: \t}\n143: \n144: \tc.filterPausedContainers, err = containers.GetPauseContainerFilter()\n145: \tif err != nil {\n146: \t\treturn err\n147: \t}\n148: \n149: \teventsCtx, cancelEvents := context.WithCancel(ctx)\n150: \tc.eventsChan, c.errorsChan = c.containerdClient.GetEvents().Subscribe(eventsCtx, subscribeFilters()...)\n151: \n152: \terr = c.notifyInitialEvents(ctx)\n153: \tif err != nil {\n154: \t\tcancelEvents()\n155: \t\treturn err\n156: \t}\n157: \n158: \tgo func() {\n159: \t\tdefer func() {\n160: \t\t\tif errClose := c.containerdClient.Close(); errClose != nil {\n161: \t\t\t\tlog.Warnf(\"Error when closing containerd connection: %s\", errClose)\n162: \t\t\t}\n163: \t\t}()\n164: \t\tdefer cancelEvents()\n165: \n166: \t\tc.stream(ctx)\n167: \t}()\n168: \n169: \treturn nil\n170: }\n171: \n172: func (c *collector) Pull(_ context.Context) error {\n173: \treturn nil\n174: }\n175: \n176: func (c *collector) GetID() string {\n177: \treturn c.id\n178: }\n179: \n180: func (c *collector) GetTargetCatalog() workloadmeta.AgentType {\n181: \treturn c.catalog\n182: }\n183: \n184: func (c *collector) stream(ctx context.Context) {\n185: \thealthHandle := health.RegisterLiveness(componentName)\n186: \tctx, cancel := context.WithCancel(ctx)\n187: \n188: \tfor {\n189: \t\tselect {\n190: \t\tcase <-healthHandle.C:\n191: \n192: \t\tcase ev := <-c.eventsChan:\n193: \t\t\tif err := c.handleEvent(ctx, ev); err != nil {\n194: \t\t\t\tlog.Warnf(err.Error())\n195: \t\t\t}\n196: \n197: \t\tcase err := <-c.errorsChan:\n198: \t\t\tif err != nil {\n199: \t\t\t\tlog.Errorf(\"stopping collection: %s\", err)\n200: \t\t\t}\n201: \t\t\tcancel()\n202: \t\t\treturn\n203: \n204: \t\tcase <-ctx.Done():\n205: \t\t\terr := healthHandle.Deregister()\n206: \t\t\tif err != nil {\n207: \t\t\t\tlog.Warnf(\"error de-registering health check: %s\", err)\n208: \t\t\t}\n209: \t\t\tcancel()\n210: \t\t\treturn\n211: \t\t}\n212: \t}\n213: }\n214: \n215: func (c *collector) notifyInitialEvents(ctx context.Context) error {\n216: \tvar containerEvents []workloadmeta.CollectorEvent\n217: \n218: \tnamespaces, err := cutil.NamespacesToWatch(ctx, c.containerdClient)\n219: \tif err != nil {\n220: \t\treturn err\n221: \t}\n222: \n223: \tfor _, namespace := range namespaces {\n224: \t\tnsContainerEvents, err := c.generateInitialContainerEvents(namespace)\n225: \t\tif err != nil {\n226: \t\t\treturn err\n227: \t\t}\n228: \t\tcontainerEvents = append(containerEvents, nsContainerEvents...)\n229: \n230: \t\tif imageMetadataCollectionIsEnabled() {\n231: \t\t\tif err := c.notifyInitialImageEvents(ctx, namespace); err != nil {\n232: \t\t\t\treturn err\n233: \t\t\t}\n234: \t\t}\n235: \t}\n236: \n237: \tif len(containerEvents) > 0 {\n238: \t\tc.store.Notify(containerEvents)\n239: \t}\n240: \n241: \treturn nil\n242: }\n243: \n244: func (c *collector) generateInitialContainerEvents(namespace string) ([]workloadmeta.CollectorEvent, error) {\n245: \tvar events []workloadmeta.CollectorEvent\n246: \n247: \texistingContainers, err := c.containerdClient.Containers(namespace)\n248: \tif err != nil {\n249: \t\treturn nil, err\n250: \t}\n251: \n252: \tfor _, container := range existingContainers {\n253: \t\t// if ignoreContainer returns an error, keep the container\n254: \t\t// regardless.  it might've been because of network errors, so\n255: \t\t// it's better to keep a container we should've ignored than\n256: \t\t// ignoring a container we should've kept\n257: \t\tignore, err := c.ignoreContainer(namespace, container)\n258: \t\tif err != nil {\n259: \t\t\tlog.Debugf(\"Error while deciding to ignore event %s, keeping it: %s\", container.ID(), err)\n260: \t\t} else if ignore {\n261: \t\t\tcontinue\n262: \t\t}\n263: \n264: \t\tev, err := createSetEvent(container, namespace, c.containerdClient)\n265: \t\tif err != nil {\n266: \t\t\tlog.Warnf(err.Error())\n267: \t\t\tcontinue\n268: \t\t}\n269: \n270: \t\tevents = append(events, ev)\n271: \t}\n272: \n273: \treturn events, nil\n274: }\n275: \n276: func (c *collector) notifyInitialImageEvents(ctx context.Context, namespace string) error {\n277: \texistingImages, err := c.containerdClient.ListImages(namespace)\n278: \tif err != nil {\n279: \t\treturn err\n280: \t}\n281: \n282: \tfor _, image := range existingImages {\n283: \t\tif err := c.notifyEventForImage(ctx, namespace, image, nil); err != nil {\n284: \t\t\tlog.Warnf(\"error getting information for image with name %q: %s\", image.Name(), err.Error())\n285: \t\t\tcontinue\n286: \t\t}\n287: \t}\n288: \n289: \treturn nil\n290: }\n291: \n292: func (c *collector) handleEvent(ctx context.Context, containerdEvent *containerdevents.Envelope) error {\n293: \tif isImageTopic(containerdEvent.Topic) {\n294: \t\treturn c.handleImageEvent(ctx, containerdEvent)\n295: \t}\n296: \n297: \treturn c.handleContainerEvent(ctx, containerdEvent)\n298: }\n299: \n300: func (c *collector) handleContainerEvent(ctx context.Context, containerdEvent *containerdevents.Envelope) error {\n301: \tcontainerID, container, err := c.extractContainerFromEvent(ctx, containerdEvent)\n302: \tif err != nil {\n303: \t\treturn fmt.Errorf(\"cannot extract container from event: %w\", err)\n304: \t}\n305: \n306: \tif container != nil {\n307: \t\tignore, err := c.ignoreContainer(containerdEvent.Namespace, container)\n308: \t\tif err != nil {\n309: \t\t\tlog.Debugf(\"Error while deciding to ignore event %s, keeping it: %s\", container.ID(), err)\n310: \t\t} else if ignore {\n311: \t\t\treturn nil\n312: \t\t}\n313: \t}\n314: \n315: \tworkloadmetaEvent, err := c.buildCollectorEvent(containerdEvent, containerID, container)\n316: \tif err != nil {\n317: \t\tif errors.Is(err, errNoContainer) {\n318: \t\t\tlog.Debugf(\"No event could be built as container is nil, skipping event. CID: %s, event: %+v\", containerID, containerdEvent)\n319: \t\t\treturn nil\n320: \t\t}\n321: \n322: \t\treturn fmt.Errorf(\"cannot build collector event: %w\", err)\n323: \t}\n324: \n325: \tc.store.Notify([]workloadmeta.CollectorEvent{workloadmetaEvent})\n326: \n327: \treturn nil\n328: }\n329: \n330: // extractContainerFromEvent extracts a container ID from an event, and\n331: // queries for a containerd.Container object. The Container object will always\n332: // be missing in a delete event, so that's why we return a separate ID and not\n333: // just an object.\n334: func (c *collector) extractContainerFromEvent(ctx context.Context, containerdEvent *containerdevents.Envelope) (string, containerd.Container, error) {\n335: \tvar (\n336: \t\tcontainerID string\n337: \t\thasID       bool\n338: \t)\n339: \n340: \tswitch containerdEvent.Topic {\n341: \tcase containerCreationTopic, containerUpdateTopic, containerDeletionTopic:\n342: \t\tcontainerID, hasID = containerdEvent.Field([]string{\"event\", \"id\"})\n343: \t\tif !hasID {\n344: \t\t\treturn \"\", nil, fmt.Errorf(\"missing ID in containerd event\")\n345: \t\t}\n346: \n347: \tcase TaskStartTopic, TaskOOMTopic, TaskPausedTopic, TaskResumedTopic, TaskExitTopic, TaskDeleteTopic:\n348: \t\tcontainerID, hasID = containerdEvent.Field([]string{\"event\", \"container_id\"})\n349: \t\tif !hasID {\n350: \t\t\treturn \"\", nil, fmt.Errorf(\"missing ID in containerd event\")\n351: \t\t}\n352: \n353: \tdefault:\n354: \t\treturn \"\", nil, fmt.Errorf(\"unknown action type %s, ignoring\", containerdEvent.Topic)\n355: \t}\n356: \n357: \t// ignore NotFound errors, since they happen for every deleted\n358: \t// container, but these events still need to be handled\n359: \tcontainer, err := c.containerdClient.ContainerWithContext(ctx, containerdEvent.Namespace, containerID)\n360: \tif err != nil && !agentErrors.IsNotFound(err) {\n361: \t\treturn \"\", nil, err\n362: \t}\n363: \n364: \treturn containerID, container, nil\n365: }\n366: \n367: // ignoreContainer returns whether a containerd event should be ignored.\n368: // The ignored events are the ones that refer to a \"pause\" container.\n369: func (c *collector) ignoreContainer(namespace string, container containerd.Container) (bool, error) {\n370: \tisSandbox, err := c.containerdClient.IsSandbox(namespace, container)\n371: \tif err != nil {\n372: \t\treturn false, err\n373: \t}\n374: \n375: \tif isSandbox {\n376: \t\treturn true, nil\n377: \t}\n378: \n379: \tinfo, err := c.containerdClient.Info(namespace, container)\n380: \tif err != nil {\n381: \t\treturn false, err\n382: \t}\n383: \n384: \t// Only the image name is relevant to exclude paused containers\n385: \treturn c.filterPausedContainers.IsExcluded(nil, \"\", info.Image, \"\"), nil\n386: }\n387: \n388: func subscribeFilters() []string {\n389: \tvar filters []string\n390: \n391: \tfor _, topic := range containerdTopics {\n392: \t\tif isImageTopic(topic) && !imageMetadataCollectionIsEnabled() {\n393: \t\t\tcontinue\n394: \t\t}\n395: \n396: \t\tfilters = append(filters, fmt.Sprintf(`topic==%q`, topic))\n397: \t}\n398: \n399: \treturn cutil.FiltersWithNamespaces(filters)\n400: }\n401: \n402: func (c *collector) getExitInfo(id string) *exitInfo {\n403: \treturn c.contToExitInfo[id]\n404: }\n405: \n406: func (c *collector) deleteExitInfo(id string) {\n407: \tdelete(c.contToExitInfo, id)\n408: }\n409: \n410: func (c *collector) cacheExitInfo(id string, exitCode *uint32, exitTS time.Time) {\n411: \tc.contToExitInfo[id] = &exitInfo{\n412: \t\texitTS:   exitTS,\n413: \t\texitCode: exitCode,\n414: \t}\n415: }\n416: \n417: func imageMetadataCollectionIsEnabled() bool {\n418: \treturn config.Datadog.GetBool(\"container_image.enabled\")\n419: }\n\n(End of file - total 419 lines)\n</content>",
