              "oldString": "// isNameMoreReadable returns true if newName is more readable than oldName.\n// A name is considered more readable if it doesn't contain a raw sha256 string.\nfunc isNameMoreReadable(oldName, newName string) bool {\n\t// If the old name contains sha256 and the new one doesn't, the new one is more readable\n\tif strings.Contains(oldName, \"sha256:\") && !strings.Contains(newName, \"sha256:\") {\n\t\treturn true\n\t}\n\treturn false\n}",
              "newString": "// isNameMoreReadable returns true if newName is more readable than oldName.\n// A name is considered more readable if it doesn't contain a raw sha256 string.\n// A raw sha256 string is an image ID that starts with \"sha256:\" (like \"sha256:abc123...\").\n// Repository digests (like \"repo@sha256:abc123...\") are considered more readable than raw IDs\n// because they include the repository name, but less readable than repo tags.\nfunc isNameMoreReadable(oldName, newName string) bool {\n\t// A raw image ID starts with \"sha256:\" and contains no \"@\"\n\tisRawImageID := func(name string) bool {\n\t\treturn strings.HasPrefix(name, \"sha256:\") && !strings.Contains(name, \"@\")\n\t}\n\n\toldIsRawID := isRawImageID(oldName)\n\tnewIsRawID := isRawImageID(newName)\n\n\t// If old is a raw ID and new is not, new is more readable\n\tif oldIsRawID && !newIsRawID {\n\t\treturn true\n\t}\n\n\t// If old is a repo digest (contains @sha256:) and new is a repo tag (no sha256), new is more readable\n\tif strings.Contains(oldName, \"@sha256:\") && !strings.Contains(newName, \"sha256:\") {\n\t\treturn true\n\t}\n\n\treturn false\n}"
