            "output": "<path>/workspace/sdk/ml/azure-ai-ml/tests/finetuning_job/unittests/test_finetuning_job_convesion.py</path>\n<type>file</type>\n<content>\n1: from azure.ai.ml.constants._common import AssetTypes\n2: from azure.ai.ml.entities._inputs_outputs import Input, Output\n3: from typing import Optional, Dict\n4: from azure.ai.ml._restclient.v2024_01_01_preview.models import (\n5:     UriFileJobInput,\n6:     MLFlowModelJobInput,\n7:     FineTuningTaskType,\n8: )\n9: from azure.ai.ml.entities._job.finetuning.custom_model_finetuning_job import CustomModelFineTuningJob\n10: from azure.ai.ml.entities._job.finetuning.azure_openai_finetuning_job import AzureOpenAIFineTuningJob\n11: from azure.ai.ml.entities._job.finetuning.azure_openai_hyperparameters import AzureOpenAIHyperparameters\n12: import pytest\n13: \n14: \n15: @pytest.mark.finetuning_test\n16: @pytest.mark.unittest\n17: class TestCustomModelFineTuningJob:\n18:     @pytest.mark.parametrize(\n19:         \"task\",\n20:         [\n21:             FineTuningTaskType.CHAT_COMPLETION,\n22:             FineTuningTaskType.TEXT_COMPLETION,\n23:             FineTuningTaskType.TEXT_CLASSIFICATION,\n24:             FineTuningTaskType.QUESTION_ANSWERING,\n25:             FineTuningTaskType.TEXT_SUMMARIZATION,\n26:             FineTuningTaskType.TOKEN_CLASSIFICATION,\n27:             FineTuningTaskType.TEXT_TRANSLATION,\n28:             FineTuningTaskType.IMAGE_CLASSIFICATION,\n29:             FineTuningTaskType.IMAGE_INSTANCE_SEGMENTATION,\n30:             FineTuningTaskType.IMAGE_OBJECT_DETECTION,\n31:             FineTuningTaskType.VIDEO_MULTI_OBJECT_TRACKING,\n32:         ],\n33:     )\n34:     def test_custom_model_finetuning_job_conversion(self, task: str):\n35:         # Create Custom Model FineTuning Job\n36:         custom_model_finetuning_job = self._get_custom_model_finetuning_job(\n37:             task=task,\n38:             display_name=\"llama-display-name\",\n39:             training_data=Input(type