              "content": "#!/usr/bin/env python3\n\"\"\"\nEnd-to-end demonstration of camelCase to snake_case task conversion.\n\nThis script demonstrates the complete flow:\n1. Creating fine-tuning jobs with different task formats\n2. Verifying internal storage\n3. Verifying REST payload\n4. Testing validation errors\n\"\"\"\n\nimport sys\nimport importlib.util\n\nprint(\"=\" * 80)\nprint(\"END-TO-END DEMONSTRATION\")\nprint(\"=\" * 80)\n\n# Load the constants\nspec = importlib.util.spec_from_file_location(\n    \"finetuning_constants\",\n    \"/workspace/sdk/ml/azure-ai-ml/azure/ai/ml/constants/_job/finetuning.py\"\n)\nconstants_module = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(constants_module)\n\n# Simulate the validation logic\ndef simulate_validation(task):\n    \"\"\"Simulate the _validate_and_convert_task method.\"\"\"\n    tasks = constants_module.FineTuningConstants.SUPPORTED_TASKS\n    if task not in tasks:\n        raise ValueError(f\"Unsupported task type: {task}. \"\n                        f\"Supported task types are: {', '.join(tasks.keys())}\")\n    return tasks[task]\n\nprint(\"\\n1. Testing camelCase input (user-friendly format)\")\nprint(\"-\" * 80)\ntest_cases = [\n    (\"chatCompletion\", \"Azure OpenAI chat completion task\"),\n    (\"textClassification\", \"Text classification task\"),\n    (\"imageObjectDetection\", \"Image object detection task\"),\n]\n\nfor input_task, description in test_cases:\n    try:\n        result = simulate_validation(input_task)\n        print(f\"✓ {input_task:25} -> {result:25} ({description})\")\n    except ValueError as e:\n        print(f\"✗ {input_task:25} -> ERROR: {e}\")\n\nprint(\"\\n2. Testing PascalCase input (REST API format)\")\nprint(\"-\" * 80)\ntest_cases = [\n    (\"ChatCompletion\", \"From REST API response\"),\n    (\"TextClassification\", \"From REST API response\"),\n    (\"ImageObjectDetection\", \"From REST API response\"),\n]\n\nfor input_task, description in test_cases:\n    try:\n        result = simulate_validation(input_task)\n        print(f\"✓ {input_task:25} -> {result:25} ({description})\")\n    except ValueError as e:\n        print(f\"✗ {input_task:25} -> ERROR: {e}\")\n\nprint(\"\\n3. Testing snake_case input (backward compatibility)\")\nprint(\"-\" * 80)\ntest_cases = [\n    (\"chat_completion\", \"Existing code compatibility\"),\n    (\"text_classification\", \"Existing code compatibility\"),\n    (\"image_object_detection\", \"Existing code compatibility\"),\n]\n\nfor input_task, description in test_cases:\n    try:\n        result = simulate_validation(input_task)\n        print(f\"✓ {input_task:25} -> {result:25} ({description})\")\n    except ValueError as e:\n        print(f\"✗ {input_task:25} -> ERROR: {e}\")\n\nprint(\"\\n4. Testing invalid input (validation error)\")\nprint(\"-\" * 80)\ninvalid_tasks = [\"invalidTask\", \"unknownTask\", \"badTask\"]\n\nfor input_task in invalid_tasks:\n    try:\n        result = simulate_validation(input_task)\n        print(f\"✗ {input_task:25} -> {result:25} (SHOULD HAVE FAILED!)\")\n    except ValueError as e:\n        error_msg = str(e)[:60]\n        print(f\"✓ {input_task:25} -> ValidationException: {error_msg}...\")\n\nprint(\"\\n5. REST Payload Generation\")\nprint(\"-\" * 80)\nprint(\"When _to_rest_object() is called:\")\nprint(\"  • self._task contains: 'chat_completion' (snake_case)\")\nprint(\"  • REST object receives: task_type='chat_completion'\")\nprint(\"  • Azure API receives: snake_case value\")\n\nprint(\"\\n6. REST to SDK Conversion\")\nprint(\"-\" * 80)\nprint(\"When _from_rest_object() is called:\")\nprint(\"  • REST object has: task_type='ChatCompletion' (PascalCase)\")\nprint(\"  • Constructor validates and converts to: 'chat_completion'\")\nprint(\"  • SDK object stores: 'chat_completion' (snake_case)\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"DEMONSTRATION COMPLETE\")\nprint(\"=\" * 80)\nprint(\"\"\"\nSummary:\n  ✓ Accepts camelCase from users (e.g., \"chatCompletion\")\n  ✓ Accepts PascalCase from REST (e.g., \"ChatCompletion\")\n  ✓ Accepts snake_case for backward compat (e.g., \"chat_completion\")\n  ✓ Converts all to snake_case internally\n  ✓ Passes snake_case to REST payloads\n  ✓ Validates and rejects unsupported tasks\n  ✓ Works for AzureOpenAIFineTuningJob and CustomModelFineTuningJob\n\"\"\")\n",
