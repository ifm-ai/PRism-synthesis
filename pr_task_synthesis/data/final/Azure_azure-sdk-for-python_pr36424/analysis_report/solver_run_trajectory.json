            {
              "file": "sdk/ml/azure-ai-ml/tests/finetuning_job/unittests/test_task_conversion.py",
              "patch": "Index: sdk/ml/azure-ai-ml/tests/finetuning_job/unittests/test_task_conversion.py\n===================================================================\n--- sdk/ml/azure-ai-ml/tests/finetuning_job/unittests/test_task_conversion.py\t\n+++ sdk/ml/azure-ai-ml/tests/finetuning_job/unittests/test_task_conversion.py\t\n@@ -0,0 +1,169 @@\n+\"\"\"Test camelCase to snake_case task conversion for fine-tuning jobs.\"\"\"\n+\n+import pytest\n+from azure.ai.ml.constants._common import AssetTypes\n+from azure.ai.ml.entities._inputs_outputs import Input\n+from azure.ai.ml.entities._job.finetuning.custom_model_finetuning_job import CustomModelFineTuningJob\n+from azure.ai.ml.entities._job.finetuning.azure_openai_finetuning_job import AzureOpenAIFineTuningJob\n+from azure.ai.ml.entities._job.finetuning.azure_openai_hyperparameters import AzureOpenAIHyperparameters\n+from azure.ai.ml.exceptions import ValidationException\n+\n+\n+@pytest.mark.finetuning_test\n+@pytest.mark.unittest\n+class TestTaskConversion:\n+    \"\"\"Test camelCase to snake_case task conversion.\"\"\"\n+\n+    @pytest.mark.parametrize(\n+        \"task_input,expected_snake_case\",\n+        [\n+            # camelCase\n+            (\"chatCompletion\", \"chat_completion\"),\n+            (\"textCompletion\", \"text_completion\"),\n+            (\"textClassification\", \"text_classification\"),\n+            (\"questionAnswering\", \"question_answering\"),\n+            (\"textSummarization\", \"text_summarization\"),\n+            (\"tokenClassification\", \"token_classification\"),\n+            (\"textTranslation\", \"text_translation\"),\n+            (\"imageClassification\", \"image_classification\"),\n+            (\"imageInstanceSegmentation\", \"image_instance_segmentation\"),\n+            (\"imageObjectDetection\", \"image_object_detection\"),\n+            (\"videoMultiObjectTracking\", \"video_multi_object_tracking\"),\n+            # PascalCase (from REST API)\n+            (\"ChatCompletion\", \"chat_completion\"),\n+            (\"TextCompletion\", \"text_completion\"),\n+            (\"TextClassification\", \"text_classification\"),\n+            (\"QuestionAnswering\", \"question_answering\"),\n+            (\"TextSummarization\", \"text_summarization\"),\n+            (\"TokenClassification\", \"token_classification\"),\n+            (\"TextTranslation\", \"text_translation\"),\n+            (\"ImageClassification\", \"image_classification\"),\n+            (\"ImageInstanceSegmentation\", \"image_instance_segmentation\"),\n+            (\"ImageObjectDetection\", \"image_object_detection\"),\n+            (\"VideoMultiObjectTracking\", \"video_multi_object_tracking\"),\n+            # snake_case (backward compatibility)\n+            (\"chat_completion\", \"chat_completion\"),\n+            (\"text_completion\", \"text_completion\"),\n+            (\"text_classification\", \"text_classification\"),\n+            (\"question_answering\", \"question_answering\"),\n+            (\"text_summarization\", \"text_summarization\"),\n+            (\"token_classification\", \"token_classification\"),\n+            (\"text_translation\", \"text_translation\"),\n+            (\"image_classification\", \"image_classification\"),\n+            (\"image_instance_segmentation\", \"image_instance_segmentation\"),\n+            (\"image_object_detection\", \"image_object_detection\"),\n+            (\"video_multi_object_tracking\", \"video_multi_object_tracking\"),\n+        ],\n+    )\n+    def test_custom_model_task_conversion(self, task_input, expected_snake_case):\n+        \"\"\"Test that CustomModelFineTuningJob accepts camelCase/PascalCase/snake_case and stores snake_case.\"\"\"\n+        job = CustomModelFineTuningJob(\n+            task=task_input,\n+            model=Input(\n+                type=AssetTypes.MLFLOW_MODEL,\n+                path=\"azureml://registries/azureml-meta/models/Llama-2-7b/versions/9\"\n+            ),\n+            training_data=Input(type=AssetTypes.URI_FILE, path=\"https://foo/bar/train.csv\"),\n+        )\n+        \n+        assert job.task == expected_snake_case, f\"Expected {expected_snake_case}, got {job.task}\"\n+        \n+        rest_obj = job._to_rest_object()\n+        assert rest_obj.properties.fine_tuning_details.task_type == expected_snake_case\n+\n+    @pytest.mark.parametrize(\n+        \"task_input,expected_snake_case\",\n+        [\n+            # camelCase\n+            (\"chatCompletion\", \"chat_completion\"),\n+            (\"textCompletion\", \"text_completion\"),\n+            # PascalCase\n+            (\"ChatCompletion\", \"chat_completion\"),\n+            (\"TextCompletion\", \"text_completion\"),\n+            # snake_case\n+            (\"chat_completion\", \"chat_completion\"),\n+            (\"text_completion\", \"text_completion\"),\n+        ],\n+    )\n+    def test_azure_openai_task_conversion(self, task_input, expected_snake_case):\n+        \"\"\"Test that AzureOpenAIFineTuningJob accepts camelCase/PascalCase/snake_case and stores snake_case.\"\"\"\n+        job = AzureOpenAIFineTuningJob(\n+            task=task_input,\n+            model=Input(\n+                type=AssetTypes.MLFLOW_MODEL,\n+                path=\"azureml://registries/azure-openai-v2/models/gpt-4/versions/1\"\n+            ),\n+            training_data=Input(type=AssetTypes.URI_FILE, path=\"https://foo/bar/train.csv\"),\n+            hyperparameters=AzureOpenAIHyperparameters(batch_size=2, n_epochs=3),\n+        )\n+        \n+        assert job.task == expected_snake_case, f\"Expected {expected_snake_case}, got {job.task}\"\n+        \n+        rest_obj = job._to_rest_object()\n+        assert rest_obj.properties.fine_tuning_details.task_type == expected_snake_case\n+\n+    def test_invalid_task_raises_validation_error(self):\n+        \"\"\"Test that invalid task types raise ValidationException.\"\"\"\n+        with pytest.raises(ValidationException) as exc_info:\n+            CustomModelFineTuningJob(\n+                task=\"invalidTask\",\n+                model=Input(\n+                    type=AssetTypes.MLFLOW_MODEL,\n+                    path=\"azureml://registries/azureml-meta/models/Llama-2-7b/versions/9\"\n+                ),\n+                training_data=Input(type=AssetTypes.URI_FILE, path=\"https://foo/bar/train.csv\"),\n+            )\n+        \n+        assert \"Unsupported task type: invalidTask\" in str(exc_info.value)\n+        assert \"chatCompletion\" in str(exc_info.value)\n+\n+    def test_task_setter_conversion(self):\n+        \"\"\"Test that task setter also performs conversion.\"\"\"\n+        job = CustomModelFineTuningJob(\n+            task=\"chatCompletion\",\n+            model=Input(\n+                type=AssetTypes.MLFLOW_MODEL,\n+                path=\"azureml://registries/azureml-meta/models/Llama-2-7b/versions/9\"\n+            ),\n+            training_data=Input(type=AssetTypes.URI_FILE, path=\"https://foo/bar/train.csv\"),\n+        )\n+        \n+        assert job.task == \"chat_completion\"\n+        \n+        job.task = \"textClassification\"\n+        assert job.task == \"text_classification\"\n+\n+    def test_invalid_task_setter_raises_error(self):\n+        \"\"\"Test that setting invalid task raises ValidationException.\"\"\"\n+        job = CustomModelFineTuningJob(\n+            task=\"chatCompletion\",\n+            model=Input(\n+                type=AssetTypes.MLFLOW_MODEL,\n+                path=\"azureml://registries/azureml-meta/models/Llama-2-7b/versions/9\"\n+            ),\n+            training_data=Input(type=AssetTypes.URI_FILE, path=\"https://foo/bar/train.csv\"),\n+        )\n+        \n+        with pytest.raises(ValidationException) as exc_info:\n+            job.task = \"invalidTask\"\n+        \n+        assert \"Unsupported task type: invalidTask\" in str(exc_info.value)\n+\n+    def test_roundtrip_conversion(self):\n+        \"\"\"Test that conversion to REST and back preserves snake_case task.\"\"\"\n+        original_job = CustomModelFineTuningJob(\n+            task=\"chatCompletion\",\n+            model=Input(\n+                type=AssetTypes.MLFLOW_MODEL,\n+                path=\"azureml://registries/azureml-meta/models/Llama-2-7b/versions/9\"\n+            ),\n+            training_data=Input(type=AssetTypes.URI_FILE, path=\"https://foo/bar/train.csv\"),\n+        )\n+        \n+        assert original_job.task == \"chat_completion\"\n+        \n+        rest_obj = original_job._to_rest_object()\n+        assert rest_obj.properties.fine_tuning_details.task_type == \"chat_completion\"\n+        \n+        restored_job = CustomModelFineTuningJob._from_rest_object(rest_obj)\n+        assert restored_job.task == \"chat_completion\"\n",
              "additions": 169,
