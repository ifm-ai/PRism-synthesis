          "messageID": "msg_eee50368b001Wo11t7sn5A4eul"
        },
        {
          "type": "tool",
          "tool": "bash",
          "callID": "call_636f35f6f73d4e359de00ada",
          "state": {
            "status": "completed",
            "input": {
              "command": "cd /workspace/sdk/ml/azure-ai-ml && python3 << 'EOF'\n# Simulate the conversion logic\nimport re\n\ndef _camel_to_snake_convert(text: str) -> str:\n    text = re.sub('(.)([A-Z][a-z]+)', r'\\1_\\2', text)\n    return re.sub('([a-z0-9])([A-Z])', r'\\1_\\2', text).lower()\n\nSUPPORTED_TASKS = {\n    \"chatCompletion\": \"chat_completion\",\n    \"ChatCompletion\": \"chat_completion\",\n    \"textCompletion\": \"text_completion\",\n    \"TextCompletion\": \"text_completion\",\n}\n\ndef validate_and_convert(task):\n    if task not in SUPPORTED_TASKS:\n        raise ValueError(f\"Unsupported task: {task}\")\n    return SUPPORTED_TASKS[task]\n\n# Test cases\ntest_cases = [\n    (\"chatCompletion\", \"chat_completion\"),  # User provides camelCase\n    (\"ChatCompletion\", \"chat_completion\"),  # REST provides PascalCase\n    (\"textCompletion\", \"text_completion\"),\n    (\"TextCompletion\", \"text_completion\"),\n]\n\nprint(\"Testing task conversion:\")\nfor input_task, expected in test_cases:\n    result = validate_and_convert(input_task)\n    status = \"✓\" if result == expected else \"✗\"\n    print(f\"  {status} {input_task:20} -> {result:20} (expected: {expected})\")\n\n# Test invalid task\ntry:\n    validate_and_convert(\"invalidTask\")\n    print(\"  ✗ Should have raised error for invalidTask\")\nexcept ValueError as e:\n    print(f\"  ✓ Invalid task correctly rejected: {e}\")\nEOF\n",
              "description": "Test conversion logic"
            },
            "output": "Testing task conversion:\n  ✓ chatCompletion       -> chat_completion      (expected: chat_completion)\n  ✓ ChatCompletion       -> chat_completion      (expected: chat_completion)\n  ✓ textCompletion       -> text_completion      (expected: text_completion)\n  ✓ TextCompletion       -> text_completion      (expected: text_completion)\n  ✓ Invalid task correctly rejected: Unsupported task: invalidTask\n",
            "metadata": {
              "output": "Testing task conversion:\n  ✓ chatCompletion       -> chat_completion      (expected: chat_completion)\n  ✓ ChatCompletion       -> chat_completion      (expected: chat_completion)\n  ✓ textCompletion       -> text_completion      (expected: text_completion)\n  ✓ TextCompletion       -> text_completion      (expected: text_completion)\n  ✓ Invalid task correctly rejected: Unsupported task: invalidTask\n",
