e comment requires multiple lines, start a new line and indent everything after this.\n490:         var commentRows = NormalizeMultilineComment(item.MiddleComment, int.MaxValue);\n491:         _buffer.EndLine(_pads.EOL);\n492:         \n493:         foreach (var row in commentRows)\n494:             _buffer.Add(Options.PrefixString, _pads.Indent(depth+1), row).EndLine(_pads.EOL);\n495:         \n496:         _buffer.Add(Options.PrefixString, _pads.Indent(depth+1));\n497:         return depth + 1;\n498:     }\n499: \n500:     /// <summary>\n501:     /// Do the stuff that's usually the same for the end of all formatted items, like trailing commas and postfix\n502:     /// comments.\n503:     /// </summary>\n504:     private void StandardFormatEnd(JsonItem item, bool includeTrailingComma)\n505:     {\n506:         if (includeTrailingComma && item.IsPostCommentLineStyle)\n507:             _buffer.Add(_pads.Comma);\n508:         if (item.PostfixCommentLength > 0)\n509:             _buffer.Add(_pads.Comment, item.PostfixComment);\n510:         if (includeTrailingComma && !item.IsPostCommentLineStyle)\n511:             _buffer.Add(_pads.Comma);\n512:         _buffer.EndLine(_pads.EOL);\n513:     }\n514:     \n515: \n516:     /// <summary>\n517:     /// Adds the inline representation of this item to the buffer.  This includes all of this element's\n518:     /// comments and children when appropriate.  It DOES NOT include indentation, newlines, or any of that.  This\n519:     /// should only be called if item.RequiresMultipleLines is false.\n520:     /// </summary>\n521:     private void InlineElement(JsonItem item, bool includeTrailingComma)\n522:     {\n523:         if (item.RequiresMultipleLines)\n524:             throw new FracturedJsonException(\"Logic error - trying to inline invalid element\");\n525:         \n526:         if (item.PrefixCommentLength > 0)\n527:             _buffer.Add(item.PrefixComment, _pads.Comment);\n528:         \n529:         if (item.NameLengt