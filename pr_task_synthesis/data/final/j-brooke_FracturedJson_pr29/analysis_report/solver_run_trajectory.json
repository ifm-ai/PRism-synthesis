depth, includeTrailingComma);\n216:                 break;\n217:         }\n218:     }\n219: \n220:     /// <summary>\n221:     /// Adds the representation for an array or object to the buffer, including all necessary indents, newlines, etc.\n222:     /// The array/object might be formatted inline, compact multiline, table, or expanded, according to circumstances.\n223:     /// </summary>\n224:     private void FormatContainer(JsonItem item, int depth, bool includeTrailingComma)\n225:     {\n226:         // Try to inline of compact-multiline format, as long as we're deeper than AlwaysExpandDepth.  Of course,\n227:         // there may be other disqualifying factors that are discovered along the way.\n228:         if (depth > Options.AlwaysExpandDepth)\n229:         {\n230:             if (FormatContainerInline(item, depth, includeTrailingComma))\n231:                 return;\n232:             if (FormatContainerCompactMultiline(item, depth, includeTrailingComma))\n233:                 return;\n234:         }\n235: \n236:         // Allow table formatting at the specified depth, too.  So if this is a root level array and\n237:         // AlwaysExpandDepth=0, we can table format it.  But if AlwaysExpandDepth=1, we can't format the root\n238:         // as a table, since a table's children are always inlined (and thus not expanded).\n239:         if (depth >= Options.AlwaysExpandDepth)\n240:         {\n241:             if (FormatContainerTable(item, depth, includeTrailingComma))\n242:                 return;\n243:         }\n244: \n245:         FormatContainerExpanded(item, depth, includeTrailingComma);\n246:     }\n247: \n248:     /// <summary>\n249:     /// Tries to add the representation for an array or object to the buffer, including all necessary indents, newlines, \n250:     /// etc., if the array/object qualifies.\n251:     /// </summary>\n252:     /// <returns>True if the content was added.</returns>\n253:     private bool FormatContainerInline(JsonItem item, int depth, bool includeTrailingComma)\n254:     {\n255:         if (item.RequiresMultipleLines)\n256:             return false;\n257:         var lengthToConsider = item.MinimumTotalLength + ((includeTrailingComma) ? _pads.CommaLen : 0);\n258:         if (item.Complexity > Options.MaxInlineComplexity  || lengthToConsider > AvailableLineSpace(depth))\n259:             return false;\n260: \n261:         _buffer.Add(Options.PrefixString, _pads.Indent(depth));\n262:         InlineElement(item, includeTrailingComma);\n263:         _buffer.EndLine(_pads.EOL);\n264: \n265:         return true;\n266:     }\n267: \n268:     /// <summary>\n269:     /// Tries to add the representation of this array to the buffer, including indents and things, spanning multiple \n270:     /// lines but with each child written inline and several of them per line.\n271:     /// </summary>\n272:     /// <returns>True if the content was added</returns>\n273:     private bool FormatContainerCompactMultiline(JsonItem item, int depth, bool includeTrailingComma)\n274:     {\n275:         if (item.Type != JsonItemType.Array)\n276:             return false;\n277:         if (item.Complexity > Options.MaxCompactArrayComplexity)\n278:             return false;\n279:         if (item.RequiresMultipleLines)\n280:             return false;\n281: \n282:         // If all items are alike, we'll want to format each element as if it were a table row.\n283:         var template = new TableTemplate(_pads, !Options.DontJustifyNumbers);\n284:         template.MeasureTableRoot(item);\n285: \n286:         // If we can't fit lots of them on a line, compact multiline isn't a good choice.  Table would likely\n287:         // be better.\n288:         var likelyAvailableLineSpace = AvailableLineSpace(depth+1);\n289:         var avgItemWidth = _pads.CommaLen\n290:                            + ((template.IsRowDataCompatible)\n291:                                ? template.TotalLength\n292:                                : item.Children.Sum(ch => ch.MinimumTotalLength) / item.Children.Count);\n293:         if (avgItemWidth * Options.MinCompactArrayRowItems > likelyAvailableLineSpace)\n294:             return false;\n295: \n296: \n297:         // Add prefixString, indent, prefix comment, starting bracket (with no EOL).\n298:         var depthAfterColon = StandardFormatStart(item, depth);\n299:         _buffer.Add(_pads.Start(item.Type, BracketPaddingType.Empty));\n300: \n301:         var availableLineSpace = AvailableLineSpace(depthAfterColon+1);\n302:         var remainingLineSpace = -1;\n303:         for (var i=0; i<item.Children.Count; ++i)\n304:         {\n305:             // Figure out whether the next item fits on the current line.  If not, start a new one.\n306:             var child = item.Children[i];\n307:             var needsComma = (i < item.Children.Count - 1);\n308:             var spaceNeededForNext = ((needsComma) ? _pads.CommaLen : 0) + \n309:                                      ((template.IsRowDataCompatible) ? template.TotalLength : child.MinimumTotalLength);\n310: \n311:             if (remainingLineSpace < spaceNeededForNext)\n312:             {\n313:                 _buffer.EndLine(_pads.EOL).Add(Options.PrefixString, _pads.Indent(depthAfterColon+1));\n314:                 remainingLineSpace = availableLineSpace;\n315:             }\n316:             \n317:             // Write it out\n318:             if (template.IsRowDataCompatible)\n319:                 InlineTableRowSegment(template, child, needsComma, false);\n320:             else\n321:                 InlineElement(child, needsComma);\n322:             remainingLineSpace -= spaceNeededForNext;\n323:         }\n324: \n325:         // The previous line won't have ended yet, so do a line feed and indent before the closing bracket.\n326:         _buffer.EndLine(_pads.EOL).Add(Options.PrefixString, _pads.Indent(depthAfterColon),\n327:             _pads.End(item.Type, BracketPaddingType.Empty));\n328: \n329:         StandardFormatEnd(item, includeTrailingComma);\n330:         return true;\n331:     }\n332: \n333:     /// <summary>\n334:     /// Tries to format this array/object as a table.  That is, each of this JsonItem's children are each written\n335:     /// as a single line, with their pieces formatted to line up.  This only works if the structures and types\n336:     /// are consistent for all rows.\n337:     /// </summary>\n338:     /// <returns>True if the content was added</returns>\n339:     private bool FormatContainerTable(JsonItem item, int depth, bool includeTrailingComma)\n340:     {\n341:         // If this element's children are too complex to be written inline, don't bother.\n342:         if (item.Complexity > Options.MaxTableRowComplexity + 1)\n343:             return false;\n344:         \n345:         var availableSpace = AvailableLineSpace(depth + 1) - _pads.CommaLen;\n346: \n347:         // If any child element is too long even without formatting, don't bother.\n348:         var isChildTooLong = item.Children\n349:             .Where(ch => ch.Type is not (JsonItemType.BlankLine or JsonItemType.LineComment or JsonItemType.BlockComment))\n350:             .Any(ch => ch.MinimumTotalLength > availableSpace);\n351:         if (isChildTooLong)\n352:             return false;\n353: \n354:         // Create a helper object to measure how much space we'll need.  If this item's children aren't sufficiently\n355:         // similar, IsRowDataCompatible will be false.\n356:         var template = new TableTemplate(_pads, !Options.DontJustifyNumbers);\n357:         template.MeasureTableRoot(item);\n358:         if (!template.IsRowDataCompatible)\n359:             return false;\n360: \n361:         // If the rows won't fit with everything (including descendents) tabular, try dropping the columns for\n362:         // the deepest nested items, repeatedly, until it either fits or we give up.\n363:         //\n364:         // For instance, here's an example of what full