          \"    [5, 6.0, 7,   8]  \\n\" +\n50:             \"]\";\n51: \n52:         // Since this is table formatting, each column is consistent, but not siblings in the same array.\n53:         var opts = new FracturedJsonOptions() { MaxInlineComplexity = -1, JsonEolStyle = EolStyle.Lf };\n54: \n55:         var formatter = new Formatter() { Options = opts };\n56:         var output = formatter.Reformat(input, 0);\n57: \n58:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n59:     }\n60: \n61:     [TestMethod]\n62:     public void DontJustifyOptionRespected()\n63:     {\n64:         const string input = \"[1, 2.1, 3, -99]\";\n65:         const string expectedOutput = \"[\\n    1  , 2.1, 3  , -99\\n]\";\n66: \n67:         // Here, it's formatted as a compact multiline array (but not really multiline).  But since we're telling it\n68:         // not to justify numbers, they're treated like text: left-aligned and space-padded.\n69:         var opts = new FracturedJsonOptions()\n70:             { MaxInlineComplexity = -1, DontJustifyNumbers = true, JsonEolStyle = EolStyle.Lf };\n71: \n72:         var formatter = new Formatter() { Options = opts };\n73:         var output = formatter.Reformat(input, 0);\n74: \n75:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n76:     }\n77: \n78:     [TestMethod]\n79:     public void BigNumbersInvalidateAlignment1()\n80:     {\n81:         const string input = \"[1, 2.1, 3, 1e+99]\";\n82:         const string expectedOutput = \"[\\n    1    , 2.1  , 3    , 1e+99\\n]\";\n83: \n84:         // If there's a number that requires an \"E\", don't try to justify the numbers.\n85:         var opts = new FracturedJsonOptions()\n86:             { MaxInlineComplexity = -1, JsonEolStyle = EolStyle.Lf };\n87: \n88:         var formatter = new Formatter() { Options = opts };\n89:         var output = formatter.Reformat(input, 0);\n90: \n91:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n92:     }\n93: \n94:     [TestMethod]\n95:     public void BigNumbersInvalidateAlignment2()\n96:     {\n97:         const string input = \"[1, 2.1, 3, 1234567890123456]\";\n98:         const string expectedOutput = \"[\\n    1               , 2.1             , 3               , 1234567890123456\\n]\";\n99: \n100:         // If there's a number with too many significant digits, don't try to justify the numbers.\n101:         var opts = new FracturedJsonOptions()\n102:             { MaxInlineComplexity = -1, JsonEolStyle = EolStyle.Lf };\n103: \n104:         var formatter = new Formatter() { Options = opts };\n105:         var output = formatter.Reformat(input, 0);\n106: \n107:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n108:     }\n109: \n110:     [TestMethod]\n111:     public void NullsRespectedWhenAligningNumbers()\n112:     {\n113:         const string input = \"[1, 2, null, -99]\";\n114:         const string expectedOutput = \"[\\n       1,    2, null,  -99\\n]\";\n115: \n116:         // In general, if an array contains stuff other than numbers, we don't try to justify them.  Null is an\n117:         // exception though: an array of numbers and nulls should be justified as numbers.\n118:         var opts = new FracturedJsonOptions() { MaxInlineComplexity = -1, JsonEolStyle = EolStyle.Lf };\n119: \n120:         var formatter = new Formatter() { Options = opts };\n121:         var output = formatter.Reformat(input, 0);\n122: \n123:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n124:     }\n125: \n126:     [TestMethod]\n127:     public void OverflowDoubleInvalidatesAlignment()\n128:     {\n129:         const string input = \"[1e500, 4.0]\";\n130:         const string expectedOutput = \"[\\n    1e500, 4.0  \\n]\";\n131: \n132:         // If a number is too big to fit in a 64-bit float, we shouldn't try to reformat its column/array.\n133:         // If we did, it would turn into \"Infinity\", isn't a valid JSON token.\n134:         var opts = new FracturedJsonOption