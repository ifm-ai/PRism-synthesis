            "output": "<path>/workspace/FracturedJson/Formatter.cs</path>\n<type>file</type>\n<content>\n1: ﻿using System;\n2: using System.Collections.Generic;\n3: using System.IO;\n4: using System.Linq;\n5: using System.Text.Json;\n6: using FracturedJson.Formatting;\n7: using FracturedJson.Parsing;\n8: \n9: namespace FracturedJson;\n10: \n11: /// <summary>\n12: /// Class that writes JSON data in a human-friendly format.  Comments are optionally supported.  While many options\n13: /// are supported through <see cref=\"FracturedJsonOptions\"/>, generally this class should \"just work\", producing\n14: /// reasonable output for any JSON doc.\n15: /// </summary>\n16: public class Formatter\n17: {\n18:     /// <summary>\n19:     /// Settings controlling output and defining permissible input.\n20:     /// </summary>\n21:     public FracturedJsonOptions Options { get; set; } = new();\n22: \n23:     /// <summary>\n24:     /// Function that returns the width of the input string, for purposes of aligning text.\n25:     /// </summary>\n26:     public Func<string,int> StringLengthFunc { get; set; } = StringLengthByCharCount;\n27: \n28:     /// <summary>\n29:     /// Reads in JSON text (or JSON-with-comments), and returns a nicely-formatted string of the same content.\n30:     /// </summary>\n31:     public string Reformat(IEnumerable<char> jsonText, int startingDepth = 0)\n32:     {\n33:         var buffer = new StringBuilderBuffer(Options.OmitTrailingWhitespace);\n34:         var parser = new Parser() { Options = Options };\n35:         var docModel = parser.ParseTopLevel(jsonText, true);\n36:         FormatTopLevel(docModel, startingDepth, buffer);\n37: \n38:         buffer.Flush();\n39:         return buffer.AsString();\n40:     }\n41: \n42:     /// <summary>\n43:     /// Reads in JSON text (or JSON-with-comments), and writes a nicely-formatted version of the same content\n44:     /// to the writer.\n45:     /// </summary>\n46:     public void Reformat(IEnumerable<char> jsonText, int startingDepth, TextWriter writer)\n47:     {\n48:         var buffer = new LineWriterBuffer(writer, Options.OmitTrailingWhitespace);\n49:         var parser = new Parser() { Options = Options };\n50:         var docModel = parser.ParseTopLevel(jsonText, true);\n51:         FormatTopLevel(docModel, startingDepth, buffer);\n52: \n53:         buffer.Flush();\n54:     }\n55: \n56:     /// <summary>\n57:     /// Writes the serialized object as a nicely-formatted string.\n58:     /// </summary>\n59:     public string Serialize<T>(T obj, int startingDepth = 0, JsonSerializerOptions? serOpts = null)\n60:     {\n61:         var buffer = new StringBuilderBuffer(Options.OmitTrailingWhitespace);\n62:         var rootElem = DomConverter.Convert(JsonSerializer.SerializeToElement(obj, serOpts), null);\n63:         FormatTopLevel(new[] { rootElem }, startingDepth, buffer);\n64: \n65:         buffer.Flush();\n66:         return buffer.AsString();\n67:     }\n68: \n69:     /// <summary>\n70:     /// Writes the serialized object to the writer as a nicely-formatted text.\n71:     /// </summary>\n72:     public void Serialize<T>(T obj, int startingDepth, TextWriter writer, JsonSerializerOptions? serOpts = null)\n73:     {\n74:         var buffer = new LineWriterBuffer(writer, Options.OmitTrailingWhitespace);\n75:         var rootElem = DomConverter.Convert(JsonSerializer.SerializeToElement(obj, serOpts), null);\n76:         FormatTopLevel(new[] { rootElem }, startingDepth, buffer);\n77: \n78:         buffer.Flush();\n79:     }\n80: \n81:     /// <summary>\n82:     /// Writes the given JSON input as a JSON string with all unnecessary space removed.  If comments and/or blank\n83:     /// lines are allowed, they are written preserved.\n84:     /// </summary>\n85:     public string Minify(IEnumerable<char> jsonText)\n86:     {\n87:         var buffer = new StringBuilderBuffer(Options.OmitTrailingWhitespace);\n88:         var parser = new Parser() { Options = Options };\n89:         var docModel = parser.ParseTopLevel(jsonText, true);\n90:         MinifyTopLevel(docModel, buffer);\n91: \n92:         buffer.Flush();\n93:         return buffer.AsString();\n94:     }\n95: \n96:     /// <summary>\n97:     /// Writes the given JSON input to the writer as a JSON with all unnecessary space removed.  If comments and/or\n98:     /// blank lines are allowed, they are written preserved.\n99:     /// </summary>\n100:     public void Minify(IEnumerable<char> jsonText, TextWriter writer)\n101:     {\n102:         var buffer = new LineWriterBuffer(writer, Options.OmitTrailingWhitespace);\n103:         var parser = new Parser() { Options = Options };\n104:         var docModel = parser.ParseTopLevel(jsonText, true);\n105:         MinifyTopLevel(docModel, buffer);\n106: \n107:         buffer.Flush();\n108:     }\n109: \n110:     /// <summary>\n111:     /// Default method for determining the length of strings for alignment purposes.  This usually works fine for Latin\n112:     /// characters with a monospaced font, but it doesn't handle East Asian characters appropriately.\n113:     /// </summary>\n114:     public static int StringLengthByCharCount(string s)\n115:     {\n116:         return s.Length;\n117:     }\n118: \n119:     private IBuffer _buffer = new NullBuffer();\n120:     private PaddedFormattingTokens _pads = new (new FracturedJsonOptions(), StringLengthByCharCount);\n121: \n122:     private void FormatTopLevel(IEnumerable<JsonItem> docModel, int startingDepth, IBuffer buffer)\n123:     {\n124:         _buffer = buffer;\n125:         _pads = new PaddedFormattingTokens(Options, StringLengthFunc);\n126: \n127:         foreach(var item in docModel)\n128:         {\n129:             ComputeItemLengths(item);\n130:             FormatItem(item, startingDepth, false);\n131:         }\n132: \n133:         _buffer = new NullBuffer();\n134:     }\n135: \n136:     private void MinifyTopLevel(IEnumerable<JsonItem> docModel, IBuffer buffer)\n137:     {\n138:         _buffer = buffer;\n139:         _pads = new PaddedFormattingTokens(Options, StringLengthFunc);\n140: \n141:         var atStartOfNewLine = true;\n142:         foreach (var item in docModel)\n143:             atStartOfNewLine = MinifyItem(item, atStartOfNewLine);\n144: \n145:         _buffer = new NullBuffer();\n146:     }\n147: \n148:     /// <summary>\n149:     /// Runs StringLengthFunc on every part of every item and stores the value.  Also computes the total minimum\n150:     /// length, which for arrays and objects includes their child lengths.  We're going to use these values a lot,\n151:     /// and we don't want to run StringLengthFunc more than needed in case it's expensive.\n152:     /// </summary>\n153:     private void ComputeItemLengths(JsonItem item)\n154:     {\n155:         const char newline = '\\n';\n156:         foreach(var child in item.Children)\n157:             ComputeItemLengths(child);\n158: \n159:         item.NameLength = StringLengthFunc(item.Name);\n160:         item.ValueLength = StringLengthFunc(item.Value);\n161:         item.PrefixCommentLength = StringLengthFunc(item.PrefixComment);\n162:         item.MiddleCommentLength = StringLengthFunc(item.MiddleComment);\n163:         item.PostfixCommentLength = StringLengthFunc(item.PostfixComment);\n164:         item.RequiresMultipleLines =\n165:             (item.Type is JsonItemType.BlankLine or JsonItemType.BlockComment or JsonItemType.LineComment) \n166:             || item.Children.Any(ch => ch.RequiresMultipleLines || ch.IsPostCommentLineStyle)\n167:             || item.PrefixComment.Contains(newline)\n168:             || item.MiddleComment.Contains(newline) \n169:             || item.PostfixComment.Contains(newline) \n170:             || item.Value.Contains(newline);\n171: \n172:         if (item.Type is JsonItemType.Array or JsonItemType.Object)\n173:         {\n174:             var padType = GetPaddingType(item);\n175:             item.ValueLength = \n176:                 _pad