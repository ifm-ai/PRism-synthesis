            "output": "<path>/workspace/Tests/UniversalJsonTests.cs</path>\n<type>file</type>\n<content>\n1: using System.Text.Json;\n2: using FracturedJson;\n3: \n4: namespace Tests;\n5: \n6: /// <summary>\n7: /// <para>Tests that should pass with ANY input and ANY settings, within a few constraints.  These aren't particularly\n8: /// focused tests.  The idea is to throw a variety of inputs with a wide variety of settings and make sure\n9: /// nothing horribly unexpected happens.</para>\n10: ///\n11: /// <para>Constraints:</para>\n12: /// <list type=\"bullet\">\n13: ///     <item>The input is valid JSON</item>\n14: ///     <item>Input strings may not contain any of []{}:,\\n</item>\n15: ///     <item>Values given to PrefixString\" may only contain whitespace.</item>\n16: /// </list>\n17: ///\n18: /// <para>Those rules exist to make the output easy to test without understanding the grammar.  Other files might contain\n19: /// tests that don't impose these restrictions.</para>\n20: /// </summary>\n21: [TestClass]\n22: public class UniversalJsonTests\n23: {\n24:     /// <summary>\n25:     /// Generates combos of input JSON and Formatter options to feed to all of the tests.\n26:     /// </summary>\n27:     public static IEnumerable<object[]> GenerateUniversalParams()\n28:     {\n29:         var testFilesDir = new DirectoryInfo(\"StandardJsonFiles\");\n30:         foreach (var file in testFilesDir.EnumerateFiles(\"*.json\"))\n31:         {\n32:             var fileData = File.ReadAllText(file.FullName);\n33:             foreach (var options in GenerateOptions())\n34:                 yield return new object[] { fileData, options };\n35:         }\n36: \n37:         var commentTestFilesDir = new DirectoryInfo(\"FilesWithComments\");\n38:         foreach (var file in commentTestFilesDir.EnumerateFiles(\"*.jsonc\"))\n39:         {\n40:             var fileData = File.ReadAllText(file.FullName);\n41:             foreach (var options in GenerateOptions())\n42:             {\n43:                 var moddedOpts = options with\n44:                 {\n45:                     CommentPolicy = CommentPolicy.Preserve,\n46:                     PreserveBlankLines = true,\n47:                 };\n48:                 yield return new object[] { fileData, moddedOpts };\n49:             }\n50:         }\n51:     }\n52: \n53:     /// <summary>\n54:     /// Generates formatter options with a wide variety of property settings.  We can't test every permutation of\n55:     /// settings, but hopefully we can provide enough to make it hard for bugs to stay hidden.\n56:     /// </summary>\n57:     private static IEnumerable<FracturedJsonOptions> GenerateOptions()\n58:     {\n59:         yield return new();\n60:         yield return new() { MaxInlineComplexity = 10000 };\n61:         yield return new() { MaxInlineLength = int.MaxValue };\n62:         yield return new() { MaxInlineLength = 23 };\n63:         yield return new() { MaxInlineLength = 59 };\n64:         yield return new() { MaxTotalLineLength = 59 };\n65:         yield return new() { JsonEolStyle = EolStyle.Crlf };\n66:         yield return new() { JsonEolStyle = EolStyle.Lf };\n67:         yield return new() { JsonEolStyle = EolStyle.Default };\n68:         yield return new() { MaxInlineComplexity = 0, MaxCompactArrayComplexity = 0, MaxTableRowComplexity = 0 };\n69:         yield return new() { MaxInlineComplexity = 2, MaxCompactArrayComplexity = 0, MaxTableRowComplexity = 0 };\n70:         yield return new() { MaxInlineComplexity = 0, MaxCompactArrayComplexity = 2, MaxTableRowComplexity = 0 };\n71:         yield return new() { MaxInlineComplexity = 0, MaxCompactArrayComplexity = 0, MaxTableRowComplexity = 2 };\n72:         yield return new()\n73:         {\n74:             MaxInlineComplexity = 10,\n75:             MaxCompactArrayComplexity = 10,\n76:             MaxTableRowComplexity = 10,\n77:             MaxTotalLineLength = 1000,\n78:         };\n79:         yield return new()\n80:         {\n81:             NestedBracketPadding = false,\n82:             SimpleBracketPadding = true,\n83:             ColonPadding = false,\n84:             CommaPadding = false,\n85:             IndentSpaces = 3,\n86:             PrefixString = \"\\t\\t\"\n87:         };\n88:     }\n89: \n90:     private static string EolString(FracturedJsonOptions options)\n91:     {\n92:         return options.JsonEolStyle switch\n93:         {\n94:             EolStyle.Crlf => \"\\r\\n\",\n95:             EolStyle.Lf => \"\\n\",\n96:             EolStyle.Default => Environment.NewLine,\n97:             _ => Environment.NewLine\n98:         };\n99:     }\n100: \n101:     private static string SkipPrefixAndIndent(FracturedJsonOptions options, string line)\n102:     {\n103:         // Skip past the prefix string and whitespace.\n104:         if (!line.StartsWith(options.PrefixString))\n105:             throw new Exception(\"Output line does not begin with prefix string\");\n106:         var lineAfterPrefix = line.Substring(options.PrefixString.Length).TrimStart();\n107:         return lineAfterPrefix;\n108:     }\n109: \n110:     /// <summary>\n111:     /// Tests that the output is actually valid JSON.\n112:     /// </summary>\n113:     [DataTestMethod]\n114:     [DynamicData(nameof(GenerateUniversalParams), DynamicDataSourceType.Method)]\n115:     public void IsWellFormed(string inputText, FracturedJsonOptions options)\n116:     {\n117:         var formatter = new Formatter() { Options = options };\n118:         var outputText = formatter.Reformat(inputText, 0);\n119: \n120:         // Parse will throw an exception if its input (Formatter output) isn't well-formed.\n121:         var sysOpts = new JsonDocumentOptions();\n122:         if (options.CommentPolicy != CommentPolicy.TreatAsError)\n123:             sysOpts.CommentHandling = JsonCommentHandling.Skip;\n124:         var _ = JsonDocument.Parse(outputText, sysOpts);\n125:     }\n126: \n127: \n128:     /// <summary>\n129:     /// Any string that exists in the input should exist somewhere in the output.\n130:     /// </summary>\n131:     [DataTestMethod]\n132:     [DynamicData(nameof(GenerateUniversalParams), DynamicDataSourceType.Method)]\n133:     public void AllStringsExist(string inputText, FracturedJsonOptions options)\n134:     {\n135:         var formatter = new Formatter() { Options = options };\n136:         var outputText = formatter.Reformat(inputText, 0);\n137: \n138:         var startPos = 0;\n139:         while (true)\n140:         {\n141:             while (startPos < inputText.Length && inputText[startPos] != '\"')\n142:                 startPos += 1;\n143: \n144:             var endPos = startPos + 1;\n145:             while (endPos < inputText.Length && inputText[endPos] != '\"')\n146:                 endPos += 1;\n147: \n148:             if (endPos >= inputText.Length)\n149:                 return;\n150: \n151:             var stringFromSource = inputText.Substring(startPos+1, endPos - startPos - 2);\n152:             StringAssert.Contains(outputText, stringFromSource);\n153:             startPos = endPos + 1;\n154:         }\n155:     }\n156: \n157: \n158:     /// <summary>\n159:     /// Makes sure that the length restriction properties are respected.\n160:     /// </summary>\n161:     [DataTestMethod]\n162:     [DynamicData(nameof(GenerateUniversalParams), DynamicDataSourceType.Method)]\n163:     public void MaxLengthRespected(string inputText, FracturedJsonOptions options)\n164:     {\n165:         var formatter = new Formatter() { Options = options };\n166:         var outputText = formatter.Reformat(inputText, 0);\n167:         var outputLines = outputText.TrimEnd().Split(EolString(options));\n168: \n169:         foreach (var line in outputLines)\n170:         {\n171:             var content = SkipPrefixAndIndent(options, line);\n172: \n173:             // If the content is shorter than the max, it's all good.\n174:             if (content.Length <= options.MaxInlineLength && line.Length <= options.MaxTotalLineLength)\n175:                 continue;\n176: \n177:             // We'll consider it a single element if there's no more than one comma.\n178:             var commaCount = content.Count(ch => ch == ',');\n179:             Assert.IsTrue(commaCount <= 1);\n180:         }\n181:     }\n182: \n183:     [DataTestMethod]\n184:     [DynamicData(nameof(GenerateUniversalParams), DynamicDataSourceType.Method)]\n185:     public void MaxInlineComplexityRespected(string inputText, FracturedJsonOptions options)\n186:     {\n187:         var formatter = new Formatter() { Options = options };\n188:         var outputText = formatter.Reformat(inputText, 0);\n189:         var outputLines = outputText.TrimEnd().Split(EolString(options));\n190: \n191:         // Look at each line of the output separately, counting the nesting level in each.\n192:         foreach (var line in outputLines)\n193:         {\n194:             var content = SkipPrefixAndIndent(options, line);\n195: \n196:             // Keep a running total of opens vs closes.  Since Formatter treats empty arrays and objects as complexity\n197:             // zero just like primitives, we don't update nestLevel until we see something other than an empty.\n198:             var openCount = 0;\n199:             var nestLevel = 0;\n200:             var topLevelCommaSeen = false;\n201:             var multipleTopLevelItems = false;\n202:             foreach (var ch in content)\n203:             {\n204:                 switch (ch)\n205:                 {\n206:                     case ' ':\n207:                     case '\\t':\n208:                         break;\n209:                     case '[':\n210:                     case '{':\n211:                         multipleTopLevelItems |= (topLevelCommaSeen && openCount == 0);\n212:                         openCount += 1;\n213:                         break;\n214:                     case ']':\n215:                     case '}':\n216:                         openCount -= 1;\n217:                         nestLevel = Math.Max(nestLevel, openCount);\n218:                         break;\n219:                     default:\n220:                         multipleTopLevelItems |= (topLevelCommaSeen && openCount == 0);\n221:                         if (ch == ',')\n222:                             topLevelCommaSeen |= (openCount == 0);\n223:                         nestLevel = Math.Max(nestLevel, openCount);\n224:                         break;\n225:                 }\n226:             }\n227: \n228:             // If there were multiple top-level items on the line, this must be a compact array case.  Comments mess\n229:             // with the \"top level\" heuristic though.\n230:             if (multipleTopLevelItems && options.CommentPolicy != CommentPolicy.Preserve)\n231:             {\n232:                 Assert.IsTrue(nestLevel <= options.MaxCompactArrayComplexity);\n233:                 continue;\n234:             }\n235: \n236:             // Otherwise, we can't actually tell if it's a compact array, table, or inline by looking at just the one line.\n237:             Assert.IsTrue(nestLevel <= options.MaxInlineComplexity\n238:                           || nestLevel <= options.MaxCompactArrayComplexity\n239:                           || nestLevel <= options.MaxTableRowComplexity);\n240:         }\n241:     }\n242: \n243:     [DataTestMethod]\n244:     [DynamicData(nameof(GenerateUniversalParams), DynamicDataSourceType.Method)]\n245:     public void RepeatedFormattingIsStable(string inputText, FracturedJsonOptions options)\n246:     {\n247:         var mainFormatter = new Formatter() { Options = options };\n248:         var initialOutput = mainFormatter.Reformat(inputText, 0);\n249: \n250:         var crunchOutput = mainFormatter.Minify(initialOutput);\n251:         var backToStartOutput1 = mainFormatter.Reformat(crunchOutput, 0);\n252: \n253:         // We formatted it, then minified that, then reformatted that.  It should be the same.\n254:         Assert.AreEqual(initialOutput, backToStartOutput1);\n255: \n256:         var expandOptions = new FracturedJsonOptions()\n257:         {\n258:             AlwaysExpandDepth = int.MaxValue,\n259:             CommentPolicy = CommentPolicy.Preserve,\n260:             PreserveBlankLines = true,\n261:             DontJustifyNumbers = true,\n262:         };\n263:         var expandFormatter = new Formatter() { Options = expandOptions };\n264:         var expandOutput = expandFormatter.Reformat(crunchOutput, 0);\n265: \n266:         var backToStartOutput2 = mainFormatter.Reformat(expandOutput, 0);\n267: \n268:         // For good measure, we took the minified output and expanded it as much as possible, and then formatted that.\n269:         // Again, it should be the same as our original formatting.\n270:         Assert.AreEqual(initialOutput, backToStartOutput2);\n271:     }\n272: \n273:     [DataTestMethod]\n274:     [DynamicData(nameof(GenerateUniversalParams), DynamicDataSourceType.Method)]\n275:     public void NoTrailingWhitespace(string inputText, FracturedJsonOptions options)\n276:     {\n277:         var modifiedOptions = options with { OmitTrailingWhitespace = true };\n278: \n279:         var formatter = new Formatter() { Options = modifiedOptions };\n280:         var outputText = formatter.Reformat(inputText, 0);\n281:         var outputLines = outputText.TrimEnd().Split(EolString(options));\n282: \n283:         foreach (var line in outputLines)\n284:         {\n285:             var trimmedLine = line.TrimEnd();\n286:             Assert.AreEqual(trimmedLine, line);\n287:         }\n288:     }\n289: }\n\n(End of file - total 289 lines)\n</content>",
