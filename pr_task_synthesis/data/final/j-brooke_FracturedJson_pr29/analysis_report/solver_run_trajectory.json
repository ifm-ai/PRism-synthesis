            "output": "<path>/workspace/FracturedJson/Formatting/TableTemplate.cs</path>\n<type>file</type>\n<content>\n1: ﻿using System;\n2: using System.Collections.Generic;\n3: using System.Globalization;\n4: using System.Linq;\n5: using System.Text.RegularExpressions;\n6: \n7: namespace FracturedJson.Formatting;\n8: \n9: /// <summary>\n10: /// Collects spacing information about the columns of a potential table.  Each TableTemplate corresponds do\n11: /// a part of a row, and they're nested recursively to match the JSON structure.\n12: /// </summary>\n13: /// <remarks>\n14: /// <para> Say you have an object/array where each item would make a nice row all by itself.  We want to try to line up \n15: /// everything about it - comments, prop names, values.  If the row items are themselves objects/arrays, ideally\n16: /// we'd like to line up all of their children, too, recursively.  This only works as long as the structure/types\n17: /// are consistent.</para>\n18: /// </remarks>\n19: internal class TableTemplate\n20: {\n21:     /// <summary>\n22:     /// The property name in the table that this segment matches up with. \n23:     /// </summary>\n24:     public string? LocationInParent { get; private set; }\n25:     public JsonItemType Type { get; private set; } = JsonItemType.Null;\n26:     \n27:     /// <summary>\n28:     /// Assessment of whether this is a viable column.  The main qualifying factor is that all corresponding pieces\n29:     /// of each row are the same type.\n30:     /// </summary>\n31:     public bool IsRowDataCompatible { get; private set; } = true;\n32:     public int RowCount { get; private set; }\n33:     \n34:     public int NameLength { get; private set; }\n35:     public int SimpleValueLength { get; private set; }\n36:     public int PrefixCommentLength { get; private set; }\n37:     public int MiddleCommentLength { get; private set; }\n38:     public int PostfixCommentLength { get; private set; }\n39:     public BracketPaddingType PadType { get; private set; } = BracketPaddingType.Simple;\n40:     public bool IsFormattableNumber { get; private set; }\n41:     public int CompositeValueLength { get; private set; }\n42:     public int TotalLength { get; private set; }\n43:     \n44:     /// <summary>\n45:     /// If this TableTemplate corresponds to an object or array, Children contains sub-templates\n46:     /// for the array/object's children.\n47:     /// </summary>\n48:     public IList<TableTemplate> Children { get; set; } = new List<TableTemplate>();\n49: \n50:     public TableTemplate(PaddedFormattingTokens pads, bool allowReformattingNumbers)\n51:     {\n52:         _pads = pads;\n53:         _allowReformattingNumbers = allowReformattingNumbers;\n54:         IsFormattableNumber = allowReformattingNumbers;\n55:     }\n56: \n57:     /// <summary>\n58:     /// Analyzes an object/array for formatting as a potential table.  The tableRoot is a container that\n59:     /// is split out across many lines.  Each \"row\" is a single child written inline.\n60:     /// </summary>\n61:     public void MeasureTableRoot(JsonItem tableRoot)\n62:     {\n63:         // For each row of the potential table, measure it and its children, making room for everything.\n64:         // (Or, if there are incompatible types at any level, set CanBeUsedInTable to false.)\n65:         foreach(var child in tableRoot.Children)\n66:             MeasureRowSegment(child);\n67: \n68:         // Get rid of incomplete junk and figure out our size.\n69:         PruneAndRecompute(int.MaxValue);\n70: \n71:         // If there are fewer than 2 actual data rows (i.e., not standalone comments), no point making a table.\n72:         IsRowDataCompatible &= (RowCount >= 2);\n73:     }\n74: \n75:     /// <summary>\n76:     /// Check if the template's width fits in the given size.  Repeatedly drop inner formatting and\n77:     /// recompute to make it fit, if needed.\n78:     /// </summary>\n79:     public bool TryToFit(int maximumLength)\n80:     {\n81:         for (var complexity = GetTemplateComplexity(); complexity >= 0; --complexity)\n82:         {\n83:             if (TotalLength <= maximumLength)\n84:                 return true;\n85:             PruneAndRecompute(complexity-1);\n86:         }\n87: \n88:         return false;\n89:     }\n90: \n91:     public string FormatNumber(string originalValueString)\n92:     {\n93:         if (!IsFormattableNumber)\n94:             throw new FracturedJsonException(\"Logic error - attempting to format inappropriate thing as number\");\n95: \n96:         // Create a .NET format string, if we don't already have one.\n97:         if (_numberFormat == null)\n98:         {\n99:             var totalWidth = _maxDigitsBeforeDecimal + _maxDigitsAfterDecimal + ((_maxDigitsAfterDecimal > 0) ? 1 : 0);\n100: \n101:             // Leave room for the literal null if we saw one in the row data.\n102:             if (_dataContainsNull && totalWidth < 4)\n103:                 totalWidth = 4;\n104:             _numberFormat = $\"{{0,{totalWidth}:F{_maxDigitsAfterDecimal}}}\";\n105:         }\n106: \n107:         return string.Format(CultureInfo.InvariantCulture, _numberFormat, double.Parse(originalValueString));\n108:     }\n109: \n110:     private readonly PaddedFormattingTokens _pads;\n111:     private readonly bool _allowReformattingNumbers;\n112:     private int _maxDigitsBeforeDecimal = 0;\n113:     private int _maxDigitsAfterDecimal = 0;\n114:     private string? _numberFormat;\n115:     private bool _dataContainsNull = false;\n116: \n117:     // Regex to help us distinguish between numbers that truly have a zero value - which can take many forms like\n118:     // 0, 0.000, and 0.0e75 - and numbers too small for a 64bit float, such as 1e-500.\n119:     private static readonly Regex _trulyZeroValString = new Regex(\"^-?[0.]+([eE].*)?$\");\n120: \n121:     /// <summary>\n122:     /// Adjusts this TableTemplate (and its children) to make room for the given rowSegment (and its children).\n123:     /// </summary>\n124:     /// <param name=\"rowSegment\"></param>\n125:     private void MeasureRowSegment(JsonItem rowSegment)\n126:     {\n127:         // Standalone comments and blank lines don't figure into template measurements\n128:         if (rowSegment.Type is JsonItemType.BlankLine or JsonItemType.BlockComment or JsonItemType.LineComment)\n129:             return;\n130:         \n131:         // Make sure this rowSegment's type is compatible with the ones we've seen so far.  Null is compatible\n132:         // with all types.  It the types aren't compatible, we can still align this element and its comments,\n133:         // but not any children for arrays/objects.\n134:         if (rowSegment.Type is JsonItemType.False or JsonItemType.True)\n135:         {\n136:             IsRowDataCompatible &= (Type is JsonItemType.True or JsonItemType.Null);\n137:             Type = JsonItemType.True;\n138:             IsFormattableNumber = false;\n139:         }\n140:         else if (rowSegment.Type is JsonItemType.Number)\n141:         {\n142:             IsRowDataCompatible &= (Type is JsonItemType.Number or JsonItemType.Null);\n143:             Type = JsonItemType.Number;\n144:         }\n145:         else if (rowSegment.Type is JsonItemType.Null)\n146:         {\n147:             _dataContainsNull = true;\n148:         }\n149:         else\n150:         {\n151:             IsRowDataCompatible &= (Type == rowSegment.Type || Type == JsonItemType.Null);\n152:             if (Type is JsonItemType.Null)\n153:                 Type = rowSegment.Type;\n154:             IsFormattableNumber = false;\n155:         }\n156: \n157:         // If multiple lines are necessary for a row (probably due to pesky comments), we can't make a table.\n158:         IsRowDataCompatible &= !rowSegment.RequiresMultipleLines;\n159: \n160:         // Update the numbers.\n161:         RowCount += 1;\n162:         NameLength = Math.Max(NameLength, rowSegment.NameLength);\n163:         SimpleValueLength = Math.Max(SimpleValueLength, rowSegment.ValueLength);\n164:         MiddleCommentLength = Math.Max(MiddleCommentLength, rowSegment.MiddleCommentLength);\n165:         PrefixCommentLength = Math.Max(PrefixCommentLength, rowSegment.PrefixCommentLength);\n166:         PostfixCommentLength = Math.Max(PostfixCommentLength, rowSegment.PostfixCommentLength);\n167: \n168:         if (rowSegment.Complexity >= 2)\n169:             PadType = BracketPaddingType.Complex;\n170: \n171:         if (!IsRowDataCompatible)\n172:             return;\n173:         \n174:         if (rowSegment.Type == JsonItemType.Array)\n175:         {\n176:             // For each row in this rowSegment, find or create this TableTemplate's child template for\n177:             // the that array index, and then measure recursively.\n178:             for (var i = 0; i < rowSegment.Children.Count; ++i)\n179:             {\n180:                 if (Children.Count <= i)\n181:                     Children.Add(new(_pads, _allowReformattingNumbers));\n182:                 var subTemplate = Children[i];\n183:                 subTemplate.MeasureRowSegment(rowSegment.Children[i]);\n184:             }\n185:         }\n186:         else if (rowSegment.Type == JsonItemType.Object)\n187:         {\n188:             // If this object has multiple children with the same property name, which is allowed by the JSON standard\n189:             // although it's hard to imagine anyone would deliberately do it, we can't format it as part of a table.\n190:             var distinctChildKeyCount = rowSegment.Children.Select(item => item.Name)\n191:                 .Distinct()\n192:                 .Count();\n193:             if (distinctChildKeyCount != rowSegment.Children.Count)\n194:             {\n195:                 IsRowDataCompatible = false;\n196:                 return;\n197:             }\n198: \n199:             // For each property in rowSegment, check whether there's sub-template with the same name.  If not\n200:             // found, create one.  Then measure recursively.\n201:             foreach (var rowSegChild in rowSegment.Children)\n202:             {\n203:                 var subTemplate = Children.FirstOrDefault(tt => tt.LocationInParent == rowSegChild.Name);\n204:                 if (subTemplate == null)\n205:                 {\n206:                     subTemplate = new(_pads, _allowReformattingNumbers) { LocationInParent = rowSegChild.Name };\n207:                     Children.Add(subTemplate);\n208:                 }\n209:                 subTemplate.MeasureRowSegment(rowSegChild);\n210:             }\n211:         }\n212:         else if (rowSegment.Type == JsonItemType.Number && IsFormattableNumber)\n213:         {\n214:             // So far, everything in this column is a number that we can safely reformat.  Check to see if that's\n215:             // still true with this new rowSegment, and if so, measure how much space we need before and after\n216:             // the decimal point.\n217:             const int maxChars = 15;\n218:             var parsedVal = double.Parse(rowSegment.Value);\n219:             var normalizedStr = parsedVal.ToString(\"G\", CultureInfo.InvariantCulture);\n220: \n221:             // JSON allows numbers that won't fit in a 64-bit double.  For example, 1e500 becomes Infinity, and\n222:             // 1e-500 becomes 0.  In either of those cases, we shouldn't try to reformat the column.  Likewise,\n223:             // if there are too many digits or it needs to be expressed in scientific notation, we're better off\n224:             // not even trying.\n225:             IsFormattableNumber = !double.IsNaN(parsedVal)\n226:                                   && !double.IsInfinity(parsedVal)\n227:                                   && normalizedStr.Length <= maxChars\n228:                                   && !normalizedStr.Contains('E')\n229:                                   && (parsedVal!=0.0 || _trulyZeroValString.IsMatch(rowSegment.Value));\n230: \n231:             var indexOfDot = normalizedStr.IndexOf('.');\n232:             _maxDigitsBeforeDecimal =\n233:                 Math.Max(_maxDigitsBeforeDecimal, (indexOfDot >= 0) ? indexOfDot : normalizedStr.Length);\n234:             _maxDigitsAfterDecimal =\n235:                 Math.Max(_maxDigitsAfterDecimal, (indexOfDot >= 0) ? normalizedStr.Length - indexOfDot - 1 : 0);\n236:         }\n237:     }\n238: \n239:     /// <summary>\n240:     /// Get rid of any sub-templates we don't want - either because we found the row data wasn't compatible after all,\n241:     /// or because we need to reduce size.  Recompute CompositeValueLength and TotalLength, which may have changed\n242:     /// because of the pruning (or may not have been set yet at all).\n243:     /// </summary>\n244:     private void PruneAndRecompute(int maxAllowedComplexity)\n245:     {\n246:         if (maxAllowedComplexity<=0)\n247:             Children.Clear();\n248:         \n249:         foreach(var subTemplate in Children)\n250:             subTemplate.PruneAndRecompute(maxAllowedComplexity-1);\n251:         \n252:         if (!IsRowDataCompatible)\n253:             Children.Clear();\n254: \n255:         CompositeValueLength = SimpleValueLength;\n256:         if (Children.Count>0)\n257:         {\n258:             CompositeValueLength = Children.Sum(ch => ch.TotalLength)\n259:                                    + Math.Max(0, _pads.CommaLen * (Children.Count - 1))\n260:                                    + _pads.ArrStartLen(PadType)\n261:                                    + _pads.ArrEndLen(PadType);\n262:         }\n263:         else if (IsFormattableNumber)\n264:         {\n265:             CompositeValueLength = _maxDigitsBeforeDecimal\n266:                                    + _maxDigitsAfterDecimal\n267:                                    + ((_maxDigitsAfterDecimal > 0) ? 1 : 0);\n268: \n269:             // Allow room for null.\n270:             if (_dataContainsNull && CompositeValueLength < 4)\n271:                 CompositeValueLength = 4;\n272:         }\n273: \n274:         TotalLength = ((PrefixCommentLength > 0) ? PrefixCommentLength + _pads.CommentLen : 0)\n275:                     + ((NameLength > 0) ? NameLength + _pads.ColonLen : 0)\n276:                     + ((MiddleCommentLength > 0) ? MiddleCommentLength + _pads.CommentLen : 0)\n277:                     + CompositeValueLength\n278:                     + ((PostfixCommentLength > 0) ? PostfixCommentLength + _pads.CommentLen : 0);\n279:     }\n280: \n281:     private int GetTemplateComplexity()\n282:     {\n283:         if (Children.Count == 0)\n284:             return 0;\n285:         return 1 + Children.Max(ch => ch.GetTemplateComplexity());\n286:     }\n287: }\n\n(End of file - total 287 lines)\n</content>",
