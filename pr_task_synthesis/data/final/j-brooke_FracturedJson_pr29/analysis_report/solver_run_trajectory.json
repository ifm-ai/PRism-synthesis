estMethod]\n95:     public void BigNumbersInvalidateAlignment2()\n96:     {\n97:         const string input = \"[1, 2.1, 3, 1234567890123456]\";\n98:         const string expectedOutput = \"[\\n    1               , 2.1             , 3               , 1234567890123456\\n]\";\n99: \n100:         // If there's a number with too many significant digits, don't try to justify the numbers.\n101:         var opts = new FracturedJsonOptions()\n102:             { MaxInlineComplexity = -1, JsonEolStyle = EolStyle.Lf };\n103: \n104:         var formatter = new Formatter() { Options = opts };\n105:         var output = formatter.Reformat(input, 0);\n106: \n107:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n108:     }\n109: \n110:     [TestMethod]\n111:     public void NullsRespectedWhenAligningNumbers()\n112:     {\n113:         const string input = \"[1, 2, null, -99]\";\n114:         const string expectedOutput = \"[\\n       1,    2, null,  -99\\n]\";\n115: \n116:         // In general, if an array contains stuff other than numbers, we don't try to justify them.  Null is an\n117:         // exception though: an array of numbers and nulls should be justified as numbers.\n118:         var opts = new FracturedJsonOptions() { MaxInlineComplexity = -1, JsonEolStyle = EolStyle.Lf };\n119: \n120:         var formatter = new Formatter() { Options = opts };\n121:         var output = formatter.Reformat(input, 0);\n122: \n123:         Assert.AreEqual(expectedOutput, output.TrimEnd());\n124:     }\n125: \n126:     [TestMethod]\n127:     public void OverflowDoubleInvalidatesAlignment()\n128:     {\n129:         const string input = \"[1e500, 4.0]\";\n130:         const string expectedOutput = \"[\\n    1e500, 4.0  \\n]\";\n131: \n132:         // If a number is too big to fit in a 64-bit float, we shouldn't try to reformat its column/array.\n133:         // If we did, it would turn into \"Infinity\", isn't a valid JSON token.\n134:         var opts = new FracturedJsonOption