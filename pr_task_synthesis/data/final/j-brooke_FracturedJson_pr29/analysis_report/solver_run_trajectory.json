              "file": "FracturedJson/NumberListAlignment.cs",
              "patch": "Index: FracturedJson/NumberListAlignment.cs\n===================================================================\n--- FracturedJson/NumberListAlignment.cs\t\n+++ FracturedJson/NumberListAlignment.cs\t\n@@ -0,0 +1,29 @@\n+namespace FracturedJson;\n+\n+/// <summary>\n+/// Specifies how numeric values should be aligned when they appear in JSON arrays or table-like structures.\n+/// </summary>\n+public enum NumberListAlignment\n+{\n+    /// <summary>\n+    /// Numbers and null literals are left-justified within their column and padded with spaces on the right.\n+    /// </summary>\n+    Left,\n+\n+    /// <summary>\n+    /// Numbers and null literals are right-justified within their column and padded with spaces on the left.\n+    /// </summary>\n+    Right,\n+\n+    /// <summary>\n+    /// The decimal point (or exponent marker) of each numeric token is aligned vertically across rows.\n+    /// Spaces are inserted as needed to ensure decimal points line up.\n+    /// </summary>\n+    Decimal,\n+\n+    /// <summary>\n+    /// All numeric tokens are treated as having a uniform length, with a fixed number of decimal places when appropriate.\n+    /// Null entries are padded to the same width, guaranteeing that rows have identical character lengths.\n+    /// </summary>\n+    Normalize\n+}\n",
