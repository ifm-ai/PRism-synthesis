            "output": "<path>/workspace/Tests/TableFormattingTests.cs</path>\n<type>file</type>\n<content>\n1: ﻿using FracturedJson;\n2: \n3: namespace Tests;\n4: \n5: /// <summary>\n6: /// Tests about formatting things in tables, so that corresponding properties and array positions are neatly\n7: /// lined up, when possible.\n8: /// </summary>\n9: [TestClass]\n10: public class TableFormattingTests\n11: {\n12:     [TestMethod]\n13:     public void NestedElementsLineUp()\n14:     {\n15:         var inputLines = new[]\n16:         {\n17:             \"{\",\n18:             \"    'Rect' : { 'position': {'x': -44, 'y':  3.4}, 'color': [0, 255, 255] }, \",\n19:             \"    'Point': { 'position': {'y': 22, 'z': 3} }, \",\n20:             \"    'Oval' : { 'position': {'x': 140, 'y':  0.04}, 'color': '#7f3e96' }  \",\n21:             \"}\",\n22:         };\n23:         var input = string.Join(\"\\n\", inputLines).Replace('\\'', '\"');\n24: \n25:         // With default options (except EOL), this will be neatly formatted as a table.\n26:         var opts = new FracturedJsonOptions() { JsonEolStyle = EolStyle.Lf };\n27: \n28:         var formatter = new Formatter() { Options = opts };\n29:         var output = formatter.Reformat(input, 0);\n30:         var outputLines = output.TrimEnd().Split('\\n');\n31: \n32:         // Everything should line up.\n33:         TestHelpers.TestInstancesLineUp(outputLines, \"x\");\n34:         TestHelpers.TestInstancesLineUp(outputLines, \"y\");\n35:         TestHelpers.TestInstancesLineUp(outputLines, \"z\");\n36:         TestHelpers.TestInstancesLineUp(outputLines, \"position\");\n37:         TestHelpers.TestInstancesLineUp(outputLines, \"color\");\n38: \n39:         // The numbers of the y column will be justified.\n40:         StringAssert.Contains(outputLines[2], \"22.00,\");\n41:     }\n42: \n43: \n44:     [TestMethod]\n45:     public void NestedElementsCompactWhenNeeded()\n46:     {\n47:         var inputLines = new[]\n48:         {\n49:             \"{\",\n50:             \"    'Rect' : { 'position': {'x': -44, 'y':  3.4}, 'color': [0, 255, 255] }, \",\n51:             \"    'Point': { 'position': {'y': 22, 'z': 3} }, \",\n52:             \"    'Oval' : { 'position': {'x': 140, 'y':  0.04}, 'color': '#7f3e96' }  \",\n53:             \"}\",\n54:         };\n55:         var input = string.Join(\"\\n\", inputLines).Replace('\\'', '\"');\n56: \n57:         // Smaller rows, so there's not enough room to do a full table.\n58:         var opts = new FracturedJsonOptions() { MaxTotalLineLength = 77, JsonEolStyle = EolStyle.Lf };\n59: \n60:         var formatter = new Formatter() { Options = opts };\n61:         var output = formatter.Reformat(input, 0);\n62:         var outputLines = output.TrimEnd().Split('\\n');\n63: \n64:         // Since the available size is reduced, x,y,z will no longer line up, but position and color will.\n65:         TestHelpers.TestInstancesLineUp(outputLines, \"position\");\n66:         TestHelpers.TestInstancesLineUp(outputLines, \"color\");\n67: \n68:         // The numbers of the y column aren't justified, so the input value is used.\n69:         StringAssert.Contains(outputLines[2], \"22,\");\n70:     }\n71: \n72: \n73:     [TestMethod]\n74:     public void FallBackOnInlineIfNeeded()\n75:     {\n76:         var inputLines = new[]\n77:         {\n78:             \"{\",\n79:             \"    'Rect' : { 'position': {'x': -44, 'y':  3.4}, 'color': [0, 255, 255] }, \",\n80:             \"    'Point': { 'position': {'y': 22, 'z': 3} }, \",\n81:             \"    'Oval' : { 'position': {'x': 140, 'y':  0.04}, 'color': '#7f3e96' }  \",\n82:             \"}\",\n83:         };\n84:         var input = string.Join(\"\\n\", inputLines).Replace('\\'', '\"');\n85: \n86:         // In this case, it's too small to do any table formatting.  But each row should still be inlined.\n87:         var opts = new FracturedJsonOptions() { MaxTotalLineLength = 74, JsonEolStyle = EolStyle.Lf };\n88: \n89:         var formatter = new Formatter() { Options = opts };\n90:         var output = formatter.Reformat(input, 0);\n91:         var outputLines = output.TrimEnd().Split('\\n');\n92: \n93:         // All rows should be inlined, so a total of 5 rows.\n94:         Assert.AreEqual(5, outputLines.Length);\n95: \n96:         // Not even position lines up here.\n97:         Assert.AreNotEqual(outputLines[1].IndexOf(\"position\", StringComparison.Ordinal),\n98:             outputLines[2].IndexOf(\"position\", StringComparison.Ordinal));\n99:     }\n100: \n101: \n102:     [TestMethod]\n103:     public void TablesWithCommentsLineUp()\n104:     {\n105:         var inputLines = new[]\n106:         {\n107:             \"{\",\n108:             \"'Firetruck': /* red */ { 'color': '#CC0000' }, \",\n109:             \"'Dumptruck': /* yellow */ { 'color': [255, 255, 0] }, \",\n110:             \"'Godzilla': /* green */  { 'color': '#336633' },  // Not a truck\",\n111:             \"/* ! */ 'F150': { 'color': null } \",\n112:             \"}\"\n113:         };\n114:         var input = string.Join(\"\\n\", inputLines).Replace('\\'', '\"');\n115: \n116:         // Need to be wide enough and allow comments.\n117:         var opts = new FracturedJsonOptions() { MaxTotalLineLength = 100, CommentPolicy = CommentPolicy.Preserve,\n118:             JsonEolStyle = EolStyle.Lf };\n119: \n120:         var formatter = new Formatter() { Options = opts };\n121:         var output = formatter.Reformat(input, 0);\n122:         var outputLines = output.TrimEnd().Split('\\n');\n123: \n124:         // All rows should be inlined, so a total of 5 rows.\n125:         Assert.AreEqual(6, outputLines.Length);\n126: \n127:         // Lots of stuff to line up here.\n128:         TestHelpers.TestInstancesLineUp(outputLines, \"\\\"\");\n129:         TestHelpers.TestInstancesLineUp(outputLines, \":\");\n130:         TestHelpers.TestInstancesLineUp(outputLines, \" {\");\n131:         TestHelpers.TestInstancesLineUp(outputLines, \" }\");\n132:         TestHelpers.TestInstancesLineUp(outputLines, \"color\");\n133:     }\n134: \n135:     [TestMethod]\n136:     public void TablesWithBlankLinesLineUp()\n137:     {\n138:         var inputLines = new[]\n139:         {\n140:             \"{'a': [7,8],\",\n141:             \"\",\n142:             \"//1\",\n143:             \"'b': [9,10]}\",\n144:         };\n145:         var input = string.Join(\"\\n\", inputLines).Replace('\\'', '\"');\n146: \n147:         // Need to be wide enough and allow comments.\n148:         var opts = new FracturedJsonOptions() { CommentPolicy = CommentPolicy.Preserve,\n149:             PreserveBlankLines = true, JsonEolStyle = EolStyle.Lf };\n150: \n151:         var formatter = new Formatter() { Options = opts };\n152:         var output = formatter.Reformat(input, 0);\n153:         var outputLines = output.TrimEnd().Split('\\n');\n154: \n155:         // All rows should be inlined, so a total of 5 rows.\n156:         Assert.AreEqual(6, outputLines.Length);\n157: \n158:         // The presence of comments and blank lines shouldn't prevent table formatting.\n159:         TestHelpers.TestInstancesLineUp(outputLines, \":\");\n160:         TestHelpers.TestInstancesLineUp(outputLines, \"[\");\n161:         TestHelpers.TestInstancesLineUp(outputLines, \"]\");\n162:     }\n163: \n164:     [TestMethod]\n165:     public void RejectObjectsWithDuplicateKeys()\n166:     {\n167:         // Here we have an object with duplicate 'z' keys.  This is legal in JSON, even though it's hard to imagine\n168:         // any case where it would actually happen.  Still, we want to reproduce the data faithfully, so\n169:         // we mustn't try to format it as a table.\n170:         var inputLines = new[]\n171:         {\n172:             \"[ { 'x': 1, 'y': 2, 'z': 3 },\",\n173:             \"{ 'y': 44, 'z': 55, 'z': 66 } ]\",\n174:         };\n175:         var input = string.Join(\"\\n\", inputLines).Replace('\\'', '\"');\n176: \n177:         var opts = new FracturedJsonOptions() { JsonEolStyle = EolStyle.Lf, MaxInlineComplexity = 1 };\n178: \n179:         var formatter = new Formatter() { Options = opts };\n180:         var output = formatter.Reformat(input, 0);\n181:         var outputLines = output.TrimEnd().Split('\\n');\n182: \n183:         // The brackets and each object get their own rows.\n184:         Assert.AreEqual(4, outputLines.Length);\n185: \n186:         // We don't expect the y's to line up.\n187:         Assert.IsTrue(outputLines[1].IndexOf('y') != outputLines[2].IndexOf('y'));\n188: \n189:         // There should be 3 z's in the output, just like in the input.\n190:         var zCount = output.Count(ch => ch == 'z');\n191:         Assert.AreEqual(3, zCount);\n192:     }\n193: }\n\n(End of file - total 193 lines)\n</content>",
