            "output": "<path>/workspace/FracturedJson/FracturedJsonOptions.cs</path>\n<type>file</type>\n<content>\n1: ﻿namespace FracturedJson;\n2: \n3: /// <summary>\n4: /// Settings controlling the output of FracturedJson-formatted JSON documents.\n5: /// </summary>\n6: public record FracturedJsonOptions\n7: {\n8:     /// <summary>\n9:     /// Dictates which characters to use for line breaks.\n10:     /// </summary>\n11:     public EolStyle JsonEolStyle { get; set; } = EolStyle.Default;\n12: \n13:     /// <summary>\n14:     /// Maximum length that the formatter can use when combining complex elements into a single line.  This\n15:     /// includes comments, property names, etc. - everything except indentation and any PrefixString.  Note that\n16:     /// lines containing only a single element can exceed this: a long string, or an element with a long prefix\n17:     /// or postfix comment, for example.\n18:     /// <seealso cref=\"MaxTotalLineLength\"/>\n19:     /// </summary>\n20:     public int MaxInlineLength { get; set; } = int.MaxValue;\n21: \n22:     /// <summary>\n23:     /// Maximum length that the formatter can use when combining complex elements into a single line, from the start\n24:     /// of the line.  This is identical to <see cref=\"MaxInlineLength\"/> except that this one DOES count indentation\n25:     /// and any PrefixString.\n26:     /// <seealso cref=\"MaxInlineLength\"/>\n27:     /// </summary>\n28:     public int MaxTotalLineLength { get; set; } = 120;\n29: \n30:     /// <summary>\n31:     /// Maximum degree of nesting of arrays/objects that may be written on a single line.  0 disables inlining (but see\n32:     /// related settings).  1 allows inlining of arrays/objects that contain only simple items.  2 allows inlining of\n33:     /// arrays/objects that contain other arrays/objects as long as the child containers only contain simple items.  Etc.\n34:     /// <seealso cref=\"MaxCompactArrayComplexity\"/>\n35:     /// <seealso cref=\"MaxTableRowComplexity\"/>\n36:     /// </summary>\n37:     public int MaxInlineComplexity { get; set; } = 2;\n38: \n39:     /// <summary>\n40:     /// Maximum degree of nesting of arrays formatted as with multiple items per row across multiple rows.\n41:     /// <seealso cref=\"MaxInlineComplexity\"/>\n42:     /// <seealso cref=\"MaxTableRowComplexity\"/>\n43:     /// </summary>\n44:     public int MaxCompactArrayComplexity { get; set; } = 1;\n45: \n46:     /// <summary>\n47:     /// Maximum degree of nesting of arrays/objects formatted as table rows.\n48:     /// <seealso cref=\"MaxCompactArrayComplexity\"/>\n49:     /// <seealso cref=\"MaxInlineComplexity\"/>\n50:     /// </summary>\n51:     public int MaxTableRowComplexity { get; set; } = 2;\n52: \n53:     /// <summary>\n54:     /// Minimum number of items allowed per row to format an array as with multiple items per line across multiple\n55:     /// lines.  This is an approximation, not a hard rule.  The idea is that if there will be too few items per row,\n56:     /// you'd probably rather see it as a table.\n57:     /// </summary>\n58:     public int MinCompactArrayRowItems { get; set; } = 3;\n59: \n60:     /// <summary>\n61:     /// Depth at which lists/objects are always fully expanded, regardless of other settings.\n62:     /// -1 = none; 0 = root node only; 1 = root node and its children.\n63:     /// </summary>\n64:     public int AlwaysExpandDepth { get; set; } = -1;\n65: \n66:     /// <summary>\n67:     /// If an inlined array or object contains other arrays or objects, setting NestedBracketPadding to true\n68:     /// will include spaces inside the outer brackets.\n69:     /// <seealso cref=\"SimpleBracketPadding\"/>\n70:     /// </summary>\n71:     /// <remarks>\n72:     /// Example: <br/>\n73:     /// true: [ [1, 2, 3], [4] ] <br/>\n74:     /// false: [[1, 2, 3], [4]] <br/>\n75:     /// </remarks>\n76:     public bool NestedBracketPadding { get; set; } = true;\n77: \n78:     /// <summary>\n79:     /// If an inlined array or object does NOT contain other arrays/objects, setting SimpleBracketPadding to true\n80:     /// will include spaces inside the brackets.\n81:     /// <seealso cref=\"NestedBracketPadding\"/>\n82:     /// </summary>\n83:     public bool SimpleBracketPadding { get; set; } = false;\n84: \n85:     /// <summary>\n86:     /// If true, includes a space after property colons.\n87:     /// </summary>\n88:     public bool ColonPadding { get; set; } = true;\n89: \n90:     /// <summary>\n91:     /// If true, includes a space after commas separating array items and object properties.\n92:     /// </summary>\n93:     public bool CommaPadding { get; set; } = true;\n94: \n95:     /// <summary>\n96:     /// If true, spaces are included between prefix and postfix comments and their content.\n97:     /// </summary>\n98:     public bool CommentPadding { get; set; } = true;\n99: \n100:     /// <summary>\n101:     /// If true, there won't be any spaces or tabs at the end of lines.  Normally there are a variety of cases where\n102:     /// whitespace can be created or preserved at the ends of lines.  The most noticeable case is when\n103:     /// <see cref=\"CommaPadding\"/> is true.  Setting this to true gets rid of all of that (including inside multi-\n104:     /// line comments).\n105:     /// </summary>\n106:     public bool OmitTrailingWhitespace { get; set; } = false;\n107:     \n108:     /// <summary>\n109:     /// If true, numbers won't be right-aligned with matching precision.\n110:     /// </summary>\n111:     public bool DontJustifyNumbers { get; set; } = false;\n112: \n113:     /// <summary>\n114:     /// Number of spaces to use per indent level.  If <see cref=\"UseTabToIndent\"/> is true, spaces won't be used but\n115:     /// this number will still be used in length computations.\n116:     /// <seealso cref=\"UseTabToIndent\"/>\n117:     /// </summary>\n118:     public int IndentSpaces { get; set; } = 4;\n119: \n120:     /// <summary>\n121:     /// Uses a single tab per indent level, instead of spaces.\n122:     /// <seealso cref=\"IndentSpaces\"/>\n123:     /// </summary>\n124:     public bool UseTabToIndent { get; set; } = false;\n125:     \n126:     /// <summary>\n127:     /// String attached to the beginning of every line, before regular indentation.  If this string contains anything\n128:     /// other than whitespace, this will probably make the output invalid JSON, but it might be useful for output\n129:     /// to documentation, for instance.\n130:     /// </summary>\n131:     public string PrefixString { get; set; } = string.Empty;\n132: \n133:     /// <summary>\n134:     /// Determines how the parser and formatter should treat comments.  The JSON standard does not allow comments,\n135:     /// but it's a common unofficial extension.  (Such files are often given the extension \".jsonc\".)\n136:     /// </summary>\n137:     public CommentPolicy CommentPolicy { get; set; } = CommentPolicy.TreatAsError;\n138: \n139:     /// <summary>\n140:     /// If true, blank lines in the original input should be preserved in the output.\n141:     /// </summary>\n142:     public bool PreserveBlankLines { get; set; } = false;\n143: \n144:     /// <summary>\n145:     /// If true, arrays and objects that contain a comma after their last element are permitting.  The JSON standard\n146:     /// does not allow commas after the final element of an array or object, but some systems permit it, so\n147:     /// it's nice to have the option here.\n148:     /// </summary>\n149:     public bool AllowTrailingCommas { get; set; } = false;\n150: }\n\n(End of file - total 150 lines)\n</content>",
