estedBracketPadding) ? \" }\" : \"}\";\n40:         \n41:         Comma = (opts.CommaPadding) ? \", \" : \",\";\n42:         Colon = (opts.ColonPadding) ? \": \" : \":\";\n43:         Comment = (opts.CommentPadding) ? \" \" : string.Empty;\n44:         EOL = opts.JsonEolStyle switch\n45:         {\n46:             EolStyle.Crlf => \"\\r\\n\",\n47:             EolStyle.Lf => \"\\n\",\n48:             _ => Environment.NewLine,\n49:         };\n50: \n51:         _arrStartLen = _arrStart.Select(strLenFunc).ToArray();\n52:         _arrEndLen = _arrEnd.Select(strLenFunc).ToArray();\n53:         _objStartLen = _objStart.Select(strLenFunc).ToArray();\n54:         _objEndLen = _objEnd.Select(strLenFunc).ToArray();\n55: \n56:         // Create pre-made indent strings for levels 0 and 1 now.  We'll construct and cache others as needed.\n57:         _indentStrings = new()\n58:         {\n59:             string.Empty,\n60:             (opts.UseTabToIndent)? \"\\t\" : new string(' ', opts.IndentSpaces)\n61:         };\n62: \n63:         CommaLen = strLenFunc(Comma);\n64:         ColonLen = strLenFunc(Colon);\n65:         CommentLen = strLenFunc(Comment);\n66:         PrefixStringLen = strLenFunc(opts.PrefixString);\n67:     }\n68: \n69:     public string ArrStart(BracketPaddingType type)\n70:     {\n71:         return _arrStart[(int)type];\n72:     }\n73: \n74:     public string ArrEnd(BracketPaddingType type)\n75:     {\n76:         return _arrEnd[(int)type];\n77:     }\n78: \n79:     public string ObjStart(BracketPaddingType type)\n80:     {\n81:         return _objStart[(int)type];\n82:     }\n83: \n84:     public string ObjEnd(BracketPaddingType type)\n85:     {\n86:         return _objEnd[(int)type];\n87:     }\n88: \n89:     public string Start(JsonItemType elemType, BracketPaddingType bracketType)\n90:     {\n91:         return (elemType == JsonItemType.Array) ? ArrStart(bracketType) : ObjStart(bracketType);\n92:     }\n93:     \n94:     public string End(JsonItemType elem