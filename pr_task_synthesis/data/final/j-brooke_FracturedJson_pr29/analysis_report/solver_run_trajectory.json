\n408:     /// <summary>\n409:     /// Adds the representation for an array or object to the buffer, including all necessary indents, newlines, etc.,\n410:     /// broken out on separate lines.  This is the most general case that always works.\n411:     /// </summary>\n412:     private void FormatContainerExpanded(JsonItem item, int depth, bool includeTrailingComma)\n413:     {\n414:         var depthAfterColon = StandardFormatStart(item, depth);\n415:         _buffer.Add(_pads.Start(item.Type, BracketPaddingType.Empty)).EndLine(_pads.EOL);\n416: \n417:         // Take note of the position of the last actual element, for comma decisions.  The last element\n418:         // might not be the last item.\n419:         var lastElementIndex = IndexOfLastElement(item.Children);\n420:         for (var i=0; i<item.Children.Count; ++i)\n421:             FormatItem(item.Children[i], depthAfterColon+1, (i<lastElementIndex));\n422: \n423:         _buffer.Add(Options.PrefixString, _pads.Indent(depthAfterColon), _pads.End(item.Type, BracketPaddingType.Empty));\n424:         StandardFormatEnd(item, includeTrailingComma);\n425:     }\n426: \n427:     /// <summary>\n428:     /// Adds a (possibly multiline) standalone comment to the buffer, with indents and newlines on each line.\n429:     /// </summary>\n430:     private void FormatStandaloneComment(JsonItem item, int depth)\n431:     {\n432:         var commentRows = NormalizeMultilineComment(item.Value, item.InputPosition.Column);\n433: \n434:         foreach (var line in commentRows)\n435:             _buffer.Add(Options.PrefixString, _pads.Indent(depth), line).EndLine(_pads.EOL);\n436:     }\n437: \n438:     private void FormatBlankLine()\n439:     {\n440:         _buffer.Add(Options.PrefixString).EndLine(_pads.EOL);\n441:     }\n442: \n443:     /// <summary>\n444:     /// Adds an element to the buffer that can be written as a single line, including indents and newlines.\n445:     /// </summary>\n446:     private void FormatInline