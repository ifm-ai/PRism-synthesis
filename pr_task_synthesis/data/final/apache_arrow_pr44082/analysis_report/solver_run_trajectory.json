            "input": {
              "filePath": "/workspace/cpp/src/parquet/arrow/reader_writer_benchmark.cc",
              "oldString": "template <bool nullable, typename ParquetType>\nvoid SetBytesProcessed(::benchmark::State& state, int64_t num_values = BENCHMARK_SIZE) {\n  const int64_t items_processed = state.iterations() * num_values;\n  const int64_t bytes_processed = items_processed * sizeof(typename ParquetType::c_type);\n\n  state.SetItemsProcessed(bytes_processed);\n  state.SetBytesProcessed(bytes_processed);\n}",
              "newString": "template <bool nullable, typename ParquetType>\nvoid SetMetricsProcessed(::benchmark::State& state, int64_t num_values = BENCHMARK_SIZE) {\n  const int64_t items_processed = state.iterations() * num_values;\n  state.SetItemsProcessed(items_processed);\n  \n  int64_t bytes_processed;\n  if constexpr (std::is_same_v<ParquetType, BooleanType>) {\n    bytes_processed = ::arrow::bit_util::BytesForBits(items_processed);\n  } else if constexpr (std::is_same_v<ParquetType, Float16LogicalType>) {\n    bytes_processed = items_processed * 2;\n  } else {\n    bytes_processed = items_processed * sizeof(typename ParquetType::c_type);\n  }\n  state.SetBytesProcessed(bytes_processed);\n}"
