ibution<T> d(std::numeric_limits<T>::min(),\n46:                                      std::numeric_limits<T>::max());\n47:   for (uint32_t i = 0; i < size; ++i) {\n48:     data[i] = d(gen);\n49:   }\n50: }\n51: \n52: template <typename T>\n53: void GenerateBenchmarkDataFloatImpl(uint32_t size, uint32_t seed, T* data,\n54:                                     std::vector<uint8_t>* heap, uint32_t) {\n55:   static_assert(std::is_floating_point_v<T>);\n56:   heap->clear();\n57:   std::default_random_engine gen(seed);\n58:   std::uniform_real_distribution<T> d(std::numeric_limits<T>::lowest(),\n59:                                       std::numeric_limits<T>::max());\n60:   for (uint32_t i = 0; i < size; ++i) {\n61:     data[i] = d(gen);\n62:   }\n63: }\n64: \n65: }  // namespace\n66: \n67: template <>\n68: void GenerateBenchmarkData(uint32_t size, uint32_t seed, int32_t* data,\n69:                            std::vector<uint8_t>* heap, uint32_t data_string_length) {\n70:   GenerateBenchmarkDataIntegerImpl<int32_t>(size, seed, data, heap, data_string_length);\n71: }\n72: \n73: template <>\n74: void GenerateBenchmarkData(uint32_t size, uint32_t seed, int64_t* data,\n75:                            std::vector<uint8_t>* heap, uint32_t data_string_length) {\n76:   GenerateBenchmarkDataIntegerImpl<int64_t>(size, seed, data, heap, data_string_length);\n77: }\n78: \n79: template <>\n80: void GenerateBenchmarkData(uint32_t size, uint32_t seed, float* data,\n81:                            std::vector<uint8_t>* heap, uint32_t data_string_length) {\n82:   GenerateBenchmarkDataFloatImpl<float>(size, seed, data, heap, data_string_length);\n83: }\n84: \n85: template <>\n86: void GenerateBenchmarkData(uint32_t size, uint32_t seed, double* data,\n87:                            std::vector<uint8_t>* heap, uint32_t data_string_length) {\n88:   GenerateBenchmarkDataFloatImpl<double>(size, seed, data, heap, data_string_length);\n89: }\n90: \n91: template <>\n92: void GenerateBenchmarkData(uint32_t size, uint32_t seed, Int96* data,\n93:                            std::vector<uint8_t>* heap, uint32_t) {\n94:   heap->clear();\n95:   std::default_random_engine gen(seed);\n96:   std::uniform_int_distribution<int> d(std::numeric_limits<int>::min(),\n97:                                        std::numeric_limits<int>::max());\n98:   for (uint32_t i = 0; i < size; ++i) {\n99:     data[i].value[0] = d(gen);\n100:     data[i].value[1] = d(gen);\n101:     data[i].value[2] = d(gen);\n102:   }\n103: }\n104: \n105: template <>\n106: void GenerateBenchmarkData(uint32_t size, uint32_t seed, FLBA* data,\n107:                            std::vector<uint8_t>* heap, uint32_t data_string_length) {\n108:   heap->clear();\n109:   GenerateRandomString(data_string_length * size, seed, heap);\n110:   for (uint32_t i = 0; i < size; ++i) {\n111:     data[i].ptr = heap->data() + i * data_string_length;\n112:   }\n113: }\n114: \n115: template <>\n116: void GenerateBenchmarkData(uint32_t size, uint32_t seed, ByteArray* data,\n117:                            std::vector<uint8_t>* heap, uint32_t data_string_length) {\n118:   heap->clear();\n119:   GenerateRandomString(data_string_length * size, seed, heap);\n120:   for (uint32_t i = 0; i < size; ++i) {\n121:     data[i].ptr = heap->data() + i * data_string_length;\n122:     data[i].len = data_string_length;\n123:   }\n124: }\n125: \n126: }  // namespace parquet::benchmark\n\n(End of file - total 126 lines)\n</content>",
