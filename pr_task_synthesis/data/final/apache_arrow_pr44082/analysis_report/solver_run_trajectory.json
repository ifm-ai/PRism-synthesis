05: }\n106: \n107: template <bool nullable, typename ParquetType>\n108: void SetBytesProcessed(::benchmark::State& state, int64_t num_values = BENCHMARK_SIZE) {\n109:   const int64_t items_processed = state.iterations() * num_values;\n110:   const int64_t bytes_processed = items_processed * sizeof(typename ParquetType::c_type);\n111: \n112:   state.SetItemsProcessed(bytes_processed);\n113:   state.SetBytesProcessed(bytes_processed);\n114: }\n115: \n116: constexpr int64_t kAlternatingOrNa = -1;\n117: \n118: template <typename T>\n119: std::vector<T> RandomVector(int64_t true_percentage, int64_t vector_size,\n120:                             const std::array<T, 2>& sample_values, int seed = 500) {\n121:   std::vector<T> values(vector_size, {});\n122:   if (true_percentage == kAlternatingOrNa) {\n123:     int n = {0};\n124:     std::generate(values.begin(), values.end(), [&n] { return n++ % 2; });\n125:   } else {\n126:     std::default_random_engine rng(seed);\n127:     double true_probability = static_cast<double>(true_percentage) / 100.0;\n128:     std::bernoulli_distribution dist(true_probability);\n129:     std::generate(values.begin(), values.end(), [&] { return sample_values[dist(rng)]; });\n130:   }\n131:   return values;\n132: }\n133: \n134: template <typename ParquetType, typename ArrowType = ArrowType<ParquetType>>\n135: std::shared_ptr<::arrow::Table> TableFromVector(\n136:     const std::vector<typename ArrowType::c_type>& vec, bool nullable,\n137:     int64_t null_percentage = kAlternatingOrNa) {\n138:   if (!nullable) {\n139:     ARROW_CHECK_EQ(null_percentage, kAlternatingOrNa);\n140:   }\n141:   std::shared_ptr<::arrow::DataType> type = std::make_shared<ArrowType>();\n142:   NumericBuilder<ArrowType> builder;\n143:   if (nullable) {\n144:     // Note true values select index 1 of sample_values\n145:     auto valid_bytes = RandomVector<uint8_t>(/*true_percentage=*/null_percentage,\n146:                                              vec.size(), /*sample_values=*/{1, 0});\n147:     EXIT_NOT_OK(builder.AppendValues(vec.data(), vec.size(), valid_bytes.data()));\n148:   } else {\n149:     EXIT_NOT_OK(builder.AppendValues(vec.data(), vec.size(), nullptr));\n150:   }\n151:   std::shared_ptr<::arrow::Array> array;\n152:   EXIT_NOT_OK(builder.Finish(&array));\n153: \n154:   auto field = ::arrow::field(\"column\", type, nullable);\n155:   auto schema = ::arrow::schema({field});\n156:   return ::arrow::Table::Make(schema, {array});\n157: }\n158: \n159: template <>\n160: std::shared_ptr<::arrow::Table> TableFromVector<BooleanType>(const std::vector<bool>& vec,\n161:                                                              bool nullable,\n162:                                                              int64_t null_percentage) {\n163:   BooleanBuilder builder;\n164:   if (nullable) {\n165:     auto valid_bytes = RandomVector<bool>(/*true_percentage=*/null_percentage, vec.size(),\n166:                                           {true, false});\n167:     EXIT_NOT_OK(builder.AppendValues(vec, valid_bytes));\n168:   } else {\n169:     EXIT_NOT_OK(builder.AppendValues(vec));\n170:   }\n171:   std::shared_ptr<::arrow::Array> array;\n172:   EXIT_NOT_OK(builder.Finish(&array));\n173: \n174:   auto field = ::arrow::field(\"column\", ::arrow::boolean(), nullable);\n175:   auto schema = std::make_shared<::arrow::Schema>(\n176:       std::vector<std::shared_ptr<::arrow::Field>>({field}));\n177:   return ::arrow::Table::Make(schema, {array});\n178: }\n179: \n180: template <bool nullable, typename ParquetType>\n181: static void BM_WriteColumn(::benchmark::State& state) {\n182:   using T = typename ParquetType::c_type;\n183:   std::vector<T> values(BENCHMARK_SIZE, static_cast<T>(128));\n184:   std::shared_ptr<::arrow::Table> table = TableFromVector<ParquetType>(values, nullable);\n185: \n186:   while (state.KeepRunning()) {\n187:     auto output = CreateOutputStream();\n188:     EXIT_NOT_OK(\n189:         WriteTable(*table, ::arrow::default_memory_pool(), output, BENCHMARK_SIZE));\n190:   }\n191:   SetBytesProcessed<nullable, ParquetType>(state);\n192: }\n193: \n194: BENCHMARK_TEMPLATE2(BM_WriteColumn, false, Int32Type);\n195: BENCHMARK_TEMPLATE2(BM_WriteColumn, true, Int32Type);\n196: \n197: BENCHMARK_TEMPLATE2(BM_WriteColumn, false, Int64Type);\n198: BENCHMARK_TEMPLATE2(BM_WriteColumn, true, Int64Type);\n199: \n200: BENCHMARK_TEMPLATE2(BM_WriteColumn, false, DoubleType);\n201: BENCHMARK_TEMPLATE2(BM_WriteColumn, true, DoubleType);\n202: \n203: BENCHMARK_TEMPLATE2(BM_WriteColumn, false, BooleanType);\n204: BENCHMARK_TEMPLATE2(BM_WriteColumn, true, BooleanType);\n205: \n206: int32_t kInfiniteUniqueValues = -1;\n207: \n208: std::shared_ptr<::arrow::Table> RandomStringTable(int64_t length, int64_t unique_values,\n209:                                                   int64_t null_percentage) {\n210:   std::shared_ptr<::arrow::DataType> type = ::arrow::utf8();\n211:   std::shared_ptr<::arrow::Array> arr;\n212:   ::arrow::random::RandomArrayGenerator generator(/*seed=*/500);\n213:   double null_probability = static_cast<double>(null_percentage) / 100.0;\n214:   if (unique_values == kInfiniteUniqueValues) {\n215:     arr = generator.String(length, /*min_length=*/3, /*max_length=*/32,\n216:                            /*null_probability=*/null_probability);\n217:   } else {\n218:     arr = generator.StringWithRepeats(length, /*unique=*/unique_values,\n219:                                       /*min_length=*/3, /*max_length=*/32,\n220:                                       /*null_probability=*/null_probability);\n221:   }\n222:   return ::arrow::Table::Make(\n223:       ::arrow::schema({::arrow::field(\"column\", type, null_percentage > 0)}), {arr});\n224: }\n225: \n226: static void BM_WriteBinaryColumn(::benchmark::State& state) {\n227:   std::shared_ptr<::arrow::Table> table =\n228:       RandomStringTable(BENCHMARK_SIZE, state.range(1), state.range(0));\n229: \n230:   while (state.KeepRunning()) {\n231:     auto output = CreateOutputStream();\n232:     EXIT_NOT_OK(\n233:         WriteTable(*table, ::arrow::default_memory_pool(), output, BENCHMARK_SIZE));\n234:   }\n235: \n236:   // Offsets + data\n237:   int64_t total_bytes = table->column(0)->chunk(0)->data()->buffers[1]->size() +\n238:                         table->column(0)->chunk(0)->data()->buffers[2]->size();\n239:   state.SetItemsProcessed(BENCHMARK_SIZE * state.iterations());\n240:   state.SetBytesProcessed(total_bytes * state.iterations());\n241: }\n242: \n243: BENCHMARK(BM_WriteBinaryColumn)\n244:     ->ArgNames({\"null_probability\", \"unique_values\"})\n245:     // We vary unique values to trigger the dictionary-encoded (for low-cardinality)\n246:     // and plain (for high-cardinality) code paths.\n247:     ->Args({0, 32})\n248:     ->Args({0, kInfiniteUniqueValues})\n249:     ->Args({1, 32})\n250:     ->Args({50, 32})\n251:     ->Args({99, 32})\n252:     ->Args({1, kInfiniteUniqueValues})\n253:     ->Args({50, kInfiniteUniqueValues})\n254:     ->Args({99, kInfiniteUniqueValues});\n255: \n256: template <typename T>\n257: struct Examples {\n258:   static constexpr std::array<T, 2> values() { return {127, 128}; }\n259: };\n260: \n261: template <>\n262: struct Examples<bool> {\n263:   static constexpr std::array<bool, 2> values() { return {false, true}; }\n264: };\n265: \n266: static void BenchmarkReadTable(::benchmark::State& state, const ::arrow::Table& table,\n267:                                std::shared_ptr<WriterProperties> properties,\n268:                                int64_t num_values = -1, int64_t total_bytes = -1) {\n269:   auto output = CreateOutputStream();\n270:   EXIT_NOT_OK(WriteTable(table, ::arrow::default_memory_pool(), output,\n271:                          /*chunk_size=*/table.num_rows(), properties));\n272:   PARQUET_ASSIGN_OR_THROW(auto buffer, output->Finish());\n273: \n274:   for (auto _ : state) {\n275:     auto reader =\n276:         ParquetFileReader::Open(std::make_shared<::arrow::io::BufferReader>(buffer));\n277:     std::unique_ptr<FileReader> arrow_reader;\n278:     EXIT_NOT_OK(FileReader::Make(::arrow::default_memory_pool(), std::move(reader),\n279:                                  &arrow_reader));\n280: \n281:     std::shared_ptr<::arrow::Table> table;\n282:     EXIT_NOT_OK(arrow_reader->ReadTable(&table));\n283:   }\n284: \n285:   if (num_values == -1) {\n286:     num_values = table.num_rows();\n287:   }\n288:   state.SetItemsProcessed(num_values * state.iterations());\n289:   if (total_bytes != -1) {\n290:     state.SetBytesProcessed(total_bytes * state.iterations());\n291:   }\n292: }\n293: \n294: static void BenchmarkReadTable(::benchmark::State& state, const ::arrow::Table& table,\n295:                                int64_t num_values = -1, int64_t total_bytes = -1) {\n296:   BenchmarkReadTable(state, table, default_writer_properties(), num_values, total_bytes);\n297: }\n298: \n299: static void BenchmarkReadArray(::benchmark::State& state,\n300:                                const std::shared_ptr<Array>& array, bool nullable,\n301:                                std::shared_ptr<WriterProperties> properties,\n302:                                int64_t num_values = -1, int64_t total_bytes = -1) {\n303:   auto schema = ::arrow::schema({field(\"s\", array->type(), nullable)});\n304:   auto table = ::arrow::Table::Make(schema, {array}, array->length());\n305: \n306:   EXIT_NOT_OK(table->Validate());\n307: \n308:   BenchmarkReadTable(state, *table, num_values, total_bytes);\n309: }\n310: \n311: static void BenchmarkReadArray(::benchmark::State& state,\n312:                                const std::shared_ptr<Array>& array, bool nullable,\n313:                                int64_t num_values = -1, int64_t total_bytes = -1) {\n314:   BenchmarkReadArray(state, array, nullable, default_writer_properties(), num_values,\n315:                      total_bytes);\n316: }\n317: \n318: //\n319: // Benchmark reading a dict-encoded primitive column\n320: //\n321: \n322: template <bool nullable, typename ParquetType>\n323: static void BM_ReadColumn(::benchmark::State& state) {\n324:   using T = typename ParquetType::c_type;\n325: \n326:   auto values = RandomVector<T>(/*percentage=*/state.range(1), BENCHMARK_SIZE,\n327:                                 Examples<T>::values());\n328: \n329:   std::shared_ptr<::arrow::Table> table =\n330:       TableFromVector<ParquetType>(values, nullable, state.range(0));\n331: \n332:   auto properties = WriterProperties::Builder().disable_dictionary()->build();\n333: \n334:   BenchmarkReadTable(state, *table, properties, table->num_rows(),\n335:                      sizeof(typename ParquetType::c_type) * table->num_rows());\n336: }\n337: \n338: // There are two parameters here that cover different data distributions.\n339: // null_percentage governs distribution and therefore runs of null values.\n340: // first_value_percentage governs distribution of values (we select from 1 of 2)\n341: // so when 0 or 100 RLE is triggered all the time.  When a value in the range (0, 100)\n342: // there will be some percentage of RLE-encoded dictionary indices and some\n343: // percentage of literal encoded dictionary indices\n344: // (RLE is much less likely with percentages close to 50).\n345: BENCHMARK_TEMPLATE2(BM_ReadColumn, false, Int32Type)\n346:     ->Args({/*null_percentage=*/kAlternatingOrNa, 1})\n347:     ->Args({/*null_percentage=*/kAlternatingOrNa, 10})\n348:     ->Args({/*null_percentage=*/kAlternatingOrNa, 50});\n349: \n350: BENCHMARK_TEMPLATE2(BM_ReadColumn, true, Int32Type)\n351:     ->Args({/*null_percentage=*/kAlternatingOrNa, /*first_value_percentage=*/0})\n352:     ->Args({/*null_percentage=*/0, /*first_value_percentage=*/1})\n353:     ->Args({/*null_percentage=*/1, /*first_value_percentage=*/1})\n354:     ->Args({/*null_percentage=*/10, /*first_value_percentage=*/10})\n355:     ->Args({/*null_percentage=*/25, /*first_value_percentage=*/5})\n356:     ->Args({/*null_percentage=*/50, /*first_value_percentage=*/50})\n357:     ->Args({/*null_percentage=*/50, /*first_value_percentage=*/0})\n358:     ->Args({/*null_percentage=*/99, /*first_value_percentage=*/50})\n359:     ->Args({/*null_percentage=*/99, /*first_value_percentage=*/0});\n360: \n361: BENCHMARK_TEMPLATE2(BM_ReadColumn, false, Int64Type)\n362:     ->Args({/*null_percentage=*/kAlternatingOrNa, 1})\n363:     ->Args({/*null_percentage=*/kAlternatingOrNa, 10})\n364:     ->Args({/*null_percentage=*/kAlternatingOrNa, 50});\n365: BENCHMARK_TEMPLATE2(BM_ReadColumn, true, Int64Type)\n366:     ->Args({/*null_percentage=*/kAlternatingOrNa, /*first_value_percentage=*/0})\n367:     ->Args({/*null_percentage=*/1, /*first_value_percentage=*/1})\n368:     ->Args({/*null_percentage=*/5, /*first_value_percentage=*/5})\n369:     ->Args({/*null_percentage=*/10, /*first_value_percentage=*/5})\n370:     ->Args({/*null_percentage=*/25, /*first_value_percentage=*/10})\n371:     ->Args({/*null_percentage=*/30, /*first_value_percentage=*/10})\n372:     ->Args({/*null_percentage=*/35, /*first_value_percentage=*/10})\n373:     ->Args({/*null_percentage=*/45, /*first_value_percentage=*/25})\n374:     ->Args({/*null_percentage=*/50, /*first_value_percentage=*/50})\n375:     ->Args({/*null_percentage=*/50, /*first_value_percentage=*/1})\n376:     ->Args({/*null_percentage=*/75, /*first_value_percentage=*/1})\n377:     ->Args({/*null_percentage=*/99, /*first_value_percentage=*/50})\n378:     ->Args({/*null_percentage=*/99, /*first_value_percentage=*/0});\n379: \n380: BENCHMARK_TEMPLATE2(BM_ReadColumn, false, DoubleType)\n381:     ->Args({kAlternatingOrNa, 0})\n382:     ->Args({kAlternatingOrNa, 20});\n383: // Less coverage because int64_t should be pretty good representation for nullability and\n384: // repeating values.\n385: BENCHMARK_TEMPLATE2(BM_ReadColumn, true, DoubleType)\n386:     ->Args({/*null_percentage=*/kAlternatingOrNa, /*first_value_percentage=*/0})\n387:     ->Args({/*null_percentage=*/10, /*first_value_percentage=*/50})\n388:     ->Args({/*null_percentage=*/25, /*first_value_percentage=*/25});\n389: \n390: BENCHMARK_TEMPLATE2(BM_ReadColumn, false, BooleanType)\n391:     ->Args({kAlternatingOrNa, 0})\n392:     ->Args({1, 20});\n393: BENCHMARK_TEMPLATE2(BM_ReadColumn, true, BooleanType)\n394:     ->Args({kAlternatingOrNa, 1})\n395:     ->Args({5, 10});\n396: \n397: //\n398: // Benchmark reading a PLAIN-encoded primitive column\n399: //\n400: \n401: template <bool nullable, typename ParquetType>\n402: static void BM_ReadColumnPlain(::benchmark::State& state) {\n403:   using c_type = typename ArrowType<ParquetType>::c_type;\n404: \n405:   const std::vector<c_type> values(BENCHMARK_SIZE, static_cast<c_type>(42));\n406:   std::shared_ptr<::arrow::Table> table =\n407:       TableFromVector<ParquetType>(values, /*nullable=*/nullable, state.range(0));\n408: \n409:   auto properties = WriterProperties::Builder().disable_dictionary()->build();\n410:   BenchmarkReadTable(state, *table, properties, table->num_rows(),\n411:                      sizeof(c_type) * table->num_rows());\n412: }\n413: \n414: BENCHMARK_TEMPLATE2(BM_ReadColumnPlain, false, Int32Type)\n415:     ->ArgNames({\"null_probability\"})\n416:     ->Args({kAlternatingOrNa});\n417: BENCHMARK_TEMPLATE2(BM_ReadColumnPlain, true, Int32Type)\n418:     ->ArgNames({\"null_probability\"})\n419:     ->Args({0})\n420:     ->Args({1})\n421:     ->Args({50})\n422:     ->Args({99})\n423:     ->Args({100});\n424: \n425: BENCHMARK_TEMPLATE2(BM_ReadColumnPlain, false, Float16LogicalType)\n426:     ->ArgNames({\"null_probability\"})\n427:     ->Args({kAlternatingOrNa});\n428: BENCHMARK_TEMPLATE2(BM_ReadColumnPlain, true, Float16LogicalType)\n429:     ->ArgNames({\"null_probability\"})\n430:     ->Args({0})\n431:     ->Args({1})\n432:     ->Args({50})\n433:     ->Args({99})\n434:     ->Args({100});\n435: \n436: //\n437: // Benchmark reading binary column\n438: //\n439: \n440: static void BM_ReadBinaryColumn(::benchmark::State& state) {\n441:   std::shared_ptr<::arrow::Table> table =\n442:       RandomStringTable(BENCHMARK_SIZE, state.range(1), state.range(0));\n443: \n444:   // Offsets + data\n445:   int64_t total_bytes = table->column(0)->chunk(0)->data()->buffers[1]->size() +\n446:                         table->column(0)->chunk(0)->data()->buffers[2]->size();\n447:   BenchmarkReadTable(state, *table, table->num_rows(), total_bytes);\n448: }\n449: \n450: BENCHMARK(BM_ReadBinaryColumn)\n451:     ->ArgNames({\"null_probability\", \"unique_values\"})\n452:     // We vary unique values to trigger the dictionary-encoded (for low-cardinality)\n453:     // and plain (for high-cardinality) code paths.\n454:     ->Args({0, 32})\n455:     ->Args({0, kInfiniteUniqueValues})\n456:     ->Args({1, 32})\n457:     ->Args({50, 32})\n458:     ->Args({99, 32})\n459:     ->Args({1, kInfiniteUniqueValues})\n460:     ->Args({50, kInfiniteUniqueValues})\n461:     ->Args({99, kInfiniteUniqueValues});\n462: \n463: //\n464: // Benchmark reading a nested column\n465: //\n466: \n467: const std::vector<int64_t> kNestedNullPercents = {0, 1, 50, 99};\n468: \n469: // XXX We can use ArgsProduct() starting from Benchmark 1.5.2\n470: static void NestedReadArguments(::benchmark::internal::Benchmark* b) {\n471:   for (const auto null_percentage : kNestedNullPercents) {\n472:     b->Arg(null_percentage);\n473:   }\n474: }\n475: \n476: static std::shared_ptr<Array> MakeStructArray(::arrow::random::RandomArrayGenerator* rng,\n477:                                               const ArrayVector& children,\n478:                                               double null_probability,\n479:                                               bool propagate_validity = false) {\n480:   ARROW_CHECK_GT(children.size(), 0);\n481:   const int64_t length = children[0]->length();\n482: \n483:   std::shared_ptr<::arrow::Buffer> null_bitmap;\n484:   if (null_probability > 0.0) {\n485:     null_bitmap = rng->NullBitmap(length, null_probability);\n486:     if (propagate_validity) {\n487:       // HACK: the Parquet writer currently doesn't allow non-empty list\n488:       // entries where a parent node is null (for instance, a struct-of-list\n489:       // where the outer struct is marked null but the inner list value is\n490:       // non-empty).\n491:       for (const auto& child : children) {\n492:         null_bitmap = *::arrow::internal::BitmapOr(\n493:             ::arrow::default_memory_pool(), null_bitmap->data(), 0,\n494:             child->null_bitmap_data(), 0, length, 0);\n495:       }\n496:     }\n497:   }\n498:   FieldVector fields(children.size());\n499:   char field_name = 'a';\n500:   for (size_t i = 0; i < children.size(); ++i) {\n501:     fields[i] = field(std::string{field_name++}, children[i]->type(),\n502:                       /*nullable=*/null_probability > 0.0);\n503:   }\n504:   return *::arrow::StructArray::Make(children, std::move(fields), null_bitmap);\n505: }\n506: \n507: // Make a (int32, int64) struct array\n508: static std::shared_ptr<Array> MakeStructArray(::arrow::random::RandomArrayGenerator* rng,\n509:                                               int64_t size, double null_probability) {\n510:   auto values1 = rng->Int32(size, -5, 5, null_probability);\n511:   auto values2 = rng->Int64(size, -12345678912345LL, 12345678912345LL, null_probability);\n512:   return MakeStructArray(rng, {values1, values2}, null_probability);\n513: }\n514: \n515: static void BM_ReadStructColumn(::benchmark::State& state) {\n516:   constexpr int64_t kNumValues = BENCHMARK_SIZE / 10;\n517:   const double null_probability = static_cast<double>(state.range(0)) / 100.0;\n518:   const bool nullable = (null_probability != 0.0);\n519: \n520:   ARROW_CHECK_GE(null_probability, 0.0);\n521: \n522:   const int64_t kBytesPerValue = sizeof(int32_t) + sizeof(int64_t);\n523: \n524:   ::arrow::random::RandomArrayGenerator rng(42);\n525:   auto array = MakeStructArray(&rng, kNumValues, null_probability);\n526: \n527:   BenchmarkReadArray(state, array, nullable, kNumValues, kBytesPerValue * kNumValues);\n528: }\n529: \n530: BENCHMARK(BM_ReadStructColumn)->Apply(NestedReadArguments);\n531: \n532: static void BM_ReadStructOfStructColumn(::benchmark::State& state) {\n533:   constexpr int64_t kNumValues = BENCHMARK_SIZE / 10;\n534:   const double null_probability = static_cast<double>(state.range(0)) / 100.0;\n535:   const bool nullable = (null_probability != 0.0);\n536: \n537:   ARROW_CHECK_GE(null_probability, 0.0);\n538: \n539:   const int64_t kBytesPerValue = 2 * (sizeof(int32_t) + sizeof(int64_t));\n540: \n541:   ::arrow::random::RandomArrayGenerator rng(42);\n542:   auto values1 = MakeStructArray(&rng, kNumValues, null_probability);\n543:   auto values2 = MakeStructArray(&rng, kNumValues, null_probability);\n544:   auto array = MakeStructArray(&rng, {values1, values2}, null_probability);\n545: \n546:   BenchmarkReadArray(state, array, nullable, kNumValues, kBytesPerValue * kNumValues);\n547: }\n548: \n549: BENCHMARK(BM_ReadStructOfStructColumn)->Apply(NestedReadArguments);\n550: \n551: static void BM_ReadStructOfListColumn(::benchmark::State& state) {\n552:   constexpr int64_t kNumValues = BENCHMARK_SIZE / 10;\n553:   const double null_probability = static_cast<double>(state.range(0)) / 100.0;\n554:   const bool nullable = (null_probability != 0.0);\n555: \n556:   ARROW_CHECK_GE(null_probability, 0.0);\n557: \n558:   ::arrow::random::RandomArrayGenerator rng(42);\n559: \n560:   const int64_t kBytesPerValue = sizeof(int32_t) + sizeof(int64_t);\n561: \n562:   auto values1 = rng.Int32(kNumValues, -5, 5, null_probability);\n563:   auto values2 =\n564:       rng.Int64(kNumValues, -12345678912345LL, 12345678912345LL, null_probability);\n565:   auto list1 = rng.List(*values1, kNumValues / 10, null_probability);\n566:   auto list2 = rng.List(*values2, kNumValues / 10, null_probability);\n567:   auto array = MakeStructArray(&rng, {list1, list2}, null_probability,\n568:                                /*propagate_validity =*/true);\n569: \n570:   BenchmarkReadArray(state, array, nullable, kNumValues, kBytesPerValue * kNumValues);\n571: }\n572: \n573: BENCHMARK(BM_ReadStructOfListColumn)->Apply(NestedReadArguments);\n574: \n575: static void BM_ReadListColumn(::benchmark::State& state) {\n576:   constexpr int64_t kNumValues = BENCHMARK_SIZE / 10;\n577:   const double null_probability = static_cast<double>(state.range(0)) / 100.0;\n578:   const bool nullable = (null_probability != 0.0);\n579: \n580:   ARROW_CHECK_GE(null_probability, 0.0);\n581: \n582:   ::arrow::random::RandomArrayGenerator rng(42);\n583: \n584:   auto values = rng.Int64(kNumValues, /*min=*/-5, /*max=*/5, null_probability);\n585:   const int64_t kBytesPerValue = sizeof(int64_t);\n586: \n587:   auto array = rng.List(*values, kNumValues / 10, null_probability);\n588: \n589:   BenchmarkReadArray(state, array, nullable, kNumValues, kBytesPerValue * kNumValues);\n590: }\n591: \n592: BENCHMARK(BM_ReadListColumn)->Apply(NestedReadArguments);\n593: \n594: static void BM_ReadListOfStructColumn(::benchmark::State& state) {\n595:   constexpr int64_t kNumValues = BENCHMARK_SIZE / 10;\n596:   const double null_probability = static_cast<double>(state.range(0)) / 100.0;\n597:   const bool nullable = (null_probability != 0.0);\n598: \n599:   ARROW_CHECK_GE(null_probability, 0.0);\n600: \n601:   ::arrow::random::RandomArrayGenerator rng(42);\n602: \n603:   auto values = MakeStructArray(&rng, kNumValues, null_probability);\n604:   const int64_t kBytesPerValue = sizeof(int32_t) + sizeof(int64_t);\n605: \n606:   auto array = rng.List(*values, kNumValues / 10, null_probability);\n607: \n608:   BenchmarkReadArray(state, array, nullable, kNumValues, kBytesPerValue * kNumValues);\n609: }\n610: \n611: BENCHMARK(BM_ReadListOfStructColumn)->Apply(NestedReadArguments);\n612: \n613: static void BM_ReadListOfListColumn(::benchmark::State& state) {\n614:   constexpr int64_t kNumValues = BENCHMARK_SIZE / 10;\n615:   const double null_probability = static_cast<double>(state.range(0)) / 100.0;\n616:   const bool nullable = (null_probability != 0.0);\n617: \n618:   ARROW_CHECK_GE(null_probability, 0.0);\n619: \n620:   ::arrow::random::RandomArrayGenerator rng(42);\n621: \n622:   auto values = rng.Int64(kNumValues, /*min=*/-5, /*max=*/5, null_probability);\n623:   const int64_t kBytesPerValue = sizeof(int64_t);\n624: \n625:   auto inner = rng.List(*values, kNumValues / 10, null_probability);\n626:   auto array = rng.List(*inner, kNumValues / 100, null_probability);\n627: \n628:   BenchmarkReadArray(state, array, nullable, kNumValues, kBytesPerValue * kNumValues);\n629: }\n630: \n631: BENCHMARK(BM_ReadListOfListColumn)->Apply(NestedReadArguments);\n632: \n633: //\n634: // Benchmark different ways of reading select row groups\n635: //\n636: \n637: static void BM_ReadIndividualRowGroups(::benchmark::State& state) {\n638:   std::vector<int64_t> values(BENCHMARK_SIZE, 128);\n639:   std::shared_ptr<::arrow::Table> table = TableFromVector<Int64Type>(values, true);\n640:   auto output = CreateOutputStream();\n641:   // This writes 10 RowGroups\n642:   EXIT_NOT_OK(\n643:       WriteTable(*table, ::arrow::default_memory_pool(), output, BENCHMARK_SIZE / 10));\n644: \n645:   PARQUET_ASSIGN_OR_THROW(auto buffer, output->Finish());\n646: \n647:   while (state.KeepRunning()) {\n648:     auto reader =\n649:         ParquetFileReader::Open(std::make_shared<::arrow::io::BufferReader>(buffer));\n650:     std::unique_ptr<FileReader> arrow_reader;\n651:     EXIT_NOT_OK(FileReader::Make(::arrow::default_memory_pool(), std::move(reader),\n652:                                  &arrow_reader));\n653: \n654:     std::vector<std::shared_ptr<::arrow::Table>> tables;\n655:     for (int i = 0; i < arrow_reader->num_row_groups(); i++) {\n656:       // Only read the even numbered RowGroups\n657:       if ((i % 2) == 0) {\n658:         std::shared_ptr<::arrow::Table> table;\n659:      