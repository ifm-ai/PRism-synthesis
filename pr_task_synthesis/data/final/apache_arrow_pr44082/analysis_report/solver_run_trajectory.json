NCHMARK_SIZE << \"\\n\";\n  std::cout << \"  Bytes: \" << CalculateBytesProcessed<Int64Type>(BENCHMARK_SIZE) << \"\\n\";\n  std::cout << \"  Expected: \" << (BENCHMARK_SIZE * 8) << \" bytes (8 bytes per item)\\n\\n\";\n  \n  std::cout << \"DoubleType:\\n\";\n  std::cout << \"  Items: \" << BENCHMARK_SIZE << \"\\n\";\n  std::cout << \"  Bytes: \" << CalculateBytesProcessed<DoubleType>(BENCHMARK_SIZE) << \"\\n\";\n  std::cout << \"  Expected: \" << (BENCHMARK_SIZE * 8) << \" bytes (8 bytes per item)\\n\\n\";\n  \n  std::cout << \"Float16LogicalType:\\n\";\n  std::cout << \"  Items: \" << BENCHMARK_SIZE << \"\\n\";\n  std::cout << \"  Bytes: \" << CalculateBytesProcessed<Float16LogicalType>(BENCHMARK_SIZE) << \"\\n\";\n  std::cout << \"  Expected: \" << (BENCHMARK_SIZE * 2) << \" bytes (2 bytes per item)\\n\\n\";\n  \n  // Verify calculations\n  bool all_correct = true;\n  \n  if (CalculateBytesProcessed<BooleanType>(BENCHMARK_SIZE) != arrow::bit_util::BytesForBits(BENCHMARK_SIZE)) {\n    std::cerr << \"ERROR: Boolean calculation incorrect!\\n\";\n    all_correct = false;\n  }\n  \n  if (CalculateBytesProcessed<Int32Type>(BENCHMARK_SIZE) != BENCHMARK_SIZE * 4) {\n    std::cerr << \"ERROR: Int32 calculation incorrect!\\n\";\n    all_correct = false;\n  }\n  \n  if (CalculateBytesProcessed<Int64Type>(BENCHMARK_SIZE) != BENCHMARK_SIZE * 8) {\n    std::cerr << \"ERROR: Int64 calculation incorrect!\\n\";\n    all_correct = false;\n  }\n  \n  if (CalculateBytesProcessed<DoubleType>(BENCHMARK_SIZE) != BENCHMARK_SIZE * 8) {\n    std::cerr << \"ERROR: Double calculation incorrect!\\n\";\n    all_correct = false;\n  }\n  \n  if (CalculateBytesProcessed<Float16LogicalType>(BENCHMARK_SIZE) != BENCHMARK_SIZE * 2) {\n    std::cerr << \"ERROR: Float16 calculation incorrect!\\n\";\n    all_correct = false;\n  }\n  \n  if (all_correct) {\n    std::cout << \"All calculations are CORRECT!\\n\";\n    return 0;\n  } else {\n    std::cerr << \"Some calculations are INCORRECT!\\n\";\n    return 1;\n  }\n}\n"
