              "content": "#include <iostream>\n#include <cstdint>\n\nnamespace arrow {\nnamespace bit_util {\nconstexpr int64_t BytesForBits(int64_t bits) {\n  return (bits >> 3) + ((bits & 7) != 0);\n}\n}\n}\n\nstruct BooleanType {\n  using c_type = bool;\n};\n\nstruct Int32Type {\n  using c_type = int32_t;\n};\n\nstruct Int64Type {\n  using c_type = int64_t;\n};\n\nstruct DoubleType {\n  using c_type = double;\n};\n\nstruct Float16LogicalType {\n  using c_type = uint16_t;\n};\n\ntemplate <bool nullable, typename ParquetType>\nvoid SetMetricsProcessed(int64_t iterations, int64_t num_values, \n                         int64_t& items_out, int64_t& bytes_out) {\n  const int64_t items_processed = iterations * num_values;\n  items_out = items_processed;\n  \n  int64_t bytes_processed;\n  if constexpr (std::is_same_v<ParquetType, BooleanType>) {\n    bytes_processed = arrow::bit_util::BytesForBits(items_processed);\n  } else if constexpr (std::is_same_v<ParquetType, Float16LogicalType>) {\n    bytes_processed = items_processed * 2;\n  } else {\n    bytes_processed = items_processed * sizeof(typename ParquetType::c_type);\n  }\n  bytes_out = bytes_processed;\n}\n\nint main() {\n  const int64_t BENCHMARK_SIZE = 10 * 1024 * 1024;\n  const int64_t iterations = 5;\n  \n  std::cout << \"Testing SetMetricsProcessed for \" << iterations << \" iterations:\\n\\n\";\n  \n  int64_t items, bytes;\n  \n  SetMetricsProcessed<false, BooleanType>(iterations, BENCHMARK_SIZE, items, bytes);\n  std::cout << \"BooleanType:\\n\";\n  std::cout << \"  Items processed: \" << items << \"\\n\";\n  std::cout << \"  Bytes processed: \" << bytes << \"\\n\";\n  std::cout << \"  Items != Bytes: \" << (items != bytes ? \"PASS\" : \"FAIL\") << \"\\n\\n\";\n  \n  SetMetricsProcessed<false, Int32Type>(iterations, BENCHMARK_SIZE, items, bytes);\n  std::cout << \"Int32Type:\\n\";\n  std::cout << \"  Items processed: \" << items << \"\\n\";\n  std::cout << \"  Bytes processed: \" << bytes << \"\\n\";\n  std::cout << \"  Items != Bytes: \" << (items != bytes ? \"PASS\" : \"FAIL\") << \"\\n\";\n  std::cout << \"  Bytes == Items * 4: \" << (bytes == items * 4 ? \"PASS\" : \"FAIL\") << \"\\n\\n\";\n  \n  SetMetricsProcessed<false, Int64Type>(iterations, BENCHMARK_SIZE, items, bytes);\n  std::cout << \"Int64Type:\\n\";\n  std::cout << \"  Items processed: \" << items << \"\\n\";\n  std::cout << \"  Bytes processed: \" << bytes << \"\\n\";\n  std::cout << \"  Items != Bytes: \" << (items != bytes ? \"PASS\" : \"FAIL\") << \"\\n\";\n  std::cout << \"  Bytes == Items * 8: \" << (bytes == items * 8 ? \"PASS\" : \"FAIL\") << \"\\n\\n\";\n  \n  SetMetricsProcessed<false, DoubleType>(iterations, BENCHMARK_SIZE, items, bytes);\n  std::cout << \"DoubleType:\\n\";\n  std::cout << \"  Items processed: \" << items << \"\\n\";\n  std::cout << \"  Bytes processed: \" << bytes << \"\\n\";\n  std::cout << \"  Items != Bytes: \" << (items != bytes ? \"PASS\" : \"FAIL\") << \"\\n\";\n  std::cout << \"  Bytes == Items * 8: \" << (bytes == items * 8 ? \"PASS\" : \"FAIL\") << \"\\n\\n\";\n  \n  SetMetricsProcessed<false, Float16LogicalType>(iterations, BENCHMARK_SIZE, items, bytes);\n  std::cout << \"Float16LogicalType:\\n\";\n  std::cout << \"  Items processed: \" << items << \"\\n\";\n  std::cout << \"  Bytes processed: \" << bytes << \"\\n\";\n  std::cout << \"  Items != Bytes: \" << (items != bytes ? \"PASS\" : \"FAIL\") << \"\\n\";\n  std::cout << \"  Bytes == Items * 2: \" << (bytes == items * 2 ? \"PASS\" : \"FAIL\") << \"\\n\\n\";\n  \n  std::cout << \"Key verification: Boolean bytes should be ~1/8 of item count\\n\";\n  SetMetricsProcessed<false, BooleanType>(1, BENCHMARK_SIZE, items, bytes);\n  std::cout << \"  Boolean ratio (bytes/items): \" << (double)bytes / items << \" (should be ~0.125)\\n\";\n  \n  return 0;\n}\n",
