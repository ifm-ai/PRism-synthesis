            "output": "<path>/workspace/terraform/modernisation-platform-account/iam.tf</path>\n<type>file</type>\n<content>\n1: #tfsec:ignore:aws-iam-no-policy-wildcards\n2: #tfsec:ignore:aws-iam-enforce-mfa\n3: module \"iam\" {\n4:   source        = \"github.com/ministryofjustice/modernisation-platform-terraform-iam-superadmins?ref=180803bb2f1f9e08bb2653b40e52744126472dce\" # v2.0.2\n5:   account_alias = \"moj-modernisation-platform\"\n6: }\n7: \n8: ### Collaborators\n9: \n10: # Attach created users to a AWS IAM group, with several policies\n11: #tfsec:ignore:aws-iam-no-policy-wildcards\n12: #tfsec:ignore:aws-iam-enforce-mfa\n13: module \"collaborators_group\" {\n14:   #checkov:skip=CKV_TF_1:Module registry does not support commit hashes for versions\n15:   source  = \"terraform-aws-modules/iam/aws//modules/iam-group-with-policies\"\n16:   version = \"~> 5.0\"\n17:   name    = \"collaborators\"\n18: \n19:   group_users = [for user in module.collaborators : user.username]\n20: \n21:   custom_group_policy_arns = [\n22:     data.aws_iam_policy.ForceMFA.arn,\n23:     aws_iam_policy.collaborator_local_plan.arn\n24:   ]\n25: }\n26: \n27: data \"aws_iam_policy\" \"ForceMFA\" {\n28:   name = \"ForceMFA\"\n29: }\n30: \n31: resource \"aws_iam_policy\" \"collaborator_local_plan\" {\n32:   name        = \"collaborator-local-plan\"\n33:   description = \"Permissions collaborators need to perform local Terraform plans\"\n34:   policy      = data.aws_iam_policy_document.collaborator_local_plan.json\n35: }\n36: \n37: data \"aws_iam_policy_document\" \"collaborator_local_plan\" {\n38:   statement {\n39:     sid    = \"AssumeRole\"\n40:     effect = \"Allow\"\n41:     actions = [\n42:       \"sts:AssumeRole\"\n43:     ]\n44:     resources = [\n45:       \"arn:aws:iam::${local.environment_management.account_ids[\"core-network-services-production\"]}:role/read-log-records\",\n46:       \"arn:aws:iam::${local.environment_management.account_ids[\"core-vpc-development\"]}:role/member-delegation-read-only\",\n47:       \"arn:aws:iam::${local.environment_management.account_ids[\"core-vpc-test\"]}:role/member-delegation-read-only\",\n48:       \"arn:aws:iam::${local.environment_management.account_ids[\"core-vpc-preproduction\"]}:role/member-delegation-read-only\",\n49:       \"arn:aws:iam::${local.environment_management.account_ids[\"core-vpc-production\"]}:role/member-delegation-read-only\",\n50:       \"arn:aws:iam::${local.environment_management.account_ids[\"core-vpc-sandbox\"]}:role/member-delegation-read-only\",\n51:       \"arn:aws:iam::${data.aws_caller_identity.current.id}:role/modernisation-account-limited-read-member-access\"\n52:     ]\n53:     condition {\n54:       test     = \"BoolIfExists\"\n55:       variable = \"aws:MultiFactorAuthPresent\"\n56:       values   = [\"true\"]\n57:     }\n58:   }\n59: \n60:   statement {\n61:     sid = \"TerraformStateAccess\"\n62:     actions = [\n63:       \"s3:ListBucket\",\n64:       \"s3:GetObject\"\n65:     ]\n66: \n67:     resources = [\n68:       \"arn:aws:s3:::modernisation-platform-terraform-state/terraform.tfstate\",\n69:       \"arn:aws:s3:::modernisation-platform-terraform-state/environments/members/*\",\n70:       \"arn:aws:s3:::modernisation-platform-terraform-state/environments/accounts/core-network-services/*\",\n71:       \"arn:aws:s3:::modernisation-platform-terraform-state\"\n72:     ]\n73:     condition {\n74:       test     = \"BoolIfExists\"\n75:       variable = \"aws:MultiFactorAuthPresent\"\n76:       values   = [\"true\"]\n77:     }\n78:   }\n79: \n80:   statement {\n81:     sid    = \"ssmAccess\"\n82:     effect = \"Allow\"\n83:     actions = [\n84:       \"ssm:GetParameter\"\n85:     ]\n86:     resources = [\n87:       \"arn:aws:ssm:eu-west-2:${data.aws_caller_identity.current.id}:parameter/modernisation_platform_account_id\"\n88:     ]\n89:     condition {\n90:       test     = \"BoolIfExists\"\n91:       variable = \"aws:MultiFactorAuthPresent\"\n92:       values   = [\"true\"]\n93:     }\n94:   }\n95: }\n96: \n97: #tfsec:ignore:aws-iam-no-user-attached-policies\n98: module \"collaborators\" {\n99:   source                 = \"../modules/collaborators\"\n100:   for_each               = { for user in local.collaborators.users : user.username => user.accounts }\n101:   username               = each.key\n102:   accounts               = each.value\n103:   environment_management = local.environment_management\n104: }\n105: \n106: # Modernisation Platform Account Readonly Role\n107: data \"aws_iam_policy_document\" \"modernisation_account_limited_read_assume_role\" {\n108:   version = \"2012-10-17\"\n109: \n110:   statement {\n111:     effect  = \"Allow\"\n112:     actions = [\"sts:AssumeRole\"]\n113: \n114:     principals {\n115:       type        = \"AWS\"\n116:       identifiers = [\"*\"]\n117:     }\n118: \n119:     condition {\n120:       test     = \"ForAnyValue:StringLike\"\n121:       variable = \"aws:PrincipalOrgPaths\"\n122:       values   = [\"${data.aws_organizations_organization.root_account.id}/*/${local.modernisation_platform_ou_id}/*\"]\n123:     }\n124:   }\n125: }\n126: \n127: resource \"aws_iam_role\" \"modernisation_account_limited_read\" {\n128:   name                 = \"modernisation-account-limited-read-member-access\"\n129:   max_session_duration = 3600\n130:   assume_role_policy   = data.aws_iam_policy_document.modernisation_account_limited_read_assume_role.json\n131: \n132:   tags = local.tags\n133: }\n134: \n135: data \"aws_iam_policy_document\" \"modernisation_account_limited_read\" {\n136:   statement {\n137:     effect = \"Allow\"\n138:     actions = [\n139:       \"secretsmanager:GetResourcePolicy\",\n140:       \"secretsmanager:GetSecretValue\",\n141:       \"secretsmanager:DescribeSecret\",\n142:       \"secretsmanager:ListSecretVersionIds\",\n143:       \"secretsmanager:ListSecrets\"\n144:     ]\n145:     resources = [\n146:       \"arn:aws:secretsmanager:eu-west-2:${data.aws_caller_identity.current.account_id}:secret:environment_management-??????\",\n147:       \"arn:aws:secretsmanager:eu-west-2:${data.aws_caller_identity.current.account_id}:secret:pagerduty_integration_keys-??????\",\n148:     ]\n149:   }\n150:   statement {\n151:     effect    = \"Deny\"\n152:     actions   = [\"s3:*\"]\n153:     resources = [\"arn:aws:s3:::*\"]\n154:   }\n155: }\n156: resource \"aws_iam_policy\" \"modernisation_account_limited_read\" {\n157:   name        = \"ModernisationAccountLimitedRead\"\n158:   description = \"Limited Read Access in MP Account for Members and CI\"\n159:   policy      = data.aws_iam_policy_document.modernisation_account_limited_read.json\n160: }\n161: \n162: resource \"aws_iam_role_policy_attachment\" \"modernisation_account_limited_read\" {\n163:   role       = aws_iam_role.modernisation_account_limited_read.id\n164:   policy_arn = aws_iam_policy.modernisation_account_limited_read.arn\n165: }\n166: \n167: # Modernisation Platform Environments Terraform backend role\n168: \n169: data \"aws_iam_policy_document\" \"modernisation_account_terraform_state_role\" {\n170:   version = \"2012-10-17\"\n171:   statement {\n172:     sid    = \"AllowDynamoDBAccess\"\n173:     effect = \"Allow\"\n174:     actions = [\n175:       \"dynamodb:DescribeTable\",\n176:       \"dynamodb:GetItem\",\n177:       \"dynamodb:PutItem\",\n178:       \"dynamodb:DeleteItem\"\n179:     ]\n180:     resources = [\"arn:aws:dynamodb:eu-west-2:${data.aws_caller_identity.current.account_id}:table/modernisation-platform-terraform-state-lock\"]\n181:   }\n182:   statement {\n183:     sid    = \"AllowS3AccessList\"\n184:     effect = \"Allow\"\n185:     actions = [\n186:       \"s3:ListBucket\",\n187:     ]\n188:     resources = [\"arn:aws:s3:::modernisation-platform-terraform-state\"]\n189:   }\n190:   statement {\n191:     sid    = \"AllowS3AccessActions\"\n192:     effect = \"Allow\"\n193:     actions = [\n194:       \"s3:DeleteObject\",\n195:       \"s3:GetObject\",\n196:       \"s3:PutObject\",\n197:     ]\n198:     resources = [\"arn:aws:s3:::modernisation-platform-terraform-state/environments/members/*\"]\n199:   }\n200: }\n201: \n202: data \"aws_iam_policy_document\" \"modernisation_account_terraform_state_assume_role\" {\n203:   version = \"2012-10-17\"\n204: \n205:   statement {\n206:     effect  = \"Allow\"\n207:     actions = [\"sts:AssumeRole\"]\n208: \n209:     principals {\n210:       type        = \"AWS\"\n211:       identifiers = [\"*\"]\n212:     }\n213: \n214:     condition {\n215:       test     = \"ForAnyValue:StringLike\"\n216:       variable = \"aws:PrincipalOrgPaths\"\n217:       values   = [\"${data.aws_organizations_organization.root_account.id}/*/${local.modernisation_platform_ou_id}/*\"]\n218:     }\n219:   }\n220: }\n221: \n222: resource \"aws_iam_role\" \"modernisation_account_terraform_state\" {\n223:   name                 = \"modernisation-account-terraform-state-member-access\"\n224:   max_session_duration = 3600\n225:   assume_role_policy   = data.aws_iam_policy_document.modernisation_account_terraform_state_assume_role.json\n226: \n227:   tags = local.tags\n228: }\n229: \n230: resource \"aws_iam_policy\" \"modernisation_account_terraform_state\" {\n231:   name        = \"ModernisationAccountTerraformState\"\n232:   description = \"Role allowing Modernisation Platform customers access to Terraform state backend resources\"\n233:   policy      = data.aws_iam_policy_document.modernisation_account_terraform_state_role.json\n234: }\n235: \n236: resource \"aws_iam_role_policy_attachment\" \"modernisation_account_terraform_state\" {\n237:   role       = aws_iam_role.modernisation_account_terraform_state.id\n238:   policy_arn = aws_iam_policy.modernisation_account_terraform_state.arn\n239: }\n240: \n241: \n242: # OIDC resources\n243: \n244: module \"github-oidc\" {\n245:   source                      = \"github.com/ministryofjustice/modernisation-platform-github-oidc-provider?ref=82f546bd5f002674138a2ccdade7d7618c6758b3\" # v3.0.0