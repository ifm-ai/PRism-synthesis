            "output": "<path>/workspace/terraform/environments/bootstrap/delegate-access/policies.tf</path>\n<type>file</type>\n<content>\n1: # IAM policies used for SSO and collaborator roles\n2: \n3: # common policy statements\n4: #tfsec:ignore:aws-iam-no-policy-wildcards\n5: data \"aws_iam_policy_document\" \"common_statements\" {\n6:   statement {\n7:     sid    = \"denyPermissions\"\n8:     effect = \"Deny\"\n9:     actions = [\n10:       \"ec2:CreateVpc\",\n11:       \"ec2:CreateSubnet\",\n12:       \"ec2:CreateVpcPeeringConnection\",\n13:       \"iam:AddClientIDToOpenIDConnectProvider\",\n14:       \"iam:AddUserToGroup\",\n15:       \"iam:AttachGroupPolicy\",\n16:       \"iam:AttachUserPolicy\",\n17:       \"iam:CreateAccountAlias\",\n18:       \"iam:CreateGroup\",\n19:       \"iam:CreateLoginProfile\",\n20:       \"iam:CreateOpenIDConnectProvider\",\n21:       \"iam:CreateSAMLProvider\",\n22:       \"iam:CreateUser\",\n23:       \"iam:CreateVirtualMFADevice\",\n24:       \"iam:DeactivateMFADevice\",\n25:       \"iam:DeleteAccountAlias\",\n26:       \"iam:DeleteAccountPasswordPolicy\",\n27:       \"iam:DeleteGroup\",\n28:       \"iam:DeleteGroupPolicy\",\n29:       \"iam:DeleteLoginProfile\",\n30:       \"iam:DeleteOpenIDConnectProvider\",\n31:       \"iam:DeleteSAMLProvider\",\n32:       \"iam:DeleteUser\",\n33:       \"iam:DeleteUserPermissionsBoundary\",\n34:       \"iam:DeleteUserPolicy\",\n35:       \"iam:DeleteVirtualMFADevice\",\n36:       \"iam:DetachGroupPolicy\",\n37:       \"iam:DetachUserPolicy\",\n38:       \"iam:EnableMFADevice\",\n39:       \"iam:RemoveClientIDFromOpenIDConnectProvider\",\n40:       \"iam:RemoveUserFromGroup\",\n41:       \"iam:ResyncMFADevice\",\n42:       \"iam:UpdateAccountPasswordPolicy\",\n43:       \"iam:UpdateGroup\",\n44:       \"iam:UpdateLoginProfile\",\n45:       \"iam:UpdateOpenIDConnectProviderThumbprint\",\n46:       \"iam:UpdateSAMLProvider\",\n47:       \"iam:UpdateUser\"\n48:     ]\n49:     resources = [\"*\"]\