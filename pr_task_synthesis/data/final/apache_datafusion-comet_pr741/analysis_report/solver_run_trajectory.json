            "output": "<path>/workspace/spark/src/main/scala/org/apache/spark/sql/comet/DecimalPrecision.scala</path>\n<type>file</type>\n<content>\n1: /*\n2:  * Licensed to the Apache Software Foundation (ASF) under one\n3:  * or more contributor license agreements.  See the NOTICE file\n4:  * distributed with this work for additional information\n5:  * regarding copyright ownership.  The ASF licenses this file\n6:  * to you under the Apache License, Version 2.0 (the\n7:  * \"License\"); you may not use this file except in compliance\n8:  * with the License.  You may obtain a copy of the License at\n9:  *\n10:  *   http://www.apache.org/licenses/LICENSE-2.0\n11:  *\n12:  * Unless required by applicable law or agreed to in writing,\n13:  * software distributed under the License is distributed on an\n14:  * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY\n15:  * KIND, either express or implied.  See the License for the\n16:  * specific language governing permissions and limitations\n17:  * under the License.\n18:  */\n19: \n20: package org.apache.spark.sql.comet\n21: \n22: import scala.math.{max, min}\n23: \n24: import org.apache.spark.sql.catalyst.expressions._\n25: import org.apache.spark.sql.types.DecimalType\n26: \n27: /**\n28:  * This is mostly copied from the `decimalAndDecimal` method in Spark's [[DecimalPrecision]] which\n29:  * existed before Spark 3.4.\n30:  *\n31:  * In Spark 3.4 and up, the method `decimalAndDecimal` is removed from Spark, and for binary\n32:  * expressions with different decimal precisions from children, the difference is handled in the\n33:  * expression evaluation instead (see SPARK-39316).\n34:  *\n35:  * However in Comet, we still have to rely on the type coercion to ensure the decimal precision is\n36:  * the same for both children of a binary expression, since our arithmetic kernels do not yet\n37:  * handle the case where precision is different. Therefore, this re-apply the logic in the\n38:  * original rule, and rely on `Cast` and `CheckOverflow` for decimal binary operation.\n39:  *\n40:  * TODO: instead of relying on this rule, it's probably better to enhance arithmetic kernels to\n41:  * handle different decimal precisions\n42:  */\n43: object DecimalPrecision {\n44:   def promote(\n45:       allowPrecisionLoss: Boolean,\n46:       expr: Expression,\n47:       nullOnOverflow: Boolean): Expression = {\n48:     expr.transformUp {\n49:       // This means the binary expression is already optimized with the rule in Spark. This can\n50:       // happen if the Spark version is < 3.4\n51:       case e: BinaryArithmetic if e.left.prettyName == \"promote_precision\" => e\n52: \n53:       case add @ Add(DecimalExpression(p1, s1), DecimalExpression(p2, s2), _) =>\n54:         val resultScale = max(s1, s2)\n55:         val resultType = if (allowPrecisionLoss) {\n56:           DecimalType.adjustPrecisionScale(max(p1 - s1, p2 - s2) + resultScale + 1, resultScale)\n57:         } else {\n58:           DecimalType.bounded(max(p1 - s1, p2 - s2) + resultScale + 1, resultScale)\n59:         }\n60:         CheckOverflow(add, resultType, nullOnOverflow)\n61: \n62:       case sub @ Subtract(DecimalExpression(p1, s1), DecimalExpression(p2, s2), _) =>\n63:         val resultScale = max(s1, s2)\n64:         val resultType = if (allowPrecisionLoss) {\n65:           DecimalType.adjustPrecisionScale(max(p1 - s1, p2 - s2) + resultScale + 1, resultScale)\n66:         } else {\n67:           DecimalType.bounded(max(p1 - s1, p2 - s2) + resultScale + 1, resultScale)\n68:         }\n69:         CheckOverflow(sub, resultType, nullOnOverflow)\n70: \n71:       case mul @ Multiply(DecimalExpression(p1, s1), DecimalExpression(p2, s2), _) =>\n72:         val resultType = if (allowPrecisionLoss) {\n73:           DecimalType.adjustPrecisionScale(p1 + p2 + 1, s1 + s2)\n74:         } else {\n75:           DecimalType.bounded(p1 + p2 + 1, s1 + s2)\n76:         }\n77:         CheckOverflow(mul, resultType, nullOnOverflow)\n78: \n79:       case div @ Divide(DecimalExpression(p1, s1), DecimalExpression(p2, s2), _) =>\n80:         val resultType = if (allowPrecisionLoss) {\n81:           // Precision: p1 - s1 + s2 + max(6, s1 + p2 + 1)\n82:           // Scale: max(6, s1 + p2 + 1)\n83:           val intDig = p1 - s1 + s2\n84:           val scale = max(DecimalType.MINIMUM_ADJUSTED_SCALE, s1 + p2 + 1)\n85:           val prec = intDig + scale\n86:           DecimalType.adjustPrecisionScale(prec, scale)\n87:         } else {\n88:           var intDig = min(DecimalType.MAX_SCALE, p1 - s1 + s2)\n89:           var decDig = min(DecimalType.MAX_SCALE, max(6, s1 + p2 + 1))\n90:           val diff = (intDig + decDig) - DecimalType.MAX_SCALE\n91:           if (diff > 0) {\n92:             decDig -= diff / 2 + 1\n93:             intDig = DecimalType.MAX_SCALE - decDig\n94:           }\n95:           DecimalType.bounded(intDig + decDig, decDig)\n96:         }\n97:         CheckOverflow(div, resultType, nullOnOverflow)\n98: \n99:       case rem @ Remainder(DecimalExpression(p1, s1), DecimalExpression(p2, s2), _) =>\n100:         val resultType = if (allowPrecisionLoss) {\n101:           DecimalType.adjustPrecisionScale(min(p1 - s1, p2 - s2) + max(s1, s2), max(s1, s2))\n102:         } else {\n103:           DecimalType.bounded(min(p1 - s1, p2 - s2) + max(s1, s2), max(s1, s2))\n104:         }\n105:         CheckOverflow(rem, resultType, nullOnOverflow)\n106: \n107:       case e => e\n108:     }\n109:   }\n110: \n111:   // TODO: consider to use `org.apache.spark.sql.types.DecimalExpression` for Spark 3.5+\n112:   object DecimalExpression {\n113:     def unapply(e: Expression): Option[(Int, Int)] = e.dataType match {\n114:       case t: DecimalType => Some((t.precision, t.scale))\n115:       case _ => None\n116:     }\n117:   }\n118: }\n\n(End of file - total 118 lines)\n</content>",
