              "newString": "        Operator {\n            children: vec![child_op],\n            op_struct: Some(OpStruct::Filter(spark_operator::Filter {\n                predicate: Some(expr),\n            })),\n        }\n    }\n\n    #[test]\n    fn test_decimal_result_fits_in_128() {\n        use datafusion::logical_expr::Operator as DataFusionOperator;\n\n        // Test addition: max(p1 - s1, p2 - s2) + max(s1, s2) + 1\n        // Small precision should fit\n        assert!(decimal_result_fits_in_128(&DataFusionOperator::Plus, 10, 2, 10, 2));\n        assert!(decimal_result_fits_in_128(&DataFusionOperator::Plus, 18, 5, 18, 5));\n        \n        // Large precision should not fit\n        assert!(!decimal_result_fits_in_128(&DataFusionOperator::Plus, 38, 10, 38, 10));\n        \n        // Test subtraction: same as addition\n        assert!(decimal_result_fits_in_128(&DataFusionOperator::Minus, 10, 2, 10, 2));\n        assert!(!decimal_result_fits_in_128(&DataFusionOperator::Minus, 38, 10, 38, 10));\n        \n        // Test multiplication: p1 + p2 + 1\n        // Small precision should fit (10 + 10 + 1 = 21 <= 38)\n        assert!(decimal_result_fits_in_128(&DataFusionOperator::Multiply, 10, 2, 10, 2));\n        // Medium precision should fit (18 + 18 + 1 = 37 <= 38)\n        assert!(decimal_result_fits_in_128(&DataFusionOperator::Multiply, 18, 5, 18, 5));\n        // Large precision should not fit (38 + 38 + 1 = 77 > 38)\n        assert!(!decimal_result_fits_in_128(&DataFusionOperator::Multiply, 38, 10, 38, 10));\n        // Edge case: 19 + 19 + 1 = 39 > 38\n        assert!(!decimal_result_fits_in_128(&DataFusionOperator::Multiply, 19, 5, 19, 5));\n        \n        // Test modulo: min(p1 - s1, p2 - s2) + max(s1, s2)\n        // Small precision should fit\n        assert!(decimal_result_fits_in_128(&DataFusionOperator::Modulo, 10, 2, 10, 2));\n        // Large precision should not fit\n        assert!(!decimal_result_fits_in_128(&DataFusionOperator::Modulo, 38, 10, 38, 10));\n        \n        // Test division: always returns false (handled separately)\n        assert!(!decimal_result_fits_in_128(&DataFusionOperator::Divide, 10, 2, 10, 2));\n    }\n}"
