                "patch": "Index: /workspace/native/core/src/execution/datafusion/planner.rs\n===================================================================\n--- /workspace/native/core/src/execution/datafusion/planner.rs\n+++ /workspace/native/core/src/execution/datafusion/planner.rs\n@@ -94,8 +94,39 @@\n };\n \n use super::expressions::{create_named_struct::CreateNamedStruct, EvalMode};\n use crate::execution::datafusion::expressions::comet_scalar_funcs::create_comet_physical_fun;\n+\n+/// Calculates the required precision for decimal arithmetic operations.\n+/// Returns true if the result fits within Decimal128 (precision <= 38), false otherwise.\n+fn decimal_result_fits_in_128(op: &DataFusionOperator, p1: u8, s1: i8, p2: u8, s2: i8) -> bool {\n+    let result_precision = match op {\n+        DataFusionOperator::Plus | DataFusionOperator::Minus => {\n+            // For addition/subtraction: max(p1 - s1, p2 - s2) + max(s1, s2) + 1\n+            let int_digits = std::cmp::max(p1 as i32 - s1 as i32, p2 as i32 - s2 as i32);\n+            let scale = std::cmp::max(s1, s2);\n+            int_digits + scale as i32 + 1\n+        }\n+        DataFusionOperator::Multiply => {\n+            // For multiplication: p1 + p2 + 1\n+            p1 as i32 + p2 as i32 + 1\n+        }\n+        DataFusionOperator::Modulo => {\n+            // For modulo: min(p1 - s1, p2 - s2) + max(s1, s2)\n+            let int_digits = std::cmp::min(p1 as i32 - s1 as i32, p2 as i32 - s2 as i32);\n+            let scale = std::cmp::max(s1, s2);\n+            int_digits + scale as i32\n+        }\n+        DataFusionOperator::Divide => {\n+            // Division is handled separately with spark_decimal_div\n+            // This case should not be reached for division\n+            return false;\n+        }\n+        _ => return false,\n+    };\n+\n+    result_precision <= 38\n+}\n use datafusion_comet_proto::{\n     spark_expression::{\n         self, agg_expr::ExprStruct as AggExprStruct, expr::ExprStruct, literal::Value, AggExpr,\n         Expr, ScalarFunc,\n",
