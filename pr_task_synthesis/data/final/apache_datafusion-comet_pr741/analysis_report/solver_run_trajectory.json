            "output": "<path>/workspace/native/spark-expr/src/scalar_funcs.rs</path>\n<type>file</type>\n<content>\n200: /// Spark-compatible `MakeDecimal` expression (internal to Spark optimizer)\n201: pub fn spark_make_decimal(\n202:     args: &[ColumnarValue],\n203:     data_type: &DataType,\n204: ) -> DataFusionResult<ColumnarValue> {\n205:     let (precision, scale) = get_precision_scale(data_type);\n206:     match &args[0] {\n207:         ColumnarValue::Scalar(v) => match v {\n208:             ScalarValue::Int64(n) => Ok(ColumnarValue::Scalar(ScalarValue::Decimal128(\n209:                 long_to_decimal(n, precision),\n210:                 precision,\n211:                 scale,\n212:             ))),\n213:             sv => internal_err!(\"Expected Int64 but found {sv:?}\"),\n214:         },\n215:         ColumnarValue::Array(a) => {\n216:             let arr = a.as_primitive::<Int64Type>();\n217:             let mut result = Decimal128Builder::new();\n218:             for v in arr.into_iter() {\n219:                 result.append_option(long_to_decimal(&v, precision))\n220:             }\n221:             let result_type = DataType::Decimal128(precision, scale);\n222: \n223:             Ok(ColumnarValue::Array(Arc::new(\n224:                 result.finish().with_data_type(result_type),\n225:             )))\n226:         }\n227:     }\n228: }\n229: \n230: /// Convert the input long to decimal with the given maximum precision. If overflows, returns null\n231: /// instead.\n232: #[inline]\n233: fn long_to_decimal(v: &Option<i64>, precision: u8) -> Option<i128> {\n234:     match v {\n235:         Some(v) if validate_decimal_precision(*v as i128, precision).is_ok() => Some(*v as i128),\n236:         _ => None,\n237:     }\n238: }\n239: \n240: #[inline]\n241: fn decimal_ceil_f(scale: &i8) -> impl Fn(i128) -> i128 {\n242:     let div = 10_i128.pow_wrapping(*scale as u32);\n243:     move |x: i128| div_ceil(x, div)\n244: }\n245: \n246: #[inline]\n247: fn decimal_floor_f(scale: &i8) -> impl Fn(i128) -> i128 {\n248:     let div = 10_i128.pow_wrapping(*scale as u32);\n249:     move |x: i128| div_floor(x, div)\n250: }\n251: \n252: // Spark uses BigDecimal. See RoundBase implementation in Spark. Instead, we do the same by\n253: // 1) add the half of divisor, 2) round down by division, 3) adjust precision by multiplication\n254: #[inline]\n255: fn decimal_round_f(scale: &i8, point: &i64) -> Box<dyn Fn(i128) -> i128> {\n256:     if *point < 0 {\n257:         if let Some(div) = 10_i128.checked_pow((-(*point) as u32) + (*scale as u32)) {\n258:             let half = div / 2;\n259:             let mul = 10_i128.pow_wrapping((-(*point)) as u32);\n260:             // i128 can hold 39 digits of a base 10 number, adding half will not cause overflow\n261:             Box::new(move |x: i128| (x + x.signum() * half) / div * mul)\n262:         } else {\n263:             Box::new(move |_: i128| 0)\n264:         }\n265:     } else {\n266:         let div = 10_i128.pow_wrapping((*scale as u32) - min(*scale as u32, *point as u32));\n267:         let half = div / 2;\n268:         Box::new(move |x: i128| (x + x.signum() * half) / div)\n269:     }\n270: }\n271: \n272: #[inline]\n273: fn make_decimal_array(\n274:     array: &ArrayRef,\n275:     precision: u8,\n276:     scale: i8,\n277:     f: &dyn Fn(i128) -> i128,\n278: ) -> Result<ColumnarValue, DataFusionError> {\n279:     let array = array.as_primitive::<Decimal128Type>();\n280:     let result: Decimal128Array = arrow::compute::kernels::arity::unary(array, f);\n281:     let result = result.with_data_type(DataType::Decimal128(precision, scale));\n282:     Ok(ColumnarValue::Array(Arc::new(result)))\n283: }\n284: \n285: #[inline]\n286: fn make_decimal_scalar(\n287:     a: &Option<i128>,\n288:     precision: u8,\n289:     scale: i8,\n290:     f: &dyn Fn(i128) -> i128,\n291: ) -> Result<ColumnarValue, DataFusionError> {\n292:     let result = ScalarValue::Decimal128(a.map(f), precision, scale);\n293:     Ok(ColumnarValue::Scalar(result))\n294: }\n295: \n296: macro_rules! integer_round {\n297:     ($X:expr, $DIV:expr, $HALF:expr) => {{\n298:         let rem = $X % $DIV;\n299:         if rem <= -$HALF {\n300:             ($X - rem).sub_wrapping($DIV)\n301:         } else if rem >= $HALF {\n302:             ($X - rem).add_wrapping($DIV)\n303:         } else {\n304:             $X - rem\n305:         }\n306:     }};\n307: }\n308: \n309: macro_rules! round_integer_array {\n310:     ($ARRAY:expr, $POINT:expr, $TYPE:ty, $NATIVE:ty) => {{\n311:         let array = $ARRAY.as_any().downcast_ref::<$TYPE>().unwrap();\n312:         let ten: $NATIVE = 10;\n313:         let result: $TYPE = if let Some(div) = ten.checked_pow((-(*$POINT)) as u32) {\n314:             let half = div / 2;\n315:             arrow::compute::kernels::arity::unary(array, |x| integer_round!(x, div, half))\n316:         } else {\n317:             arrow::compute::kernels::arity::unary(array, |_| 0)\n318:         };\n319:         Ok(ColumnarValue::Array(Arc::new(result)))\n320:     }};\n321: }\n322: \n323: macro_rules! round_integer_scalar {\n324:     ($SCALAR:expr, $POINT:expr, $TYPE:expr, $NATIVE:ty) => {{\n325:         let ten: $NATIVE = 10;\n326:         if let Some(div) = ten.checked_pow((-(*$POINT)) as u32) {\n327:             let half = div / 2;\n328:             Ok(ColumnarValue::Scalar($TYPE(\n329:                 $SCALAR.map(|x| integer_round!(x, div, half)),\n330:             )))\n331:         } else {\n332:             Ok(ColumnarValue::Scalar($TYPE(Some(0))))\n333:         }\n334:     }};\n335: }\n336: \n337: /// `round` function that simulates Spark `round` expression\n338: pub fn spark_round(\n339:     args: &[ColumnarValue],\n340:     data_type: &DataType,\n341: ) -> Result<ColumnarValue, DataFusionError> {\n342:     let value = &args[0];\n343:     let point = &args[1];\n344:     let ColumnarValue::Scalar(ScalarValue::Int64(Some(point))) = point else {\n345:         return internal_err!(\"In