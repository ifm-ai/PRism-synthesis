   Ok(env_path) => env_path,\n47:             Err(_) => $default.into(),\n48:         }\n49:     };\n50: }\n51: \n52: fn list_files_in_folder(dir: &str) -> Result<Vec<String>> {\n53:     let mut file_paths = Vec::new();\n54: \n55:     for entry in fs::read_dir(dir)? {\n56:         let path = entry?.path();\n57:         if path.is_file() {\n58:             if let Some(path_str) = path.to_str() {\n59:                 file_paths.push(path_str.to_string());\n60:             }\n61:         }\n62:     }\n63: \n64:     Ok(file_paths)\n65: }\n66: \n67: #[repr(C)]\n68: #[serde_as]\n69: #[derive(Debug, Serialize, Deserialize)]\n70: pub struct SeAttestationResponse {\n71:     #[serde_as(as = \"Base64\")]\n72:     measurement: Vec<u8>,\n73:     #[serde_as(as = \"Base64\")]\n74:     additional_data: Vec<u8>,\n75:     #[serde_as(as = \"Base64\")]\n76:     user_data: Vec<u8>,\n77:     #[serde_as(as = \"Base64\")]\n78:     cuid: ConfigUid,\n79:     #[serde_as(as = \"Base64\")]\n80:     encr_measurement_key: Vec<u8>,\n81:     #[serde_as(as = \"Base64\")]\n82:     encr_request_nonce: Vec<u8>,\n83:     #[serde_as(as = \"Base64\")]\n84:     image_hdr_tags: BootHdrTags,\n85: }\n86: \n87: #[repr(C)]\n88: #[serde_as]\n89: #[derive(Debug, Serialize, Deserialize)]\n90: pub struct SeAttestationClaims {\n91:     #[serde_as(as = \"Hex\")]\n92:     cuid: ConfigUid,\n93:     #[serde_as(as = \"Hex\")]\n94:     user_data: Vec<u8>,\n95:     version: u32,\n96:     #[serde_as(as = \"Hex\")]\n97:     image_phkh: Vec<u8>,\n98:     #[serde_as(as = \"Hex\")]\n99:     attestation_phkh: Vec<u8>,\n100:     #[serde_as(as = \"Hex\")]\n101:     tag: [u8; 16],\n102: }\n103: \n104: #[repr(C)]\n105: #[serde_as]\n106: #[derive(Debug, Serialize, Deserialize)]\n107: pub struct SeAttestationRequest {\n108:     #[serde_as(as = \"Base64\")]\n109:     request_blob: Vec<u8>,\n110:     measurement_size: u32,\n111:     additional_size: u32,\n112:     #[serde_as(as = \"Base64\")]\n113:     encr_measurement_key: Vec<u8>,\n114:     #[serde_as(as = \"Base64\")]\n115:     encr_request_nonce: Vec<u8>,\n116:     #[serde_as(as = \"Base64\")]\n117:     image_hdr_tags: BootHdrTags,\n118: }\n119: \n120: #[derive(Debug)]\n121: pub struct SeVerifierImpl {\n122:     private_key: PKey<Private>,\n123:     public_key: PKey<Public>,\n124: }\n125: \n126: impl SeVerifierImpl {\n127:     pub fn new() -> Result<Self> {\n128:         let pri_key_file = env_or_default!(\n129:             \"SE_MEASUREMENT_ENCR_KEY_PRIVATE\",\n130:             DEFAULT_SE_MEASUREMENT_ENCR_KEY_PRIVATE\n131:         );\n132:         let priv_contents = fs::read(pri_key_file)?;\n133:         let private_key = PKey::private_key_from_pem(&priv_contents)?;\n134: \n135:         let pub_key_file = env_or_default!(\n136:             \"SE_MEASUREMENT_ENCR_KEY_PUBLIC\",\n137:             DEFAULT_SE_MEASUREMENT_ENCR_KEY_PUBLIC\n138:         );\n139:         let pub_contents = fs::read(pub_key_file)?;\n140:         let public_key = PKey::public_key_from_pem(&pub_contents)?;\n141: \n142:         Ok(Self {\n143:             private_key,\n144:             public_key,\n145:         })\n146:     }\n147: \n148:     fn decrypt(&self, ciphertext: &[u8]) -> Result<Vec<u8>> {\n149:         let mut decrypter = Decrypter::new(&self.private_key)?;\n150:         decrypter.set_rsa_padding(Padding::PKCS1)?;\n151: \n152:         let buffer_len = decrypter.decrypt_len(ciphertext)?;\n153:         let mut decrypted = vec![0; buffer_len];\n154:         let decrypted_len = decrypter.decrypt(ciphertext, &mut decrypted)?;\n155:         decrypted.truncate(decrypted_len);\n156: \n157:         Ok(decrypted)\n158:     }\n159: \n160:     fn encrypt(&self, text: &[u8]) -> Result<Vec<u8>> {\n161:         let mut encrypter = Encrypter::new(&self.public_key)?;\n162:         encrypter.set_rsa_padding(Padding::PKCS1)?;\n163: \n164:         let buffer_len = encrypter.encrypt_len(text)?;\n165:         let mut encrypted = vec![0; buffer_len];\n166:         let len = encrypter.encrypt(text, &mut encrypted)?;\n167:         encrypted.truncate(len);\n168: \n169:         Ok(encrypted)\n170:     }\n171: \n172:     pub fn evaluate(&self, evidence: &[u8]) -> Result<TeeEvidenceParsedClaim> {\n173:         info!(\"IBM SE verify API called.\");\n174: \n175:         // evidence is serialized SeAttestationResponse String bytes\n176:         let se_response: SeAttestationResponse = serde_json::from_slice(evidence)?;\n177: \n178:         let meas_key = self\n179:             .decrypt(&se_response.encr_measurement_key)\n180:             .context(\"decrypt Measurement Key\")?;\n181:         let nonce = self\n182:             .decrypt(&se_response.encr_request_nonce)\n183:             .context(\"decrypt Request Nonce\")?;\n184: \n185:         let nonce_array: [u8; 16] = nonce\n186:             .try_into()\n187:             .map_err(|_| anyhow!(\"Failed to convert nonce from Vec<u8> to [u8; 16], It must have exactly 16 elements.\"))?;\n188: \n189:         let meas_key = PKey::hmac(&meas_key)?;\n190:         let items = AttestationItems::new(\n191:             &se_response.image_hdr_tags,\n192:             &se_response.cuid,\n193:             Some(&se_response.user_data),\n194:             Some(&nonce_array),\n195:             Some(&se_response.additional_data),\n196:         );\n197: \n198:         let measurement =\n199:             AttestationMeasurement::calculate(items, AttestationMeasAlg::HmacSha512, &meas_key)?;\n200: \n201:         if !measurement.eq_secure(&se_response.measurement) {\n202:             debug!(\"Recieved: {:?}\", se_response.measurement);\n203:             debug!(\"Calculated: {:?}\", measurement.as_ref());\n204:             bail!(\"Failed to verify the measurement!\");\n205:         }\n206: \n207:         let mut att_flags = AttestationFlags::default();\n208:         att_flags.set_image_phkh();\n209:         att_flags.set_attest_phkh();\n210:         let add_data = AdditionalData::from_slice(&se_response.additional_data, &att_flags)?;\n211:         debug!(\"additional_data: {:?}\", add_data);\n212:         let image_phkh = add_data\n213:             .image_public_host_key_hash()\n214:             .ok_or(anyhow!(\"Failed to get image_public_host_key_hash.\"))?;\n215:         let attestation_phkh = add_data\n216:             .attestation_public_host_key_hash()\n217:             .ok_or(anyhow!(\"Failed to get attestation_public_host_key_hash.\"))?;\n218: \n219:         let claims = SeAttestationClaims {\n220:             cuid: se_response.cuid,\n221:             user_data: se_response.user_data.clone(),\n222:             version: AttestationVersion::One as u32,\n223:             image_phkh: image_phkh.to_vec(),\n224:             attestation_phkh: attestation_phkh.to_vec(),\n225:             tag: *se_response.image_hdr_tags.tag(),\n226:         };\n227: \n228:         serde_json::to_value(claims).context(\"build json value from the se claims\")\n229:     }\n230: \n231:     pub async fn generate_supplemental_challenge(&self, _tee_parameters: String) -> Result<String> {\n232:         let se_certificate_root =\n233:             env_or_default!(\"SE_CERTIFICATES_ROOT\", DEFAULT_SE_CERTIFICATES_ROOT);\n234:         let ca_certs = list_files_in_folder(&se_certificate_root)?;\n235: \n236:         let crl_root = env_or_default!(\n237:             \"SE_CERTIFICATE_REVOCATION_LISTS_ROOT\",\n238:             DEFAULT_SE_CERTIFICATE_REVOCATION_LISTS_ROOT\n239:         );\n240:         let crls = list_files_in_folder(&crl_root)?;\n241: \n242:         let root_ca_path =\n243:             env_or_default!(\"SE_CERTIFICATE_ROOT_CA\", DEFAULT_SE_CERTIFICATE_ROOT_CA);\n244:         let ca_option: Option<String> = if std::path::Path::new(&root_ca_path).exists() {\n245:             Some(root_ca_path)\n246:         } else {\n247:             None::<String>\n248:         };\n249:         let offline_certs_verify = env_or_default!(\n250:             \"CERTS_OFFLINE_VERIFICATION\",\n251:             DEFAULT_CERTS_OFFLINE_VERIFICATION\n252:         );\n253:         let offline_certs_verify: bool = offline_certs_verify.parse::<bool>().unwrap_or(false);\n254:         let mut attestation_flags = AttestationFlags::default();\n255:         attestation_flags.set_image_phkh();\n256:         attestation_flags.set_attest_phkh();\n257:         let mut arcb = AttestationRequest::new(\n258:             AttestationVersion::One,\n259:             AttestationMeasAlg::HmacSha512,\n260:             attestation_flags,\n261:         )?;\n262: \n263:         let hkds_root = env_or_default!(\n264:             \"DEFAULT_SE_HOST_KEY_DOCUMENTS_ROOT\",\n265:             DEFAULT_SE_HOST_KEY_DOCUMENTS_ROOT\n266:         );\n267:         let hkds = list_files_in_folder(&hkds_root)?;\n268:         for hkd in &hkds {\n269:             let hk = std::fs::read(hkd).context(\"read host-key document\")?;\n270:             let certs = read_certs(&hk)?;\n271:             if certs.is_empty() {\n272:                 warn!(\"The host key document in '{hkd}' contains empty certificate!\");\n273:             }\n274:             if certs.len() != 1 {\n275:                 warn!(\"The host key document in '{hkd}' contains more than one certificate!\")\n276:             }\n277:             let c = certs\n278:                 .first()\n279:                 .ok_or(anyhow!(\"File does not contain a X509 certificate\"))?;\n280:             #[cfg(debug_assertions)]\n281:             {\n282:                 const DEFAULT_SE_SKIP_CERTS_VERIFICATION: &str = \"false\";\n283:                 let skip_certs_env = env_or_default!(\n284:                     \"SE_SKIP_CERTS_VERIFICATION\",\n285:                     DEFAULT_SE_SKIP_CERTS_VERIFICATION\n286:                 );\n287:                 let skip_certs: bool = skip_certs_env.parse::<bool>().unwrap_or(false);\n288:                 if !skip_certs {\n289:                     let verifier = CertVerifier::new(\n290:                         ca_certs.as_slice(),\n291:                         crls.as_slice(),\n292:                         ca_option.clone(),\n293:                         offline_certs_verify,\n294:                     )?;\n295:                     verifier.verify(c)?;\n296:                 }\n297:             }\n298:             #[cfg(not(debug_assertions))]\n299:             {\n300:                 let verifier = CertVerifier::new(\n301:                     ca_certs.as_slice(),\n302:                     crls.as_slice(),\n303:                     ca_option.clone(),\n304:                     offline_certs_verify,\n305:                 )?;\n306:                 verifier.verify(c)?;\n307:             }\n308:             arcb.add_hostkey(c.public_key()?);\n309:         }\n310: \n311:         let encr_ctx = ReqEncrCtx::random(SymKeyType::Aes256)?;\n312:         let request_blob = arcb.encrypt(&encr_ctx)?;\n313:         let conf_data = arcb.confidential_data();\n314:         let encr_measurement_key = self.encrypt(conf_data.measurement_key())?;\n315:         let nonce = conf_data\n316:             .nonce()\n317:             .as_ref()\n318:             .ok_or(anyhow!(\"Failed to get nonce binding\"))?\n319:             .value();\n320:         let encr_request_nonce = self.encrypt(nonce)?;\n321: \n322:         let se_img_hdr = env_or_default!(\"SE_IMAGE_HEADER_FILE\", DEFAULT_SE_IMAGE_HEADER_FILE);\n323:         let mut hdr_file = open_file(se_img_hdr)?;\n324:         let image_hdr_tags = BootHdrTags::from_se_image(&mut hdr_file)?;\n325: \n326:         let se_attestation_request = SeAttestationRequest {\n327:             request_blob,\n328:             measurement_size: AttestationMeasAlg::HmacSha512.exp_size(),\n329:             additional_size: arcb.flags().expected_additional_size(),\n330:             encr_measurement_key,\n331:             encr_request_nonce,\n332:             image_hdr_tags,\n333:         };\n334: \n335:         let challenge = serde_json::to_string(&se_attestation_request)?;\n336:         Ok(challenge)\n337:     }\n338: }\n\n(End of file - total 338 lines)\n</content>",
