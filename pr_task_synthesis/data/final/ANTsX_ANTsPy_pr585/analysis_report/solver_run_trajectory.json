ngWindowedSinc\n48:             lanczosWindowedSinc\n49:             genericLabel use this for label images\n50: \n51:     imagetype : integer\n52:         choose 0/1/2/3 mapping to scalar/vector/tensor/time-series\n53: \n54:     whichtoinvert : list of booleans (optional)\n55:         Must be same length as transformlist.\n56:         whichtoinvert[i] is True if transformlist[i] is a matrix,\n57:         and the matrix should be inverted. If transformlist[i] is a\n58:         warp field, whichtoinvert[i] must be False.\n59:         If the transform list is a matrix followed by a warp field,\n60:         whichtoinvert defaults to (True,False). Otherwise it defaults\n61:         to [False]*len(transformlist)).\n62: \n63:     compose : string (optional)\n64:         if it is a string pointing to a valid file location,\n65:         this will force the function to return a composite transformation filename.\n66: \n67:     defaultvalue : scalar\n68:         Default voxel value for mappings outside the image domain.\n69: \n70:     verbose : boolean\n71:         print command and run verbose application of transform.\n72: \n73:     singleprecision : boolean\n74:         if True, perform the transformation in single precision (float32).\n75:         if False (default), perform the transformation in double precision (float64).\n76:         The returned image will always have the same pixeltype as the moving image.\n77: \n78:     kwargs : keyword arguments\n79:         extra parameters\n80: \n81:     Returns\n82:     -------\n83:     ANTsImage or string (transformation filename)\n84: \n85:     Example\n86:     -------\n87:     >>> import ants\n88:     >>> fixed = ants.image_read( ants.get_ants_data('r16') )\n89:     >>> moving = ants.image_read( ants.get_ants_data('r64') )\n90:     >>> fixed = ants.resample_image(fixed, (64,64), 1, 0)\n91:     >>> moving = ants.resample_image(moving, (64,64), 1, 0)\n92:     >>> mytx = ants.registration(fixed=fixed , moving=moving ,\n93:                                  type_of_transform = 'SyN' )\n94:     >>> mywarpedimage = ants.apply_transforms( fixed=fixed, moving=moving,\n95:                                                transformlist=mytx['fwdtransforms'] )\n96:     \"\"\"\n97: \n98:     if not isinstance(transformlist, (tuple, list)) and (transformlist is not None):\n99:         transformlist = [transformlist]\n100: \n101:     accepted_interpolators = {\"linear\", \"nearestNeighbor\", \"multiLabel\", \"gaussian\",\n102:                         \"bSpline\", \"cosineWindowedSinc\", \"welchWindowedSinc\",\n103:                         \"hammingWindowedSinc\", \"lanczosWindowedSinc\", \"genericLabel\"}\n104: \n105:     if interpolator not in accepted_interpolators:\n106:         raise ValueError('interpolator not supported - see %s' % accepted_interpolators)\n107: \n108:     args = [fixed, moving, transformlist, interpolator]\n109: \n110:     if not isinstance(fixed, str):\n111:         if isinstance(fixed, iio.ANTsImage) and isinstance(moving, iio.ANTsImage):\n112:             for tl_path in transformlist:\n113:                 if not os.path.exists(tl_path):\n114:                     raise Exception('Transform %s does not exist' % tl_path)\n115: \n116:             inpixeltype = moving.pixeltype\n117:             compute_pixeltype = 'float' if singleprecision else 'double'\n118:             fixed = fixed.clone(compute_pixeltype)\n119:             moving = moving.clone(compute_pixeltype)\n120:             warpedmovout = moving.clone()\n121:             f = fixed\n122:             m = moving\n123:             if (moving.dimension == 4) and (fixed.dimension == 3) and (imagetype == 0):\n124:                 raise Exception('Set imagetype 3 to transform time series images.')\n125: \n126:             wmo = warpedmovout\n127:             mytx = []\n128:             if whichtoinvert is None or (isinstance(whichtoinvert, (tuple,list)) and (sum([w is not None for w in whichtoinvert])==0)):\n129:                 if (len(transformlist) == 2) and ('.mat' in transformlist[0]) and ('.mat' not in transformlist[1]):\n130:                     whichtoinvert = (True, False)\n131:                 else:\n132:                     whichtoinvert = tuple([False]*len(transformlist))\n133: \n134:             if len(whichtoinvert) != len(transformlist):\n135:                 raise ValueError('Transform list and inversion list must be the same length')\n136: \n137:             for i in range(len(transformlist)):\n138:                 ismat = False\n139:                 if '.mat' in transformlist[i]:\n140:                     ismat = True\n141:                 if whichtoinvert[i] and (not ismat):\n142:                     raise ValueError('Cannot invert transform %i (%s) because it is not a matrix' % (i, transformlist[i]))\n143:                 if whichtoinvert[i]:\n144:                     mytx = mytx + ['-t', '[%s,1]' % (transformlist[i])]\n145:                 else:\n146:                     mytx = mytx + ['-t', transformlist[i]]\n147: \n148:             if compose is None:\n149:                 args = ['-d', fixed.dimension,\n150:                         '-i', m,\n151:                         '-o', wmo,\n152:                         '-r', f,\n153:                         '-n', interpolator]\n154:                 args = args + mytx\n155:             if compose:\n156:                 tfn = '%scomptx.nii.gz' % compose if not compose.endswith('.h5') else compose\n157:             else:\n158:                 tfn = 'NA'\n159:             if compose is not None:\n160:                 mycompo = '[%s,1]' % tfn\n161:                 args = ['-d', fixed.dimension,\n162:                         '-i', m,\n163:                         '-o', mycompo,\n164:                         '-r', f,\n165:                         '-n', interpolator]\n166:                 args = args + mytx\n167: \n168:             myargs = utils._int_antsProcessArguments(args)\n169: \n170:             myverb = int(verbose)\n171: 