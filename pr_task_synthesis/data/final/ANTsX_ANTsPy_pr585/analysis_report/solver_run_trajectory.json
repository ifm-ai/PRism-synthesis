              "oldString": "class TestModule_apply_transforms(unittest.TestCase):\n    def setUp(self):\n        pass\n\n    def tearDown(self):\n        pass\n\n    def test_example(self):\n        # test ANTsPy/ANTsR example\n        fixed = ants.image_read(ants.get_ants_data(\"r16\"))\n        moving = ants.image_read(ants.get_ants_data(\"r64\"))\n        fixed = ants.resample_image(fixed, (64, 64), 1, 0)\n        moving = ants.resample_image(moving, (64, 64), 1, 0)\n        mytx = ants.registration(fixed=fixed, moving=moving, type_of_transform=\"SyN\")\n        mywarpedimage = ants.apply_transforms(\n            fixed=fixed, moving=moving, transformlist=mytx[\"fwdtransforms\"]\n        )\n\n        # bad interpolator\n        with self.assertRaises(Exception):\n            mywarpedimage = ants.apply_transforms(\n                fixed=fixed,\n                moving=moving,\n                transformlist=mytx[\"fwdtransforms\"],\n                interpolator=\"unsupported-interp\",\n            )\n\n        # transform doesnt exist\n        with self.assertRaises(Exception):\n            mywarpedimage = ants.apply_transforms(\n                fixed=fixed,\n                moving=moving,\n                transformlist=[\"blah-blah.mat\"],\n                interpolator=\"unsupported-interp\",\n            )",
              "newString": "class TestModule_apply_transforms(unittest.TestCase):\n    def setUp(self):\n        pass\n\n    def tearDown(self):\n        pass\n\n    def test_example(self):\n        # test ANTsPy/ANTsR example\n        fixed = ants.image_read(ants.get_ants_data(\"r16\"))\n        moving = ants.image_read(ants.get_ants_data(\"r64\"))\n        fixed = ants.resample_image(fixed, (64, 64), 1, 0)\n        moving = ants.resample_image(moving, (64, 64), 1, 0)\n        mytx = ants.registration(fixed=fixed, moving=moving, type_of_transform=\"SyN\")\n        mywarpedimage = ants.apply_transforms(\n            fixed=fixed, moving=moving, transformlist=mytx[\"fwdtransforms\"]\n        )\n\n        # bad interpolator\n        with self.assertRaises(Exception):\n            mywarpedimage = ants.apply_transforms(\n                fixed=fixed,\n                moving=moving,\n                transformlist=mytx[\"fwdtransforms\"],\n                interpolator=\"unsupported-interp\",\n            )\n\n        # transform doesnt exist\n        with self.assertRaises(Exception):\n            mywarpedimage = ants.apply_transforms(\n                fixed=fixed,\n                moving=moving,\n                transformlist=[\"blah-blah.mat\"],\n                interpolator=\"unsupported-interp\",\n            )\n\n    def test_singleprecision_parameter(self):\n        # test that singleprecision parameter works correctly\n        fixed = ants.image_read(ants.get_ants_data(\"r16\"))\n        moving = ants.image_read(ants.get_ants_data(\"r64\"))\n        fixed = ants.resample_image(fixed, (64, 64), 1, 0)\n        moving = ants.resample_image(moving, (64, 64), 1, 0)\n        mytx = ants.registration(fixed=fixed, moving=moving, type_of_transform=\"SyN\")\n\n        # Test 1: Default (double precision) - pixeltype should match moving image\n        warped_default = ants.apply_transforms(\n            fixed=fixed, moving=moving, transformlist=mytx[\"fwdtransforms\"]\n        )\n        self.assertEqual(warped_default.pixeltype, moving.pixeltype)\n\n        # Test 2: Single precision - pixeltype should still match moving image\n        warped_single = ants.apply_transforms(\n            fixed=fixed, moving=moving, transformlist=mytx[\"fwdtransforms\"],\n            singleprecision=True\n        )\n        self.assertEqual(warped_single.pixeltype, moving.pixeltype)\n\n        # Test 3: Physical space consistency\n        self.assertTrue(\n            ants.image_physical_space_consistency(fixed, warped_default, 0.0001, datatype=False)\n        )\n        self.assertTrue(\n            ants.image_physical_space_consistency(fixed, warped_single, 0.0001, datatype=False)\n        )\n\n        # Test 4: Sums should be almost identical (places=3)\n        self.assertAlmostEqual(warped_default.sum(), warped_single.sum(), places=3)\n\n        # Test 5: Error handling - unknown interpolator\n        with self.assertRaises(Exception):\n            ants.apply_transforms(\n                fixed=fixed,\n                moving=moving,\n                transformlist=mytx[\"fwdtransforms\"],\n                interpolator=\"unsupported-interp\",\n                singleprecision=True\n            )\n\n        # Test 6: Error handling - non-existent transform file\n        with self.assertRaises(Exception):\n            ants.apply_transforms(\n                fixed=fixed,\n                moving=moving,\n                transformlist=[\"blah-blah.mat\"],\n                singleprecision=True\n            )\n\n        # Test 7: Test with different moving image pixeltype (unsigned int)\n        moving_uint = moving.clone(\"unsigned int\")\n        warped_uint_default = ants.apply_transforms(\n            fixed=fixed,\n            moving=moving_uint,\n            transformlist=mytx[\"fwdtransforms\"]\n        )\n        warped_uint_single = ants.apply_transforms(\n            fixed=fixed,\n            moving=moving_uint,\n            transformlist=mytx[\"fwdtransforms\"],\n            singleprecision=True\n        )\n        self.assertEqual(warped_uint_default.pixeltype, moving_uint.pixeltype)\n        self.assertEqual(warped_uint_single.pixeltype, moving_uint.pixeltype)"
            },
