              "file": "test_singleprecision.py",
              "patch": "Index: test_singleprecision.py\n===================================================================\n--- test_singleprecision.py\t\n+++ test_singleprecision.py\t\n@@ -0,0 +1,125 @@\n+\"\"\"\n+Test script for singleprecision parameter in apply_transforms\n+\"\"\"\n+\n+import numpy as np\n+\n+def test_singleprecision_parameter():\n+    \"\"\"Test that singleprecision parameter works correctly\"\"\"\n+    import ants\n+    \n+    # Setup test images\n+    fixed = ants.image_read(ants.get_ants_data('r16'))\n+    moving = ants.image_read(ants.get_ants_data('r64'))\n+    fixed = ants.resample_image(fixed, (64, 64), 1, 0)\n+    moving = ants.resample_image(moving, (64, 64), 1, 0)\n+    \n+    # Register to get transforms\n+    mytx = ants.registration(fixed=fixed, moving=moving, type_of_transform='SyN')\n+    \n+    # Test 1: Default (double precision) - pixeltype should match moving image\n+    print(\"Test 1: Default (double precision)\")\n+    warped_default = ants.apply_transforms(\n+        fixed=fixed, \n+        moving=moving, \n+        transformlist=mytx['fwdtransforms']\n+    )\n+    print(f\"  Moving pixeltype: {moving.pixeltype}\")\n+    print(f\"  Warped pixeltype (default): {warped_default.pixeltype}\")\n+    assert warped_default.pixeltype == moving.pixeltype, \\\n+        f\"Expected {moving.pixeltype}, got {warped_default.pixeltype}\"\n+    print(\"  ✓ PASSED: pixeltype matches moving image\")\n+    \n+    # Test 2: Single precision - pixeltype should still match moving image\n+    print(\"\\nTest 2: Single precision\")\n+    warped_single = ants.apply_transforms(\n+        fixed=fixed, \n+        moving=moving, \n+        transformlist=mytx['fwdtransforms'],\n+        singleprecision=True\n+    )\n+    print(f\"  Moving pixeltype: {moving.pixeltype}\")\n+    print(f\"  Warped pixeltype (single): {warped_single.pixeltype}\")\n+    assert warped_single.pixeltype == moving.pixeltype, \\\n+        f\"Expected {moving.pixeltype}, got {warped_single.pixeltype}\"\n+    print(\"  ✓ PASSED: pixeltype matches moving image\")\n+    \n+    # Test 3: Physical space consistency\n+    print(\"\\nTest 3: Physical space consistency\")\n+    phys_consistent_default = ants.image_physical_space_consistency(\n+        fixed, warped_default, 0.0001, datatype=False\n+    )\n+    phys_consistent_single = ants.image_physical_space_consistency(\n+        fixed, warped_single, 0.0001, datatype=False\n+    )\n+    print(f\"  Physical space consistent (default): {phys_consistent_default}\")\n+    print(f\"  Physical space consistent (single): {phys_consistent_single}\")\n+    assert phys_consistent_default, \"Default warped image should match fixed image physical space\"\n+    assert phys_consistent_single, \"Single precision warped image should match fixed image physical space\"\n+    print(\"  ✓ PASSED: Physical space consistency holds\")\n+    \n+    # Test 4: Sums should be almost identical\n+    print(\"\\nTest 4: Sum comparison\")\n+    sum_default = warped_default.sum()\n+    sum_single = warped_single.sum()\n+    print(f\"  Sum (default): {sum_default:.6f}\")\n+    print(f\"  Sum (single): {sum_single:.6f}\")\n+    print(f\"  Difference: {abs(sum_default - sum_single):.6f}\")\n+    # Use assertAlmostEqual with places=3 as specified in requirements\n+    np.testing.assert_almost_equal(sum_default, sum_single, decimal=3)\n+    print(\"  ✓ PASSED: Sums are almost identical (places=3)\")\n+    \n+    # Test 5: Error handling - unknown interpolator\n+    print(\"\\nTest 5: Error handling - unknown interpolator\")\n+    try:\n+        ants.apply_transforms(\n+            fixed=fixed,\n+            moving=moving,\n+            transformlist=mytx['fwdtransforms'],\n+            interpolator=\"unsupported-interp\"\n+        )\n+        print(\"  ✗ FAILED: Should have raised an exception\")\n+        assert False, \"Should have raised an exception for unknown interpolator\"\n+    except (ValueError, Exception) as e:\n+        print(f\"  ✓ PASSED: Exception raised as expected: {type(e).__name__}\")\n+    \n+    # Test 6: Error handling - non-existent transform file\n+    print(\"\\nTest 6: Error handling - non-existent transform file\")\n+    try:\n+        ants.apply_transforms(\n+            fixed=fixed,\n+            moving=moving,\n+            transformlist=[\"blah-blah.mat\"]\n+        )\n+        print(\"  ✗ FAILED: Should have raised an exception\")\n+        assert False, \"Should have raised an exception for non-existent transform\"\n+    except Exception as e:\n+        print(f\"  ✓ PASSED: Exception raised as expected: {type(e).__name__}\")\n+    \n+    # Test 7: Test with different moving image pixeltype (unsigned int)\n+    print(\"\\nTest 7: Different moving image pixeltype (unsigned int)\")\n+    moving_uint = moving.clone('unsigned int')\n+    warped_uint_default = ants.apply_transforms(\n+        fixed=fixed,\n+        moving=moving_uint,\n+        transformlist=mytx['fwdtransforms']\n+    )\n+    warped_uint_single = ants.apply_transforms(\n+        fixed=fixed,\n+        moving=moving_uint,\n+        transformlist=mytx['fwdtransforms'],\n+        singleprecision=True\n+    )\n+    print(f\"  Moving pixeltype: {moving_uint.pixeltype}\")\n+    print(f\"  Warped pixeltype (default): {warped_uint_default.pixeltype}\")\n+    print(f\"  Warped pixeltype (single): {warped_uint_single.pixeltype}\")\n+    assert warped_uint_default.pixeltype == moving_uint.pixeltype\n+    assert warped_uint_single.pixeltype == moving_uint.pixeltype\n+    print(\"  ✓ PASSED: pixeltype preserved for unsigned int\")\n+    \n+    print(\"\\n\" + \"=\"*60)\n+    print(\"All tests PASSED!\")\n+    print(\"=\"*60)\n+\n+if __name__ == \"__main__\":\n+    test_singleprecision_parameter()\n",
              "additions": 125,
              "deletions": 0,
              "status": "added"
