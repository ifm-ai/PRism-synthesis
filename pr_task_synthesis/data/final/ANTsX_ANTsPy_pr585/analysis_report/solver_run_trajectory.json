            "output": "<path>/workspace/ants/registration/apply_transforms.py</path>\n<type>file</type>\n<content>\n1: \n2: \n3: __all__ = ['apply_transforms','apply_transforms_to_points']\n4: \n5: import os\n6: \n7: from .. import core\n8: from ..core import ants_image as iio\n9: from .. import utils\n10: \n11: def apply_transforms(fixed, moving, transformlist,\n12:                      interpolator='linear', imagetype=0,\n13:                      whichtoinvert=None, compose=None,\n14:                      defaultvalue=0, verbose=False, **kwargs):\n15:     \"\"\"\n16:     Apply a transform list to map an image from one domain to another.\n17:     In image registration, one computes mappings between (usually) pairs\n18:     of images. These transforms are often a sequence of increasingly\n19:     complex maps, e.g. from translation, to rigid, to affine to deformation.\n20:     The list of such transforms is passed to this function to interpolate one\n21:     image domain into the next image domain, as below. The order matters\n22:     strongly and the user is advised to familiarize with the standards\n23:     established in examples.\n24: \n25:     ANTsR function: `antsApplyTransforms`\n26: \n27:     Arguments\n28:     ---------\n29:     fixed : ANTsImage\n30:         fixed image defining domain into which the moving image is transformed.\n31: \n32:     moving : AntsImage\n33:         moving image to be mapped to fixed space.\n34: \n35:     transformlist : list of strings\n36:         list of transforms generated by ants.registration where each transform is a filename.\n37: \n38:     interpolator : string\n39:         Choice of interpolator. Supports partial matching.\n40:             linear\n41:             nearestNeighbor\n42:             multiLabel for label images (deprecated, prefer genericLabel)\n43:             gaussian\n44:             bSpline\n45:             cosineWindowedSinc\n46:             welchWindowedSinc\n47:             hammingWindowedSinc\n48:             lanczosWindowedSinc\n49:             genericLabel use this for label images\n50: \n51:     imagetype : integer\n52:         choose 0/1/2/3 mapping to scalar/vector/tensor/time-series\n53: \n54:     whichtoinvert : list of booleans (optional)\n55:         Must be same length as transformlist.\n56:         whichtoinvert[i] is True if transformlist[i] is a matrix,\n57:         and the matrix should be inverted. If transformlist[i] is a\n58:         warp field, whichtoinvert[i] must be False.\n59:         If the transform list is a matrix followed by a warp field,\n60:         whichtoinvert defaults to (True,False). Otherwise it defaults\n61:         to [False]*len(transformlist)).\n62: \n63:     compose : string (optional)\n64:         if it is a string pointing to a valid file location,\n65:         this will force the function to return a composite transformation filename.\n66: \n67:     defaultvalue : scalar\n68:         Default voxel value for mappings outside the image domain.\n69: \n70:     verbose : boolean\n71:         print command and run verbose application of transform.\n72: \n73:     kwargs : keyword arguments\n74:         extra parameters\n75: \n76:     Returns\n77:     -------\n78:     ANTsImage or string (transformation filename)\n79: \n80:     Example\n81:     -------\n82:     >>> import ants\n83:     >>> fixed = ants.image_read( ants.get_ants_data('r16') )\n84:     >>> moving = ants.image_read( ants.get_ants_data('r64') )\n85:     >>> fixed = ants.resample_image(fixed, (64,64), 1, 0)\n86:     >>> moving = ants.resample_image(moving, (64,64), 1, 0)\n87:     >>> mytx = ants.registration(fixed=fixed , moving=moving ,\n88:                                  type_of_transform = 'SyN' )\n89:     >>> mywarpedimage = ants.apply_transforms( fixed=fixed, moving=moving,\n90:                                                transformlist=mytx['fwdtransforms'] )\n91:     \"\"\"\n92: \n93:     if not isinstance(transformlist, (tuple, list)) and (transformlist is not None):\n94:         transformlist = [transformlist]\n95: \n96:     accepted_interpolators = {\"linear\", \"nearestNeighbor\", \"multiLabel\", \"gaussian\",\n97:                         \"bSpline\", \"cosineWindowedSinc\", \"welchWindowedSinc\",\n98:                         \"hammingWindowedSinc\", \"lanczosWindowedSinc\", \"genericLabel\"}\n99: \n100:     if interpolator not in accepted_interpolators:\n101:         raise ValueError('interpolator not supported - see %s' % accepted_interpolators)\n102: \n103:     args = [fixed, moving, transformlist, interpolator]\n104: \n105:     if not isinstance(fixed, str):\n106:         if isinstance(fixed, iio.ANTsImage) and isinstance(moving, iio.ANTsImage):\n107:             for tl_path in transformlist:\n108:                 if not os.path.exists(tl_path):\n109:                     raise Exception('Transform %s does not exist' % tl_path)\n110: \n111:             inpixeltype = fixed.pixeltype\n112:             fixed = fixed.clone('float')\n113:             moving = moving.clone('float')\n114:             warpedmovout = moving.clone()\n115:             f = fixed\n116:             m = moving\n117:             if (moving.dimension == 4) and (fixed.dimension == 3) and (imagetype == 0):\n118:                 raise Exception('Set imagetype 3 to transform time series images.')\n119: \n120:             wmo = warpedmovout\n121:             mytx = []\n122:             if whichtoinvert is None or (isinstance(whichtoinvert, (tuple,list)) and (sum([w is not None for w in whichtoinvert])==0)):\n123:                 if (len(transformlist) == 2) and ('.mat' in transformlist[0]) and ('.mat' not in transformlist[1]):\n124:                     whichtoinvert = (True, False)\n125:                 else:\n126:                     whichtoinvert = tuple([False]*len(transformlist))\n127: \n128:             if len(whichtoinvert) != len(transformlist):\n129:                 raise ValueError('Transform list and inversion list must be the same length')\n130: \n131:             for i in range(len(transformlist)):\n132:                 ismat = False\n133:                 if '.mat' in transformlist[i]:\n134:                     ismat = True\n135:                 if whichtoinvert[i] and (not ismat):\n136:                     raise ValueError('Cannot invert transform %i (%s) because it is not a matrix' % (i, transformlist[i]))\n137:                 if whichtoinvert[i]:\n138:                     mytx = mytx + ['-t', '[%s,1]' % (transformlist[i])]\n139:                 else:\n140:                     mytx = mytx + ['-t', transformlist[i]]\n141: \n142:             if compose is None:\n143:                 args = ['-d', fixed.dimension,\n144:                         '-i', m,\n145:                         '-o', wmo,\n146:                         '-r', f,\n147:                         '-n', interpolator]\n148:                 args = args + mytx\n149:             if compose:\n150:                 tfn = '%scomptx.nii.gz' % compose if not compose.endswith('.h5') else compose\n151:             else:\n152:                 tfn = 'NA'\n153:             if compose is not None:\n154:                 mycompo = '[%s,1]' % tfn\n155:                 args = ['-d', fixed.dimension,\n156:                         '-i', m,\n157:                         '-o', mycompo,\n158:                         '-r', f,\n159:                         '-n', interpolator]\n160:                 args = args + mytx\n161: \n162:             myargs = utils._int_antsProcessArguments(args)\n163: \n164:             myverb = int(verbose)\n165:             if verbose:\n166:                 print(myargs)\n167: \n168:             processed_args = myargs + ['-z', str(1), '-v', str(myverb), '--float', str(1), '-e', str(imagetype), '-f', str(defaultvalue)]\n169:             libfn = utils.get_lib_fn('antsApplyTransforms')\n170:             libfn(processed_args)\n171: \n172:             if compose is None:\n173:                 return warpedmovout.clone(inpixeltype)\n174:             else:\n175:                 if os.path.exists(tfn):\n176:                     return tfn\n177:                 else:\n178:                     return None\n179: \n180:         else:\n181:             return 1\n182:     else:\n183:         args = args + ['-z', 1, '--float', 1, '-e', imagetype, '-f', defaultvalue]\n184:         processed_args = utils._int_antsProcessArguments(args)\n185:         libfn = utils.get_lib_fn('antsApplyTransforms')\n186:         libfn(processed_args)\n187: \n188: \n189: \n190: \n191: \n192: \n193: def apply_transforms_to_points( dim, points, transformlist,\n194:                      whichtoinvert=None, verbose=False ):\n195:     \"\"\"\n196:      Apply a transform list to map a pointset from one domain to\n197:      another. In registration, one computes mappings between pairs of\n198:      domains. These transforms are often a sequence of increasingly\n199:      complex maps, e.g. from translation, to rigid, to affine to\n200:      deformation.  The list of such transforms is passed to this\n201:      function to interpolate one image domain into the next image\n202:      domain, as below.  The order matters strongly and the user is\n203:      advised to familiarize with the standards established in examples.\n204:      Importantly, point mapping goes the opposite direction of image\n205:      mapping, for both reasons of convention and engineering.\n206: \n207:     ANTsR function: `antsApplyTransformsToPoints`\n208: \n209:     Arguments\n210:     ---------\n211:     dim: integer\n212:          dimensionality of the transformation.\n213: \n214:     points: data frame\n215:           moving point set with n-points in rows of at least dim\n216:           columns - we maintain extra information in additional\n217:           columns. this should be a data frame with columns names x, y, z, t.\n218: \n219:     transformlist : list of strings\n220:         list of transforms generated by ants.registration where each transform is a filename.\n221: \n222:     whichtoinvert : list of booleans (optional)\n223:         Must be same length as transformlist.\n224:         whichtoinvert[i] is True if transformlist[i] is a matrix,\n225:         and the matrix should be inverted. If transformlist[i] is a\n226:         warp field, whichtoinvert[i] must be False.\n227:         If the transform list is a matrix followed by a warp field,\n228:         whichtoinvert defaults to (True,False). Otherwise it defaults\n229:         to [False]*len(transformlist)).\n230: \n231:     verbose : boolean\n232: \n233:     Returns\n234:     -------\n235:     data frame of transformed points\n236: \n237:     Example\n238:     -------\n239:     >>> import ants\n240:     >>> fixed = ants.image_read( ants.get_ants_data('r16') )\n241:     >>> moving = ants.image_read( ants.get_ants_data('r27') )\n242:     >>> reg = ants.registration( fixed, moving, 'Affine' )\n243:     >>> d = {'x': [128, 127], 'y': [101, 111]}\n244:     >>> pts = pd.DataFrame(data=d)\n245:     >>> ptsw = ants.apply_transforms_to_points( 2, pts, reg['fwdtransforms'])\n246:     \"\"\"\n247: \n248:     if not isinstance(transformlist, (tuple, list)) and (transformlist is not None):\n249:         transformlist = [transformlist]\n250: \n251:     args = [dim, points, transformlist, whichtoinvert]\n252: \n253:     for tl_path in transformlist:\n254:         if not os.path.exists(tl_path):\n255:             raise Exception('Transform %s does not exist' % tl_path)\n256: \n257:     mytx = []\n258: \n259:     if whichtoinvert is None or (isinstance(whichtoinvert, (tuple,list)) and (sum([w is not None for w in whichtoinvert])==0)):\n260:         if (len(transformlist) == 2) and ('.mat' in transformlist[0]) and ('.mat' not in transformlist[1]):\n261:             whichtoinvert = (True, False)\n262:         else:\n263:             whichtoinvert = tuple([False]*len(transformlist))\n264: \n265:     if len(whichtoinvert) != len(transformlist):\n266:         raise ValueError('Transform list and inversion list must be the same length')\n267: \n268:     for i in range(len(transformlist)):\n269:         ismat = False\n270:         if '.mat' in transformlist[i]:\n271:             ismat = True\n272:         if whichtoinvert[i] and (not ismat):\n273:             raise ValueError('Cannot invert transform %i (%s) because it is not a matrix' % (i, transformlist[i]))\n274:         if whichtoinvert[i]:\n275:             mytx = mytx + ['-t', '[%s,1]' % (transformlist[i])]\n276:         else:\n277:             mytx = mytx + ['-t', transformlist[i]]\n278:     if dim == 2:\n279:         pointsSub = points[['x','y']]\n280:     if dim == 3:\n281:         pointsSub = points[['x','y','z']]\n282:     if dim == 4:\n283:         pointsSub = points[['x','y','z','t']]\n284:     pointImage = core.make_image( pointsSub.shape, pointsSub.values.flatten())\n285:     pointsOut = pointImage.clone()\n286:     args = ['-d', dim,\n287:             '-i', pointImage,\n288:             '-o', pointsOut ]\n289:     args = args + mytx\n290:     myargs = utils._int_antsProcessArguments(args)\n291: \n292:     myverb = int(verbose)\n293:     if verbose:\n294:         print(myargs)\n295: \n296:     processed_args = myargs + [ '-f', str(1), '--precision', str(0)]\n297:     libfn = utils.get_lib_fn('antsApplyTransformsToPoints')\n298:     libfn(processed_args)\n299:     mynp = pointsOut.numpy()\n300:     pointsOutDF = points.copy()\n301:     pointsOutDF['x'] = mynp[:,0]\n302:     if dim >= 2:\n303:         pointsOutDF['y'] = mynp[:,1]\n304:     if dim >= 3:\n305:         pointsOutDF['z'] = mynp[:,2]\n306:     if dim >= 4:\n307:         pointsOutDF['t'] = mynp[:,3]\n308:     return pointsOutDF\n\n(End of file - total 308 lines)\n</content>",
