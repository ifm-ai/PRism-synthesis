            "output": "<path>/workspace/ants/core/ants_image.py</path>\n<type>file</type>\n<content>\n1: \n2: \n3: __all__ = ['ANTsImage',\n4:            'LabelImage',\n5:            'copy_image_info',\n6:            'set_origin',\n7:            'get_origin',\n8:            'set_direction',\n9:            'get_direction',\n10:            'set_spacing',\n11:            'get_spacing',\n12:            'image_physical_space_consistency',\n13:            'image_type_cast',\n14:            'allclose']\n15: \n16: import os\n17: \n18: import numpy as np\n19: import pandas as pd\n20: \n21: try:\n22:     from functools import partialmethod\n23:     HAS_PY3 = True\n24: except:\n25:     HAS_PY3 = False\n26: \n27: import inspect\n28: \n29: from .. import registration, segmentation, utils, viz\n30: from . import ants_image_io as iio2\n31: \n32: _supported_ptypes = {'unsigned char', 'unsigned int', 'float', 'double'}\n33: _supported_dtypes = {'uint8', 'uint32', 'float32', 'float64'}\n34: _itk_to_npy_map = {\n35:     'unsigned char': 'uint8',\n36:     'unsigned int': 'uint32',\n37:     'float': 'float32',\n38:     'double': 'float64'}\n39: _npy_to_itk_map = {\n40:     'uint8': 'unsigned char',\n41:     'uint32':'unsigned int',\n42:     'float32': 'float',\n43:     'float64': 'double'}\n44: \n45: \n46: class ANTsImage(object):\n47: \n48:     def __init__(self, pixeltype='float', dimension=3, components=1, pointer=None, is_rgb=False, label_image=None):\n49:         \"\"\"\n50:         Initialize an ANTsImage\n51: \n52:         Arguments\n53:         ---------\n54:         pixeltype : string\n55:             ITK pixeltype of image\n56: \n57:         dimension : integer\n58:             number of image dimension. Does NOT include components dimension\n59: \n60:         components : integer\n61:             number of pixel components in the image\n62: \n63:         pointer : py::capsule (optional)\n64:             pybind11 capsule holding the pointer to the underlying ITK image object\n65: \n66:         label_image : LabelImage\n67:             a discrete label image for mapping locations to atlas regions\n68: \n69:         \"\"\"\n70:         ## Attributes which cant change without creating a new ANTsImage object\n71:         self.pointer = pointer\n72:         self.pixeltype = pixeltype\n73:         self.dimension = dimension\n74:         self.components = components\n75:         self.has_components = self.components > 1\n76:         self.dtype = _itk_to_npy_map[self.pixeltype]\n77:         self.is_rgb = is_rgb\n78: \n79:         self._pixelclass = 'vector' if self.has_components else 'scalar'\n80:         self._shortpclass = 'V' if self._pixelclass == 'vector' else ''\n81:         if is_rgb:\n82:             self._pixelclass = 'rgb'\n83:             self._shortpclass = 'RGB'\n84: \n85:         self._libsuffix = '%s%s%i' % (self._shortpclass, utils.short_ptype(self.pixeltype), self.dimension)\n86: \n87:         self.shape = utils.get_lib_fn('getShape%s'%self._libsuffix)(self.pointer)\n88:         self.physical_shape = tuple([round(sh*sp,3) for sh,sp in zip(self.shape, self.spacing)])\n89: \n90:         if label_image is not None:\n91:             if not isinstance(label_image, LabelImage):\n92:                 raise ValueError('label_image argument must be a LabelImage type')\n93:             self.label_image = label_image\n94: \n95:         self._array = None\n96: \n97:     @property\n98:     def spacing(self):\n99:         \"\"\"\n100:         Get image spacing\n101: \n102:         Returns\n103:         -------\n104:         tuple\n105:         \"\"\"\n106:         libfn = utils.get_lib_fn('getSpacing%s'%self._libsuffix)\n107:         return libfn(self.pointer)\n108: \n109:     def set_spacing(self, new_spacing):\n110:         \"\"\"\n111:         Set image spacing\n112: \n113:         Arguments\n114:         ---------\n115:         new_spacing : tuple or list\n116:             updated spacing for the image.\n117:             should have one value for each dimension\n118: \n119:         Returns\n120:         -------\n121:         None\n122:         \"\"\"\n123:         if not isinstance(new_spacing, (tuple, list)):\n124:             raise ValueError('arg must be tuple or list')\n125:         if len(new_spacing) != self.dimension:\n126:             raise ValueError('must give a spacing value for each dimension (%i)' % self.dimension)\n127: \n128:         libfn = utils.get_lib_fn('setSpacing%s'%self._libsuffix)\n129:         libfn(self.pointer, new_spacing)\n130: \n131:     @property\n132:     def origin(self):\n133:         \"\"\"\n134:         Get image origin\n135: \n136:         Returns\n137:         -------\n138:         tuple\n139:         \"\"\"\n140:         libfn = utils.get_lib_fn('getOrigin%s'%self._libsuffix)\n141:         return libfn(self.pointer)\n142: \n143:     def set_origin(self, new_origin):\n144:         \"\"\"\n145:         Set image origin\n146: \n147:         Arguments\n148:         ---------\n149:         new_origin : tuple or list\n150:             updated origin for the image.\n151:             should have one value for each dimension\n152: \n153:         Returns\n154:         -------\n155:         None\n156:         \"\"\"\n157:         if not isinstance(new_origin, (tuple, list)):\n158:             raise ValueError('arg must be tuple or list')\n159:         if len(new_origin) != self.dimension:\n160:             raise ValueError('must give a origin value for each dimension (%i)' % self.dimension)\n161: \n162:         libfn = utils.get_lib_fn('setOrigin%s'%self._libsuffix)\n163:         libfn(self.pointer, new_origin)\n164: \n165:     @property\n166:     def direction(self):\n167:         \"\"\"\n168:         Get image direction\n169: \n170:         Returns\n171:         -------\n172:         tuple\n173:         \"\"\"\n174:         libfn = utils.get_lib_fn('getDirection%s'%self._libsuffix)\n175:         return libfn(self.pointer)\n176: \n177:     def set_direction(self, new_direction):\n178:         \"\"\"\n179:         Set image direction\n180: \n181:         Arguments\n182:         ---------\n183:         new_direction : numpy.ndarray or tuple or list\n184:             updated direction for the image.\n185:             should have one value for each dimension\n186: \n187:         Returns\n188:         -------\n189:         None\n190:         \"\"\"\n191:         if isinstance(new_direction, (tuple,list)):\n192:             new_direction = np.asarray(new_direction)\n193: \n194:         if not isinstance(new_direction, np.ndarray):\n195:             raise ValueError('arg must be np.ndarray or tuple or list')\n196:         if len(new_direction) != self.dimension:\n197:             raise ValueError('must give a origin value for each dimension (%i)' % self.dimension)\n198: \n199:         libfn = utils.get_lib_fn('setDirection%s'%self._libsuffix)\n200:         libfn(self.pointer, new_direction)\n201: \n202:     @property\n203:     def orientation(self):\n204:         if self.dimension == 3:\n205:             return self.get_orientation()\n206:         else:\n207:             return None\n208: \n209:     def view(self, single_components=False):\n210:         \"\"\"\n211:         Geet a numpy array providing direct, shared access to the image data.\n212:         IMPORTANT: If you alter the view, then the underlying image data\n213:         will also be altered.\n214: \n215:         Arguments\n216:         ---------\n217:         single_components : boolean (default is False)\n218:             if True, keep the extra component dimension in returned array even\n219:             if image only has one component (i.e. self.has_components == False)\n220: \n221:         Returns\n222:         -------\n223:         ndarray\n224:         \"\"\"\n225:         if self.is_rgb:\n226:             img = self.rgb_to_vector()\n227:         else:\n228:             img = self\n229:         dtype = img.dtype\n230:         shape = img.shape[::-1]\n231:         if img.has_components or (single_components == True):\n232:             shape = list(shape) + [img.components]\n233:         libfn = utils.get_lib_fn('toNumpy%s'%img._libsuffix)\n234:         memview = libfn(img.pointer)\n235:         return np.asarray(memview).view(dtype = dtype).reshape(shape).view(np.ndarray).T\n236: \n237:     def numpy(self, single_components=False):\n238:         \"\"\"\n239:         Get a numpy array copy representing the underlying image data. Altering\n240:         this ndarray will have NO effect on the underlying image data.\n241: \n242:         Arguments\n243:         ---------\n244:         single_components : boolean (default is False)\n245:             if True, keep the extra component dimension in returned array even\n246:             if image only has one component (i.e. self.has_components == False)\n247: \n248:         Returns\n249:         -------\n250:         ndarray\n251:         \"\"\"\n252:         array = np.array(self.view(single_components=single_components), copy=True, dtype=self.dtype)\n253:         if self.has_components or (single_components == True):\n254:             array = np.rollaxis(array, 0, self.dimension+1)\n255:         return array\n256: \n257:     def clone(self, pixeltype=None):\n258:         \"\"\"\n259:         Create a copy of the given ANTsImage with the same data and info, possibly with\n260:         a different data type for the image data. Only supports casting to\n261:         uint8 (unsigned char), uint32 (unsigned int), float32 (float), and float64 (double)\n262: \n263:         Arguments\n264:         ---------\n265:         dtype: string (optional)\n266:             if None, the dtype will be the same as the cloned ANTsImage. Otherwise,\n267:             the data will be cast to this type. This can be a numpy type or an ITK\n268:             type.\n269:             Options:\n270:                 'unsigned char' or 'uint8',\n271:                 'unsigned int' or 'uint32',\n272:                 'float' or 'float32',\n273:                 'double' or 'float64'\n274: \n275:         Returns\n276:         -------\n277:         ANTsImage\n278:         \"\"\"\n279:         if pixeltype is None:\n280:             pixeltype = self.pixeltype\n281: \n282:         if pixeltype not in _supported_ptypes:\n283:             raise ValueError('Pixeltype %s not supported. Supported types are %s' % (pixeltype, _supported_ptypes))\n284: \n285:         if self.has_components and (not self.is_rgb):\n286:             comp_imgs = utils.split_channels(self)\n287:             comp_imgs_cloned = [comp_img.clone(pixeltype) for comp_img in comp_imgs]\n288:             return utils.merge_channels(comp_imgs_cloned)\n289:         else:\n290:             p1_short = utils.short_ptype(self.pixeltype)\n291:             p2_short = utils.short_ptype(pixeltype)\n292:             ndim = self.dimension\n293:             fn_suffix = '%s%i%s%i' % (p1_short,ndim,p2_short,ndim)\n294:             libfn = utils.get_lib_fn('antsImageClone%s'%fn_suffix)\n295:             pointer_cloned = libfn(self.pointer)\n296:             return ANTsImage(pixeltype=pixeltype,\n297:                             dimension=self.dimension,\n298:                             components=self.components,\n299:                             is_rgb=self.is_rgb,\n300:                             pointer=pointer_cloned)\n301: \n302:     # pythonic alias for `clone` is `copy`\n303:     copy = clone\n304: \n305:     def astype(self, dtype):\n306:         \"\"\"\n307:         Cast & clone an ANTsImage to a given numpy datatype.\n308: \n309:         Map:\n310:             uint8   : unsigned char\n311:             uint32  : unsigned int\n312:             float32 : float\n313:             float64 : double\n314:         \"\"\"\n315:         if dtype not in _supported_dtypes:\n316:             raise ValueError('Datatype %s not supported. Supported types are %s' % (dtype, _supported_dtypes))\n317: \n318:         pixeltype = _npy_to_itk_map[dtype]\n319:         return self.clone(pixeltype)\n320: \n321:     def new_image_like(self, data):\n322:         \"\"\"\n323:         Create a new ANTsImage with the same header information, but with\n324:         a new image array.\n325: \n326:         Arguments\n327:         ---------\n328:         data : ndarray or py::capsule\n329:             New array or pointer for the image.\n330:             It must have the same shape as the current\n331:             image data.\n332: \n333:         Returns\n334:         -------\n335:         ANTsImage\n336:         \"\"\"\n337:         if not isinstance(data, np.ndarray):\n338:             raise ValueError('data must be a numpy array')\n339:         if not self.has_components:\n340:             if data.shape != self.shape:\n341:                 raise ValueError('given array shape (%s) and image array shape (%s) do not match' % (data.shape, self.shape))\n342:         else:\n343:             if (data.shape[-1] != self.components) or (data.shape[:-1] != self.shape):\n344:                 raise ValueError('given array shape (%s) and image array shape (%s) do not match' % (data.shape[1:], self.shape))\n345: \n346:         return iio2.from_numpy(data, origin=self.origin,\n347:             spacing=self.spacing, direction=self.direction,\n348:             has_components=self.has_components)\n349: \n350:     def to_file(self, filename):\n351:         \"\"\"\n352:         Write the ANTsImage to file\n353: \n354:         Args\n355:         ----\n356:         filename : string\n357:             filepath to which the image will be written\n358:         \"\"\"\n359:         filename = os.path.expanduser(filename)\n360:         libfn = utils.get_lib_fn('toFile%s'%self._libsuffix)\n361:         libfn(self.pointer, filename)\n362:     to_filename = to_file\n363: \n364:     def apply(self, fn):\n365:         \"\"\"\n366:         Apply an arbitrary function to ANTsImage.\n367: \n368:         Args\n369:         ----\n370:         fn : python function or lambda\n371:             function to apply to ENTIRE image at once\n372: \n373:         Returns\n374:         -------\n375:         ANTsImage\n376:             image with function applied to it\n377:         \"\"\"\n378:         this_array = self.numpy()\n379:         new_array = fn(this_array)\n380:         return self.new_image_like(new_array)\n381: \n382:     def as_label_image(self, label_info=None):\n383:         return LabelImage(image=self, label_info=label_info)\n384: \n385:     ## NUMPY FUNCTIONS ##\n386:     def abs(self, axis=None):\n387:         \"\"\" Return absolute value of image \"\"\"\n388:         return np.abs(self.numpy())\n389:     def mean(self, axis=None):\n390:         \"\"\" Return mean along specified axis \"\"\"\n391:         return self.numpy().mean(axis=axis)\n392:     def median(self, axis=None):\n393:         \"\"\" Return median along specified axis \"\"\"\n394:         return np.median(self.numpy(), axis=axis)\n395:     def std(self, axis=None):\n396:         \"\"\" Return std along specified axis \"\"\"\n397:         return self.numpy().std(axis=axis)\n398:     def sum(self, axis=None, keepdims=False):\n399:         \"\"\" Return sum along specified axis \"\"\"\n400:         return self.numpy().sum(axis=axis, keepdims=keepdims)\n401:     def min(self, axis=None):\n402:         \"\"\" Return min along specified axis \"\"\"\n403:         return self.numpy().min(axis=axis)\n404:     def max(self, axis=None):\n405:         \"\"\" Return max along specified axis \"\"\"\n406:         return self.numpy().max(axis=axis)\n407:     def range(self, axis=None):\n408:         \"\"\" Return range tuple along specified axis \"\"\"\n409:         return (self.min(axis=axis), self.max(axis=axis))\n410:     def argmin(self, axis=None):\n411:         \"\"\" Return argmin along specified axis \"\"\"\n412:         return self.numpy().argmin(axis=axis)\n413:     def argmax(self, axis=None):\n414:         \"\"\" Return argmax along specified axis \"\"\"\n415:         return self.numpy().argmax(axis=axis)\n416:     def argrange(self, axis=None):\n417:         \"\"\" Return argrange along specified axis \"\"\"\n418:         amin = self.argmin(axis=axis)\n419:         amax = self.argmax(axis=axis)\n420:         if axis is None:\n421:             return (amin, amax)\n422:         else:\n423:             return np.stack([amin, amax]).T\n424:     def flatten(self):\n425:         \"\"\" Flatten image data \"\"\"\n426:         return self.numpy().flatten()\n427:     def nonzero(self):\n428:         \"\"\" Return non-zero indices of image \"\"\"\n429:         return self.numpy().nonzero()\n430:     def unique(self, sort=False):\n431:         \"\"\" Return unique set of values in image \"\"\"\n432:         unique_vals = np.unique(self.numpy())\n433:         if sort:\n434:             unique_vals = np.sort(unique_vals)\n435:         return unique_vals\n436: \n437:     ## OVERLOADED OPERATORS ##\n438:     def __add__(self, other):\n439:         this_array = self.numpy()\n440: \n441:         if isinstance(other, ANTsImage):\n442:             if not image_physical_space_consistency(self, other):\n443:                 raise ValueError('images do not occupy same physical space')\n444:             other = other.numpy()\n445: \n446:         new_array = this_array + other\n447:         return self.new_image_like(new_array)\n448:     \n449:     __radd__ = __add__\n450:     \n451:     def __sub__(self, other):\n452:         this_array = self.numpy()\n453: \n454:         if isinstance(other, ANTsImage):\n455:             if not image_physical_space_consistency(self, other):\n456:                 raise ValueError('images do not occupy same physical space')\n457:             other = other.numpy()\n458: \n459:         new_array = this_array - other\n460:         return self.new_image_like(new_array)\n461:     \n462:     def __rsub__(self, other):\n463:         this_array = self.numpy()\n464: \n465:         if isinstance(other, ANTsImage):\n466:             if not image_physical_space_consistency(self, other):\n467:                 raise ValueError('images do not occupy same physical space')\n468:             other = other.numpy()\n469: \n470:         new_array = other - this_array\n471:         return self.new_image_like(new_array)\n472:     \n473:     def __mul__(self, other):\n474:         this_array = self.numpy()\n475: \n476:         if isinstance(other, ANTsImage):\n477:             if not image_physical_space_consistency(self, other):\n478:                 raise ValueError('images do not occupy same physical space')\n479:             other = other.numpy()\n480: \n481:         new_array = this_array * other\n482:         return self.new_image_like(new_array)\n483: \n484:     __rmul__ = __mul__\n485: \n486:     def __truediv__(self, other):\n487:         this_array = self.numpy()\n488: \n489:         if isinstance(other, ANTsImage):\n490:             if not image_physical_space_consistency(self, other):\n491:                 raise ValueError('images do not occupy same physical space')\n492:             other = other.numpy()\n493: \n494:         new_array = this_array / other\n495:         return self.new_image_like(new_array)\n496: \n497:     def __pow__(self, other):\n498:         this_array = self.numpy()\n499: \n500:         if isinstance(other, ANTsImage):\n501:             if not image_physical_space_consistency(self, other):\n502:                 raise ValueError('images do not occupy same physical space')\n503:             other = other.numpy()\n504: \n505:         new_array = this_array ** other\n506:         return self.new_image_like(new_array)\n507: \n508:     def __gt__(self, other):\n509:         this_array = self.numpy()\n510: \n511:         if isinstance(other, ANTsImage):\n512:             if not image_physical_space_consistency(self, other):\n513:                 raise ValueError('images do not occupy same physical space')\n514:             other = other.numpy()\n515: \n516:         new_array = this_array > other\n517:         return self.new_image_like(new_array.astype('uint8'))\n518: \n519:     def __ge__(self, other):\n520:         this_array = self.numpy()\n521: \n522:         if isinstance(other, ANTsImage):\n523:             if not image_physical_space_consistency(self, other):\n524:                 raise ValueError('images do not occupy same physical space')\n525:             other = other.numpy()\n526: \n527:         new_array = this_array >= other\n528:         return self.new_image_like(new_array.astype('uint8'))\n529: \n530:     def __lt__(self, other):\n531:         this_array = self.numpy()\n532: \n533:         if isinstance(other, ANTsImage):\n534:             if not image_physical_space_consistency(self, other):\n535:                 raise ValueError('images do not occupy same physical space')\n536:             other = other.numpy()\n537: \n538:         new_array = this_array < other\n539:         return self.new_image_like(new_array.astype('uint8'))\n540: \n541:     def __le__(self, other):\n542:         this_array = self.numpy()\n543: \n544:         if isinstance(other, ANTsImage):\n545:             if not image_physical_space_consistency(self, other):\n546:                 raise ValueError('images do not occupy same physical space')\n547:             other = other.numpy()\n548: \n549:         new_array = this_array <= other\n550:         return self.new_image_like(new_array.astype('uint8'))\n551: \n552:     def __eq__(self, other):\n553:         this_array = self.numpy()\n554: \n555:         if isinstance(other, ANTsImage):\n556:             if not image_physical_space_consistency(self, other):\n557:                 raise ValueError('images do not occupy same physical space')\n558:             other = other.numpy()\n559: \n560:         new_array = this_array == other\n561:         return self.new_image_like(new_array.astype('uint8'))\n562: \n563:     def __ne__(self, other):\n564:         this_array = self.numpy()\n565: \n566:         if isinstance(other, ANTsImage):\n567:             if not image_physical_space_consistency(self, other):\n568:                 raise ValueError('images do not occupy same physical space')\n569:             other = other.numpy()\n570: \n571:         new_array = this_array != other\n572:         return self.new_image_like(new_array.astype('uint8'))\n573: \n574:     def __getitem__(self, idx):\n575:         if self._array is None:\n576:             self._array = self.numpy()\n577: \n578:         if isinstance(idx, ANTsImage):\n579:             if not image_physical_space_consistency(self, idx):\n580:                 raise ValueError('images do not occupy same physical space')\n581:             return self._array.__getitem__(idx.numpy().astype('bool'))\n582:         else:\n583:             return self._array.__getitem__(idx)\n584: \n585: \n586:     def __setitem__(self, idx, value):\n587:         arr = self.view()\n588:         if isinstance(idx, ANTsImage):\n589:             if not image_physical_space_consistency(self, idx):\n590:                 raise ValueError('images do not occupy same physical space')\n591:             arr.__setitem__(idx.numpy().astype('bool'), value)\n592:         else:\n593:             arr.__setitem__(idx, value)\n594: \n595:     def __repr__(self):\n596:         if self.dimension == 3:\n597:             s = 'ANTsImage ({})\\n'.format(self.orientation)\n598:         else:\n599:             s = 'ANTsImage\\n'\n600:         s = s +\\\n601:             '\\t {:<10} : {} ({})\\n'.format('Pixel Type', self.pixeltype, self.dtype)+\\\n602:             '\\t {:<10} : {}{}\\n'.format('Components', self.components, ' (RGB)' if 'RGB' in self._libsuffix else '')+\\\n603:             '\\t {:<10} : {}\\n'.format('Dimensions', self.shape)+\\\n604:             '\\t {:<10} : {}\\n'.format('Spacing', tuple([round(s,4) for s in self.spacing]))+\\\n605:             '\\t {:<10} : {}\\n'.format('Origin', tuple([round(o,4) for o in self.origin]))+\\