nputStream.use { input ->\n51:             destFile.outputStream().use { output ->\n52:                 input.copyTo(output)\n53:             }\n54:         }\n55: \n56:         DiskUtil.scanMedia(context, destFile.toUri())\n57: \n58:         return destFile.getUriCompat(context)\n59:     }\n60: \n61:     @RequiresApi(Build.VERSION_CODES.Q)\n62:     private fun saveApi29(\n63:         image: Image,\n64:         type: ImageUtil.ImageType,\n65:         filename: String,\n66:         data: () -> InputStream,\n67:     ): Uri {\n68:         val pictureDir =\n69:             MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)\n70: \n71:         val imageLocation = (image.location as Location.Pictures).relativePath\n72:         val relativePath = listOf(\n73:             Environment.DIRECTORY_PICTURES,\n74:             context.stringResource(MR.strings.app_name),\n75:             imageLocation,\n76:         ).joinToString(File.separator)\n77: \n78:         val contentValues = contentValuesOf(\n79:             MediaStore.Images.Media.RELATIVE_PATH to relativePath,\n80:             MediaStore.Images.Media.DISPLAY_NAME to image.name,\n81:             MediaStore.Images.Media.MIME_TYPE to type.mime,\n82:             MediaStore.Images.Media.DATE_MODIFIED to Instant.now().toEpochMilli(),\n83:         )\n84: \n85:         val picture = findUriOrDefault(relativePath, filename) {\n86:             context.contentResolver.insert(\n87:                 pictureDir,\n88:                 contentValues,\n89:             ) ?: throw IOException(context.stringResource(MR.strings.error_saving_picture))\n90:         }\n91: \n92:         try {\n93:             data().use { input ->\n94:                 context.contentResolver.openOutputStream(picture, \"w\").use { output ->\n95:                     input.copyTo(output!!)\n96:                 }\n97:             }\n98:         } catch (e: Exception) {\n99:             logcat(LogPriority.ERROR, e)\n100:             throw IOException(context.stringResource(MR.strings.error_saving_picture))\n101:         }\n102: \n103:         DiskUtil.scanMedia(context, picture)\n104: \n105:         return picture\n106:     }\n107: \n108:     @RequiresApi(Build.VERSION_CODES.Q)\n109:     private fun findUriOrDefault(path: String, filename: String, default: () -> Uri): Uri {\n110:         val projection = arrayOf(\n111:             MediaStore.MediaColumns._ID,\n112:             MediaStore.MediaColumns.DISPLAY_NAME,\n113:             MediaStore.MediaColumns.RELATIVE_PATH,\n114:         )\n115: \n116:         val selection = \"${MediaStore.MediaColumns.RELATIVE_PATH}=? AND ${MediaStore.MediaColumns.DISPLAY_NAME}=?\"\n117: \n118:         // Need to make sure it ends with the separator\n119:         val normalizedPath = \"${path.removeSuffix(File.separator)}${File.separator}\"\n120: \n121:         context.contentResolver.query(\n122:             MediaStore.Images.Media.EXTERNAL_CONTENT_URI,\n123:             projection,\n124:             selection,\n125:             arrayOf(normalizedPath, filename),\n126:             null,\n127:         ).use { cursor ->\n128:             if (cursor != null && cursor.count >= 1) {\n129:                 if (cursor.moveToFirst()) {\n130:                     val id = cursor.getLong(cursor.getColumnIndexOrThrow(MediaStore.MediaColumns._ID))\n131:                     return ContentUris.withAppendedId(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, id)\n132:                 }\n133:             }\n134:         }\n135: \n136:         return default()\n137:     }\n138: }\n139: \n140: sealed class Image(\n141:     open val name: String,\n142:     open val location: Location,\n143: ) {\n144:     data class Cover(\n145:         val bitmap: Bitmap,\n146:         override val name: String,\n147:         override val location: Location,\n148:     ) : Image(name, location)\n149: \n150:     data class Page(\n151:         val inputStream: () -> InputStream,\n152:         override val name: String