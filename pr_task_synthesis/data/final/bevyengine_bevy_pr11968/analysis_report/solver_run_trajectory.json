w_size(\n61:     mut windows: ResMut<Dimensions>,\n62:     mut phase: ResMut<Phase>,\n63:     mut first_complete: Local<bool>,\n64: ) {\n65:     // Put off rendering for one frame, as currently for a frame where\n66:     // resizing happens, nothing is presented.\n67:     // TODO: Debug and fix this if feasible\n68:     if !*first_complete {\n69:         *first_complete = true;\n70:         return;\n71:     }\n72:     let height = windows.height;\n73:     let width = windows.width;\n74:     match *phase {\n75:         ContractingY => {\n76:             if height <= MIN_HEIGHT {\n77:                 *phase = ContractingX;\n78:             } else {\n79:                 windows.height -= RESIZE_STEP;\n80:             }\n81:         }\n82:         ContractingX => {\n83:             if width <= MIN_WIDTH {\n84:                 *phase = ExpandingY;\n85:             } else {\n86:                 windows.width -= RESIZE_STEP;\n87:             }\n88:         }\n89:         ExpandingY => {\n90:             if height >= MAX_HEIGHT {\n91:                 *phase = ExpandingX;\n92:             } else {\n93:                 windows.height += RESIZE_STEP;\n94:             }\n95:         }\n96:         ExpandingX => {\n97:             if width >= MAX_WIDTH {\n98:                 *phase = ContractingY;\n99:             } else {\n100:                 windows.width += RESIZE_STEP;\n101:             }\n102:         }\n103:     }\n104: }\n105: \n106: fn sync_dimensions(dim: Res<Dimensions>, mut windows: Query<&mut Window>) {\n107:     if dim.is_changed() {\n108:         let mut window = windows.single_mut();\n109:         window.resolution.set(dim.width as f32, dim.height as f32);\n110:     }\n111: }\n112: \n113: /// A simple 3d scene, taken from the `3d_scene` example\n114: fn setup_3d(\n115:     mut commands: Commands,\n116:     mut meshes: ResMut<Assets<Mesh>>,\n117:     mut materials: ResMut<Assets<StandardMaterial>>,\n118: ) {\n119:     // plane\n120:     commands.spawn(PbrBundle {\