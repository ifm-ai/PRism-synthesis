            "output": "<path>/workspace/crates/bevy_render/src/camera/camera.rs</path>\n<type>file</type>\n<content>\n1: use crate::{\n2:     camera::CameraProjection,\n3:     camera::{ManualTextureViewHandle, ManualTextureViews},\n4:     prelude::Image,\n5:     primitives::Frustum,\n6:     render_asset::RenderAssets,\n7:     render_graph::{InternedRenderSubGraph, RenderSubGraph},\n8:     render_resource::TextureView,\n9:     view::{ColorGrading, ExtractedView, ExtractedWindows, RenderLayers, VisibleEntities},\n10:     Extract,\n11: };\n12: use bevy_asset::{AssetEvent, AssetId, Assets, Handle};\n13: use bevy_derive::{Deref, DerefMut};\n14: use bevy_ecs::{\n15:     change_detection::DetectChanges,\n16:     component::Component,\n17:     entity::Entity,\n18:     event::EventReader,\n19:     prelude::With,\n20:     reflect::ReflectComponent,\n21:     system::{Commands, Query, Res, ResMut, Resource},\n22: };\n23: use bevy_log::warn;\n24: use bevy_math::{\n25:     primitives::Direction3d, vec2, Mat4, Ray3d, Rect, URect, UVec2, UVec4, Vec2, Vec3,\n26: };\n27: use bevy_reflect::prelude::*;\n28: use bevy_render_macros::ExtractComponent;\n29: use bevy_transform::components::GlobalTransform;\n30: use bevy_utils::{HashMap, HashSet};\n31: use bevy_window::{\n32:     NormalizedWindowRef, PrimaryWindow, Window, WindowCreated, WindowRef, WindowResized,\n33:     WindowScaleFactorChanged,\n34: };\n35: use std::ops::Range;\n36: use wgpu::{BlendState, LoadOp, TextureFormat, TextureUsages};\n37: \n38: use super::{ClearColorConfig, Projection};\n39: \n40: /// Render viewport configuration for the [`Camera`] component.\n41: ///\n42: /// The viewport defines the area on the render target to which the camera renders its image.\n43: /// You can overlay multiple cameras in a single window using viewports to create effects like\n44: /// split screen, minimaps, and character viewers.\n45: #[derive(Reflect, Debug, Clone)]\n46: #[reflect(Default)]\n47: pub struct Viewport {\n48:     /// The physical position to render this viewport to within the [`RenderTarget`] of this [`Camera`].\n49:     /// (0,0) corresponds to the top-left corner\n50:     pub physical_position: UVec2,\n51:     /// The physical size of the viewport rectangle to render to within the [`RenderTarget`] of this [`Camera`].\n52:     /// The origin of the rectangle is in the top-left corner.\n53:     pub physical_size: UVec2,\n54:     /// The minimum and maximum depth to render (on a scale from 0.0 to 1.0).\n55:     pub depth: Range<f32>,\n56: }\n57: \n58: impl Default for Viewport {\n59:     fn default() -> Self {\n60:         Self {\n61:             physical_position: Default::default(),\n62:             physical_size: Default::default(),\n63:             depth: 0.0..1.0,\n64:         }\n65:     }\n66: }\n67: \n68: /// Information about the current [`RenderTarget`].\n69: #[derive(Default, Debug, Clone)]\n70: pub struct RenderTargetInfo {\n71:     /// The physical size of this render target (in physical pixels, ignoring scale factor).\n72:     pub physical_size: UVec2,\n73:     /// The scale factor of this render target.\n74:     ///\n75:     /// When rendering to a window, typically it is a value greater or equal than 1.0,\n76:     /// representing the ratio between the size of the window in physical pixels and the logical size of the window.\n77:     pub scale_factor: f32,\n78: }\n79: \n80: /// Holds internally computed [`Camera`] values.\n81: #[derive(Default, Debug, Clone)]\n82: pub struct ComputedCameraValues {\n83:     projection_matrix: Mat4,\n84:     target_info: Option<RenderTargetInfo>,\n85:     // size of the `Viewport`\n86:     old_viewport_size: Option<UVec2>,\n87: }\n88: \n89: /// How much energy a `Camera3d` absorbs from incoming light.\n90: ///\n91: /// <https://en.wikipedia.org/wiki/Exposure_(photography)>\n92: #[derive(Component, Clone, Copy, Reflect)]\n93: #[reflect_value(Component)]\n94: pub struct Exposure {\n95:     /// <https://en.wikipedia.org/wiki/Exposure_value#Tabulated_exposure_values>\n96:     pub ev100: f32,\n97: }\n98: \n99: impl Exposure {\n100:     pub const SUNLIGHT: Self = Self {\n101:         ev100: Self::EV100_SUNLIGHT,\n102:     };\n103:     pub const OVERCAST: Self = Self {\n104:         ev100: Self::EV100_OVERCAST,\n105:     };\n106:     pub const INDOOR: Self = Self {\n107:         ev100: Self::EV100_INDOOR,\n108:     };\n109:     /// This value was calibrated to match Blender's implicit/default exposure as closely as possible.\n110:     /// It also happens to be a reasonable default.\n111:     ///\n112:     /// See <https://github.com/bevyengine/bevy/issues/11577> for details.\n113:     pub const BLENDER: Self = Self {\n114:         ev100: Self::EV100_BLENDER,\n115:     };\n116: \n117:     pub const EV100_SUNLIGHT: f32 = 15.0;\n118:     pub const EV100_OVERCAST: f32 = 12.0;\n119:     pub const EV100_INDOOR: f32 = 7.0;\n120: \n121:     /// This value was calibrated to match Blender's implicit/default exposure as closely as possible.\n122:     /// It also happens to be a reasonable default.\n123:     ///\n124:     /// See <https://github.com/bevyengine/bevy/issues/11577> for details.\n125:     pub const EV100_BLENDER: f32 = 9.7;\n126: \n127:     pub fn from_physical_camera(physical_camera_parameters: PhysicalCameraParameters) -> Self {\n128:         Self {\n129:             ev100: physical_camera_parameters.ev100(),\n130:         }\n131:     }\n132: \n133:     /// Converts EV100 values to exposure values.\n134:     /// <https://google.github.io/filament/Filament.md.html#imagingpipeline/physicallybasedcamera/exposure>\n135:     #[inline]\n136:     pub fn exposure(&self) -> f32 {\n137:         (-self.ev100).exp2() / 1.2\n138:     }\n139: }\n140: \n141: impl Default for Exposure {\n142:     fn default() -> Self {\n143:         Self::BLENDER\n144:     }\n145: }\n146: \n147: /// Parameters based on physical camera characteristics for calculating\n148: /// EV100 values for use with [`Exposure`].\n149: #[derive(Clone, Copy)]\n150: pub struct PhysicalCameraParameters {\n151:     /// <https://en.wikipedia.org/wiki/F-number>\n152:     pub aperture_f_stops: f32,\n153:     /// <https://en.wikipedia.org/wiki/Shutter_speed>\n154:     pub shutter_speed_s: f32,\n155:     /// <https://en.wikipedia.org/wiki/Film_speed>\n156:     pub sensitivity_iso: f32,\n157: }\n158: \n159: impl PhysicalCameraParameters {\n160:     /// Calculate the [EV100](https://en.wikipedia.org/wiki/Exposure_value).\n161:     pub fn ev100(&self) -> f32 {\n162:         (self.aperture_f_stops * self.aperture_f_stops * 100.0\n163:             / (self.shutter_speed_s * self.sensitivity_iso))\n164:             .log2()\n165:     }\n166: }\n167: \n168: impl Default for PhysicalCameraParameters {\n169:     fn default() -> Self {\n170:         Self {\n171:             aperture_f_stops: 1.0,\n172:             shutter_speed_s: 1.0 / 125.0,\n173:             sensitivity_iso: 100.0,\n174:         }\n175:     }\n176: }\n177: \n178: /// The defining [`Component`] for camera entities,\n179: /// storing information about how and what to render through this camera.\n180: ///\n181: /// The [`Camera`] component is added to an entity to define the properties of the viewpoint from\n182: /// which rendering occurs. It defines the position of the view to render, the projection method\n183: /// to transform the 3D objects into a 2D image, as well as the render target into which that image\n184: /// is produced.\n185: ///\n186: /// Adding a camera is typically done by adding a bundle, either the `Camera2dBundle` or the\n187: /// `Camera3dBundle`.\n188: #[derive(Component, Debug, Reflect, Clone)]\n189: #[reflect(Component)]\n190: pub struct Camera {\n191:     /// If set, this camera will render to the given [`Viewport`] rectangle within the configured [`RenderTarget`].\n192:     pub viewport: Option<Viewport>,\n193:     /// Cameras with a higher order are rendered later, and thus on top of lower order cameras.\n194:     pub order: isize,\n195:     /// If this is set to `true`, this camera will be rendered to its specified [`RenderTarget`]. If `false`, this\n196:     /// camera will not be rendered.\n197:     pub is_active: bool,\n198:     /// Computed values for this camera, such as the projection matrix and the render target size.\n199:     #[reflect(ignore)]\n200:     pub computed: ComputedCameraValues,\n201:     /// The \"target\" that this camera will render to.\n202:     #[reflect(ignore)]\n203:     pub target: RenderTarget,\n204:     /// If this is set to `true`, the camera will use an intermediate \"high dynamic range\" render texture.\n205:     /// This allows rendering with a wider range of lighting values.\n206:     pub hdr: bool,\n207:     // todo: reflect this when #6042 lands\n208:     /// The [`CameraOutputMode`] for this camera.\n209:     #[reflect(ignore)]\n210:     pub output_mode: CameraOutputMode,\n211:     /// If this is enabled, a previous camera exists that shares this camera's render target, and this camera has MSAA enabled, then the previous camera's\n212:     /// outputs will be written to the intermediate multi-sampled render target textures for this camera. This enables cameras with MSAA enabled to\n213:     /// \"write their results on top\" of previous camera results, and include them as a part of their render results. This is enabled by default to ensure\n214:     /// cameras with MSAA enabled layer their results in the same way as cameras without MSAA enabled by default.\n215:     pub msaa_writeback: bool,\n216:     /// The clear color operation to perform on the render target.\n217:     pub clear_color: ClearColorConfig,\n218: }\n219: \n220: impl Default for Camera {\n221:     fn default() -> Self {\n222:         Self {\n223:             is_active: true,\n224:             order: 0,\n225:             viewport: None,\n226:             computed: Default::default(),\n227:             target: Default::default(),\n228:             output_mode: Default::default(),\n229:             hdr: false,\n230:             msaa_writeback: true,\n231:             clear_color: Default::default(),\n232:         }\n233:     }\n234: }\n235: \n236: impl Camera {\n237:     /// Converts a physical size in this `Camera` to a logical size.\n238:     #[inline]\n239:     pub fn to_logical(&self, physical_size: UVec2) -> Option<Vec2> {\n240:         let scale = self.computed.target_info.as_ref()?.scale_factor;\n241:         Some(physical_size.as_vec2() / scale)\n242:     }\n243: \n244:     /// The rendered physical bounds [`URect`] of the camera. If the `viewport` field is\n245:     /// set to [`Some`], this will be the rect of that custom viewport. Otherwise it will default to\n246:     /// the full physical rect of the current [`RenderTarget`].\n247:     #[inline]\n248:     pub fn physical_viewport_rect(&self) -> Option<URect> {\n249:         let min = self\n250:             .viewport\n251:             .as_ref()\n252:             .map(|v| v.physical_position)\n253:             .unwrap_or(UVec2::ZERO);\n254:         let max = min + self.physical_viewport_size()?;\n255:         Some(URect { min, max })\n256:     }\n257: \n258:     /// The rendered logical bounds [`Rect`] of the camera. If the `viewport` field is set to\n259:     /// [`Some`], this will be the rect of that custom viewport. Otherwise it will default to the\n260:     /// full logical rect of the current [`RenderTarget`].\n261:     #[inline]\n262:     pub fn logical_viewport_rect(&self) -> Option<Rect> {\n263:         let URect { min, max } = self.physical_viewport_rect()?;\n264:         Some(Rect {\n265:             min: self.to_logical(min)?,\n266:             max: self.to_logical(max)?,\n267:         })\n268:     }\n269: \n270:     /// The logical size of this camera's viewport. If the `viewport` field is set to [`Some`], this\n271:     /// will be the size of that custom viewport. Otherwise it will default to the full logical size\n272:     /// of the current [`RenderTarget`].\n273:     ///  For logic that requires the full logical size of the\n274:     /// [`RenderTarget`], prefer [`Camera::logical_target_size`].\n275:     ///\n276:     /// Returns `None` if either:\n277:     /// - the function is called just after the `Camera` is created, before `camera_system` is executed,\n278:     /// - the [`RenderTarget`] isn't correctly set:\n279:     ///   - it references the [`PrimaryWindow`](RenderTarget::Window) when there is none,\n280:     ///   - it references a [`Window`](RenderTarget::Window) entity that doesn't exist or doesn't actually have a `Window` component,\n281:     ///   - it references an [`Image`](RenderTarget::Image) that doesn't exist (invalid handle),\n282:     ///   - it references a [`TextureView`](RenderTarget::TextureView) that doesn't exist (invalid handle).\n283:     #[inline]\n284:     pub fn logical_viewport_size(&self) -> Option<Vec2> {\n285:         self.viewport\n286:             .as_ref()\n287:             .and_then(|v| self.to_logical(v.physical_size))\n288:             .or_else(|| self.logical_target_size())\n289:     }\n290: \n291:     /// The physical size of this camera's viewport (in physical pixels).\n292:     /// If the `viewport` field is set to [`Some`], this\n293:     /// will be the size of that custom viewport. Otherwise it will default to the full physical size of\n294:     /// the current [`RenderTarget`].\n295:     /// For logic that requires the full physical size of the [`RenderTarget`], prefer [`Camera::physical_target_size`].\n296:     #[inline]\n297:     pub fn physical_viewport_size(&self) -> Option<UVec2> {\n298:         self.viewport\n299:             .as_ref()\n300:             .map(|v| v.physical_size)\n301:             .or_else(|| self.physical_target_size())\n302:     }\n303: \n304:     /// The full logical size of this camera's [`RenderTarget`], ignoring custom `viewport` configuration.\n305:     /// Note that if the `viewport` field is [`Some`], this will not represent the size of the rendered area.\n306:     /// For logic that requires the size of the actually rendered area, prefer [`Camera::logical_viewport_size`].\n307:     #[inline]\n308:     pub fn logical_target_size(&self) -> Option<Vec2> {\n309:         self.computed\n310:             .target_info\n311:             .as_ref()\n312:             .and_then(|t| self.to_logical(t.physical_size))\n313:     }\n314: \n315:     /// The full physical size of this camera's [`RenderTarget`] (in physical pixels),\n316:     /// ignoring custom `viewport` configuration.\n317:     /// Note that if the `viewport` field is [`Some`], this will not represent the size of the rendered area.\n318:     /// For logic that requires the size of the actually rendered area, prefer [`Camera::physical_viewport_size`].\n319:     #[inline]\n320:     pub fn physical_target_size(&self) -> Option<UVec2> {\n321:         self.computed.target_info.as_ref().map(|t| t.physical_size)\n322:     }\n323: \n324:     #[inline]\n325:     pub fn target_scaling_factor(&self) -> Option<f32> {\n326:         self.computed.target_info.as_ref().map(|t| t.scale_factor)\n327:     }\n328: \n329:     /// The projection matrix computed using this camera's [`CameraProjection`].\n330:     #[inline]\n331:     pub fn projection_matrix(&self) -> Mat4 {\n332:         self.computed.projection_matrix\n333:     }\n334: \n335:     /// Given a position in world space, use the camera to compute the viewport-space coordinates.\n336:     ///\n337:     /// To get the coordinates in Normalized Device Coordinates, you should use\n338:     /// [`world_to_ndc`](Self::world_to_ndc).\n339:     ///\n340:     /// Returns `None` if any of these conditions occur:\n341:     /// - The computed coordinates are beyond the near or far plane\n342:     /// - The logical viewport size cannot be computed. See [`logical_viewport_size`](Camera::logical_viewport_size)\n343:     /// - The world coordinates cannot be mapped to the Normalized Device Coordinates. See [`world_to_ndc`](Camera::world_to_ndc)\n344:     /// May also panic if `glam_assert` is enabled. See [`world_to_ndc`](Camera::world_to_ndc).\n345:     #[doc(alias = \"world_to_screen\")]\n346:     pub fn world_to_viewport(\n347:         &self,\n348:         camera_transform: &GlobalTransform,\n349:         world_position: Vec3,\n350:     ) -> Option<Vec2> {\n351:         let target_size = self.logical_viewport_size()?;\n352:         let ndc_space_coords = self.world_to_ndc(camera_transform, world_position)?;\n353:         // NDC z-values outside of 0 < z < 1 are outside the (implicit) camera frustum and are thus not in viewport-space\n354:         if ndc_space_coords.z < 0.0 || ndc_space_coords.z > 1.0 {\n355:             return None;\n356:         }\n357: \n358:         // Once in NDC space, we can discard the z element and rescale x/y to fit the screen\n359:         let mut viewport_position = (ndc_space_coords.truncate() + Vec2::ONE) / 2.0 * target_size;\n360:         // Flip the Y co-ordinate origin from the bottom to the top.\n361:         viewport_position.y = target_size.y - viewport_position.y;\n362:         Some(viewport_position)\n363:     }\n364: \n365:     /// Returns a ray originating from the camera, that passes through everything beyond `viewport_position`.\n366:     ///\n367:     /// The resulting ray starts on the near plane of the camera.\n368:     ///\n369:     /// If the camera's projection is orthographic the direction of the ray is always equal to `camera_transform.forward()`.\n370:     ///\n371:     /// To get the world space coordinates with Normalized Device Coordinates, you should use\n372:     /// [`ndc_to_world`](Self::ndc_to_world).\n373:     ///\n374:     /// Returns `None` if any of these conditions occur:\n375:     /// - The logical viewport size cannot be computed. See [`logical_viewport_size`](Camera::logical_viewport_size)\n376:     /// - The near or far plane cannot be computed. This can happen if the `camera_transform`, the `world_position`, or the projection matrix defined by [`CameraProjection`] contain `NAN`.\n377:     /// Panics if the projection matrix is null and `glam_assert` is enabled.\n378:     pub fn viewport_to_world(\n379:         &self,\n380:         camera_transform: &GlobalTransform,\n381:         mut viewport_position: Vec2,\n382:     ) -> Option<Ray3d> {\n383:         let target_size = self.logical_viewport_size()?;\n384:         // Flip the Y co-ordinate origin from the top to the bottom.\n385:         viewport_position.y = target_size.y - viewport_position.y;\n386:         let ndc = viewport_position * 2. / target_size - Vec2::ONE;\n387: \n388:         let ndc_to_world =\n389:             camera_transform.compute_matrix() * self.computed.projection_matrix.inverse();\n390:         let world_near_plane = ndc_to_world.project_point3(ndc.extend(1.));\n391:         // Using EPSILON because an ndc with Z = 0 returns NaNs.\n392:         let world_far_plane = ndc_to_world.project_point3(ndc.extend(f32::EPSILON));\n393: \n394:         // The fallible direction constructor ensures that world_near_plane and world_far_plane aren't NaN.\n395:         Direction3d::new(world_far_plane - world_near_plane).map_or(None, |direction| {\n396:             Some(Ray3d {\n397:                 origin: world_near_plane,\n398:                 direction,\n399:             })\n400:         })\n401:     }\n402: \n403:     /// Returns a 2D world position computed from a position on this [`Camera`]'s viewport.\n404:     ///\n405:     /// Useful for 2D cameras and other cameras with an orthographic projection pointing along the Z axis.\n406:     ///\n407:     /// To get the world space coordinates with Normalized Device Coordinates, you should use\n408:     /// [`ndc_to_world`](Self::ndc_to_world).\n409:     ///\n410:     /// Returns `None` if any of these conditions occur:\n411:     /// - The logical viewport size cannot be computed. See [`logical_viewport_size`](Camera::logical_viewport_size)\n412:     /// - The viewport position cannot be mapped to the world. See [`ndc_to_world`](Camera::ndc_to_world)\n413:     /// May panic. See [`ndc_to_world`](Camera::ndc_to_world).\n414:     pub fn viewport_to_world_2d(\n415:         &self,\n416:         camera_transform: &GlobalTransform,\n417:         mut viewport_position: Vec2,\n418:     ) -> Option<Vec2> {\n419:         let target_size = self.logical_viewport_size()?;\n420:         // Flip the Y co-ordinate origin from the top to the bottom.\n421:         viewport_position.y = target_size.y - viewport_position.y;\n422:         let ndc = viewport_position * 2. / target_size - Vec2::ONE;\n423: \n424:         let world_near_plane = self.ndc_to_world(camera_transform, ndc.extend(1.))?;\n425: \n426:         Some(world_near_plane.truncate())\n427:     }\n428: \n429:     /// Given a position in world space, use the camera's viewport to compute the Normalized Device Coordinates.\n430:     ///\n431:     /// When the position is within the viewport the values returned will be between -1.0 and 1.0 on the X and Y axes,\n432:     /// and between 0.0 and 1.0 on the Z axis.\n433:     /// To get the coordinates in the render target's viewport dimensions, you should use\n434:     /// [`world_to_viewport`](Self::world_to_viewport).\n435:     ///\n436:     /// Returns `None` if the `camera_transform`, the `world_position`, or the projection matrix defined by [`CameraProjection`] contain `NAN`.\n437:     /// Panics if the `camera_transform` contains `NAN` and the `glam_assert` feature is enabled.\n438:     pub fn world_to_ndc(\n439:         &self,\n440:         camera_transform: &GlobalTransform,\n441:         world_position: Vec3,\n442:     ) -> Option<Vec3> {\n443:         // Build a transformation matrix to convert from world space to NDC using camera data\n444:         let world_to_ndc: Mat4 =\n445:             self.computed.projection_matrix * camera_transform.compute_matrix().inverse();\n446:         let ndc_space_coords: Vec3 = world_to_ndc.project_point3(world_position);\n447: \n448:         (!ndc_space_coords.is_nan()).then_some(ndc_space_coords)\n449:     }\n450: \n451:     /// Given a position in Normalized Device Coordinates,\n452:     /// use the camera's viewport to compute the world space position.\n453:     ///\n454:     /// When the position is within the viewport the values returned will be between -1.0 and 1.0 on the X and Y axes,\n455:     /// and between 0.0 and 1.0 on the Z axis.\n456:     /// To get the world space coordinates with the viewport position, you should use\n457:     /// [`world_to_viewport`](Self::world_to_viewport).\n458:     ///\n459:     /// Returns `None` if the `camera_transform`, the `world_position`, or the projection matrix defined by [`CameraProjection`] contain `NAN`.\n460:     /// Panics if the projection matrix is null and `glam_assert` is enabled.\n461:     pub fn ndc_to_world(&self, camera_transform: &GlobalTransform, ndc: Vec3) -> Option<Vec3> {\n462:         // Build a transformation matrix to convert from NDC to world space using camera data\n463:         let ndc_to_world =\n464:             camera_transform.compute_matrix() * self.computed.projection_matrix.inverse();\n465: \n466:         let world_space_coords = ndc_to_world.project_point3(ndc);\n467: \n468:         (!world_space_coords.is_nan()).then_some(world_space_coords)\n469:     }\n470: }\n471: \n472: /// Control how this camera outputs once rendering is completed.\n473: #[derive(Debug, Clone, Copy)]\n474: pub enum CameraOutputMode {\n475:     /// Writes the camera output to configured render target.\n476:     Write {\n477:         /// The blend state that will be used by the pipeline that writes the intermediate render textures to the final render target texture.\n478:         blend_state: Option<BlendState>,\n479:         /// The color attachment load operation that will be used by the pipeline that writes the intermediate render textures to the final render\n480:         /// target texture.\n481:         color_attachment_load_op: LoadOp<wgpu::Color>,\n482:     },\n483:     /// Skips writing the camera output to the configured render target. The output will remain in the\n484:     /// Render Target's \"intermediate\" textures, which a camera with a higher order should write to the render target\n485:     /// using [`CameraOutputMode::Write`]. The \"skip\" mode can easily prevent render results from being displayed, or cause\n486:     /// them to be lost. Only use this if you know what you are doing!\n487:     /// In camera setups with multiple active cameras rendering to the same RenderTarget, the Skip mode can be used to remove\n488:     /// unnecessary / redundant writes to the final output texture, removing unnecessary render passes.\n489:     Skip,\n490: }\n491: \n492: impl Default for CameraOutputMode {\n493:     fn default() -> Self {\n494:         CameraOutputMode::Write {\n495:             blend_state: None,\n496:             color_attachment_load_op: LoadOp::Clear(Default::default()),\n497:         }\n498:     }\n499: }\n500: \n501: /// Configures the [`RenderGraph`](crate::render_graph::RenderGraph) name assigned to be run for a given [`Camera`] entity.\n502: #[derive(Component, Deref, DerefMut, Reflect, Clone)]\n503: #[reflect_value(Component)]\n504: pub struct CameraRenderGraph(InternedRenderSubGraph);\n505: \n506: impl CameraRenderGraph {\n507:     /// Creates a new [`CameraRenderGraph`] from any string-like type.\n508:     #[inline]\n509:     pub fn new<T: RenderSubGraph>(name: T) -> Self {\n510:         Self(name.intern())\n511:     }\n512: \n513:     /// Sets the graph name.\n514:     #[inline]\n515:     pub fn set<T: RenderSubGraph>(&mut self, name: T) {\n516:         self.0 = name.intern();\n517:     }\n518: }\n519: \n520: /// The \"target\" that a [`Camera`] will render to. For example, this could be a [`Window`]\n521: /// swapchain or an [`Image`].\n522: #[derive(Debug, Clone, Reflect)]\n523: pub enum RenderTarget {\n524:     /// Window to which the camera's view is rendered.\n525:     Window(WindowRef),\n526:     /// Image to which the camera's view is rendered.\n527:     Image(Handle<Image>),\n528:     /// Texture View to which the camera's view is rendered.\n529:     /// Useful when the texture view needs to be created outside of Bevy, for example OpenXR.\n530:     TextureView(ManualTextureViewHandle),\n531: }\n532: \n533: impl From<Handle<Image>> for RenderTarget {\n534:     fn from(handle: Handle<Image>) -> Self {\n535:         Self::Image(handle)\n536:     }\n537: }\n538: \n539: /// Normalized version of the render target.\n540: ///\n541: /// Once we have this we shouldn't need to resolve it down anymore.\n542: #[derive(Debug, Clone, Reflect, PartialEq, Eq, Hash, PartialOrd, Ord)]\n543: pub enum NormalizedRenderTarget {\n544:     /// Window to which the camera's view is rendered.\n545:     Window(NormalizedWindowRef),\n546:     /// Image to which the camera's view is rendered.\n547:     Image(Handle<Image>),\n548:     /// Texture View to which the camera's view is rendered.\n549:     /// Useful when the texture view needs to be created outside of Bevy, for example OpenXR.\n550:     TextureView(ManualTextureViewHandle),\n551: }\n552: \n553: impl Default for RenderTarget {\n554:     fn default() -> Self {\n555:         Self::Window(Default::default())\n556:     }\n557: }\n558: \n559: impl RenderTarget {\n560:     /// Normalize the render target down to a more concrete value, mostly used for equality comparisons.\n561:     pub fn normalize(&self, primary_window: Option<Entity>) -> Option<NormalizedRenderTarget> {\n562:         match self {\n563:             RenderTarget::Window(window_ref) => window_ref\n564:                 .normalize(primary_window)\n565:                 .map(NormalizedRenderTarget::Window),\n566:             RenderTarget::Image(handle) => Some(NormalizedRenderTarget::Image(handle.clone())),\n567:             RenderTarget::TextureView(id) => Some(NormalizedRenderTarget::TextureView(*id)),\n568:         }\n569:     }\n570: \n571:     /// Get a handle to the render target's image,\n572:     /// or `None` if the render target is another variant.\n573:     pub fn as_image(&self) -> Option<&Handle<Image>> {\n574:         if let Self::Image(handle) = self {\n575:             Some(handle)\n576:         } else {\n577:             None\n578:         }\n579:     }\n580: }\n581: \n582: impl NormalizedRenderTarget {\n583:     pub fn get_texture_view<'a>(\n584:         &self,\n585:         windows: &'a ExtractedWindows,\n586:         images: &'a RenderAssets<Image>,\n587:         manual_texture_views: &'a ManualTextureViews,\n588:     ) -> Option<&'a TextureView> {\n589:         match self {\n590:             NormalizedRenderTarget::Window(window_ref) => windows\n591:                 .get(&window_ref.entity())\n592:                 .and_then(|window| window.swap_chain_texture_view.as_ref()),\n593:             NormalizedRenderTarget::Image(image_handle) => {\n594:                 images.get(image_handle).map(|image| &image.texture_view)\n595:             }\n596:             NormalizedRenderTarget::TextureView(id) => {\n597:                 manual_texture_views.get(id).map(|tex| &tex.texture_view)\n598:             }\n599:         }\n600:     }\n601: \n602:     /// Retrieves the [`TextureFormat`] of this render target, if it exists.\n603:     pub fn get_texture_format<'a>(\n604:         &self,\n605:         windows: &'a ExtractedWindows,\n606:         images: &'a RenderAssets<Image>,\n607:         manual_texture_views: &'a ManualTextureViews,\n608:     ) -> Option<TextureFormat> {\n609:         match self {\n610:             NormalizedRenderTarget::Window(window_ref) => windows\n611:                 .get(&window_ref.entity())\n612:                 .and_then(|window| window.swap_chain_texture_format),\n613:             NormalizedRenderTarget::Image(image_handle) => {\n614:                 images.get(image_handle).map(|image| image.texture_format)\n615:             }\n616:             NormalizedRenderTarget::TextureView(id) => {\n617:                 manual_texture_views.get(id).map(|tex| tex.format)\n618:             }\n619:         }\n620:     }\n621: \n622:     pub fn get_render_target_info<'a>(\n623:         &self,\n624:         resolutions: impl IntoIterator<Item = (Entity, &'a Window)>,\n625:         images: &Assets<Image>,\n626:         manual_texture_views: &ManualTextureViews,\n627:     ) -> Option<RenderTargetInfo> {\n628:         match self {\n629:             NormalizedRenderTarget::Window(window_ref) => resolutions\n630:                 .into_iter()\n631:                 .find(|(entity, _)| *entity == window_ref.entity())\n632:                 .map(|(_, window)| RenderTargetInfo {\n633:                     physical_size: UVec2::new(\n634:                         window.resolution.physical_width(),\n635:                         window.resolution.physical_height(),\n636:                     ),\n637:                     scale_factor: window.resolution.scale_factor(),\n638:                 }),\n639:             NormalizedRenderTarget::Image(image_handle) => {\n640:                 let image = images.get(image_handle)?;\n641:                 Some(RenderTargetInfo {\n642:                     physical_size: image.size(),\n643:                     scale_factor: 1.0,\n644:                 })\n645:             }\n646:             NormalizedRenderTarget::TextureView(id) => {\n647:                 manual_texture_views.get(id).map(|tex| RenderTargetInfo {\n648:                     physical_size: tex.size,\n649:                     scale_factor: 1.0,\n650:                 })\n651:             }\n652:         }\n653:     }\n654: \n655:     // Check if this render target is contained in the given changed windows or images.\n656:     fn is_changed(\n657:         &self,\n658:         changed_window_ids: &HashSet<Entity>,\n659:         changed_image_handles: &HashSet<&AssetId<Image>>,\n660:     ) -> bool {\n661:         match self {\n662:             NormalizedRenderTarget::Window(window_ref) => {\n663:                 changed_window_ids.contains(&window_ref.entity())\n664:             }\n665:             NormalizedRenderTarget::Image(image_handle) => {\n666:                 changed_image_handles.contains(&image_handle.id())\n667:             }\n668:             NormalizedRenderTarget::TextureView(_) => true,\n669:         }\n670:     }\n671: }\n672: \n673: /// System in charge of updating a [`Camera`] when its window or projection changes.\n674: ///\n675: /// The system detects window creation, resize, and scale factor change events to update the camera\n676: /// projection if needed. It also queries any [`CameraProjection`] component associated with the same\n677: /// entity as the [`Camera`] one, to automatically update the camera projection matrix.\n678: ///\n679: /// The system function is generic over the camera projection type, and only instances of\n680: /// [`OrthographicProjection`] and [`PerspectiveProjection`] are automatically added to\n681: /// the app, as well as the runtime-selected [`Projection`].\n682: /// The system runs during [`PostUpdate`](bevy_app::PostUpdate).\n683: ///\n684: /// ## World Resources\n685: ///\n686: /// [`Res<Assets<Image>>`](Assets<Image>) -- For cameras that render to an image, this resource is used to\n687: /// inspect information about the render target. This system will not access any other image assets.\n688: ///\n689: /// [`OrthographicProjection`]: crate::camera::OrthographicProjection\n690: /// [`PerspectiveProjection`]: crate::camera::PerspectiveProjection\n691: #[allow(clippy::too_many_arguments)]\n692: pub fn camera_system<T: CameraProjection + Component>(\n693:     mut window_resized_events: EventReader<WindowResized>,\n694:     mut window_created_events: EventReader<WindowCreated>,\n695:     mut window_scale_factor_changed_events: EventReader<WindowScaleFactorChanged>,\n696:     mut image_asset_events: EventReader<AssetEvent<Image>>,\n697:     primary_window: Query<Entity, With<PrimaryWindow>>,\n698:     windows: Query<(Entity, &Window)>,\n699:     images: Res<Assets<Image>>,\n700:     manual_texture_views: Res<ManualTextureViews>,\n701:     mut cameras: Query<(&mut Camera, &mut T)>,\n702: ) {\n703:     let primary_window = primary_window.iter().next();\n704: \n705:     let mut changed_window_ids = HashSet::new();\n706:     changed_window_ids.extend(window_created_events.read().map(|event| event.window));\n707:     changed_window_ids.extend(window_resized_events.read().map(|event| event.window));\n708:     let scale_factor_changed_window_ids: HashSet<_> = window_scale_factor_changed_events\n709:         .read()\n710:         .map(|event| event.window)\n711:         .collect();\n712:     changed_window_ids.extend(scale_factor_changed_window_ids.clone());\n713: \n714:     let changed_image_handles: HashSet<&AssetId<Image>> = image_asset_events\n715:         .read()\n716:         .filter_map(|event| match event {\n717:             AssetEvent::Modified { id } | AssetEvent::Added { id } => Some(id),\n718:             _ => None,\n719:         })\n720:         .collect();\n721: \n722:     for (mut camera, mut camera_projection) in &mut cameras {\n723:         let mut viewport_size = camera\n724:             .viewport\n725:             .as_ref()\n726:             .map(|viewport| viewport.physical_size);\n727: \n728:         if let Some(normalized_target) = camera.target.normalize(primary_window) {\n729:             if normalized_target.is_changed(&changed_window_ids, &changed_image_handles)\n730:                 || camera.is_added()\n731:                 || camera_projection.is_changed()\n732:                 || camera.computed.old_viewport_size != viewport_size\n733:             {\n734:                 let new_computed_target_info = normalized_target.get_render_target_info(\n735:                     &windows,\n736:                     &images,\n737:                     &manual_texture_views,\n738:                 );\n739:                 // Check for the scale factor changing, and resize the viewport if needed.\n740:                 // This can happen when the window is moved between monitors with different DPIs.\n741:                 // Without this, the viewport will take a smaller portion of the window moved to\n742:                 // a higher DPI monitor.\n743:                 if normalized_target.is_changed(&scale_factor_changed_window_ids, &HashSet::new()) {\n744:                     if let (Some(new_scale_factor), Some(old_scale_factor)) = (\n745:                         new_computed_target_info\n746:                             .as_ref()\n747:                             .map(|info| info.scale_factor),\n748:                         camera\n749:                             .computed\n750:                             .target_info\n751:                             .as_ref()\n752:                             .map(|info| info.scale_factor),\n753:                     ) {\n754:                         let resize_factor = new_scale_factor / old_scale_factor;\n755:                         if let Some(ref mut viewport) = camera.viewport {\n756:                             let resize = |vec: UVec2| (vec.as_vec2() * resize_factor).as_uvec2();\n757:                             viewport.physical_position = resize(viewport.physical_position);\n758:                             viewport.physical_size = resize(viewport.physical_size);\n759:                             viewport_size = Some(viewport.physical_size);\n760:                         }\n761:                     }\n762:                 }\n763:                 camera.computed.target_info = new_computed_target_info;\n764:                 if let Some(size) = camera.logical_viewport_size() {\n765:                     camera_projection.update(size.x, size.y);\n766:                     camera.computed.projection_matrix = camera_projection.get_projection_matrix();\n767:                 }\n768:             }\n769:         }\n770: \n771:         if ca