            "output": "<path>/workspace/examples/3d/split_screen.rs</path>\n<type>file</type>\n<content>\n1: //! Renders two cameras to the same window to accomplish \"split screen\".\n2: \n3: use std::f32::consts::PI;\n4: \n5: use bevy::{\n6:     pbr::CascadeShadowConfigBuilder, prelude::*, render::camera::Viewport, window::WindowResized,\n7: };\n8: \n9: fn main() {\n10:     App::new()\n11:         .add_plugins(DefaultPlugins)\n12:         .add_systems(Startup, setup)\n13:         .add_systems(Update, (set_camera_viewports, button_system))\n14:         .run();\n15: }\n16: \n17: /// set up a simple 3D scene\n18: fn setup(\n19:     mut commands: Commands,\n20:     asset_server: Res<AssetServer>,\n21:     mut meshes: ResMut<Assets<Mesh>>,\n22:     mut materials: ResMut<Assets<StandardMaterial>>,\n23: ) {\n24:     // plane\n25:     commands.spawn(PbrBundle {\n26:         mesh: meshes.add(Plane3d::default().mesh().size(100.0, 100.0)),\n27:         material: materials.add(Color::rgb(0.3, 0.5, 0.3)),\n28:         ..default()\n29:     });\n30: \n31:     commands.spawn(SceneBundle {\n32:         scene: asset_server.load(\"models/animated/Fox.glb#Scene0\"),\n33:         ..default()\n34:     });\n35: \n36:     // Light\n37:     commands.spawn(DirectionalLightBundle {\n38:         transform: Transform::from_rotation(Quat::from_euler(EulerRot::ZYX, 0.0, 1.0, -PI / 4.)),\n39:         directional_light: DirectionalLight {\n40:             shadows_enabled: true,\n41:             ..default()\n42:         },\n43:         cascade_shadow_config: CascadeShadowConfigBuilder {\n44:             num_cascades: 2,\n45:             first_cascade_far_bound: 200.0,\n46:             maximum_distance: 280.0,\n47:             ..default()\n48:         }\n49:         .into(),\n50:         ..default()\n51:     });\n52: \n53:     // Left Camera\n54:     let left_camera = commands\n55:         .spawn((\n56:             Camera3dBundle {\n57:                 transform: Transform::from_xyz(0.0, 200.0, -100.0).looking_at(Vec3::ZERO, Vec3::Y),\n58:                 ..default()\n59:             },\n60:             LeftCamera,\n61:         ))\n62:         .id();\n63: \n64:     // Right Camera\n65:     let right_camera = commands\n66:         .spawn((\n67:             Camera3dBundle {\n68:                 transform: Transform::from_xyz(100.0, 100., 150.0).looking_at(Vec3::ZERO, Vec3::Y),\n69:                 camera: Camera {\n70:                     // Renders the right camera after the left camera, which has a default priority of 0\n71:                     order: 1,\n72:                     // don't clear on the second camera because the first camera already cleared the window\n73:                     clear_color: ClearColorConfig::None,\n74:                     ..default()\n75:                 },\n76:                 ..default()\n77:             },\n78:             RightCamera,\n79:         ))\n80:         .id();\n81: \n82:     // Set up UI\n83:     commands\n84:         .spawn((\n85:             TargetCamera(left_camera),\n86:             NodeBundle {\n87:                 style: Style {\n88:                     width: Val::Percent(100.),\n89:                     height: Val::Percent(100.),\n90:                     ..default()\n91:                 },\n92:                 ..default()\n93:             },\n94:         ))\n95:         .with_children(|parent| {\n96:             parent.spawn(TextBundle::from_section(\n97:                 \"Left\",\n98:                 TextStyle {\n99:                     font_size: 20.,\n100:                     ..default()\n101:                 },\n102:             ));\n103:             buttons_panel(parent);\n104:         });\n105: \n106:     commands\n107:         .spawn((\n108:             TargetCamera(right_camera),\n109:             NodeBundle {\n110:                 style: Style {\n111:                     width: Val::Percent(100.),\n112:                     height: Val::Percent(100.),\n113:                     ..default()\n114:                 },\n115:                 ..default()\n116:             },\n117:         ))\n118:         .with_children(|parent| {\n119:             parent.spawn(TextBundle::from_section(\n120:                 \"Right\",\n121:                 TextStyle {\n122:                     font_size: 20.,\n123:                     ..default()\n124:                 },\n125:             ));\n126:             buttons_panel(parent);\n127:         });\n128: \n129:     fn buttons_panel(parent: &mut ChildBuilder) {\n130:         parent\n131:             .spawn(NodeBundle {\n132:                 style: Style {\n133:                     position_type: PositionType::Absolute,\n134:                     width: Val::Percent(100.),\n135:                     height: Val::Percent(100.),\n136:                     display: Display::Flex,\n137:                     flex_direction: FlexDirection::Row,\n138:                     justify_content: JustifyContent::SpaceBetween,\n139:                     align_items: AlignItems::Center,\n140:                     padding: UiRect::all(Val::Px(20.)),\n141:                     ..default()\n142:                 },\n143:                 ..default()\n144:             })\n145:             .with_children(|parent| {\n146:                 rotate_button(parent, \"<\", Direction::Left);\n147:                 rotate_button(parent, \">\", Direction::Right);\n148:             });\n149:     }\n150: \n151:     fn rotate_button(parent: &mut ChildBuilder, caption: &str, direction: Direction) {\n152:         parent\n153:             .spawn((\n154:                 RotateCamera(direction),\n155:                 ButtonBundle {\n156:                     style: Style {\n157:                         width: Val::Px(40.),\n158:                         height: Val::Px(40.),\n159:                         border: UiRect::all(Val::Px(2.)),\n160:                         justify_content: JustifyContent::Center,\n161:                         align_items: AlignItems::Center,\n162:                         ..default()\n163:                     },\n164:                     border_color: Color::WHITE.into(),\n165:                     background_color: Color::DARK_GRAY.into(),\n166:                     ..default()\n167:                 },\n168:             ))\n169:             .with_children(|parent| {\n170:                 parent.spawn(TextBundle::from_section(\n171:                     caption,\n172:                     TextStyle {\n173:                         font_size: 20.,\n174:                         ..default()\n175:                     },\n176:                 ));\n177:             });\n178:     }\n179: }\n180: \n181: #[derive(Component)]\n182: struct LeftCamera;\n183: \n184: #[derive(Component)]\n185: struct RightCamera;\n186: \n187: #[derive(Component)]\n188: struct RotateCamera(Direction);\n189: \n190: enum Direction {\n191:     Left,\n192:     Right,\n193: }\n194: \n195: fn set_camera_viewports(\n196:     windows: Query<&Window>,\n197:     mut resize_events: EventReader<WindowResized>,\n198:     mut left_camera: Query<&mut Camera, (With<LeftCamera>, Without<RightCamera>)>,\n199:     mut right_camera: Query<&mut Camera, With<RightCamera>>,\n200: ) {\n201:     // We need to dynamically resize the camera's viewports whenever the window size changes\n202:     // so then each camera always takes up half the screen.\n203:     // A resize_event is sent when the window is first created, allowing us to reuse this system for initial setup.\n204:     for resize_event in resize_events.read() {\n205:         let window = windows.get(resize_event.window).unwrap();\n206:         let mut left_camera = left_camera.single_mut();\n207:         left_camera.viewport = Some(Viewport {\n208:             physical_position: UVec2::new(0, 0),\n209:             physical_size: UVec2::new(\n210:                 window.resolution.physical_width() / 2,\n211:                 window.resolution.physical_height(),\n212:             ),\n213:             ..default()\n214:         });\n215: \n216:         let mut right_camera = right_camera.single_mut();\n217:         right_camera.viewport = Some(Viewport {\n218:             physical_position: UVec2::new(window.resolution.physical_width() / 2, 0),\n219:             physical_size: UVec2::new(\n220:                 window.resolution.physical_width() / 2,\n221:                 window.resolution.physical_height(),\n222:             ),\n223:             ..default()\n224:         });\n225:     }\n226: }\n227: \n228: #[allow(clippy::type_complexity)]\n229: fn button_system(\n230:     interaction_query: Query<\n231:         (&Interaction, &TargetCamera, &RotateCamera),\n232:         (Changed<Interaction>, With<Button>),\n233:     >,\n234:     mut camera_query: Query<&mut Transform, With<Camera>>,\n235: ) {\n236:     for (interaction, target_camera, RotateCamera(direction)) in &interaction_query {\n237:         if let Interaction::Pressed = *interaction {\n238:             // Since TargetCamera propagates to the children, we can use it to find\n239:             // which side of the screen the button is on.\n240:             if let Ok(mut camera_transform) = camera_query.get_mut(target_camera.entity()) {\n241:                 let angle = match direction {\n242:                     Direction::Left => -0.1,\n243:                     Direction::Right => 0.1,\n244:                 };\n245:                 camera_transform.rotate_around(Vec3::ZERO, Quat::from_axis_angle(Vec3::Y, angle));\n246:             }\n247:         }\n248:     }\n249: }\n\n(End of file - total 249 lines)\n</content>",
            "metadata": {
              "preview": "//! Renders two cameras to the same window to accomplish \"split screen\".\n\nuse std::f32::consts::PI;\n\nuse bevy::{\n    pbr::CascadeShadowConfigBuilder, prelude::*, render::camera::Viewport, window::WindowResized,\n};\n\nfn main() {\n    App::new()\n        .add_plugins(DefaultPlugins)\n        .add_systems(Startup, setup)\n        .add_systems(Update, (set_camera_viewports, button_system))\n        .run();\n}\n\n/// set up a simple 3D scene\nfn setup(\n    mut commands: Commands,\n    asset_server: Res<AssetServer>,",
