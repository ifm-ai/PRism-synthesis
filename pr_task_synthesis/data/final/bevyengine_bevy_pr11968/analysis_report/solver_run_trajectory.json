\n211: \n212:     /// Retrieve this target's main texture's color attachment.\n213:     pub fn get_color_attachment(&self) -> RenderPassColorAttachment {\n214:         if self.main_texture.load(Ordering::SeqCst) == 0 {\n215:             self.main_textures.a.get_attachment()\n216:         } else {\n217:             self.main_textures.b.get_attachment()\n218:         }\n219:     }\n220: \n221:     /// Retrieve this target's \"unsampled\" main texture's color attachment.\n222:     pub fn get_unsampled_color_attachment(&self) -> RenderPassColorAttachment {\n223:         if self.main_texture.load(Ordering::SeqCst) == 0 {\n224:             self.main_textures.a.get_unsampled_attachment()\n225:         } else {\n226:             self.main_textures.b.get_unsampled_attachment()\n227:         }\n228:     }\n229: \n230:     /// The \"main\" unsampled texture.\n231:     pub fn main_texture(&self) -> &Texture {\n232:         if self.main_texture.load(Ordering::SeqCst) == 0 {\n233:             &self.main_textures.a.texture.texture\n234:         } else {\n235:             &self.main_textures.b.texture.texture\n236:         }\n237:     }\n238: \n239:     /// The _other_ \"main\" unsampled texture.\n240:     /// In most cases you should use [`Self::main_texture`] instead and never this.\n241:     /// The textures will naturally be swapped when [`Self::post_process_write`] is called.\n242:     ///\n243:     /// A use case for this is to be able to prepare a bind group for all main textures\n244:     /// ahead of time.\n245:     pub fn main_texture_other(&self) -> &Texture {\n246:         if self.main_texture.load(Ordering::SeqCst) == 0 {\n247:             &self.main_textures.b.texture.texture\n248:         } else {\n249:             &self.main_textures.a.texture.texture\n250:         }\n251:     }\n252: \n253:     /// The \"main\" unsampled texture.\n254:     pub fn main_texture_view(&self) -> &TextureView {\n255:         if self.main_texture.load(Ordering::SeqCst) == 0 {\n256:             &self.main_textures.a.texture.default_view\n257:         } else {\n258:             &self.main_textures.b.texture.default_view\n259:         }\n260:     }\n261: \n262:     /// The _other_ \"main\" unsampled texture view.\n263:     /// In most cases you should use [`Self::main_texture_view`] instead and never this.\n264:     /// The textures will naturally be swapped when [`Self::post_process_write`] is called.\n265:     ///\n266:     /// A use case for this is to be able to prepare a bind group for all main textures\n267:     /// ahead of time.\n268:     pub fn main_texture_other_view(&self) -> &TextureView {\n269:         if self.main_texture.load(Ordering::SeqCst) == 0 {\n270:             &self.main_textures.b.texture.default_view\n271:         } else {\n272:             &self.main_textures.a.texture.default_view\n273:         }\n274:     }\n275: \n276:     /// The \"main\" sampled texture.\n277:     pub fn sampled_main_texture(&self) -> Option<&Texture> {\n278:         self.main_textures\n279:             .a\n280:             .resolve_target\n281:             .as_ref()\n282:             .map(|sampled| &sampled.texture)\n283:     }\n284: \n285:     /// The \"main\" sampled texture view.\n286:     pub fn sampled_main_texture_view(&self) -> Option<&TextureView> {\n287:         self.main_textures\n288:             .a\n289:             .resolve_target\n290:             .as_ref()\n291:             .map(|sampled| &sampled.default_view)\n292:     }\n293: \n294:     #[inline]\n295:     pub fn main_texture_format(&self) -> TextureFormat {\n296:         self.main_texture_format\n297:     }\n298: \n299:     /// Returns `true` if and only if the main texture is [`Self::TEXTURE_FORMAT_HDR`]\n300:     #[inline]\n301:     pub fn is_hdr(&self) -> bool {\n302:         self.main_texture_format == ViewTarget::TEXTURE_FORMAT_HDR\n303:     }\n304: \n305:     /// The final texture this view will render to.\n306:     #[inline]\n307:     pub fn out_texture(&self) -> &TextureView {\n308:         &self.out_texture\n309:     }\n310: \n311:     /// The format of the final texture this view will render to\n312:     #[inline]\n313:     pub fn out_texture_format(&self) -> TextureFormat {\n314:         self.out_texture_format\n315:     }\n316: \n317:     /// This will start a new \"post process write\", which assumes that the caller\n318:     /// will write the [`PostProcessWrite`]'s `source` to the `destination`.\n319:     ///\n320:     /// `source` is the \"current\" main texture. This will internally flip this\n321:     /// [`ViewTarget`]'s main texture to the `destination` texture, so the caller\n322:     /// _must_ ensure `source` is copied to `destination`, with or without modifications.\n323:     /// Failing to do so will cause the current main texture information to be lost.\n324:     pub fn post_process_write(&self) -> PostProcessWrite {\n325:         let old_is_a_main_texture = self.main_texture.fetch_xor(1, Ordering::SeqCst);\n326:         // if the old main texture is a, then the post processing must write from a to b\n327:         if old_is_a_main_texture == 0 {\n328:             self.main_textures.b.mark_as_cleared();\n329:             PostProcessWrite {\n330:                 source: &self.main_textures.a.texture.default_view,\n331:                 destination: &self.main_textures.b.texture.default_view,\n332:             }\n333:         } else {\n334:             self.main_textures.a.mark_as_cleared();\n335:             PostProcessWrite {\n336:                 source: &self.main_textures.b.texture.default_view,\n337:                 destination: &self.main_textures.a.texture.default_view,\n338:             }\n339:         }\n340:     }\n341: }\n342: \n343: #[derive(Component)]\n344: pub struct ViewDepthTexture {\n345:     pub texture: Texture,\n346:     attachment: DepthAttachment,\n347: }\n348: \n349: impl ViewDepthTexture {\n350:     pub fn new(texture: CachedTexture, clear_value: Option<f32>) -> Self {\n351:         Self {\n352:             texture: texture.texture,\n353:             attachment: DepthAttachment::new(texture.default_view, clear_value),\n354:         }\n355:     }\n356: \n357:     pub fn get_attachment(&self, store: StoreOp) -> RenderPassDepthStencilAttachment {\n358:         self.attachment.get_attachment(store)\n359:     }\n360: \n361:     pub fn view(&self) -> &TextureView {\n362:         &self.attachment.view\n363:     }\n364: }\n365: \n366: pub fn prepare_view_uniforms(\n367:     mut commands: Commands,\n368:     render_device: Res<RenderDevice>,\n369:     render_queue: Res<RenderQueue>,\n370:     mut view_uniforms: ResMut<ViewUniforms>,\n371:     views: Query<(\n372:         Entity,\n373:         Option<&ExtractedCamera>,\n374:         &ExtractedView,\n375:         Option<&Frustum>,\n376:         Option<&TemporalJitter>,\n377:         Option<&MipBias>,\n378:         Option<&RenderLayers>,\n379:     )>,\n380: ) {\n381:     let view_iter = views.iter();\n382:     let view_count = view_iter.len();\n383:     let Some(mut writer) =\n384:         view_uniforms\n385:             .uniforms\n386:             .get_writer(view_count, &render_device, &render_queue)\n387:     else {\n388:         return;\n389:     };\n390:     for (\n391:         entity,\n392:         extracted_camera,\n393:         extracted_view,\n394:         frustum,\n395:         temporal_jitter,\n396:         mip_bias,\n397:         maybe_layers,\n398:     ) in &views\n399:     {\n400:         let viewport = extracted_view.viewport.as_vec4();\n401:         let unjittered_projection = extracted_view.projection;\n402:         let mut projection = unjittered_projection;\n403: \n404:         if let Some(temporal_jitter) = temporal_jitter {\n405:             temporal_jitter.jitter_projection(&mut projection, viewport.zw());\n406:         }\n407: \n408:         let inverse_projection = projection.inverse();\n409:         let view = extracted_view.transform.compute_matrix();\n410:         let inverse_view = view.inverse();\n411: \n412:         let view_proj = if temporal_jitter.is_some() {\n413:             projection * inverse_view\n414:         } else {\n415:             extracted_view\n416:                 .view_projection\n417:                 .unwrap_or_else(|| projection * inverse_view)\n418:         };\n419: \n420:         // Map Frustum type to shader array<vec4<f32>, 6>\n421:         let frustum = frustum\n422:             .map(|frustum| frustum.half_spaces.map(|h| h.normal_d()))\n423:             .unwrap_or([Vec4::ZERO; 6]);\n424: \n425:         let view_uniforms = ViewUniformOffset {\n426:             offset: writer.write(&ViewUniform {\n427:                 view_proj,\n428:                 unjittered_view_proj: unjittered_projection * inverse_view,\n429:                 inverse_view_proj: view * inverse_projection,\n430:                 view,\n431:                 inverse_view,\n432:                 projection,\n433:                 inverse_projection,\n434:                 world_position: extracted_view.transform.translation(),\n435:                 exposure: extracted_camera\n436:                     .map(|c| c.exposure)\n437:                     .unwrap_or_else(|| Exposure::default().exposure()),\n438:                 viewport,\n439:                 frustum,\n440:                 color_grading: extracted_view.color_grading,\n441:                 mip_bias: mip_bias.unwrap_or(&MipBias(0.0)).0,\n442:                 render_layers: maybe_layers.copied().unwrap_or_default().bits(),\n443:             }),\n444:         };\n445: \n446:         commands.entity(entity).insert(view_uniforms);\n447:     }\n448: }\n449: \n450: #[derive(Clone)]\n451: struct MainTargetTextures {\n452:     a: ColorAttachment,\n453:     b: ColorAttachment,\n454:     /// 0 represents `main_textures.a`, 1 represents `main_textures.b`\n455:     /// This is shared across view targets with the same render target\n456:     main_texture: Arc<AtomicUsize>,\n457: }\n458: \n459: #[allow(clippy::too_many_arguments)]\n460: pub fn prepare_view_targets(\n461:     mut commands: Commands,\n462:     windows: Res<ExtractedWindows>,\n463:     images: Res<RenderAssets<Image>>,\n464:     msaa: Res<Msaa>,\n465:     clear_color_global: Res<ClearColor>,\n466:     render_device: Res<RenderDevice>,\n467:     mut texture_cache: ResMut<TextureCache>,\n468:     cameras: Query<(\n469:         Entity,\n470:         &ExtractedCamera,\n471:         &ExtractedView,\n472:         &CameraMainTextureUsages,\n473:     )>,\n474:     manual_texture_views: Res<ManualTextureViews>,\n475: ) {\n476:     let mut textures = HashMap::default();\n477:     for (entity, camera, view, texture_usage) in cameras.iter() {\n478:         if let (Some(target_size), Some(target)) = (camera.physical_target_size, &camera.target) {\n479:             if let (Some(out_texture_view), Some(out_texture_format)) = (\n480:                 target.get_texture_view(&windows, &images, &manual_texture_views),\n481:                 target.get_texture_format(&windows, &images, &manual_texture_views),\n482:             ) {\n483:                 let size = Extent3d {\n484:                     width: target_size.x,\n485:                     height: target_size.y,\n486:                     depth_or_array_layers: 1,\n487:                 };\n488: \n489:                 let main_texture_format = if view.hdr {\n490:                     ViewTarget::TEXTURE_FORMAT_HDR\n491:                 } else {\n492:                     TextureFormat::bevy_default()\n493:                 };\n494: \n495:                 let clear_color = match camera.clear_color {\n496:                     ClearColorConfig::Custom(color) => Some(color),\n497:                     ClearColorConfig::None => None,\n498:                     _ => Some(clear_color_global.0),\n499:                 };\n500: \n501:                 let (a, b, sampled) = textures\n502:                     .entry((camera.target.clone(), view.hdr))\n503:                     .or_insert_with(|| {\n504:                         let descriptor = TextureDescriptor {\n505:                             label: None,\n506:                             size,\n507:                             mip_level_count: 1,\n508:                             sample_count: 1,\n509:                             dimension: TextureDimension::D2,\n510:                             format: main_texture_format,\n511:                             usage: texture_usage.0,\n512:                             view_formats: match main_texture_format {\n513:                                 TextureFormat::Bgra8Unorm => &[TextureFormat::Bgra8UnormSrgb],\n514:                                 TextureFormat::Rgba8Unorm => &[TextureFormat::Rgba8UnormSrgb],\n515:                                 _ => &[],\n516:                             },\n517:                         };\n518:                         let a = texture_cache.get(\n519:                             &render_device,\n520:                             TextureDescriptor {\n521:                                 label: Some(\"main_texture_a\"),\n522:                                 ..descriptor\n523:                             },\n524:                         );\n525:                         let b = texture_cache.get(\n526:                             &render_device,\n527:                             TextureDescriptor {\n528:                                 label: Some(\"main_texture_b\"),\n529:                                 ..descriptor\n530:                             },\n531:                         );\n532:                         let sampled = if msaa.samples() > 1 {\n533:                             let sampled = texture_cache.get(\n534:                                 &render_device,\n535:                                 TextureDescriptor {\n536:                                     label: Some(\"main_texture_sampled\"),\n537:                                     size,\n538:                                     mip_level_count: 1,\n539:                                     sample_count: msaa.samples(),\n540:                                     dimension: TextureDimension::D2,\n541:                                     format: main_texture_format,\n542:                                     usage: TextureUsages::RENDER_ATTACHMENT,\n543:                                     view_formats: descriptor.view_formats,\n544:                                 },\n545:                             );\n546:                             Some(sampled)\n547:                         } else {\n548:                             None\n549:                         };\n550:                         (a, b, sampled)\n551:                     });\n552: \n553:                 let main_textures = MainTargetTextures {\n554:                     a: ColorAttachment::new(a.clone(), sampled.clone(), clear_color),\n555:                     b: ColorAttachment::new(b.clone(), sampled.clone(), clear_color),\n556:                     main_texture: Arc::new(AtomicUsize::new(0)),\n557:                 };\n558: \n559:                 commands.entity(entity).insert(ViewTarget {\n560:                     main_texture: main_textures.main_texture.clone(),\n561:                     main_textures,\n562:                     main_texture_format,\n563:                     out_texture: out_texture_view.clone(),\n564:                     out_texture_format: out_texture_format.add_srgb_suffix(),\n565:                 });\n566:             }\n567:         }\n568:     }\n569: }\n\n(End of file - total 569 lines)\n</content>",
