            "output": "<path>/workspace/crates/bevy_core_pipeline/src/msaa_writeback.rs</path>\n<type>file</type>\n<content>\n1: use crate::{\n2:     blit::{BlitPipeline, BlitPipelineKey},\n3:     core_2d::graph::{Core2d, Node2d},\n4:     core_3d::graph::{Core3d, Node3d},\n5: };\n6: use bevy_app::{App, Plugin};\n7: use bevy_ecs::prelude::*;\n8: use bevy_render::{\n9:     camera::ExtractedCamera,\n10:     color::Color,\n11:     render_graph::{Node, NodeRunError, RenderGraphApp, RenderGraphContext},\n12:     render_resource::BindGroupEntries,\n13:     renderer::RenderContext,\n14:     view::{Msaa, ViewTarget},\n15:     Render, RenderSet,\n16: };\n17: use bevy_render::{render_resource::*, RenderApp};\n18: \n19: /// This enables \"msaa writeback\" support for the `core_2d` and `core_3d` pipelines, which can be enabled on cameras\n20: /// using [`bevy_render::camera::Camera::msaa_writeback`]. See the docs on that field for more information.\n21: pub struct MsaaWritebackPlugin;\n22: \n23: impl Plugin for MsaaWritebackPlugin {\n24:     fn build(&self, app: &mut App) {\n25:         let Ok(render_app) = app.get_sub_app_mut(RenderApp) else {\n26:             return;\n27:         };\n28: \n29:         render_app.add_systems(\n30:             Render,\n31:             prepare_msaa_writeback_pipelines.in_set(RenderSet::Prepare),\n32:         );\n33:         {\n34:             render_app\n35:                 .add_render_graph_node::<MsaaWritebackNode>(Core2d, Node2d::MsaaWriteback)\n36:                 .add_render_graph_edge(Core2d, Node2d::MsaaWriteback, Node2d::MainPass);\n37:         }\n38:         {\n39:             render_app\n40:                 .add_render_graph_node::<MsaaWritebackNode>(Core3d, Node3d::MsaaWriteback)\n41:                 .add_render_graph_edge(Core3d, Node3d::MsaaWriteback, Node3d::StartMainPass);\n42:         }\n43:     }\n44: }\n45: \n46: pub struct MsaaWritebackNode {\n47:     cameras: QueryState<(&'static ViewTarget, &'static MsaaWritebackBlitPipeline)>,\n48: }\n49: \n50: impl FromWorld for MsaaWritebackNode {\n51:     fn from_world(world: &mut World) -> Self {\n52:         Self {\n53:             cameras: world.query(),\n54:         }\n55:     }\n56: }\n57: \n58: impl Node for MsaaWritebackNode {\n59:     fn update(&mut self, world: &mut World) {\n60:         self.cameras.update_archetypes(world);\n61:     }\n62: \n63:     fn run(\n64:         &self,\n65:         graph: &mut RenderGraphContext,\n66:         render_context: &mut RenderContext,\n67:         world: &World,\n68:     ) -> Result<(), NodeRunError> {\n69:         if *world.resource::<Msaa>() == Msaa::Off {\n70:             return Ok(());\n71:         }\n72: \n73:         let view_entity = graph.view_entity();\n74:         if let Ok((target, blit_pipeline_id)) = self.cameras.get_manual(world, view_entity) {\n75:             let blit_pipeline = world.resource::<BlitPipeline>();\n76:             let pipeline_cache = world.resource::<PipelineCache>();\n77:             let Some(pipeline) = pipeline_cache.get_render_pipeline(blit_pipeline_id.0) else {\n78:                 return Ok(());\n79:             };\n80: \n81:             // The current \"main texture\" needs to be bound as an input resource, and we need the \"other\"\n82:             // unused target to be the \"resolve target\" for the MSAA write. Therefore this is the same\n83:             // as a post process write!\n84:             let post_process = target.post_process_write();\n85: \n86:             let pass_descriptor = RenderPassDescriptor {\n87:                 label: Some(\"msaa_writeback\"),\n88:                 // The target's \"resolve target\" is the \"destination\" in post_process.\n89:                 // We will indirectly write the results to the \"destination\" using\n90:                 // the MSAA resolve step.\n91:                 color_attachments: &[Some(RenderPassColorAttachment {\n92:                     // If MSAA is enabled, then the sampled texture will always exist\n93:                     view: target.sampled_main_texture_view().unwrap(),\n94:                     resolve_target: Some(post_process.destination),\n95:                     ops: Operations {\n96:                         load: LoadOp::Clear(Color::BLACK.into()),\n97:                         store: StoreOp::Store,\n98:                     },\n99:                 })],\n100:                 depth_stencil_attachment: None,\n101:                 timestamp_writes: None,\n102:                 occlusion_query_set: None,\n103:             };\n104: \n105:             let bind_group = render_context.render_device().create_bind_group(\n106:                 None,\n107:                 &blit_pipeline.texture_bind_group,\n108:                 &BindGroupEntries::sequential((post_process.source, &blit_pipeline.sampler)),\n109:             );\n110: \n111:             let mut render_pass = render_context\n112:                 .command_encoder()\n113:                 .begin_render_pass(&pass_descriptor);\n114: \n115:             render_pass.set_pipeline(pipeline);\n116:             render_pass.set_bind_group(0, &bind_group, &[]);\n117:             render_pass.draw(0..3, 0..1);\n118:         }\n119: \n120:         Ok(())\n121:     }\n122: }\n123: \n124: #[derive(Component)]\n125: pub struct MsaaWritebackBlitPipeline(CachedRenderPipelineId);\n126: \n127: fn prepare_msaa_writeback_pipelines(\n128:     mut commands: Commands,\n129:     pipeline_cache: Res<PipelineCache>,\n130:     mut pipelines: ResMut<SpecializedRenderPipelines<BlitPipeline>>,\n131:     blit_pipeline: Res<BlitPipeline>,\n132:     view_targets: Query<(Entity, &ViewTarget, &ExtractedCamera)>,\n133:     msaa: Res<Msaa>,\n134: ) {\n135:     for (entity, view_target, camera) in view_targets.iter() {\n136:         // only do writeback if writeback is enabled for the camera and this isn't the first camera in the target,\n137:         // as there is nothing to write back for the first camera.\n138:         if msaa.samples() > 1 && camera.msaa_writeback && camera.sorted_camera_index_for_target > 0\n139:         {\n140:             let key = BlitPipelineKey {\n141:                 texture_format: view_target.main_texture_format(),\n142:                 samples: msaa.samples(),\n143:                 blend_state: None,\n144:             };\n145: \n146:             let pipeline = pipelines.specialize(&pipeline_cache, &blit_pipeline, key);\n147:             commands\n148:                 .entity(entity)\n149:                 .insert(MsaaWritebackBlitPipeline(pipeline));\n150:         } else {\n151:             // This isn't strictly necessary now, but if we move to retained render entity state I don't\n152:             // want this to silently break\n153:             commands\n154:                 .entity(entity)\n155:                 .remove::<MsaaWritebackBlitPipeline>();\n156:         }\n157:     }\n158: }\n\n(End of file - total 158 lines)\n</content>",
            "metadata": {
