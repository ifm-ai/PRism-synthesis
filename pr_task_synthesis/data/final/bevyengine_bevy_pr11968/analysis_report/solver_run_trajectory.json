le4 = 4,\n99:     Sample8 = 8,\n100: }\n101: \n102: impl Msaa {\n103:     #[inline]\n104:     pub fn samples(&self) -> u32 {\n105:         *self as u32\n106:     }\n107: }\n108: \n109: #[derive(Component)]\n110: pub struct ExtractedView {\n111:     pub projection: Mat4,\n112:     pub transform: GlobalTransform,\n113:     // The view-projection matrix. When provided it is used instead of deriving it from\n114:     // `projection` and `transform` fields, which can be helpful in cases where numerical\n115:     // stability matters and there is a more direct way to derive the view-projection matrix.\n116:     pub view_projection: Option<Mat4>,\n117:     pub hdr: bool,\n118:     // uvec4(origin.x, origin.y, width, height)\n119:     pub viewport: UVec4,\n120:     pub color_grading: ColorGrading,\n121: }\n122: \n123: impl ExtractedView {\n124:     /// Creates a 3D rangefinder for a view\n125:     pub fn rangefinder3d(&self) -> ViewRangefinder3d {\n126:         ViewRangefinder3d::from_view_matrix(&self.transform.compute_matrix())\n127:     }\n128: }\n129: \n130: /// Configures basic color grading parameters to adjust the image appearance. Grading is applied just before/after tonemapping for a given [`Camera`](crate::camera::Camera) entity.\n131: #[derive(Component, Reflect, Debug, Copy, Clone, ShaderType)]\n132: #[reflect(Component, Default)]\n133: pub struct ColorGrading {\n134:     /// Exposure value (EV) offset, measured in stops.\n135:     pub exposure: f32,\n136: \n137:     /// Non-linear luminance adjustment applied before tonemapping. y = pow(x, gamma)\n138:     pub gamma: f32,\n139: \n140:     /// Saturation adjustment applied before tonemapping.\n141:     /// Values below 1.0 desaturate, with a value of 0.0 resulting in a grayscale image\n142:     /// with luminance defined by ITU-R BT.709.\n143:     /// Values above 1.0 increase saturation.\n144:     pub pre_saturation: f32,\n145: \n146:     /// Saturation adjustment applied after tonemapping.\n147:     /// Values