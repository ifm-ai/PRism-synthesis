})\n70:         .id();\n71: \n72:     // Run systems\n73:     app.update();\n74: \n75:     // Check resulting changes\n76:     assert!(app.world.get::<Enemy>(enemy_id).is_some());\n77:     assert_eq!(app.world.get::<Enemy>(enemy_id).unwrap().hit_points, 4);\n78: }\n79: \n80: #[test]\n81: fn did_despawn_enemy() {\n82:     // Setup app\n83:     let mut app = App::new();\n84: \n85:     // Add Score resource\n86:     app.insert_resource(Score(0));\n87: \n88:     // Add `EnemyDied` event\n89:     app.add_event::<EnemyDied>();\n90: \n91:     // Add our two systems\n92:     app.add_systems(Update, (hurt_enemies, despawn_dead_enemies).chain());\n93: \n94:     // Setup test entities\n95:     let enemy_id = app\n96:         .world\n97:         .spawn(Enemy {\n98:             hit_points: 1,\n99:             score_value: 1,\n100:         })\n101:         .id();\n102: \n103:     // Run systems\n104:     app.update();\n105: \n106:     // Check enemy was despawned\n107:     assert!(app.world.get::<Enemy>(enemy_id).is_none());\n108: \n109:     // Get `EnemyDied` event reader\n110:     let enemy_died_events = app.world.resource::<Events<EnemyDied>>();\n111:     let mut enemy_died_reader = enemy_died_events.get_reader();\n112:     let enemy_died = enemy_died_reader.read(enemy_died_events).next().unwrap();\n113: \n114:     // Check the event has been sent\n115:     assert_eq!(enemy_died.0, 1);\n116: }\n117: \n118: #[test]\n119: fn spawn_enemy_using_input_resource() {\n120:     // Setup app\n121:     let mut app = App::new();\n122: \n123:     // Add our systems\n124:     app.add_systems(Update, spawn_enemy);\n125: \n126:     // Setup test resource\n127:     let mut input = ButtonInput::<KeyCode>::default();\n128:     input.press(KeyCode::Space);\n129:     app.insert_resource(input);\n130: \n131:     // Run systems\n132:     app.update();\n133: \n134:     // Check resulting changes, one entity has been spawned with `Enemy` component\n135:     assert_eq!(app.world.query::<&Enemy>().iter(