{
  "base_image": "python:3.11-slim",
  "build_context_files": [
    "setup_runtime.sh",
    "repo_setup.sh"
  ],
  "system_packages": [
    "python3.11-venv",
    "python3-pip"
  ],
  "base_setup_commands": [
    "apt-get update -qq",
    "apt-get install -y -qq python3.11-venv python3-pip",
    "rm -rf /var/lib/apt/lists/*"
  ],
  "copied_artifacts": [
    {
      "source": "setup_runtime.sh",
      "destination": "/opt/benchmark/setup_runtime.sh"
    },
    {
      "source": "repo_setup.sh",
      "destination": "/opt/benchmark/repo_setup.sh"
    }
  ],
  "build_steps": [
    {
      "step": 1,
      "description": "Copy setup scripts to image",
      "command": "COPY setup_runtime.sh repo_setup.sh /opt/benchmark/"
    },
    {
      "step": 2,
      "description": "Make scripts executable",
      "command": "chmod +x /opt/benchmark/setup_runtime.sh /opt/benchmark/repo_setup.sh"
    },
    {
      "step": 3,
      "description": "Materialize repository from git",
      "command": "/opt/benchmark/repo_setup.sh"
    },
    {
      "step": 4,
      "description": "Install Python runtime dependencies",
      "command": "/opt/benchmark/setup_runtime.sh"
    }
  ],
  "python_environment": {
    "type": "venv",
    "path": "/opt/benchmark/venv",
    "package_manager": "pip",
    "pytorch_index": "https://download.pytorch.org/whl/cpu"
  },
  "final_workdir": "/workspace",
  "runtime_mounts_notes": {
    "eval_sh": "Mounted at runtime, not baked into image",
    "test_patch": "Applied at runtime if present",
    "tests": "Runtime-mounted from /artifacts/evaluation/tests/"
  },
  "build_backend": "buildah",
  "output_format": "oci",
  "output_archive": "/artifacts/environment/openenv_validation_oci.tar"
}
