B256,\n165:         s: crate::B256,\n166:         parity: T,\n167:     ) -> Result<Self, SignatureError> {\n168:         let inner = k256::ecdsa::Signature::from_scalars(r.0, s.0)?;\n169:         Self::from_signature_and_parity(inner, parity)\n170:     }\n171: \n172:     /// Normalizes the signature into \"low S\" form as described in\n173:     /// [BIP 0062: Dealing with Malleability][1].\n174:     ///\n175:     /// [1]: https://github.com/bitcoin/bips/blob/master/bip-0062.mediawiki\n176:     #[inline]\n177:     pub fn normalize_s(&self) -> Option<Self> {\n178:         // Normalize into \"low S\" form. See:\n179:         // - https://github.com/RustCrypto/elliptic-curves/issues/988\n180:         // - https://github.com/bluealloy/revm/pull/870\n181:         self.inner.normalize_s().map(|normalized| {\n182:             let s = U256::from_be_slice(normalized.s().to_bytes().as_ref());\n183:             Self { inner: normalized, v: self.v.inverted(), r: self.r, s }\n184:         })\n185:     }\n186: \n187:     /// Returns the recovery ID.\n188:     #[inline]\n189:     pub const fn recid(&self) -> k256::ecdsa::RecoveryId {\n190:         self.v.recid()\n191:     }\n192: \n193:     #[doc(hidden)]\n194:     #[deprecated(note = \"use `Signature::recid` instead\")]\n195:     pub const fn recovery_id(&self) -> k256::ecdsa::RecoveryId {\n196:         self.recid()\n197:     }\n198: \n199:     /// Recovers an [`Address`] from this signature and the given message by first prefixing and\n200:     /// hashing the message according to [EIP-191](crate::eip191_hash_message).\n201:     ///\n202:     /// [`Address`]: crate::Address\n203:     #[inline]\n204:     pub fn recover_address_from_msg<T: AsRef<[u8]>>(\n205:         &self,\n206:         msg: T,\n207:     ) -> Result<crate::Address, SignatureError> {\n208:         self.recover_from_msg(msg).map(|vk| crate::Address::from_public_key(&vk))\n209:     }\n210: \n211:     /// Recovers an [`Address`] from this signature and the given prehashed message.\n212:     ///\n213:     /// [`Address`]: crate::Address\n214:     #[inline]\n215:     pub fn recover_address_from_prehash(\n216:         &self,\n217:         prehash: &crate::B256,\n218:     ) -> Result<crate::Address, SignatureError> {\n219:         self.recover_from_prehash(prehash).map(|vk| crate::Address::from_public_key(&vk))\n220:     }\n221: \n222:     /// Recovers a [`VerifyingKey`] from this signature and the given message by first prefixing and\n223:     /// hashing the message according to [EIP-191](crate::eip191_hash_message).\n224:     ///\n225:     /// [`VerifyingKey`]: k256::ecdsa::VerifyingKey\n226:     #[inline]\n227:     pub fn recover_from_msg<T: AsRef<[u8]>>(\n228:         &self,\n229:         msg: T,\n230:     ) -> Result<k256::ecdsa::VerifyingKey, SignatureError> {\n231:         self.recover_from_prehash(&crate::eip191_hash_message(msg))\n232:     }\n233: \n234:     /// Recovers a [`VerifyingKey`] from this signature and the given prehashed message.\n235:     ///\n236:     /// [`VerifyingKey`]: k256::ecdsa::VerifyingKey\n237:     #[inline]\n238:     pub fn recover_from_prehash(\n239:         &self,\n240:         prehash: &crate::B256,\n241:     ) -> Result<k256::ecdsa::VerifyingKey, SignatureError> {\n242:         let this = self.normalize_s().unwrap_or(*self);\n243:         k256::ecdsa::VerifyingKey::recover_from_prehash(\n244:             prehash.as_slice(),\n245:             &this.inner,\n246:             this.recid(),\n247:         )\n248:         .map_err(Into::into)\n249:     }\n250: }\n251: \n252: impl Signature<()> {\n253:     /// Parses a signature from a byte slice, with a v value\n254:     ///\n255:     /// # Panics\n256:     ///\n257:     /// If the slice is not at least 64 bytes long.\n258:     #[inline]\n259:     pub fn from_bytes_and_parity<T: TryInto<Parity, Error = E>, E: Into<SignatureError>>(\n260:         bytes: &[u8],\n261:         parity: T,\n262:     ) -> Result<Self, SignatureError> {\n263:         let r = U256::from_be_slice(&bytes[..32]);\n264:         let s = U256::from_be_slice(&bytes[32..64]);\n265:         Self::from_rs_and_parity(r, s, parity)\n266:     }\n267: \n268:     /// Instantiate from v, r, s.\n269:     pub fn from_rs_and_parity<T: TryInto<Parity, Error = E>, E: Into<SignatureError>>(\n270:         r: U256,\n271:         s: U256,\n272:         parity: T,\n273:     ) -> Result<Self, SignatureError> {\n274:         Ok(Self { inner: (), v: parity.try_into().map_err(Into::into)?, r, s })\n275:     }\n276: }\n277: \n278: impl<S: Copy> Signature<S> {\n279:     /// Returns the inner ECDSA signature.\n280:     #[inline]\n281:     pub const fn into_inner(self) -> S {\n282:         self.inner\n283:     }\n284: \n285:     /// Modifies the recovery ID by applying [EIP-155] to a `v` value.\n286:     ///\n287:     /// [EIP-155]: https://eips.ethereum.org/EIPS/eip-155\n288:     #[inline]\n289:     pub fn with_chain_id(self, chain_id: u64) -> Self {\n290:         self.with_parity(self.v.with_chain_id(chain_id))\n291:     }\n292: \n293:     /// Modifies the recovery ID by dropping any [EIP-155] v value, converting\n294:     /// to a simple parity bool.\n295:     pub fn with_parity_bool(self) -> Self {\n296:         self.with_parity(self.v.to_parity_bool())\n297:     }\n298: }\n299: \n300: impl<S> Signature<S> {\n301:     /// Returns the inner ECDSA signature.\n302:     #[inline]\n303:     pub const fn inner(&self) -> &S {\n304:         &self.inner\n305:     }\n306: \n307:     /// Returns the `r` component of this signature.\n308:     #[inline]\n309:     pub const fn r(&self) -> U256 {\n310:         self.r\n311:     }\n312: \n313:     /// Returns the `s` component of this signature.\n314:     #[inline]\n315:     pub const fn s(&self) -> U256 {\n316:         self.s\n317:     }\n318: \n319:     /// Returns the recovery ID as a `u8`.\n320:     #[inline]\n321:     pub const fn v(&self) -> Parity {\n322:         self.v\n323:     }\n324: \n325:     /// Returns the byte-array r