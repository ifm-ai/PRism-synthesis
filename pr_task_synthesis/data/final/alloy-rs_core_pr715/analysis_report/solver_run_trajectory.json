atureError;\n60: \n61:     fn from_str(s: &str) -> Result<Self, Self::Err> {\n62:         let bytes = hex::decode(s)?;\n63:         Self::try_from(&bytes[..])\n64:     }\n65: }\n66: \n67: impl From<&crate::Signature> for [u8; 65] {\n68:     #[inline]\n69:     fn from(value: &crate::Signature) -> [u8; 65] {\n70:         value.as_bytes()\n71:     }\n72: }\n73: \n74: impl From<crate::Signature> for [u8; 65] {\n75:     #[inline]\n76:     fn from(value: crate::Signature) -> [u8; 65] {\n77:         value.as_bytes()\n78:     }\n79: }\n80: \n81: impl From<&crate::Signature> for Vec<u8> {\n82:     #[inline]\n83:     fn from(value: &crate::Signature) -> Self {\n84:         value.as_bytes().to_vec()\n85:     }\n86: }\n87: \n88: impl From<crate::Signature> for Vec<u8> {\n89:     #[inline]\n90:     fn from(value: crate::Signature) -> Self {\n91:         value.as_bytes().to_vec()\n92:     }\n93: }\n94: \n95: #[cfg(feature = \"k256\")]\n96: impl From<(k256::ecdsa::Signature, k256::ecdsa::RecoveryId)> for Signature<k256::ecdsa::Signature> {\n97:     fn from(value: (k256::ecdsa::Signature, k256::ecdsa::RecoveryId)) -> Self {\n98:         Self::from_signature_and_parity(value.0, value.1).unwrap()\n99:     }\n100: }\n101: \n102: #[cfg(feature = \"rlp\")]\n103: impl crate::Signature {\n104:     /// Decode an RLP-encoded VRS signature.\n105:     pub fn decode_rlp_vrs(buf: &mut &[u8]) -> Result<Self, alloy_rlp::Error> {\n106:         use alloy_rlp::Decodable;\n107: \n108:         let parity: Parity = Decodable::decode(buf)?;\n109:         let r = Decodable::decode(buf)?;\n110:         let s = Decodable::decode(buf)?;\n111: \n112:         Self::from_rs_and_parity(r, s, parity)\n113:             .map_err(|_| alloy_rlp::Error::Custom(\"attempted to decode invalid field element\"))\n114:     }\n115: }\n116: \n117: #[cfg(feature = \"k256\")]\n118: impl Signature<k256::ecdsa::Signature> {\n119:     #[doc(hidden)]\n120:     pub fn test_signature() -> Self {\n121:         Self::from_scalars_and_