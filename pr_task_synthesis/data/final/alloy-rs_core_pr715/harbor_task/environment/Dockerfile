# Final Dockerfile for alloy-rs/core Rust Ethereum primitives
# Base image: rust:slim
# Generated by openenv-dockerfile-builder

FROM rust:slim

# Install system packages required for building Rust projects
RUN apt-get update && apt-get install -y \
    git \
    curl \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set up environment variables for Rust toolchain
ENV RUSTUP_HOME=/root/.rustup
ENV CARGO_HOME=/root/.cargo
ENV PATH="$CARGO_HOME/bin:$PATH"

# Create benchmark directory for build scripts
RUN mkdir -p /opt/benchmark

# Copy build-context scripts into the image
COPY setup_runtime.sh /opt/benchmark/setup_runtime.sh
COPY repo_setup.sh /opt/benchmark/repo_setup.sh

# Make scripts executable
RUN chmod +x /opt/benchmark/setup_runtime.sh /opt/benchmark/repo_setup.sh

# Run repo_setup.sh to materialize /workspace from git repository
RUN /opt/benchmark/repo_setup.sh

# Run setup_runtime.sh to configure Rust environment
RUN /opt/benchmark/setup_runtime.sh

# Set working directory to workspace
WORKDIR /workspace

# Default command (can be overridden at runtime)
CMD ["/bin/bash"]
