:         \"\"\"\n45:         Constructor for the RipsLayer class\n46: \n47:         Parameters:\n48:             maximum_edge_length (float): maximum edge length for the Rips complex \n49:             homology_dimensions (List[int]): list of homology dimensions\n50:             min_persistence (List[float]): minimum distance-to-diagonal of the points in the output persistence diagrams (default None, in which case 0. is used for all dimensions)\n51:             homology_coeff_field (int): homology field coefficient. Must be a prime number. Default value is 11. Max is 46337.\n52:         \"\"\"\n53:         super().__init__(dynamic=True, **kwargs)\n54:         self.max_edge = maximum_edge_length\n55:         self.dimensions = homology_dimensions\n56:         self.min_persistence = min_persistence if min_persistence is not None else [0. for _ in range(len(self.dimensions))]\n57:         self.hcf = homology_coeff_field\n58:         assert len(self.min_persistence) == len(self.dimensions)\n59:         \n60:     def call(self, X):\n61:         \"\"\"\n62:         Compute Rips persistence diagram associated to a point cloud\n63: \n64:         Parameters:   \n65:             X (TensorFlow variable): point cloud of shape [number of points, number of dimensions]\n66: \n67:         Returns:\n68:             List[Tuple[tf.Tensor,tf.Tensor]]: List of Rips persistence diagrams. The length of this list is the same than that of dimensions, i.e., there is one persistence diagram per homology dimension provided in the input list dimensions. Moreover, the finite and essential parts of the persistence diagrams are provided separately: each element of this list is a tuple of size two that contains the finite and essential parts of the corresponding persistence diagram, of shapes [num_finite_points, 2] and [num_essential_points, 1] respectively\n69:         \"\"\"    \n70:         # Compute distance matrix\n71:         DX = tf.norm(tf.expand_dims(X, 1)-tf.expand_dims(X, 0), axis=2)\n72:         # Compute vertices associated to positive and negative simplices \n73:         # Don't compute gradient for this operation\n74:         indices = _Rips(DX.numpy(), self.max_edge, self.dimensions, self.hcf)\n75:         # Get persistence diagrams by simply picking the corresponding entries in the distance matrix\n76:         self.dgms = []\n77:         for idx_dim, dimension in enumerate(self.dimensions):\n78:             cur_idx = indices[idx_dim]\n79:             if dimension > 0:\n80:                 finite_dgm = tf.reshape(tf.gather_nd(DX, tf.reshape(cur_idx[0], [-1,2])), [-1,2])\n81:                 essential_dgm = tf.reshape(tf.gather_nd(DX, tf.reshape(cur_idx[1], [-1,2])), [-1,1])\n82:             else:\n83:                 reshaped_cur_idx = tf.reshape(cur_idx[0], [-1,3])\n84:                 finite_dgm = tf.concat([tf.zeros([reshaped_cur_idx.shape[0],1]), tf.reshape(tf.gather_nd(DX, reshaped_cur_idx[:,1:]), [-1,1])], axis=1)\n85:                 essential_dgm = tf.zeros([cur_idx[1].shape[0],1])\n86:             min_pers = self.min_persistence[idx_dim]\n87:             if min_pers >= 0:\n88:                 persistent_indices = tf.where(tf.math.abs(finite_dgm[:,1]-finite_dgm[:,0]) > min_pers)\n89:                 self.dgms.append((tf.reshape(tf.gather(finite_dgm, indices=persistent_indices),[-1,2]), essential_dgm))\n90:             else:\n91:                 self.dgms.append((finite_dgm, essential_dgm))\n92:         return self.dgms\n93: \n\n(End of file - total 93 lines)\n</content>",
