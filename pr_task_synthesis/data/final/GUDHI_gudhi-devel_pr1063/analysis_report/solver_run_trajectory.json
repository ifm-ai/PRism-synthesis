n39: \n40:     return L_indices\n41: \n42: class LowerStarSimplexTreeLayer(tf.keras.layers.Layer):\n43:     \"\"\"\n44:     TensorFlow layer for computing lower-star persistence out of a simplex tree\n45:     \"\"\"\n46:     def __init__(self, simplextree, homology_dimensions, min_persistence=None, homology_coeff_field=11, persistence_dim_max=False, **kwargs):\n47:         \"\"\"\n48:         Constructor for the LowerStarSimplexTreeLayer class\n49:   \n50:         Parameters:\n51:             simplextree (gudhi.SimplexTree): underlying simplex tree. Its vertices MUST be named with integers from 0 to n-1, where n is its number of vertices. Note that its filtration values are modified in each call of the class.\n52:             homology_dimensions (List[int]): list of homology dimensions\n53:             min_persistence (List[float]): minimum distance-to-diagonal of the points in the output persistence diagrams (default None, in which case 0. is used for all dimensions)\n54:             homology_coeff_field (int): homology field coefficient. Must be a prime number. Default value is 11. Max is 46337.\n55:             persistence_dim_max (bool): if true, the persistent homology for the maximal dimension in the simplex tree is computed. If false, it is ignored. Default is false.\n56:         \"\"\"\n57:         super().__init__(dynamic=True, **kwargs)\n58:         self.dimensions  = homology_dimensions\n59:         self.simplextree = simplextree\n60:         self.min_persistence = min_persistence if min_persistence is not None else [0. for _ in range(len(self.dimensions))]\n61:         self.hcf = homology_coeff_field\n62:         self.pdm = persistence_dim_max\n63:         assert len(self.min_persistence) == len(self.dimensions)\n64: \n65:     def call(self, filtration):\n66:         \"\"\"\n67:         Compute lower-star persistence diagram associated to a function defined on the vertices of the simplex tree\n68: \n69:         Parameters:\n70:             F (TensorFlow variable): filter function values over the vertices of the simplex tree. The ith entry of F corresponds to vertex i in self.simplextree\n71: \n72:         Returns:\n73:             List[Tuple[tf.Tensor,tf.Tensor]]: List of lower-star persistence diagrams. The length of this list is the same than that of dimensions, i.e., there is one persistence diagram per homology dimension provided in the input list dimensions. Moreover, the finite and essential parts of the persistence diagrams are provided separately: each element of this list is a tuple of size two that contains the finite and essential parts of the corresponding persistence diagram, of shapes [num_finite_points, 2] and [num_essential_points, 1] respectively\n74:         \"\"\"\n75:         # Don't try to compute gradients for the vertex pairs\n76:         indices = _LowerStarSimplexTree(self.simplextree, filtration.numpy(), self.dimensions, self.hcf, self.pdm)\n77:         # Get persistence diagrams\n78:         self.dgms = []\n79:         for idx_dim, dimension in enumerate(self.dimensions):\n80:             finite_dgm = tf.reshape(tf.gather(filtration, indices[idx_dim][0]), [-1,2])\n81:             essential_dgm = tf.reshape(tf.gather(filtration, indices[idx_dim][1]), [-1,1])\n82:             min_pers = self.min_persistence[idx_dim]\n83:             if min_pers >= 0:\n84:                 persistent_indices = tf.where(tf.math.abs(finite_dgm[:,1]-finite_dgm[:,0]) > min_pers)\n85:                 self.dgms.append((tf.reshape(tf.gather(finite_dgm, indices=persistent_indices),[-1,2]), essential_dgm))\n86:             else:\n87:                 self.dgms.append((finite_dgm, essential_dgm))\n88:         return self.dgms\n89: \n\n(End of file - total 89 lines)\n</content>",
