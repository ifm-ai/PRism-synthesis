    # Check the specific assertions from the requirements\n        checks = [\n            ('empty_categorical_all', True),\n            ('empty_categorical_partial', True),\n            ('empty_extension_all', True),\n            ('empty_extension_partial', True),\n        ]\n        \n        all_passed = True\n        for col_name, expected_nullable in checks:\n            is_nullable = obs_arr.attr(col_name).isnullable\n            status = \"✓ PASS\" if is_nullable == expected_nullable else \"✗ FAIL\"\n            print(f\"  {status}: obs.attr('{col_name}').isnullable = {is_nullable} (expected {expected_nullable})\")\n            if is_nullable != expected_nullable:\n                all_passed = False\n    \n    exp.close()\n    \n    if all_passed:\n        print(\"\\n✓ All assertions passed successfully!\")\n    else:\n        print(\"\\n✗ Some assertions failed!\")\n        exit(1)\nEOF\n",
