            "output": "<path>/workspace/apis/python/src/tiledbsoma/io/ingest.py</path>\n<type>file</type>\n<content>\n1: # Copyright (c) 2021-2023 The Chan Zuckerberg Initiative Foundation\n2: # Copyright (c) 2021-2023 TileDB, Inc.\n3: #\n4: # Licensed under the MIT License.\n5: \n6: \"\"\"Ingestion methods.\n7: \n8: This module contains methods to generate SOMA artifacts starting from\n9: other formats. Currently only ``.h5ad`` (`AnnData <https://anndata.readthedocs.io/>`_) is supported.\n10: \"\"\"\n11: \n12: import json\n13: import math\n14: import time\n15: from typing import (\n16:     Any,\n17:     ContextManager,\n18:     Dict,\n19:     List,\n20:     Mapping,\n21:     Optional,\n22:     Sequence,\n23:     Tuple,\n24:     Type,\n25:     TypeVar,\n26:     Union,\n27:     cast,\n28:     overload,\n29: )\n30: from unittest import mock\n31: \n32: import anndata as ad\n33: import h5py\n34: import numpy as np\n35: import pandas as pd\n36: import pyarrow as pa\n37: import scipy.sparse as sp\n38: import tiledb\n39: from anndata._core import file_backing\n40: from anndata._core.sparse_dataset import SparseDataset\n41: from somacore.options import PlatformConfig\n42: \n43: from .. import (\n44:     Collection,\n45:     DataFrame,\n46:     DenseNDArray,\n47:     Experiment,\n48:     Measurement,\n49:     SparseNDArray,\n50:     _factory,\n51:     _util,\n52:     eta,\n53:     logging,\n54: )\n55: from .._arrow_types import df_to_arrow, tiledb_type_from_arrow_type\n56: from .._collection import AnyTileDBCollection\n57: from .._common_nd_array import NDArray\n58: from .._constants import SOMA_JOINID\n59: from .._exception import DoesNotExistError, SOMAError\n60: from .._funcs import typeguard_ignore\n61: from .._tdb_handles import RawHandle\n62: from .._tiledb_array import TileDBArray\n63: from .._tiledb_object import AnyTileDBObject, TileDBObject\n64: from .._types import INGEST_MODES, IngestMode, NPNDArray, Path\n65: from ..options import SOMATileDBContext\n66: from ..options._soma_tiledb_context import _validate_soma_tiledb_context\n67: from ..options._tiledb_create_options import TileDBCreateOptions\n68: from . import conversions\n69: from ._registration import (\n70:     AxisIDMapping,\n71:     ExperimentAmbientLabelMapping,\n72:     ExperimentIDMapping,\n73:     get_dataframe_values,\n74:     signatures,\n75: )\n76: \n77: SparseMatrix = Union[sp.csr_matrix, sp.csc_matrix, SparseDataset]\n78: DenseMatrix = Union[NPNDArray, h5py.Dataset]\n79: Matrix = Union[DenseMatrix, SparseMatrix]\n80: _NDArr = TypeVar(\"_NDArr\", bound=NDArray)\n81: _TDBO = TypeVar(\"_TDBO\", bound=TileDBObject[RawHandle])\n82: \n83: # Arrays of strings from AnnData's uns are stored in SOMA as SOMADataFrame,\n84: # since SOMA ND arrays are necessarily arrays *of numbers*. This is okay since\n85: # the one and only job of SOMA uns is to faithfully ingest from AnnData and\n86: # outgest back. These are parameters common to ingest and outgest of these.\n87: _UNS_OUTGEST_HINT_KEY = \"soma_uns_outgest_hint\"\n88: _UNS_OUTGEST_HINT_1D = \"array_1d\"\n89: _UNS_OUTGEST_HINT_2D = \"array_2d\"\n90: _UNS_OUTGEST_COLUMN_NAME_1D = \"values\"\n91: _UNS_OUTGEST_COLUMN_PREFIX_2D = \"values_\"\n92: \n93: _TILEDBSOMA_TYPE = \"soma_tiledbsoma_type\"\n94: _DATAFRAME_ORIGINAL_INDEX_NAME_JSON = \"soma_dataframe_original_index_name\"\n95: \n96: \n97: # ----------------------------------------------------------------\n98: class IngestionParams:\n99:     \"\"\"Maps from user-level ingest modes to a set of implementation-level boolean flags.\"\"\"\n100: \n101:     write_schema_no_data: bool\n102:     error_if_already_exists: bool\n103:     skip_existing_nonempty_domain: bool\n104:     appending: bool\n105: \n106:     def __init__(\n107:         self,\n108:         ingest_mode: str,\n109:         label_mapping: Optional[ExperimentAmbientLabelMapping],\n110:     ) -> None:\n111:         if ingest_mode == \"schema_only\":\n112:             self.write_schema_no_data = True\n113:             self.error_if_already_exists = True\n114:             self.skip_existing_nonempty_domain = False\n115:             self.appending = False\n116: \n117:         elif ingest_mode == \"write\":\n118:             if label_mapping is None:\n119:                 self.write_schema_no_data = False\n120:                 self.error_if_already_exists = True\n121:                 self.skip_existing_nonempty_domain = False\n122:                 self.appending = False\n123:             else:\n124:                 # append mode, but, the user supplying non-null registration information suffices\n125:                 # for us to understand \"append\"\n126:                 self.write_schema_no_data = False\n127:                 self.error_if_already_exists = False\n128:                 self.skip_existing_nonempty_domain = False\n129:                 self.appending = True\n130: \n131:         elif ingest_mode == \"resume\":\n132:             if label_mapping is None:\n133:                 self.write_schema_no_data = False\n134:                 self.error_if_already_exists = False\n135:                 self.skip_existing_nonempty_domain = True\n136:                 self.appending = False\n137:             else:\n138:                 # resume-append mode, but, the user supplying non-null registration information\n139:                 # suffices for us to understand \"resume-append\"\n140:                 self.write_schema_no_data = False\n141:                 self.error_if_already_exists = False\n142:                 self.skip_existing_nonempty_domain = True\n143:                 self.appending = True\n144: \n145:         elif ingest_mode == \"update\":\n146:             self.write_schema_no_data = False\n147:             self.error_if_already_exists = False\n148:             self.skip_existing_nonempty_domain = False\n149:             self.appending = False\n150: \n151:         else:\n152:             raise SOMAError(\n153:                 f'expected ingest_mode to be one of {INGEST_MODES}; got \"{ingest_mode}\"'\n154:             )\n155: \n156: \n157: # The tiledbsoma.io._registration package is private. These are the two sole user-facing API\n158: # entrypoints for append-mode soma_joinid registration.\n159: def register_h5ads(\n160:     experiment_uri: Optional[str],\n161:     h5ad_file_names: Sequence[str],\n162:     *,\n163:     measurement_name: str,\n164:     obs_field_name: str,\n165:     var_field_name: str,\n166:     append_obsm_varm: bool = False,\n167:     context: Optional[SOMATileDBContext] = None,\n168: ) -> ExperimentAmbientLabelMapping:\n169:     \"\"\"Extends registration data from the baseline, already-written SOMA\n170:     experiment to include multiple H5AD input files. See ``from_h5ad`` and\n171:     ``from_anndata`` on-line help.\"\"\"\n172:     return ExperimentAmbientLabelMapping.from_h5ad_appends_on_experiment(\n173:         experiment_uri=experiment_uri,\n174:         h5ad_file_names=h5ad_file_names,\n175:         measurement_name=measurement_name,\n176:         obs_field_name=obs_field_name,\n177:         var_field_name=var_field_name,\n178:         append_obsm_varm=append_obsm_varm,\n179:         context=context,\n180:     )\n181: \n182: \n183: def register_anndatas(\n184:     experiment_uri: Optional[str],\n185:     adatas: Sequence[ad.AnnData],\n186:     *,\n187:     measurement_name: str,\n188:     obs_field_name: str,\n189:     var_field_name: str,\n190:     append_obsm_varm: bool = False,\n191:     context: Optional[SOMATileDBContext] = None,\n192: ) -> ExperimentAmbientLabelMapping:\n193:     \"\"\"Extends registration data from the baseline, already-written SOMA\n194:     experiment to include multiple H5AD input files. See ``from_h5ad`` and\n195:     ``from_anndata`` on-line help.\"\"\"\n196:     return ExperimentAmbientLabelMapping.from_anndata_appends_on_experiment(\n197:         experiment_uri=experiment_uri,\n198:         adatas=adatas,\n199:         measurement_name=measurement_name,\n200:         obs_field_name=obs_field_name,\n201:         var_field_name=var_field_name,\n202:         append_obsm_varm=append_obsm_varm,\n203:         context=context,\n204:     )\n205: \n206: \n207: # This trick lets us ingest H5AD with \"r\" (backed mode) from S3 URIs.  While h5ad\n208: # supports any file-like object, AnnData specifically wants only an `os.PathLike`\n209: # object. The only thing it does with the PathLike is to use it to get the filename.\n210: class _FSPathWrapper:\n211:     \"\"\"Tricks anndata into thinking a file-like object is an ``os.PathLike``.\n212: \n213:     While h5ad supports any file-like object, anndata specifically wants\n214:     an ``os.PathLike object``, which it uses *exclusively* to get the \"filename\"\n215:     of the opened file.\n216: \n217:     We need to provide ``__fspath__`` as a real class method, so simply\n218:     setting ``some_file_obj.__fspath__ = lambda: \"some/path\"`` won't work,\n219:     so here we just proxy all attributes except ``__fspath__``.\n220:     \"\"\"\n221: \n222:     def __init__(self, obj: object, path: Path) -> None:\n223:         self._obj = obj\n224:         self._path = path\n225: \n226:     def __fspath__(self) -> Path:\n227:         return self._path\n228: \n229:     def __getattr__(self, name: str) -> object:\n230:         return getattr(self._obj, name)\n231: \n232: \n233: def _hack_patch_anndata() -> ContextManager[object]:\n234:     \"\"\"Part Two of the ``_FSPathWrapper`` trick.\"\"\"\n235: \n236:     @file_backing.AnnDataFileManager.filename.setter  # type: ignore\n237:     def filename(self: file_backing.AnnDataFileManager, filename: Path) -> None:\n238:         self._filename = filename\n239: \n240:     return mock.patch.object(file_backing.AnnDataFileManager, \"filename\", filename)\n241: \n242: \n243: def from_h5ad(\n244:     experiment_uri: str,\n245:     input_path: Path,\n246:     measurement_name: str,\n247:     *,\n248:     context: Optional[SOMATileDBContext] = None,\n249:     platform_config: Optional[PlatformConfig] = None,\n250:     obs_id_name: str = \"obs_id\",\n251:     var_id_name: str = \"var_id\",\n252:     X_layer_name: str = \"data\",\n253:     raw_X_layer_name: str = \"data\",\n254:     ingest_mode: IngestMode = \"write\",\n255:     use_relative_uri: Optional[bool] = None,\n256:     X_kind: Union[Type[SparseNDArray], Type[DenseNDArray]] = SparseNDArray,\n257:     registration_mapping: Optional[ExperimentAmbientLabelMapping] = None,\n258:     uns_keys: Optional[Sequence[str]] = None,\n259: ) -> str:\n260:     \"\"\"Reads an ``.h5ad`` file and writes it to an :class:`Experiment`.\n261: \n262:     Measurement data is stored in a :class:`Measurement` in the experiment's\n263:     ``ms`` field, with the key provided by ``measurement_name``. Data elements\n264:     are available at the standard fields (``var``, ``X``, etc.). Unstructured\n265:     data from ``uns`` is partially supported (structured arrays and non-numeric\n266:     NDArrays are skipped), and is available at the measurement's ``uns`` key\n267:     (i.e., at ``your_experiment.ms[measurement_name][\"uns\"]``).\n268: \n269:     Args:\n270:         experiment_uri: The experiment to create or update.\n271: \n272:         input_path: A path to an input H5AD file.\n273: \n274:         measurement_name: The name of the measurement to store data in.\n275: \n276:         context: Optional :class:`SOMATileDBContext` containing storage parameters, etc.\n277: \n278:         platform_config: Platform-specific options used to create this array, provided in the form\n279:         ``{\"tiledb\": {\"create\": {\"sparse_nd_array_dim_zstd_level\": 7}}}`` nested keys.\n280: \n281:         obs_id_name and var_id_name: Which AnnData ``obs`` and ``var`` columns, respectively, to use\n282:         for append mode: values of this column will be used to decide which obs/var rows in appended\n283:         inputs are distinct from the ones already stored, for the assignment of ``soma_joinid``.  If\n284:         this column exists in the input data, as a named index or a non-index column name, it will\n285:         be used. If this column doesn't exist in the input data, and if the index is nameless or\n286:         named ``index``, that index will be given this name when written to the SOMA experiment's\n287:         ``obs`` / ``var``. NOTE: it is not necessary for this column to be the index-column\n288:         name in the input AnnData objects ``obs``/``var``.\n289: \n290:         X_layer_name: SOMA array name for the AnnData's ``X`` matrix.\n291: \n292:         raw_X_layer_name: SOMA array name for the AnnData's ``raw/X`` matrix.\n293: \n294:         ingest_mode: The ingestion type to perform:\n295:             - ``write``: Writes all data, creating new layers if the SOMA already exists.\n296:             - ``resume``: Adds data to an existing SOMA, skipping writing data\n297:               that was previously written. Useful for continuing after a partial\n298:               or interrupted ingestion operation.\n299:             - ``schema_only``: Creates groups and the array schema, without\n300:               writing any data to the array. Useful to prepare for appending\n301:               multiple H5AD files to a single SOMA.\n302: \n303:         X_kind: Which type of matrix is used to store dense X data from the\n304:             H5AD file: ``DenseNDArray`` or ``SparseNDArray``.\n305: \n306:         registration_mapping: Does not need to be supplied when ingesting a single\n307:           H5AD/AnnData object into a single :class:`Experiment`. When multiple inputs\n308:           are to be ingested into a single experiment, there are two steps. First:\n309: \n310:               import tiledbsoma.io\n311:               rd = tiledbsoma.io.register_h5ads(\n312:                   experiment_uri,\n313:                   h5ad_file_names,\n314:                   measurement_name=\"RNA\",\n315:                   obs_field_name=\"obs_id\",\n316:                   var_field_name=\"var_id\",\n317:                   context=context,\n318:               )\n319: \n320:           Once that's been done, the data ingests per se may be done in any order,\n321:           or in parallel, via for each ``h5ad_file_name``:\n322: \n323:               tiledbsoma.io.from_h5ad(\n324:                   experiment_uri,\n325:                   h5ad_file_name,\n326:                   measurement_name=\"RNA\",\n327:                   ingest_mode=\"write\",\n328:                   registration_mapping=rd,\n329:               )\n330: \n331:         uns_keys: Only ingest the specified top-level ``uns`` keys.\n332:           The default is to ingest them all. Use ``uns_keys=[]``\n333:           to not ingest any ``uns`` keys.\n334: \n335:     Returns:\n336:         The URI of the newly created experiment.\n337: \n338:     Lifecycle:\n339:         Experimental.\n340:     \"\"\"\n341:     if ingest_mode not in INGEST_MODES:\n342:         raise SOMAError(\n343:             f'expected ingest_mode to be one of {INGEST_MODES}; got \"{ingest_mode}\"'\n344:         )\n345: \n346:     if isinstance(input_path, ad.AnnData):\n347:         raise TypeError(\"input path is an AnnData object -- did you want from_anndata?\")\n348: \n349:     context = _validate_soma_tiledb_context(context)\n350: \n351:     s = _util.get_start_stamp()\n352:     logging.log_io(None, f\"START  Experiment.from_h5ad {input_path}\")\n353: \n354:     with tiledb.VFS(ctx=context.tiledb_ctx).open(input_path) as input_handle:\n355:         logging.log_io(None, f\"START  READING {input_path}\")\n356:         with _hack_patch_anndata():\n357:             anndata = ad.read_h5ad(_FSPathWrapper(input_handle, input_path), \"r\")\n358:         logging.log_io(None, _util.format_elapsed(s, f\"FINISH READING {input_path}\"))\n359:         uri = from_anndata(\n360:             experiment_uri,\n361:             anndata,\n362:             measurement_name,\n363:             context=context,\n364:             platform_config=platform_config,\n365:             obs_id_name=obs_id_name,\n366:             var_id_name=var_id_name,\n367:             X_layer_name=X_layer_name,\n368:             raw_X_layer_name=raw_X_layer_name,\n369:             ingest_mode=ingest_mode,\n370:             use_relative_uri=use_relative_uri,\n371:             X_kind=X_kind,\n372:             registration_mapping=registration_mapping,\n373:             uns_keys=uns_keys,\n374:         )\n375: \n376:     logging.log_io(\n377:         None, _util.format_elapsed(s, f\"FINISH Experiment.from_h5ad {input_path} {uri}\")\n378:     )\n379:     return uri\n380: \n381: \n382: # ----------------------------------------------------------------\n383: def from_anndata(\n384:     experiment_uri: str,\n385:     anndata: ad.AnnData,\n386:     measurement_name: str,\n387:     *,\n388:     context: Optional[SOMATileDBContext] = None,\n389:     platform_config: Optional[PlatformConfig] = None,\n390:     obs_id_name: str = \"obs_id\",\n391:     var_id_name: str = \"var_id\",\n392:     X_layer_name: str = \"data\",\n393:     raw_X_layer_name: str = \"data\",\n394:     ingest_mode: IngestMode = \"write\",\n395:     use_relative_uri: Optional[bool] = None,\n396:     X_kind: Union[Type[SparseNDArray], Type[DenseNDArray]] = SparseNDArray,\n397:     registration_mapping: Optional[ExperimentAmbientLabelMapping] = None,\n398:     uns_keys: Optional[Sequence[str]] = None,\n399: ) -> str:\n400:     \"\"\"Writes an `AnnData <https://anndata.readthedocs.io/>`_ object to an :class:`Experiment`.\n401: \n402:     Usage is the same as ``from_h5ad`` except that you can use this function when the AnnData object\n403:     is already loaded into memory.\n404: \n405:     Lifecycle:\n406:         Experimental.\n407:     \"\"\"\n408:     if ingest_mode not in INGEST_MODES:\n409:         raise SOMAError(\n410:             f'expected ingest_mode to be one of {INGEST_MODES}; got \"{ingest_mode}\"'\n411:         )\n412: \n413:     # Map the user-level ingest mode to a set of implementation-level boolean flags\n414:     ingestion_params = IngestionParams(ingest_mode, registration_mapping)\n415: \n416:     if ingestion_params.appending and X_kind == DenseNDArray:\n417:         raise ValueError(\"dense X is not supported for append mode\")\n418: \n419:     if not isinstance(anndata, ad.AnnData):\n420:         raise TypeError(\n421:             \"Second argument is not an AnnData object -- did you want from_h5ad?\"\n422:         )\n423: \n424:     # For single ingest (no append):\n425:     #\n426:     # * obs, var, X, etc array indices map 1-1 to soma_joinid, soma_dim_0, soma_dim_1, etc.\n427:     #\n428:     # * There is no need to look at a particular barcode column etc.\n429:     #\n430:     # For append mode:\n431:     #\n432:     # * We require for mappings to be pre-computed and passed in\n433:     #\n434:     # * The mappings are from obs-label/var-label to soma_joinid, soma_dim_0, soma_dim_1\n435:     #   for all the H5AD/AnnData objects being ingested\n436:     #\n437:     # * Here we select out the renumberings for the obs, var, X, etc array indices\n438:     if registration_mapping is None:\n439:         jidmaps = ExperimentIDMapping.from_isolated_anndata(\n440:             anndata, measurement_name=measurement_name\n441:         )\n442:     else:\n443:         jidmaps = registration_mapping.id_mappings_for_anndata(\n444:             anndata, measurement_name=measurement_name\n445:         )\n446: \n447:     context = _validate_soma_tiledb_context(context)\n448: \n449:     # Without _at least_ an index, there is nothing to indicate the dimension indices.\n450:     if anndata.obs.index.empty or anndata.var.index.empty:\n451:         raise NotImplementedError(\"Empty AnnData.obs or AnnData.var unsupported.\")\n452: \n453:     s = _util.get_start_stamp()\n454:     logging.log_io(None, \"START  DECATEGORICALIZING\")\n455: \n456:     anndata.obs_names_make_unique()\n457:     anndata.var_names_make_unique()\n458: \n459:     logging.log_io(None, _util.format_elapsed(s, \"FINISH DECATEGORICALIZING\"))\n460: \n461:     s = _util.get_start_stamp()\n462:     logging.log_io(None, f\"START  WRITING {experiment_uri}\")\n463: \n464:     # Must be done first, to create the parent directory.\n465:     experiment = _create_or_open_collection(\n466:         Experiment, experiment_uri, ingestion_params=ingestion_params, context=context\n467:     )\n468: \n469:     # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n470:     # OBS\n471:     df_uri = _util.uri_joinpath(experiment_uri, \"obs\")\n472:     with _write_dataframe(\n473:         df_uri,\n474:         conversions.decategoricalize_obs_or_var(anndata.obs),\n475:         id_column_name=obs_id_name,\n476:         platform_config=platform_config,\n477:         context=context,\n478:         ingestion_params=ingestion_params,\n479:         axis_mapping=jidmaps.obs_axis,\n480:     ) as obs:\n481:         _maybe_set(experiment, \"obs\", obs, use_relative_uri=use_relative_uri)\n482: \n483:     # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n484:     # MS\n485: \n486:     # For local disk and S3, this is the same as experiment.ms.uri.\n487:     # For ingest_mode=\"resume\" on TileDB Cloud, experiment_uri will be of the form\n488:     # tiledb://namespace/s3://bucket/path/to/exp whereas experiment.ms.uri will\n489:     # be of the form tiledb://namespace/uuid. Only for the former is it suitable\n490:     # to append \"/ms\" so that is what we do here.\n491:     experiment_ms_uri = f\"{experiment_uri}/ms\"\n492: \n493:     with _create_or_open_collection(\n494:         Collection[Measurement],\n495:         experiment_ms_uri,\n496:         ingestion_params=ingestion_params,\n497:         context=context,\n498:     ) as ms:\n499:         _maybe_set(experiment, \"ms\", ms, use_relative_uri=use_relative_uri)\n500: \n501:         # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n502:         # MS/meas\n503:         measurement_uri = _util.uri_joinpath(experiment_ms_uri, measurement_name)\n504:         with _create_or_open_collection(\n505:             Measurement,\n506:             measurement_uri,\n507:             ingestion_params=ingestion_params,\n508:             context=context,\n509:         ) as measurement:\n510:             _maybe_set(\n511:                 ms, measurement_name, measurement, use_relative_uri=use_relative_uri\n512:             )\n513: \n514:             # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n515:             # ms/meas/uns\n516:             _maybe_ingest_uns(\n517:                 measurement,\n518:                 anndata.uns,\n519:                 platform_config=platform_config,\n520:                 context=context,\n521:                 ingestion_params=ingestion_params,\n522:                 use_relative_uri=use_relative_uri,\n523:                 uns_keys=uns_keys,\n524:             )\n525: \n526:             # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n527:             # MS/meas/VAR\n528:             with _write_dataframe(\n529:                 _util.uri_joinpath(measurement_uri, \"var\"),\n530:                 conversions.decategoricalize_obs_or_var(anndata.var),\n531:                 id_column_name=var_id_name,\n532:                 platform_config=platform_config,\n533:                 context=context,\n534:                 ingestion_params=ingestion_params,\n535:                 # Layer existence is pre-checked in the registration phase\n536:                 axis_mapping=jidmaps.var_axes[measurement_name],\n537:             ) as var:\n538:                 _maybe_set(measurement, \"var\", var, use_relative_uri=use_relative_uri)\n539: \n540:             # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n541:             # MS/meas/X/DATA\n542: \n543:             measurement_X_uri = _util.uri_joinpath(measurement_uri, \"X\")\n544:             with _create_or_open_collection(\n545:                 Collection,\n546:                 measurement_X_uri,\n547:                 ingestion_params=ingestion_params,\n548:                 context=context,\n549:             ) as x:\n550:                 _maybe_set(measurement, \"X\", x, use_relative_uri=use_relative_uri)\n551: \n552:                 # Since we did ``anndata = ad.read_h5ad(path_to_h5ad, \"r\")`` with the \"r\":\n553:                 # * If we do ``anndata.X[:]`` we're loading all of a CSR/CSC/etc into memory.\n554:                 # * If we do ``anndata.X`` we're getting a pageable object which can be loaded\n555:                 #   chunkwise into memory.\n556:                 # Using the latter allows us to ingest larger .h5ad files without OOMing.\n557: \n558:                 # Some AnnData objects have no X at all. This might be a missing attribute\n559:                 # anndata.X; it might be anndata.X present, but with value None.\n560:                 try:\n561:                     has_X = anndata.X is not None\n562:                 except (NameError, KeyError):\n563:                     # We need to check both -- different exception types occur dependinng\n564:                     # on whether the anndata object is read in backing mode or not.\n565:                     has_X = False\n566: \n567:                 if has_X:\n568:                     with _create_from_matrix(\n569:                         X_kind,\n570:                         _util.uri_joinpath(measurement_X_uri, X_layer_name),\n571:                         anndata.X,\n572:                         ingestion_params=ingestion_params,\n573:                         platform_config=platform_config,\n574:                         context=context,\n575:                         axis_0_mapping=jidmaps.obs_axis,\n576:                         axis_1_mapping=jidmaps.var_axes[measurement_name],\n577:                     ) as data:\n578:                         _maybe_set(\n579:                             x, X_layer_name, data, use_relative_uri=use_relative_uri\n580:                         )\n581: \n582:                 for layer_name, layer in anndata.layers.items():\n583:                     with _create_from_matrix(\n584:                         X_kind,\n585:                         _util.uri_joinpath(measurement_X_uri, layer_name),\n586:                         layer,\n587:                         ingestion_params=ingestion_params,\n588:                         platform_config=platform_config,\n589:                         context=context,\n590:                         axis_0_mapping=jidmaps.obs_axis,\n591:                         axis_1_mapping=jidmaps.var_axes[measurement_name],\n592:                     ) as layer_data:\n593:                         _maybe_set(\n594:                             x, layer_name, layer_data, use_relative_uri=use_relative_uri\n595:                         )\n596: \n597:                 # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n598:                 # MS/meas/OBSM,VARM,OBSP,VARP\n599:                 if len(anndata.obsm.keys()) > 0:  # do not create an empty collection\n600:                     obsm_uri = _util.uri_joinpath(measurement_uri, \"obsm\")\n601:                     with _create_or_open_collection(\n602:                         Collection,\n603:                         obsm_uri,\n604:                         ingestion_params=ingestion_params,\n605:                         context=context,\n606:                     ) as obsm:\n607:                         _maybe_set(\n608:                             measurement, \"obsm\", obsm, use_relative_uri=use_relative_uri\n609:                         )\n610:                         for key in anndata.obsm.keys():\n611:                             num_cols = anndata.obsm[key].shape[1]\n612:                             with _create_from_matrix(\n613:                                 # TODO (https://github.com/single-cell-data/TileDB-SOMA/issues/1245):\n614:                                 # consider a use-dense flag at the tiledbsoma.io API\n615:                                 # DenseNDArray,\n616:                                 SparseNDArray,\n617:                                 _util.uri_joinpath(obsm.uri, key),\n618:                                 conversions.to_tiledb_supported_array_type(\n619:                                     key, anndata.obsm[key]\n620:                                 ),\n621:                                 ingestion_params=ingestion_params,\n622:                                 platform_config=platform_config,\n623:                                 context=context,\n624:                                 axis_0_mapping=jidmaps.obs_axis,\n625:                                 axis_1_mapping=AxisIDMapping.identity(num_cols),\n626:                             ) as arr:\n627:                                 _maybe_set(\n628:                                     obsm, key, arr, use_relative_uri=use_relative_uri\n629:                                 )\n630:                             arr.close()\n631:                     measurement.obsm.close()\n632: \n633:                 if len(anndata.varm.keys()) > 0:  # do not create an empty collection\n634:                     _util.uri_joinpath(measurement_uri, \"varm\")\n635:                     with _create_or_open_collection(\n636:                         Collection,\n637:                         _util.uri_joinpath(measurement.uri, \"varm\"),\n638:                         ingestion_params=ingestion_params,\n639:                         context=context,\n640:                     ) as varm:\n641:                         _maybe_set(\n642:                             measurement, \"varm\", varm, use_relative_uri=use_relative_uri\n643:                         )\n644:                         for key in anndata.varm.keys():\n645:                             num_cols = anndata.varm[key].shape[1]\n646:                             with _create_from_matrix(\n647:                                 # TODO (https://github.com/single-cell-data/TileDB-SOMA/issues/1245):\n648:                                 # consider a use-dense flag at the tiledbsoma.io API\n649:                                 # DenseNDArray,\n650:                                 SparseNDArray,\n651:                                 _util.uri_joinpath(varm.uri, key),\n652:                                 conversions.to_tiledb_supported_array_type(\n653:                                     key, anndata.varm[key]\n654:                                 ),\n655:                                 ingestion_params=ingestion_params,\n656:                                 platform_config=platform_config,\n657:                                 context=context,\n658:                                 axis_0_mapping=jidmaps.var_axes[measurement_name],\n659:                                 axis_1_mapping=AxisIDMapping.identity(num_cols),\n660:                             ) as darr:\n661:                                 _maybe_set(\n662:                                     varm,\n663:                                     key,\n664:                                     darr,\n665:                                     use_relative_uri=use_relative_uri,\n666:                                 )\n667: \n668:                 if len(anndata.obsp.keys()) > 0:  # do not create an empty collection\n669:                     _util.uri_joinpath(measurement_uri, \"obsp\")\n670:                     with _create_or_open_collection(\n671:                         Collection,\n672:                         _util.uri_joinpath(measurement.uri, \"obsp\"),\n673:                         ingestion_params=ingestion_params,\n674:                         context=context,\n675:                     ) as obsp:\n676:                         _maybe_set(\n677:                             measurement, \"obsp\", obsp, use_relative_uri=use_relative_uri\n678:                         )\n679:                         for key in anndata.obsp.keys():\n680:                             with _create_from_matrix(\n681:                                 SparseNDArray,\n682:                                 _util.uri_joinpath(obsp.uri, key),\n683:                                 conversions.to_tiledb_supported_array_type(\n684:                                     key, anndata.obsp[key]\n685:                                 ),\n686:                                 ingestion_params=ingestion_params,\n687:                                 platform_config=platform_config,\n688:                                 context=context,\n689:                                 axis_0_mapping=jidmaps.obs_axis,\n690:                                 axis_1_mapping=jidmaps.obs_axis,\n691:                             ) as sarr:\n692:                                 _maybe_set(\n693:                                     obsp,\n694:                                     key,\n695:                                     sarr,\n696:                                     use_relative_uri=use_relative_uri,\n697:                                 )\n698: \n699:                 if len(anndata.varp.keys()) > 0:  # do not create an empty collection\n700:                     _util.uri_joinpath(measurement_uri, \"obsp\")\n701:                     with _create_or_open_collection(\n702:                         Collection,\n703:                         _util.uri_joinpath(measurement.uri, \"varp\"),\n704:                         ingestion_params=ingestion_params,\n705:                         context=context,\n706:                     ) as varp:\n707:                         _maybe_set(\n708:                             measurement, \"varp\", varp, use_relative_uri=use_relative_uri\n709:                         )\n710:                         for key in anndata.varp.keys():\n711:                             with _create_from_matrix(\n712:                                 SparseNDArray,\n713:                                 _util.uri_joinpath(varp.uri, key),\n714:                                 conversions.to_tiledb_supported_array_type(\n715:                                     key, anndata.varp[key]\n716:                                 ),\n717:                                 ingestion_params=ingestion_params,\n718:                                 platform_config=platform_config,\n719:                                 context=context,\n720:                                 axis_0_mapping=jidmaps.var_axes[measurement_name],\n721:                                 axis_1_mapping=jidmaps.var_axes[measurement_name],\n722:                             ) as sarr:\n723:                                 _maybe_set(\n724:                                     varp,\n725:                                     key,\n726:                                     sarr,\n727:                                     use_relative_uri=use_relative_uri,\n728:                                 )\n729: \n730:                 # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n731:                 # MS/RAW\n732:                 if anndata.raw is not None:\n733:                     raw_uri = _util.uri_joinpath(experiment_ms_uri, \"raw\")\n734:                     with _create_or_open_collection(\n735:                         Measurement,\n736:                         raw_uri,\n737:                         ingestion_params=ingestion_params,\n738:                         context=context,\n739:                     ) as raw_measurement:\n740:                         _maybe_set(\n741:                             ms,\n742:                             \"raw\",\n743:                             raw_measurement,\n744:                             use_relative_uri=use_relative_uri,\n745:                         )\n746: \n747:                         with _write_dataframe(\n748:                             _util.uri_joinpath(raw_uri, \"var\"),\n749:                             conversions.decategoricalize_obs_or_var(anndata.raw.var),\n750:                             id_column_name=var_id_name,\n751:                             ingestion_params=ingestion_params,\n752:                             platform_config=platform_config,\n753:                             context=context,\n754:                             axis_mapping=jidmaps.var_axes[\"raw\"],\n755:                         ) as var:\n756:                             _maybe_set(\n757:                                 raw_measurement,\n758:                                 \"var\",\n759:                                 var,\n760:                                 use_relative_uri=use_relative_uri,\n761:                             )\n762: \n763:                         raw_X_uri = _util.uri_joinpath(raw_uri, \"X\")\n764:                         with _create_or_open_collection(\n765:                             Collection,\n766:                             raw_X_uri,\n767:                             ingestion_params=ingestion_params,\n768:                             context=context,\n769:                         ) as rm_x:\n770:                             _maybe_set(\n771:                                 raw_measurement,\n772:                                 \"X\",\n773:                                 rm_x,\n774:                                 use_relative_uri=use_relative_uri,\n775:                             )\n776: \n777:                             with _create_from_matrix(\n778:                                 SparseNDArray,\n779:                                 _util.uri_joinpath(raw_X_uri, raw_X_layer_name),\n780:                                 anndata.raw.X,\n781:                                 ingestion_params=ingestion_params,\n782:                                 platform_config=platform_config,\n783:                                 context=context,\n784:                                 axis_0_mapping=jidmaps.obs_axis,\n785:                                 axis_1_mapping=jidmaps.var_axes[\"raw\"],\n786:                             ) as rm_x_data:\n787:                                 _maybe_set(\n788:                                     rm_x,\n789:                                     raw_X_layer_name,\n790:                                     rm_x_data,\n791:                                     use_relative_uri=use_relative_uri,\n792:                                 )\n793: \n794:     experiment.close()\n795: \n796:     logging.log_io(\n797:         f\"Wrote   {experiment.uri}\",\n798:         _util.format_elapsed(s, f\"FINISH WRITING {experiment.uri}\"),\n799:     )\n800:     return experiment.uri\n801: \n802: \n803: def append_obs(\n804:     exp: Experiment,\n805:     new_obs: pd.DataFrame,\n806:     *,\n807:     obs_id_name: str = \"obs_id\",\n808:     registration_mapping: ExperimentAmbientLabelMapping,\n809:     context: Optional[SOMATileDBContext] = None,\n810:     platform_config: Optional[PlatformConfig] = None,\n811: ) -> str:\n812:     \"\"\"\n813:     Writes new rows to an existing ``obs`` dataframe. (This is distinct from ``update_obs``\n814:     which mutates the entirety of the ``obs`` dataframe, e.g. to add/remove columns.)\n815: \n816:     Example:\n817: \n818:         rd = tiledbsoma.io.register_anndatas(\n819:             exp_uri,\n820:             [new_anndata],\n821:             measurement_name=\"RNA\",\n822:             obs_field_name=\"obs_id\",\n823:             var_field_name=\"var_id\",\n824:         )\n825: \n826:         with tiledbsoma.Experiment.open(exp_uri, \"w\") as exp:\n827:             tiledbsoma.io.append_obs(\n828:                 exp, new_anndata.obs, registration_mapping=rd,\n829:             )\n830: \n831:     Lifecycle:\n832:         Experimental.\n833:     \"\"\"\n834:     if exp.closed or exp.mode != \"w\":\n835:         raise SOMAError(f\"Experiment must be open for write: {exp.uri}\")\n836: \n837:     # Map the user-level ingest mode to a set of implementation-level boolean flags.\n838:     # See comments in from_anndata.\n839:     context = _validate_soma_tiledb_context(context)\n840:     ingestion_params = IngestionParams(\"write\", registration_mapping)\n841:     jidmap = registration_mapping.obs_axis.id_mapping_from_dataframe(new_obs)\n842: \n843:     s = _util.get_start_stamp()\n844:     logging.log_io_same(f\"Start  writing obs for {exp.obs.uri}\")\n845: \n846:     with _write_dataframe(\n847:         exp.obs.uri,\n848:         conversions.decategoricalize_obs_or_var(new_obs),\n849:         id_column_name=obs_id_name,\n850:         platform_config=platform_config,\n851:         context=context,\n852:         ingestion_params=ingestion_params,\n853:         axis_mapping=jidmap,\n854:     ):\n855:         logging.log_io_same(\n856:             _util.format_elapsed(s, f\"Finish writing obs for {exp.obs.uri}\")\n857:         )\n858:     return exp.obs.uri\n859: \n860: \n861: def append_var(\n862:     exp: Experiment,\n863:     new_var: pd.DataFrame,\n864:     measurement_name: str,\n865:     *,\n866:     var_id_name: str = \"var_id\",\n867:     registration_mapping: ExperimentAmbientLabelMapping,\n868:     context: Optional[SOMATileDBContext] = None,\n869:     platform_config: Optional[PlatformConfig] = None,\n870: ) -> str:\n871:     \"\"\"\n872:     Writes new rows to an existing ``obs`` dataframe. (This is distinct from ``update_obs``\n873:     which mutates the entirety of the ``obs`` dataframe, e.g. to add/remove columns.)\n874: \n875:     Example:\n876: \n877:         rd = tiledbsoma.io.register_anndatas(\n878:             exp_uri,\n879:             [new_anndata],\n880:             measurement_name=\"RNA\",\n881:             obs_field_name=\"obs_id\",\n882:             var_field_name=\"var_id\",\n883:         )\n884: \n885:         with tiledbsoma.Experiment.open(exp_uri, \"w\") as exp:\n886:             tiledbsoma.io.append_var(\n887:                 exp, a2.var, measurement_name=\"RNA\", registration_mapping=rd,\n888:             )\n889: \n890:     Lifecycle:\n891:         Experimental.\n892:     \"\"\"\n893:     if exp.closed or exp.mode != \"w\":\n894:         raise SOMAError(f\"Experiment must be open for write: {exp.uri}\")\n895:     if measurement_name not in exp.ms:\n896:         raise SOMAError(\n897:             f\"Experiment {exp.uri} has no measurement named {measurement_name}\"\n898:         )\n899:     sdf = exp.ms[measurement_name].var\n900: \n901:     # Map the user-level ingest mode to a set of implementation-level boolean flags.\n902:     # See comments in from_anndata.\n903:     context = _validate_soma_tiledb_context(context)\n904:     ingestion_params = IngestionParams(\"write\", registration_mapping)\n905:     jidmap = registration_mapping.var_axes[measurement_name].id_mapping_from_dataframe(\n906:         new_var\n907:     )\n908: \n909:     s = _util.get_start_stamp()\n910:     logging.log_io_same(f\"Start  writing var for {sdf.uri}\")\n911: \n912:     with _write_dataframe(\n913:         sdf.uri,\n914:         conversions.decategoricalize_obs_or_var(new_var),\n915:         id_column_name=var_id_name,\n916:         platform_config=platform_config,\n917:         context=context,\n918:         ingestion_params=ingestion_params,\n919:         axis_mapping=jidmap,\n920:     ):\n921:         logging.log_io_same(\n922:             _util.format_elapsed(s, f\"Finish writing var for {sdf.uri}\")\n923:         )\n924:     return sdf.uri\n925: \n926: \n927: def append_X(\n928:     exp: Experiment,\n929:     new_X: Union[Matrix, h5py.Dataset],\n930:     measurement_name: str,\n931:     X_layer_name: str,\n932:     obs_ids: Sequence[str],\n933:     var_ids: Sequence[str],\n934:     *,\n935:     registration_mapping: ExperimentAmbientLabelMapping,\n936:     X_kind: Union[Type[SparseNDArray], Type[DenseNDArray]] = SparseNDArray,\n937:     context: Optional[SOMATileDBContext] = None,\n938:     platform_config: Optional[PlatformConfig] = None,\n939: ) -> str:\n940:     \"\"\"\n941:     Appends new data to an existing ``X`` matrix. Nominally to be used in conjunction\n942:     with ``update_obs`` and ``update_var``, as an itemized alternative to doing\n943:     ``from_anndata`` with a registration mapping supplied.\n944: \n945:     Example:\n946: \n947:         rd = tiledbsoma.io.register_anndatas(\n948:             exp_uri,\n949:             [new_anndata],\n950:             measurement_name=\"RNA\",\n951:             obs_field_name=\"obs_id\",\n952:             var_field_name=\"var_id\",\n953:         )\n954: \n955: \n956:         with tiledbsoma.Experiment.open(exp_uri) as exp:\n957:             tiledbsoma.io.append_X(\n958:                 exp,\n959:                 new_X=adata.X,\n960:                 measurement_name=measurement_name,\n961:                 X_layer_name=X_layer_name,\n962:                 obs_ids=list(new_anndata.obs.index),\n963:                 var_ids=list(new_anndata.var.index),\n964:                 registration_mapping=rd,\n965:             )\n966: \n967:     Lifecycle:\n968:         Experimental.\n969:     \"\"\"\n970:     if exp.closed or exp.mode != \"w\":\n971:         raise SOMAError(f\"Experiment must be open for write: {exp.uri}\")\n972:     if measurement_name not in exp.ms:\n973:         raise SOMAError(\n974:             f\"Experiment {exp.uri} has no measurement named {measurement_name}\"\n975:         )\n976:     if X_layer_name not in exp.ms[measurement_name].X:\n977:         raise SOMAError(\n978:             f\"Experiment {exp.uri} has no X layer named {X_layer_name} in measurement {measurement_name}\"\n979:         )\n980:     X = exp.ms[measurement_name].X[X_layer_name]\n981: \n982:     # Map the user-level ingest mode to a set of implementation-level boolean flags.\n983:     # See comments in from_anndata.\n984:     ingestion_params = IngestionParams(\"write\", registration_mapping)\n985:     context = _validate_soma_tiledb_context(context)\n986: \n987:     s = _util.get_start_stamp()\n988:     logging.log_io_same(f\"Start  writing var for {X.uri}\")\n989: \n990:     axis_0_mapping = registration_mapping.obs_axis.id_mapping_from_values(obs_ids)\n991:     axis_1_mapping = registration_mapping.var_axes[\n992:         measurement_name\n993:     ].id_mapping_from_values(var_ids)\n994: \n995:     with _create_from_matrix(\n996:         X_kind,\n997:         X.uri,\n998:         new_X,\n999:         ingestion_params=ingestion_params,\n1000:         platform_config=platform_config,\n1001:         context=context,\n1002:         axis_0_mapping=axis_0_mapping,\n1003:         axis_1_mapping=axis_1_mapping,\n1004:     ):\n1005:         logging.log_io_same(_util.format_elapsed(s, f\"Finish writing X for {X.uri}\"))\n1006:     return X.uri\n1007: \n1008: \n1009: def _maybe_set(\n1010:     coll: AnyTileDBCollection,\n1011:     key: str,\n1012:     value: AnyTileDBObject,\n1013:     *,\n1014:     use_relative_uri: Optional[bool],\n1015: ) -> None:\n1016:     if coll.closed or coll.mode != \"w\":\n1017:         raise SOMAError(f\"Collection must be open for write: {coll.uri}\")\n1018:     try:\n1019:         coll.set(key, value, use_relative_uri=use_relative_uri)\n1020:     except SOMAError:\n1021:         # This is already a member of the collection.\n1022:         pass\n1023: \n1024: \n1025: @overload\n1026: def _create_or_open_collection(\n1027:     cls: Type[Experiment],\n1028:     uri: str,\n1029:     *,\n1030:     ingestion_params: IngestionParams,\n1031:     context: Optional[SOMATileDBContext],\n1032: ) -> Experiment:\n1033:     ...\n1034: \n1035: \n1036: @overload\n1037: def _create_or_open_collection(\n1038:     cls: Type[Measurement],\n1039:     uri: str,\n1040:     *,\n1041:     ingestion_params: IngestionParams,\n1042:     context: Optional[SOMATileDBContext],\n1043: ) -> Measurement:\n1044:     ...\n1045: \n1046: \n1047: @overload\n1048: def _create_or_open_collection(\n1049:     cls: Type[Collection[_TDBO]],\n1050:     uri: str,\n1051:     *,\n1052:     ingestion_params: IngestionParams,\n1053:     context: Optional[SOMATileDBContext],\n1054: ) -> Collection[_TDBO]:\n1055:     ...\n1056: \n1057: \n1058: @typeguard_ignore\n1059: def _create_or_open_collection(\n1060:     cls: Type[Any],\n1061:     uri: str,\n1062:     *,\n1063:     ingestion_params: IngestionParams,\n1064:     context: Optional[SOMATileDBContext],\n1065: ) -> Any:\n1066:     try:\n1067:         thing = cls.open(uri, \"w\", context=context)\n1068:     except DoesNotExistError:\n1069:         pass  # This is always OK; make a new one.\n1070:     else:\n1071:         # It already exists. Are we resuming?\n1072:         if ingestion_params.error_if_already_exists:\n1073:             raise SOMAError(f\"{uri} already exists\")\n1074:         return thing\n1075: \n1076:     return cls.create(uri, context=context)\n1077: \n1078: \n1079: # Spellings compatible with 1.2.7:\n1080: @overload\n1081: def _create_or_open_coll(\n1082:     cls: Type[Experiment],\n1083:     uri: str,\n1084:     *,\n1085:     ingest_mode: str,\n1086:     context: Optional[SOMATileDBContext],\n1087: ) -> Experiment:\n1088:     ...\n1089: \n1090: \n1091: @overload\n1092: def _create_or_open_coll(\n1093:     cls: Type[Measurement],\n1094:     uri: str,\n1095:     *,\n1096:     ingest_mode: str,\n1097:     context: Optional[SOMATileDBContext],\n1098: ) -> Measurement:\n1099:     ...\n1100: \n1101: \n1102: @overload\n1103: def _create_or_open_coll(\n1104:     cls: Type[Collection[_TDBO]],\n1105:     uri: str,\n1106:     *,\n1107:     ingest_mode: str,\n1108:     context: Optional[SOMATileDBContext],\n1109: ) -> Collection[_TDBO]:\n1110:     ...\n1111: \n1112: \n1113: @typeguard_ignore\n1114: def _create_or_open_coll(\n1115:     cls: Type[Any],\n1116:     uri: str,\n1117:     *,\n1118:     ingest_mode: str,\n1119:     context: Optional[SOMATileDBContext],\n1120: ) -> Any:\n1121:     return _create_or_open_collection(\n1122:         cls,\n1123:         uri,\n1124:         ingestion_params=IngestionParams(ingest_mode=ingest_mode, label_mapping=None),\n1125:         context=context,\n1126:     )\n1127: \n1128: \n1129: def _extract_new_values_for_append(\n1130:     df_uri: str,\n1131:     arrow_table: pa.Table,\n1132:     id_column_name: str,\n1133:     context: Optional[SOMATileDBContext] = None,\n1134: ) -> pa.Table:\n1135:     \"\"\"\n1136:     For append mode: mostly we just go ahead and write the data, except var.\n1137:     Nominally:\n1138: \n1139:     * Cell IDs (obs IDs) are distinct per input\n1140:       o This means \"obs grows down\"\n1141:     * Gene IDs (var IDs) are almost all the same per input\n1142:       o This means \"var gets stacked\"\n1143:     * X is obs x var\n1144:       o This means \"X grows down\"\n1145:     * obsm is obs x M, and varm is var x N\n1146:       o This means means they \"grow down\"\n1147:     * obsp is obs x obs, and varp is var x var\n1148:       o This means means they _would_ grow block-diagonally -- but\n1149:         (for biological reasons) we disallow append of obsp and varp\n1150: \n1151:     Reviewing the above, we can see that \"just write the data\" is almost always the right way to\n1152:     append -- except for var. There, if there are 100 H5ADs appending into a single SOMA experiment,\n1153:     we don't want 100 TileDB fragment-layers of mostly the same data -- we just want to write the\n1154:     _new_ genes not yet seen before (if any).\n1155:     \"\"\"\n1156:     try:\n1157:         with _factory.open(\n1158:             df_uri, \"r\", soma_type=DataFrame, context=context\n1159:         ) as previous_soma_dataframe:\n1160:             previous_table = previous_soma_dataframe.read().concat()\n1161:             previous_df = previous_table.to_pandas()\n1162:             previous_join_ids = set(\n1163:                 int(e) for e in get_dataframe_values(previous_df, SOMA_JOINID)\n1164:             )\n1165:             mask = [\n1166:                 e.as_py() not in previous_join_ids for e in arrow_table[SOMA_JOINID]\n1167:             ]\n1168:             return arrow_table.filter(mask)\n1169:     except DoesNotExistError:\n1170:         return arrow_table\n1171: \n1172: \n1173: def _write_arrow_table(\n1174:     arrow_table: pa.Table,\n1175:     handle: Union[DataFrame, SparseNDArray],\n1176:     tiledb_create_options: TileDBCreateOptions,\n1177: ) -> None:\n1178:     \"\"\"Handles num-bytes capacity for remote object stores.\"\"\"\n1179:     cap = tiledb_create_options.remote_cap_nbytes\n1180:     if arrow_table.nbytes > cap:\n1181:         n = len(arrow_table)\n1182:         if n < 2:\n1183:             raise SOMAError(\n1184:                 \"single table row nbytes {arrow_table.nbytes} exceeds cap nbytes {cap}\"\n1185:             )\n1186:         m = n // 2\n1187:         _write_arrow_table(arrow_table[:m], handle, tiledb_create_options)\n1188:         _write_arrow_table(arrow_table[m:], handle, tiledb_create_options)\n1189:     else:\n1190:         logging.log_io(\n1191:             None,\n1192:             f\"Write Arrow table num_rows={len(arrow_table)} num_bytes={arrow_table.nbytes} cap={cap}\",\n1193:         )\n1194:         handle.write(arrow_table)\n1195: \n1196: \n1197: def _write_dataframe(\n1198:     df_uri: str,\n1199:     df: pd.DataFrame,\n1200:     id_column_name: Optional[str],\n1201:     *,\n1202:     ingestion_params: IngestionParams,\n1203:     platform_config: Optional[PlatformConfig] = None,\n1204:     context: Optional[SOMATileDBContext] = None,\n1205:     axis_mapping: AxisIDMapping,\n1206: ) -> DataFrame:\n1207:     \"\"\"\n1208:     The id_column_name is for disambiguating rows in append mode;\n1209:     it may or may not be an index name in the input AnnData obs/var.\n1210: \n1211:     The original_index_name is the index name in the AnnData obs/var.\n1212: \n1213:     This helper mutates the input dataframe, for parsimony of memory usage.\n1214:     The caller should have copied anything pointing to a user-provided\n1215:     adata.obs, adata.var, etc.\n1216:     \"\"\"\n1217:     original_index_name = None\n1218:     if df.index is not None and df.index.name is not None and df.index.name != \"index\":\n1219:         original_index_name = df.index.name\n1220: \n1221:     df.reset_index(inplace=True)\n1222:     if id_column_name is not None:\n1223:         if id_column_name in df:\n1224:             if \"index\" in df:\n1225:                 df.drop(columns=[\"index\"], inplace=True)\n1226:         else:\n1227:             df.rename(columns={\"index\": id_column_name}, inplace=True)\n1228: \n1229:     df[SOMA_JOINID] = np.asarray(axis_mapping.data, dtype=np.int64)\n1230: \n1231:     df.set_index(SOMA_JOINID, inplace=True)\n1232: \n1233:     return _write_dataframe_impl(\n1234:         df,\n1235:         df_uri,\n1236:         id_column_name,\n1237:         ingestion_params=ingestion_params,\n1238:         original_index_name=original_index_name,\n1239:         platform_config=platform_config,\n1240:         context=context,\n1241:     )\n1242: \n1243: \n1244: def _write_dataframe_impl(\n1245:     df: pd.DataFrame,\n1246:     df_uri: str,\n1247:     id_column_name: Optional[str],\n1248:     *,\n1249:     ingestion_params: IngestionParams,\n1250:     original_index_name: Optional[str] = None,\n1251:     platform_config: Optional[PlatformConfig] = None,\n1252:     context: Optional[SOMATileDBContext] = None,\n1253: ) -> DataFrame:\n1254:     s = _util.get_start_stamp()\n1255:     logging.log_io(None, f\"START  WRITING {df_uri}\")\n1256: \n1257:     arrow_table = df_to_arrow(df)\n1258: \n1259:     # Don't many-layer the almost-always-repeated var dataframe.\n1260:     # And for obs, if there are duplicate values for whatever reason, don't write them\n1261:     # when appending.\n1262:     if ingestion_params.appending:\n1263:         if id_column_name is None:\n1264:             # Nominally, nil id_column_name only happens for uns append and we do not append uns,\n1265:             # which is a concern for our caller. This is a second-level check.\n1266:             raise ValueError(\"internal coding error: id_column_name unspecified\")\n1267:         arrow_table = _extract_new_values_for_append(\n1268:             df_uri, arrow_table, id_column_name, context\n1269:         )\n1270: \n1271:     try:\n1272:         soma_df = _factory.open(df_uri, \"w\", soma_type=DataFrame, context=context)\n1273:     except DoesNotExistError:\n1274:         soma_df = DataFrame.create(\n1275:             df_uri,\n1276:             schema=arrow_table.schema,\n1277:             platform_config=platform_config,\n1278:             context=context,\n1279:         )\n1280:     else:\n1281:         if ingestion_params.skip_existing_nonempty_domain:\n1282:             storage_ned = _read_nonempty_domain(soma_df)\n1283:             dim_range = ((int(df.index.min()), int(df.index.max())),)\n1284:             if _chunk_is_contained_in(dim_range, storage_ned):\n1285:                 logging.log_io(\n1286:                     f\"Skipped {soma_df.uri}\",\n1287:                     _util.format_elapsed(s, f\"SKIPPED {soma_df.uri}\"),\n1288:                 )\n1289:                 return soma_df\n1290:         elif ingestion_params.error_if_already_exists:\n1291:             raise SOMAError(f\"{soma_df.uri} already exists\")\n1292: \n1293:     if ingestion_params.write_schema_no_data:\n1294:         logging.log_io(\n1295:             f\"Wrote schema {soma_df.uri}\",\n1296:             _util.format_elapsed(s, f\"FINISH WRITING SCHEMA {soma_df.uri}\"),\n1297:         )\n1298:         return soma_df\n1299: \n1300:     tiledb_create_options = TileDBCreateOptions.from_platform_config(platform_config)\n1301: \n1302:     _write_arrow_table(arrow_table, soma_df, tiledb_create_options)\n1303: \n1304:     # Save the original index name for outgest. We use JSON for elegant indication of index name\n1305:     # being None (in Python anyway).\n1306:     soma_df.metadata[_DATAFRAME_ORIGINAL_INDEX_NAME_JSON] = json.dumps(\n1307:         original_index_name\n1308:     )\n1309: \n1310:     logging.log_io(\n1311:         f\"Wrote   {soma_df.uri}\",\n1312:         _util.format_elapsed(s, f\"FINISH WRITING {soma_df.uri}\"),\n1313:     )\n1314:     return soma_df\n1315: \n1316: \n1317: @typeguard_ignore\n1318: def create_from_matrix(\n1319:     cls: Type[_NDArr],\n1320:     uri: str,\n1321:     matrix: Union[Matrix, h5py.Dataset],\n1322:     platform_config: Optional[PlatformConfig] = None,\n1323:     ingest_mode: IngestMode = \"write\",\n1324:     context: Optional[SOMATileDBContext] = None,\n1325: ) -> _NDArr:\n1326:     \"\"\"\n1327:     Create and populate the ``soma_matrix`` from the contents of ``matrix``.\n1328: \n1329:     Lifecycle:\n1330:         Experimental.\n1331:     \"\"\"\n1332:     return _create_from_matrix(\n1333:         cls,\n1334:         uri,\n1335:         matrix,\n1336:         ingestion_params=IngestionParams(ingest_mode, None),\n1337:         platform_config=platform_config,\n1338:         context=context,\n1339:         axis_0_mapping=AxisIDMapping.identity(matrix.shape[0]),\n1340:         axis_1_mapping=AxisIDMapping.identity(matrix.shape[1]),\n1341:     )\n1342: \n1343: \n1344: @typeguard_ignore\n1345: def _create_from_matrix(\n1346:     cls: Type[_NDArr],\n1347:     uri: str,\n1348:     matrix: Union[Matrix, h5py.Dataset],\n1349:     *,\n1350:     ingestion_params: IngestionParams,\n1351:     platform_config: Optional[PlatformConfig] = None,\n1352:     context: Optional[SOMATileDBContext] = None,\n1353:     axis_0_mapping: AxisIDMapping,\n1354:     axis_1_mapping: AxisIDMapping,\n1355: ) -> _NDArr:\n1356:     \"\"\"\n1357:     Internal helper for user-facing ``create_from_matrix``.\n1358:     \"\"\"\n1359:     # SparseDataset has no ndim but it has a shape\n1360:     if len(matrix.shape) != 2:\n1361:         raise ValueError(f\"expected matrix.shape == 2; got {matrix.shape}\")\n1362: \n1363:     s = _util.get_start_stamp()\n1364:     logging.log_io(None, f\"START  WRITING {uri}\")\n1365: \n1366:     try: