\n        # Check the specific assertions from the requirements\n        print(\"\\n\\nChecking specific assertions:\")\n        with tiledb.open(exp.obs.uri, \"r\") as obs:\n            print(f\"  obs.attr('empty_categorical_all').isnullable = {obs.attr('empty_categorical_all').isnullable}\")\n            print(f\"  obs.attr('empty_categorical_partial').isnullable = {obs.attr('empty_categorical_partial').isnullable}\")\n            print(f\"  obs.attr('empty_extension_all').isnullable = {obs.attr('empty_extension_all').isnullable}\")\n            print(f\"  obs.attr('empty_extension_partial').isnullable = {obs.attr('empty_extension_partial').isnullable}\")\n    except Exception as e:\n        print(f\"Error: {type(e).__name__}: {e}\")\n        import traceback\n        traceback.print_exc()\nEOF\n",
