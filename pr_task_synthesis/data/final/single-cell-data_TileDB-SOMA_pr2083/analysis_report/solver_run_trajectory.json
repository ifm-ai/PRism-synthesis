            "output": "<path>/workspace/apis/python/src/tiledbsoma/io/conversions.py</path>\n<type>file</type>\n<content>\n1: # Copyright (c) 2021-2023 The Chan Zuckerberg Initiative Foundation\n2: # Copyright (c) 2021-2023 TileDB, Inc.\n3: #\n4: # Licensed under the MIT License.\n5: \n6: \"\"\"Conversion utility methods.\n7: \"\"\"\n8: \n9: from typing import TypeVar, cast\n10: \n11: import numpy as np\n12: import pandas as pd\n13: import pandas._typing as pdt\n14: import scipy.sparse as sp\n15: \n16: from .._funcs import typeguard_ignore\n17: from .._types import NPNDArray, PDSeries\n18: \n19: _DT = TypeVar(\"_DT\", bound=pdt.Dtype)\n20: _MT = TypeVar(\"_MT\", NPNDArray, sp.spmatrix, PDSeries)\n21: _str_to_type = {\"boolean\": bool, \"string\": str, \"bytes\": bytes}\n22: \n23: \n24: def decategoricalize_obs_or_var(obs_or_var: pd.DataFrame) -> pd.DataFrame:\n25:     \"\"\"Performs a typecast into types that TileDB can persist.\"\"\"\n26:     if len(obs_or_var.columns) > 0:\n27:         return pd.DataFrame.from_dict(\n28:             {\n29:                 str(k): to_tiledb_supported_array_type(str(k), v)\n30:                 for k, v in obs_or_var.items()\n31:             },\n32:         )\n33:     else:\n34:         return obs_or_var.copy()\n35: \n36: \n37: @typeguard_ignore\n38: def _to_tiledb_supported_dtype(dtype: _DT) -> _DT:\n39:     \"\"\"A handful of types are cast into the TileDB type system.\"\"\"\n40:     # TileDB has no float16 -- cast up to float32\n41:     return cast(_DT, np.dtype(\"float32\")) if dtype == np.dtype(\"float16\") else dtype\n42: \n43: \n44: def to_tiledb_supported_array_type(name: str, x: _MT) -> _MT:\n45:     \"\"\"Converts datatypes unrepresentable by TileDB into datatypes it can represent.\n46:     E.g., float16 -> float32\n47:     \"\"\"\n48:     if isinstance(x, (np.ndarray, sp.spmatrix)) or not isinstance(\n49:         x, pd.CategoricalDtype\n50:     ):\n51:         # mypy issues a spurious error here, but only when\n52:         # _to_tiledb_supported_dtype is decorated with @typeguard_ignore???\n53:         target_dtype = _to_tiledb_supported_dtype(x.dtype)  # type: ignore[arg-type]\n54:         return x if target_dtype == x.dtype else x.astype(target_dtype)\n55: \n56:     # categories = x.cat.categories\n57:     # cat_dtype = categories.dtype\n58:     # if cat_dtype.kind in (\"f\", \"u\", \"i\"):\n59:     #     if x.hasnans and cat_dtype.kind == \"i\":\n60:     #         raise ValueError(\n61:     #             f\"Categorical column {name!r} contains NaN -- unable to convert to TileDB array.\"\n62:     #         )\n63:     #     # More mysterious spurious mypy errors.\n64:     #     target_dtype = _to_tiledb_supported_dtype(cat_dtype)  # type: ignore[arg-type]\n65:     # else:\n66:     #     # Into the weirdness. See if Pandas can help with edge cases.\n67:     #     inferred = infer_dtype(categories)\n68:     #     if x.hasnans and inferred in (\"boolean\", \"bytes\"):\n69:     #         raise ValueError(\n70:     #             \"Categorical array contains NaN -- unable to convert to TileDB array.\"\n71:     #         )\n72:     #     target_dtype = np.dtype(  # type: ignore[assignment]\n73:     #         _str_to_type.get(inferred, object)\n74:     #     )\n75: \n76:     # return x.astype(target_dtype)\n77:     return x\n78: \n79: \n80: def csr_from_tiledb_df(df: pd.DataFrame, num_rows: int, num_cols: int) -> sp.csr_matrix:\n81:     \"\"\"Given a tiledb dataframe, return a ``scipy.sparse.csr_matrx``.\"\"\"\n82:     return sp.csr_matrix(\n83:         (df[\"soma_data\"], (df[\"soma_dim_0\"], df[\"soma_dim_1\"])),\n84:         shape=(num_rows, num_cols),\n85:     )\n\n(End of file - total 85 lines)\n</content>",
