pe.to_pandas_dtype()\n        else:\n            try:\n                tdb_type = field.type.to_pandas_dtype()\n            except:\n                tdb_type = 'U1'  # Default to string\n        \n        attr = tiledb.Attr(name=col, dtype=tdb_type, nullable=True)\n        attrs.append(attr)\n    \n    schema = tiledb.ArraySchema(\n        domain=tiledb.Domain(\n            tiledb.Dim(name=\"soma_joinid\", domain=(0, n-1), tile=n, dtype=np.int64)\n        ),\n        attrs=attrs\n    )\n    \n    tiledb.Array.create(uri, schema)\n    \n    # Write data\n    with tiledb.open(uri, 'w') as A:\n        data = {\n            'soma_joinid': np.arange(n),\n        }\n        for col in arrow_table.column_names:\n            data[col] = arrow_table.column(col).to_numpy()\n        A[data]\n    \n    # Read back and check isnullable\n    with tiledb.open(uri, 'r') as A:\n        print(\"\\nAttributes and their isnullable property:\")\n        for i in range(A.schema.nattr):\n            attr = A.schema.attr(i)\n            print(f\"  {attr.name}: isnullable={attr.isnullable}\")\nEOF\n",
