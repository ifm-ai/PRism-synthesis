.startswith(('Int', 'UInt', 'Float')) or df[k].dtype.name == 'boolean':\n221:                     # Keep the same nullable dtype but use None values\n222:                     df[k] = pd.Series([None] * df.shape[0], dtype=df[k].dtype)\n223:                 # For string dtypes or generic object columns\n224:                 elif df[k].dtype == pd.StringDtype() or df[k].dtype.name == \"object\":\n225:                     df[k] = pd.Series([None] * df.shape[0], dtype=pd.StringDtype())\n226:                 else:\n227:                     # For other types, try to infer and create nulls\n228:                     df[k] = pa.nulls(df.shape[0], pa.infer_type(df[k]))\n229:             else:\n230:                 # Partially-null columns: preserve existing Arrow null handling\n231:                 # For nullable integer/float/boolean extension dtypes, use pd.NA for null values\n232:                 if str(df[k].dtype).startswith(('Int', 'UInt', 'Float')) or df[k].dtype.name == 'boolean':\n233:                     df[k] = df[k].where(df[k].notnull(), pd.NA)\n234:                 elif isinstance(df[k].dtype, pd.CategoricalDtype):\n235:                     # For categoricals, preserve the categorical structure\n236:                     df[k] = df[k].where(df[k].notnull(), pd.NA)\n237:                 else:\n238:                     # For other types, use Arrow nulls\n239:                     df[k] = df[k].where(\n240:                         df[k].notnull(),\n241:                         pd.Series(pa.nulls(df[k].isnull().sum(), pa.infer_type(df[k]))),\n242:                     )\n243:             null_fields.add(k)\n244: \n245:     # For categoricals, it's possible to get\n246:     #   TypeError: Object of type bool_ is not JSON serializable\n247:     # deep within library functions. Debugging reveals that this happens when\n248:     # the df[key].values.ordered is of type np.bool_ rather than Python bool.\n249:     # So, we cast and reconstruct.\n250:     for key in df:\n251:         column = df[key]\n252:         if isinstance(column.dtype, pd.CategoricalDtype):\n253:             if hasattr(column.values, \"categories\"):\n254:                 categories = column.values.categories\n255: \n256:             if hasattr(column.values, \"ordered\"):\n257:                 ordered = bool(column.values.ordered)\n258: \n259:             df[key] = pd.Categorical(\n260:                 values=column, categories=categories, ordered=ordered\n261:             )\n262: \n263:     arrow_table = pa.Table.from_pandas(df)\n264:     if null_fields:\n265:         md = arrow_table.schema.metadata\n266:         md.update(dict.fromkeys(null_fields, \"nullable\"))\n267:         arrow_table = arrow_table.replace_schema_metadata(md)\n268: \n269:     return arrow_table\n\n(End of file - total 269 lines)\n</content>",
