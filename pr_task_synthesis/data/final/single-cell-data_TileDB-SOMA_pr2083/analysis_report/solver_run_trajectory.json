            "output": "<path>/workspace/apis/python/tests/test_basic_anndata_io.py</path>\n<type>file</type>\n<content>\n720: \n721: def test_null_obs(adata, tmp_path: Path):\n722:     output_path = tmp_path.as_uri()\n723:     seed = 42\n724:     #   Create column of all null values\n725:     adata.obs[\"empty_all\"] = pd.Categorical(\n726:         [np.NaN] * adata.n_obs, dtype=pd.CategoricalDtype(categories=[], ordered=False)\n727:     )\n728:     #   Create column of partially-null values\n729:     rng = np.random.RandomState(seed)\n730:     adata.obs[\"empty_partial\"] = rng.choice((np.NaN, 1.0), adata.n_obs, True)\n731: \n732:     original = adata.copy()\n733:     uri = tiledbsoma.io.from_anndata(\n734:         output_path, adata, \"RNA\", ingest_mode=\"write\", X_kind=tiledbsoma.SparseNDArray\n735:     )\n736:     assert anndata_dataframe_unmodified_nan_safe(original.obs, adata.obs)\n737:     assert anndata_dataframe_unmodified_nan_safe(original.var, adata.var)\n738: \n739:     exp = tiledbsoma.Experiment.open(uri)\n740:     with tiledb.open(exp.obs.uri, \"r\") as obs:\n741:         #   Explicitly check columns created above\n742:         assert obs.attr(\"empty_all\").isnullable\n743:         assert obs.attr(\"empty_partial\").isnullable\n744:         #   For every column in the data frame\n745:         #   ensure that `isnullable` reflects the null-ness\n746:         #   of the Pandas data frame\n747:         for k in adata.obs:\n748:             assert obs.attr(k).isnullable == adata.obs[k].isnull().any()\n749: \n750: \n751: def test_export_obsm_with_holes(h5ad_file_with_obsm_holes, tmp_path):\n752:     adata = anndata.read_h5ad(h5ad_file_with_obsm_holes.as_posix())\n753:     original = adata.copy()\n754:     assert 1 == 1\n755: \n756:     # This data file is prepared such that obsm[\"X_pca\"] has shape (2638, 50)\n757:     # but its [0][0] element is a 0, so when it's stored as sparse, its nnz\n758:     # is not 2638*50=131900.\n759:     ado = adata.obsm[\"X_pca\"]\n760:     assert ado.shape == (2638, 50)\n761: \n762:     output_path = tmp_path.as_posix()\n763:     tiledbsoma.io.from_anndata(output_path, adata, \"RNA\")\n764: \n765:     assert anndata_dataframe_unmodified(original.obs, adata.obs)\n766:     assert anndata_dataframe_unmodified(original.var, adata.var)\n767: \n768:     exp = tiledbsoma.Experiment.open(output_path)\n769: \n770:     # Verify the bounding box on the SOMA SparseNDArray\n771:     with tiledb.open(exp.ms[\"RNA\"].obsm[\"X_pca\"].uri) as so:\n772:         assert so.meta[\"soma_dim_0_domain_lower\"] == 0\n773:         assert so.meta[\"soma_dim_0_domain_upper\"] == 2637\n774:         assert so.meta[\"soma_dim_1_domain_lower\"] == 0\n775:         assert so.meta[\"soma_dim_1_domain_upper\"] == 49\n776: \n777:     # With the bounding box present, all is well for outgest to AnnData format.\n778:     try1 = tiledbsoma.io.to_anndata(exp, \"RNA\")\n779:     assert try1.obsm[\"X_pca\"].shape == (2638, 50)\n780: \n781:     # Now remove the bounding box to simulate reading older data that lacks a bounding box.\n782:     with tiledb.open(exp.ms[\"RNA\"].obsm[\"X_pca\"].uri, \"w\") as so:\n783:         del so.meta[\"soma_dim_0_domain_lower\"]\n784:         del so.meta[\"soma_dim_0_domain_upper\"]\n785:         del so.meta[\"soma_dim_1_domain_lower\"]\n786:         del so.meta[\"soma_dim_1_domain_upper\"]\n787: \n788:     # Re-open to simulate opening afresh a bounding-box-free array.\n789:     exp = tiledbsoma.Experiment.open(output_path)\n790: \n791:     with tiledb.open(exp.ms[\"RNA\"].obsm[\"X_pca\"].uri) as so:\n792:         with pytest.raises(KeyError):\n793:             so.meta[\"soma_dim_0_domain_lower\"]\n794:         with pytest.raises(KeyError):\n795:             so.meta[\"soma_dim_0_domain_upper\"]\n796:         with pytest.raises(KeyError):\n797:             so.meta[\"soma_dim_1_domain_lower\"]\n798:         with pytest.raises(KeyError):\n799:             so.meta[\"soma_dim_1_domain_upper\"]\n800