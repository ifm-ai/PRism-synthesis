{
  "base_image": "rust:1.70-slim-bookworm",
  "build_context": {
    "location": "/artifacts/environment",
    "files": [
      "setup_runtime.sh",
      "repo_setup.sh",
      "Dockerfile.final"
    ]
  },
  "system_packages": [
    "git",
    "curl",
    "pkg-config",
    "libssl-dev",
    "ca-certificates"
  ],
  "build_steps": [
    {
      "order": 1,
      "description": "Install system packages",
      "command": "apt-get update && apt-get install -y git curl pkg-config libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*"
    },
    {
      "order": 2,
      "description": "Copy build-context scripts to /opt/benchmark",
      "action": "COPY",
      "sources": ["setup_runtime.sh", "repo_setup.sh"],
      "destination": "/opt/benchmark/"
    },
    {
      "order": 3,
      "description": "Run repo_setup.sh to materialize /workspace",
      "command": "/opt/benchmark/repo_setup.sh",
      "purpose": "Clone Apache Arrow Rust repository to /workspace"
    },
    {
      "order": 4,
      "description": "Run setup_runtime.sh for runtime creation",
      "command": "/opt/benchmark/setup_runtime.sh",
      "purpose": "Install Rust toolchain and fetch project dependencies"
    }
  ],
  "environment_variables": {
    "CARGO_HOME": "/root/.cargo",
    "RUSTUP_HOME": "/root/.rustup",
    "PATH": "/root/.cargo/bin:${PATH}"
  },
  "working_directory": "/workspace",
  "runtime_mounts": {
    "eval_sh": {
      "source": "/artifacts/evaluation/eval.sh",
      "note": "Runtime-mounted verifier asset, not baked into image"
    },
    "tests": {
      "source": "/artifacts/evaluation/tests/",
      "note": "Runtime-mounted hidden tests, not baked into image"
    }
  },
  "build_backend": "buildah",
  "export_format": "oci",
  "export_path": "/artifacts/environment/openenv_validation_oci.tar",
  "apptainer_compatibility": "runtime-only",
  "notes": "Image is built with Buildah. Apptainer is used only at runtime. The eval.sh and hidden tests are runtime-mounted, not baked into the image."
}
