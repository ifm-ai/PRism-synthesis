                .with_exporter(exporter)\n188:                 .build()\n189:                 .context(\"Failed to create OTLP metrics pipeline\")?;\n190: \n191:             tracing::trace!(target: \"relay\", \"Successfully initialized metric controller on tokio runtime\");\n192: \n193:             tracing_subscriber::registry()\n194:                 .with(log_layer(args))\n195:                 .with(\n196:                     tracing_opentelemetry::layer()\n197:                         .with_tracer(tracer)\n198:                         .with_filter(env_filter()),\n199:                 )\n200:                 .into()\n201:         }\n202:     };\n203: \n204:     drop(temp_logger_guard); // Drop as late as possible\n205: \n206:     dispatch\n207:         .try_init()\n208:         .context(\"Failed to initialize tracing\")?;\n209: \n210:     Ok(())\n211: }\n212: \n213: /// Constructs the base log layer.\n214: ///\n215: /// The user has a choice between:\n216: ///\n217: /// - human-centered formatting\n218: /// - JSON-formatting\n219: /// - Google Cloud optimised formatting\n220: fn log_layer<T>(args: &Args) -> Box<dyn Layer<T> + Send + Sync>\n221: where\n222:     T: Subscriber + for<'a> tracing_subscriber::registry::LookupSpan<'a>,\n223: {\n224:     let log_layer = match (args.log_format, args.google_cloud_project_id.clone()) {\n225:         (LogFormat::Human, _) => tracing_subscriber::fmt::layer().boxed(),\n226:         (LogFormat::Json, _) => tracing_subscriber::fmt::layer().json().boxed(),\n227:         (LogFormat::GoogleCloud, None) => {\n228:             tracing::warn!(target: \"relay\", \"Emitting logs in Google Cloud format but without the project ID set. Spans will be emitted without IDs!\");\n229: \n230:             tracing_stackdriver::layer().boxed()\n231:         }\n232:         (LogFormat::GoogleCloud, Some(project_id)) => tracing_stackdriver::layer()\n233:             .with_cloud_trace(CloudTraceConfiguration { project_id })\n234:             .boxed(),\n235:     };\n236: \n237:     log_layer.with_filter(env_filter()).boxed()\n238: }\n239: \n240: fn env_filter() -> EnvFilter {\n241:     EnvFilter::builder()\n242:         .with_default_directive(LevelFilter::INFO.into())\n243:         .from_env_lossy()\n244: }\n245: \n246: async fn connect_to_portal(\n247:     args: &Args,\n248:     token: &SecretString,\n249:     mut url: Url,\n250:     stamp_secret: &SecretString,\n251: ) -> Result<Option<PhoenixChannel<JoinMessage, (), ()>>> {\n252:     use secrecy::ExposeSecret;\n253: \n254:     if !url.path().is_empty() {\n255:         tracing::warn!(target: \"relay\", \"Overwriting path component of portal URL with '/relay/websocket'\");\n256:     }\n257: \n258:     url.set_path(\"relay/websocket\");\n259:     url.query_pairs_mut()\n260:         .append_pair(\"token\", token.expose_secret().as_str());\n261: \n262:     if let Some(public_ip4_addr) = args.public_ip4_addr {\n263:         url.query_pairs_mut()\n264:             .append_pair(\"ipv4\", &public_ip4_addr.to_string());\n265:     }\n266:     if let Some(public_ip6_addr) = args.public_ip6_addr {\n267:         url.query_pairs_mut()\n268:             .append_pair(\"ipv6\", &public_ip6_addr.to_string());\n269:     }\n270: \n271:     let (channel, Init {}) = phoenix_channel::init::<_, Init, _, _>(\n272:         Secret::from(SecureUrl::from_url(url)),\n273:         format!(\"relay/{}\", env!(\"CARGO_PKG_VERSION\")),\n274:         \"relay\",\n275:         JoinMessage {\n276:             stamp_secret: stamp_secret.expose_secret().to_string(),\n277:         },\n278:         ExponentialBackoffBuilder::default()\n279:             .with_max_elapsed_time(None)\n280:             .build(),\n281:     )\n282:     .await??;\n283: \n284:     Ok(Some(channel))\n285: }\n286: \n287: #[derive(serde::Deserialize, Debug)]\n288: struct Init {}\n289: \n290: #[derive(serde::Serialize, PartialEq, Debug, Clone)]\n291: struct JoinMessage {\n292:     stamp_secret: String,\n293: }\n294: \n295: #[cfg(debug_assertions)]\n296: fn make_rng(seed: Option<u64>) -> StdRng {\n297:     let Some(seed) = seed else {\n298:         return StdRng::from_entropy();\n299:     };\n300: \n301:     tracing::info!(target: \"relay\", \"Seeding RNG from '{seed}'\");\n302: \n303:     StdRng::seed_from_u64(seed)\n304: }\n305: \n306: #[cfg(not(debug_assertions))]\n307: fn make_rng(seed: Option<u64>) -> StdRng {\n308:     if seed.is_some() {\n309:         tracing::debug!(target: \"relay\", \"Ignoring rng-seed because we are running in release mode\");\n310:     }\n311: \n312:     StdRng::from_entropy()\n313: }\n314: \n315: struct Eventloop<R> {\n316:     inbound_data_receiver: mpsc::Receiver<(Vec<u8>, SocketAddr)>,\n317:     outbound_ip4_data_sender: mpsc::Sender<(Vec<u8>, SocketAddr)>,\n318:     outbound_ip6_data_sender: mpsc::Sender<(Vec<u8>, SocketAddr)>,\n319:     server: Server<R>,\n320:     channel: Option<PhoenixChannel<JoinMessage, (), ()>>,\n321:     allocations: HashMap<(AllocationId, AddressFamily), Allocation>,\n322:     relay_data_sender: mpsc::Sender<(Vec<u8>, SocketAddr, AllocationId)>,\n323:     relay_data_receiver: mpsc::Receiver<(Vec<u8>, SocketAddr, AllocationId)>,\n324:     sleep: Sleep,\n325: \n326:     stats_log_interval: tokio::time::Interval,\n327:     last_num_bytes_relayed: u64,\n328: }\n329: \n330: impl<R> Eventloop<R>\n331: where\n332:     R: Rng,\n333: {\n334:     fn new(\n335:         server: Server<R>,\n336:         channel: Option<PhoenixChannel<JoinMessage, (), ()>>,\n337:         public_address: IpStack,\n338:     ) -> Result<Self> {\n339:         let (relay_data_sender, relay_data_receiver) = mpsc::channel(1);\n340:         let (inbound_data_sender, inbound_data_receiver) = mpsc::channel(1000);\n341:         let (outbound_ip4_data_sender, outbound_ip4_data_receiver) =\n342:             mpsc::channel::<(Vec<u8>, SocketAddr)>(1000);\n343:         let (outbound_ip6_data_sender, outbound_ip6_data_receiver) =\n344:             mpsc::channel::<(Vec<u8>, SocketAddr)>(1000);\n345: \n346:         if public_address.as_v4().is_some() {\n347:             tokio::spawn(main_udp_socket_task(\n348:                 AddressFamily::V4,\n349:                 inbound_data_sender.clone(),\n350:                 outbound_ip4_data_receiver,\n351:             ));\n352:         }\n353:         if public_address.as_v6().is_some() {\n354:             tokio::spawn(main_udp_socket_task(\n355:                 AddressFamily::V6,\n356:                 inbound_data_sender,\n357:                 outbound_ip6_data_receiver,\n358:             ));\n359:         }\n360: \n361:         Ok(Self {\n362:             inbound_data_receiver,\n363:             outbound_ip4_data_sender,\n364:             outbound_ip6_data_sender,\n365:             server,\n366:             channel,\n367:             allocations: Default::default(),\n368:             relay_data_sender,\n369:             relay_data_receiver,\n370:             sleep: Sleep::default(),\n371:             stats_log_interval: tokio::time::interval(STATS_LOG_INTERVAL),\n372:             last_num_bytes_relayed: 0,\n373:         })\n374:     }\n375: \n376:     fn poll(&mut self, cx: &mut std::task::Context<'_>) -> Poll<Result<()>> {\n377:         let span = tracing::error_span!(\"Eventloop::poll\");\n378:         let _guard = span.enter();\n379: \n380:         loop {\n381:             // Don't fail these results. One of the senders might not be active because we might not be listening on IP4 / IP6.\n382:             let _ = ready!(self.outbound_ip4_data_sender.poll_ready_unpin(cx));\n383:             let _ = ready!(self.outbound_ip6_data_sender.poll_ready_unpin(cx));\n384: \n385:             let now = SystemTime::now();\n386: \n387:             // Priority 1: Execute the pending commands of the server.\n388:             if let Some(next_command) = self.server.next_command() {\n389:                 match next_command {\n390:                     Command::SendMessage { payload, recipient } => {\n391:                         let span = tracing::error_span!(\"Command::SendMessage\");\n392:                         let _guard = span.enter();\n393: \n394:                         let sender = match recipient.family() {\n395:                             AddressFamily::V4 => &mut self.outbound_ip4_data_sender,\n396:                             AddressFamily::V6 => &mut self.outbound_ip6_data_sender,\n397:                         };\n398: \n399:                         if let Err(e) = sender.try_send((payload, recipient)) {\n400:                             if e.is_disconnected() {\n401:                                 return Poll::Ready(Err(anyhow!(\n402:                                     \"Channel to primary UDP socket task has been closed\"\n403:                                 )));\n404:                             }\n405: \n406:                             // Should never happen because we poll for readiness above.\n407:                             if e.is_full() {\n408:                                 tracing::warn!(target: \"relay\", %recipient, \"Dropping message because channel to primary UDP socket task is full\");\n409:                             }\n410:                         }\n411:                     }\n412:                     Command::CreateAllocation { id, family, port } => {\n413:                         let span =\n414:                             tracing::error_span!(\"Command::CreateAllocation\", %id, %family, %port);\n415:                         let _guard = span.enter();\n416: \n417:                         self.allocations.insert(\n418:                             (id, family),\n419:                             Allocation::new(self.relay_data_sender.clone(), id, family, port),\n420:                         );\n421:                     }\n422:                     Command::FreeAllocation { id, family } => {\n423:                         let span = tracing::error_span!(\"Command::FreeAllocation\", %id, %family);\n424:                         let _guard = span.enter();\n425: \n426:                         if self.allocations.remove(&(id, family)).is_none() {\n427:                             tracing::debug!(target: \"relay\", \"Unknown allocation {id}\");\n428:                             continue;\n429:                         };\n430: \n431:                         tracing::info!(target: \"relay\", \"Freeing addresses of allocation {id}\");\n432:                     }\n433:                     Command::Wake { deadline } => {\n434:                         let span = tracing::error_span!(\"Command::Wake\", ?deadline);\n435:                         let _guard = span.enter();\n436: \n437:                         match deadline.duration_since(now) {\n438:                             Ok(duration) => {\n439:                                 tracing::trace!(target: \"relay\", ?duration, \"Suspending event loop\")\n440:                             }\n441:                             Err(e) => {\n442:                                 let difference = e.duration();\n443: \n444:                                 tracing::warn!(target: \"relay\",\n445:                                     ?difference,\n446:                                     \"Wake time is already in the past, waking now\"\n447:                                 )\n448:                             }\n449:                         }\n450: \n451:                         Pin::new(&mut self.sleep).reset(deadline);\n452:                     }\n453:                     Command::ForwardData { id, data, receiver } => {\n454:                         let span = tracing::error_span!(\"Command::ForwardData\", %id, %receiver);\n455:                         let _guard = span.enter();\n456: \n457:                         let mut allocation = match self.allocations.entry((id, receiver.family())) {\n458:                             Entry::Occupied(entry) => entry,\n459:                             Entry::Vacant(_) => {\n460:                                 tracing::debug!(target: \"relay\", allocation = %id, family = %receiver.family(), \"Unknown allocation\");\n461:                                 continue;\n462:                             }\n463:                         };\n464: \n465:                         if allocation.get_mut().send(data, receiver).is_err() {\n466:                             self.server.handle_allocation_failed(id);\n467:                             allocation.remove();\n468:                         }\n469:                     }\n470:                 }\n471: \n472:                 continue; // Attempt to process more commands.\n473:             }\n474: \n475:             // Priority 2: Handle time-sensitive tasks:\n476:             if self.sleep.poll_unpin(cx).is_ready() {\n477:                 self.server.handle_deadline_reached(now);\n478:                 continue; // Handle potentially new commands.\n479:             }\n480: \n481:             // Priority 3: Handle relayed data (we prioritize latency for existing allocations over making new ones)\n482:             if let Poll::Ready(Some((data, sender, allocation))) =\n483:                 self.relay_data_receiver.poll_next_unpin(cx)\n484:             {\n485:                 self.server.handle_peer_traffic(&data, sender, allocation);\n486:                 continue; // Handle potentially new commands.\n487:             }\n488: \n489:             // Priority 4: Accept new allocations / answer STUN requests etc\n490:             if let Poll::Ready(Some((buffer, sender))) =\n491:                 self.inbound_data_receiver.poll_next_unpin(cx)\n492:             {\n493:                 self.server.handle_client_input(&buffer, sender, now);\n494:                 continue; // Handle potentially new commands.\n495:             }\n496: \n497:             // Priority 5: Handle portal messages\n498:             match self.channel.as_mut().map(|c| c.poll(cx)) {\n499:                 Some(Poll::Ready(Err(Error::Serde(e)))) => {\n500:                     tracing::warn!(target: \"relay\", \"Failed to deserialize portal message: {e}\");\n501:                     continue; // This is not a hard-error, we can continue.\n502:                 }\n503:                 Some(Poll::Ready(Err(e))) => {\n504:                     return Poll::Ready(Err(anyhow!(\"Portal connection failed: {e}\")));\n505:                 }\n506:                 Some(Poll::Ready(Ok(Event::SuccessResponse { res: (), .. }))) => {\n507:                     continue;\n508:                 }\n509:                 Some(Poll::Ready(Ok(Event::JoinedRoom { topic }))) => {\n510:                     tracing::info!(target: \"relay\", \"Successfully joined room '{topic}'\");\n511:                     continue;\n512:                 }\n513:                 Some(Poll::Ready(Ok(Event::ErrorResponse {\n514:                     topic,\n515:                     req_id,\n516:                     reason,\n517:                 }))) => {\n518:                     tracing::warn!(target: \"relay\", \"Request with ID {req_id} on topic {topic} failed: {reason}\");\n519:                     continue;\n520:                 }\n521:                 Some(Poll::Ready(Ok(Event::HeartbeatSent))) => {\n522:                     tracing::debug!(target: \"relay\", \"Heartbeat sent to portal\");\n523:                     continue;\n524:                 }\n525:                 Some(Poll::Ready(Ok(\n526:                     Event::InboundMessage { msg: (), .. } | Event::InboundReq { req: (), .. },\n527:                 )))\n528:                 | Some(Poll::Pending)\n529:                 | None => {}\n530:             }\n531: \n532:             if self.stats_log_interval.poll_tick(cx).is_ready() {\n533:                 let num_allocations = self.server.num_allocations();\n534:                 let num_channels = self.server.num_channels();\n535: \n536:                 let bytes_relayed_since_last_tick =\n537:                     self.server.num_relayed_bytes() - self.last_num_bytes_relayed;\n538:                 self.last_num_bytes_relayed = self.server.num_relayed_bytes();\n539: \n540:                 let avg_throughput = bytes_relayed_since_last_tick / STATS_LOG_INTERVAL.as_secs();\n541: \n542:                 tracing::info!(target: \"relay\", \"Allocations = {num_allocations} Channels = {num_channels} Throughput = {}\", fmt_human_throughput(avg_throughput as f64));\n543:             }\n544: \n545:             return Poll::Pending;\n546:         }\n547:     }\n548: }\n549: \n550: fn fmt_human_throughput(mut throughput: f64) -> String {\n551:     let units = [\"B/s\", \"kB/s\", \"MB/s\", \"GB/s\", \"TB/s\"];\n552: \n553:     for unit in units {\n554:         if throughput < 1000.0 {\n555:             return format!(\"{throughput:.2} {unit}\");\n556:         }\n557: \n558:         throughput /= 1000.0;\n559:     }\n560: \n561:     format!(\"{throughput:.2} TB/s\")\n562: }\n563: \n564: async fn main_udp_socket_task(\n565:     family: AddressFamily,\n566:     mut inbound_data_sender: mpsc::Sender<(Vec<u8>, SocketAddr)>,\n567:     mut outbound_data_receiver: mpsc::Receiver<(Vec<u8>, SocketAddr)>,\n568: ) -> Result<Infallible> {\n569:     let mut socket = UdpSocket::bind(family, 3478)?;\n570: \n571:     loop {\n572:         tokio::select! {\n573:             result = socket.recv() => {\n574:                 let (data, sender) = result?;\n575:                 inbound_data_sender.send((data.to_vec(), sender)).await?;\n576:             }\n577:             maybe_item = outbound_data_receiver.next() => {\n578:                 let (data, recipient) = maybe_item.context(\"Outbound data channel closed\")?;\n579:                 socket.send_to(data.as_ref(), recipient).await?;\n580:             }\n581:         }\n582:     }\n583: }\n584: \n585: #[cfg(test)]\n586: mod tests {\n587:     use super::*;\n588: \n589:     #[test]\n590:     fn prints_humanfriendly_throughput() {\n591:         assert_eq!(fmt_human_throughput(42.0), \"42.00 B/s\");\n592:         assert_eq!(fmt_human_throughput(1_234.0), \"1.23 kB/s\");\n593:         assert_eq!(fmt_human_throughput(955_333_999.0), \"955.33 MB/s\");\n594:         assert_eq!(fmt_human_throughput(100_000_000_000.0), \"100.00 GB/s\");\n595:     }\n596: }\n\n(End of file - total 596 lines)\n</content>",
