7: \n58:     /// Send data to a peer on this allocation.\n59:     ///\n60:     /// In case the channel is full, we will simply drop the packet and log a warning.\n61:     /// In normal operation, this should not happen but if for some reason, the allocation task cannot keep up with the incoming data, we need to drop packets somewhere to avoid unbounded memory growth.\n62:     ///\n63:     /// All our data is relayed over UDP which by design is an unreliable protocol.\n64:     /// Thus, any application running on top of this relay must already account for potential packet loss.\n65:     pub fn send(&mut self, data: Vec<u8>, recipient: SocketAddr) -> Result<()> {\n66:         match self.sender.try_send((data, recipient)) {\n67:             Ok(()) => Ok(()),\n68:             Err(e) if e.is_disconnected() => {\n69:                 tracing::warn!(allocation = %self.id, %recipient, \"Channel to allocation is disconnected\");\n70:                 bail!(\"Channel to allocation {} is disconnected\", self.id)\n71:             }\n72:             Err(e) if e.is_full() => {\n73:                 tracing::warn!(allocation = %self.id, \"Send buffer for allocation is full, dropping packet\");\n74:                 Ok(())\n75:             }\n76:             Err(_) => {\n77:                 // Fail in debug, but not in release mode.\n78:                 debug_assert!(false, \"TrySendError only has two variants\");\n79:                 Ok(())\n80:             }\n81:         }\n82:     }\n83: }\n84: \n85: impl Drop for Allocation {\n86:     fn drop(&mut self) {\n87:         self.handle.abort();\n88:     }\n89: }\n90: \n91: async fn forward_incoming_relay_data(\n92:     mut relayed_data_sender: mpsc::Sender<(Vec<u8>, SocketAddr, AllocationId)>,\n93:     mut client_to_peer_receiver: mpsc::Receiver<(Vec<u8>, SocketAddr)>,\n94:     id: AllocationId,\n95:     family: AddressFamily,\n96:     port: u16,\n97: ) -> Result<Infallible> {\n98:     let mut socket = UdpSocket::bind(family, port)?;\n99: \n100:     loop {\n101:         tokio::select! {\n102:             result = socket.recv() => {\n103:                 let (data, sender) = result?;\n104:                 relayed_data_sender.send((data.to_vec(), sender, id)).await?;\n105:             }\n106: \n107:             Some((data, recipient)) = client_to_peer_receiver.next() => {\n108:                 socket.send_to(&data, recipient).await?;\n109:             }\n110:         }\n111:     }\n112: }\n\n(End of file - total 112 lines)\n</content>",
