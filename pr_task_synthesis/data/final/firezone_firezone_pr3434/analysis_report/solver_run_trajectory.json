            "output": "<path>/workspace/rust/relay/src/server.rs</path>\n<type>file</type>\n<content>\n1: mod channel_data;\n2: mod client_message;\n3: \n4: pub use crate::server::channel_data::ChannelData;\n5: pub use crate::server::client_message::{\n6:     Allocate, Binding, ChannelBind, ClientMessage, CreatePermission, Refresh,\n7: };\n8: \n9: use crate::auth::{MessageIntegrityExt, Nonces, FIREZONE};\n10: use crate::net_ext::IpAddrExt;\n11: use crate::{IpStack, TimeEvents};\n12: use anyhow::Result;\n13: use bytecodec::EncodeExt;\n14: use core::fmt;\n15: use opentelemetry::metrics::{Counter, Unit, UpDownCounter};\n16: use opentelemetry::KeyValue;\n17: use rand::Rng;\n18: use secrecy::SecretString;\n19: use std::collections::{HashMap, VecDeque};\n20: use std::hash::Hash;\n21: use std::net::{IpAddr, SocketAddr};\n22: use std::time::{Duration, SystemTime};\n23: use stun_codec::rfc5389::attributes::{\n24:     ErrorCode, MessageIntegrity, Nonce, Realm, Username, XorMappedAddress,\n25: };\n26: use stun_codec::rfc5389::errors::{BadRequest, StaleNonce, Unauthorized};\n27: use stun_codec::rfc5389::methods::BINDING;\n28: use stun_codec::rfc5766::attributes::{\n29:     ChannelNumber, Lifetime, RequestedTransport, XorPeerAddress, XorRelayAddress,\n30: };\n31: use stun_codec::rfc5766::errors::{AllocationMismatch, InsufficientCapacity};\n32: use stun_codec::rfc5766::methods::{ALLOCATE, CHANNEL_BIND, CREATE_PERMISSION, REFRESH};\n33: use stun_codec::rfc8656::attributes::{\n34:     AdditionalAddressFamily, AddressFamily, RequestedAddressFamily,\n35: };\n36: use stun_codec::rfc8656::errors::{AddressFamilyNotSupported, PeerAddressFamilyMismatch};\n37: use stun_codec::{Message, MessageClass, MessageEncoder, Method, TransactionId};\n38: use tracing::{field, log, Span};\n39: use tracing_core::field::display;\n40: use uuid::Uuid;\n41: \n42: /// A sans-IO STUN & TURN server.\n43: ///\n44: /// A [`Server`] is bound to an IPv4 address and assumes to only operate on UDP.\n45: /// Thus, 3 out of the 5 components of a \"5-tuple\" are unique to an instance of [`Server`] and\n46: /// we can index data simply by the sender's [`SocketAddr`].\n47: ///\n48: /// Additionally, we assume to have complete ownership over the port range `lowest_port` - `highest_port`.\n49: pub struct Server<R> {\n50:     decoder: client_message::Decoder,\n51:     encoder: MessageEncoder<Attribute>,\n52: \n53:     public_address: IpStack,\n54: \n55:     /// All client allocations, indexed by client's socket address.\n56:     allocations: HashMap<SocketAddr, Allocation>,\n57:     clients_by_allocation: HashMap<AllocationId, SocketAddr>,\n58:     allocations_by_port: HashMap<u16, AllocationId>,\n59: \n60:     lowest_port: u16,\n61:     highest_port: u16,\n62: \n63:     channels_by_client_and_number: HashMap<(SocketAddr, u16), Channel>,\n64:     channel_numbers_by_peer: HashMap<SocketAddr, u16>,\n65: \n66:     pending_commands: VecDeque<Command>,\n67:     next_allocation_id: AllocationId,\n68: \n69:     rng: R,\n70: \n71:     auth_secret: SecretString,\n72: \n73:     nonces: Nonces,\n74: \n75:     time_events: TimeEvents<TimedAction>,\n76: \n77:     allocations_up_down_counter: UpDownCounter<i64>,\n78:     data_relayed_counter: Counter<u64>,\n79:     data_relayed: u64, // Keep a separate counter because `Counter` doesn't expose the current value :(\n80:     responses_counter: Counter<u64>,\n81: }\n82: \n83: /// The commands returned from a [`Server`].\n84: ///\n85: /// The [`Server`] itself is sans-IO, meaning it is the caller responsibility to cause the side-effects described by these commands.\n86: #[derive(Debug, PartialEq)]\n87: pub enum Command {\n88:     SendMessage {\n89:         payload: Vec<u8>,\n90:         recipient: SocketAddr,\n91:     },\n92:     /// Listen for traffic on the provided port [AddressFamily].\n93:     ///\n94:     /// Any incoming data should be handed to the [`Server`] via [`Server::handle_peer_traffic`].\n95:     /// A single allocation can reference one of either [AddressFamily]s or both.\n96:     /// Only the combination of [AllocationId] and [AddressFamily] is unique.\n97:     CreateAllocation {\n98:         id: AllocationId,\n99:         family: AddressFamily,\n100:         port: u16,\n101:     },\n102:     /// Free the allocation associated with the given [`AllocationId`] and [AddressFamily]\n103:     FreeAllocation {\n104:         id: AllocationId,\n105:         family: AddressFamily,\n106:     },\n107: \n108:     ForwardData {\n109:         id: AllocationId,\n110:         data: Vec<u8>,\n111:         receiver: SocketAddr,\n112:     },\n113:     /// At the latest, the [`Server`] needs to be woken at the specified deadline to execute time-based actions correctly.\n114:     Wake { deadline: SystemTime },\n115: }\n116: \n117: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]\n118: pub struct AllocationId(u64);\n119: \n120: impl AllocationId {\n121:     fn next(&mut self) -> Self {\n122:         let id = self.0;\n123: \n124:         self.0 += 1;\n125: \n126:         AllocationId(id)\n127:     }\n128: }\n129: \n130: impl fmt::Display for AllocationId {\n131:     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n132:         write!(f, \"AID-{}\", self.0)\n133:     }\n134: }\n135: \n136: /// See <https://www.rfc-editor.org/rfc/rfc8656#name-requested-transport>.\n137: const UDP_TRANSPORT: u8 = 17;\n138: \n139: /// The duration of a channel binding.\n140: ///\n141: /// See <https://www.rfc-editor.org/rfc/rfc8656#name-channels-2>.\n142: const CHANNEL_BINDING_DURATION: Duration = Duration::from_secs(600);\n143: \n144: impl<R> Server<R>\n145: where\n146:     R: Rng,\n147: {\n148:     /// Constructs a new [`Server`].\n149:     ///\n150:     /// # Port configuration\n151:     ///\n152:     /// The [TURN RFC](https://www.rfc-editor.org/rfc/rfc8656#section-7.2-6) recommends using the port range `49152 - 65535`.\n153:     /// We make this configurable here because there are several situations in which we don't want to use the full range:\n154:     /// - Users might already have other services deployed on the same machine that overlap with the ports the RFC recommends.\n155:     /// - Docker Desktop struggles with forwarding large port ranges to the host with the default networking mode.\n156:     pub fn new(\n157:         public_address: impl Into<IpStack>,\n158:         mut rng: R,\n159:         lowest_port: u16,\n160:         highest_port: u16,\n161:     ) -> Self {\n162:         // TODO: Validate that local IP isn't multicast / loopback etc.\n163: \n164:         let meter = opentelemetry_api::global::meter(\"relay\");\n165: \n166:         let allocations_up_down_counter = meter\n167:             .i64_up_down_counter(\"allocations_total\")\n168:             .with_description(\"The number of active allocations\")\n169:             .init();\n170:         let responses_counter = meter\n171:             .u64_counter(\"responses_total\")\n172:             .with_description(\"The number of responses\")\n173:             .init();\n174:         let data_relayed_counter = meter\n175:             .u64_counter(\"data_relayed_bytes\")\n176:             .with_description(\"The number of bytes relayed\")\n177:             .with_unit(Unit::new(\"b\"))\n178:             .init();\n179: \n180:         Self {\n181:             decoder: Default::default(),\n182:             encoder: Default::default(),\n183:             public_address: public_address.into(),\n184:             allocations: Default::default(),\n185:             clients_by_allocation: Default::default(),\n186:             allocations_by_port: Default::default(),\n187:             lowest_port,\n188:             highest_port,\n189:             channels_by_client_and_number: Default::default(),\n190:             channel_numbers_by_peer: Default::default(),\n191:             pending_commands: Default::default(),\n192:             next_allocation_id: AllocationId(1),\n193:             auth_secret: SecretString::from(hex::encode(rng.gen::<[u8; 32]>())),\n194:             rng,\n195:             time_events: TimeEvents::default(),\n196:             nonces: Default::default(),\n197:             allocations_up_down_counter,\n198:             responses_counter,\n199:             data_relayed_counter,\n200:             data_relayed: 0,\n201:         }\n202:     }\n203: \n204:     pub fn auth_secret(&self) -> &SecretString {\n205:         &self.auth_secret\n206:     }\n207: \n208:     /// Registers a new, valid nonce.\n209:     ///\n210:     /// Each nonce is valid for 10 requests.\n211:     pub fn add_nonce(&mut self, nonce: Uuid) {\n212:         self.nonces.add_new(nonce);\n213:     }\n214: \n215:     pub fn num_relayed_bytes(&self) -> u64 {\n216:         self.data_relayed\n217:     }\n218: \n219:     pub fn num_allocations(&self) -> usize {\n220:         self.allocations.len()\n221:     }\n222: \n223:     pub fn num_channels(&self) -> usize {\n224:         self.channels_by_client_and_number.len()\n225:     }\n226: \n227:     /// Process the bytes received from a client.\n228:     ///\n229:     /// After calling this method, you should call [`Server::next_command`] until it returns `None`.\n230:     #[tracing::instrument(skip_all, fields(transaction_id, %sender, allocation, channel, recipient, peer), level = \"error\")]\n231:     pub fn handle_client_input(&mut self, bytes: &[u8], sender: SocketAddr, now: SystemTime) {\n232:         if tracing::enabled!(target: \"wire\", tracing::Level::TRACE) {\n233:             let hex_bytes = hex::encode(bytes);\n234:             tracing::trace!(target: \"wire\", %hex_bytes, \"receiving bytes\");\n235:         }\n236: \n237:         match self.decoder.decode(bytes) {\n238:             Ok(Ok(message)) => {\n239:                 if let Some(id) = message.transaction_id() {\n240:                     Span::current().record(\"transaction_id\", hex::encode(id.as_bytes()));\n241:                 }\n242: \n243:                 self.handle_client_message(message, sender, now);\n244:             }\n245:             // Could parse the bytes but message was semantically invalid (like missing attribute).\n246:             Ok(Err(error_code)) => {\n247:                 self.queue_error_response(sender, error_code);\n248:             }\n249:             // Parsing the bytes failed.\n250:             Err(client_message::Error::BadChannelData(ref error)) => {\n251:                 tracing::debug!(%error, \"failed to decode channel data\")\n252:             }\n253:             Err(client_message::Error::DecodeStun(ref error)) => {\n254:                 tracing::debug!(%error, \"failed to decode stun packet\")\n255:             }\n256:             Err(client_message::Error::UnknownMessageType(t)) => {\n257:                 tracing::debug!(r#type = %t, \"unknown STUN message type\")\n258:             }\n259:             Err(client_message::Error::Eof) => {\n260:                 tracing::debug!(\"unexpected EOF while parsing message\")\n261:             }\n262:         };\n263:     }\n264: \n265:     pub fn handle_client_message(\n266:         &mut self,\n267:         message: ClientMessage,\n268:         sender: SocketAddr,\n269:         now: SystemTime,\n270:     ) {\n271:         let result = match message {\n272:             ClientMessage::Allocate(request) => self.handle_allocate_request(request, sender, now),\n273:             ClientMessage::Refresh(request) => self.handle_refresh_request(request, sender, now),\n274:             ClientMessage::ChannelBind(request) => {\n275:                 self.handle_channel_bind_request(request, sender, now)\n276:             }\n277:             ClientMessage::CreatePermission(request) => {\n278:                 self.handle_create_permission_request(request, sender, now)\n279:             }\n280:             ClientMessage::Binding(request) => {\n281:                 self.handle_binding_request(request, sender);\n282:                 return;\n283:             }\n284:             ClientMessage::ChannelData(msg) => {\n285:                 self.handle_channel_data_message(msg, sender, now);\n286:                 return;\n287:             }\n288:         };\n289: \n290:         let Err(error_response) = result else {\n291:             return;\n292:         };\n293: \n294:         self.queue_error_response(sender, error_response)\n295:     }\n296: \n297:     fn queue_error_response(&mut self, sender: SocketAddr, mut error_response: Message<Attribute>) {\n298:         let Some(error) = error_response.get_attribute::<ErrorCode>().cloned() else {\n299:             debug_assert!(false, \"Error response without an `ErrorCode`\");\n300:             return;\n301:         };\n302: \n303:         // In case of a 401 or 438 response, attach a realm and nonce.\n304:         if error == ErrorCode::from(Unauthorized) || error == ErrorCode::from(StaleNonce) {\n305:             let new_nonce = Uuid::from_u128(self.rng.gen());\n306: \n307:             self.add_nonce(new_nonce);\n308: \n309:             error_response.add_attribute(Nonce::new(new_nonce.to_string()).unwrap());\n310:             error_response.add_attribute((*FIREZONE).clone());\n311: \n312:             tracing::debug!(target: \"relay\", \"{} failed: {}\", error_response.method(), error.reason_phrase());\n313:         } else {\n314:             tracing::warn!(target: \"relay\", \"{} failed: {}\", error_response.method(), error.reason_phrase());\n315:         }\n316: \n317:         self.send_message(error_response, sender);\n318:     }\n319: \n320:     /// Process the bytes received from an allocation.\n321:     #[tracing::instrument(skip_all, fields(%sender, %allocation, recipient, channel), level = \"error\")]\n322:     pub fn handle_peer_traffic(\n323:         &mut self,\n324:         bytes: &[u8],\n325:         sender: SocketAddr,\n326:         allocation: AllocationId,\n327:     ) {\n328:         if tracing::enabled!(target: \"wire\", tracing::Level::TRACE) {\n329:             let hex_bytes = hex::encode(bytes);\n330:             tracing::trace!(target: \"wire\", %hex_bytes, \"receiving bytes\");\n331:         }\n332: \n333:         let Some(recipient) = self.clients_by_allocation.get(&allocation) else {\n334:             tracing::debug!(target: \"relay\", \"unknown allocation\");\n335:             return;\n336:         };\n337: \n338:         Span::current().record(\"recipient\", field::display(&recipient));\n339: \n340:         let Some(channel_number) = self.channel_numbers_by_peer.get(&sender) else {\n341:             tracing::debug!(target: \"relay\", \"no active channel, refusing to relay {} bytes\", bytes.len());\n342:             return;\n343:         };\n344: \n345:         Span::current().record(\"channel\", channel_number);\n346: \n347:         let Some(channel) = self\n348:             .channels_by_client_and_number\n349:             .get(&(*recipient, *channel_number))\n350:         else {\n351:             debug_assert!(false, \"unknown channel {}\", channel_number);\n352:             return;\n353:         };\n354: \n355:         if !channel.bound {\n356:             tracing::debug!(target: \"relay\", \"channel existed but is unbound\");\n357:             return;\n358:         }\n359: \n360:         if channel.allocation != allocation {\n361:             tracing::debug!(target: \"relay\", \"channel is not associated with allocation\");\n362:             return;\n363:         }\n364: \n365:         tracing::debug!(target: \"relay\", \"Relaying {} bytes\", bytes.len());\n366: \n367:         self.data_relayed_counter.add(bytes.len() as u64, &[]);\n368:         self.data_relayed += bytes.len() as u64;\n369: \n370:         let data = ChannelData::new(*channel_number, bytes).to_bytes();\n371: \n372:         if tracing::enabled!(target: \"wire\", tracing::Level::TRACE) {\n373:             let hex_bytes = hex::encode(&data);\n374:             tracing::trace!(target: \"wire\", %hex_bytes, \"sending bytes\");\n375:         }\n376: \n377:         self.pending_commands.push_back(Command::SendMessage {\n378:             payload: data,\n379:             recipient: *recipient,\n380:         })\n381:     }\n382: \n383:     #[tracing::instrument(skip(self), level = \"error\")]\n384:     pub fn handle_deadline_reached(&mut self, now: SystemTime) {\n385:         for action in self.time_events.pending_actions(now) {\n386:             match action {\n387:                 TimedAction::ExpireAllocation(id) => {\n388:                     let Some(allocation) = self.get_allocation(&id) else {\n389:                         tracing::debug!(target: \"relay\", \"Cannot expire non-existing allocation {id}\");\n390: \n391:                         continue;\n392:                     };\n393: \n394:                     if allocation.is_expired(now) {\n395:                         self.delete_allocation(id)\n396:                     }\n397:                 }\n398:                 TimedAction::UnbindChannel((client, chan)) => {\n399:                     let Some(channel) = self.channels_by_client_and_number.get_mut(&(client, chan))\n400:                     else {\n401:                         tracing::debug!(target: \"relay\", \"Cannot expire non-existing channel binding {chan} of client {client}\");\n402: \n403:                         continue;\n404:                     };\n405: \n406:                     if channel.is_expired(now) {\n407:                         tracing::info!(target: \"relay\", \"Channel {chan} is now expired\");\n408: \n409:                         channel.bound = false;\n410: \n411:                         self.time_events.add(\n412:                             now + Duration::from_secs(5 * 60),\n413:                             TimedAction::DeleteChannel((client, chan)),\n414:                         );\n415:                     }\n416:                 }\n417:                 TimedAction::DeleteChannel((client, chan)) => {\n418:                     self.delete_channel_binding(client, chan);\n419:                 }\n420:             }\n421:         }\n422:     }\n423: \n424:     /// An allocation failed.\n425:     #[tracing::instrument(skip(self), fields(%allocation), level = \"error\")]\n426:     pub fn handle_allocation_failed(&mut self, allocation: AllocationId) {\n427:         self.delete_allocation(allocation)\n428:     }\n429: \n430:     /// Return the next command to be executed.\n431:     pub fn next_command(&mut self) -> Option<Command> {\n432:         let num_commands = self.pending_commands.len();\n433: \n434:         if num_commands > 0 {\n435:             tracing::trace!(%num_commands, \"Popping next command\");\n436:         }\n437: \n438:         self.pending_commands.pop_front()\n439:     }\n440: \n441:     fn handle_binding_request(&mut self, message: Binding, sender: SocketAddr) {\n442:         let mut message = Message::new(\n443:             MessageClass::SuccessResponse,\n444:             BINDING,\n445:             message.transaction_id(),\n446:         );\n447:         message.add_attribute(XorMappedAddress::new(sender));\n448: \n449:         self.send_message(message, sender);\n450:     }\n451: \n452:     /// Handle a TURN allocate request.\n453:     ///\n454:     /// See <https://www.rfc-editor.org/rfc/rfc8656#name-receiving-an-allocate-reque> for details.\n455:     fn handle_allocate_request(\n456:         &mut self,\n457:         request: Allocate,\n458:         sender: SocketAddr,\n459:         now: SystemTime,\n460:     ) -> Result<(), Message<Attribute>> {\n461:         self.verify_auth(&request, now)?;\n462: \n463:         if let Some(allocation) = self.allocations.get(&sender) {\n464:             Span::current().record(\"allocation\", display(&allocation.id));\n465:             tracing::warn!(target: \"relay\", \"Client already has an allocation\");\n466: \n467:             return Err(error_response(AllocationMismatch, &request));\n468:         }\n469: \n470:         let max_available_ports = self.max_available_ports() as usize;\n471:         if self.allocations_by_port.len() == max_available_ports {\n472:             tracing::warn!(target: \"relay\", %max_available_ports, \"No more ports available\");\n473: \n474:             return Err(error_response(InsufficientCapacity, &request));\n475:         }\n476: \n477:         let requested_protocol = request.requested_transport().protocol();\n478:         if requested_protocol != UDP_TRANSPORT {\n479:             tracing::warn!(target: \"relay\", %requested_protocol, \"Unsupported protocol\");\n480: \n481:             return Err(error_response(BadRequest, &request));\n482:         }\n483: \n484:         let (first_relay_address, maybe_second_relay_addr) = derive_relay_addresses(\n485:             self.public_address,\n486:             request.requested_address_family(),\n487:             request.additional_address_family(),\n488:         )\n489:         .map_err(|e| error_response(e, &request))?;\n490: \n491:         // TODO: Do we need to handle DONT-FRAGMENT?\n492:         // TODO: Do we need to handle EVEN/ODD-PORT?\n493:         let effective_lifetime = request.effective_lifetime();\n494: \n495:         let allocation = self.create_new_allocation(\n496:             now,\n497:             &effective_lifetime,\n498:             first_relay_address,\n499:             maybe_second_relay_addr,\n500:         );\n501: \n502:         let mut message = Message::new(\n503:             MessageClass::SuccessResponse,\n504:             ALLOCATE,\n505:             request.transaction_id(),\n506:         );\n507: \n508:         let port = allocation.port;\n509: \n510:         message.add_attribute(XorRelayAddress::new(SocketAddr::new(\n511:             first_relay_address,\n512:             port,\n513:         )));\n514:         if let Some(second_relay_address) = maybe_second_relay_addr {\n515:             message.add_attribute(XorRelayAddress::new(SocketAddr::new(\n516:                 second_relay_address,\n517:                 port,\n518:             )));\n519:         }\n520: \n521:         message.add_attribute(XorMappedAddress::new(sender));\n522:         message.add_attribute(effective_lifetime.clone());\n523: \n524:         let wake_deadline = self.time_events.add(\n525:             allocation.expires_at,\n526:             TimedAction::ExpireAllocation(allocation.id),\n527:         );\n528:         self.pending_commands.push_back(Command::Wake {\n529:             deadline: wake_deadline,\n530:         });\n531:         self.pending_commands.push_back(Command::CreateAllocation {\n532:             id: allocation.id,\n533:             family: first_relay_address.family(),\n534:             port,\n535:         });\n536:         if let Some(second_relay_addr) = maybe_second_relay_addr {\n537:             self.pending_commands.push_back(Command::CreateAllocation {\n538:                 id: allocation.id,\n539:                 family: second_relay_addr.family(),\n540:                 port,\n541:             });\n542:         }\n543:         self.send_message(message, sender);\n544: \n545:         Span::current().record(\"allocation\", display(&allocation.id));\n546: \n547:         if let Some(second_relay_addr) = maybe_second_relay_addr {\n548:             tracing::info!(\n549:                 target: \"relay\",\n550:                 first_relay_address = field::display(first_relay_address),\n551:                 second_relay_address = field::display(second_relay_addr),\n552:                 lifetime = field::debug(effective_lifetime.lifetime()),\n553:                 \"Created new allocation\",\n554:             )\n555:         } else {\n556:             tracing::info!(\n557:                 target: \"relay\",\n558:                 first_relay_address = field::display(first_relay_address),\n559:                 lifetime = field::debug(effective_lifetime.lifetime()),\n560:                 \"Created new allocation\",\n561:             )\n562:         }\n563: \n564:         self.clients_by_allocation.insert(allocation.id, sender);\n565:         self.allocations.insert(sender, allocation);\n566:         self.allocations_up_down_counter.add(1, &[]);\n567: \n568:         Ok(())\n569:     }\n570: \n571:     /// Handle a TURN refresh request.\n572:     ///\n573:     /// See <https://www.rfc-editor.org/rfc/rfc8656#name-receiving-a-refresh-request> for details.\n574:     fn handle_refresh_request(\n575:         &mut self,\n576:         request: Refresh,\n577:         sender: SocketAddr,\n578:         now: SystemTime,\n579:     ) -> Result<(), Message<Attribute>> {\n580:         self.verify_auth(&request, now)?;\n581: \n582:         // TODO: Verify that this is the correct error code.\n583:         let allocation = self\n584:             .allocations\n585:             .get_mut(&sender)\n586:             .ok_or(error_response(AllocationMismatch, &request))?;\n587: \n588:         Span::current().record(\"allocation\", display(&allocation.id));\n589: \n590:         let effective_lifetime = request.effective_lifetime();\n591: \n592:         if effective_lifetime.lifetime().is_zero() {\n593:             let id = allocation.id;\n594: \n595:             self.delete_allocation(id);\n596:             self.send_message(\n597:                 refresh_success_response(effective_lifetime, request.transaction_id()),\n598:                 sender,\n599:             );\n600: \n601:             return Ok(());\n602:         }\n603: \n604:         allocation.expires_at = now + effective_lifetime.lifetime();\n605: \n606:         tracing::info!(\n607:             target: \"relay\",\n608:             port = %allocation.port,\n609:             \"Refreshed allocation\",\n610:         );\n611: \n612:         let wake_deadline = self.time_events.add(\n613:             allocation.expires_at,\n614:             TimedAction::ExpireAllocation(allocation.id),\n615:         );\n616:         self.pending_commands.push_back(Command::Wake {\n617:             deadline: wake_deadline,\n618:         });\n619:         self.send_message(\n620:             refresh_success_response(effective_lifetime, request.transaction_id()),\n621:             sender,\n622:         );\n623: \n624:         Ok(())\n625:     }\n626: \n627:     /// Handle a TURN channel bind request.\n628:     ///\n629:     /// See <https://www.rfc-editor.org/rfc/rfc8656#name-receiving-a-channelbind-req> for details.\n630:     fn handle_channel_bind_request(\n631:         &mut self,\n632:         request: ChannelBind,\n633:         sender: SocketAddr,\n634:         now: SystemTime,\n635:     ) -> Result<(), Message<Attribute>> {\n636:         self.verify_auth(&request, now)?;\n637: \n638:         let allocation = self\n639:             .allocations\n640:             .get_mut(&sender)\n641:             .ok_or(error_response(AllocationMismatch, &request))?;\n642: \n643:         // Note: `channel_number` is enforced to be in the correct range.\n644:         let requested_channel = request.channel_number().value();\n645:         let peer_address = request.xor_peer_address().address();\n646: \n647:         Span::current().record(\"allocation\", display(&allocation.id));\n648:         Span::current().record(\"peer\", display(&peer_address));\n649:         Span::current().record(\"channel\", display(&requested_channel));\n650: \n651:         // Check that our allocation can handle the requested peer addr.\n652:         if !allocation.can_relay_to(peer_address) {\n653:             tracing::warn!(target: \"relay\", \"Allocation cannot relay to peer\");\n654: \n655:             return Err(error_response(PeerAddressFamilyMismatch, &request));\n656:         }\n657: \n658:         // Ensure the same address isn't already bound to a different channel.\n659:         if let Some(number) = self.channel_numbers_by_peer.get(&peer_address) {\n660:             if number != &requested_channel {\n661:                 tracing::warn!(target: \"relay\", existing_channel = %number, \"Peer is already bound to another channel\");\n662: \n663:                 return Err(error_response(BadRequest, &request));\n664:             }\n665:         }\n666: \n667:         // Ensure the channel is not already bound to a different address.\n668:         if let Some(channel) = self\n669:             .channels_by_client_and_number\n670:             .get_mut(&(sender, requested_channel))\n671:         {\n672:             if channel.peer_address != peer_address {\n673:                 tracing::warn!(target: \"relay\", existing_peer = %channel.peer_address, \"Channel is already bound to a different peer\");\n674: \n675:                 return Err(error_response(BadRequest, &request));\n676:             }\n677: \n678:             // Binding requests for existing channels act as a refresh for the binding.\n679: \n680:             channel.refresh(now);\n681: \n682:             tracing::info!(target: \"relay\", \"Refreshed channel binding\");\n683: \n684:             self.time_events.add(\n685:                 channel.expiry,\n686:                 TimedAction::UnbindChannel((sender, requested_channel)),\n687:             );\n688:             self.send_message(\n689:                 channel_bind_success_response(request.transaction_id()),\n690:                 sender,\n691:             );\n692: \n693:             return Ok(());\n694:         }\n695: \n696:         // Channel binding does not exist yet, create it.\n697: \n698:         // TODO: Any additional validations would go here.\n699:         // TODO: Capacity checking would go here.\n700: \n701:         let allocation_id = allocation.id;\n702:         self.create_channel_binding(sender, requested_channel, peer_address, allocation_id, now);\n703:         self.send_message(\n704:             channel_bind_success_response(request.transaction_id()),\n705:             sender,\n706:         );\n707: \n708:         tracing::info!(target: \"relay\", \"Successfully bound channel\");\n709: \n710:         Ok(())\n711:     }\n712: \n713:     /// Handle a TURN create permission request.\n714:     ///\n715:     /// See <https://www.rfc-editor.org/rfc/rfc8656#name-receiving-a-createpermissio> for details.\n716:     ///\n717:     /// This TURN server implementation does not support relaying data other than through channels.\n718:     /// Thus, creating a permission is a no-op that always succeeds.\n719:     #[tracing::instrument(skip(self, message, now), fields(%sender), level = \"error\")]\n720:     fn handle_create_permission_request(\n721:         &mut self,\n722:         message: CreatePermission,\n723:         sender: SocketAddr,\n724:         now: SystemTime,\n725:     ) -> Result<(), Message<Attribute>> {\n726:         self.verify_auth(&message, now)?;\n727: \n728:         self.send_message(\n729:             create_permission_success_response(message.transaction_id()),\n730:             sender,\n731:         );\n732: \n733:         Ok(())\n734:     }\n735: \n736:     fn handle_channel_data_message(\n737:         &mut self,\n738:         message: ChannelData,\n739:         sender: SocketAddr,\n740:         _: SystemTime,\n741:     ) {\n742:         let channel_number = message.channel();\n743:         let data = message.data();\n744: \n745:         let Some(channel) = self\n746:             .channels_by_client_and_number\n747:             .get(&(sender, channel_number))\n748:         else {\n749:             tracing::debug!(target: \"relay\", channel = %channel_number, \"Channel does not exist, refusing to forward data\");\n750:             return;\n751:         };\n752: \n753:         // TODO: Do we need to enforce that only the creator of the channel can relay data?\n754:         // The sender of a UDP packet can be spoofed, so why would we bother?\n755: \n756:         if !channel.bound {\n757:             tracing::debug!(target: \"relay\", channel = %channel_number, \"Channel exists but is unbound\");\n758:             return;\n759:         }\n760: \n761:         Span::current().record(\"allocation\", field::display(&channel.allocation));\n762:         Span::current().record(\"recipient\", field::display(&channel.peer_address));\n763:         Span::current().record(\"channel\", field::display(&channel_number));\n764: \n765:         tracing::debug!(target: \"relay\", \"Relaying {} bytes\", data.len());\n766: \n767:         self.data_relayed_counter.add(data.len() as u64, &[]);\n768:         self.data_relayed += data.len() as u64;\n769: \n770:         if tracing::enabled!(target: \"wire\", tracing::Level::TRACE) {\n771:             let hex_bytes = hex::encode(data);\n772:             tracing::trace!(target: \"wire\", %hex_bytes, \"sending bytes\");\n773:         }\n774: \n775:         self.pending_commands.push_back(Command::ForwardData {\n776:             id: channel.allocation,\n777:             data: data.to_vec(),\n778:             receiver: channel.peer_address,\n779:         });\n780:     }\n781: \n782:     fn verify_auth(\n783:         &mut self,\n784:         request: &(impl StunRequest + ProtectedRequest),\n785:         now: SystemTime,\n786:     ) -> Result<(), Message<Attribute>> {\n787:         let message_integrity = request\n788:             .message_integrity()\n789:             .map_err(|e| error_response(e, request))?;\n790:         let username = request.username().map_err(|e| error_response(e, request))?;\n791:         let nonce = request\n792:             .nonce()\n793:             .map_err(|e| error_response(e, request))?\n794:             .value()\n795:             .parse::<Uuid>()\n796:             .map_err(|e| {\n797:                 log::debug!(\"failed to parse nonce: {e}\");\n798: \n799:                 error_response(Unauthorized, request)\n800:             })?;\n801: \n802:         self.nonces\n803:             .handle_nonce_used(nonce)\n804:             .map_err(|_| error_response(StaleNonce, request))?;\n805: \n806:         message_integrity\n807:             .verify(&self.auth_secret, username.name(), now)\n808:             .map_err(|_| error_response(Unauthorized, request))?;\n809: \n810:         Ok(())\n811:     }\n812: \n813:     fn create_new_allocation(\n814:         &mut self,\n815:         now: SystemTime,\n816:         lifetime: &Lifetime,\n817:         first_relay_addr: IpAddr,\n818:         second_relay_addr: Option<IpAddr>,\n819:     ) -> Allocation {\n820:         // First, find an unused port.\n821: \n822:         assert!(\n823:             self.allocations_by_port.len() < self.max_available_ports() as usize,\n824:             \"No more ports available; this would loop forever\"\n825:         );\n826: \n827:         let port = loop {\n828:             let candidate = self.rng.gen_range(self.lowest_port..self.highest_port);\n829: \n830:             if !self.allocations_by_port.contains_key(&candidate) {\n831:                 break candidate;\n832:             }\n833:         };\n834: \n835:         // Second, grab a new allocation ID.\n836:         let id = self.next_allocation_id.next();\n837: \n838:         self.allocations_by_port.insert(port, id);\n839: \n840:         Allocation {\n841:             id,\n842:             port,\n843:             expires_at: now + lifetime.lifetime(),\n844:             first_relay_addr,\n845:             second_relay_addr,\n846:         }\n847:     }\n848: \n849:     fn max_available_ports(&self) -> u16 {\n850:         self.highest_port - self.lowest_port\n851:     }\n852: \n853:     fn create_channel_binding(\n854:         &mut self,\n855:         client: SocketAddr,\n856:         requested_channel: u16,\n857:         peer_address: SocketAddr,\n858:         id: AllocationId,\n859:         now: SystemTime,\n860:     ) {\n861:         self.channels_by_client_and_number.insert(\n862:             (client, requested_channel),\n863:             Channel {\n864:                 expiry: now + CHANNEL_BINDING_DURATION,\n865:                 peer_address,\n866:                 allocation: id,\n867:                 bound: true,\n868:             },\n869:         );\n870:         self.channel_numbers_by_peer\n871:             .insert(peer_address, requested_channel);\n872:     }\n873: \n874:     fn send_message(&mut self, message: Message<Attribute>, recipient: SocketAddr) {\n875:         let method = message.method();\n876:         let class = message.class();\n877:         tracing::trace!(target: \"relay\",  method = %message.method(), class = %message.class(), \"Sending message\");\n878: \n879:         let Ok(bytes) = self.encoder.encode_into_bytes(message) else {\n880:             debug_assert!(false, \"Encoding should never fail\");\n881:             return;\n882:         };\n883: \n884:         if tracing::enabled!(target: \"wire\", tracing::Level::TRACE) {\n885:             let hex_bytes = hex::encode(&bytes);\n886:             tracing::trace!(target: \"wire\", %hex_bytes, \"sending bytes\");\n887:         }\n888: \n889:         self.pending_commands.push_back(Command::SendMessage {\n890:             payload: bytes,\n891:             recipient,\n892:         });\n893: \n894:         // record metrics\n895:         let response_class = match class {\n896:             MessageClass::SuccessResponse => \"success\",\n897:             MessageClass::ErrorResponse => \"error\",\n898:             _ => return,\n899:         };\n900:         let message_type = match method {\n901:             BINDING => \"binding\",\n902:             ALLOCATE => \"allocate\",\n903:             REFRESH => \"refresh\",\n904:             CHANNEL_BIND => \"channelbind\",\n905:             CREATE_PERMISSION => \"createpermission\",\n906:             _ => return,\n907:         };\n908:         self.responses_counter.add(\n909:             1,\n910:             &[\n911:                 KeyValue::new(\"response_class\", response_class),\n912:                 KeyValue::new(\"message_type\", message_type),\n913:             ],\n914:         );\n915:     }\n916: \n917:     fn get_allocation(&self, id: &AllocationId) -> Option<&Allocation> {\n918:         self.clients_by_allocation\n919:             .get(id)\n920:             .and_then(|client| self.allocations.get(client))\n921:     }\n922: \n923:     fn delete_allocation(&mut self, id: AllocationId) {\n924:         let Some(client) = self.clients_by_allocation.remove(&id) else {\n925:             tracing::debug!(\"Unable to delete unknown allocation\");\n926: \n927:             return;\n928:         };\n929:         let allocation = self\n930:             .allocations\n931:             .remove(&client)\n932:             .expect(\"internal state mismatch\");\n933: \n934:         let port = allocation.port;\n935: \n936:         self.allocations_by_port.remove(&port);\n937: \n938:         self.allocations_up_down_counter.add(-1, &[]);\n939:         self.pending_commands.push_back(Command::FreeAllocation {\n940:             id,\n941:             family: allocation.first_relay_addr.family(),\n942:         });\n943:         if let Some(second_relay_addr) = allocation.second_relay_addr {\n944:             self.pending_commands.push_back(Command::FreeAllocation {\n945:                 id,\n946:                 family: second_relay_addr.family(),\n947:             })\n948:         }\n949: \n950:         tracing::info!(target: \"relay\", %port, \"Deleted allocation\");\n951:     }\n952: \n953:     fn delete_channel_binding(&mut self, client: SocketAddr, chan: u16) {\n954:         let Some(channel) = self.channels_by_client_and_number.get(&(client, chan)) else {\n955:             return;\n956:         };\n957: \n958:         let addr = channel.peer_address;\n959: \n960:         self.channel_numbers_by_peer.remove(&addr);\n961:         self.channels_by_client_and_number.remove(&(client, chan));\n962:     }\n963: }\n964: \n965: fn refresh_success_response(\n966:     effective_lifetime: Lifetime,\n967:     transaction_id: TransactionId,\n968: ) -> Message<Attribute> {\n969:     let mut message = Message::new(MessageClass::SuccessResponse, REFRESH, transaction_id);\n970:     message.add_attribute(effective_lifetime);\n971:     message\n972: }\n973: \n974: fn channel_bind_success_response(transaction_id: TransactionId) -> Message<Attribute> {\n975:     Message::new(MessageClass::SuccessResponse, CHANNEL_BIND, transaction_id)\n976: }\n977: \n978: fn create_permission_success_response(transaction_id: TransactionId) -> Message<Attribute> {\n979:     Message::new(\n980:         MessageClass::SuccessResponse,\n981:         CREATE_PERMISSION,\n982:         transaction_id,\n983:     )\n984: }\n985: \n986: /// Represents an allocation of a client.\n987: struct Allocation {\n988:     id: AllocationId,\n989:     /// Data arriving on this port will be forwarded to the client iff there is an active data channel.\n990:     port: u16,\n991:     expires_at: SystemTime,\n992: \n993:     first_relay_addr: IpAddr,\n994:     second_relay_addr: Option<IpAddr>,\n995: }\n996: \n997: struct Channel {\n998:     /// When the channel expires.\n999:     expiry: SystemTime,\n1000: \n1001:     /// The address of the peer that the channel is bound to.\n1002:     peer_address: SocketAddr,\n1003: \n1004:     /// The allocation this channel belongs to.\n1005:     allocation: AllocationId,\n1006: \n1007:     /// Whether the channel is currently bound.\n1008:     ///\n1009:     /// Channels are active for 10 minutes. During this time, data can be relayed through the channel.\n1010:     /// After 10 minutes, the channel is considered unbound.\n1011:     ///\n1012:     /// To prevent race conditions, we MUST NOT use the same channel number for a different peer and vice versa for another 5 minutes after the channel becomes unbound.\n1013:     /// Once it becomes unbound, we simply flip this bool and only completely remove the channel after another 5 minutes.\n1014:     ///\n1015:     /// With the data structure still existing while the channel is unbound, our existing validations cover the above requirement.\n1016:     bound: bool,\n1017: }\n1018: \n1019: impl Channel {\n1020:     fn refresh(&mut self, now: SystemTime) {\n1021:         self.expiry = now + CHANNEL_BINDING_DURATION;\n1022:     }\n1023: \n1024:     fn is_expired(&self, now: SystemTime) -> bool {\n1025:         self.expiry <= now\n1026:     }\n1027: }\n1028: \n1029: impl Allocation {\n1030:     fn can_relay_to(&self, addr: SocketAddr) -> bool {\n1031:         // Currently, we only support IPv4, thus any IPv6 address is invalid.\n1032:         addr.is_ipv4()\n1033:     }\n1034: }\n1035: \n1036: impl Allocation {\n1037:     fn is_expired(&self, now: SystemTime) -> bool {\n1038:         self.expires_at <= now\n1039:     }\n1040: }\n1041: \n1042: #[derive(PartialEq)]\n1043: enum TimedAction {\n1044:     ExpireAllocation(AllocationId),\n1045:     UnbindChannel((SocketAddr, u16)),\n1046:     DeleteChannel((SocketAddr, u16)),\n1047: }\n1048: \n1049: fn error_response(\n1050:     error_code: impl Into<ErrorCode>,\n1051:     request: &impl StunRequest,\n1052: ) -> Message<Attribute> {\n1053:     let mut message = Message::new(\n1054:         MessageClass::ErrorResponse,\n1055:         request.method(),\n1056:         request.transaction_id(),\n1057:     );\n1058:     message.add_attribute(Attribute::from(error_code.into()));\n1059: \n1060:     message\n1061: }\n1062: \n1063: /// Derive the relay address for the client based on the request and the supported IP stack of the relay server.\n1064: ///\n1065: /// By default, a client gets an IPv4 address.\n1066: /// They can request an _additional_ IPv6 address or only an IPv6 address.\n1067: /// This is handled with two different STUN attributes: [AdditionalAddressFamily] and [RequestedAddressFamily].\n1068: ///\n1069: /// The specification mandates certain checks for how these attributes can be used.\n1070: /// In a nutshell, the requirements constrain the use such that there is only one way of doing things.\n1071: /// For example, it is disallowed to use [RequestedAddressFamily] for IPv6 and requested and an IPv4 address via [AdditionalAddressFamily].\n1072: /// If this is desired, clients should simply use [AdditionalAddressFamily] for IPv6.\n1073: fn derive_relay_addresses(\n1074:     public_address: IpStack,\n1075:     requested_addr_family: Option<&RequestedAddressFamily>,\n1076:     additional_addr_family: Option<&AdditionalAddressFamily>,\n1077: ) -> Result<(IpAddr, Option<IpAddr>), ErrorCode> {\n1078:     match (\n1079:         public_address,\n1080:         requested_addr_family.map(|r| r.address_family()),\n1081:         additional_addr_family.map(|a| a.address_family()),\n1082:     ) {\n1083:         (\n1084:             IpStack::Ip4(addr) | IpStack::Dual { ip4: addr, .. },\n1085:             None | Some(AddressFamily::V4),\n1086:             None,\n1087:         ) => Ok((addr.into(), None)),\n1088:         (IpStack::Ip6(addr) | IpStack::Dual { ip6: addr, .. }, Some(AddressFamily::V6), None) => {\n1089:             Ok((addr.into(), None))\n1090:         }\n1091:         (IpStack::Dual { ip4, ip6 }, None, Some(AddressFamily::V6)) => {\n1092:             Ok((ip4.into(), Some(ip6.into())))\n1093:         }\n1094:         (IpStack::Ip4(ip4), None, Some(AddressFamily::V6)) => {\n1095:             // TODO: The spec says to also include an error code here.\n1096:             // For now, we will just partially satisfy the request.\n1097:             // We expect clients to gracefully handle this by only extracting the relay addresses they receive.\n1098: \n1099:             tracing::warn!(target: \"relay\", \"Partially fulfilling allocation using only an IPv4 address\");\n1100: \n1101:             Ok((ip4.into(), None))\n1102:         }\n1103:         (IpStack::Ip6(ip6), None, Some(AddressFamily::V6)) => {\n1104:             // TODO: The spec says to also include an error code here.\n1105:             // For now, we will just partially satisfy the request.\n1106:             // We expect clients to gracefully handle this by only extracting the relay addresses they receive.\n1107: \n1108:             tracing::warn!(target: \"relay\", \"Partially fulfilling allocation using only an IPv6 address\");\n1109: \n1110:             Ok((ip6.into(), None))\n1111:         }\n1112:         (_, Some(_), Some(_)) => {\n1113:             tracing::warn!(target: \"relay\", \"Specifying `REQUESTED-ADDRESS-FAMILY` and `ADDITIONAL-ADDRESS-FAMILY` is against the spec\");\n1114: \n1115:             Err(BadRequest.into())\n1116:         }\n1117:         (_, _, Some(AddressFamily::V4)) => {\n1118:             tracing::warn!(target: \"relay\", \"Specifying `IPv4` for `ADDITIONAL-ADDRESS-FAMILY` is against the spec\");\n1119: \n1120:             Err(BadRequest.into())\n1121:         }\n1122:         (IpStack::Ip6(_), None | Some(AddressFamily::V4), None) => {\n1123:             tracing::warn!(target: \"relay\", \"Cannot provide an IPv4 allocation on an IPv6-only relay\");\n1124: \n1125:             Err(AddressFamilyNotSupported.into())\n1126:         }\n1127:         (IpStack::Ip4(_), Some(AddressFamily::V6), _) => {\n1128:             tracing::warn!(target: \"relay\", \"Cannot provide an IPv6 allocation on an IPv4-only relay\");\n1129: \n1130:             Err(AddressFamilyNotSupported.into())\n1131:         }\n1132:     }\n1133: }\n1134: \n1135: /// Private helper trait to make [`error_response`] more ergonomic to use.\n1136: trait StunRequest {\n1137:     fn transaction_id(&self) -> TransactionId;\n1138:     fn method(&self) -> Method;\n1139: }\n1140: \n1141: macro_rules! impl_stun_request_for {\n1142:     ($t:ty, $m:expr) => {\n1143:         impl StunRequest for $t {\n1144:             fn transaction_id(&self) -> TransactionId {\n1145:                 self.transaction_id()\n1146:             }\n1147: \n1148:             fn method(&self) -> Method {\n1149:                 $m\n1150:             }\n1151:         }\n1152:     };\n1153: }\n1154: \n1155: impl_stun_request_for!(Allocate, ALLOCATE);\n1156: impl_stun_request_for!(ChannelBind, CHANNEL_BIND);\n1157: impl_stun_request_for!(CreatePermission, CREATE_PERMISSION);\n1158: impl_stun_request_for!(Refresh, REFRESH);\n1159: \n1160: /// Private helper trait to make [`Server::verify_auth`] more ergonomic to use.\n1161: trait ProtectedRequest {\n1162:     fn message_integrity(&self) -> Result<&MessageIntegrity, Unauthorized>;\n1163:     fn username(&self) -> Result<&Username, Unauthorized>;\n1164:     fn nonce(&self) -> Result<&Nonce, Unauthorized>;\n1165: }\n1166: \n1167: macro_rules! impl_protected_request_for {\n1168:     ($t:ty) => {\n1169:         impl ProtectedRequest for $t {\n1170:             fn message_integrity(&self) -> Result<&MessageIntegrity, Unauthorized> {\n1171:                 self.message_integrity().ok_or(Unauthorized)\n1172:             }\n1173: \n1174:             fn username(&self) -> Result<&Username, Unauthorized> {\n1175:                 self.username().ok_or(Unauthorized)\n1176:             }\n1177: \n1178:             fn nonce(&self) -> Result<&Nonce, Unauthorized> {\n1179:                 self.nonce().ok_or(Unauthorized)\n1180:             }\n1181:         }\n1182:     };\n1183: }\n1184: \n1185: impl_protected_request_for!(Allocate);\n1186: impl_protected_request_for!(ChannelBind);\n1187: impl_protected_request_for!(CreatePermission);\n1188: impl_protected_request_for!(Refresh);\n1189: \n1190: // Define an enum of all attributes that we care about for our server.\n1191: stun_codec::define_attribute_enums!(\n1192:     Attribute,\n1193:     AttributeDecoder,\n1194:     AttributeEncoder,\n1195:     [\n1196:         MessageIntegrity,\n1197:         XorMappedAddress,\n1198:         ErrorCode,\n1199:         RequestedTransport,\n1200:         XorRelayAddress,\n1201:         Lifetime,\n1202:         ChannelNumber,\n1203:         XorPeerAddress,\n1204:         Nonce,\n1205:         Realm,\n1206:         Username,\n1207:         RequestedAddressFamily,\n1208:         AdditionalAddressFamily\n1209:     ]\n1210: );\n1211: \n1212: #[cfg(test)]\n1213: mod tests {\n1214:     use super::*;\n1215:     use std::net::{Ipv4Addr, Ipv6Addr};\n1216: \n1217:     // Tests for requirements listed in https://www.rfc-editor.org/rfc/rfc8656#name-receiving-an-allocate-reque.\n1218: \n1219:     // 6. The server checks if the request contains both REQUESTED-ADDRESS-FAMILY and ADDITIONAL-ADDRESS-FAMILY attributes. If yes, then the server rejects the request with a 400 (Bad Request) error.\n1220:     #[test]\n1221:     fn requested_and_additional_is_bad_request() {\n1222:         let error_code = derive_relay_addresses(\n1223:             IpStack::Ip4(Ipv4Addr::LOCALHOST),\n1224:             Some(&RequestedAddressFamily::new(AddressFamily::V4)),\n1225:             Some(&AdditionalAddressFamily::new(AddressFamily::V6)),\n1226:         )\n1227:         .unwrap_err();\n1228: \n1229:         assert_eq!(error_code.code(), BadRequest::CODEPOINT)\n1230:     }\n1231: \n1232:     // 7. If the server does not support the address family requested by the client in REQUESTED-ADDRESS-FAMILY, or if the allocation of the requested address family is disabled by local policy, it MUST generate an Allocate error response, and it MUST include an ERROR-CODE attribute with the 440 (Address Family not Supported) response code.\n1233:     // If the REQUESTED-ADDRESS-FAMILY attribute is absent and the server does not support the IPv4 address family, the server MUST include an ERROR-CODE attribute with the 440 (Address Family not Supported) response code.\n1234:     #[test]\n1235:     fn requested_address_family_not_available_is_not_supported() {\n1236:         let error_code = derive_relay_addresses(\n1237:             IpStack::Ip4(Ipv4Addr::LOCALHOST),\n1238:             Some(&RequestedAddressFamily::new(AddressFamily::V6)),\n1239:             None,\n1240:         )\n1241:         .unwrap_err();\n1242: \n1243:         assert_eq!(error_code.code(), AddressFamilyNotSupported::CODEPOINT);\n1244: \n1245:         let error_code = derive_relay_addresses(\n1246:             IpStack::Ip6(Ipv6Addr::LOCALHOST),\n1247:             Some(&RequestedAddressFamily::new(AddressFamily::V4)),\n1248:             None,\n1249:         )\n1250:         .unwrap_err();\n1251: \n1252:         assert_eq!(error_code.code(), AddressFamilyNotSupported::CODEPOINT);\n1253: \n1254:         let error_code =\n1255:             derive_relay_addresses(IpStack::Ip6(Ipv6Addr::LOCALHOST), None, None).unwrap_err();\n1256: \n1257:         assert_eq!(error_code.code(), AddressFamilyNotSupported::CODEPOINT)\n1258:     }\n1259: \n1260:     //9. The server checks if the request contains an ADDITIONAL-ADDRESS-FAMILY attribute. If yes, and the attribute value is 0x01 (IPv4 address family), then the server rejects the request with a 400 (Bad Request) error.\n1261:     #[test]\n1262:     fn additional_address_family_ip4_is_bad_request() {\n1263:         let error_code = derive_relay_addresses(\n1264:             IpStack::Ip4(Ipv4Addr::LOCALHOST),\n1265:             None,\n1266:             Some(&AdditionalAddressFamily::new(AddressFamily::V4)),\n1267:         )\n1268:         .unwrap_err();\n1269: \n1270:         assert_eq!(error_code.code(), BadRequest::CODEPOINT)\n1271:     }\n1272: }\n\n(End of file - total 1272 lines)\n</content>",
