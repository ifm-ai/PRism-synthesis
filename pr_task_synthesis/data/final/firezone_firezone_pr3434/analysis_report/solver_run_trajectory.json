:new(\n344:                 channel_bind_transaction_id,\n345:                 channel,\n346:                 XorPeerAddress::new(peer.into()),\n347:                 valid_username(now, &username_salt),\n348:                 &secret,\n349:                 nonce,\n350:             ),\n351:             now,\n352:         ),\n353:         [send_message(\n354:             source,\n355:             channel_bind_response(channel_bind_transaction_id),\n356:         )],\n357:     );\n358: \n359:     let now = now + Duration::from_secs(1);\n360: \n361:     server.assert_commands(\n362:         from_client(\n363:             source,\n364:             ChannelData::new(channel.value(), client_to_peer_ping.as_ref()),\n365:             now,\n366:         ),\n367:         [forward(peer, &client_to_peer_ping, 49152)],\n368:     );\n369: \n370:     server.assert_commands(\n371:         from_peer(peer, peer_to_client_ping.as_ref(), 49152),\n372:         [send_channel_data(\n373:             source,\n374:             ChannelData::new(channel.value(), peer_to_client_ping.as_ref()),\n375:         )],\n376:     );\n377: }\n378: \n379: #[proptest]\n380: fn can_make_ipv6_allocation(\n381:     #[strategy(firezone_relay::proptest::transaction_id())] transaction_id: TransactionId,\n382:     #[strategy(firezone_relay::proptest::allocation_lifetime())] lifetime: Lifetime,\n383:     #[strategy(firezone_relay::proptest::username_salt())] username_salt: String,\n384:     source: SocketAddrV4,\n385:     public_relay_ip4_addr: Ipv4Addr,\n386:     public_relay_ip6_addr: Ipv6Addr,\n387:     #[strategy(firezone_relay::proptest::now())] now: SystemTime,\n388:     #[strategy(firezone_relay::proptest::nonce())] nonce: Uuid,\n389: ) {\n390:     let mut server =\n391:         TestServer::new((public_relay_ip4_addr, public_relay_ip6_addr)).with_nonce(nonce);\n392:     let secret = server.auth_secret();\n393: \n394:     server.assert_commands(\n395:         from_client(\n396:             source,\n397:             Allocate::new_authenticated_udp_ip6(\n398:                 transaction_id,\n399:                 Some(lifetime.clone()),\n400:                 valid_username(now, &username_salt),\n401:                 secret,\n402:                 nonce,\n403:             ),\n404:             now,\n405:         ),\n406:         [\n407:             Wake(now + lifetime.lifetime()),\n408:             CreateAllocation(49152, AddressFamily::V6),\n409:             send_message(\n410:                 source,\n411:                 allocate_response(\n412:                     transaction_id,\n413:                     public_relay_ip6_addr,\n414:                     49152,\n415:                     source,\n416:                     &lifetime,\n417:                 ),\n418:             ),\n419:         ],\n420:     );\n421: }\n422: \n423: struct TestServer {\n424:     server: Server<StepRng>,\n425:     id_to_port: HashMap<u16, AllocationId>,\n426: }\n427: \n428: impl TestServer {\n429:     fn new(relay_public_addr: impl Into<IpStack>) -> Self {\n430:         Self {\n431:             server: Server::new(relay_public_addr, StepRng::new(0, 0), 49152, 65535),\n432:             id_to_port: Default::default(),\n433:         }\n434:     }\n435: \n436:     fn with_nonce(mut self, nonce: Uuid) -> Self {\n437:         self.server.add_nonce(nonce);\n438: \n439:         self\n440:     }\n441: \n442:     fn auth_secret(&self) -> &SecretString {\n443:         self.server.auth_secret()\n444:     }\n445: \n446:     fn assert_commands<const N: usize>(&mut self, input: Input, output: [Output; N]) {\n447:         match input {\n448:             Input::Client(sender, message, now) => {\n449:                 self.server.handle_client_message(message, sender, now);\n450:             }\n451:             Input::Time(now) => {\n452:                 self.server.handle_deadline_reached(now);\n453:             }\n454:             Input::Peer(peer, data, port) => {\n455:                 self.server\n456:                     .handle_peer_traffic(&data, peer, self.id_to_port[&port]);\n457:             }\n458:         }\n459: \n460:         for expected_output in output {\n461:             let Some(actual_output) = self.server.next_command() else {\n462:                 let msg = match expected_output {\n463:                     Output::SendMessage((recipient, msg)) => {\n464:                         format!(\"to send message {:?} to {recipient}\", msg)\n465:                     }\n466:                     Wake(time) => format!(\"to be woken at {time:?}\"),\n467:                     CreateAllocation(port, family) => {\n468:                         format!(\"to create allocation on port {port} for address family {family}\")\n469:                     }\n470:                     FreeAllocation(port, family) => {\n471:                         format!(\"to free allocation on port {port} for address family {family}\")\n472:                     }\n473:                     Output::SendChannelData((peer, _)) => {\n474:                         format!(\"to send channel data from {peer} to client\")\n475:                     }\n476:                     Output::Forward((peer, _, _)) => format!(\"to forward data to peer {peer}\"),\n477:                 };\n478: \n479:                 panic!(\"No commands produced but expected {msg}\");\n480:             };\n481: \n482:             match (expected_output, actual_output) {\n483:                 (\n484:                     Output::SendMessage((to, message)),\n485:                     Command::SendMessage { payload, recipient },\n486:                 ) => {\n487:                     let expected_bytes = MessageEncoder::new()\n488:                         .encode_into_bytes(message.clone())\n489:                         .unwrap();\n490: \n491:                     if expected_bytes != payload {\n492:                         let expected_message = format!(\"{:?}\", message);\n493:                         let actual_message = format!(\"{:?}\", parse_message(&payload));\n494: \n495:                         difference::assert_diff!(&expected_message, &actual_message, \"\\n\", 0);\n496:                     }\n497: \n498:                     assert_eq!(recipient, to);\n499:                 }\n500:                 (Wake(when), Command::Wake { deadline }) => {\n501:                     assert_eq!(when, deadline);\n502:                 }\n503:                 (\n504:                     CreateAllocation(expected_port, expected_family),\n505:                     Command::CreateAllocation {\n506:                         id,\n507:                         family: actual_family,\n508:                         port: actual_port,\n509:                     },\n510:                 ) => {\n511:                     self.id_to_port.insert(actual_port, id);\n512:                     assert_eq!(expected_port, actual_port);\n513:                     assert_eq!(expected_family, actual_family);\n514:                 }\n515:                 (\n516:                     FreeAllocation(port, family),\n517:                     Command::FreeAllocation {\n518:                         id,\n519:                         family: actual_family,\n520:                     },\n521:                 ) => {\n522:                     let actual_id = self.id_to_port.remove(&port).expect(\"to have port in map\");\n523:                     assert_eq!(id, actual_id);\n524:                     assert_eq!(family, actual_family);\n525:                 }\n526:                 (Wake(when), Command::SendMessage { payload, .. }) => {\n527:                     panic!(\n528:                         \"Expected `Wake({})`, got `SendMessage({:?})`\",\n529:                         when.duration_since(SystemTime::UNIX_EPOCH)\n530:                             .unwrap()\n531:                             .as_secs(),\n532:                         parse_message(&payload)\n533:                     )\n534:                 }\n535:                 (\n536:                     Output::SendChannelData((peer, channeldata)),\n537:                     Command::SendMessage { recipient, payload },\n538:                 ) => {\n539:                     let expected_channel_data = hex::encode(channeldata.to_bytes());\n540:                     let actual_message = hex::encode(payload);\n541: \n542:                     assert_eq!(expected_channel_data, actual_message);\n543:                     assert_eq!(recipient, peer);\n544:                 }\n545:                 (\n546:                     Output::Forward((peer, expected_data, port)),\n547:                     Command::ForwardData {\n548:                         id,\n549:                         data: actual_data,\n550:                         receiver,\n551:                     },\n552:                 ) => {\n553:                     assert_eq!(hex::encode(expected_data), hex::encode(actual_data));\n554:                     assert_eq!(receiver, peer);\n555:                     assert_eq!(self.id_to_port[&port], id);\n556:                 }\n557:                 (expected, actual) => panic!(\"Unhandled combination: {expected:?} {actual:?}\"),\n558:             }\n559:         }\n560: \n561:         let remaining_commands = iter::from_fn(|| self.server.next_command()).collect::<Vec<_>>();\n562: \n563:         assert_eq!(remaining_commands, vec![])\n564:     }\n565: }\n566: \n567: fn valid_username(now: SystemTime, salt: &str) -> Username {\n568:     let now_unix = now\n569:         .duration_since(SystemTime::UNIX_EPOCH)\n570:         .unwrap()\n571:         .as_secs();\n572: \n573:     let expiry = now_unix + 1000;\n574: \n575:     Username::new(format!(\"{expiry}:{salt}\")).unwrap()\n576: }\n577: \n578: fn binding_response(\n579:     transaction_id: TransactionId,\n580:     address: impl Into<SocketAddr>,\n581: ) -> Message<Attribute> {\n582:     let mut message =\n583:         Message::<Attribute>::new(MessageClass::SuccessResponse, BINDING, transaction_id);\n584:     message.add_attribute(Xor