            "output": "<path>/workspace/auto_gptq/nn_modules/qlinear/qlinear_marlin.py</path>\n<type>file</type>\n<content>\n1: # Copyright (C) Marlin.2024 Elias Frantar (elias.frantar@ist.ac.at)\n2: #\n3: # Licensed under the Apache License, Version 2.0 (the \"License\");\n4: # you may not use this file except in compliance with the License.\n5: # You may obtain a copy of the License at\n6: #\n7: #         http://www.apache.org/licenses/LICENSE-2.0\n8: #\n9: # Unless required by applicable law or agreed to in writing, software\n10: # distributed under the License is distributed on an \"AS IS\" BASIS,\n11: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n12: # See the License for the specific language governing permissions and\n13: # limitations under the License.\n14: import math\n15: from logging import getLogger\n16: \n17: import numpy as np\n18: import torch\n19: import torch.nn as nn\n20: import transformers\n21: \n22: logger = getLogger(__name__)\n23: \n24: try:\n25:     import marlin_cuda\n26: \n27:     _marlin_available = True\n28: except ImportError:\n29:     _marlin_available = False\n30: \n31: \n32: def mul(A, B, C, s, workspace, thread_k=-1, thread_n=-1, sms=-1):\n33:     \"\"\"Marlin FP16xINT4 multiply; can be used within `torch.compile`.\n34:     @A: `torch.half` input matrix of shape `(m, k)` in standard row-major layout\n35:     @B: `torch.int` weight matrix of original shape `(k, n)` in Marlin format; see `Layer.pack()`\n36:     @C: `torch.half` out matrix of shape `(m, n)` in standard row-major layout\n37:     @s: `torch.half` scales of shape `(m / group_size, n)`\n38:     @workspace: `torch.int` tensor with at least as many entries as there a GPU SMs (256 is usually safe)\n39:     @thread_k: `k` size of a thread_tile in `B` (can usually be left as auto -1)\n40:     @thread_n: `n` size of a thread_tile in `B` (can usually be left as auto -1)\n41:     @sms: number of SMs to use for the kernel (can usually be left as auto -1)\n42:     \"\"\"\n43:     marlin_cuda.mul(A, B, C, s, workspace, thread_k, thread_n, sms)\n44: \n45: \n46: # Precompute permutations for Marlin weight and scale shuffling \n47: \n48: def _get_perms():\n49:     perm = []\n50:     for i in range(32):\n51:         perm1 = []\n52:         col = i // 4\n53:         for block in [0, 1]:\n54:             for row in [\n55:                 2 * (i % 4),\n56:                 2 * (i % 4) + 1,\n57:                 2 * (i % 4 + 4),\n58:                 2 * (i % 4 + 4) + 1\n59:             ]:\n60:                 perm1.append(16 * row + col + 8 * block)\n61:         for j in range(4):\n62:             perm.extend([p + 256 * j for p in perm1])\n63: \n64:     perm = np.array(perm)\n65:     interleave = np.array([0, 2, 4, 6, 1, 3, 5, 7])\n66:     perm = perm.reshape((-1, 8))[:, interleave].ravel()\n67:     perm = torch.from_numpy(perm)\n68:     scale_perm = []\n69:     for i in range(8):\n70:         scale_perm.extend([i + 8 * j for j in range(8)])\n71:     scale_perm_single = []\n72:     for i in range(4):\n73:         scale_perm_single.extend([2 * i + j for j in [0, 1, 8, 9, 16, 17, 24, 25]])\n74:     return perm, scale_perm, scale_perm_single\n75: \n76: \n77: _perm, _scale_perm, _scale_perm_single = _get_perms()\n78: \n79: \n80: class QuantLinear(nn.Module):\n81:     QUANT_TYPE = \"marlin\"\n82: \n83:     def __init__(\n84:             self,\n85:             bits,\n86:             group_size,\n87:             infeatures,\n88:             outfeatures,\n89:             bias,\n90:             trainable=False,\n91:             **kwargs\n92:     ):\n93:         super().__init__()\n94:         if infeatures % 128 != 0 or outfeatures != 256 == 0:\n95:             raise ValueError('`infeatures` must be divisible by 128 and `outfeatures` by 256.')\n96:         if bits not in [4]:\n97:             raise NotImplementedError(\"Only 4 bits are supported.\")\n98:         if group_size not in [-1, 128] and group_size != infeatures:\n99:             raise ValueError('Only group_size -1 and 128 are supported.')\n100:         if infeatures % group_size != 0:\n101:             raise ValueError('`infeatures` must be divisible by `group_size`.')\n102:         if trainable:\n103:             raise NotImplementedError('Marlin does not support train.')\n104: \n105:         self.infeatures = infeatures\n106:         self.outfeatures = outfeatures\n107:         self.group_size = group_size if group_size != -1 else infeatures\n108:         self.register_buffer('B', torch.empty((self.infeatures // 16, self.outfeatures * 16 // 8), dtype=torch.int))\n109:         self.register_buffer('s', torch.empty((self.infeatures // group_size, self.outfeatures), dtype=torch.half))\n110:         # 128 is currently the minimum `tile_n`, hence it gives the maximum workspace size\n111:         self.register_buffer('workspace', torch.zeros(self.outfeatures // 128, dtype=torch.int), persistent=False)\n112:         if bias:\n113:             self.register_buffer('bias', torch.zeros((outfeatures), dtype=torch.half))\n114:         else:\n115:             self.bias = None\n116:             \n117:     def post_init(self):\n118:         pass\n119: \n120:     def pack(self, linear, scales):\n121:         \"\"\"Pack a fake-quantized linear layer into this actual Marlin representation.\n122:         @linear: fake-quantized `torch.nn.Linear` layer to convert (must be of type `torch.half`)\n123:         @scales: corresponding quantization scales of shape `(infeatures, groups)`\n124:         \"\"\"\n125:         if linear.weight.dtype != torch.half:\n126:             raise ValueError('Only `torch.half` weights are supported.')\n127:         tile = 16\n128:         maxq = 2 ** 4 - 1\n129:         s = scales.t()\n130:         w = linear.weight.data.t()\n131:         if self.group_size != self.infeatures:\n132:             w = w.reshape((-1, self.group_size, self.outfeatures))\n133:             w = w.permute(1, 0, 2)\n134:             w = w.reshape((self.group_size, -1))\n135:             s = s.reshape((1, -1))\n136:         w = torch.round(w / s).int()\n137:         w += (maxq + 1) // 2\n138:         w = torch.clamp(w, 0, maxq)\n139:         if self.group_size != self.infeatures:\n140:             w = w.reshape((self.group_size, -1, self.outfeatures))\n141:             w = w.permute(1, 0, 2)\n142:             w = w.reshape((self.infeatures, self.outfeatures)).contiguous()\n143:             s = s.reshape((-1, len(_scale_perm)))[:, _scale_perm]\n144:         else:\n145:             s = s.reshape((-1, len(_scale_perm_single)))[:, _scale_perm_single]\n146:         s = s.reshape((-1, self.outfeatures)).contiguous()\n147:         w = w.reshape((self.infeatures // tile, tile, self.outfeatures // tile, tile))\n148:         w = w.permute((0, 2, 1, 3))\n149:         w = w.reshape((self.infeatures // tile, self.outfeatures * tile))\n150:         res = w\n151:         res = res.reshape((-1, _perm.numel()))[:, _perm].reshape(res.shape)\n152:         q = np.zeros((res.shape[0], res.shape[1] // 8), dtype=np.uint32)\n153:         res = res.cpu().numpy().astype(np.uint32)\n154:         for i in range(8):\n155:             q |= res[:, i::8] << 4 * i\n156:         q = torch.from_numpy(q.astype(np.int32)).to(w.device)\n157:         self.B[:, :] = q.to(self.B.device)\n158:         self.s[:, :] = s.to(self.s.device)\n159:         if self.bias is not None:\n160:             self.bias[:] = linear.bias.data.to(self.bias.device)\n161: \n162:     def forward(self, A):\n163:         A = A.half()\n164:         C = torch.empty(A.shape[:-1] + (self.s.shape[1],), dtype=A.dtype, device=A.device)\n165:         mul(A.view((-1, A.shape[-1])), self.B, C.view((-1, C.shape[-1])), self.s, self.workspace)\n166:         C = C + self.bias if self.bias is not None else C \n167:         return C\n168: \n169: \n170: # Adapted from https://github.com/rib-2/marlin/tree/conversion\n171: def _validate_marlin_compatibility(quantization_config):\n172:     if quantization_config.bits != 4:\n173:         return f\"The quantized model uses a bitwidth different than 4 (found {quantization_config.bits})\"\n174:     if quantization_config.group_size != 128 and quantization_config.group_size != -1:\n175:         return f\"The quantized model uses a group size that is not 128 or -1 (found quantization_config.group_size)\"\n176:     if not quantization_config.sym:\n177:         return f\"The quantized model uses asymmetric quantization\"\n178:     if quantization_config.desc_act:\n179:         return f\"The quantized model uses act-order (also called desc-act) scheme\"\n180:     return None\n181: \n182: # Copied from https://github.com/IST-DASLab/marlin/pull/1\n183: @torch.no_grad()\n184: def unpack_4bit_to_32bit_signed(qweight, qzeros):\n185:     # Unpack 4-bit values and interpret them as signed integers\n186:     unpacked_weights = torch.zeros(\n187:         (qweight.shape[0] * 8, qweight.shape[1]),\n188:         dtype=torch.int8,\n189:         device=qweight.device,\n190:         requires_grad=False\n191:     )\n192: \n193:     unpacked_zeros = torch.zeros(\n194:         (qzeros.shape[0], qzeros.shape[1] * 8),\n195:         dtype=torch.int8,\n196:         device=qzeros.device,\n197:         requires_grad=False\n198:     )\n199: \n200:     for row in range(unpacked_weights.shape[0]):\n201:         i = row % 8\n202:         unpacked_weights[row, :] = (qweight[row // 8, :] >> (4 * i)) & 0xF\n203: \n204:     for col in range(unpacked_zeros.shape[1]):\n205:         i = col % 8\n206:         unpacked_zeros[:, col] = (qzeros[:, col // 8] >> (4 * i)) & 0xF\n207: \n208:     return unpacked_weights, unpacked_zeros + 1\n209: \n210: # Copied from https://github.com/IST-DASLab/marlin/pull/1\n211: @torch.no_grad()\n212: def dequantize_weight(layer):\n213:     qweight, qzeros, scales = layer.qweight, layer.qzeros, layer.scales\n214:     unpacked_qweight, unpacked_qzeros = unpack_4bit_to_32bit_signed(qweight, qzeros)\n215:     group_size = unpacked_qweight.shape[0] // scales.shape[0]\n216:     scales = scales.repeat_interleave(group_size, dim=0)\n217:     unpacked_qzeros = unpacked_qzeros.repeat_interleave(group_size, dim=0)\n218:     unpacked_qweight = (unpacked_qweight - unpacked_qzeros) * scales\n219: \n220:     return unpacked_qweight.T, unpacked_qzeros\n221: \n222: __all__ = [\"QuantLinear\", \"_validate_marlin_compatibility\", \"dequantize_weight\"]\n\n(End of file - total 222 lines)\n</content>",
