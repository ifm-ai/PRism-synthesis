        create_pr (`bool`, *optional*, defaults to `False`):\n527:                 Whether or not to create a PR with the uploaded files or directly commit.\n528:         \"\"\"\n529:         if (self.quantize_config.model_name_or_path is None or not isdir(self.quantize_config.model_name_or_path)) and save_dir is None:\n530:             raise ValueError(\"Quantized model should be saved first, or you can provide save_dir to make sure model is saved to local disk before uploading.\")\n531:         \n532:         if save_dir is not None:\n533:             logger.info(f\"Saving model to {save_dir}\")\n534:             self.save_quantized(save_dir, use_safetensors, safetensors_metadata)\n535: \n536:         repo_url = create_repo(\n537:             repo_id=repo_id, token=token, private=private, exist_ok=True, repo_type=\"model\"\n538:         )\n539:         repo_id = repo_url.repo_id\n540: \n541:         if self.quantize_config.model_name_or_path is not None:\n542:             work_dir = self.quantize_config.model_name_or_path\n543:             operations = [\n544:                 CommitOperationAdd(path_or_fileobj=join(work_dir, f), path_in_repo=f)\n545:                 for f in os.listdir(work_dir)\n546:             ]\n547:             logger.info(f\"Uploading the following files to {repo_id}: {','.join(os.listdir(work_dir))}\")\n548:             return create_commit(\n549:                 repo_id=repo_id,\n550:                 operations=operations,\n551:                 commit_message=commit_message,\n552:                 token=use_auth_token,\n553:                 create_pr=create_pr,\n554:                 repo_type=\"model\",\n555:             )\n556: \n557:     def save_quantized(self, save_dir: str, use_safetensors: bool = True, safetensors_metadata: Optional[Dict[str, str]] = None):\n558:         \"\"\"save quantized model and configs to local disk\"\"\"\n559:         os.makedirs(save_dir, exist_ok=True)\n560: \n561:         if not self.quantized:\n562:       