              "file": "test_marlin_implementation.py",
              "patch": "Index: test_marlin_implementation.py\n===================================================================\n--- test_marlin_implementation.py\t\n+++ test_marlin_implementation.py\t\n@@ -0,0 +1,160 @@\n+\"\"\"\n+Test script to verify Marlin format support implementation.\n+This script demonstrates the expected behavior but requires PyTorch and CUDA to run.\n+\"\"\"\n+\n+import os\n+import time\n+import tempfile\n+from auto_gptq import AutoGPTQForCausalLM, BaseQuantizeConfig\n+from auto_gptq.utils.marlin_utils import _get_cached_marlin_save_name\n+from auto_gptq.nn_modules.qlinear.qlinear_marlin import QuantLinear as MarlinQuantLinear\n+\n+\n+def test_get_cached_marlin_save_name():\n+    \"\"\"Test that _get_cached_marlin_save_name returns paths with 'assets' substring.\"\"\"\n+    \n+    # Test local path\n+    local_path = \"/tmp/test_model\"\n+    result = _get_cached_marlin_save_name(local_path)\n+    assert \"assets\" in result, f\"Local path should contain 'assets': {result}\"\n+    assert result == os.path.join(local_path, \"assets\", \"marlin_model.safetensors\")\n+    print(f\"✓ Local path test passed: {result}\")\n+    \n+    # Test remote path (mock)\n+    # Note: This would actually create a cache directory in practice\n+    remote_path = \"test/model\"\n+    result = _get_cached_marlin_save_name(remote_path)\n+    assert \"assets\" in result, f\"Remote path should contain 'assets': {result}\"\n+    print(f\"✓ Remote path test passed: {result}\")\n+\n+\n+def test_marlin_loading_and_saving():\n+    \"\"\"Test the full cycle of loading, saving, and reloading Marlin models.\"\"\"\n+    \n+    model_id = \"TheBloke/Llama-2-7B-Chat-GPTQ\"\n+    \n+    # First load with use_marlin=True\n+    print(\"\\n=== First Load (GPTQ -> Marlin conversion) ===\")\n+    start_time = time.time()\n+    model1 = AutoGPTQForCausalLM.from_quantized(\n+        model_id,\n+        device=\"cuda:0\",\n+        use_marlin=True,\n+        use_triton=False,\n+        inject_fused_attention=False,\n+        inject_fused_mlp=False,\n+        disable_exllama=True,\n+        disable_exllamav2=True\n+    )\n+    first_load_time = time.time() - start_time\n+    print(f\"First load time: {first_load_time:.2f}s\")\n+    \n+    # Verify model has MarlinQuantLinear modules\n+    has_marlin = False\n+    for name, module in model1.named_modules():\n+        if isinstance(module, MarlinQuantLinear):\n+            has_marlin = True\n+            break\n+    assert has_marlin, \"Model should have MarlinQuantLinear modules\"\n+    print(\"✓ Model has MarlinQuantLinear modules\")\n+    \n+    # Save the model\n+    with tempfile.TemporaryDirectory() as tmpdir:\n+        save_path = os.path.join(tmpdir, \"saved_model\")\n+        print(f\"\\n=== Saving Model to {save_path} ===\")\n+        model1.save_pretrained(save_path)\n+        \n+        # Verify files\n+        assert os.path.exists(os.path.join(save_path, \"model.safetensors\")), \\\n+            \"Should save model.safetensors for Marlin format\"\n+        assert not os.path.exists(os.path.join(save_path, \"autogptq_model.safetensors\")), \\\n+            \"Should NOT create autogptq_model.safetensors\"\n+        \n+        # Verify config\n+        import json\n+        with open(os.path.join(save_path, \"quantize_config.json\"), \"r\") as f:\n+            config = json.load(f)\n+        assert config.get(\"is_marlin_format\") == True, \\\n+            \"Config should have is_marlin_format: true\"\n+        print(\"✓ Saved model.safetensors and quantize_config.json with is_marlin_format: true\")\n+        \n+        # Second load from saved model\n+        print(f\"\\n=== Second Load (from saved Marlin model) ===\")\n+        start_time = time.time()\n+        model2 = AutoGPTQForCausalLM.from_quantized(\n+            save_path,\n+            device=\"cuda:0\",\n+            use_marlin=True,\n+            use_triton=False,\n+            inject_fused_attention=False,\n+            inject_fused_mlp=False,\n+            disable_exllama=True,\n+            disable_exllamav2=True\n+        )\n+        second_load_time = time.time() - start_time\n+        print(f\"Second load time: {second_load_time:.2f}s\")\n+        \n+        # Verify fast load (< 20% of first load)\n+        assert second_load_time < 0.2 * first_load_time, \\\n+            f\"Second load should be < 20% of first load ({second_load_time:.2f}s vs {first_load_time:.2f}s)\"\n+        print(f\"✓ Second load is {100*second_load_time/first_load_time:.1f}% of first load time (fast!)\")\n+        \n+        # Verify model has MarlinQuantLinear modules\n+        has_marlin = False\n+        for name, module in model2.named_modules():\n+            if isinstance(module, MarlinQuantLinear):\n+                has_marlin = True\n+                break\n+        assert has_marlin, \"Reloaded model should have MarlinQuantLinear modules\"\n+        print(\"✓ Reloaded model has MarlinQuantLinear modules\")\n+    \n+    # Third load (from cache)\n+    print(f\"\\n=== Third Load (from Marlin cache) ===\")\n+    start_time = time.time()\n+    model3 = AutoGPTQForCausalLM.from_quantized(\n+        model_id,\n+        device=\"cuda:0\",\n+        use_marlin=True,\n+        use_triton=False,\n+        inject_fused_attention=False,\n+        inject_fused_mlp=False,\n+        disable_exllama=True,\n+        disable_exllamav2=True\n+    )\n+    third_load_time = time.time() - start_time\n+    print(f\"Third load time: {third_load_time:.2f}s\")\n+    \n+    # Verify fast load (< 20% of first load)\n+    assert third_load_time < 0.2 * first_load_time, \\\n+        f\"Third load should be < 20% of first load ({third_load_time:.2f}s vs {first_load_time:.2f}s)\"\n+    print(f\"✓ Third load is {100*third_load_time/first_load_time:.1f}% of first load time (fast!)\")\n+    \n+    # Verify model has MarlinQuantLinear modules\n+    has_marlin = False\n+    for name, module in model3.named_modules():\n+        if isinstance(module, MarlinQuantLinear):\n+            has_marlin = True\n+            break\n+    assert has_marlin, \"Cached model should have MarlinQuantLinear modules\"\n+    print(\"✓ Cached model has MarlinQuantLinear modules\")\n+    \n+    print(\"\\n=== All Tests Passed! ===\")\n+\n+\n+if __name__ == \"__main__\":\n+    print(\"Testing Marlin format support implementation...\")\n+    print(\"=\" * 60)\n+    \n+    # Test helper function\n+    test_get_cached_marlin_save_name()\n+    \n+    # Test full cycle (requires GPU)\n+    try:\n+        import torch\n+        if torch.cuda.is_available():\n+            test_marlin_loading_and_saving()\n+        else:\n+            print(\"\\n⚠ CUDA not available, skipping full cycle test\")\n+    except ImportError:\n+        print(\"\\n⚠ PyTorch not available, skipping full cycle test\")\n",
