odel.named_modules():\n56:         if name.endswith(module_name):\n57:             return module\n58: \n59: \n60: def make_quant(\n61:     module,\n62:     names,\n63:     bits,\n64:     group_size,\n65:     name='',\n66:     use_triton: bool = False,\n67:     disable_exllama: Optional[bool] = None,\n68:     disable_exllamav2: bool = False, \n69:     use_qigen: bool = False,\n70:     use_cuda_fp16: bool = True,\n71:     desc_act: bool = False,\n72:     trainable: bool = False\n73: ):\n74:     # If disable_exllamav2 is True, we want to fall back on the exllama kernel and not the cuda/cuda_old ones.\n75:     if disable_exllama is None:\n76:         if disable_exllamav2:\n77:             disable_exllama = False\n78:         else:\n79:             disable_exllama = True\n80: \n81:     QuantLinear = dynamically_import_QuantLinear(use_triton=use_triton, desc_act=desc_act, group_size=group_size, bits=bits, disable_exllama=disable_exllama, disable_exllamav2=disable_exllamav2, use_qigen=use_qigen)\n82: \n83:     if isinstance(module, QuantLinear):\n84:         return\n85:     for attr in dir(module):\n86:         tmp = getattr(module, attr)\n87:         name1 = name + '.' + attr if name != '' else attr\n88:         if name1 in names:\n89:             ori_layer_device = get_device(getattr(module, attr))\n90:             delattr(module, attr)\n91:             if isinstance(tmp,nn.Linear):\n92:                 in_features = tmp.in_features\n93:                 out_features = tmp.out_features\n94:             elif isinstance(tmp,nn.Conv2d):\n95:                 in_features = tmp.in_channels\n96:                 out_features = tmp.out_channels\n97:             elif isinstance(tmp,transformers.pytorch_utils.Conv1D):            \n98:                 in_features = tmp.weight.shape[0]\n99:                 out_features = tmp.weight.shape[1]\n100:             if (not(desc_act) or group_size == -1) and not use_triton and not use_qigen:\n101:                 new_layer = QuantLinear(\n102:                     bits, group_size, in_features, out_features, True, use_cuda_fp16=use_cuda_fp16, trainable=trainable, weight_dtype=tmp.weight.dtype\n103:                 )\n104:             else:\n105:                 new_layer = QuantLinear(bits, group_size, in_features, out_features, True, trainable=trainable, weight_dtype=tmp.weight.dtype)\n106:             new_layer.device = ori_layer_device\n107:             setattr(module, attr, new_layer.to(ori_layer_device))\n108:     for name1, child in module.named_children():\n109:         make_quant(\n110:             child,\n111:             names,\n112:             bits,\n113:             group_size,\n114:             name + '.' + name1 if name != '' else name1,\n115:             use_triton=use_triton,\n116:             use_cuda_fp16=use_cuda_fp16,\n117:             desc_act=desc_act,\n118:             trainable=trainable,\n119:             disable_exllama=disable_exllama,\n120:             disable_exllamav2=disable_exllamav2,\n121:             use_qigen=use_qigen\n122:         )\n123: \n124: @torch.no_grad()\n125: def convert_to_marlin(model, model_quantlinear, quantization_config, repack: bool):\n126:     \"\"\"\n127:     Converts GPTQ-packed weights to the Marlin format. This assumes that the model already meets Marlin kernel constraints.\n128: \n129:     Arguments:\n130:         repack (`bool`):\n131:             Whether to repack the qweights from `model` into the Marlin's QuantLinear layers.\n132:     \"\"\"\n133:     if repack:\n134:         message = \"Repacking weights to be compatible with Marlin kernel...\"\n135:     else:\n136:         message = \"Overriding QuantLinear layers to use Marlin's QuantLinear...\"\n137: \n138:     for name, module in tqdm(model.named_modules(), desc=message, total=len(list(model.named_modules()))):\n139:         if not isinstance(module, model_quantlinear):\n140:             continue\n141: \n142:         if module.bias is not None and torch.count_nonzero(module.bias) > 0:\n143:             bias = module.bias\n144:         else:\n145:             bias = None\n146: \n147:         parent_name = \".\".join(name.split(\".\")[:-1])\n148:         layer_name = name[len(parent_name) + 1:]\n149: \n150:         # Dequantize the weight.\n151:         if repack:\n152:             dequantized_weight, dequantized_qzeros = dequantize_weight(module)\n153:             dequantized_weight = dequantized_weight.to(torch.float16)\n154: \n155:             if not torch.all(dequantized_qzeros == 8):\n156:                 raise ValueError(f\"Marlin kernel is compatible only with checkpoints using symetric quantization. Found non-symmetric quantization for the weight {name}.\")\n157: \n158:             linear_module = nn.Linear(\n159:                 in_features=dequantized_weight.shape[1],\n160:                 out_features=dequantized_weight.shape[0],\n161:                 bias=bias is not None,\n162:                 dtype=torch.float16,\n163:                 device=\"cuda\"\n164:             )\n165:             linear_module.weight.data.copy_(dequantized_weight)\n166: \n167:             if bias is not None:\n168:                 linear_module.bias.data.copy_(bias)\n169:         else:\n170:             linear_module = nn.Linear(module.infeatures, module.outfeatures, bias=bias is not None, dtype=torch.float16, device=\"cuda\")\n171: \n172:         # Create new linear method and copy to model.\n173:         new_module = MarlinQuantLinear(\n174:             bits=4,\n175:             group_size=module.group_size,\n176:             infeatures=linear_module.in_features,\n177:             outfeatures=linear_module.out_features,\n178:             bias=bias is not None,\n179:             trainable=False,\n180:         )\n181: \n182:         if repack:\n183:             new_module.pack(linear_module, scales=copy.deepcopy(module.scales.data.t()).to(\"cuda\"))\n184: \n185:         # Save to parent.\n186:         parent_module = model.get_submodule(parent_name)\n187:         setattr(parent_module, layer_name, new_module)\n188: \n189:         # Free cuda memory.\n190:         del module\n191:         if repack:\n192:             del dequantized_weight\n193:         torch.cuda.empty_cache()\n194:         gc.collect()\n195:     return model\n196: \n197: def preprocess_checkpoint_qigen(\n198:     module,\n199:     names,\n200:     bits,\n201:     group_size,\n202:     checkpoint,\n203:     name='',\n204: ):\n205:     try:\n206:         import cQIGen as qinfer\n207:     except ImportError:\n208:         logger.error('cQIGen not installed.')\n209:         raise\n210: \n211:     QuantLinear = dynamically_import_QuantLinear(use_triton=False, desc_act=False, group_size=group_size, bits=bits, disable_exllama=False, use_qigen=True)\n212:     if isinstance(module, QuantLinear):\n213:         in_features = module.infeatures\n214:         out_features = module.outfeatures\n215:         \n216:         zeros = checkpoint[name + '.qzeros']\n217:         scales = checkpoint[name + '.scales'].float()\n218:         \n219:         if zeros.dtype != torch.float32:\n220:             new_zeros = torch.zeros_like(scales).float().contiguous()\n221:             if bits == 4:\n222:                 qinfer.unpack_zeros4(zeros, new_zeros, new_zeros.shape[0], new_zeros.shape[1])\n223:             elif bits == 2:\n224:                 qinfer.unpack_zeros2(zeros, new_zeros, new_zeros.shape[0], new_zeros.shape[1])\n225:             elif bits == 3:\n226:                 logger.info(\"Unpacking zeros for 3 bits\")\n227:             new_scales = scales.contiguous()\n228:         else:\n229:             if scales.shape[1] != out_features:\n230:                 new_scales = scales.transpose(0,1).contiguous()\n231:             else:\n232:                 new_scales = scales.contiguous()\n233:             if zeros.shape[1] != out_features:\n234:                 new_zeros = zeros.transpose(0,1).contiguous()\n235:             else:\n236:                 new_zeros = zeros.contiguous()\n237: \n238:         checkpoint[name + '.zeros'],checkpoint[name + '.scales'] = new_zeros, new_scales\n239:         del checkpoint[name + '.qzeros']\n240:         del checkpoint[name + '.g_idx']\n241:         if name + '.bias' in checkpoint:\n242:             checkpoint[name + '.bias'] = checkpoint[name + '.bias'].float()\n243:         else:\n244:             checkpoint[name + '.bias'] = torch.zeros(out_features)\n245:         checkpoint_qweight = checkpoint[name + '.qweight'].int().contiguous()\n246:         if bits == 4:\n247:             qweight = torch.zeros(int(in_features // 8 * out_features)).int().contiguous()\n248:             qinfer.pack4(checkpoint_qweight, qweight, in_features // 8, out_features, module.mb, module.tb, module.cutoff)# * (module.tt//tb))\n249:         elif bits == 3:\n250:             qweight = torch.zeros(int(in_features // 32 * 3 * out_features)).int().contiguous()\n251:             qinfer.pack3(checkpoint_qweight, qweight, in_features // 32 * 3, out_features, module.mb // 32 * 3, module.tb, module.cutoff)\n252:         elif bits == 2:\n253:             qweight = torch.zeros(int(in_features // 16 * out_features)).int().contiguous()\n254:             qinfer.pack2(checkpoint_qweight, qweight, in_features // 16, out_features, module.mb, module.tb, module.cutoff)# * (module.tt//tb))\n255:         checkpoint[name + '.qweight'] = qweight\n256:         return\n257: \n258:     for name1, child in module.named_children():\n259:         preprocess_checkpoint_qigen(\n260:             child,\n261:             names,\n262:             bits,\n263:             group_size,\n264:             checkpoint,\n265:             name + '.' + name1 if name != '' else name1,\n266:         )\n267: \n268: def pack_model(\n269:     model,\n270:     quantizers,\n271:     bits,\n272:     group_size,\n273:     use_triton=False,\n274:     use_cuda_fp16=True,\n275:     desc_act=False,\n276:     warmup_triton: bool = False,\n277:     force_layer_back_to_cpu: bool = False\n278: ):\n279:     QuantLinear = dynamically_import_QuantLinear(use_triton=use_triton, desc_act=desc_act, group_size=group_size, bits=bits, disable_exllama=False, disable_exllamav2=True)\n280: \n281:     if force_layer_back_to_cpu:\n282:         model.to(CPU)\n283: \n284:     logger.info('Packing model...')\n285:     layers = find_layers(model)\n286:     layers = {n: layers[n] for n in quantizers}\n287:     make_quant(model, quantizers, bits, group_size, use_triton=use_triton, use_cuda_fp16=use_cuda_fp16, desc_act=desc_act, disable_exllama=False, disable_exllamav2=True)\n288:     qlayers = find_layers(model, [QuantLinear])\n289:     for name in qlayers:\n290:         logger.info(name)\n291:         quantizers[name], scale, zero, g_idx = quantizers[name]\n292:         # so far can only pack layer on CPU\n293:         layer_device = qlayers[name].device\n294:         qlayers[name].to(CPU)\n295:         layers[name], scale, zero, g_idx = layers[name].to(CPU), scale.to(CPU), zero.to(CPU), g_idx.to(CPU)\n296:         qlayers[name].pack(layers[name], scale, zero, g_idx)\n297:         qlayers[name].to(layer_device)\n298:     logger.info('Model packed.')\n299: \n300:     if use_triton and warmup_triton:\n301:         logger.warning(\n302:             \"using autotune_warmup will move model to GPU, make sure you have enough VRAM to load the whole model.\"\n303:         )\n304:         QuantLinear.warmup(model.to(CUDA_0), seqlen=model.seqlen)\n305: \n306: \n307: def check_and_get_model_type(model_dir, trust_remote_code=False):\n308:     config = AutoConfig.from_pretrained(model_dir, trust_remote_code=trust_remote_code)\n309:     if config.model_type not in SUPPORTED_MODELS:\n310:         raise TypeError(f\"{config.model_type} isn't supported yet.\")\n311:     model_type = config.model_type\n312:     return model_type\n313: \n314: \n315: def simple_dispatch_model(model, device_map):\n316:     from accelerate.hooks import add_hook_to_module, AlignDevicesHook\n317: \n318:     if \"\" in device_map:\n319:         d = device_map[\"\"]\n320:         model = model.to(torch.device(d))\n321:         model.hf_device_map = device_map\n322:         return model\n323: \n324:     tied_params = accelerate.utils.modeling.find_tied_parameters(model)\n325:     if set(device_map.values()) == {\"cpu\"} or set(device_map.values()) == {\"cpu\", \"disk\"}:\n326:         main_device = \"cpu\"\n327:     else:\n328:         main_device = [d for d in device_map.values() if d not in [\"cpu\", \"disk\"]][0]\n329: \n330:     cpu_offload_group = [(n, d) for n, d in device_map.items() if d == \"cpu\"]\n331:     prev_hook = None\n332:     for idx, (n, d) in enumerate(cpu_offload_group):\n333:         m = get_module_by_name_suffix(model, n)\n334:         _, prev_hook = accelerate.cpu_offload_with_hook(m, execution_device=main_device, prev_module_hook=prev_hook)\n335:     # set first cpu offload module's prev_module_hook to the last cpu offload module's hook\n336:     if len(cpu_offload_group) > 1:\n337:         get_module_by_name_suffix(model, cpu_offload_group[0][0])._hf_hook.prev_module_hook = prev_hook\n338: \n339:     for n, d in device_map.items():\n340:         m = get_module_by_name_suffix(model, n)\n341:         if d != \"cpu\":\n342:             d = torch.device(d)\n343:             hook = AlignDevicesHook(d, io_same_device=True, place_submodules=True)\n344:             add_hook_to_module(m, hook)\n345:     accelerate.utils.modeling.retie_parameters(model, tied_params)\n346:     model.hf_device_map = device_map\n347: \n348:     return model\n349: \n350: \n351: def autogptq_post_init(model, use_act_order: bool, max_input_length: Optional[int] = None):\n352:     \"\"\"\n353:     The max_input_length argument is specific to the exllama backend, that requires to initialize a buffer temp_state.\n354:     \"\"\"\n355:     device_to_buffers_size = {}\n356: \n357:     model_uses_exllama = False\n358:     for name, submodule in model.named_modules():\n359:         if hasattr(submodule, \"QUANT_TYPE\") and submodule.QUANT_TYPE == \"exllama\":\n360:             model_uses_exllama = True\n361:             device = submodule.qweight.device\n362:             if device not in device_to_buffers_size:\n363:                 device_to_buffers_size[device] = {\n364:                     \"max_dq_buffer_size\": 1,\n365:                     \"max_inner_outer_dim\": 1\n366:                 }\n367:             \n368:             if not use_act_order:\n369:                 submodule._use_act_order = False\n370:             else:\n371:                 submodule._use_act_order = True\n372: \n373:             # Disable this heuristic for detecting act_order, but it could be used instead of the config.\n374:             \"\"\"\n375:             if submodule.g_idx is None:\n376:                 submodule.act_order = False\n377:             elif submodule.g_idx is not None and ((submodule.g_idx == 0).all() or torch.equal(submodule.g_idx.cpu(), torch.tensor([i // submodule.group_size for i in range(submodule.g_idx.shape[0])], dtype=torch.int32))):\n378:                 submodule.g_idx = None\n379:                 submodule.act_order = False\n380:             else:\n381:                 submodule.act_order = True\n382:             \"\"\"\n383: \n384:             device_to_buffers_size[device][\"max_dq_buffer_size\"] = max(device_to_buffers_size[device][\"max_dq_buffer_size\"], submodule.qweight.numel() * 8)\n385: \n386:             if use_act_order:\n387:                 device_to_buffers_size[device][\"max_inner_outer_dim\"] = max(device_to_buffers_size[device][\"max_inner_outer_dim\"], submodule.infeatures, submodule.outfeatures)\n388: \n389:     if model_uses_exllama:\n390:         # To be honest this is quite ugly, not proud of this.\n391:         try:\n392:             from exllama_kernels import prepare_buffers, set_tuning_params\n393:         except ImportError as e:\n394:             raise ImportError(f\"Could not import exllama backend dep