r_forward_hook(add_batch(name)))\n387:                 for j in range(num_batches):\n388:                     layer_input = move_to_device(layer_inputs[j], cur_layer_device)\n389:                     layer_attention_mask = move_to_device(attention_masks[j], cur_layer_device)\n390:                     additional_layer_inputs = {\n391:                         \"attention_mask\": layer_attention_mask\n392:                     }\n393:                     layer_position_ids = None if not position_ids else move_to_device(position_ids[j], cur_layer_device)\n394:                     if layer_position_ids is not None:\n395:                         additional_layer_inputs[\"position_ids\"] = layer_position_ids\n396:                     for k, v in layer_input_kwargs[j].items():\n397:                         additional_layer_inputs[k] = nested_move_to_device(v, cur_layer_device)\n398:                     layer(layer_input, **additional_layer_inputs)\n399:                 for h in handles:\n400:                     h.remove()\n401: \n402:                 for name in subset:\n403:                     logger.info(f'Quantizing {name} in layer {i + 1}/{len(layers)}...')\n404:                     scale, zero, g_idx = gptq[name].fasterquant(\n405:                         percdamp=self.quantize_config.damp_percent,\n406:                         group_size=self.quantize_config.group_size,\n407:                         actorder=self.quantize_config.desc_act,\n408:                         static_groups=self.quantize_config.static_groups\n409:                     )\n410:                     quantizers[f'{self.layers_block_name}.{i}.{name}'] = (\n411:                         gptq[name].quantizer.to(CPU if force_layer_back_to_cpu else cur_layer_device),\n412:                         move_to_device(scale, CPU if force_layer_back_to_cpu else cur_layer_device),\n413:                         move_to_device(zero, CPU if force_layer_back_to_cpu else cur_layer_device),\n414:                         move_to_device(g_idx, CPU if force_layer_back_to_cpu else cur_layer_device)\n415:                     )\n416:                     gptq[name].free()\n417: \n418:             for j in range(num_batches):\n419:                 layer_input = move_to_device(layer_inputs[j], cur_layer_device)\n420:                 layer_attention_mask = move_to_device(attention_masks[j], cur_layer_device)\n421:                 additional_layer_inputs = {\n422:                     \"attention_mask\": layer_attention_mask\n423:                 }\n424:                 layer_position_ids = None if not position_ids else move_to_device(position_ids[j], cur_layer_device)\n425:                 if layer_position_ids is not None:\n426:                     additional_layer_inputs[\"position_ids\"] = layer_position_ids\n427:                 for k, v in layer_input_kwargs[j].items():\n428:                     additional_layer_inputs[k] = nested_move_to_device(v, cur_layer_device)\n429:                 layer_output = move_to_device(\n430:                     layer(layer_input, **additional_layer_inputs)[0],\n431:                     cur_layer_device if cache_examples_on_gpu else CPU\n432:                 )\n433:                 layer_outputs.append(layer_output)\n434: \n435:             layers[i] = move_to_device(layer, CPU if force_layer_back_to_cpu else cur_layer_device)\n436:             del layer\n437:             del gptq\n438:             del layer_inputs\n439:             layer_inputs, layer_outputs = layer_outputs, []\n440:             torch.cuda.empty_cache()\n441: \n442:         pack_model(\n443:             model=self.model,\n444:             quantizers=quantizers,\n445:             bits=self.quantize_config.bits,\n446:             group_size=self.quantize_config.group_size,\n447:             use_triton=use_triton,\n448:             use_cuda_fp16=use_cuda_fp16,\n449:             desc_act=self.quantize_config.desc_act,\n450:             warmup_triton=autotune_warmup_after_quantized,\n451:             force_layer_back_to_cpu=force_layer_back_to_cpu\n452:         )\n453:         if device_map:\n454:             self.model = remove_hook_from_module(self.model, recurse=True)\n455:             self.model = simple_dispatch_model(self.model, device_map)\n456:         self.model.config.use_cache = forward_pass_use_cache\n457: \n458:         self._quantized = True\n459: \n460:         torch.cuda.empty_cache()\n461: \n462:     @property\n463:     def device(self):\n464:         if not self.hf_device_map:\n465:             return self.model.device\n466:         else:\n467:             device = [d for d in self.hf_device_map.values() if d not in {'disk'}][0]\n468:             return torch.device(device)\n469: \n470:     def to(self, device: Union[str, torch.device]):\n471:         self.model.to(device)\n472:         return self\n473: \n474:     def forward(self, *args, **kwargs):\n475:         return self.model(*args, **kwargs)\n476: \n477:     def generate(self, **kwargs):\n478:         \"\"\"shortcut for model.generate\"\"\"\n479:         with torch.inference_mode(), torch.amp.autocast(device_type=self.device.type):\n480:             return self.model.generate(**kwargs)\n481: \n482:     def prepare_inputs_for_generation(self, *args, **kwargs):\n483:         \"\"\"shortcut for model.prepare_inputs_for_generation\"\"\"\n484:         return self.model.prepare_inputs_for_generation(*args, **kwargs)\n485: \n486:     def push_to_hub(\n487:         self,\n488:         repo_id: str,\n489:         save_dir: Optional[str] = None,\n490:         use_safetensors: Optional[bool] = True,\n491:         safetensors_metadata: Optional[Dict[str, str]] = None,\n492:         commit_message: Optional[str] = \"Upload of AutoGPTQ quantized model\",\n493:         use_auth_token: Optional[Union[bool, str]] = None,\n494:         private: Optional[bool] = None,\n495:         token: Optional[Union[bool, str]] = None,\n496:         create_pr: Optional[bool] = False,\n497:     ) -> str:\n498