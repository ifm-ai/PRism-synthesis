:         config = AutoConfig.from_pretrained(pretrained_model_name_or_path, trust_remote_code=True, **cached_file_kwargs)\n666:         if config.model_type not in SUPPORTED_MODELS:\n667:             raise TypeError(f\"{config.model_type} isn't supported yet.\")\n668: \n669:         # enforce some values despite user specified\n670:         model_init_kwargs[\"torch_dtype\"] = torch_dtype\n671:         model_init_kwargs[\"trust_remote_code\"] = trust_remote_code\n672:         if max_memory:\n673:             if \"disk\" in max_memory:\n674:                 raise NotImplementedError(\"disk offload not support yet.\")\n675:             with accelerate.init_empty_weights():\n676:                 model = AutoModelForCausalLM.from_config(config, trust_remote_code=True)\n677:             model.tie_weights()\n678: \n679:             max_memory = accelerate.utils.get_balanced_memory(\n680:                 model,\n681:                 max_memory=max_memory,\n682:                 no_split_module_classes=[cls.layer_type],\n683:                 dtype=model_init_kwargs[\"torch_dtype\"],\n684:                 low_zero=False\n685:             )\n686:             model_init_kwargs[\"device_map\"] = accelerate.infer_auto_device_map(\n687:                 model,\n688:                 max_memory=max_memory,\n689:                 no_split_module_classes=[cls.layer_type],\n690:                 dtype=model_init_kwargs[\"torch_dtype\"]\n691:             )\n692:             model_init_kwargs[\"low_cpu_mem_usage\"] = True\n693: \n694:             del model\n695:         else:\n696:             model_init_kwargs[\"device_map\"] = None\n697:             model_init_kwargs[\"low_cpu_mem_usage\"] = False\n698: \n699:         torch.cuda.empty_cache()\n700: \n701:         merged_kwargs = {**model_init_kwargs, **cached_file_kwargs}\n702:         model = AutoModelForCausalLM.from_pretrained(pretrained_model_name_or_path, **merged_kwargs)\n703: \n704:         model_config = model.config.to_dict()\n7