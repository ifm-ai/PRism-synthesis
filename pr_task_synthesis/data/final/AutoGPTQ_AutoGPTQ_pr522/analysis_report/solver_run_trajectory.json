lt from exllama repo here.\n181:         matmul_recons_thd = 8\n182:         matmul_fused_remap = False\n183:         matmul_no_half2 = False\n184:         set_tuning_params(matmul_recons_thd, matmul_fused_remap, matmul_no_half2)\n185: \n186:         inp = torch.rand(1, m, k, dtype=torch.float16).to(device)\n187: \n188:         with torch.no_grad():\n189:             res = linear(inp)[0][0]\n190: \n191:         reference = CUDA_OLD_REFERENCE.to(device)\n192: \n193:         self.assertTrue(torch.allclose(res, reference, rtol=3e-5, atol=2e-2), get_diff(res, reference))\n194:     \n195:     def test_exllama_buffer_size(self):\n196:         prompt = \"I am in Paris and\" * 450\n197:         device = torch.device(\"cuda:0\")\n198: \n199:         model_id = \"TheBloke/vicuna-13B-1.1-GPTQ-4bit-128g\"\n200:         revision = \"actorder\"\n201:         model_basename = \"vicuna-13B-1.1-GPTQ-4bit-128g.latest\"\n202: \n203:         model_q = AutoGPTQForCausalLM.from_quantized(model_id, revision=revision, device=\"cuda:0\", use_triton=False, inject_fused_attention=False, inject_fused_mlp=True, model_basename=model_basename, disable_exllama=False, disable_exllamav2=True)\n204:         tokenizer = AutoTokenizer.from_pretrained(model_id)\n205: \n206:         inp = tokenizer(prompt, return_tensors=\"pt\").to(device)\n207: \n208:         self.assertTrue(inp[\"input_ids\"].shape[1] > EXLLAMA_DEFAULT_MAX_INPUT_LENGTH)  # 2048 is the default max_input_length\n209: \n210:         with self.assertRaises(RuntimeError) as cm:\n211:             res = model_q.generate(**inp, num_beams=1, min_new_tokens=3, max_new_tokens=3)\n212:         self.assertTrue(\"temp_state buffer is too small\" in str(cm.exception))\n213: \n214:         model_q = exllama_set_max_input_length(model_q, 4096)\n215: \n216:         res = model_q.generate(**inp, num_beams=1, min_new_tokens=3, max_new_tokens=3)\n217: \n218:         model_q = exllama_set_max_input_length(model_q, 1034)\n219: \n220:         with self.assert