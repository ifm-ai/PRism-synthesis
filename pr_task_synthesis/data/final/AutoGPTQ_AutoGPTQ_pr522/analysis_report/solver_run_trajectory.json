new_safetensors_metadata\n591:                 if converted_keys:\n592:                     logger.debug(f\"One or more safetensors_metadata keys or values had to be converted to str(). Final safetensors_metadata: {safetensors_metadata}\")\n593: \n594:             # Format is required to enable Accelerate to load the metadata\n595:             # otherwise it raises an OSError\n596:             safetensors_metadata['format'] = \"pt\"\n597: \n598:             # Store the quantization configuration as safetensors metadata\n599:             from auto_gptq import __version__\n600:             safetensors_metadata['auto_gptq_version'] = str(__version__)\n601:             safetensors_metadata['gptq_bits'] = str(self.quantize_config.bits)\n602:             safetensors_metadata['gptq_group_size'] = str(self.quantize_config.group_size)\n603:             safetensors_metadata['gptq_desc_act'] = str(self.quantize_config.desc_act)\n604:             safetensors_metadata['gptq_damp_percent'] = str(self.quantize_config.damp_percent)\n605: \n606:             safe_save(state_dict, join(save_dir, model_save_name), safetensors_metadata)\n607:         else:\n608:             model_save_name = model_base_name + \".bin\"\n609:             torch.save(self.model.state_dict(), join(save_dir, model_save_name))\n610: \n611:         self.model.config.save_pretrained(save_dir)\n612:         self.quantize_config.save_pretrained(save_dir)\n613:         self.quantize_config.model_name_or_path = save_dir\n614:         self.quantize_config.model_file_base_name = model_base_name\n615: \n616:     def save_pretrained(self, save_dir: str, use_safetensors: bool = True, safetensors_metadata: Optional[Dict[str, str]] = None, **kwargs):\n617:         \"\"\"alias of save_quantized\"\"\"\n618:         logger.warning(\"you are using save_pretrained, which will re-direct to save_quantized.\")\n619:         self.save_quantized(save_dir, use_safetensors, safetensors_metadata)\n620: \n621:     @classmethod\n622:    