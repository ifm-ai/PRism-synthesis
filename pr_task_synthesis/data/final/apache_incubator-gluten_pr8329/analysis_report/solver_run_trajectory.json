          "callID": "call_82df840277f34ce1a3ac7bfc",
          "state": {
            "status": "completed",
            "input": {
              "filePath": "/workspace/.idea/vcs.xml",
              "oldString": "          <option name=\"issueRegexp\" value=\"#(\\d+)|GLUTEN-(\\d+)\" />",
              "newString": "          <option name=\"issueRegexp\" value=\"(?:#|GLUTEN-)(\\d+)\" />"
            },
            "output": "Edit applied successfully.",
            "metadata": {
              "diagnostics": {},
              "diff": "Index: /workspace/.idea/vcs.xml\n===================================================================\n--- /workspace/.idea/vcs.xml\n+++ /workspace/.idea/vcs.xml\n@@ -19,9 +19,9 @@\n <component name=\"IssueNavigationConfiguration\">\n   <option name=\"links\">\n     <list>\n       <IssueNavigationLink>\n-        <option name=\"issueRegexp\" value=\"#(\\d+)|GLUTEN-(\\d+)\" />\n+        <option name=\"issueRegexp\" value=\"(?:#|GLUTEN-)(\\d+)\" />\n         <!--\n           GitHub share the sequence number of issues and pull requests, and it will redirect to\n           the right place when the the sequence number not match kind.\n          -->\n",
