{
  "base_image": "eclipse-temurin:17-jdk-jammy",
  "system_packages": [
    "git",
    "curl",
    "maven",
    "scala",
    "python3",
    "python3-pytest"
  ],
  "build_context_scripts": [
    "setup_runtime.sh",
    "repo_setup.sh"
  ],
  "script_destinations": {
    "setup_runtime.sh": "/opt/benchmark/setup_runtime.sh",
    "repo_setup.sh": "/opt/benchmark/repo_setup.sh"
  ],
  "build_steps": [
    {
      "type": "from",
      "image": "eclipse-temurin:17-jdk-jammy"
    },
    {
      "type": "env",
      "variables": {
        "JAVA_HOME": "/opt/java/openjdk",
        "MAVEN_HOME": "/usr/share/maven",
        "MAVEN_OPTS": "-Xmx2g -XX:MaxMetaspaceSize=512m",
        "SCALA_HOME": "/usr/share/scala"
      }
    },
    {
      "type": "run",
      "command": "apt-get update && apt-get install -y git curl maven scala python3 python3-pytest && apt-get clean && rm -rf /var/lib/apt/lists/*"
    },
    {
      "type": "run",
      "command": "mkdir -p /opt/benchmark"
    },
    {
      "type": "copy",
      "source": "setup_runtime.sh",
      "destination": "/opt/benchmark/setup_runtime.sh"
    },
    {
      "type": "copy",
      "source": "repo_setup.sh",
      "destination": "/opt/benchmark/repo_setup.sh"
    },
    {
      "type": "run",
      "command": "chmod +x /opt/benchmark/setup_runtime.sh /opt/benchmark/repo_setup.sh"
    },
    {
      "type": "run",
      "command": "/opt/benchmark/repo_setup.sh"
    },
    {
      "type": "run",
      "command": "/opt/benchmark/setup_runtime.sh"
    },
    {
      "type": "workdir",
      "path": "/workspace"
    }
  ],
  "workspace_contract": {
    "materialization": "repo_setup.sh",
    "method": "git-clone",
    "no_snapshot": true
  },
  "verifier_separation": {
    "eval_sh_baked": false,
    "test_patch_baked": false,
    "tests_dir_baked": false
  },
  "build_backend": "buildah",
  "output_artifact": "/artifacts/environment/openenv_validation_oci.tar"
}
