tationLayer[LabeledSpan] = annotation_field(target=\"tokens\")\n800:                     relations: AnnotationLayer[BinaryRelation] = annotation_field(target=\"entities\")\n801:                     relation_attributes: AnnotationLayer[Attribute] = annotation_field(target=\"relations\")\n802: \n803: \n804:                 doc_text = TextBasedDocumentWithEntitiesRelationsAndRelationAttributes(text=\"Hello World!\")\n805:                 e1_text = LabeledSpan(0, 5, \"word1\")\n806:                 e2_text = LabeledSpan(6, 11, \"word2\")\n807:                 doc_text.entities.extend([e1, e2])\n808:                 r1_text = BinaryRelation(e1_text, e2_text, \"relation1\")\n809:                 doc_text.relations.append(r1_text)\n810:                 doc_text.relation_attributes.append(Attribute(r1_text, \"attribute1\"))\n811: \n812:                 doc_tokens = TokenBasedDocumentWithEntitiesRelationsAndRelationAttributes(\n813:                     tokens=(\"Hello\", \"World\", \"!\")\n814:                 )\n815:                 e1_tokens = LabeledSpan(0, 1, \"word1\")\n816:                 e2_tokens = LabeledSpan(1, 2, \"word2\")\n817:                 doc_tokens.entities.extend([e1_tokens, e2_tokens])\n818:                 doc_tokens.add_all_annotations_from_other(\n819:                     other=doc_text,\n820:                     override_annotations={\"entities\": {e1_text._id: e1_tokens, e2_text._id: e2_tokens}},\n821:                 )\n822:                 # Note that the relation and attribute are still present, but now refer to the new entities\n823:                 # and new relation, respectively.\n824:                 ```\n825:         \"\"\"\n826:         removed_annotations = defaultdict(set, removed_annotations or dict())\n827:         added_annotations = defaultdict(list)\n828: \n829:         annotation_store: Dict[str, Dict[int, Annotation]] = defaultdict(dict)\n830:         named_annotation_fields = {field.name: field for field in self.annotation_field