     annotation_store[field_name][ann._id] = new_ann\n894:                             self[field_name].predictions.append(new_ann)\n895:                             added_annotations[field_name].append(ann)\n896:                         else:\n897:                             if strict:\n898:                                 raise ValueError(\n899:                                     f\"Could not add annotation {ann} to {type(self).__name__} because it depends on \"\n900:                                     f\"annotations that are not present in the document.\"\n901:                                 )\n902:                             if verbose:\n903:                                 logger.warning(\n904:                                     f\"Could not add annotation {ann} to {type(self).__name__} because it depends on \"\n905:                                     f\"annotations that are not present in the document. The annotation is ignored. \"\n906:                                     f\"(disable this warning with verbose=False)\"\n907:                                 )\n908:                             # The annotation was removed, so we need to make sure that it is not referenced by any other\n909:                             removed_annotations[field_name].add(ann._id)\n910: \n911:         return dict(added_annotations)\n912: \n913: \n914: def resolve_annotation(\n915:     id_or_annotation: Union[int, Annotation],\n916:     store: Optional[Dict[int, Annotation]],\n917: ) -> Annotation:\n918:     if isinstance(id_or_annotation, Annotation):\n919:         return id_or_annotation\n920:     else:\n921:         if store is None:\n922:             raise ValueError(\"Unable to resolve the annotation id without annotation_store.\")\n923:         return store[id_or_annotation]\n\n(End of file - total 923 lines)\n</content>",
