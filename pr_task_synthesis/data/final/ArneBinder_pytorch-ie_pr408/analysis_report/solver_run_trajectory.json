            "output": "<path>/workspace/tests/test_annotations.py</path>\n<type>file</type>\n<content>\n1: import re\n2: \n3: import pytest\n4: \n5: from pytorch_ie.annotations import (\n6:     BinaryRelation,\n7:     Label,\n8:     LabeledSpan,\n9:     MultiLabel,\n10:     MultiLabeledBinaryRelation,\n11:     MultiLabeledSpan,\n12:     Span,\n13: )\n14: from tests.core.test_document import _test_annotation_reconstruction\n15: \n16: \n17: def test_label():\n18:     label1 = Label(label=\"label1\")\n19:     assert label1.label == \"label1\"\n20:     assert label1.score == pytest.approx(1.0)\n21: \n22:     label2 = Label(label=\"label2\", score=0.5)\n23:     assert label2.label == \"label2\"\n24:     assert label2.score == pytest.approx(0.5)\n25: \n26:     assert label2.asdict() == {\n27:         \"_id\": label2._id,\n28:         \"label\": \"label2\",\n29:         \"score\": 0.5,\n30:     }\n31: \n32:     _test_annotation_reconstruction(label2)\n33: \n34: \n35: def test_multilabel():\n36:     multilabel1 = MultiLabel(label=(\"label1\", \"label2\"))\n37:     assert multilabel1.label == (\"label1\", \"label2\")\n38:     assert multilabel1.score == pytest.approx((1.0, 1.0))\n39: \n40:     multilabel2 = MultiLabel(label=(\"label3\", \"label4\"), score=(0.4, 0.5))\n41:     assert multilabel2.label == (\"label3\", \"label4\")\n42:     assert multilabel2.score == pytest.approx((0.4, 0.5))\n43: \n44:     assert multilabel2.asdict() == {\n45:         \"_id\": multilabel2._id,\n46:         \"label\": (\"label3\", \"label4\"),\n47:         \"score\": (0.4, 0.5),\n48:     }\n49: \n50:     _test_annotation_reconstruction(multilabel2)\n51: \n52:     with pytest.raises(\n53:         ValueError, match=re.escape(\"Number of labels (2) and scores (3) must be equal.\")\n54:     ):\n55:         MultiLabel(label=(\"label5\", \"label6\"), score=(0.1, 0.2, 0.3))\n56: \n57: \n58: def test_span():\n59:     span = Span(start=1, end=2)\n60:     assert span.start == 1\n61:     assert span.end =