- The prompt to use for the completion request.\n44:             settings {OpenAITextPromptExecutionSettings} -- The settings to use for the completion request.\n45: \n46:         Returns:\n47:             List[\"TextContent\"] -- The completion result(s).\n48:         \"\"\"\n49:         if isinstance(settings, OpenAITextPromptExecutionSettings):\n50:             settings.prompt = prompt\n51:         else:\n52:             settings.messages = [{\"role\": \"user\", \"content\": prompt}]\n53:         if settings.ai_model_id is None:\n54:             settings.ai_model_id = self.ai_model_id\n55:         response = await self._send_request(request_settings=settings)\n56:         metadata = self._get_metadata_from_text_response(response)\n57:         return [self._create_text_content(response, choice, metadata) for choice in response.choices]\n58: \n59:     def _create_text_content(\n60:         self,\n61:         response: Completion,\n62:         choice: Union[CompletionChoice, ChatCompletionChoice],\n63:         response_metadata: Dict[str, Any],\n64:     ) -> \"TextContent\":\n65:         \"\"\"Create a text content object from a choice.\"\"\"\n66:         choice_metadata = self._get_metadata_from_text_choice(choice)\n67:         choice_metadata.update(response_metadata)\n68:         text = choice.text if isinstance(choice, CompletionChoice) else choice.message.content\n69:         return TextContent(\n70:             inner_content=response,\n71:             ai_model_id=self.ai_model_id,\n72:             text=text,\n73:             metadata=choice_metadata,\n74:         )\n75: \n76:     async def complete_stream(\n77:         self,\n78:         prompt: str,\n79:         settings: \"OpenAIPromptExecutionSettings\",\n80:         **kwargs,\n81:     ) -> AsyncIterable[List[\"StreamingTextContent\"]]:\n82:         \"\"\"\n83:         Executes a completion request and streams the result.\n84:         Supports both chat completion and text completion.\n85: \n86:         Arguments:\n87:             prompt {str} -- The prompt to use for the completion request.\n88:             settings {OpenAITextPromptExecutionSettings} -- The settings to use for the completion request.\n89: \n90:         Yields:\n91:             List[\"StreamingTextContent\"] -- The result stream made up of StreamingTextContent objects.\n92:         \"\"\"\n93:         if \"prompt\" in settings.model_fields:\n94:             settings.prompt = prompt\n95:         if \"messages\" in settings.model_fields:\n96:             if not settings.messages:\n97:                 settings.messages = [{\"role\": \"user\", \"content\": prompt}]\n98:             else:\n99:                 settings.messages.append({\"role\": \"user\", \"content\": prompt})\n100:         settings.ai_model_id = self.ai_model_id\n101:         settings.stream = True\n102:         response = await self._send_request(request_settings=settings)\n103:         if not isinstance(response, AsyncStream):\n104:             raise ValueError(\"Expected an AsyncStream[Completion] response.\")\n105: \n106:         async for chunk in response:\n107:             if len(chunk.choices) == 0:\n108:                 continue\n109:             chunk_metadata = self._get_metadata_from_text_response(chunk)\n110:             yield [self._create_streaming_text_content(chunk, choice, chunk_metadata) for choice in chunk.choices]\n111: \n112:     def _create_streaming_text_content(\n113:         self, chunk: Completion, choice: Union[CompletionChoice, ChatCompletionChunk], response_metadata: Dict[str, Any]\n114:     ) -> \"StreamingTextContent\":\n115:         \"\"\"Create a streaming text content object from a choice.\"\"\"\n116:         choice_metadata = self._get_metadata_from_text_choice(choice)\n117:         choice_metadata.update(response_metadata)\n118:         text = choice.text if isinstance(choice, CompletionChoice) else choice.delta.content\n119:         return StreamingTextContent(\n120:             choice_index=choice.index,\n121:             inner_content=chunk,\n122:             ai_model_id=self.ai_model_id,\n123:             metadata=choice_metadata,\n124:             text=text,\n125:         )\n126: \n127:     def _get_metadata_from_text_response(self, response: Completion) -> Dict[str, Any]:\n128:         \"\"\"Get metadata from a completion response.\"\"\"\n129:         return {\n130:             \"id\": response.id,\n131:             \"created\": response.created,\n132:             \"system_fingerprint\": response.system_fingerprint,\n133:             \"usage\": response.usage,\n134:         }\n135: \n136:     def _get_metadata_from_streaming_text_response(self, response: Completion) -> Dict[str, Any]:\n137:         \"\"\"Get metadata from a streaming completion response.\"\"\"\n138:         return {\n139:             \"id\": response.id,\n140:             \"created\": response.created,\n141:             \"system_fingerprint\": response.system_fingerprint,\n142:         }\n143: \n144:     def _get_metadata_from_text_choice(self, choice: CompletionChoice) -> Dict[str, Any]:\n145:         \"\"\"Get metadata from a completion choice.\"\"\"\n146:         return {\n147:             \"logprobs\": choice.logprobs,\n148:         }\n\n(End of file - total 148 lines)\n</content>",
