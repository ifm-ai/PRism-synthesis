onSettings\n41: \n42:     async def complete_chat(\n43:         self,\n44:         messages: List[Dict[str, str]],\n45:         settings: OpenAIPromptExecutionSettings,\n46:         **kwargs,\n47:     ) -> List[OpenAIChatMessageContent]:\n48:         \"\"\"Executes a chat completion request and returns the result.\n49: \n50:         Arguments:\n51:             messages {List[Dict[str,str]]} -- The messages to use for the chat completion.\n52:             settings {OpenAIChatPromptExecutionSettings | AzureChatPromptExecutionSettings} -- The settings to use\n53:                 for the chat completion request.\n54: \n55:         Returns:\n56:             List[OpenAIChatMessageContent | AzureChatMessageContent] -- The completion result(s).\n57:         \"\"\"\n58:         # TODO: replace messages with ChatHistory object with ChatMessageContent objects\n59:         settings.messages = messages\n60:         settings.stream = False\n61:         if not settings.ai_model_id:\n62:             settings.ai_model_id = self.ai_model_id\n63:         response = await self._send_request(request_settings=settings)\n64:         response_metadata = self._get_metadata_from_chat_response(response)\n65:         return [self._create_chat_message_content(response, choice, response_metadata) for choice in response.choices]\n66: \n67:     async def complete_chat_stream(\n68:         self,\n69:         messages: List[Dict[str, str]],\n70:         settings: OpenAIPromptExecutionSettings,\n71:         **kwargs,\n72:     ) -> AsyncIterable[List[OpenAIStreamingChatMessageContent]]:\n73:         \"\"\"Executes a streaming chat completion request and returns the result.\n74: \n75:         Arguments:\n76:             messages {List[Tuple[str,str]]} -- The messages to use for the chat completion.\n77:             settings {OpenAIChatPromptExecutionSettings | AzureChatPromptExecutionSettings} -- The settings to use\n78:                 for the chat completion request.\n79: \n80:         Yields:\n81:             List[OpenAIStreamingChatMessageContent | AzureStreamingChatMessageContent] -- A stream of\n82:                 OpenAIStreamingChatMessages or AzureStreamingChatMessageContent when using Azure.\n83:         \"\"\"\n84:         settings.messages = messages\n85:         settings.stream = True\n86:         if not settings.ai_model_id:\n87:             settings.ai_model_id = self.ai_model_id\n88:         response = await self._send_request(request_settings=settings)\n89:         if not isinstance(response, AsyncStream):\n90:             raise ValueError(\"Expected an AsyncStream[ChatCompletionChunk] response.\")\n91: \n92:         update_storage = self._get_update_storage_fields()\n93: \n94:         async for chunk in response:\n95:             if len(chunk.choices) == 0:\n96:                 continue\n97:             chunk_metadata = self._get_metadata_from_streaming_chat_response(chunk)\n98:             contents = [\n99:                 self._create_streaming_chat_message_content(chunk, choice, chunk_metadata) for choice in chunk.choices\n100:             ]\n101:             self._update_storages(contents, update_storage)\n102:             yield contents\n103: \n104:     def _create_chat_message_content(\n105:         self, response: ChatCompletion, choice: Choice, response_metadata: Dict[str, Any]\n106:     ) -> OpenAIChatMessageContent:\n107:         \"\"\"Create a chat message content object from a choice.\"\"\"\n108:         metadata = self._get_metadata_from_chat_choice(choice)\n109:         metadata.update(response_metadata)\n110:         return OpenAIChatMessageContent(\n111:             inner_content=response,\n112:             ai_model_id=self.ai_model_id,\n113:             metadata=metadata,\n114:             role=ChatRole(choice.message.role),\n115:             content=choice.message.content,\n116:             function_call=self._get_function_call_from_chat_choice(choice),\n117:             tool_calls=self._get_tool_calls_from_chat_choice(choice),\n118:         )\n119: \n120:     def _create_streaming_chat_message_content(\n121:         self,\n122:         chunk: ChatCompletionChunk,\n123:         choice: ChunkChoice,\n124:         chunk_metadata: Dict[str, Any],\n125:     ):\n126:         \"\"\"Create a streaming chat message content object from a choice.\"\"\"\n127:         metadata = self._get_metadata_from_chat_choice(choice)\n128:         metadata.update(chunk_metadata)\n129:         return OpenAIStreamingChatMessageContent(\n130:             choice_index=choice.index,\n131:             inner_content=chunk,\n132:             ai_model_id=self.ai_model_id,\n133:             metadata=metadata,\n134:             role=ChatRole(choice.delta.role),\n135:             content=choice.delta.content,\n136:             finish_reason=FinishReason(choice.finish_reason),\n137:             function_call=self._get_function_call_from_chat_choice(choice),\n138:             tool_calls=self._get_tool_calls_from_chat_choice(choice),\n139:         )\n140: \n141:     def _get_update_storage_fields(self) -> Dict[str, Dict[int, Any]]:\n142:         \"\"\"Get the fields to use for storing updates to the messages, tool_calls and function_calls.\"\"\"\n143:         out_messages = {}\n144:         tool_call_ids_by_index = {}\n145:         function_call_by_index = {}\n146:         return {\n147:             \"out_messages\": out_messages,\n148:             \"tool_call_ids_by_index\": tool_call_ids_by_index,\n149:             \"function_call_by_index\": function_call_by_index,\n150:         }\n151: \n152:     def _update_storages(\n153:         self, contents: List[OpenAIStreamingChatMessageContent], update_storage: Dict[str, Dict[int, Any]]\n154:     ):\n155:         \"\"\"Handle updates to the messages, tool_calls and function_calls.\n156: \n157:         This will be used for auto-invoking tools.\n158:         \"\"\"\n159:         out_messages = update_storage[\"out_messages\"]\n160:         tool_call_ids_by_index = update_storage[\"tool_call_ids_by_index\"]\n161:         function_call_by_index = update_storage[\"function_call_by_index\"]\n162: \n163:         for index, content in enumerate(contents):\n164:             if content.content is not None:\n165:                 if index not in out_messages:\n166:                     out_messages[index] = str(content)\n167:                 else:\n168:                     out_messages[index] += str(content)\n169:             if content.tool_calls is not None:\n170:                 if index not in tool_call_ids_by_index:\n171:                     tool_call_ids_by_index[index] = content.tool_calls\n172:                 else:\n173:                     for tc_index, tool_call in enumerate(content.tool_calls):\n174:                         tool_call_ids_by_index[index][tc_index].update(tool_call)\n175:             if content.function_call is not None:\n176:                 if index not in function_call_by_index:\n177:                     function_call_by_index[index] = content.function_call\n178:                 else:\n179:                     function_call_by_index[index].update(content.function_call)\n180: \n181:     def _get_metadata_from_chat_response(self, response: ChatCompletion) -> Dict[str, Any]:\n182:         \"\"\"Get metadata from a chat response.\"\"\"\n183:         return {\n184:             \"id\": response.id,\n185:             \"created\": response.created,\n186:             \"system_fingerprint\": response.system_fingerprint,\n187:             \"usage\": response.usage,\n188:         }\n189: \n190:     def _get_metadata_from_streaming_chat_response(self, response: ChatCompletionChunk) -> Dict[str, Any]:\n191:         \"\"\"Get metadata from a streaming chat response.\"\"\"\n192:         return {\n193:             \"id\": response.id,\n194:             \"created\": response.created,\n195:             \"system_fingerprint\": response.system_fingerprint,\n196:         }\n197: \n198:     def _get_metadata_from_chat_choice(self, choice: Union[Choice, ChunkChoice]) -> Dict[str, Any]:\n199:         \"\"\"Get metadata from a chat choice.\"\"\"\n200:         return {\n201:             \"logprobs\": choice.logprobs,\n202:         }\n203: \n204:     def _get_tool_calls_from_chat_choice(self, choice: Union[Choice, ChunkChoice]) -> Optional[List[ToolCall]]:\n205:         \"\"\"Get tool calls from a chat choice.\"\"\"\n206:         if isinstance(choice, Choice):\n207:             content = choice.message\n208:         else:\n209:             content = choice.delta\n210:         if content.tool_calls is None:\n211:             return None\n212:         return [\n213:             ToolCall(\n214:                 id=tool.id,\n215:                 type=tool.type,\n216:                 function=FunctionCall(name=tool.function.name, arguments=tool.function.arguments),\n217:             )\n218:             for tool in content.tool_calls\n219:         ]\n220: \n221:     def _get_function_call_from_chat_choice(self, choice: Union[Choice, ChunkChoice]) -> Optional[FunctionCall]:\n222:         \"\"\"Get a function call from a chat choice.\"\"\"\n223:         if isinstance(choice, Choice):\n224:             content = choice.message\n225:         else:\n226:             content = choice.delta\n227:         if content.function_call is None:\n228:             return None\n229:         return FunctionCall(name=content.function_call.name, arguments=content.function_call.arguments)\n\n(End of file - total 229 lines)\n</content>",
