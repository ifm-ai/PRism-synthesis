            {
              "file": "examples/tiff/example_tiff_image.go",
              "patch": "Index: examples/tiff/example_tiff_image.go\n===================================================================\n--- examples/tiff/example_tiff_image.go\t\n+++ examples/tiff/example_tiff_image.go\t\n@@ -1,37 +1,42 @@\n // NOTE: Run from project root directory\n \n package package_test\n \n import (\n \t\"fmt\"\n \t\"os\"\n \n \t\"github.com/davidbyttow/govips/v2/vips\"\n )\n \n func checkError(err error) {\n \tif err != nil {\n \t\tfmt.Println(\"error:\", err)\n \t\tos.Exit(1)\n \t}\n }\n \n func main() {\n \tvips.Startup(nil)\n \tdefer vips.Shutdown()\n \n \tinputImage, err := vips.NewImageFromFile(\"examples/tiff/input.jpg\")\n \tcheckError(err)\n \tdefer inputImage.Close()\n \n \tfmt.Println(inputImage.Height(), inputImage.Width())\n \terr = inputImage.Resize(0.5, vips.KernelLanczos3)\n \tcheckError(err)\n \tfmt.Println(inputImage.Height(), inputImage.Width())\n \n \texportParams := vips.NewTiffExportParams()\n \texportParams.Quality = 100\n+\texportParams.Pyramid = true\n+\texportParams.Tile = true\n+\texportParams.TileWidth = 256\n+\texportParams.TileHeight = 256\n \timageBytes, _, err := inputImage.ExportTiff(exportParams)\n+\tcheckError(err)\n \terr = os.WriteFile(\"examples/tiff/output-govips.tiff\", imageBytes, 0644)\n \tcheckError(err)\n }\n",
