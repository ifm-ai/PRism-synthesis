            "output": "<path>/workspace/vips/foreign.c</path>\n<type>file</type>\n<content>\n1: #include \"foreign.h\"\n2: \n3: #include \"lang.h\"\n4: \n5: void set_bool_param(Param *p, gboolean b) {\n6:   p->type = PARAM_TYPE_BOOL;\n7:   p->value.b = b;\n8:   p->is_set = TRUE;\n9: }\n10: \n11: void set_int_param(Param *p, gint i) {\n12:   p->type = PARAM_TYPE_INT;\n13:   p->value.i = i;\n14:   p->is_set = TRUE;\n15: }\n16: \n17: void set_double_param(Param *p, gdouble d) {\n18:   p->type = PARAM_TYPE_DOUBLE;\n19:   p->value.d = d;\n20:   p->is_set = TRUE;\n21: }\n22: \n23: int load_image_buffer(LoadParams *params, void *buf, size_t len,\n24:                       VipsImage **out) {\n25:   int code = 1;\n26:   ImageType imageType = params->inputFormat;\n27: \n28:   if (imageType == JPEG) {\n29:     // shrink: int, fail: bool, autorotate: bool\n30:     code = vips_jpegload_buffer(buf, len, out, \"fail\", params->fail,\n31:                                 \"autorotate\", params->autorotate, \"shrink\",\n32:                                 params->jpegShrink, NULL);\n33:   } else if (imageType == PNG) {\n34:     code = vips_pngload_buffer(buf, len, out, NULL);\n35:   } else if (imageType == WEBP) {\n36:     // page: int, n: int, scale: double\n37:     code = vips_webpload_buffer(buf, len, out, \"page\", params->page, \"n\",\n38:                                 params->n, NULL);\n39:   } else if (imageType == TIFF) {\n40:     // page: int, n: int, autorotate: bool, subifd: int\n41:     code =\n42:         vips_tiffload_buffer(buf, len, out, \"page\", params->page, \"n\",\n43:                              params->n, \"autorotate\", params->autorotate, NULL);\n44:   } else if (imageType == GIF) {\n45:     // page: int, n: int, scale: double\n46:     code = vips_gifload_buffer(buf, len, out, \"page\", params->page, \"n\",\n47:                                params->n, NULL);\n48:   } else if (imageType == PDF) {\n49:     // page: int, n: int, dpi: double, scale: double, background: color\n50:     code = vips_pdfload_buffer(buf, len, out, \"page\", params->page, \"n\",\n51:                                params->n, \"dpi\", params->dpi, NULL);\n52:   } else if (imageType == SVG) {\n53:     // dpi: double, scale: double, unlimited: bool\n54:     code = vips_svgload_buffer(buf, len, out, \"dpi\", params->dpi, \"unlimited\",\n55:                                params->svgUnlimited, NULL);\n56:   } else if (imageType == HEIF) {\n57:     // added autorotate on load as currently it addresses orientation issues\n58:     // https://github.com/libvips/libvips/pull/1680\n59:     // page: int, n: int, thumbnail: bool\n60:     code = vips_heifload_buffer(buf, len, out, \"page\", params->page, \"n\",\n61:                                 params->n, \"thumbnail\", params->heifThumbnail,\n62:                                 \"autorotate\", TRUE, NULL);\n63:   } else if (imageType == MAGICK) {\n64:     // page: int, n: int, density: string\n65:     code = vips_magickload_buffer(buf, len, out, \"page\", params->page, \"n\",\n66:                                   params->n, NULL);\n67:   } else if (imageType == AVIF) {\n68:     code = vips_heifload_buffer(buf, len, out, \"page\", params->page, \"n\",\n69:                                 params->n, \"thumbnail\", params->heifThumbnail,\n70:                                 \"autorotate\", params->autorotate, NULL);\n71: \n72:   }\n73:   #if (VIPS_MAJOR_VERSION >= 8) && (VIPS_MINOR_VERSION >= 11)\n74:   else if (imageType == JP2K) {\n75:        code = vips_jp2kload_buffer(buf, len, out, \"page\", params->page, NULL);\n76:   }\n77:   #endif\n78: \n79:   return code;\n80: }\n81: \n82: #define MAYBE_SET_BOOL(OP, PARAM, NAME)                          \\\n83:   if (PARAM.is_set) {                                            \\\n84:     vips_object_set(VIPS_OBJECT(OP), NAME, PARAM.value.b, NULL); \\\n85:   }\n86: \n87: #define MAYBE_SET_INT(OP, PARAM, NAME)                           \\\n88:   if (PARAM.is_set) {                                            \\\n89:     vips_object_set(VIPS_OBJECT(OP), NAME, PARAM.value.i, NULL); \\\n90:   }\n91: \n92: #define MAYBE_SET_DOUBLE(OP, PARAM, NAME)                        \\\n93:   if (PARAM.is_set) {                                            \\\n94:     vips_object_set(VIPS_OBJECT(OP), NAME, PARAM.value.d, NULL); \\\n95:   }\n96: \n97: typedef int (*SetLoadOptionsFn)(VipsOperation *operation, LoadParams *params);\n98: \n99: int set_jpegload_options(VipsOperation *operation, LoadParams *params) {\n100:   MAYBE_SET_BOOL(operation, params->autorotate, \"autorotate\");\n101:   MAYBE_SET_BOOL(operation, params->fail, \"fail\");\n102:   MAYBE_SET_INT(operation, params->jpegShrink, \"shrink\");\n103:   return 0;\n104: }\n105: \n106: int set_pngload_options(VipsOperation *operation, LoadParams *params) {\n107:   MAYBE_SET_BOOL(operation, params->fail, \"fail\");\n108:   return 0;\n109: }\n110: \n111: int set_webpload_options(VipsOperation *operation, LoadParams *params) {\n112:   MAYBE_SET_INT(operation, params->page, \"page\");\n113:   MAYBE_SET_INT(operation, params->n, \"n\");\n114:   return 0;\n115: }\n116: \n117: int set_tiffload_options(VipsOperation *operation, LoadParams *params) {\n118:   MAYBE_SET_BOOL(operation, params->autorotate, \"autorotate\");\n119:   MAYBE_SET_INT(operation, params->page, \"page\");\n120:   MAYBE_SET_INT(operation, params->n, \"n\");\n121:   return 0;\n122: }\n123: \n124: int set_gifload_options(VipsOperation *operation, LoadParams *params) {\n125:   MAYBE_SET_INT(operation, params->page, \"page\");\n126:   MAYBE_SET_INT(operation, params->n, \"n\");\n127:   return 0;\n128: }\n129: \n130: int set_pdfload_options(VipsOperation *operation, LoadParams *params) {\n131:   MAYBE_SET_INT(operation, params->page, \"page\");\n132:   MAYBE_SET_INT(operation, params->n, \"n\");\n133:   MAYBE_SET_DOUBLE(operation, params->dpi, \"dpi\");\n134:   return 0;\n135: }\n136: \n137: int set_svgload_options(VipsOperation *operation, LoadParams *params) {\n138:   MAYBE_SET_BOOL(operation, params->svgUnlimited, \"unlimited\");\n139:   MAYBE_SET_DOUBLE(operation, params->dpi, \"dpi\");\n140:   return 0;\n141: }\n142: \n143: int set_heifload_options(VipsOperation *operation, LoadParams *params) {\n144:   MAYBE_SET_BOOL(operation, params->autorotate, \"autorotate\");\n145:   MAYBE_SET_BOOL(operation, params->heifThumbnail, \"thumbnail\");\n146:   MAYBE_SET_INT(operation, params->page, \"page\");\n147:   MAYBE_SET_INT(operation, params->n, \"n\");\n148:   return 0;\n149: }\n150: \n151: int set_jp2kload_options(VipsOperation *operation, LoadParams *params) {\n152:   MAYBE_SET_INT(operation, params->page, \"page\");\n153:   return 0;\n154: }\n155: \n156: int set_jxlload_options(VipsOperation *operation, LoadParams *params) {\n157:   // nothing need to do\n158:   return 0;\n159: }\n160: \n161: int set_magickload_options(VipsOperation *operation, LoadParams *params) {\n162:   MAYBE_SET_INT(operation, params->page, \"page\");\n163:   MAYBE_SET_INT(operation, params->n, \"n\");\n164:   return 0;\n165: }\n166: \n167: int load_buffer(const char *operationName, void *buf, size_t len,\n168:                 LoadParams *params, SetLoadOptionsFn setLoadOptions) {\n169:   VipsBlob *blob = vips_blob_new(NULL, buf, len);\n170: \n171:   VipsOperation *operation = vips_operation_new(operationName);\n172:   if (!operation) {\n173:     return 1;\n174:   }\n175: \n176:   if (vips_object_set(VIPS_OBJECT(operation), \"buffer\", blob, NULL)) {\n177:     vips_area_unref(VIPS_AREA(blob));\n178:     return 1;\n179:   }\n180: \n181:   vips_area_unref(VIPS_AREA(blob));\n182: \n183:   if (setLoadOptions(operation, params)) {\n184:     vips_object_unref_outputs(VIPS_OBJECT(operation));\n185:     g_object_unref(operation);\n186:     return 1;\n187:   }\n188: \n189:   if (vips_cache_operation_buildp(&operation)) {\n190:     vips_object_unref_outputs(VIPS_OBJECT(operation));\n191:     g_object_unref(operation);\n192:     return 1;\n193:   }\n194: \n195:   g_object_get(VIPS_OBJECT(operation), \"out\", &params->outputImage, NULL);\n196: \n197:   vips_object_unref_outputs(VIPS_OBJECT(operation));\n198:   g_object_unref(operation);\n199: \n200:   return 0;\n201: }\n202: \n203: typedef int (*SetSaveOptionsFn)(VipsOperation *operation, SaveParams *params);\n204: \n205: int save_buffer(const char *operationName, SaveParams *params,\n206:                 SetSaveOptionsFn setSaveOptions) {\n207:   VipsBlob *blob;\n208:   VipsOperation *operation = vips_operation_new(operationName);\n209:   if (!operation) {\n210:     return 1;\n211:   }\n212: \n213:   if (vips_object_set(VIPS_OBJECT(operation), \"in\", params->inputImage, NULL)) {\n214:     return 1;\n215:   }\n216: \n217:   if (setSaveOptions(operation, params)) {\n218:     g_object_unref(operation);\n219:     return 1;\n220:   }\n221: \n222:   if (vips_cache_operation_buildp(&operation)) {\n223:     vips_object_unref_outputs(VIPS_OBJECT(operation));\n224:     g_object_unref(operation);\n225:     return 1;\n226:   }\n227: \n228:   g_object_get(VIPS_OBJECT(operation), \"buffer\", &blob, NULL);\n229:   g_object_unref(operation);\n230: \n231:   VipsArea *area = VIPS_AREA(blob);\n232: \n233:   params->outputBuffer = (char *)(area->data);\n234:   params->outputLen = area->length;\n235:   area->free_fn = NULL;\n236:   vips_area_unref(area);\n237: \n238:   return 0;\n239: }\n240: \n241: // https://libvips.github.io/libvips/API/current/VipsForeignSave.html#vips-jpegsave-buffer\n242: int set_jpegsave_options(VipsOperation *operation, SaveParams *params) {\n243:   int ret = vips_object_set(\n244:       VIPS_OBJECT(operation), \"strip\", params->stripMetadata, \"optimize_coding\",\n245:       params->jpegOptimizeCoding, \"interlace\", params->interlace,\n246:       \"subsample_mode\", params->jpegSubsample, \"trellis_quant\",\n247:       params->jpegTrellisQuant, \"overshoot_deringing\",\n248:       params->jpegOvershootDeringing, \"optimize_scans\",\n249:       params->jpegOptimizeScans, \"quant_table\", params->jpegQuantTable, NULL);\n250: \n251:   if (!ret && params->quality) {\n252:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n253:   }\n254: \n255:   return ret;\n256: }\n257: \n258: // https://libvips.github.io/libvips/API/current/VipsForeignSave.html#vips-pngsave-buffer\n259: int set_pngsave_options(VipsOperation *operation, SaveParams *params) {\n260:   int ret =\n261:       vips_object_set(VIPS_OBJECT(operation), \"strip\", params->stripMetadata,\n262:                       \"compression\", params->pngCompression, \"interlace\",\n263:                       params->interlace, \"filter\", params->pngFilter, \"palette\",\n264:                       params->pngPalette, NULL);\n265: \n266:   if (!ret && params->quality) {\n267:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n268:   }\n269: \n270:   if (!ret && params->pngDither) {\n271:     ret = vips_object_set(VIPS_OBJECT(operation), \"dither\", params->pngDither, NULL);\n272:   }\n273: \n274:   if (!ret && params->pngBitdepth) {\n275:     ret = vips_object_set(VIPS_OBJECT(operation), \"bitdepth\", params->pngBitdepth, NULL);\n276:   }\n277: \n278:   // TODO: Handle `profile` param.\n279: \n280:   return ret;\n281: }\n282: \n283: // https://github.com/libvips/libvips/blob/master/libvips/foreign/webpsave.c#L524\n284: // https://libvips.github.io/libvips/API/current/VipsForeignSave.html#vips-webpsave-buffer\n285: int set_webpsave_options(VipsOperation *operation, SaveParams *params) {\n286:   int ret =\n287:       vips_object_set(VIPS_OBJECT(operation),\n288:                       \"strip\", params->stripMetadata,\n289:                       \"lossless\", params->webpLossless,\n290:                       \"near_lossless\", params->webpNearLossless,\n291:                       \"reduction_effort\", params->webpReductionEffort,\n292:                       \"profile\", params->webpIccProfile ? params->webpIccProfile : \"none\",\n293:                       \"min_size\", params->webpMinSize,\n294:                       \"kmin\", params->webpKMin,\n295:                       \"kmax\", params->webpKMax,\n296:                       NULL);\n297: \n298:   if (!ret && params->quality) {\n299:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n300:   }\n301: \n302:   return ret;\n303: }\n304: \n305: // https://libvips.github.io/libvips/API/current/VipsForeignSave.html#vips-tiffsave-buffer\n306: int set_tiffsave_options(VipsOperation *operation, SaveParams *params) {\n307:   int ret = vips_object_set(\n308:       VIPS_OBJECT(operation), \"strip\", params->stripMetadata, \"compression\",\n309:       params->tiffCompression, \"predictor\", params->tiffPredictor, \"pyramid\",\n310:       params->tiffPyramid, \"tile_height\", params->tiffTileHeight, \"tile_width\",\n311:       params->tiffTileWidth, \"tile\", params->tiffTile, NULL);\n312: \n313:   if (!ret && params->quality) {\n314:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n315:   }\n316: \n317:   return ret;\n318: }\n319: \n320: // https://libvips.github.io/libvips/API/current/VipsForeignSave.html#vips-magicksave-buffer\n321: int set_magicksave_options(VipsOperation *operation, SaveParams *params) {\n322:   int ret = vips_object_set(VIPS_OBJECT(operation), \"format\", \"GIF\", \"bitdepth\", params->gifBitdepth, NULL);\n323: \n324:   if (!ret && params->quality) {\n325:     ret = vips_object_set(VIPS_OBJECT(operation), \"quality\", params->quality,\n326:                           NULL);\n327:   }\n328:   return ret;\n329: }\n330: \n331: // https://libvips.github.io/libvips/API/current/VipsForeignSave.html#vips-gifsave-buffer\n332: int set_gifsave_options(VipsOperation *operation, SaveParams *params) {\n333:   int ret = 0;\n334:   // See for argument values: https://www.libvips.org/API/current/VipsForeignSave.html#vips-gifsave\n335:   if (params->gifDither > 0.0 && params->gifDither <= 10) {\n336:     ret = vips_object_set(VIPS_OBJECT(operation), \"dither\", params->gifDither, NULL);\n337:   }\n338:   if (params->gifEffort >= 1 && params->gifEffort <= 10) {\n339:     ret = vips_object_set(VIPS_OBJECT(operation), \"effort\", params->gifEffort, NULL);\n340:   }\n341:   if (params->gifBitdepth >= 1 && params->gifBitdepth <= 8) {\n342:       ret = vips_object_set(VIPS_OBJECT(operation), \"bitdepth\", params->gifBitdepth, NULL);\n343:   }\n344:   return ret;\n345: }\n346: \n347: // https://github.com/libvips/libvips/blob/master/libvips/foreign/heifsave.c#L653\n348: int set_heifsave_options(VipsOperation *operation, SaveParams *params) {\n349:   int ret = vips_object_set(VIPS_OBJECT(operation), \"lossless\",\n350:                             params->heifLossless, NULL);\n351: \n352: #if (VIPS_MAJOR_VERSION >= 8) && (VIPS_MINOR_VERSION >= 13)\n353:   if (!ret && params->heifBitdepth && params->heifEffort) {\n354:     ret = vips_object_set(VIPS_OBJECT(operation), \"bitdepth\",\n355:                           params->heifBitdepth, \"effort\", params->heifEffort,\n356:                           NULL);\n357:   }\n358: #else\n359:   if (!ret && params->heifEffort) {\n360:     ret = vips_object_set(VIPS_OBJECT(operation), \"speed\", params->heifEffort,\n361:                           NULL);\n362:   }\n363: #endif\n364: \n365:   if (!ret && params->quality) {\n366:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n367:   }\n368: \n369:   return ret;\n370: }\n371: \n372: // https://github.com/libvips/libvips/blob/master/libvips/foreign/heifsave.c#L653\n373: int set_avifsave_options(VipsOperation *operation, SaveParams *params) {\n374:   int ret = vips_object_set(VIPS_OBJECT(operation), \"strip\", params->stripMetadata, \"compression\",\n375:                             VIPS_FOREIGN_HEIF_COMPRESSION_AV1, \"lossless\",\n376:                             params->heifLossless, NULL);\n377: \n378: #if (VIPS_MAJOR_VERSION >= 8) && (VIPS_MINOR_VERSION >= 13)\n379:   if (!ret && params->heifBitdepth && params->heifEffort) {\n380:     ret = vips_object_set(VIPS_OBJECT(operation), \"bitdepth\",\n381:                           params->heifBitdepth, \"effort\", params->heifEffort,\n382:                           NULL);\n383:   }\n384: #else\n385:   if (!ret && params->heifEffort) {\n386:     ret = vips_object_set(VIPS_OBJECT(operation), \"speed\", params->heifEffort,\n387:                           NULL);\n388:   }\n389: #endif\n390: \n391:   if (!ret && params->quality) {\n392:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n393:   }\n394: \n395:   return ret;\n396: }\n397: \n398: int set_jp2ksave_options(VipsOperation *operation, SaveParams *params) {\n399:   int ret = vips_object_set(\n400:       VIPS_OBJECT(operation), \"subsample_mode\", params->jpegSubsample,\n401:       \"tile_height\", params->jp2kTileHeight, \"tile_width\", params->jp2kTileWidth,\n402:       \"lossless\", params->jp2kLossless, NULL);\n403: \n404:   if (!ret && params->quality) {\n405:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n406:   }\n407: \n408:   return ret;\n409: }\n410: \n411: int set_jxlsave_options(VipsOperation *operation, SaveParams *params) {\n412:   int ret = vips_object_set(\n413:       VIPS_OBJECT(operation), \"tier\", params->jxlTier,\n414:       \"distance\", params->jxlDistance, \"effort\", params->jxlEffort,\n415:       \"lossless\", params->jxlLossless, NULL);\n416: \n417:   if (!ret && params->quality) {\n418:     ret = vips_object_set(VIPS_OBJECT(operation), \"Q\", params->quality, NULL);\n419:   }\n420: \n421:   return ret;\n422: }\n423: \n424: int load_from_buffer(LoadParams *params, void *buf, size_t len) {\n425:   switch (params->inputFormat) {\n426:     case JPEG:\n427:       return load_buffer(\"jpegload_buffer\", buf, len, params,\n428:                          set_jpegload_options);\n429:     case PNG:\n430:       return load_buffer(\"pngload_buffer\", buf, len, params,\n431:                          set_pngload_options);\n432:     case WEBP:\n433:       return load_buffer(\"webpload_buffer\", buf, len, params,\n434:                          set_webpload_options);\n435:     case HEIF:\n436:       return load_buffer(\"heifload_buffer\", buf, len, params,\n437:                          set_heifload_options);\n438:     case TIFF:\n439:       return load_buffer(\"tiffload_buffer\", buf, len, params,\n440:                          set_tiffload_options);\n441:     case SVG:\n442:       return load_buffer(\"svgload_buffer\", buf, len, params,\n443:                          set_svgload_options);\n444:     case GIF:\n445:       return load_buffer(\"gifload_buffer\", buf, len, params,\n446:                          set_gifload_options);\n447:     case PDF:\n448:       return load_buffer(\"pdfload_buffer\", buf, len, params,\n449:                          set_pdfload_options);\n450:     case MAGICK:\n451:       return load_buffer(\"magickload_buffer\", buf, len, params,\n452:                          set_magickload_options);\n453:     case AVIF:\n454:       return load_buffer(\"heifload_buffer\", buf, len, params,\n455:                          set_heifload_options);\n456:     case JP2K:\n457:       return load_buffer(\"jp2kload_buffer\", buf, len, params,\n458:                           set_jp2kload_options);\n459:     case JXL:\n460:       return load_buffer(\"jxlload_buffer\", buf, len, params,\n461:                           set_jxlload_options);\n462:     default:\n463:       g_warning(\"Unsupported input type given: %d\", params->inputFormat);\n464:   }\n465:   return 1;\n466: }\n467: \n468: int save_to_buffer(SaveParams *params) {\n469:   switch (params->outputFormat) {\n470:     case JPEG:\n471:       return save_buffer(\"jpegsave_buffer\", params, set_jpegsave_options);\n472:     case PNG:\n473:       return save_buffer(\"pngsave_buffer\", params, set_pngsave_options);\n474:     case WEBP:\n475:       return save_buffer(\"webpsave_buffer\", params, set_webpsave_options);\n476:     case HEIF:\n477:       return save_buffer(\"heifsave_buffer\", params, set_heifsave_options);\n478:     case TIFF:\n479:       return save_buffer(\"tiffsave_buffer\", params, set_tiffsave_options);\n480:     case GIF:\n481: #if (VIPS_MAJOR_VERSION >= 8) && (VIPS_MINOR_VERSION >= 12)\n482:       return save_buffer(\"gifsave_buffer\", params, set_gifsave_options);\n483: #else\n484:       return save_buffer(\"magicksave_buffer\", params, set_magicksave_options);\n485: #endif\n486:     case AVIF:\n487:       return save_buffer(\"heifsave_buffer\", params, set_avifsave_options);\n488:     case JP2K:\n489:       return save_buffer(\"jp2ksave_buffer\", params, set_jp2ksave_options);\n490:     case JXL:\n491:       return save_buffer(\"jxlsave_buffer\", params, set_jxlsave_options);\n492:     default:\n493:       g_warning(\"Unsupported output type given: %d\", params->outputFormat);\n494:   }\n495:   return 1;\n496: }\n497: \n498: LoadParams create_load_params(ImageType inputFormat) {\n499:   Param defaultParam = {};\n500:   LoadParams p = {\n501:       .inputFormat = inputFormat,\n502:       .inputBlob = NULL,\n503:       .outputImage = NULL,\n504:       .autorotate = defaultParam,\n505:       .fail = defaultParam,\n506:       .page = defaultParam,\n507:       .n = defaultParam,\n508:       .dpi = defaultParam,\n509:       .jpegShrink = defaultParam,\n510:       .heifThumbnail = defaultParam,\n511:       .svgUnlimited = defaultParam,\n512:   };\n513:   return p;\n514: }\n515: \n516: // TODO: Change to same pattern as ImportParams\n517: \n518: static SaveParams defaultSaveParams = {\n519:     .inputImage = NULL,\n520:     .outputBuffer = NULL,\n521:     .outputFormat = JPEG,\n522:     .outputLen = 0,\n523: \n524:     .interlace = FALSE,\n525:     .quality = 0,\n526:     .stripMetadata = FALSE,\n527: \n528:     .jpegOptimizeCoding = FALSE,\n529:   