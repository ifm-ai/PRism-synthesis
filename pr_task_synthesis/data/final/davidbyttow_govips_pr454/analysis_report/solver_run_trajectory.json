urn ImageTypePDF\n164: \t} else {\n165: \t\treturn ImageTypeUnknown\n166: \t}\n167: }\n168: \n169: var jpeg = []byte(\"\\xFF\\xD8\\xFF\")\n170: \n171: func isJPEG(buf []byte) bool {\n172: \treturn bytes.HasPrefix(buf, jpeg)\n173: }\n174: \n175: var gifHeader = []byte(\"\\x47\\x49\\x46\")\n176: \n177: func isGIF(buf []byte) bool {\n178: \treturn bytes.HasPrefix(buf, gifHeader)\n179: }\n180: \n181: var pngHeader = []byte(\"\\x89\\x50\\x4E\\x47\")\n182: \n183: func isPNG(buf []byte) bool {\n184: \treturn bytes.HasPrefix(buf, pngHeader)\n185: }\n186: \n187: var tifII = []byte(\"\\x49\\x49\\x2A\\x00\")\n188: var tifMM = []byte(\"\\x4D\\x4D\\x00\\x2A\")\n189: \n190: func isTIFF(buf []byte) bool {\n191: \treturn bytes.HasPrefix(buf, tifII) || bytes.HasPrefix(buf, tifMM)\n192: }\n193: \n194: var webpHeader = []byte(\"\\x57\\x45\\x42\\x50\")\n195: \n196: func isWEBP(buf []byte) bool {\n197: \treturn bytes.Equal(buf[8:12], webpHeader)\n198: }\n199: \n200: // https://github.com/strukturag/libheif/blob/master/libheif/heif.cc\n201: var ftyp = []byte(\"ftyp\")\n202: var heic = []byte(\"heic\")\n203: var mif1 = []byte(\"mif1\")\n204: var msf1 = []byte(\"msf1\")\n205: var avif = []byte(\"avif\")\n206: \n207: func isHEIF(buf []byte) bool {\n208: \treturn bytes.Equal(buf[4:8], ftyp) && (bytes.Equal(buf[8:12], heic) ||\n209: \t\tbytes.Equal(buf[8:12], mif1) ||\n210: \t\tbytes.Equal(buf[8:12], msf1)) ||\n211: \t\tisAVIF(buf)\n212: }\n213: \n214: func isAVIF(buf []byte) bool {\n215: \treturn bytes.Equal(buf[4:8], ftyp) && bytes.Equal(buf[8:12], avif)\n216: }\n217: \n218: var svg = []byte(\"<svg\")\n219: \n220: func isSVG(buf []byte) bool {\n221: \tsub := buf[:int(math.Min(1024.0, float64(len(buf))))]\n222: \tif bytes.Contains(sub, svg) {\n223: \t\tdata := &struct {\n224: \t\t\tXMLName xml.Name `xml:\"svg\"`\n225: \t\t}{}\n226: \t\treader := bytes.NewReader(buf)\n227: \t\tdecoder := xml.NewDecoder(reader)\n228: \t\tdecoder.Strict = false\n229: \t\tdecoder.CharsetReader = charset.NewReade