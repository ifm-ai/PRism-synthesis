s.Pyramid = true\n\tbothParams.Tile = true\n\tbothParams.TileWidth = 512\n\tbothParams.TileHeight = 512\n\tbuf, _, err = img.ExportTiff(bothParams)\n\tif err != nil {\n\t\tfmt.Println(\"Error exporting with both pyramid and tile:\", err)\n\t\treturn\n\t}\n\tfmt.Printf(\"Pyramid+Tiled export: %d bytes\\n\", len(buf))\n\terr = os.WriteFile(\"/tmp/test_pyramid_tiled.tiff\", buf, 0644)\n\tif err != nil {\n\t\tfmt.Println(\"Error writing pyramid+tiled file:\", err)\n\t\treturn\n\t}\n\n\tfmt.Println(\"\\nAll TIFF exports completed successfully!\")\n\tfmt.Println(\"Files written to /tmp/test_*.tiff\")\n}\nEOF\ngo run /tmp/test_tiff_export.go",
