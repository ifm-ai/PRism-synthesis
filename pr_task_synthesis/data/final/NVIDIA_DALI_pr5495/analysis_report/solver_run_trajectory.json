ify the 'device' argument as either 'cpu'\n51:  * or 'gpu' to control where the op is executed. The only constraints on\n52:  * the graphs of ops that users can define is that all cpu ops must\n53:  * precede all gpu ops, and that cpu ops can only output cpu data, and\n54:  * gpu ops can only output gpu data.\n55:  *\n56:  * When adding an op, the user specifies a name for its outputs, as well\n57:  * as the device they will exist on (cpu or gpu). If a GPU op requests\n58:  * a gpu version of a cpu tensor that has been produced earlier in the\n59:  * graph, the pipeline will insert the needed operations to transfer\n60:  * the data to the gpu.\n61:  */\n62: class DLL_PUBLIC Pipeline {\n63:  public:\n64:   /**\n65:    * @brief Creates a pipeline that will produce batches of size `batch_size`,\n66:    * using `num_threads` worker threads on gpu `device_id`.\n67:    *\n68:    * GPU memory and pinned memory allocations cause implicit synchronization of\n69:    * the device, resulting in very slow startup times as dali buffer sizes\n70:    * stabilize. To avoid this slowdown, we optionally take in an estimated size\n71:    * of each image that will be processed in bytes. This hint is used to\n72:    * pre-size buffers, potentially avoiding slow startup if the hint is close\n73:    * to the true amount of memory that will be needed by the largest image to\n74:    * be processed.\n75:    *\n76:    * @param max_batch_size the maximum size of the batch that can be produced.\n77:    * @param num_threads the number of threads to use in the prefetch stage.\n78:    * @param device_id id of the GPU to operate on.\n79:    * @param seed used for random number generation. Leaving the default value\n80:    * for this parameter results in random seed\n81:    * @param pipelined_execution whether to allocate the necessary buffers for pipeline execution\n82:    * between the cpu and gpu portions of the graph. See PipelinedExecutor.\n83:    * @param prefetch_queue_depth sets the length of the executor internal pipeline\n84:    * @param async_execution whether to use extra host-threads to enable asynchronous execution\n85:    * of cpu and gpu work. See AsyncExecutor/AsyncPipelinedExecutor.\n86:    * @param bytes_per_sample_hint Estimated size of each sample to be processed.\n87:    * Defaults to 0.\n88:    * @param set_affinity indicates whether thread affinity should be\n89:    * configured in the thread pool. Defaults to 'false'.\n90:    * @param max_num_stream set an upper limit on the number of cudaStreams\n91:    * that can be allocated by the pipeline.\n92:    * @param default_cuda_stream_priority  CUDA stream priority used by DALI.\n93:    * See `cudaStreamCreateWithPriority` in CUDA documentation\n94:    */\n95:   DLL_PUBLIC Pipeline(int max_batch_size, int num_threads, int device_id, int64_t seed = -1,\n96:                       bool pipelined_execution = true, int prefetch_queue_depth = 2,\n97:                       bool async_execution = true, size_t bytes_per_sample_hint = 0,\n98:                       bool set_affinity = false, int max_num_stream = -1,\n99:                       int default_cuda_stream_priority = 0);\n100: \n101:   DLL_PUBLIC Pipeline(const string &serialized_pipe, int max_batch_size = -1, int num_threads = -1,\n102:                       int device_id = -1, bool pipelined_execution = true,\n103:                       int prefetch_queue_depth = 2, bool async_execution = true,\n104:                       size_t bytes_per_sample_hint = 0, bool set_affinity = false,\n105:                       int max_num_stream = -1, int default_cuda_stream_priority = 0,\n106:                       int64_t seed = -1);\n107: \n108:   virtual DLL_PUBLIC ~Pipeline();\n109: \n110:   /**\n111:    * @brief Creates a placeholder for an External Source operator with the given name\n112:    * (and output of given name).\n113:    *\n114:    * Equivalent to inserting ExternalSource with output of given name and specified\n115:    * device placemnt.\n116:    */\n117:   DLL_PUBLIC int AddExternalInput(const string &name,\n118:                                          const string &device = \"cpu\",\n119:                                          DALIDataType dtype = DALI_NO_TYPE,\n120:                                          int ndim = -1,\n121:                                          const TensorLayout &layout = \"\") {\n122:     auto spec = OpSpec(\"ExternalSource\")\n123:                       .AddArg(\"name\", name)\n124:                       .AddArg(\"device\", device)\n125:                       .AddOutput(name, device);\n126:     if (!layout.empty()) spec.AddArg(\"layout\", layout);\n127:     if (ndim >= 0) spec.AddArg(\"ndim\", ndim);\n128:     if (dtype != DALI_NO_TYPE) spec.AddArg(\"dtype\", dtype);\n129:     return AddOperator(spec, name);\n130:   }\n131: \n132: \n133:   template<typename TensorListBackend, typename OperatorBackend>\n134:   void SetDataSourceHelper(\n135:           const string &name, const TensorList<TensorListBackend> &tl,\n136:           std::optional<std::string> data_id, OperatorBase *op_ptr, AccessOrder order = {},\n137:           InputOperatorSettingMode in_op_setting_mode = {},\n138:           bool is_refeeding = false) {\n139:     if (is_refeeding ||\n140:         !repeat_last_.SetLast<OperatorBackend>(name, tl, data_id, order, in_op_setting_mode)) {\n141:       auto *source = dynamic_cast<InputOperator<OperatorBackend> *>(op_ptr);\n142:       DALI_ENFORCE(source != nullptr,\n143:                   \"Input name '\" + name + \"' is not marked as an InputOperator.\");\n144:       source->template SetDataSource<TensorListBackend>(tl, order, in_op_setting_mode,\n145:                                                         std::move(data_id));\n146:     }\n147:   }\n148: \n149: \n150:   /**\n151:    * @brief Helper function for the SetExternalInput.\n152:    * @tparam Backend CPUBackend or GPUBackend\n153:    * @param name name of the input\n154:    * @param tl data\n155:    * @param order synchronization order (CUDA stream or host)\n156:    * @param ext_src_setting_mode Options passed to the External Source describing the behaviour\n157:    *                        of setting the data.\n158:    */\n159:   template<typename Backend>\n160:   void SetExternalInputHelper(const string &name, const TensorList<Backend> &tl,\n161:                               std::optional<std::string> data_id, AccessOrder order = {},\n162:                               InputOperatorSettingMode ext_src_setting_mode = {},\n163:                               bool is_refeeding = false) {\n164:     auto *node = GetInputOperatorNode(name);\n165:     OperatorBase *op_ptr = node->op.get();\n166: \n167:     switch (node->op_type) {\n168:       case OpType::CPU:\n169:         SetDataSourceHelper<Backend, CPUBackend>(name, tl, std::move(data_id), op_ptr, order,\n170:                                                  ext_src_setting_mode, is_refeeding);\n171:         break;\n172:       case OpType::MIXED:\n173:         SetDataSourceHelper<Backend, MixedBackend>(name, tl, std::move(data_id), op_ptr, order,\n174:                                                    ext_src_setting_mode, is_refeeding);\n175:         break;\n176:       case OpType::GPU:\n177:         SetDataSourceHelper<Backend, GPUBackend>(name, tl, std::move(data_id), op_ptr, order,\n178:                                                  ext_src_setting_mode, is_refeeding);\n179:         break;\n180:       default:\n181:         assert(false);  // This shouldn't happen.\n182:     }\n183:   }\n184: \n185: \n186:   /**\n187:    * @brief Sets the external input with the input name to the input data\n188:    * @tparam Backend\n189:    * @param name name of the input\n190:    * @param tl data\n191:    * @param order synchronization order (CUDA stream or host)\n192:    * @param sync If SetExternalInputHelper should be blocking - waits until provided data is copied\n193:    *             to the internal buffer\n194:    * @param no_copy_mode Select whether to use the parameter defined in the External Source or\n195:    *                     override the mode of operation forcing the copy or no-copy\n196:    */\n197:   template<typename Backend>\n198:   DLL_PUBLIC void\n199:   SetExternalInput(const string &name, const TensorList<Backend> &tl, AccessOrder order = {},\n200:                    bool sync = false, bool use_copy_kernel = false,\n201:                    InputOperatorNoCopyMode no_copy_mode = InputOperatorNoCopyMode::DEFAULT,\n202:                    std::optional<std::string> data_id = std::nullopt) {\n203:     InputOperatorSettingMode mode{sync, use_copy_kernel, no_copy_mode};\n204:     // if SetLast succeeds, the data will be forcibly _shared_ (zero copy) upon Refeed\n205:     SetExternalInputHelper(name, tl, std::move(data_id), order, mode, false);\n206:   }\n207: \n208: \n209:   /**\n210:    * @brief  Adds an Operator with the input specification to the pipeline. The\n211:    * 'device' argument in the OpSpec determines whether the CPU or GPU version\n212:    * of the named operator will be added to the pipeline\n213:    *\n214:    * @param spec\n215:    * @param inst_name\n216:    * @param logical_id Allows to group operator that are supposed to have synchronized state\n217:    * wrt randomness. Operators sharing the logical_id will have the same seed assigned.\n218:    *\n219:    * @return logical_id of added operator, so it can be used for further calls\n220:    */\n221:   DLL_PUBLIC int AddOperator(const OpSpec &spec, const std::string& inst_name, int logical_id);\n222: \n223:   /**\n224:    * @brief Adds an Operator with the input specification to the pipeline. It will be assigned\n225:    * a separate logical_id based on internal state of the pipeline.\n226:    */\n227:   DLL_PUBLIC int AddOperator(const OpSpec &spec, const std::string& inst_name);\n228: \n229:   /**\n230:    * @brief Adds an unnamed Operator with the input specification to the pipeline.\n231:    */\n232:   DLL_PUBLIC int AddOperator(const OpSpec &spec, int logical_id);\n233: \n234:   /**\n235:    * @brief Adds an unnamed Operator with the input specification to the pipeline.  It will be\n236:    * assigned a separate logical_id based on internal state of the pipeline.\n237:    */\n238:   DLL_PUBLIC int AddOperator(const OpSpec &spec);\n239: \n240:   /**\n241:    * @brief Returns true if there exists operator with given logical_id\n242:    */\n243:   DLL_PUBLIC bool IsLogicalIdUsed(int logical_id) const;\n244: \n245:   /**\n246:    * @brief Returns the graph node with Operator\n247:    * with a given name\n248:    */\n249:   DLL_PUBLIC OpNode * GetOperatorNode(const std::string& name);\n250: \n251:   /**\n252:    * @brief Rreturns an input graph node with a given name\n253:    */\n254:   DLL_PUBLIC const OpNode *GetInputOperatorNode(const std::string &name);\n255: \n256:   /** @{ */\n257:   /**\n258:    * @brief Performs some checks on the user-constructed pipeline, setups data\n259:    * for intermediate results, and marks as ready for execution. The input\n260:    * vector specifies the name and device of the desired outputs of the pipeline.\n261:    */\n262:   DLL_PUBLIC void Build(const std::vector<std::pair<string, string>>& output_names);\n263:   DLL_PUBLIC void Build(std::vector<PipelineOutputDesc> output_descs);\n264:   /** @} */\n265: \n266:   /**\n267:    * @brief Build a pipeline from deserialized output (name, device) pairs\n268:    */\n269:   DLL_PUBLIC void Build();\n270: \n271:   /**\n272:    * @brief Set execution characteristics for this Pipeline\n273:    *\n274:    * @param pipelined_execution Use pipelined execution\n275:    * @param separated_execution Use separated queues\n276:    * @param async_execution Use worker threads for RunX() functions\n277:    */\n278:   DLL_PUBLIC void SetExecutionTypes(bool pipelined_execution = true,\n279:                                     bool separated_execution = false,\n280:                                     bool async_execution = true) {\n281:     DALI_ENFORCE(!built_, \"Alterations to the pipeline after \"\n282:         \"\\\"Build()\\\" has been called are not allowed - cannot change execution type.\");\n283:     pipelined_execution_ = pipelined_execution;\n284:     separated_execution_ = separated_execution;\n285:     async_execution_ = async_execution;\n286:   }\n287: \n288:   /**\n289:    * @brief Set if the DALI pipeline should gather executor statistics of the operator ouput sizes\n290:    *\n291:    * @param enable_memory_stats If statistics should be gathered\n292:    * Useful for `bytes_per_sample_hint` operator parameter.\n293:    */\n294:   DLL_PUBLIC void EnableExecutorMemoryStats(bool enable_memory_stats = true) {\n295:     enable_memory_stats_ = enable_memory_stats;\n296:     if (executor_) {\n297:       executor_->EnableMemoryStats(enable_memory_stats_);\n298:     }\n299:   }\n300: \n301:   /**\n302:    * @brief Set if the DALI pipeline should create checkpoints between the epochs\n303:    *\n304:    * @param enable_memory_stats If checkpoints should be created\n305:    */\n306:   DLL_PUBLIC void EnableCheckpointing(bool checkpointing = true) {\n307:     checkpointing_ = checkpointing;\n308:     if (executor_) {\n309:       executor_->EnableCheckpointing(checkpointing_);\n310:     }\n311:   }\n312: \n313:   /**\n314:    * @brief Returns a serialized Checkpoint\n315:    *\n316:    * @param external_ctx_cpt Additional information from python side to be included\n317:    */\n318:   DLL_PUBLIC string SerializedCheckpoint(const ExternalContextCheckpoint &external_ctx_cpt) const {\n319:     auto cpt = GetCheckpoint();\n320:     cpt.external_ctx_cpt_ = external_ctx_cpt;\n321:     return cpt.SerializeToProtobuf(graph_);\n322:   }\n323: \n324:   /**\n325:    * @brief Returns an unserialized Checkpoint\n326:   */\n327:   DLL_PUBLIC Checkpoint GetCheckpoint() const {\n328:     DALI_ENFORCE(executor_, \"Pipeline must be built before it can produce a checkpoint. \");\n329:     DALI_ENFORCE(checkpointing_,\n330:                  \"Cannot save the checkpoint. The `enable_checkpointing` was not \"\n331:                  \"specified when creating the pipeline\");\n332:     auto &cpt = executor_->GetCurrentCheckpoint();\n333:     // Make sure the checkpoint is accessible on host\n334:     cpt.SetOrder(AccessOrder::host());\n335:     return cpt;\n336:   }\n337: \n338:   /**\n339:    * @brief Restores pipeline state from a serialized Checkpoint\n340:    *\n341:    * Should be called before building.\n342:    *\n343:    * @return Extra context which was passed to SerializedCheckpoint when creating the checkpoint\n344:   */\n345:   DLL_PUBLIC ExternalContextCheckpoint RestoreFromSerializedCheckpoint(\n346:       const std::string &serialized_checkpoint) {\n347:     DALI_ENFORCE(checkpointing_,\n348:                  \"Cannot restore checkpoint. The `enable_checkpointing` was not \"\n349:                  \"specified when creating the pipeline\");\n350:     Checkpoint cpt;\n351:     cpt.DeserializeFromProtobuf(graph_, serialized_checkpoint);\n352:     RestoreFromCheckpoint(cpt);\n353:     return cpt.external_ctx_cpt_;\n354:   }\n355: \n356:   /**\n357:    * @brief Restores pipeline state from an unserialized Checkpoint\n358:    *\n359:    * Should be called before building.\n360:   */\n361:   DLL_PUBLIC void RestoreFromCheckpoint(const Checkpoint &cpt) {\n362:     executor_->RestoreStateFromCheckpoint(cpt);\n363:   }\n364: \n365:   /**\n366:    * @brief Obtains the executor statistics\n367:    */\n368:   DLL_PUBLIC ExecutorMetaMap GetExecutorMeta() {\n369:     if (executor_) {\n370:       return executor_->GetExecutorMeta();\n371:     } else {\n372:       return {};\n373:     }\n374:   }\n375: \n376:   /**\n377:    * @brief Set queue sizes for Pipeline using Separated Queues\n378:    *\n379:    * Must be called before Build()\n380:    *\n381:    * @param cpu_size\n382:    * @param gpu_size\n383:    */\n384:   DLL_PUBLIC void SetQueueSizes(int cpu_size, int gpu_size) {\n385:     DALI_ENFORCE(!built_,\n386:                  \"Alterations to the pipeline after \"\n387:                  \"\\\"Build()\\\" has been called are not allowed - cannot set queue sizes.\");\n388:     DALI_ENFORCE(separated_execution_ || (cpu_size == gpu_size),\n389:                  \"Setting different queue sizes for non-separated execution is not allowed\");\n390:     DALI_ENFORCE(cpu_size > 0 && gpu_size > 0, \"Only positive queue sizes allowed\");\n391:     prefetch_queue_depth_ = QueueSizes(cpu_size, gpu_size);\n392:   }\n393: \n394:   DLL_PUBLIC QueueSizes GetQueueSizes() const {\n395:     return prefetch_queue_depth_;\n396:   }\n397: \n398:   /** @{ */\n399:   /**\n400:    * @brief Set descriptors of the outputs of the pipeline. Used to update the graph without\n401:    * running the executor and for pipeline serialization.\n402:    */\n403:   void SetOutputDescs(std::vector<PipelineOutputDesc> output_descs);\n404:   /**\n405:    * Convenience overload. Set only the name and device of an output, since the dtype and ndim\n406:    * are not always necessary. This function can't reset the output descriptors. If they were already\n407:    * set, the function will fail.\n408:    */\n409:   void SetOutputDescs(const vector<std::pair<string /* name */, string /* device */>> &out_names);\n410:   /** @} */\n411: \n412:   /**\n413:    * @brief Run the pipeline\n414:    */\n415:   DLL_PUBLIC void Run();\n416: \n417:   /**\n418:    * @brief Fills the prefetch queues\n419:    *\n420:    * Runs a prefetching function in the executor so that internal and output queues are full.\n421:    * Note that it requires populating the external sources InputFeedCount(name) times.\n422:    */\n423:   DLL_PUBLIC void Prefetch();\n424: \n425:   /**\n426:    * @brief Calculates how many times a given input must be populated before the pipeline can be run\n427:    *\n428:    * @param input_name The name of the input, as specified in the input operator.\n429:    * @return The number of times that feed_input needs to be called.\n430:    */\n431:   DLL_PUBLIC int InputFeedCount(const std::string &input_name);\n432: \n433:   /**\n434:    * @brief Fills the input device workspace with the output of the pipeline.\n435:    * Previously returned buffers are released.\n436:    * This method blocks until the next batch is complete. Run must be called prior to calling this\n437:    * method or it will result in a deadlock.\n438:    */\n439:   DLL_PUBLIC void Outputs(Workspace *ws);\n440: \n441:   /**\n442:    * @brief Fills the input device workspace with the output of the pipeline.\n443:    * To release previously returned buffers ReleaseOutputs need to be called.\n444:    * This method blocks until the next batch is complete. Run must be called prior to calling this\n445:    * method or it will result in a deadlock.\n446:    */\n447:   DLL_PUBLIC void ShareOutputs(Workspace *ws);\n448: \n449:   /**\n450:    * @brief Release buffers returned by the Output call\n451:    * This method is meant for cases where buffers are coppied out\n452:    * or consumed in any other way, so it is possible to set them free\n453:    * before next Outputs call\n454:    */\n455:   DLL_PUBLIC void ReleaseOutputs();\n456: \n457:   /**\n458:    * @brief serializes the pipe to a protobuf\n459:    */\n460:   DLL_PUBLIC string SerializeToProtobuf() const;\n461: \n462:   /**\n463:    * @brief Save graph in DOT direct graph format\n464:    * in filename.\n465:    */\n466:   DLL_PUBLIC void SaveGraphToDotFile(const std::string &filename, bool show_tensors = false,\n467:                                      bool show_ids = false, bool use_colors = false);\n468: \n469:   /** @{ */\n470:   /**\n471:    * @brief Returns the maximum batch size that can be processed by the Pipeline\n472:    */\n473:   DLL_PUBLIC inline int batch_size() const { return max_batch_size_; }\n474:   DLL_PUBLIC inline int max_batch_size() const { return max_batch_size_; }\n475:   /** @} */\n476: \n477:   /**\n478:    * @brief Returns the map of (node name, reader meta) for all nodes that return a valid meta\n479:    */\n480:   DLL_PUBLIC std::map<std::string, ReaderMeta> GetReaderMeta();\n481: \n482:   /**\n483:    * @brief Returns the reader meta for a node with given name\n484:    */\n485:   DLL_PUBLIC ReaderMeta GetReaderMeta(const std::string &name);\n486: \n487:   /**\n488:    * @brief Get the data layout required by the external input with a given name.\n489:    */\n490:   DLL_PUBLIC const TensorLayout &GetInputLayout(const std::string &name);\n491: \n492:   /**\n493:    * @brief Get the required number of dimensions for the external input with a given name.\n494:    */\n495:   DLL_PUBLIC int GetInputNdim(const std::string &name);\n496: \n497:   /**\n498:    * @brief Get the data type required by the external input with a given name.\n499:    */\n500:   DLL_PUBLIC DALIDataType GetInputDtype(const std::string &name);\n501: \n502:   /**\n503:    * @brief Returns the number of threads used by the pipeline.\n504:    */\n505:   DLL_PUBLIC inline int num_threads() const { return num_threads_; }\n506: \n507:   /**\n508:    * @brief Returns the GPU device number used by the pipeline\n509:    */\n510:   DLL_PUBLIC inline int device_id() const {\n511:     return device_id_;\n512:   }\n513: \n514:   /**\n515:    * @brief Returns number of external inputs.\n516:    */\n517:   DLL_PUBLIC int num_inputs() const;\n518: \n519:   /**\n520:    * @brief Returns number of outputs.\n521:    */\n522:   DLL_PUBLIC int num_outputs() const;\n523: \n524:   /**\n525:    * @brief Return the name of the nth external input in the pipeline in lexicographic order.\n526:    */\n527:   DLL_PUBLIC const std::string &input_name(int n) const;\n528: \n529:   /**\n530:    * @brief Returns a string describing the name of the output specified by given id.\n531:    */\n532:   DLL_PUBLIC const std::string &output_name(int id) const;\n533: \n534:   /**\n535:    * @brief Returns a string describing the device type backing the output specified by given id.\n536:    */\n537:   DLL_PUBLIC const std::string &output_device(int id) const;\n538: \n539:   /**\n540:    * @brief Returns data type of the output specified by given id.\n541:    */\n542:   DLL_PUBLIC DALIDataType output_dtype(int id) const;\n543: \n544:   /**\n545:    * @brief Returns number of dimensions in the output specified by given id.\n546:    */\n547:   DLL_PUBLIC int output_ndim(int id) const;\n548: \n549:   /**\n550:    * @brief Returns output descriptors for all outputs.\n551:    */\n552:   DLL_PUBLIC std::vector<PipelineOutputDesc> output_descs() const;\n553: \n554:   /**\n555:    * Checks, if a provided pipeline can be deserialized, according to the Pipeline protobuf\n556:    * definition.\n557:    *\n558:    * @param serialized_pipeline\n559:    * @return True, if the pipeline is serializable. False otherwise.\n560:    */\n561:   static bool IsDeserializable(const std::string &serialized_pipeline);\n562: \n563:   /**\n564:    * @brief Shutdown the executor\n565:    */\n566:   DLL_PUBLIC void Shutdown();\n567: \n568:   // For testing\n569:   template <typename T>\n570:   friend class PipelineTest;\n571: \n572:   DLL_PUBLIC DISABLE_COPY_MOVE_ASSIGN(Pipeline);\n573: \n574:  private:\n575:   /**\n576:    * @brief Initializes the Pipeline internal state\n577:    */\n578:   void Init(int batch_size, int num_threads, int device_id, int64_t seed, bool pipelined_execution,\n579:             bool separated_execution, bool async_execution, size_t bytes_per_sample_hint,\n580:             bool set_affinity, int max_num_stream, int default_cuda_stream_priority,\n581:             QueueSizes prefetch_queue_depth = QueueSizes{2});\n582: \n583:   using EdgeMeta = struct {\n584:     bool has_cpu;\n585:     bool has_gpu;\n586:     bool has_contiguous;\n587:     // MakeContiguous was added after this node to be used as output on specified device:\n588:     bool has_make_contiguous_c