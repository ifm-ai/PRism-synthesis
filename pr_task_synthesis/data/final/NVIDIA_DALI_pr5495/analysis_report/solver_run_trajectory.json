n48:  */\n49: using batch_size_map_t = std::unordered_map<std::string /* op_name */, int /* batch_size */>;\n50: \n51: /**\n52:  * Maps operator name to the data_id set prior to daliSetExternal... call.\n53:  *\n54:  * Usually the operator with given `op_name` will be an InputOperator.\n55:  * Typical usage:\n56:  * auto *data_id_map = reinterpret_cast<data_id_map_t *>(handle->data_id_map);\n57:  */\n58: using data_id_map_t = std::unordered_map<std::string /* op_name */, std::string /* data_id */>;\n59: \n60: /**\n61:  * @brief Aggregates a DALI pipeline and auxiliary objects\n62:  */\n63: struct DALIPipeline {\n64:   std::unique_ptr<dali::Pipeline> pipeline;\n65:   dali::Workspace workspace;\n66:   batch_size_map_t batch_size_map;\n67:   data_id_map_t data_id_map;\n68:   dali::CUDAStreamLease copy_stream;\n69: };\n70: \n71: /** Temporary workaround for backward compatibility\n72:  *\n73:  * In the long run, daliPipeline_t is going to be replaced with daliPipeline (aka DALIPipeline *)\n74:  * and is going to be passed by value.\n75:  */\n76: typedef daliPipelineHandle *daliPipelineHandle_t;\n77: \n78: namespace {\n79: \n80: bool dali_initialized = false;\n81: \n82: int PopCurrBatchSize(batch_size_map_t *batch_size_map, int max_batch_size,\n83:                      const std::string &op_name) {\n84:   auto it = batch_size_map->find(op_name);\n85:   auto exists = it != batch_size_map->end();\n86:   auto ret = !exists || it->second < 0 ? max_batch_size : it->second;\n87:   if (exists) {\n88:     it->second = -1;\n89:   }\n90:   return ret;\n91: }\n92: \n93: /**\n94:  * @brief Extract InputOperatorSettingMode based on the DALI_ext_force_copy and DALI_ext_force_no_copy\n95:  *\n96:  * @param flags Flags typically specified in daliSetExternalInput* functions.\n97:  */\n98: dali::InputOperatorNoCopyMode GetExternalSourceCopyMode(unsigned int flags) {\n99:   dali::InputOperatorNoCopyMode no_copy_mode = dali::InputOperatorNoCopyMode::DEFAULT;\n100:   DALI_ENFORCE(!((flags & DALI_ext_force_copy) && (flags & DALI_ext_force_no_copy)),\n101:                \"External Source cannot be forced to use DALI_ext_force_copy and \"\n102:                \"DALI_ext_force_no_copy at the same time.\");\n103:   if (flags & DALI_ext_force_copy) {\n104:     no_copy_mode = dali::InputOperatorNoCopyMode::FORCE_COPY;\n105:   } else if (flags & DALI_ext_force_no_copy) {\n106:     no_copy_mode = dali::InputOperatorNoCopyMode::FORCE_NO_COPY;\n107:   }\n108:   return no_copy_mode;\n109: }\n110: \n111: template <typename Backend>\n112: void SetExternalInput(daliPipelineHandle_t pipe_handle, const char *name, const void *data_ptr,\n113:                       dali_data_type_t data_type, const int64_t *shapes, int sample_dim,\n114:                       const char *layout_str, cudaStream_t stream = 0, unsigned int flags = 0) {\n115:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n116:   auto *bs_map = &(*pipe_handle)->batch_size_map;\n117:   auto *data_id_map = &(*pipe_handle)->data_id_map;\n118:   auto curr_batch_size = PopCurrBatchSize(bs_map, pipeline->max_batch_size(), name);\n119:   std::vector<int64_t> shapes_tmp(shapes, shapes + sample_dim * curr_batch_size);\n120:   dali::TensorListShape<> tl_shape(std::move(shapes_tmp), curr_batch_size, sample_dim);\n121:   dali::TensorLayout layout{};\n122:   if (layout_str != nullptr) {\n123:     layout = dali::TensorLayout(layout_str);\n124:   }\n125:   dali::TensorList<Backend> data;\n126:   auto type_id = static_cast<dali::DALIDataType>(data_type);\n127:   auto elem_sizeof = dali::TypeTable::GetTypeInfo(type_id).size();\n128:   // We cast away the const from data_ptr, as there is no other way of passing it to the\n129:   // TensorList, as we must also set the shape and type metadata.\n130:   // It is passed further as const TensorList, so it's data cannot be modified.\n131:   AccessOrder order;\n132:   if (std::is_same_v<Backend, GPUBackend> || (flags & DALI_ext_pinned))\n133:     order = AccessOrder(stream);\n134:   else\n135:     order = AccessOrder::host();\n136:   // We do not support feeding memory cross-device, it is assumed it's on the current device\n137:   // that is tied to the pipeline.\n138:   int device_id = pipeline->device_id();\n139:   data.ShareData(std::shared_ptr<void>(const_cast<void *>(data_ptr), [](void *) {}),\n140:                  tl_shape.num_elements() * elem_sizeof, flags & DALI_ext_pinned, tl_shape, type_id,\n141:                  device_id, order);\n142:   data.SetLayout(layout);\n143: \n144:   auto data_id = data_id_map->extract(name);\n145: \n146:   pipeline->SetExternalInput(name, data, order, flags & DALI_ext_force_sync,\n147:                              flags & DALI_use_copy_kernel, GetExternalSourceCopyMode(flags),\n148:                              data_id ? std::make_optional(data_id.mapped()) : std::nullopt);\n149: }\n150: \n151: \n152: template<typename Backend>\n153: void SetExternalInputTensors(daliPipelineHandle_t pipe_handle, const char *name,\n154:                              const void *const *data_ptr, dali_data_type_t data_type,\n155:                              const int64_t *shapes, int64_t sample_dim, const char *layout_str,\n156:                              cudaStream_t stream = 0, unsigned int flags = 0) {\n157:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n158:   auto *bs_map = &(*pipe_handle)->batch_size_map;\n159:   auto *data_id_map = &(*pipe_handle)->data_id_map;\n160:   auto curr_batch_size = PopCurrBatchSize(bs_map, pipeline->max_batch_size(), name);\n161:   std::vector<int64_t> shapes_tmp(shapes, shapes + sample_dim * curr_batch_size);\n162:   dali::TensorListShape<> tl_shape(std::move(shapes_tmp), curr_batch_size, sample_dim);\n163:   dali::TensorLayout layout{};\n164:   if (layout_str != nullptr) {\n165:     layout = dali::TensorLayout(layout_str);\n166:   }\n167:   auto type_id = static_cast<dali::DALIDataType>(data_type);\n168:   auto elem_sizeof = dali::TypeTable::GetTypeInfo(type_id).size();\n169: \n170:   AccessOrder order;\n171:   if (std::is_same_v<Backend, GPUBackend> || (flags & DALI_ext_pinned))\n172:     order = AccessOrder(stream);\n173:   else\n174:     order = AccessOrder::host();\n175: \n176:   // We do not support feeding memory cross-device, it is assumed it's on the current device\n177:   // that is tied to the pipeline.\n178:   int device_id = pipeline->device_id();\n179: \n180:   dali::TensorList<Backend> data(curr_batch_size);\n181:   data.set_pinned(flags & DALI_ext_pinned);\n182:   data.set_sample_dim(sample_dim);\n183:   data.set_type(type_id);\n184:   data.set_device_id(device_id);\n185:   data.set_order(order);\n186:   data.SetLayout(layout);\n187: \n188:   for (int i = 0; i < curr_batch_size; i++) {\n189:     // We cast away the const from data_ptr, as there is no other way of passing it to the\n190:     // Tensor as we must also set the shape and type metadata.\n191:     // The vector that we pass to pipeline is const.\n192:     std::shared_ptr<void> ptr(const_cast<void *>(data_ptr[i]), [](void *){});  // no deleter\n193:     data.SetSample(i, ptr, tl_shape[i].num_elements() * elem_sizeof, flags & DALI_ext_pinned,\n194:                    tl_shape[i], type_id, device_id, order, layout);\n195:   }\n196: \n197:   auto data_id = data_id_map->extract(name);\n198: \n199:   pipeline->SetExternalInput(name, data, order, flags & DALI_ext_force_sync,\n200:                              flags & DALI_use_copy_kernel, GetExternalSourceCopyMode(flags),\n201:                              data_id ? std::make_optional(data_id.mapped()) : std::nullopt);\n202: }\n203: \n204: inline dali::mm::memory_kind_id GetMemKind(device_type_t device_type, bool is_pinned) {\n205:   return device_type == device_type_t::GPU\n206:         ? dali::mm::memory_kind_id::device\n207:         : (is_pinned ? dali::mm::memory_kind_id::pinned : dali::mm::memory_kind_id::host);\n208: }\n209: \n210: inline std::unique_ptr<DALIPipeline> WrapPipeline(std::unique_ptr<dali::Pipeline> pipeline) {\n211:   auto pipe_wrap = std::make_unique<DALIPipeline>();\n212: \n213:   if (pipeline->device_id() >= 0) {\n214:     pipe_wrap->copy_stream = dali::CUDAStreamPool::instance().Get(pipeline->device_id());\n215:   }\n216: \n217:   pipe_wrap->pipeline = std::move(pipeline);\n218:   return pipe_wrap;\n219: }\n220: \n221: }  // namespace\n222: \n223: \n224: void daliInitialize() {\n225:   static std::once_flag init_flag;\n226:   auto init = [&] {\n227:       dali::DALIInit(dali::OpSpec(\"CPUAllocator\"),\n228:                      dali::OpSpec(\"PinnedCPUAllocator\"),\n229:                      dali::OpSpec(\"GPUAllocator\"));\n230:       dali_initialized = true;\n231:   };\n232:   std::call_once(init_flag, init);\n233: }\n234: \n235: \n236: void daliCreatePipeline(daliPipelineHandle *pipe_handle, const char *serialized_pipeline,\n237:                         int length, int max_batch_size, int num_threads, int device_id,\n238:                         int separated_execution, int prefetch_queue_depth,\n239:                         int cpu_prefetch_queue_depth, int gpu_prefetch_queue_depth,\n240:                         int enable_memory_stats) {\n241:   daliCreatePipeline2(pipe_handle, serialized_pipeline, length, max_batch_size, num_threads,\n242:                       device_id, 1, 1, separated_execution, prefetch_queue_depth,\n243:                       cpu_prefetch_queue_depth, gpu_prefetch_queue_depth, enable_memory_stats);\n244: }\n245: \n246: DLL_PUBLIC void\n247: daliCreatePipeline2(daliPipelineHandle *pipe_handle, const char *serialized_pipeline, int length,\n248:                     int max_batch_size, int num_threads, int device_id, int pipelined_execution,\n249:                     int async_execution, int separated_execution, int prefetch_queue_depth,\n250:                     int cpu_prefetch_queue_depth, int gpu_prefetch_queue_depth,\n251:                     int enable_memory_stats) {\n252:   bool se = separated_execution != 0;\n253:   bool pe = pipelined_execution != 0;\n254:   bool ae = async_execution != 0;\n255: \n256:   auto pipeline =\n257:           std::make_unique<dali::Pipeline>(std::string(serialized_pipeline, length), max_batch_size,\n258:                                            num_threads, device_id, pe, prefetch_queue_depth, ae);\n259:   pipeline->SetExecutionTypes(pe, se, ae);\n260:   if (se) {\n261:     pipeline->SetQueueSizes(cpu_prefetch_queue_depth, gpu_prefetch_queue_depth);\n262:   }\n263:   pipeline->EnableExecutorMemoryStats(enable_memory_stats);\n264:   pipeline->Build();\n265: \n266:   *pipe_handle = WrapPipeline(std::move(pipeline)).release();\n267: }\n268: \n269: \n270: void daliDeserializeDefault(daliPipelineHandle *pipe_handle, const char *serialized_pipeline,\n271:                             int length) {\n272:   auto pipeline = std::make_unique<dali::Pipeline>(std::string(serialized_pipeline, length));\n273:   pipeline->Build();\n274:   *pipe_handle = WrapPipeline(std::move(pipeline)).release();\n275: }\n276: \n277: \n278: int daliIsDeserializable(const char* serialized_pipeline, int length) {\n279:   auto len = static_cast<size_t>(length);\n280:   return dali::Pipeline::IsDeserializable({serialized_pipeline, len}) ? 0 : 1;\n281: }\n282: \n283: \n284: int daliGetMaxBatchSize(daliPipelineHandle_t pipe_handle) {\n285:   return (*pipe_handle)->pipeline->max_batch_size();\n286: }\n287: \n288: int daliInputFeedCount(daliPipelineHandle_t pipe_handle, const char *input_name) {\n289:   auto &pipeline = (*pipe_handle)->pipeline;\n290:   return pipeline->InputFeedCount(input_name);\n291: }\n292: \n293: void daliPrefetch(daliPipelineHandle_t pipe_handle) {\n294:   auto &pipeline = (*pipe_handle)->pipeline;\n295:   pipeline->Prefetch();\n296: }\n297: \n298: void daliPrefetchUniform(daliPipelineHandle_t pipe_handle, int queue_depth) {\n299:   auto &pipeline = (*pipe_handle)->pipeline;\n300:   auto sz = pipeline->GetQueueSizes();\n301:   if (queue_depth != sz.cpu_size || queue_depth != sz.gpu_size) {\n302:     DALI_WARN(\"daliPrefetchUniform is deprecated and setting queue_length different than\"\n303:     \" the one set in the pipeline has no effect. Use daliPrefetch instead.\");\n304:   }\n305:   pipeline->Prefetch();\n306: }\n307: \n308: \n309: void daliPrefetchSeparate(daliPipelineHandle_t pipe_handle,\n310:                           int cpu_queue_depth, int gpu_queue_depth) {\n311:   auto &pipeline = (*pipe_handle)->pipeline;\n312:   auto sz = pipeline->GetQueueSizes();\n313:   if (cpu_queue_depth != sz.cpu_size || gpu_queue_depth != sz.gpu_size) {\n314:     DALI_WARN(\"daliPrefetchSeparate is deprecated and setting queue_length different than\"\n315:     \" the one set in the pipeline has no effect. Use daliPrefetch instead.\");\n316:   }\n317:   pipeline->Prefetch();\n318: }\n319: \n320: \n321: void daliSetExternalInputBatchSize(daliPipelineHandle_t pipe_handle, const char *name,\n322:                                    int batch_size) {\n323:   (*pipe_handle)->batch_size_map[name] = batch_size;\n324: }\n325: \n326: \n327: void daliSetExternalInputDataId(daliPipelineHandle_t pipe_handle, const char *operator_name,\n328:                                 const char *data_id) {\n329:   (*pipe_handle)->data_id_map[operator_name] = data_id;\n330: }\n331: \n332: \n333: void daliSetExternalInput(daliPipelineHandle_t pipe_handle, const char *name, device_type_t device,\n334:                           const void *data_ptr, dali_data_type_t data_type, const int64_t *shapes,\n335:                           int sample_dim, const char *layout_str, unsigned int flags) {\n336:   daliSetExternalInputAsync(pipe_handle, name, device, data_ptr, data_type, shapes, sample_dim,\n337:                             layout_str, (*pipe_handle)->copy_stream, flags | DALI_ext_force_sync);\n338: }\n339: \n340: void daliSetExternalInputAsync(daliPipelineHandle_t pipe_handle, const char *name,\n341:                                device_type_t device, const void *data_ptr,\n342:                                dali_data_type_t data_type, const int64_t *shapes,\n343:                                int sample_dim, const char *layout_str, cudaStream_t stream,\n344:                                unsigned int flags) {\n345:   switch (device) {\n346:     case device_type_t::CPU:\n347:       SetExternalInput<CPUBackend>(pipe_handle, name, data_ptr, data_type, shapes, sample_dim,\n348:                                    layout_str, stream, flags);\n349:       return;\n350:     case device_type_t::GPU:\n351:       SetExternalInput<GPUBackend>(pipe_handle, name, data_ptr, data_type, shapes, sample_dim,\n352:                                    layout_str, stream, flags);\n353:       return;\n354:     default:\n355:       DALI_FAIL(dali::make_string(\"Unknown device: \", device));\n356:   }\n357: }\n358: \n359: \n360: void daliSetExternalInputTensors(daliPipelineHandle_t pipe_handle, const char *name,\n361:                                  device_type_t device, const void *const *data_ptr,\n362:                                  dali_data_type_t data_type, const int64_t *shapes,\n363:                                  int64_t sample_dim, const char *layout_str, unsigned int flags) {\n364:   daliSetExternalInputTensorsAsync(pipe_handle, name, device, data_ptr, data_type, shapes,\n365:                                         sample_dim, layout_str, (*pipe_handle)->copy_stream,\n366:                                         flags | DALI_ext_force_sync);\n367: }\n368: \n369: \n370: void daliSetExternalInputTensorsAsync(daliPipelineHandle_t pipe_handle, const char *name,\n371:                                       device_type_t device, const void *const *data_ptr,\n372:                                       dali_data_type_t data_type, const int64_t *shapes,\n373:                                       int64_t sample_dim, const char *layout_str,\n374:                                       cudaStream_t stream, unsigned int flags) {\n375:   switch (device) {\n376:     case device_type_t::CPU:\n377:       SetExternalInputTensors<CPUBackend>(pipe_handle, name, data_ptr, data_type, shapes,\n378:                                           sample_dim, layout_str, stream, flags);\n379:       return;\n380:     case device_type_t::GPU:\n381:       SetExternalInputTensors<GPUBackend>(pipe_handle, name, data_ptr, data_type, shapes,\n382:                                           sample_dim, layout_str, stream, flags);\n383:       return;\n384:     default:\n385:       DALI_FAIL(dali::make_string(\"Unknown device: \", device));\n386:   }\n387: }\n388: \n389: \n390: int daliGetNumExternalInput(daliPipelineHandle_t pipe_handle) {\n391:   return (*pipe_handle)->pipeline->num_inputs();\n392: }\n393: \n394: \n395: const char *daliGetExternalInputName(daliPipelineHandle_t pipe_handle, int n) {\n396:   return (*pipe_handle)->pipeline->input_name(n).c_str();\n397: }\n398: \n399: \n400: const char *daliGetExternalInputLayout(daliPipelineHandle_t pipe_handle, const char *name) {\n401:   return (*pipe_handle)->pipeline->GetInputLayout(name).c_str();\n402: }\n403: \n404: \n405: int daliGetExternalInputNdim(daliPipelineHandle_t pipe_handle, const char *name) {\n406:   return (*pipe_handle)->pipeline->GetInputNdim(name);\n407: }\n408: \n409: dali_data_type_t daliGetExternalInputType(daliPipelineHandle_t pipe_handle, const char *name) {\n410:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n411:   auto type_id = pipeline->GetInputDtype(name);\n412:   return static_cast<dali_data_type_t>(static_cast<int>(type_id));\n413: }\n414: \n415: void daliRun(daliPipelineHandle_t pipe_handle) {\n416:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n417:   pipeline->Run();\n418: }\n419: \n420: \n421: void daliOutput(daliPipelineHandle_t pipe_handle) {\n422:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n423:   pipeline->Outputs(&(*pipe_handle)->workspace);\n424: }\n425: \n426: \n427: void daliShareOutput(daliPipelineHandle_t pipe_handle) {\n428:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n429:   pipeline->ShareOutputs(&(*pipe_handle)->workspace);\n430: }\n431: \n432: \n433: void daliOutputRelease(daliPipelineHandle_t pipe_handle) {\n434:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n435:   pipeline->ReleaseOutputs();\n436: }\n437: \n438: int64_t daliOutputHasUniformShape(daliPipelineHandle_t pipe_handle, int i) {\n439:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n440:   if (ws->OutputIsType<CPUBackend>(i)) {\n441:     return is_uniform(ws->Output<CPUBackend>(i).shape());\n442:   } else {\n443:     return is_uniform(ws->Output<GPUBackend>(i).shape());\n444:   }\n445: }\n446: \n447: template<typename T>\n448: static int64_t *daliShapeAtHelper(dali::Workspace *ws, int n, int k) {\n449:   int64_t *c_shape = nullptr;\n450:   std::vector<dali::Index> shape;\n451:   const auto &out_tensor_list = ws->Output<T>(n);\n452:   if (k >= 0) {\n453:     auto shape_span = out_tensor_list.tensor_shape_span(k);\n454:     shape = std::vector<dali::Index>(shape_span.begin(), shape_span.end());\n455:   } else {\n456:     auto shape_span = out_tensor_list.tensor_shape_span(0);\n457:     shape = std::vector<dali::Index>(shape_span.begin(), shape_span.end());\n458:     shape.insert(shape.begin(), out_tensor_list.num_samples());\n459:   }\n460: \n461:   c_shape = static_cast<int64_t*>(malloc(sizeof(int64_t) * (shape.size() + 1)));\n462:   if (!c_shape) {\n463:     return nullptr;\n464:   }\n465:   c_shape[shape.size()] = 0;\n466:   memcpy(c_shape, &shape[0], shape.size() * sizeof(int64_t));\n467:   return c_shape;\n468: }\n469: \n470: static int64_t* daliShapeAtTypedHelper(daliPipelineHandle_t pipe_handle, int n, int k) {\n471:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n472:   if (ws->OutputIsType<CPUBackend>(n)) {\n473:     return daliShapeAtHelper<CPUBackend>(ws, n, k);\n474:   } else {\n475:     return daliShapeAtHelper<GPUBackend>(ws, n, k);\n476:   }\n477: }\n478: \n479: int64_t* daliShapeAtSample(daliPipelineHandle_t pipe_handle, int n, int k) {\n480:   return daliShapeAtTypedHelper(pipe_handle, n, k);\n481: }\n482: \n483: int64_t* daliShapeAt(daliPipelineHandle_t pipe_handle, int n) {\n484:   return daliShapeAtTypedHelper(pipe_handle, n, -1);\n485: }\n486: \n487: template <typename T>\n488: static dali_data_type_t daliTypeAtHelper(dali::Workspace* ws, int n) {\n489:   const auto &out_tensor_list = ws->Output<T>(n);\n490:   auto type_id = out_tensor_list.type();\n491:   return static_cast<dali_data_type_t>(static_cast<int>(type_id));\n492: }\n493: \n494: dali_data_type_t daliTypeAt(daliPipelineHandle_t pipe_handle, int n) {\n495:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n496:   if (ws->OutputIsType<CPUBackend>(n)) {\n497:     return daliTypeAtHelper<CPUBackend>(ws, n);\n498:   } else {\n499:     return daliTypeAtHelper<GPUBackend>(ws, n);\n500:   }\n501: }\n502: \n503: \n504: template <typename T>\n505: static size_t daliNumTensorsHelper(dali::Workspace* ws, int n) {\n506:   return ws->Output<T>(n).num_samples();\n507: }\n508: \n509: size_t daliNumTensors(daliPipelineHandle_t pipe_handle, int n) {\n510:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n511:   if (ws->OutputIsType<CPUBackend>(n)) {\n512:     return daliNumTensorsHelper<CPUBackend>(ws, n);\n513:   } else {\n514:     return daliNumTensorsHelper<GPUBackend>(ws, n);\n515:   }\n516: }\n517: \n518: template <typename T>\n519: static size_t daliNumElementsHelper(dali::Workspace* ws, int n) {\n520:   return ws->Output<T>(n)._num_elements();\n521: }\n522: \n523: size_t daliNumElements(daliPipelineHandle_t pipe_handle, int n) {\n524:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n525:   if (ws->OutputIsType<CPUBackend>(n)) {\n526:     return daliNumElementsHelper<CPUBackend>(ws, n);\n527:   } else {\n528:     return daliNumElementsHelper<GPUBackend>(ws, n);\n529:   }\n530: }\n531: \n532: template <typename T>\n533: static size_t daliTensorSizeHelper(dali::Workspace* ws, int n) {\n534:   return ws->Output<T>(n).nbytes();\n535: }\n536: \n537: size_t daliTensorSize(daliPipelineHandle_t pipe_handle, int n) {\n538:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n539:   if (ws->OutputIsType<CPUBackend>(n)) {\n540:     return daliTensorSizeHelper<CPUBackend>(ws, n);\n541:   } else {\n542:     return daliTensorSizeHelper<GPUBackend>(ws, n);\n543:   }\n544: }\n545: \n546: template <typename T>\n547: static size_t daliMaxDimTensorsHelper(dali::Workspace* ws, int n) {\n548:   const auto &out_tensor_list = ws->Output<T>(n);\n549:   size_t tensors_num = out_tensor_list.num_samples();\n550:   int max_num_dim = 0;\n551:   for (size_t i = 0; i < tensors_num; ++i) {\n552:     auto shape = out_tensor_list.tensor_shape(i);\n553:     int num_dim = shape.size();\n554:     // squeeze last dimension\n555:     if (shape[num_dim - 1] == 1) {\n556:       --num_dim;\n557:     }\n558:     max_num_dim = std::max(max_num_dim, num_dim);\n559:   }\n560:   return static_cast<size_t>(max_num_dim);\n561: }\n562: \n563: size_t daliMaxDimTensors(daliPipelineHandle_t pipe_handle, int n) {\n564:   dali::Workspace* ws = &(*pipe_handle)->workspace;\n565:   if (ws->OutputIsType<CPUBackend>(n)) {\n566:     return daliMaxDimTensorsHelper<CPUBackend>(ws, n);\n567:   } else {\n568:     return daliMaxDimTensorsHelper<GPUBackend>(ws, n);\n569:   }\n570: }\n571: \n572: size_t daliGetDeclaredOutputNdim(daliPipelineHandle_t pipe_handle, int n) {\n573:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n574:   return pipeline->output_ndim(n);\n575: }\n576: \n577: dali_data_type_t daliGetDeclaredOutputDtype(daliPipelineHandle_t pipe_handle, int n) {\n578:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n579:   return static_cast<dali_data_type_t>(static_cast<int>(pipeline->output_dtype(n)));\n580: }\n581: \n582: unsigned daliGetNumOutput(daliPipelineHandle_t pipe_handle) {\n583:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n584:   return pipeline->num_outputs();\n585: }\n586: \n587: const char *daliGetOutputName(daliPipelineHandle_t pipe_handle, int id) {\n588:   auto *pipeline = (*pipe_handle)->pipeline.get();\n589:   return pipeline->output_name(id).c_str();\n590: }\n591: \n592: \n593: device_type_t daliGetOutputDevice(daliPipelineHandle_t pipe_handle, int id) {\n594:   dali::Pipeline *pipeline = (*pipe_handle)->pipeline.get();\n595:   if (pipeline->output_device(id) == \"gpu\") {\n596:     return device_type_t::GPU;\n597:   }\n598:   return device_type_t::CPU;\n599: }\n600: \n601: \n602: int daliHasOperatorTrace(daliPipelineHandle_t pipe_handle, const char *operator_name,\n603:                          const char *trace_name) {\n604:   auto *ws = &(*pipe_handle)->workspace;\n605:   try {\n606:     auto& traces = ws->GetOperatorTraces(operator_name);\n607:     return traces.find(trace_name) != traces.end() ? 1 : 0;\n608:   } catch (std::out_of_range&) {\n609:     return -1;\n610:   }\n611: }\n612: \n613: \n614: const char *\n615: daliGetOperatorTrace(daliPipelineHandle_t pipe_handle, const char *operator_name,\n616:                      const char *trace_name) {\n617:   auto *ws = &(*pipe_handle)->workspace;\n618:   if (daliHasOperatorTrace(pipe_handle, operator_name, trace_name)) {\n619:     return ws->GetOperatorTraces(operator_name).at(trace_name).c_str();\n620:   }\n621:   return nullptr;\n622: }\n623: \n624: \n625: void daliOutputCopy(daliPipelineHandle_t pipe_handle, void *dst, int output_idx,\n626:                     device_type_t dst_type, cudaStream_t stream, unsigned int flags) {\n627:   dali::DomainTimeRange tr(\"[DALI][C API] daliOutputCopy\", dali::DomainTimeRange::kGreen);\n628: \n629:   bool is_pinned = flags & DALI_ext_pinned;\n630:   bool host_sync = flags & DALI_ext_force_sync;\n631:   bool use_copy_kernel = flags & DALI_use_copy_kernel;\n632:   auto dst_mem_kind = GetMemKind(dst_type, is_pinned);\n633: \n634:   dali::Workspace *ws = &(*pipe_handle)->workspace;\n635:   assert(ws != nullptr);\n636: \n637:   AccessOrder wait_order = AccessOrder::host();\n638:   AccessOrder copy_order = AccessOrder::host();\n639: \n640:   if (ws->OutputIsType<CPUBackend>(output_idx)) {\n641:     copy_order = is_pinned ? AccessOrder(stream) : AccessOrder::host();\n642:     auto &src = ws->Output<CPUBackend>(output_idx);\n643:     CopyToExternal(dst, dst_mem_kind, src, copy_order, use_copy_kernel);\n644:     if (!host_sync)\n645:       wait_order = src.order();  // if the copy order is host, then wait will be no-op\n646:   } else {\n647:     auto &src = ws->Output<GPUBackend>(output_idx);\n648:     copy_order = stream;\n649:     CopyToExternal(dst, dst_mem_kind, src, copy_order, use_copy_kernel);\n650:     if (!host_sync)\n651:       wait_order = src.order();\n652:   }\n653:   wait_order.wait(copy_order);\n654: }\n655: \n656: void daliOutputCopySamples(daliPipelineHandle_t pipe_handle, void **dsts, int output_idx,\n657:                            device_type_t dst_type, cudaStream_t stream, unsigned int flags) {\n658:   dali::DomainTimeRange tr(\"[DALI][C API] daliOutputCopySamples\", dali::DomainTimeRange::kGreen);\n659: \n660:   bool is_pinned = flags & DALI_ext_pinned;\n661:   bool host_sync = flags & DALI_ext_force_sync;\n662:   bool use_copy_kernel = flags & DALI_use_copy_kernel;\n663:   auto dst_mem_kind = GetMemKind(dst_type, is_pinned);\n664: \n665:   dali::Workspace *ws = &(*pipe_handle)->workspace;\n666:   assert(ws != nullptr);\n667: \n668:   AccessOrder wait_order = AccessOrder::host();\n669:   AccessOrder copy_order = AccessOrder::host();\n670: \n671:   if (ws->OutputIsType<CPUBackend>(output_idx)) {\n672:     copy_order = is_pinned ? AccessOrder(stream) : AccessOrder::host();\n673:     auto & src = ws->Output<CPUBackend>(output_idx);\n674:     CopyToExternal(dsts, dst_mem_kind, src, copy_order, use_copy_kernel);\n675:     if (!host_sync)\n676:       wait_order = src.order();  // if the copy order is host, then wait will be no-op\n677:   } else {\n678:     auto &src = ws->Output<GPUBackend>(output_idx);\n679:     copy_order = stream;\n680:     CopyToExternal(dsts, dst_mem_kind, src, copy_order, use_copy_kernel);\n681:     if (!host_sync)\n682:       wait_order = src.order();\n683:   }\n684:   wait_order.wait(copy_order);\n685: }\n686: \n687: \n688: void daliCopyTensorNTo(daliPipelineHandle_t pipe_handle, void *dst, int output_id,\n689:                     device_type_t dst_type, cudaStream_t stream, int non_blocking) {\n690:   DALI_WARN(\"Warning: daliCopyTensorNTo is now deprecated. Use daliOutputCopy instead.\");\n691: \n692:   unsigned int flags = DALI_ext_default;\n693:   if (non_blocking == 0)\n694:     flags |= DALI_ext_force_sync;\n695: \n696:   daliOutputCopy(pipe_handle, dst, output_id, dst_type, stream, flags);\n697: }\n698: \n699: void daliCopyTensorListNTo(daliPipelineHandle_t pipe_handle, void *dst, int output_id,\n700:                            device_type_t dst_type, cudaStream_t stream, int non_blocking) {\n701:   DALI_WARN(\"Warning: daliCopyTensorListNTo is now deprecated. Use daliOutputCopy instead.\");\n702: \n703:   unsigned int flags = DALI_ext_default;\n704:   if (non_blocking == 0)\n705:     flags |= DALI_ext_force_sync;\n706: \n707:   daliOutputCopy(pipe_handle, dst, output_id, dst_type, stream, flags);\n708: }\n709: \n710: void daliDeletePipeline(daliPipelineHandle_t pipe_handle) {\n711:   if (!pipe_handle)\n712:     return;\n713: \n714:   auto wrap = std::unique_ptr<DALIPipeline>(*pipe_handle);\n715:   if (wrap->copy_stream)\n716:     CUDA_CALL(cudaStreamSynchronize(wrap->copy_stream));\n717: }\n718: \n719: void daliLoadLibrary(const char* lib_path) {\n720:   dali::PluginManager::LoadLibrary(lib_path);\n721: }\n722: \n723: void daliLoadPluginDirectory(const char* plugin_dir) {\n724:   dali::PluginManager::LoadDirectory(plugin_dir);\n725: }\n726: \n727: void daliLoadDefaultPlugins() {\n728:   dali::PluginManager::LoadDefaultPlugins();\n729: }\n730: \n731: void daliGetReaderMetadata(daliPipelineHandle_t pipe_handle, const char *reader_name,\n732:                            daliReaderMetadata* meta) {\n733:   DALI_ENFORCE(meta, \"Provided pointer to meta cannot be NULL.\");\n734:   dali::Pipeline* pipeline = (*pipe_handle)->pipeline.get();\n735:   dali::ReaderMeta returned_meta = pipeline->GetReaderMeta(reader_name);\n736:   meta->epoch_size = returned_meta.epoch_size;\n737:   meta->epoch_size_padded = returned_meta.epoch_size_padded;\n738:   meta->number_of_shards = returned_meta.number_of_shards;\n739:   meta->shard_id = returned_meta.shard_id;\n740:   meta->pad_last_batch = returned_meta.pad_last_batch;\n741:   meta->stick_to_shard = returned_meta.stick_to_shard;\n742: }\n743: \n744: dali_backend_t daliGetOperatorBackend(daliPipelineHandle_t pipe_handle, const char *operator_name) {\n745:   dali::Pipeline* pipeline = (*pipe_handle)->pipeline.get();\n746:   auto *node = pipeline->GetOperatorNode(operator_name);\n747:   switch (node->op_type) {\n748:     case dali::OpType::CPU:\n749:       return dali_backend_t::DALI_BACKEND_CPU;\n750:     case dali::OpType::GPU:\n751:       return dali_backend_t::DALI_BACKEND_GPU;\n752:     case dali::OpType::MIXED:\n753:       return dali_backend_t::DALI_BACKEND_MIXED;\n754:     default:\n755:       DALI_FAIL(\"Invalid operator type.\");\n756:   }\n757: }\n758: \n759: void daliGetExecutorMetadata(daliPipelineHandle_t pipe_handle, daliExecutorMetadata **operator_meta,\n760:                              size_t *operator_meta_num) {\n761:   dali::Pipeline* pipeline = (*pipe_handle)->pipeline.get();\n762:   auto returned_meta = pipeline->GetExecutorMeta();\n763:   *operator_meta_num = returned_meta.size();\n764:   *operator_meta = static_cast<daliExecutorMetadata*>(malloc(sizeof(daliExecutorMetadata) *\n765:                                                      returned_meta.size()));\n766: \n767:   int i = 0;\n768:   for (const auto &stat : returned_meta) {\n769:     auto op_name_size = stat.first.size();\n770:     auto &op_meta = (*operator_meta)[i];\n771:     op_meta.operator_name = static_cast<char*>(malloc(sizeof(char) * (op_name_size + 1)));\n772:     stat.first.copy(op_meta.operator_name, op_name_size);\n773:     op_meta.operator_name[op_name_size] = '\\0';\n774: \n775:     auto num_outputs = stat.second.size();\n776:     op_meta.out_num = num_outputs;\n777:     op_meta.real_size = static_cast<size_t*>(malloc(sizeof(size_t) * num_outputs));\n778:     op_meta.max_real_size = static_cast<size_t*>(malloc(sizeof(size_t) * num_outputs));\n779:     op_meta.reserved = static_cast<size_t*>(malloc(sizeof(size_t) * num_outputs));\n780:     op_meta.max_reserved = static_cast<size_t*>(malloc(sizeof(size_t) * num_outputs));\n781: \n782:     for (size_t j = 0; j < num_outputs; ++j) {\n783:       const auto &entry = stat.second[j];\n784:       op_meta.real_size[j] = entry.real_size;\n785:       op_meta.max_real_size[j] = entry.max_real_size;\n786:       op_meta.reserved[j] = entry.reserved;\n787:       op_meta.max_reserved[j] = entry.max_reserved;\n788:     }\n789:     ++i;\n790:   }\n791: }\n792: \n793: void daliFreeExecutorMetadata(daliExecutorMetadata *operator_meta, size_t operator_meta_num) {\n794:   for (size_t i = 0; i < operator_meta_num; ++i) {\n795:     free(operator_meta[i].operator_name);\n796:     free(operator_meta[i].real_size);\n797:     free(operator_meta[i].max_real_size);\n798:     free(operator_meta[i].reserved);\n799:     free(operator_meta[i].max_reserved);\n800:   }\n801:   free(operator_meta);\n802: }\n803: \n804: void daliReleaseUnusedMemory() {\n805:   dali::mm::ReleaseUnusedMemory();\n806: }\n807: \n808: int daliPreallocateDeviceMemory(size_t bytes, int device_id) {\n809:   try {\n810:     dali::mm::PreallocateDeviceMemory(bytes, device_id);\n811:     return 0;\n812:   } catch (const std::bad_alloc &) {\n813:     return -1;\n814:   }\n815: }\n816: \n817: int daliPreallocatePinnedMemory(size_t bytes) {\n818:   try {\n819:     dali::mm::PreallocatePinnedMemory(bytes);\n820:     return 0;\n821:   } catch (const std::bad_alloc &) {\n822:     return -1;\n823:   }\n824: }\n825: \n826: void *daliAlloc(size_t n) {\n827:   return malloc(n);\n828: }\n829: \n830: void daliFree(void *ptr) {\n831:   free(ptr);\n832: }\n833: \n834: void daliGetSerializedCheckpoint(\n835:     daliPipelineHandle_t pipe_handle,\n836:     const daliExternalContextCheckpoint *external_context,\n837:     char **checkpoint, size_t *n) {\n838:   DALI_ENFORCE(external_context, \"Provided pointer to external context cannot be NULL.\");\n839:   auto &pipeline = (*pipe_handle)->pipeline;\n840:   dali::ExternalContextCheckpoint ctx{};\n841:   if (external_context->pipeline_data.data) {\n842:     ctx.pipeline_data = {\n843:       external_context->pipeline_data.data,\n844:       external_context->pipeline_data.size\n845:     };\n846:   }\n847:   if (external_context->iterator_data.data) {\n848:     ctx.iterator_data = {\n849:       external_context->iterator_data.data,\n850:       external_context->iterator_data.size\n851:     };\n852:   }\n853:   std::string cpt = pipeline->SerializedCheckpoint(ctx);\n854:   *n = cpt.size();\n855:   *checkpoint = reinterpret_cast<char *>(daliAlloc(cpt.size()));\n856:   DALI_ENFORCE(*checkpoint, \"Failed to allocate memory\");\n857:   memcpy(*checkpoint, cpt.c_str(), *n);\n858: }\n859: \n860: daliExternalContextField daliExternalContextFieldFromString(const std::string &string) {\n861:   daliExternalContextField field;\n862:   auto n = string.size();\n863:   field.data = static_cast<char *>(daliAlloc(n));\n864:   memcpy(field.data, string.c_str(), n);\n865:   field.size = n;\n866:   return field;\n867: }\n868: \n869: void daliRestoreFromSerializedCheckpoint(\n870:     daliPipelineHandle *pipe_handle,\n871:     const char *checkpoint, size_t n,\n872:     daliExternalContextCheckpoint *external_context) {\n873:   DALI_ENFORCE(external_context != nullptr,\n874:           