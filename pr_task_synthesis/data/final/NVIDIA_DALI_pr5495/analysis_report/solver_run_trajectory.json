keep that in sync with ReaderMeta from operator.h\n65:  */\n66: typedef struct {\n67:   int64_t epoch_size;          // raw epoch size\n68:   int64_t epoch_size_padded;   // epoch size with the padding at the end\n69:   int number_of_shards;        // number of shards\n70:   int shard_id;                // shard id of given reader\n71:   int pad_last_batch;          // if given reader should pad last batch\n72:   int stick_to_shard;          // if given reader should stick to its shard\n73: } daliReaderMetadata;\n74: \n75: \n76: /*\n77:  * Need to keep that in sync with ExecutorMeta from executor.h\n78:  */\n79: typedef struct {\n80:   char *operator_name;         // operator name, user need to free the memory\n81:   size_t out_num;              // number of the operator outputs\n82:   size_t *real_size;           // real size of the operator output, user need to free the memory\n83:   size_t *max_real_size;       // the biggest size of the tensor in the batch\n84:   size_t *reserved;            // reserved size of the operator output, user need to free the memory\n85:   size_t *max_reserved;        // the biggest reserved memory size for the tensor in the batch\n86: } daliExecutorMetadata;\n87: \n88: \n89: typedef struct daliExternalContextField {\n90:   char *data;\n91:   size_t size;\n92: } daliExternalContextField;\n93: \n94: /*\n95:  * Need to keep that in sync with ExternalContextCheckpoint from checkpoint.h\n96:  */\n97: typedef struct {\n98:   daliExternalContextField pipeline_data;\n99:   daliExternalContextField iterator_data;\n100: } daliExternalContextCheckpoint;\n101: \n102: \n103: /**\n104:  * @brief DALI initialization\n105:  *\n106:  * Call this function to initialize DALI backend. It shall be called once per process.\n107:  * Along with this, you'll need to call @see daliInitOperatorsLib() function from\n108:  * `operators.h` file, to initialize whole DALI.\n109:  * In the unlikely event you'd like to use only Pipeline and Executor (no Operators),\n110:  * you may pass on calling @see daliInitOperatorsLib()\n111:  */\n112: DLL_PUBLIC void daliInitialize();\n113: \n114: /**\n115:  * @name Create DALI Pipeline via deserialization.\n116:  * @{\n117:  */\n118: /**\n119:  * @brief Create DALI pipeline. Setting max_batch_size,\n120:  * num_threads or device_id here overrides\n121:  * values stored in the serialized pipeline.\n122:  * When separated_execution is equal to 0, prefetch_queue_depth is considered,\n123:  * gpu_prefetch_queue_depth and cpu_prefetch_queue_depth are ignored.\n124:  * When separated_execution is not equal to 0, cpu_prefetch_queue_depth and\n125:  * gpu_prefetch_queue_depth are considered and prefetch_queue_depth is ignored.\n126:  */\n127: DLL_PUBLIC void daliCreatePipeline(daliPipelineHandle *pipe_handle, const char *serialized_pipeline,\n128:                                    int length, int max_batch_size, int num_threads, int device_id,\n129:                                    int separated_execution, int prefetch_queue_depth,\n130:                                    int cpu_prefetch_queue_depth, int gpu_prefetch_queue_depth,\n131:                                    int enable_memory_stats);\n132: \n133: /**\n134:  * Create a DALI Pipeline, using a pipeline that has been serialized beforehand.\n135:  *\n136:  * @param pipe_handle Pipeline handle.\n137:  * @param serialized_pipeline Serialized pipeline.\n138:  * @param length Length of the serialized pipeline string.\n139:  * @param max_batch_size Maximum batch size.\n140:  * @param num_threads Number of CPU threads which this pipeline uses.\n141:  * @param device_id ID of the GPU device which this pipeline uses.\n142:  * @param pipelined_execution If != 0, this pipeline will execute in Pipeline mode.\n143:  * @param async_execution If != 0, this pipeline will execute asynchronously.\n144:  * @param separated_execution If != 0, this pipeline will have different depths\n145:  *                            of the CPU and GPU prefetching queues.\n146:  * @param prefetch_queue_depth Depth of the prefetching queue.\n147:  *                             If `separated_execution != 0`, this value is ignored.\n148:  * @param cpu_prefetch_queue_depth Depth of the prefetching queue in the CPU stage.\n149:  *                                 If `separated_execution == 0`, this value is ignored\n150:  * @param gpu_prefetch_queue_depth Depth of the prefetching queue in the GPU stage.\n151:  *                                 If `separated_execution == 0`, this value is ignored\n152:  * @param enable_memory_stats Enable memory stats.\n153:  */\n154: DLL_PUBLIC void\n155: daliCreatePipeline2(daliPipelineHandle *pipe_handle, const char *serialized_pipeline, int length,\n156:                     int max_batch_size, int num_threads, int device_id, int pipelined_execution,\n157:                     int async_execution, int separated_execution, int prefetch_queue_depth,\n158:                     int cpu_prefetch_queue_depth, int gpu_prefetch_queue_depth,\n159:                     int enable_memory_stats);\n160: \n161: /**\n162:  * Convenient overload. Use it, if the Pipeline should inherit its parameters\n163:  * from serialized pipeline.\n164:  */\n165: DLL_PUBLIC void daliDeserializeDefault(daliPipelineHandle *pipe_handle,\n166:                                        const char *serialized_pipeline,\n167:                                        int length);\n168: \n169: /**\n170:  * Checks, if the pipeline given by the string can be deserialized. It can be assumed that the\n171:  * pipeline, which can be deserialized, is a formally valid DALI pipeline.\n172:  *\n173:  * @param serialized_pipeline String with the serialized pipeline.\n174:  * @param length Length of the string.\n175:  * @return 0, if the pipeline is serializable. 1 otherwise.\n176:  */\n177: DLL_PUBLIC int daliIsDeserializable(const char* serialized_pipeline, int length);\n178: /** @} */\n179: \n180: enum {\n181:   DALI_ext_default = 0,\n182:   /**\n183:    * If memory transfer should be synchronous - applies to GPU memory\n184:    */\n185:   DALI_ext_force_sync = (1 << 0),\n186: \n187:   /**\n188:    * If provided CPU memory is page-locked\n189:    */\n190:   DALI_ext_pinned = (1 << 1),\n191: \n192:   /**\n193:    * If provided, a CUDA copy kernel will be used to feed external source instead of cudaMemcpyAsync\n194:    * Only relevant when the input is either pinned host memory or device memory\n195:    */\n196:   DALI_use_copy_kernel = (1 << 2),\n197: \n198:   /**\n199:    * Override the `no_copy` specified for given External Source and force the data to be copied.\n200:    */\n201:   DALI_ext_force_copy = (1 << 3),\n202: \n203:   /**\n204:    * Override the `no_copy` specified for given External Source and pass the data directly to the\n205:    * Pipeline.\n206:    */\n207:   DALI_ext_force_no_copy = (1 << 4),\n208: };\n209: \n210: /**\n211:  * @name Input batch size information\n212:  * @{\n213:  */\n214: /**\n215:  * @brief Get the max batch size of a given pipeline.\n216:  *\n217:  * @param pipe_handle Pointer to pipeline handle\n218:  * @return Max batch size\n219:  */\n220: DLL_PUBLIC int daliGetMaxBatchSize(daliPipelineHandle *pipe_handle);\n221: \n222: /**\n223:  * @brief Set the batch size for the upcoming call to `daliSetExternalInput*(...)`\n224:  *\n225:  * @param pipe_handle Pointer to pipeline handle\n226:  * @param name Pointer to a null-terminated byte string with the name of the External Source\n227:  *             to be fed\n228:  * @param batch_size Batch size of the data\n229:  */\n230: DLL_PUBLIC void daliSetExternalInputBatchSize(daliPipelineHandle *pipe_handle, const char *name,\n231:                                               int batch_size);\n232: \n233: /**\n234:  * Set the data_id for the upcoming call to `daliSetExternalInput*(...)`.\n235:  *\n236:  * The operator_name accepts the name of an input operator. Input operators are the operators,\n237:  * that can work with `daliSetExternalInput*(...)` functions, e.g. fn.external_source or\n238:  * fn.inputs.video.\n239:  *\n240:  * @param operator_name The name of the input operator to be fed.\n241:  * @param data_id data_id which will be assigned during upcoming `daliSetExternalInput*(...)` call.\n242:  */\n243: DLL_PUBLIC void\n244: daliSetExternalInputDataId(daliPipelineHandle *pipe_handle, const char *operator_name,\n245:                            const char *data_id);\n246: \n247: /**\n248:  * @brief Returns how many times daliSetExternalInput on a given input before calling daliPrefetch\n249:  *\n250:  * @param pipe_handle The handle to the pipeline\n251:  * @param input_name The name of the input in question\n252:  * @return The number of calls to be made\n253:  */\n254: DLL_PUBLIC int\n255: daliInputFeedCount(daliPipelineHandle *pipe_handle, const char *input_name);\n256: \n257: /** @} */\n258: \n259: /**\n260:  * @name Contiguous inputs\n261:  * @{\n262:  */\n263: /**\n264:  * @brief Feed the data to ExternalSource as contiguous memory.\n265:  *\n266:  * When calling this function, you need to provide a CUDA stream, which will be used when\n267:  * copying data onto GPU. This function is asynchronous, so it's your responsibility to\n268:  * synchronize on a provided CUDA stream.\n269:  *\n270:  * If GPU memory is provided, it is assumed to reside on the same device that the pipeline is using.\n271:  * See `device_id` parameter of the `daliCreatePipeline`.\n272:  *\n273:  * Keep in mind, that for the special case, where the data exists on the CPU and the\n274:  * ExternalSource's Backend in also a CPU, stream is not needed - feel free to pass\n275:  * the default stream.\n276:  *\n277:  * A convenience, synchronous, overload function is provided,\n278:  * which handles the stream synchronization.\n279:  *\n280:  * If `daliSetExternalInputBatchSize` has been called prior to this function, given batch size\n281:  * is assumed. Otherwise, the function will default to max batch size.\n282:  * @see daliSetExternalInputBatchSize\n283:  * @see daliCreatePipeline\n284:  *\n285:  * @param pipe_handle Pointer to pipeline handle\n286:  * @param name Pointer to a null-terminated byte string with the name of the External Source\n287:  *             to be fed\n288:  * @param device Device of the supplied memory.\n289:  * @param data_ptr Pointer to contiguous buffer containing all samples\n290:  * @param data_type Type of the provided data\n291:  * @param shapes Pointer to an array containing shapes of all samples concatenated one after\n292:  *              another. Should contain batch_size * sample_dim elements.\n293:  * @param sample_dim The dimensionality of a single sample.\n294:  * @param layout_str Optional layout provided as a pointer to null-terminated byte string.\n295:  *                   Can be set to NULL.\n296:  * @param stream CUDA stream to use when copying the data onto GPU. Remember to synchronize on the\n297:  *               provided stream.\n298:  * @param flags Extra flags, check DALI_ext_* and DALI_use_copy_kernel flags\n299:  */\n300: DLL_PUBLIC void\n301: daliSetExternalInputAsync(daliPipelineHandle *pipe_handle, const char *name,\n302:                           device_type_t device, const void *data_ptr,\n303:                           dali_data_type_t data_type, const int64_t *shapes,\n304:                           int sample_dim, const char *layout_str,\n305:                           cudaStream_t stream, unsigned int flags);\n306: \n307: DLL_PUBLIC void\n308: daliSetExternalInput(daliPipelineHandle *pipe_handle, const char *name,\n309:                      device_type_t device, const void *data_ptr,\n310:                      dali_data_type_t data_type, const int64_t *shapes,\n311:                      int sample_dim, const char *layout_str, unsigned int flags);\n312: /** @} */\n313: \n314: /**\n315:  * @name Sample inputs\n316:  * @{\n317:  */\n318: /**\n319:  * @brief Feed the data to ExternalSource as a set of separate buffers.\n320:  *\n321:  * When calling this function, you need to provide a CUDA stream, which will be used when\n322:  * copying data onto GPU. This function is asynchronous, so it's your responsibility to\n323:  * synchronize on a provided CUDA stream.\n324:  *\n325:  * Keep in mind, that for the special case, where the data exists on the CPU and the\n326:  * ExternalSource's Backend in also a CPU, stream is not needed - feel free to pass\n327:  * the default stream.\n328:  *\n329:  * A convenience, synchronous, overload function is provided,\n330:  * which handles the stream synchronization.\n331:  *\n332:  * If `daliSetExternalInputBatchSize` has been called prior to this function, given batch size\n333:  * is assumed. Otherwise, the function will default to max batch size.\n334:  * @see daliSetExternalInputBatchSize\n335:  * @see daliCreatePipeline\n336:  *\n337:  * @param pipe_handle Pointer to pipeline handle\n338:  * @param name Pointer to a null-terminated byte string with the name of the External Source\n339:  *             to be fed\n340:  * @param device Device of the supplied memory.\n341:  * @param data_ptr Pointer to an array containing batch_size pointers to separate Tensors.\n342:  * @param data_type Type of the provided data\n343:  * @param shapes Pointer to an array containing shapes of all samples concatenated one after\n344:  *              another. Should contain batch_size * sample_dim elements.\n345:  * @param sample_dim The dimensionality of a single sample.\n346:  * @param layout_str Optional layout provided as a pointer to null-terminated byte string.\n347:  *                   Can be set to NULL.\n348:  * @param stream CUDA stream to use when copying the data onto GPU. Remember to synchronize on the\n349:  *               provided stream.\n350:  * @param flags Extra flags, check DALI_ext_force_sync, DALI_ext_pinned, DALI_use_copy_kernel\n351:  */\n352: DLL_PUBLIC void\n353: daliSetExternalInputTensorsAsync(daliPipelineHandle *pipe_handle, const char *name,\n354:                                  device_type_t device, const void *const *data_ptr,\n355:                                  dali_data_type_t data_type, const int64_t *shapes,\n356:                                  int64_t sample_dim, const char *layout_str,\n357:                                  cudaStream_t stream, unsigned int flags);\n358: \n359: DLL_PUBLIC void\n360: daliSetExternalInputTensors(daliPipelineHandle *pipe_handle, const char *name,\n361:                             device_type_t device, const void *const *data_ptr,\n362:                             dali_data_type_t data_type, const int64_t *shapes,\n363:                             int64_t sample_dim, const char *layout_str, unsigned int flags);\n364: /** @} */\n365: \n366: /**\n367:  * @brief Get number of external inputs in the pipeline.\n368:  *\n369:  * @param pipe_handle Pointer to pipeline handle.\n370:  * @return Number of inputs.\n371:  */\n372: DLL_PUBLIC int daliGetNumExternalInput(daliPipelineHandle *pipe_handle);\n373: \n374: /**\n375:  * @brief Get the name of n-th external input in the pipeline in the lexicographic order.\n376:  *\n377:  * Returned pointer is valid until the lifetime of the pipeline object ends.\n378:  *\n379:  * @param pipe_handle Pointer to pipeline handle.\n380:  * @param n\n381:  * @return Name of the external input.\n382:  */\n383: DLL_PUBLIC const char *daliGetExternalInputName(daliPipelineHandle *pipe_handle, int n);\n384: \n385: /**\n386:  * @brief Get the data layout required by the external input with a given name.\n387:  * If the layout is not determined, an empty string is returned.\n388:  *\n389:  * Returned pointer is valid until the lifetime of the pipeline object ends.\n390:  *\n391:  * @param pipe_handle Pointer to pipeline handle.\n392:  * @param name Name of the external input.\n393:  * @return Layout string.\n394:  */\n395: DLL_PUBLIC const char *daliGetExternalInputLayout(daliPipelineHandle *pipe_handle,\n396:                                                   const char *name);\n397: \n398: \n399: /**\n400:  * @brief Get the data type required by the external input with a given name.\n401:  *\n402:  * @param pipe_handle Pointer to pipeline handle.\n403:  * @param name Name of the external input.\n404:  * @return Data type.\n405:  */\n406: DLL_PUBLIC dali_data_type_t daliGetExternalInputType(daliPipelineHandle *pipe_handle,\n407:                                                      const char *name);\n408: \n409: \n410: /**\n411:  * @brief Get the data number of dimensions required by the external input with a given name.\n412:  * If the number of dimensions is not determined, -1 is returned.\n413:  *\n414:  * @param pipe_handle Pointer to pipeline handle.\n415:  * @param name Name of the external input.\n416:  * @return Number of dimensions.\n417:  */\n418: DLL_PUBLIC int daliGetExternalInputNdim(daliPipelineHandle *pipe_handle, const char *name);\n419: \n420: /**\n421:  * @brief Start the execution of the pipeline.\n422:  */\n423: DLL_PUBLIC void daliRun(daliPipelineHandle *pipe_handle);\n424: \n425: /**\n426:  * @brief Schedule initial runs to fill the buffers.\n427:  *\n428:  * This function should be called once, after a pipeline is created and external inputs\n429:  * (if any) are populated the required number of times.\n430:  * For subsequent runs, daliRun should be used.\n431:  */\n432: DLL_PUBLIC void daliPrefetch(daliPipelineHandle *pipe_handle);\n433: \n434: /**\n435:  * @brief Schedule first runs to fill buffers for Executor with UniformQueue policy.\n436:  * @param queue_depth Ignored; must be equal to the pipeline's queue depth\n437:  * @deprecated Use `daliPrefetch` instead\n438:  */\n439: DLL_PUBLIC void daliPrefetchUniform(daliPipelineHandle *pipe_handle, int queue_depth);\n440: \n441: /**\n442:  * @brief Schedule first runs to fill buffers for Executor with SeparateQueue policy.\n443:  * @param cpu_queue_depth Ignored; must be equal to the pipeline's CPU queue depth\n444:  * @param gpu_queue_depth Ignored; must be equal to the pipeline's GPU queue depth\n445:  * @deprecated Use `daliPrefetch` instead\n446:  */\n447: DLL_PUBLIC void daliPrefetchSeparate(daliPipelineHandle *pipe_handle,\n448:                                      int cpu_queue_depth, int gpu_queue_depth);\n449: \n450: /**\n451:  * @brief Wait until the output of the pipeline is ready.\n452:  * Releases previously returned buffers.\n453:  */\n454: DLL_PUBLIC void daliOutput(daliPipelineHandle *pipe_handle);\n455: \n456: /**\n457:  * @brief Wait until the output of the pipeline is ready.\n458:  * Doesn't release previously returned buffers.\n459:  */\n460: DLL_PUBLIC void daliShareOutput(daliPipelineHandle *pipe_handle);\n461: \n462: /**\n463:  * @brief Releases buffer returned by last daliOutput call.\n464:  */\n465: DLL_PUBLIC void daliOutputRelease(daliPipelineHandle *pipe_handle);\n466: \n467: /**\n468:  * @brief Returns 1 if the the output batch stored at position `n` in the pipeline can\n469:  * be represented as dense, uniform tensor. Otherwise 0.\n470:  *\n471:  * This function may only be called after\n472:  * calling Output function.\n473:  */\n474: DLL_PUBLIC int64_t daliOutputHasUniformShape(daliPipelineHandle *pipe_handle, int i);\n475: \n476: /**\n477:  * @brief Return the shape of the output tensor stored at position `n` in the pipeline.\n478:  * Valid only if daliOutputHasUniformShape() returns 1.\n479:  *\n480:  * This function may only be called after\n481:  * calling Output function.\n482:  * @remarks Caller is responsible to 'free' the memory returned\n483:  */\n484: DLL_PUBLIC int64_t *daliShapeAt(daliPipelineHandle *pipe_handle, int n);\n485: \n486: /**\n487:  * @brief Return the type of the output tensor\n488:  * stored at position `n` in the pipeline.\n489:  * This function may only be called after\n490:  * calling Output function.\n491:  */\n492: DLL_PUBLIC dali_data_type_t daliTypeAt(daliPipelineHandle *pipe_handle, int n);\n493: \n494: /**\n495:  * @brief Return the shape of the 'k' output tensor from tensor list\n496:  * stored at position `n` in the pipeline.\n497:  * This function may only be called after\n498:  * calling Output function.\n499:  * @remarks Caller is responsible to 'free' the memory returned\n500:  */\n501: DLL_PUBLIC int64_t *daliShapeAtSample(daliPipelineHandle *pipe_handle, int n, int k);\n502: \n503: /**\n504:  * @brief Return the number of tensors in the tensor list\n505:  * stored at position `n` in the pipeline.\n506:  */\n507: DLL_PUBLIC size_t daliNumTensors(daliPipelineHandle *pipe_handle, int n);\n508: \n509: /**\n510:  * @brief Return the number of all elements in the tensor list\n511:  * stored at position `n` in the pipeline.\n512:  */\n513: DLL_PUBLIC size_t daliNumElements(daliPipelineHandle *pipe_handle, int n);\n514: \n515: /**\n516:  * @brief Return the size of the tensor list\n517:  * stored at position `n` in the pipeline.\n518:  */\n519: DLL_PUBLIC size_t daliTensorSize(daliPipelineHandle *pipe_handle, int n);\n520: \n521: /**\n522:  * @brief Return maximum number of dimensions from all tensors\n523:  * from the tensor list stored at position `n` in the pipeline.\n524:  */\n525: DLL_PUBLIC size_t daliMaxDimTensors(daliPipelineHandle *pipe_handle, int n);\n526: \n527: /**\n528:  * @brief Check, what is the declared number of dimensions in the given output.\n529:  *\n530:  * Declared number of dimensions is a number, which user can optionally provide\n531:  * at the pipeline definition stage.\n532:  *\n533:  * @param n Index of the output, at which the check is performed.\n534:  */\n535: DLL_PUBLIC size_t daliGetDeclaredOutputNdim(daliPipelineHandle *pipe_handle, int n);\n536: \n537: /**\n538:  * @brief Check, what is the declared data type in the given output.\n539:  *\n540:  * Declared data type is a type, which user can optionally provide\n541:  * at the pipeline definition stage.\n542:  *\n543:  * @param n Index of the output, at which the check is performed.\n544:  */\n545: DLL_PUBLIC dali_data_type_t daliGetDeclaredOutputDtype(daliPipelineHandle *pipe_handle, int n);\n546: \n547: /**\n548:  * @brief Returns number of DALI pipeline outputs\n549:  */\n550: DLL_PUBLIC unsigned daliGetNumOutput(daliPipelineHandle *pipe_handle);\n551: \n552: /**\n553:  * @brief Returns a string indicating name of the output given by id.\n554:  * @remark The returned pointer is invalidated after calling `daliDeletePipeline(pipe_handle)`.\n555:  */\n556: DLL_PUBLIC const char *daliGetOutputName(daliPipelineHandle *pipe_handle, int id);\n557: \n558: /**\n559:  * @brief Returns device_type_t indicating device backing pipeline output given by id\n560:  */\n561: DLL_PUBLIC device_type_t daliGetOutputDevice(daliPipelineHandle *pipe_handle, int id);\n562: \n563: \n564: /**\n565:  * @name Operator traces\n566:  * @{\n567:  */\n568: /**\n569:  * Checks, if given operator produced a trace with given name.\n570:  *\n571:  * In case the name of non-existing operator is provided,\n572:  * the behaviour of this function is undefined.\n573:  *\n574:  * @return 0, if the trace with given name does not exist.\n575:  */\n576: DLL_PUBLIC int daliHasOperatorTrace(daliPipelineHandle *pipe_handle, const char *operator_name,\n577:                                     const char *trace_name);\n578: \n579: /**\n580:  * Returns the traces of the given operator in the DALI Pipeline.\n581:  *\n582:  * Operator Traces is a communication mechanism with particular operators in the pipeline. For\n583:  * more information @see operator_trace_map_t.\n584:  *\n585:  * User does not own the returned value. In a situation, when changing of this value is necessary,\n586:  * user shall copy it to his own memory. The lifetime of this value ends, when the\n587:  * daliOutputRelease() is called.\n588:  *\n589:  * User shall check, if the trace with given name exists (@see daliHasOperatorTrace). In case the\n590:  * name of non-existing operator or non-existing trace is provided, the behaviour of this function\n591:  * is undefined.\n592:  *\n593:  * @param operator_name Name of the operator, which trace shall be returned.\n594:  * @param trace_name Name of the requested trace.\n595:  * @return Operator trace.\n596:  */\n597: DLL_PUBLIC const char *\n598: daliGetOperatorTrace(daliPipelineHandle *pipe_handle, const char *operator_name,\n599:                      const char *trace_name);\n600: /** @} */\n601: \n602: \n603: /**\n604:  * @brief Copy the output batch stored at position `output_idx` in the pipeline.\n605:  * @remarks If the pipeline output is TensorList then it needs to be dense\n606:  * @param pipe_handle Pointer to pipeline handle\n607:  * @param dst Pointer to the destination buffer where the data will be copied\n608:  * @param output_idx index of the pipeline output\n609:  * @param dst_type Device type associated with the destination buffer (0 - CPU, 1 - GPU)\n610:  * @param stream CUDA stream to use when copying the data to/from the GPU.\n611:  * @param flags Extra flags, check DALI_ext_force_sync, DALI_use_copy_kernel\n612:  */\n613: \n614: DLL_PUBLIC void\n615: daliOutputCopy(daliPipelineHandle *pipe_handle, void *dst, int output_idx, device_type_t dst_type,\n616:                cudaStream_t stream, unsigned int flags);\n617: \n618: /**\n619:  * @brief Copy the samples in output stored at position `output_idx` in the pipeline\n620:  *        to scattered memory locations.\n621:  * @param pipe_handle Pointer to pipeline handle\n622:  * @param dsts Pointers to the destination buffers where each sample will be copied.\n623:  *        A nullptr dst pointer for a sample will discard that sample.\n624:  * @param output_idx index of the pipeline output\n625:  * @param dst_type Device type associated with the destination buffer (0 - CPU, 1 - GPU)\n626:  * @param stream CUDA stream to use when copying the data to/from the GPU.\n627:  * @param flags Extra flags, check DALI_ext_force_sync, DALI_use_copy_kernel\n628:  */\n629: DLL_PUBLIC void daliOutputCopySamples(daliPipelineHandle *pipe_handle, void **dsts, int output_idx,\n630:                                       device_type_t dst_type, cudaStream_t stream,\n631:                                       unsigned int flags);\n632: \n633: /**\n634:  * @brief DEPRECATED API: use daliOutputCopy instead\n635:  */\n636: DLL_PUBLIC void\n637: daliCopyTensorNTo(daliPipelineHandle *pipe_handle, void *dst, int n, device_type_t dst_type,\n638:                   cudaStream_t stream, int non_blocking);\n639: \n640: /**\n641:  * @brief DEPRECATED API: use daliOutputCopy instead\n642:  */\n643: DLL_PUBLIC void\n644: daliCopyTensorListNTo(daliPipelineHandle *pipe_handle, void *dst, int output_id,\n645:                       device_type_t dst_type, cudaStream_t stream, int non_blocking);\n646: \n647: /**\n648:  * @brief Delete the pipeline object.\n649:  */\n650: DLL_PUBLIC void daliDeletePipeline(daliPipelineHandle *pipe_handle);\n651: \n652: /**\n653:  * @brief Load plugin library\n654:  */\n655: DLL_PUBLIC void daliLoadLibrary(const char *lib_path);\n656: \n657: /**\n658:  * @brief The plugin paths will have the following pattern:\n659:  *        {lib_path}/{sub_path}/libdali_{plugin_name}.so\n660:  */\n661: DLL_PUBLIC void daliLoadPluginDirectory(const char* plugin_dir);\n662: \n663: /**\n664:  * @brief Load default plugin library\n665:  * @remarks DALI_PRELOAD_PLUGINS are environment variables that can be used to control what\n666:  * plugins are loaded. If the variable is set, it is interpreted as a list of paths separated \n667:  * by colon (:), where each element can be a directory or library path.\n668:  * If not set, the \"default\" path is scanned, which is a subdirectory called plugin under the\n669:  * directory where the DALI library is installed.\n670:  */\n671: DLL_PUBLIC void daliLoadDefaultPlugins();\n672: \n673: /**\n674:  * @brief Returns the named reader metadata\n675:  *  @param reader_name Name of the reader to query\n676:  *  @param meta Pointer to meta