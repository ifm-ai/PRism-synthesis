index 0000000000..d209e4a09f
--- /dev/null
+++ b/boards/arm/stm32h7/nucleo-h745zi/src/stm32_usb.c
@@ -0,0 +1,320 @@
+/****************************************************************************
+ * boards/arm/stm32h7/nucleo-h745zi/src/stm32_usb.c
