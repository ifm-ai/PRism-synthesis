REFTOG    = 3,  /* OCxREF toggles when TIMy_CNT=TIMyCCRx */\n873:   STM32_CHANMODE_OCREFLO     = 4,  /* OCxREF is forced low */\n874:   STM32_CHANMODE_OCREFHI     = 5,  /* OCxREF is forced high */\n875:   STM32_CHANMODE_PWM1        = 6,  /* PWM mode 1 */\n876:   STM32_CHANMODE_PWM2        = 7,  /* PWM mode 2 */\n877: #ifdef HAVE_IP_TIMERS_V2\n878:   STM32_CHANMODE_COMBINED1   = 8,  /* Combined PWM mode 1 */\n879:   STM32_CHANMODE_COMBINED2   = 9,  /* Combined PWM mode 2 */\n880:   STM32_CHANMODE_ASYMMETRIC1 = 10, /* Asymmetric PWM mode 1 */\n881:   STM32_CHANMODE_ASYMMETRIC2 = 11, /* Asymmetric PWM mode 2 */\n882: #endif\n883: };\n884: \n885: /* PWM timer channel */\n886: \n887: enum stm32_pwm_chan_e\n888: {\n889:   STM32_PWM_CHAN1  = 1,\n890:   STM32_PWM_CHAN2  = 2,\n891:   STM32_PWM_CHAN3  = 3,\n892:   STM32_PWM_CHAN4  = 4,\n893: #ifdef HAVE_IP_TIMERS_V2\n894:   STM32_PWM_CHAN5  = 5,\n895:   STM32_PWM_CHAN6  = 6,\n896: #endif\n897: };\n898: \n899: /* PWM timer channel output */\n900: \n901: enum stm32_pwm_output_e\n902: {\n903:   STM32_PWM_OUT1  = (1 << 0),\n904:   STM32_PWM_OUT1N = (1 << 1),\n905:   STM32_PWM_OUT2  = (1 << 2),\n906:   STM32_PWM_OUT2N = (1 << 3),\n907:   STM32_PWM_OUT3  = (1 << 4),\n908:   STM32_PWM_OUT3N = (1 << 5),\n909:   STM32_PWM_OUT4  = (1 << 6),\n910: \n911:   /* 1 << 7 reserved - no complementary output for CH4 */\n912: \n913: #ifdef HAVE_IP_TIMERS_V2\n914:   /* Only available inside micro */\n915: \n916:   STM32_PWM_OUT5  = (1 << 8),\n917: \n918:   /* 1 << 9 reserved - no complementary output for CH5 */\n919: \n920:   STM32_PWM_OUT6  = (1 << 10),\n921: \n922:   /* 1 << 11 reserved - no complementary output for CH6 */\n923: #endif\n924: };\n925: \n926: #ifdef CONFIG_STM32H7_PWM_LL_OPS\n927: \n928: /* This structure provides the publicly visible representation of the\n929:  * \"lower-half\" PWM driver structure.\n930:  */\n931: \n932: struct stm32_pwm_dev_s\n933: {\n934:   /* The first field of this state structure must be a pointer to the PWM\n935:    * callback structure to be consistent with upper-half PWM driver.\n936:    */\n937: \n938:   const struct pwm_ops_s *ops;\n939: \n940:   /* Publicly visible portion of the \"lower-half\" PWM driver structure */\n941: \n942:   const struct stm32_pwm_ops_s *llops;\n943: \n944:   /* Require cast-compatibility with private \"lower-half\" PWM structure */\n945: };\n946: \n947: /* Low-level operations for PWM */\n948: \n949: struct pwm_lowerhalf_s;\n950: struct stm32_pwm_ops_s\n951: {\n952:   /* Update CCR register */\n953: \n954:   int (*ccr_update)(struct pwm_lowerhalf_s *dev,\n955:                     uint8_t index, uint32_t ccr);\n956: \n957:   /* Update PWM mode */\n958: \n959:   int (*mode_update)(struct pwm_lowerhalf_s *dev,\n960:                      uint8_t index, uint32_t mode);\n961: \n962:   /* Get CCR register */\n963: \n964:   uint32_t (*ccr_get)(struct pwm_lowerhalf_s *dev, uint8_t index);\n965: \n966:   /* Update ARR register */\n967: \n968:   int (*arr_update)(struct pwm_lowerhalf_s *dev, uint32_t arr);\n969: \n970:   /* Get ARR register */\n971: \n972:   uint32_t (*arr_get)(struct pwm_lowerhalf_s *dev);\n973: \n974:   /* Enable outputs */\n975: \n976:   int (*outputs_enable)(struct pwm_lowerhalf_s *dev, uint16_t outputs,\n977:                         bool state);\n978: \n979:   /* Software update */\n980: \n981:   int (*soft_update)(struct pwm_lowerhalf_s *dev);\n982: \n983:   /* PWM configure */\n984: \n985:   int (*configure)(struct pwm_lowerhalf_s *dev);\n986: \n987:   /* Software break */\n988: \n989:   int (*soft_break)(struct pwm_lowerhalf_s *dev, bool state);\n990: \n991:   /* Update frequency */\n992: \n993:   int (*freq_update)(struct pwm_lowerhalf_s *dev, uint32_t frequency);\n994: \n995:   /* Enable timer counter */\n996: \n997:   int (*tim_enable)(struct pwm_lowerhalf_s *dev, bool state);\n998: \n999: #ifdef CONFIG_DEBUG_PWM_INFO\n1000:   /* Dump timer registers */\n1001: \n1002:   void (*dump_regs)(struct pwm_lowerhalf_s *dev, const char *msg);\n1003: #endif\n1004: \n1005: #ifdef HAVE_PWM_COMPLEMENTARY\n1006:   /* Deadtime update */\n1007: \n1008:   int (*dt_update)(struct pwm_lowerhalf_s *dev, uint8_t dt);\n1009: #endif\n1010: };\n1011: \n1012: #endif /* CONFIG_STM32H7_PWM_LL_OPS */\n1013: \n1014: /****************************************************************************\n1015:  * Public Data\n1016:  ****************************************************************************/\n1017: \n1018: #ifndef __ASSEMBLY__\n1019: \n1020: #undef EXTERN\n1021: #if defined(__cplusplus)\n1022: #define EXTERN extern \"C\"\n1023: extern \"C\"\n1024: {\n1025: #else\n1026: #define EXTERN extern\n1027: #endif\n1028: \n1029: /****************************************************************************\n1030:  * Public Function Prototypes\n1031:  ****************************************************************************/\n1032: \n1033: /****************************************************************************\n1034:  * Name: stm32_pwminitialize\n1035:  *\n1036:  * Description:\n1037:  *   Initialize one timer for use with the upper_level PWM driver.\n1038:  *\n1039:  * Input Parameters:\n1040:  *   timer - A number identifying the timer use.  The number of valid timer\n1041:  *     IDs varies with the STM32 MCU and MCU family but is somewhere in\n1042:  *     the range of {1,..,17}.\n1043:  *\n1044:  * Returned Value:\n1045:  *   On success, a pointer to the STM32 lower half PWM driver is returned.\n1046:  *   NULL is returned on any failure.\n1047:  *\n1048:  ****************************************************************************/\n1049: \n1050: struct pwm_lowerhalf_s *stm32_pwminitialize(int timer);\n1051: \n1052: #undef EXTERN\n1053: #if defined(__cplusplus)\n1054: }\n1055: #endif\n1056: \n1057: #endif /* __ASSEMBLY__ */\n1058: #endif /* CONFIG_STM32H7_PWM */\n1059: #endif /* __ARCH_ARM_SRC_STM32H7_STM32_PWM_H */\n\n(End of file - total 1059 lines)\n</content>",
