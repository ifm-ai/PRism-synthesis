************/\n43: \n44: #define HAVE_PWM 1\n45: \n46: #ifndef CONFIG_PWM\n47: #  undef HAVE_PWM\n48: #endif\n49: \n50: #ifndef CONFIG_STM32H7_TIM1\n51: #  undef HAVE_PWM\n52: #endif\n53: \n54: #ifndef CONFIG_STM32H7_TIM1_PWM\n55: #  undef HAVE_PWM\n56: #endif\n57: \n58: /****************************************************************************\n59:  * Public Functions\n60:  ****************************************************************************/\n61: \n62: /****************************************************************************\n63:  * Name: stm32_pwm_setup\n64:  *\n65:  * Description:\n66:  *   Initialize PWM and register the PWM device.\n67:  *\n68:  ****************************************************************************/\n69: \n70: int stm32_pwm_setup(void)\n71: {\n72: #ifdef HAVE_PWM\n73:   static bool initialized = false;\n74:   struct pwm_lowerhalf_s *pwm;\n75:   int ret;\n76: \n77:   /* Have we already initialized? */\n78: \n79:   if (!initialized)\n80:     {\n81:       /* Get an instance of the PWM interface */\n82: \n83:       pwm = stm32_pwminitialize(NUCLEOH743ZI_PWMTIMER);\n84:       if (!pwm)\n85:         {\n86:           tmrerr(\"ERROR: Failed to get the STM32 PWM lower half\\n\");\n87:           return -ENODEV;\n88:         }\n89: \n90:       /* Register the PWM driver at \"/dev/pwm0\" */\n91: \n92:       ret = pwm_register(\"/dev/pwm0\", pwm);\n93:       if (ret < 0)\n94:         {\n95:           tmrerr(\"ERROR: pwm_register failed: %d\\n\", ret);\n96:           return ret;\n97:         }\n98: \n99:       /* Now we are initialized */\n100: \n101:       initialized = true;\n102:     }\n103: \n104:   return OK;\n105: #else\n106:   return -ENODEV;\n107: #endif\n108: }\n\n(End of file - total 108 lines)\n</content>",
