            "output": "<path>/workspace/boards/arm/stm32h7/nucleo-h743zi/src/stm32_gpio.c</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * boards/arm/stm32h7/nucleo-h743zi/src/stm32_gpio.c\n3:  *\n4:  * Licensed to the Apache Software Foundation (ASF) under one or more\n5:  * contributor license agreements.  See the NOTICE file distributed with\n6:  * this work for additional information regarding copyright ownership.  The\n7:  * ASF licenses this file to you under the Apache License, Version 2.0 (the\n8:  * \"License\"); you may not use this file except in compliance with the\n9:  * License.  You may obtain a copy of the License at\n10:  *\n11:  *   http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n15:  * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n16:  * License for the specific language governing permissions and limitations\n17:  * under the License.\n18:  *\n19:  ****************************************************************************/\n20: \n21: /****************************************************************************\n22:  * Included Files\n23:  ****************************************************************************/\n24: \n25: #include <nuttx/config.h>\n26: \n27: #include <stdbool.h>\n28: #include <assert.h>\n29: #include <debug.h>\n30: \n31: #include <nuttx/clock.h>\n32: #include <nuttx/wdog.h>\n33: #include <nuttx/ioexpander/gpio.h>\n34: \n35: #include <arch/board/board.h>\n36: \n37: #include \"chip.h\"\n38: #include \"stm32_gpio.h\"\n39: #include \"nucleo-h743zi.h\"\n40: \n41: #if defined(CONFIG_DEV_GPIO) && !defined(CONFIG_GPIO_LOWER_HALF)\n42: \n43: /****************************************************************************\n44:  * Private Types\n45:  ****************************************************************************/\n46: \n47: struct stm32gpio_dev_s\n48: {\n49:   struct gpio_dev_s gpio;\n50:   uint8_t id;\n51: };\n52: \n53: struct stm32gpint_dev_s\n54: {\n55:   struct stm32gpio_dev_s stm32gpio;\n56:   pin_interrupt_t callback;\n57: };\n58: \n59: /****************************************************************************\n60:  * Private Function Prototypes\n61:  ****************************************************************************/\n62: \n63: static int gpin_read(struct gpio_dev_s *dev, bool *value);\n64: static int gpout_read(struct gpio_dev_s *dev, bool *value);\n65: static int gpout_write(struct gpio_dev_s *dev, bool value);\n66: static int gpint_read(struct gpio_dev_s *dev, bool *value);\n67: static int gpint_attach(struct gpio_dev_s *dev,\n68:                         pin_interrupt_t callback);\n69: static int gpint_enable(struct gpio_dev_s *dev, bool enable);\n70: \n71: /****************************************************************************\n72:  * Private Data\n73:  ****************************************************************************/\n74: \n75: static const struct gpio_operations_s gpin_ops =\n76: {\n77:   .go_read   = gpin_read,\n78:   .go_write  = NULL,\n79:   .go_attach = NULL,\n80:   .go_enable = NULL,\n81: };\n82: \n83: static const struct gpio_operations_s gpout_ops =\n84: {\n85:   .go_read   = gpout_read,\n86:   .go_write  = gpout_write,\n87:   .go_attach = NULL,\n88:   .go_enable = NULL,\n89: };\n90: \n91: static const struct gpio_operations_s gpint_ops =\n92: {\n93:   .go_read   = gpint_read,\n94:   .go_write  = NULL,\n95:   .go_attach = gpint_attach,\n96:   .go_enable = gpint_enable,\n97: };\n98: \n99: #if BOARD_NGPIOIN > 0\n100: /* This array maps the GPIO pins used as INPUT */\n101: \n102: static const uint32_t g_gpioinputs[BOARD_NGPIOIN] =\n103: {\n104:   GPIO_IN1,\n105: };\n106: \n107: static struct stm32gpio_dev_s g_gpin[BOARD_NGPIOIN];\n108: #endif\n109: \n110: #if BOARD_NGPIOOUT\n111: /* This array maps the GPIO pins used as OUTPUT */\n112: \n113: static const uint32_t g_gpiooutputs[BOARD_NGPIOOUT] =\n114: {\n115:   GPIO_OUT1,\n116: };\n117: \n118: static struct stm32gpio_dev_s g_gpout[BOARD_NGPIOOUT];\n119: #endif\n120: \n121: #if BOARD_NGPIOINT > 0\n122: /* This array maps the GPIO pins used as INTERRUPT INPUTS */\n123: \n124: static const uint32_t g_gpiointinputs[BOARD_NGPIOINT] =\n125: {\n126:   GPIO_INT1,\n127: };\n128: \n129: static struct stm32gpint_dev_s g_gpint[BOARD_NGPIOINT];\n130: #endif\n131: \n132: /****************************************************************************\n133:  * Private Functions\n134:  ****************************************************************************/\n135: \n136: static int stm32gpio_interrupt(int irq, void *context, void *arg)\n137: {\n138:   struct stm32gpint_dev_s *stm32gpint =\n139:     (struct stm32gpint_dev_s *)arg;\n140: \n141:   DEBUGASSERT(stm32gpint != NULL && stm32gpint->callback != NULL);\n142:   gpioinfo(\"Interrupt! callback=%p\\n\", stm32gpint->callback);\n143: \n144:   stm32gpint->callback(&stm32gpint->stm32gpio.gpio,\n145:                        stm32gpint->stm32gpio.id);\n146:   return OK;\n147: }\n148: \n149: static int gpin_read(struct gpio_dev_s *dev, bool *value)\n150: {\n151:   struct stm32gpio_dev_s *stm32gpio =\n152:     (struct stm32gpio_dev_s *)dev;\n153: \n154:   DEBUGASSERT(stm32gpio != NULL && value != NULL);\n155:   DEBUGASSERT(stm32gpio->id < BOARD_NGPIOIN);\n156:   gpioinfo(\"Reading...\\n\");\n157: \n158:   *value = stm32_gpioread(g_gpioinputs[stm32gpio->id]);\n159:   return OK;\n160: }\n161: \n162: static int gpout_read(struct gpio_dev_s *dev, bool *value)\n163: {\n164:   struct stm32gpio_dev_s *stm32gpio =\n165:     (struct stm32gpio_dev_s *)dev;\n166: \n167:   DEBUGASSERT(stm32gpio != NULL && value != NULL);\n168:   DEBUGASSERT(stm32gpio->id < BOARD_NGPIOOUT);\n169:   gpioinfo(\"Reading...\\n\");\n170: \n171:   *value = stm32_gpioread(g_gpiooutputs[stm32gpio->id]);\n172:   return OK;\n173: }\n174: \n175: static int gpout_write(struct gpio_dev_s *dev, bool value)\n176: {\n177:   struct stm32gpio_dev_s *stm32gpio =\n178:     (struct stm32gpio_dev_s *)dev;\n179: \n180:   DEBUGASSERT(stm32gpio != NULL);\n181:   DEBUGASSERT(stm32gpio->id < BOARD_NGPIOOUT);\n182:   gpioinfo(\"Writing %d\\n\", (int)value);\n183: \n184:   stm32_gpiowrite(g_gpiooutputs[stm32gpio->id], value);\n185:   return OK;\n186: }\n187: \n188: static int gpint_read(struct gpio_dev_s *dev, bool *value)\n189: {\n190:   struct stm32gpint_dev_s *stm32gpint =\n191:     (struct stm32gpint_dev_s *)dev;\n192: \n193:   DEBUGASSERT(stm32gpint != NULL && value != NULL);\n194:   DEBUGASSERT(stm32gpint->stm32gpio.id < BOARD_NGPIOINT);\n195:   gpioinfo(\"Reading int pin...\\n\");\n196: \n197:   *value = stm32_gpioread(g_gpiointinputs[stm32gpint->stm32gpio.id]);\n198:   return OK;\n199: }\n200: \n201: static int gpint_attach(struct gpio_dev_s *dev,\n202:                         pin_interrupt_t callback)\n203: {\n204:   struct stm32gpint_dev_s *stm32gpint =\n205:     (struct stm32gpint_dev_s *)dev;\n206: \n207:   gpioinfo(\"Attaching the callback\\n\");\n208: \n209:   /* Make sure the interrupt is disabled */\n210: \n211:   stm32_gpiosetevent(g_gpiointinputs[stm32gpint->stm32gpio.id], false,\n212:                      false, false, NULL, NULL);\n213: \n214:   gpioinfo(\"Attach %p\\n\", callback);\n215:   stm32gpint->callback = callback;\n216:   return OK;\n217: }\n218: \n219: static int gpint_enable(struct gpio_dev_s *dev, bool enable)\n220: {\n221:   struct stm32gpint_dev_s *stm32gpint =\n222:     (struct stm32gpint_dev_s *)dev;\n223: \n224:   if (enable)\n225:     {\n226:       if (stm32gpint->callback != NULL)\n227:         {\n228:           gpioinfo(\"Enabling the interrupt\\n\");\n229: \n230:           /* Configure the interrupt for rising edge */\n231: \n232:           stm32_gpiosetevent(g_gpiointinputs[stm32gpint->stm32gpio.id],\n233:                              true, false, false, stm32gpio_interrupt,\n234:                              &g_gpint[stm32gpint->stm32gpio.id]);\n235:         }\n236:     }\n237:   else\n238:     {\n239:       gpioinfo(\"Disable the interrupt\\n\");\n240:       stm32_gpiosetevent(g_gpiointinputs[stm32gpint->stm32gpio.id],\n241:                          false, false, false, NULL, NULL);\n242:     }\n243: \n244:   return OK;\n245: }\n246: \n247: /****************************************************************************\n248:  * Public Functions\n249:  ****************************************************************************/\n250: \n251: /****************************************************************************\n252:  * Name: stm32_gpio_initialize\n253:  *\n254:  * Description:\n255:  *   Initialize GPIO drivers for use with /apps/examples/gpio\n256:  *\n257:  ****************************************************************************/\n258: \n259: int stm32_gpio_initialize(void)\n260: {\n261:   int i;\n262:   int pincount = 0;\n263: \n264: #if BOARD_NGPIOIN > 0\n265:   for (i = 0; i < BOARD_NGPIOIN; i++)\n266:     {\n267:       /* Setup and register the GPIO pin */\n268: \n269:       g_gpin[i].gpio.gp_pintype = GPIO_INPUT_PIN;\n270:       g_gpin[i].gpio.gp_ops     = &gpin_ops;\n271:       g_gpin[i].id              = i;\n272:       gpio_pin_register(&g_gpin[i].gpio, pincount);\n273: \n274:       /* Configure the pin that will be used as input */\n275: \n276:       stm32_configgpio(g_gpioinputs[i]);\n277: \n278:       pincount++;\n279:     }\n280: #endif\n281: \n282: #if BOARD_NGPIOOUT > 0\n283:   for (i = 0; i < BOARD_NGPIOOUT; i++)\n284:     {\n285:       /* Setup and register the GPIO pin */\n286: \n287:       g_gpout[i].gpio.gp_pintype = GPIO_OUTPUT_PIN;\n288:       g_gpout[i].gpio.gp_ops     = &gpout_ops;\n289:       g_gpout[i].id              = i;\n290:       gpio_pin_register(&g_gpout[i].gpio, pincount);\n291: \n292:       /* Configure the pin that will be used as output */\n293: \n294:       stm32_gpiowrite(g_gpiooutputs[i], 0);\n295:       stm32_configgpio(g_gpiooutputs[i]);\n296: \n297:       pincount++;\n298:     }\n299: #endif\n300: \n301: #if BOARD_NGPIOINT > 0\n302:   for (i = 0; i < BOARD_NGPIOINT; i++)\n303:     {\n304:       /* Setup and register the GPIO pin */\n305: \n306:       g_gpint[i].stm32gpio.gpio.gp_pintype = GPIO_INTERRUPT_PIN;\n307:       g_gpint[i].stm32gpio.gpio.gp_ops     = &gpint_ops;\n308:       g_gpint[i].stm32gpio.id              = i;\n309:       gpio_pin_register(&g_gpint[i].stm32gpio.gpio, pincount);\n310: \n311:       /* Configure the pin that will be used as interrupt input */\n312: \n313:       stm32_configgpio(g_gpiointinputs[i]);\n314: \n315:       pincount++;\n316:     }\n317: #endif\n318: \n319:   return 0;\n320: }\n321: #endif /* CONFIG_DEV_GPIO && !CONFIG_GPIO_LOWER_HALF */\n\n(End of file - total 321 lines)\n</content>",
