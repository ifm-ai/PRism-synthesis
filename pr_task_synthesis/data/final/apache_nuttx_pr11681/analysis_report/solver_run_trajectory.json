            "output": "<path>/workspace/arch/arm/src/stm32h7/stm32_adc.c</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * arch/arm/src/stm32h7/stm32_adc.c\n3:  *\n4:  *   Copyright (C) 2017, 2019 Gregory Nutt. All rights reserved.\n5:  *   Copyright (C) 2015 Motorola Mobility, LLC. All rights reserved.\n6:  *   Copyright (C) 2015 Omni Hoverboards Inc. All rights reserved.\n7:  *   Authors: Gregory Nutt <gnutt@nuttx.org>\n8:  *            Diego Sanchez <dsanchez@nx-engineering.com>\n9:  *            Paul Alexander Patience <paul-a.patience@polymtl.ca>\n10:  *            Mateusz Szafoni <raiden00@railab.me>\n11:  *            Juha Niskanen <juha.niskanen@haltian.com>\n12:  *            David Sidrane <david_s5@nscdg.com>\n13:  *\n14:  * Redistribution and use in source and binary forms, with or without\n15:  * modification, are permitted provided that the following conditions\n16:  * are met:\n17:  *\n18:  * 1. Redistributions of source code must retain the above copyright\n19:  *    notice, this list of conditions and the following disclaimer.\n20:  * 2. Redistributions in binary form must reproduce the above copyright\n21:  *    notice, this list of conditions and the following disclaimer in\n22:  *    the documentation and/or other materials provided with the\n23:  *    distribution.\n24:  * 3. Neither the name NuttX nor the names of its contributors may be\n25:  *    used to endorse or promote products derived from this software\n26:  *    without specific prior written permission.\n27:  *\n28:  * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\n29:  * \"AS IS\" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT\n30:  * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS\n31:  * FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE\n32:  * COPYRIGHT OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT,\n33:  * INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING,\n34:  * BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS\n35:  * OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED\n36:  * AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT\n37:  * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN\n38:  * ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n39:  * POSSIBILITY OF SUCH DAMAGE.\n40:  *\n41:  ****************************************************************************/\n42: \n43: /****************************************************************************\n44:  * Included Files\n45:  ****************************************************************************/\n46: \n47: #include <nuttx/config.h>\n48: \n49: #include <sys/types.h>\n50: #include <sys/ioctl.h>\n51: \n52: #include <errno.h>\n53: #include <assert.h>\n54: #include <debug.h>\n55: #include <string.h>\n56: \n57: #include <arch/board/board.h>\n58: #include <nuttx/irq.h>\n59: #include <nuttx/arch.h>\n60: #include <nuttx/fs/ioctl.h>\n61: #include <nuttx/power/pm.h>\n62: #include <nuttx/analog/adc.h>\n63: #include <nuttx/analog/ioctl.h>\n64: \n65: #include \"chip.h\"\n66: #include \"stm32_rcc.h\"\n67: #include \"stm32_tim.h\"\n68: #include \"stm32_dma.h\"\n69: #include \"stm32_adc.h\"\n70: #include \"stm32_dbgmcu.h\"\n71: \n72: /* ADC \"upper half\" support must be enabled */\n73: \n74: #ifdef CONFIG_ADC\n75: \n76: /* Some ADC peripheral must be enabled */\n77: \n78: #if defined(CONFIG_STM32H7_ADC1) || defined(CONFIG_STM32H7_ADC2) || \\\n79:     defined(CONFIG_STM32H7_ADC3)\n80: \n81: /****************************************************************************\n82:  * Pre-processor Definitions\n83:  ****************************************************************************/\n84: \n85: #ifndef container_of\n86: #  define container_of(ptr, type, member) \\\n87:           ((type *)((intptr_t)(ptr) - offsetof(type, member)))\n88: #endif\n89: \n90: /* ADC Channels/DMA *********************************************************/\n91: \n92: /* The maximum number of channels that can be sampled.  While DMA support is\n93:  * very nice for reliable multi-channel sampling, the STM32H7 can function\n94:  * without, although there is a risk of overrun.\n95:  */\n96: \n97: #define ADC_MAX_CHANNELS_DMA   20\n98: #define ADC_MAX_CHANNELS_NODMA 20\n99: \n100: #ifdef ADC_HAVE_DMA\n101: #  if !defined(CONFIG_STM32H7_DMA1) && !defined(CONFIG_STM32H7_DMA2)\n102: #    /* REVISIT: check accordingly to which one is configured in board.h */\n103: #    error \"STM32H7 ADC DMA support requires CONFIG_STM32H7_DMA1 or CONFIG_STM32H7_DMA2\"\n104: #  endif\n105: #endif\n106: \n107: #ifdef ADC_HAVE_DMA\n108: #  define ADC_MAX_SAMPLES ADC_MAX_CHANNELS_DMA\n109: #else\n110: #  define ADC_MAX_SAMPLES ADC_MAX_CHANNELS_NODMA\n111: #endif\n112: \n113: #define ADC_DMA_CONTROL_WORD (DMA_CCR_MSIZE_16BITS | \\\n114:                               DMA_CCR_PSIZE_16BITS | \\\n115:                               DMA_CCR_MINC | \\\n116:                               DMA_CCR_CIRC)\n117: \n118: /* DMA channels and interface values */\n119: \n120: #define ADC_SMPR_DEFAULT    ADC_SMPR_810p5\n121: #define ADC_SMPR1_DEFAULT   ((ADC_SMPR_DEFAULT << ADC_SMPR1_SMP0_SHIFT) | \\\n122:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP1_SHIFT) | \\\n123:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP2_SHIFT) | \\\n124:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP3_SHIFT) | \\\n125:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP4_SHIFT) | \\\n126:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP5_SHIFT) | \\\n127:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP6_SHIFT) | \\\n128:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP7_SHIFT) | \\\n129:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP8_SHIFT) | \\\n130:                              (ADC_SMPR_DEFAULT << ADC_SMPR1_SMP9_SHIFT))\n131: #define ADC_SMPR2_DEFAULT   ((ADC_SMPR_DEFAULT << ADC_SMPR2_SMP10_SHIFT) | \\\n132:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP11_SHIFT) | \\\n133:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP12_SHIFT) | \\\n134:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP13_SHIFT) | \\\n135:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP14_SHIFT) | \\\n136:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP15_SHIFT) | \\\n137:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP16_SHIFT) | \\\n138:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP17_SHIFT) | \\\n139:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP18_SHIFT) | \\\n140:                              (ADC_SMPR_DEFAULT << ADC_SMPR2_SMP19_SHIFT))\n141: \n142: /* The channels not in this range are internal channels for reading\n143:  * Vbat ADC3:17, VSense (temperature) ADC3:18 and Vrefint ADC3:19\n144:  *\n145:  * N.B. DAC channels on ADC2 are not supported\n146:  */\n147: \n148: #define ADC_EXTERNAL_CHAN_MAX  16\n149: \n150: /****************************************************************************\n151:  * Private Types\n152:  ****************************************************************************/\n153: \n154: /* This structure describes the state of one ADC block */\n155: \n156: struct stm32_dev_s\n157: {\n158:   const struct adc_callback_s *cb;\n159:   uint8_t irq;          /* Interrupt generated by this ADC block */\n160:   uint8_t nchannels;    /* Number of channels */\n161:   uint8_t cchannels;    /* Number of configured channels */\n162:   uint8_t intf;         /* ADC interface number */\n163:   uint8_t current;      /* Current ADC channel being converted */\n164: #ifdef ADC_HAVE_DMA\n165:   uint8_t dmachan;      /* DMA channel needed by this ADC */\n166:   bool    hasdma;       /* True: This ADC supports DMA */\n167: #endif\n168: #ifdef ADC_HAVE_DFSDM\n169:   bool    hasdfsdm;     /* True: This ADC routes its output to DFSDM */\n170: #endif\n171: #ifdef ADC_HAVE_TIMER\n172:   uint8_t trigger;      /* Timer trigger channel: 0=CC1, 1=CC2, 2=CC3,\n173:                          * 3=CC4, 4=TRGO, 5=TRGO2 */\n174: #endif\n175:   xcpt_t   isr;         /* Interrupt handler for this ADC block */\n176:   uint32_t base;        /* Base address of registers unique to this ADC\n177:                          * block */\n178:   uint32_t mbase;       /* Base address of master ADC (allows for access to\n179:                          * shared common registers) */\n180:   bool     initialized; /* Keeps track of the initialization status of the ADC */\n181: #ifdef ADC_HAVE_TIMER\n182:   uint32_t tbase;       /* Base address of timer used by this ADC block */\n183:   uint32_t trcc_enr;    /* RCC ENR Register */\n184:   uint32_t trcc_en;     /* RCC EN Bit in ENR Register */\n185:   uint32_t extsel;      /* EXTSEL value used by this ADC block */\n186:   uint32_t pclck;       /* The PCLK frequency that drives this timer */\n187:   uint32_t freq;        /* The desired frequency of conversions */\n188: #endif\n189: \n190: #ifdef CONFIG_PM\n191:   struct pm_callback_s pm_callback;\n192: #endif\n193: \n194: #ifdef ADC_HAVE_DMA\n195:   DMA_HANDLE dma;       /* Allocated DMA channel */\n196: \n197:   /* DMA transfer buffer */\n198: \n199:   uint16_t dmabuffer[ADC_MAX_SAMPLES];\n200: #endif\n201: \n202:   /* List of selected ADC channels to sample */\n203: \n204:   uint8_t  chanlist[ADC_MAX_SAMPLES];\n205: };\n206: \n207: /****************************************************************************\n208:  * Private Function Prototypes\n209:  ****************************************************************************/\n210: \n211: /* ADC Register access */\n212: \n213: static uint32_t adc_getreg(struct stm32_dev_s *priv, int offset);\n214: static void     adc_putreg(struct stm32_dev_s *priv, int offset,\n215:                            uint32_t value);\n216: static void     adc_modifyreg(struct stm32_dev_s *priv, int offset,\n217:                               uint32_t clrbits, uint32_t setbits);\n218: \n219: #ifdef ADC_HAVE_TIMER\n220: static uint16_t tim_getreg(struct stm32_dev_s *priv, int offset);\n221: static void     tim_putreg(struct stm32_dev_s *priv, int offset,\n222:                            uint16_t value);\n223: static void     tim_modifyreg(struct stm32_dev_s *priv, int offset,\n224:                               uint16_t clrbits, uint16_t setbits);\n225: static void     tim_dumpregs(struct stm32_dev_s *priv,\n226:                              const char *msg);\n227: #endif\n228: \n229: /* ADC Miscellaneous Helpers */\n230: \n231: static void adc_rccreset(struct stm32_dev_s *priv, bool reset);\n232: static void adc_setupclock(struct stm32_dev_s *priv);\n233: static void adc_enable(struct stm32_dev_s *priv);\n234: static uint32_t adc_sqrbits(struct stm32_dev_s *priv, int first,\n235:                             int last, int offset);\n236: static int      adc_set_ch(struct adc_dev_s *dev, uint8_t ch);\n237: static bool     adc_internal(struct stm32_dev_s * priv,\n238:                              uint32_t *adc_ccr);\n239: \n240: #ifdef ADC_HAVE_TIMER\n241: static void adc_timstart(struct stm32_dev_s *priv, bool enable);\n242: static int  adc_timinit(struct stm32_dev_s *priv);\n243: #endif\n244: \n245: #ifdef ADC_HAVE_DMA\n246: static void adc_dmaconvcallback(DMA_HANDLE handle, uint8_t isr,\n247:                                 void *arg);\n248: #endif\n249: \n250: #ifdef ADC_HAVE_DFSDM\n251: static int adc_setoffset(struct stm32_dev_s *priv, uint8_t ch, uint8_t i,\n252:                          uint16_t offset);\n253: #endif\n254: \n255: static void adc_startconv(struct stm32_dev_s *priv, bool enable);\n256: \n257: #ifdef CONFIG_PM\n258: static int adc_pm_prepare(struct pm_callback_s *cb, int domain,\n259:                           enum pm_state_e state);\n260: #endif\n261: \n262: /* ADC Interrupt Handler */\n263: \n264: static int adc_interrupt(struct adc_dev_s *dev, uint32_t regval);\n265: #if defined(CONFIG_STM32H7_ADC1) || defined(CONFIG_STM32H7_ADC2)\n266: static int adc12_interrupt(int irq, void *context, void *arg);\n267: #endif\n268: #if defined(CONFIG_STM32H7_ADC3)\n269: static int adc3_interrupt(int irq, void *context, void *arg);\n270: #endif\n271: \n272: /* ADC Driver Methods */\n273: \n274: static int  adc_bind(struct adc_dev_s *dev,\n275:                      const struct adc_callback_s *callback);\n276: static void adc_reset(struct adc_dev_s *dev);\n277: static int  adc_setup(struct adc_dev_s *dev);\n278: static void adc_shutdown(struct adc_dev_s *dev);\n279: static void adc_rxint(struct adc_dev_s *dev, bool enable);\n280: static int  adc_ioctl(struct adc_dev_s *dev, int cmd, unsigned long arg);\n281: \n282: /****************************************************************************\n283:  * Private Data\n284:  ****************************************************************************/\n285: \n286: /* ADC interface operations */\n287: \n288: static const struct adc_ops_s g_adcops =\n289: {\n290:   .ao_bind        = adc_bind,\n291:   .ao_reset       = adc_reset,\n292:   .ao_setup       = adc_setup,\n293:   .ao_shutdown    = adc_shutdown,\n294:   .ao_rxint       = adc_rxint,\n295:   .ao_ioctl       = adc_ioctl,\n296: };\n297: \n298: /* ADC1 state */\n299: \n300: #ifdef CONFIG_STM32H7_ADC1\n301: static struct stm32_dev_s g_adcpriv1 =\n302: {\n303:   .irq         = STM32_IRQ_ADC12,\n304:   .isr         = adc12_interrupt,\n305:   .intf        = 1,\n306:   .base        = STM32_ADC1_BASE,\n307:   .mbase       = STM32_ADC1_BASE,\n308:   .initialized = false,\n309: #ifdef ADC1_HAVE_TIMER\n310:   .trigger     = CONFIG_STM32H7_ADC1_TIMTRIG,\n311:   .tbase       = ADC1_TIMER_BASE,\n312:   .trcc_enr    = ADC1_TIMER_RCC_ENR,\n313:   .trcc_en     = ADC1_TIMER_RCC_EN,\n314:   .extsel      = ADC1_EXTSEL_VALUE,\n315:   .pclck       = ADC1_TIMER_PCLK_FREQUENCY,\n316:   .freq        = CONFIG_STM32H7_ADC1_SAMPLE_FREQUENCY,\n317: #endif\n318: #ifdef ADC1_HAVE_DMA\n319:   .dmachan     = ADC1_DMA_CHAN,\n320:   .hasdma      = true,\n321: #endif\n322: #ifdef ADC1_HAVE_DFSDM\n323:   .hasdfsdm    = true,\n324: #endif\n325: #ifdef CONFIG_PM\n326:   .pm_callback =\n327:     {\n328:       .prepare = adc_pm_prepare,\n329:     }\n330: #endif\n331: };\n332: \n333: static struct adc_dev_s g_adcdev1 =\n334: {\n335:   .ad_ops      = &g_adcops,\n336:   .ad_priv     = &g_adcpriv1,\n337: };\n338: #endif\n339: \n340: /* ADC2 state */\n341: \n342: #ifdef CONFIG_STM32H7_ADC2\n343: static struct stm32_dev_s g_adcpriv2 =\n344: {\n345:   .irq         = STM32_IRQ_ADC12,\n346:   .isr         = adc12_interrupt,\n347:   .intf        = 2,\n348:   .base        = STM32_ADC2_BASE,\n349:   .mbase       = STM32_ADC1_BASE,\n350:   .initialized = false,\n351: #ifdef ADC2_HAVE_TIMER\n352:   .trigger     = CONFIG_STM32H7_ADC2_TIMTRIG,\n353:   .tbase       = ADC2_TIMER_BASE,\n354:   .trcc_enr    = ADC2_TIMER_RCC_ENR,\n355:   .trcc_en     = ADC2_TIMER_RCC_EN,\n356:   .extsel      = ADC2_EXTSEL_VALUE,\n357:   .pclck       = ADC2_TIMER_PCLK_FREQUENCY,\n358:   .freq        = CONFIG_STM32H7_ADC2_SAMPLE_FREQUENCY,\n359: #endif\n360: #ifdef ADC2_HAVE_DMA\n361:   .dmachan     = ADC2_DMA_CHAN,\n362:   .hasdma      = true,\n363: #endif\n364: #ifdef ADC2_HAVE_DFSDM\n365:   .hasdfsdm    = true,\n366: #endif\n367: #ifdef CONFIG_PM\n368:   .pm_callback =\n369:     {\n370:       .prepare = adc_pm_prepare,\n371:     }\n372: #endif\n373: };\n374: \n375: static struct adc_dev_s g_adcdev2 =\n376: {\n377:   .ad_ops      = &g_adcops,\n378:   .ad_priv     = &g_adcpriv2,\n379: };\n380: #endif\n381: \n382: /* ADC3 state */\n383: \n384: #ifdef CONFIG_STM32H7_ADC3\n385: static struct stm32_dev_s g_adcpriv3 =\n386: {\n387:   .irq         = STM32_IRQ_ADC3,\n388:   .isr         = adc3_interrupt,\n389:   .intf        = 3,\n390:   .base        = STM32_ADC3_BASE,\n391:   .mbase       = STM32_ADC3_BASE,\n392:   .initialized = false,\n393: #ifdef ADC3_HAVE_TIMER\n394:   .trigger     = CONFIG_STM32H7_ADC3_TIMTRIG,\n395:   .tbase       = ADC3_TIMER_BASE,\n396:   .trcc_enr    = ADC3_TIMER_RCC_ENR,\n397:   .trcc_en     = ADC3_TIMER_RCC_EN,\n398:   .extsel      = ADC3_EXTSEL_VALUE,\n399:   .pclck       = ADC3_TIMER_PCLK_FREQUENCY,\n400:   .freq        = CONFIG_STM32H7_ADC3_SAMPLE_FREQUENCY,\n401: #endif\n402: #ifdef ADC3_HAVE_DMA\n403:   .dmachan     = ADC3_DMA_CHAN,\n404:   .hasdma      = true,\n405: #endif\n406: #ifdef ADC3_HAVE_DFSDM\n407:   .hasdfsdm    = true,\n408: #endif\n409: #ifdef CONFIG_PM\n410:   .pm_callback =\n411:     {\n412:       .prepare = adc_pm_prepare,\n413:     }\n414: #endif\n415: };\n416: \n417: static struct adc_dev_s g_adcdev3 =\n418: {\n419:   .ad_ops      = &g_adcops,\n420:   .ad_priv     = &g_adcpriv3,\n421: };\n422: #endif\n423: \n424: /****************************************************************************\n425:  * Private Functions\n426:  ****************************************************************************/\n427: \n428: /****************************************************************************\n429:  * Name: adc_getreg\n430:  *\n431:  * Description:\n432:  *   Read the value of an ADC register.\n433:  *\n434:  * Input Parameters:\n435:  *   priv   - A reference to the ADC block status\n436:  *   offset - The offset to the register to read\n437:  *\n438:  * Returned Value:\n439:  *   The current contents of the specified register\n440:  *\n441:  ****************************************************************************/\n442: \n443: static uint32_t adc_getreg(struct stm32_dev_s *priv, int offset)\n444: {\n445:   return getreg32(priv->base + offset);\n446: }\n447: \n448: /****************************************************************************\n449:  * Name: adc_putreg\n450:  *\n451:  * Description:\n452:  *   Write a value to an ADC register.\n453:  *\n454:  * Input Parameters:\n455:  *   priv   - A reference to the ADC block status\n456:  *   offset - The offset to the register to write to\n457:  *   value  - The value to write to the register\n458:  *\n459:  * Returned Value:\n460:  *   None\n461:  *\n462:  ****************************************************************************/\n463: \n464: static void adc_putreg(struct stm32_dev_s *priv, int offset,\n465:                        uint32_t value)\n466: {\n467:   putreg32(value, priv->base + offset);\n468: }\n469: \n470: /****************************************************************************\n471:  * Name: adc_modifyreg\n472:  *\n473:  * Description:\n474:  *   Modify the value of an ADC register (not atomic).\n475:  *\n476:  * Input Parameters:\n477:  *   priv    - A reference to the ADC block status\n478:  *   offset  - The offset to the register to modify\n479:  *   clrbits - The bits to clear\n480:  *   setbits - The bits to set\n481:  *\n482:  * Returned Value:\n483:  *   None\n484:  *\n485:  ****************************************************************************/\n486: \n487: static void adc_modifyreg(struct stm32_dev_s *priv, int offset,\n488:                           uint32_t clrbits, uint32_t setbits)\n489: {\n490:   adc_putreg(priv, offset, (adc_getreg(priv, offset) & ~clrbits) | setbits);\n491: }\n492: \n493: /****************************************************************************\n494:  * Name: adc_getregm\n495:  *\n496:  * Description:\n497:  *   Read the value of an ADC register from the associated ADC master.\n498:  *\n499:  * Input Parameters:\n500:  *   priv   - A reference to the ADC block status\n501:  *   offset - The offset to the register to read\n502:  *\n503:  * Returned Value:\n504:  *   The current contents of the specified register in the ADC master.\n505:  *\n506:  ****************************************************************************/\n507: \n508: static uint32_t adc_getregm(struct stm32_dev_s *priv, int offset)\n509: {\n510:   return getreg32(priv->mbase + offset);\n511: }\n512: \n513: /****************************************************************************\n514:  * Name: adc_putregm\n515:  *\n516:  * Description:\n517:  *   Write a value to an ADC register in the associated ADC master.\n518:  *\n519:  * Input Parameters:\n520:  *   priv   - A reference to the ADC block status\n521:  *   offset - The offset to the register to write to\n522:  *   value  - The value to write to the register\n523:  *\n524:  * Returned Value:\n525:  *   None\n526:  *\n527:  ****************************************************************************/\n528: \n529: static void adc_putregm(struct stm32_dev_s *priv, int offset,\n530:                         uint32_t value)\n531: {\n532:   putreg32(value, priv->mbase + offset);\n533: }\n534: \n535: /****************************************************************************\n536:  * Name: adc_modifyregm\n537:  *\n538:  * Description:\n539:  *   Modify the value of an ADC register in the associated ADC master\n540:  *  (not atomic).\n541:  *\n542:  * Input Parameters:\n543:  *   priv    - A reference to the ADC block status\n544:  *   offset  - The offset to the register to modify\n545:  *   clrbits - The bits to clear\n546:  *   setbits - The bits to set\n547:  *\n548:  * Returned Value:\n549:  *   None\n550:  *\n551:  ****************************************************************************/\n552: \n553: static void adc_modifyregm(struct stm32_dev_s *priv, int offset,\n554:                            uint32_t clrbits, uint32_t setbits)\n555: {\n556:   adc_putregm(priv, offset,\n557:               (adc_getregm(priv, offset) & ~clrbits) | setbits);\n558: }\n559: \n560: /****************************************************************************\n561:  * Name: tim_getreg\n562:  *\n563:  * Description:\n564:  *   Read the value of an ADC timer register.\n565:  *\n566:  * Input Parameters:\n567:  *   priv   - A reference to the ADC block status\n568:  *   offset - The offset to the register to read\n569:  *\n570:  * Returned Value:\n571:  *   The current contents of the specified register\n572:  *\n573:  ****************************************************************************/\n574: \n575: #ifdef ADC_HAVE_TIMER\n576: static uint16_t tim_getreg(struct stm32_dev_s *priv, int offset)\n577: {\n578:   return getreg16(priv->tbase + offset);\n579: }\n580: #endif\n581: \n582: /****************************************************************************\n583:  * Name: tim_putreg\n584:  *\n585:  * Description:\n586:  *   Write a value to an ADC timer register.\n587:  *\n588:  * Input Parameters:\n589:  *   priv   - A reference to the ADC block status\n590:  *   offset - The offset to the register to write to\n591:  *   value  - The value to write to the register\n592:  *\n593:  * Returned Value:\n594:  *   None\n595:  *\n596:  ****************************************************************************/\n597: \n598: #ifdef ADC_HAVE_TIMER\n599: static void tim_putreg(struct stm32_dev_s *priv, int offset,\n600:                        uint16_t value)\n601: {\n602:   putreg16(value, priv->tbase + offset);\n603: }\n604: #endif\n605: \n606: /****************************************************************************\n607:  * Name: tim_modifyreg\n608:  *\n609:  * Description:\n610:  *   Modify the value of an ADC timer register (not atomic).\n611:  *\n612:  * Input Parameters:\n613:  *   priv    - A reference to the ADC block status\n614:  *   offset  - The offset to the register to modify\n615:  *   clrbits - The bits to clear\n616:  *   setbits - The bits to set\n617:  *\n618:  * Returned Value:\n619:  *   None\n620:  *\n621:  ****************************************************************************/\n622: \n623: #ifdef ADC_HAVE_TIMER\n624: static void tim_modifyreg(struct stm32_dev_s *priv, int offset,\n625:                           uint16_t clrbits, uint16_t setbits)\n626: {\n627:   tim_putreg(priv, offset, (tim_getreg(priv, offset) & ~clrbits) | setbits);\n628: }\n629: #endif\n630: \n631: /****************************************************************************\n632:  * Name: tim_dumpregs\n633:  *\n634:  * Description:\n635:  *   Dump all timer registers.\n636:  *\n637:  * Input Parameters:\n638:  *   priv - A reference to the ADC block status\n639:  *\n640:  * Returned Value:\n641:  *   None\n642:  *\n643:  ****************************************************************************/\n644: \n645: #ifdef ADC_HAVE_TIMER\n646: static void tim_dumpregs(struct stm32_dev_s *priv, const char *msg)\n647: {\n648:   ainfo(\"%s:\\n\", msg);\n649:   ainfo(\"  CR1: %04x CR2:  %04x SMCR:  %04x DIER:  %04x\\n\",\n650:         tim_getreg(priv, STM32_GTIM_CR1_OFFSET),\n651:         tim_getreg(priv, STM32_GTIM_CR2_OFFSET),\n652:         tim_getreg(priv, STM32_GTIM_SMCR_OFFSET),\n653:         tim_getreg(priv, STM32_GTIM_DIER_OFFSET));\n654:   ainfo(\"   SR: %04x EGR:  0000 CCMR1: %04x CCMR2: %04x\\n\",\n655:         tim_getreg(priv, STM32_GTIM_SR_OFFSET),\n656:         tim_getreg(priv, STM32_GTIM_CCMR1_OFFSET),\n657:         tim_getreg(priv, STM32_GTIM_CCMR2_OFFSET));\n658:   ainfo(\" CCER: %04x CNT:  %04x PSC:   %04x ARR:   %04x\\n\",\n659:         tim_getreg(priv, STM32_GTIM_CCER_OFFSET),\n660:         tim_getreg(priv, STM32_GTIM_CNT_OFFSET),\n661:         tim_getreg(priv, STM32_GTIM_PSC_OFFSET),\n662:         tim_getreg(priv, STM32_GTIM_ARR_OFFSET));\n663:   ainfo(\" CCR1: %04x CCR2: %04x CCR3:  %04x CCR4:  %04x\\n\",\n664:         tim_getreg(priv, STM32_GTIM_CCR1_OFFSET),\n665:         tim_getreg(priv, STM32_GTIM_CCR2_OFFSET),\n666:         tim_getreg(priv, STM32_GTIM_CCR3_OFFSET),\n667:         tim_getreg(priv, STM32_GTIM_CCR4_OFFSET));\n668: \n669:   if (priv->tbase == STM32_TIM1_BASE || priv->tbase == STM32_TIM8_BASE)\n670:     {\n671:       ainfo(\"  RCR: %04x BDTR: %04x DCR:   %04x DMAR:  %04x\\n\",\n672:             tim_getreg(priv, STM32_ATIM_RCR_OFFSET),\n673:             tim_getreg(priv, STM32_ATIM_BDTR_OFFSET),\n674:             tim_getreg(priv, STM32_ATIM_DCR_OFFSET),\n675:             tim_getreg(priv, STM32_ATIM_DMAR_OFFSET));\n676:     }\n677:   else\n678:     {\n679:       ainfo(\"  DCR: %04x DMAR: %04x\\n\",\n680:             tim_getreg(priv, STM32_GTIM_DCR_OFFSET),\n681:             tim_getreg(priv, STM32_GTIM_DMAR_OFFSET));\n682:     }\n683: }\n684: #endif\n685: \n686: /****************************************************************************\n687:  * Name: adc_timstart\n688:  *\n689:  * Description:\n690:  *   Start (or stop) the timer counter\n691:  *\n692:  * Input Parameters:\n693:  *   priv - A reference to the ADC block status\n694:  *   enable - True: Start conversion\n695:  *\n696:  * Returned Value:\n697:  *\n698:  ****************************************************************************/\n699: \n700: #ifdef ADC_HAVE_TIMER\n701: static void adc_timstart(struct stm32_dev_s *priv, bool enable)\n702: {\n703:   ainfo(\"enable: %d\\n\", enable ? 1 : 0);\n704: \n705:   if (enable)\n706:     {\n707:       /* Start the counter */\n708: \n709:       tim_modifyreg(priv, STM32_GTIM_CR1_OFFSET, 0, GTIM_CR1_CEN);\n710:     }\n711:   else\n712:     {\n713:       /* Disable the counter */\n714: \n715:       tim_modifyreg(priv, STM32_GTIM_CR1_OFFSET, GTIM_CR1_CEN, 0);\n716:     }\n717: }\n718: #endif\n719: \n720: /****************************************************************************\n721:  * Name: adc_timinit\n722:  *\n723:  * Description:\n724:  *   Initialize the timer that drivers the ADC sampling for this channel\n725:  *   using the pre-calculated timer divider definitions.\n726:  *\n727:  * Input Parameters:\n728:  *   priv - A reference to the ADC block status\n729:  *\n730:  * Returned Value:\n731:  *   Zero on success; a negated errno value on failure.\n732:  *\n733:  ****************************************************************************/\n734: \n735: #ifdef ADC_HAVE_TIMER\n736: static int adc_timinit(struct stm32_dev_s *priv)\n737: {\n738:   uint32_t prescaler;\n739:   uint32_t reload;\n740:   uint32_t timclk;\n741: \n742:   uint16_t clrbits = 0;\n743:   uint16_t setbits = 0;\n744:   uint16_t cr2;\n745:   uint16_t ccmr1;\n746:   uint16_t ccmr2;\n747:   uint16_t ocmode1;\n748:   uint16_t ocmode2;\n749:   uint16_t ccenable;\n750:   uint16_t ccer;\n751:   uint16_t egr;\n752: \n753:   /* If the timer base address is zero, then this ADC was not configured to\n754:    * use a timer.\n755:    */\n756: \n757:   if (priv->tbase == 0)\n758:     {\n759:       return ERROR;\n760:     }\n761: \n762:   /* EXTSEL selection: These bits select the external event used to trigger\n763:    * the start of conversion of a regular group.  NOTE:\n764:    *\n765:    * - The position with of the EXTSEL field varies from one STM32 MCU\n766:    *   to another.\n767:    * - The width of the EXTSEL field varies from one STM32 MCU to another.\n768:    * - The value in priv->extsel is already shifted into the correct bit\n769:    *   position.\n770:    */\n771: \n772:   ainfo(\"Initializing timers extsel = 0x%08\" PRIx32 \"\\n\", priv->extsel);\n773: \n774:   adc_modifyreg(priv, STM32_ADC_CFGR_OFFSET,\n775:                 ADC_CFGR_EXTEN_MASK | ADC_CFGR_EXTSEL_MASK,\n776:                 ADC_CFGR_EXTEN_RISING | priv->extsel);\n777: \n778:   /* Configure the timer channel to drive the ADC */\n779: \n780:   /* Enable Timer clocking */\n781: \n782:   modifyreg32(priv->trcc_enr, 0, priv->trcc_en);\n783: \n784:   /* Calculate optimal values for the timer prescaler and for the timer\n785:    * reload register.  If freq is the desired frequency, then\n786:    *\n787:    *   reload = timclk / freq\n788:    *   reload = (pclck / prescaler) / freq\n789:    *\n790:    * There are many solutions to do this, but the best solution will be the\n791:    * one that has the largest reload value and the smallest prescaler value.\n792:    * That is the solution that should give us the most accuracy in the timer\n793:    * control.  Subject to:\n794:    *\n795:    *   0 <= prescaler  <= 65536\n796:    *   1 <= reload <= 65535\n797:    *\n798:    * So ( prescaler = pclck / 65535 / freq ) would be optimal.\n799:    */\n800: \n801:   prescaler = (priv->pclck / priv->freq + 65534) / 65535;\n802: \n803:   /* We need to decrement the prescaler value by one, but only, the value\n804:    * does not underflow.\n805:    */\n806: \n807:   if (prescaler < 1)\n808:     {\n809:       awarn(\"WARNING: Prescaler underflowed.\\n\");\n810:       prescaler = 1;\n811:     }\n812: \n813:   /* Check for overflow */\n814: \n815:   else if (prescaler > 65536)\n816:     {\n817:       awarn(\"WARNING: Prescaler overflowed.\\n\");\n818:       prescaler = 65536;\n819:     }\n820: \n821:   timclk = priv->pclck / prescaler;\n822: \n823:   reload = timclk / priv->freq;\n824:   if (reload < 1)\n825:     {\n826:       awarn(\"WARNING: Reload value underflowed.\\n\");\n827:       reload = 1;\n828:     }\n829: \n830:   else if (reload > 65535)\n831:     {\n832:       awarn(\"WARNING: Reload value overflowed.\\n\");\n833:       reload = 65535;\n834:     }\n835: \n836:   /* Disable the timer until we get it configured */\n837: \n838:   adc_timstart(priv, false);\n839: \n840:   /* Set up the timer CR1 register.\n841:    *\n842:    * Select the Counter Mode == count up:\n843:    *\n844:    * ATIM_CR1_EDGE: The counter counts up or down depending on the\n845:    *                direction bit(DIR).\n846:    * ATIM_CR1_DIR: 0: count up, 1: count down\n847:    *\n848:    * Set the clock division to zero for all\n849:    */\n850: \n851:   clrbits = GTIM_CR1_DIR | GTIM_CR1_CMS_MASK | GTIM_CR1_CKD_MASK;\n852:   setbits = GTIM_CR1_EDGE;\n853:   tim_modifyreg(priv, STM32_GTIM_CR1_OFFSET, clrbits, setbits);\n854: \n855:   /* Set the reload and prescaler values */\n856: \n857:   tim_putreg(priv, STM32_GTIM_PSC_OFFSET, prescaler - 1);\n858:   tim_putreg(priv, STM32_GTIM_ARR_OFFSET, reload);\n859: \n860:   /* Clear the advanced timers repetition counter in TIM1 */\n861: \n862:   if (priv->tbase == STM32_TIM1_BASE || priv->tbase == STM32_TIM8_BASE)\n863:     {\n864:       tim_putreg(priv, STM32_ATIM_RCR_OFFSET, 0);\n865:       tim_putreg(priv, STM32_ATIM_BDTR_OFFSET, ATIM_BDTR_MOE); /* Check me */\n866:     }\n867: \n868:   /* TIMx event generation: Bit 0 UG: Update generation */\n869: \n870:   tim_putreg(priv, STM32_GTIM_EGR_OFFSET, GTIM_EGR_UG);\n871: \n872:   /* Handle channel specific setup */\n873: \n874:   ocmode1 = 0;\n875:   ocmode2 = 0;\n876: \n877:   switch (priv->trigger)\n878:     {\n879:       case 0: /* TimerX CC1 event */\n880:         {\n881:           ccenable = ATIM_CCER_CC1E;\n882:           ocmode1  = (ATIM_CCMR_CCS_CCOUT << ATIM_CCMR1_CC1S_SHIFT) |\n883:                      (ATIM_CCMR_MODE_PWM1 << ATIM_CCMR1_OC1M_SHIFT) |\n884:                      ATIM_CCMR1_OC1PE;\n885: \n886:           /* Set the event CC1 */\n887: \n888:           egr      = ATIM_EGR_CC1G;\n889: \n890:           /* Set the duty cycle by writing to the CCR register for this\n891:            * channel\n892:            */\n893: \n894:           tim_putreg(priv, STM32_GTIM_CCR1_OFFSET, (uint16_t)(reload >> 1));\n895:         }\n896:         break;\n897: \n898:       case 1: /* TimerX CC2 event */\n899:         {\n900:           ccenable = ATIM_CCER_CC2E;\n901:           ocmode1  = (ATIM_CCMR_CCS_CCOUT << ATIM_CCMR1_CC2S_SHIFT) |\n902:                      (ATIM_CCMR_MODE_PWM1 << ATIM_CCMR1_OC2M_SHIFT) |\n903:                      ATIM_CCMR1_OC2PE;\n904: \n905:           /* Set the event CC2 */\n906: \n907:           egr      = ATIM_EGR_CC2G;\n908: \n909:           /* Set the duty cycle by writing to the CCR register for this\n910:            * channel\n911:            */\n912: \n913:           tim_putreg(priv, STM32_GTIM_CCR2_OFFSET, (uint16_t)(reload >> 1));\n914:         }\n915:         break;\n916: \n917:       case 2: /* TimerX CC3 event */\n918:         {\n919:           ccenable = ATIM_CCER_CC3E;\n920:           ocmode2  = (ATIM_CCMR_CCS_CCOUT << ATIM_CCMR2_CC3S_SHIFT) |\n921:                      (ATIM_CCMR_MODE_PWM1 << ATIM_CCMR2_OC3M_SHIFT) |\n922:                      ATIM_CCMR2_OC3PE;\n923: \n924:           /* Set the event CC3 */\n925: \n926:           egr      = ATIM_EGR_CC3G;\n927: \n928:           /* Set the duty cycle by writing to the CCR register for this\n929:            * channel\n930:            */\n931: \n932:           tim_putreg(priv, STM32_GTIM_CCR3_OFFSET, (uint16_t)(reload >> 1));\n933:         }\n934:         break;\n935: \n936:       case 3: /* TimerX CC4 event */\n937:         {\n938:           ccenable = ATIM_CCER_CC4E;\n939:           ocmode2  = (ATIM_CCMR_CCS_CCOUT << ATIM_CCMR2_CC4S_SHIFT) |\n940:                      (ATIM_CCMR_MODE_PWM1 << ATIM_CCMR2_OC4M_SHIFT) |\n941:                      ATIM_CCMR2_OC4PE;\n942: \n943:           /* Set the event CC4 */\n944: \n945:           egr      = ATIM_EGR_CC4G;\n946: \n947:           /* Set the duty cycle by writing to the CCR register for this\n948:            * channel\n949:            */\n950: \n951:           tim_putreg(priv, STM32_GTIM_CCR4_OFFSET, (uint16_t)(reload >> 1));\n952:         }\n953:         break;\n954: \n955:       case 4: /* TimerX TRGO event */\n956:         {\n957:           /* TODO: TRGO support not yet implemented */\n958: \n959:           /* Set the event TRGO */\n960: \n961:           ccenable = 0;\n962:           egr      = GTIM_EGR_TG;\n963: \n964:           /* Set the duty cycle by writing to the CCR register for this\n965:            * channel\n966:            */\n967: \n968:           tim_putreg(priv, STM32_GTIM_CCR4_OFFSET, (uint16_t)(reload >> 1));\n969:         }\n970:         break;\n971: \n972:       default:\n973:         aerr(\"ERROR: No such trigger: %d\\n\", priv->trigger);\n974:         return -EINVAL;\n975:     }\n976: \n977:   /* Disable the Channel by resetting the CCxE Bit in the CCER register */\n978: \n979:   ccer = tim_getreg(priv, STM32_GTIM_CCER_OFFSET);\n980:   ccer &= ~ccenable;\n981:   tim_putreg(priv, STM32_GTIM_CCER_OFFSET, ccer);\n982: \n983:   /* Fetch the CR2, CCMR1, and CCMR2 register (already have ccer) */\n984: \n985:   cr2   = tim_getreg(priv, STM32_GTIM_CR2_OFFSET);\n986:   ccmr1 = tim_getreg(priv, STM32_GTIM_CCMR1_OFFSET);\n987:   ccmr2 = tim_getreg(priv, STM32_GTIM_CCMR2_OFFSET);\n988: \n989:   /* Reset the Output Compare Mode Bits and set the select output compare\n990:    * mode\n991:    */\n992: \n993:   ccmr1 &= ~(ATIM_CCMR1_CC1S_MASK | ATIM_CCMR1_OC1M_MASK | ATIM_CCMR1_OC1PE |\n994:              ATIM_CCMR1_CC2S_MASK | ATIM_CCMR1_OC2M_MASK | ATIM_CCMR1_OC2PE);\n995:   ccmr2 &= ~(ATIM_CCMR2_CC3S_MASK | ATIM_CCMR2_OC3M_MASK | ATIM_CCMR2_OC3PE |\n996:              ATIM_CCMR2_CC4S_MASK | ATIM_CCMR2_OC4M_MASK | ATIM_CCMR2_OC4PE);\n997:   ccmr1 |= ocmode1;\n998:   ccmr2 |= ocmode2;\n999: \n1000:   /* Reset the output polarity level of all channels (selects high\n1001:    * polarity)\n1002:    */\n1003: \n1004:   ccer &= ~(ATIM_CCER_CC1P | ATIM_CCER_CC2P |\n1005:             ATIM_CCER_CC3P | ATIM_CCER_CC4P);\n1006: \n1007:   /* Enable the output state of the selected channel (only) */\n1008: \n1009:   ccer &= ~(ATIM_CCER_CC1E | ATIM_CCER_CC2E |\n1010:             ATIM_CCER_CC3E | ATIM_CCER_CC4E);\n1011:   ccer |= ccenable;\n1012: \n1013:   if (priv->tbase == STM32_TIM1_BASE || priv->tbase == STM32_TIM8_BASE)\n1014:     {\n1015:       /* Reset output N polarity level, output N state, output compare state,\n1016:        * output compare N idle state.\n1017:        */\n1018: \n1019:       ccer &= ~(ATIM_CCER_CC1NE | ATIM_CCER_CC1NP |\n1020:                 ATIM_CCER_CC2NE | ATIM_CCER_CC2NP |\n1021:                 ATIM_CCER_CC3NE | ATIM_CCER_CC3NP |\n1022:                 ATIM_CCER_CC4NP);\n1023: \n1024:       /* Reset the output compare and output compare N IDLE State */\n1025: \n1026:       cr2 &= ~(ATIM_CR2_OIS1 | ATIM_CR2_OIS1N |\n1027:                ATIM_CR2_OIS2 | ATIM_CR2_OIS2N |\n1028:                ATIM_CR2_OIS3 | ATIM_CR2_OIS3N |\n1029:                ATIM_CR2_OIS4);\n1030:     }\n1031:   else\n1032:     {\n1033:       ccer &= ~(GTIM_CCER_CC1NP | GTIM_CCER_CC2NP | GTIM_CCER_CC3NP);\n1034:     }\n1035: \n1036:   /* Save the modified register values */\n1037: \n1038:   tim_putreg(priv, STM32_GTIM_CR2_OFFSET, cr2);\n1039:   tim_putreg(priv, STM32_GTIM_CCMR1_OFFSET, ccmr1);\n1040:   tim_putreg(priv, STM32_GTIM_CCMR2_OFFSET, ccmr2);\n1041:   tim_putreg(priv, STM32_GTIM_CCER_OFFSET, ccer);\n1042:   tim_putreg(priv, STM32_GTIM_EGR_OFFSET, egr);\n1043: \n1044:   /* Set the ARR Preload Bit */\n1045: \n1046:   tim_modifyreg(priv, STM32_GTIM_CR1_OFFSET, 0, GTIM_CR1_ARPE);\n1047: \n1048:   /* Enable the timer counter */\n1049: \n1050:   adc_timstart(priv, true);\n1051: \n1052:   tim_dumpregs(priv, \"After starting timers\");\n1053: \n1054:   return OK;\n1055: }\n1056: #endif\n1057: \n1058: /****************************************************************************\n1059:  * Name: adc_pm_prepare\n1060:  *\n1061:  * Description:\n1062:  *   Called by power management framework when it wants to enter low power\n1063:  *   states. Check if ADC is in progress and if so prevent from entering\n1064:  *   STOP.\n1065:  *\n1066:  ****************************************************************************/\n1067: \n1068: #ifdef CONFIG_PM\n1069: static int adc_pm_prepare(struct pm_callback_s *cb, int domain,\n1070:                           enum pm_state_e state)\n1071: {\n1072:   struct stm32_dev_s *priv =\n1073:       container_of(cb, struct stm32_dev_s, pm_callback);\n1074:   uint32_t regval;\n1075: \n1076:   regval = adc_getreg(priv, STM32_ADC_CR_OFFSET);\n1077:   if ((state >= PM_IDLE) && (regval & ADC_CR_ADSTART))\n1078:     {\n1079:       return -EBUSY;\n1080:     }\n1081: \n1082:   return OK;\n1083: }\n1084: #endif\n1085: \n1086: /****************************************************************************\n1087:  * Name: adc_wdog_enable\n1088:  *\n1089:  * Description:\n1090:  *   Enable the analog watchdog.\n1091:  *\n1092:  ****************************************************************************/\n1093: \n1094: static void adc_wdog_enable(struct stm32_dev_s *priv)\n1095: {\n1096:   uint32_t regval;\n1097: \n1098:   /* Initialize the Analog watchdog enable */\n1099: \n1100:   regval  = adc_getreg(priv, STM32_ADC_CFGR_OFFSET);\n1101:   regval |= ADC_CFGR_AWD1EN | ADC_CFGR_CONT | ADC_CFGR_OVRMOD;\n1102:   adc_putreg(priv, STM32_ADC_CFGR_OFFSET, regval);\n1103: \n1104:   /* Switch to analog watchdog interrupt */\n1105: \n1106:   regval = adc_getreg(priv, STM32_ADC_IER_OFFSET);\n1107:   regval |= ADC_INT_AWD1;\n1108:   regval &= ~ADC_INT_EOC;\n1109:   adc_putreg(priv, STM32_ADC_IER_OFFSET, regval);\n1110: }\n1111: \n1112: /****************************************************************************\n1113:  * Name: adc_startconv\n1114:  *\n1115:  * Description:\n1116:  *   Start (or stop) the ADC conversion process\n1117:  *\n1118:  * Input Parameters:\n1119:  *   priv - A reference to the ADC block status\n1120:  *   enable - True: Start conversion\n1121:  *\n1122:  * Returned Value:\n1123:  *\n1124:  ****************************************************************************/\n1125: \n1126: static void adc_startconv(struct stm32_dev_s *priv, bool enable)\n1127: {\n1128:   uint32_t regval;\n1129: \n1130:   ainfo(\"enable: %d\\n\", enable ? 1 : 0);\n1131: \n1132:   regval = adc_getreg(priv, STM32_ADC_CR_OFFSET);\n1133:   if (enable)\n1134:     {\n1135:       /* Start conversion of regular channels */\n1136: \n1137:       regval |= ADC_CR_ADSTART;\n1138:     }\n1139:   else\n1140:     {\n1141:       /* Disable the conversion of regular channels */\n1142: \n1143:       regval |= ADC_CR_ADSTP;\n1144:     }\n1145: \n1146:   adc_putreg(priv, STM32_ADC_CR_OFFSET, regval);\n1147: }\n1148: \n1149: /****************************************************************************\n1150:  * Name: adc_rccreset\n1151:  *\n1152:  * Description:\n1153:  *   Deinitializes the ADCx peripheral registers to their default\n1154:  *   reset values. It could set all the ADCs configured.\n1155:  *\n1156:  * Input Parameters:\n1157:  *   priv - A reference to the ADC block status\n1158:  *   reset - Condition, set or reset\n1159:  *\n1160:  * Returned Value:\n1161:  *\n1162:  ****************************************************************************/\n1163: \n1164: static void adc_rccreset(struct stm32_dev_s *priv, bool reset)\n1165: {\n1166:   irqstate_t flags;\n1167:   uint32_t regval;\n1168:   uint32_t reg = STM32_RCC_AHB4RSTR;\n1169:   uint32_t bit = RCC_AHB4RSTR_ADC3RST;\n1170: \n1171:   /* Pick the appropriate bit in the AHBx reset register. */\n1172: \n1173:   if (priv->intf != 3)\n1174:     {\n1175:       reg = STM32_RCC_AHB1RSTR;\n1176:       bit = RCC_AHB1RSTR_ADC12RST;\n1177:     }\n1178: \n1179:   /* First must disable interrupts because the AHB2RSTR register is used by\n1180:    * several different drivers.\n1181:    */\n1182: \n1183:   flags = enter_critical_section();\n1184: \n1185:   /* Set or clear the selected bit in the AHB2 reset register */\n1186: \n1187:   regval = getreg32(reg);\n1188:   if (reset)\n1189:     {\n1190:       regval |= bit;\n1191:     }\n1192:   else\n1193:     {\n1194:       regval &= ~bit;\n1195:     }\n1196: \n1197:   putreg32(regval, reg);\n1198:   leave_critical_section(flags);\n1199: }\n1200: \n1201: /****************************************************************************\n1202:  * Name: adc_enable\n1203:  *\n1204:  * Description:\n1205:  *   Enables the specified ADC peripheral.\n1206:  *\n1207:  * Input Parameters:\n1208:  *   priv - A reference to the ADC block status\n1209:  *\n1210:  * Returned Value:\n1211:  *\n1212:  ****************************************************************************/\n1213: \n1214: static void adc_enable(struct stm32_dev_s *priv)\n1215: {\n1216:   uint32_t regval;\n1217: \n1218:   regval = adc_getreg(priv, STM32_ADC_CR_OFFSET);\n1219: \n1220:   /* Exit deep power down mode and enable voltage regulator */\n1221: \n1222:   regval &= ~ADC_CR_DEEPPWD;\n1223:   regval |= ADC_CR_ADVREGEN;\n1224:   adc_putreg(priv, STM32_ADC_CR_OFFSET, regval);\n1225: \n1226:   /* Wait for voltage regulator to power up */\n1227: \n1228:   up_udelay(20);\n1229: \n1230:   /* Enable ADC calibration. ADCALDIF == 0 so this is only for\n1231:    * single-ended conversions, not for differential ones.\n1232:    */\n1233: \n1234:   regval |= ADC_CR_ADCAL;\n1235:   adc_putreg(priv, STM32_ADC_CR_OFFSET, regval);\n1236: \n1237:   /* Wait for calibration to complete */\n1238: \n1239:   while (adc_getreg(priv, STM32_ADC_CR_OFFSET) & ADC_CR_ADCAL);\n1240: \n1241:   /* Enable ADC\n1242:    * Note: ADEN bit cannot be set during ADCAL=1 and 4 ADC clock cycle\n1243:    * after the ADCAL bit is cleared by hardware. If we are using SYSCLK\n1244:    * as ADC clock source, this is the same as time taken to execute 4\n1245:    * ARM instructions.\n1246:    */\n1247: \n1248:   regval  = adc_getreg(priv, STM32_ADC_CR_OFFSET);\n1249:   regval |= ADC_CR_ADEN;\n1250:   adc_putreg(priv, STM32_ADC_CR_OFFSET, regval);\n1251: \n1252:   /* Wait for hardware to be ready for conversions */\n1253: \n1254:   while (!(adc_getreg(priv, STM32_ADC_ISR_OFFSET) & ADC_INT_ADRDY));\n1255: }\n1256: \n1257: /****************************************************************************\n1258:  * Name: adc_bind\n1259:  *\n1260:  * Description:\n1261:  *   Bind the upper-half driver callbacks to the lower-half implementation.\n1262:  *   This must be called early in order to receive ADC event notifications.\n1263:  *\n1264:  ****************************************************************************/\n1265: \n1266: static int adc_bind(struct adc_dev_s *dev,\n1267:                     const struct adc_callback_s *callback)\n1268: {\n1269:   struct stm32_dev_s *priv = (struct stm32_dev_s *)dev->ad_priv;\n1270: \n1271:   DEBUGASSERT(priv != NULL);\n1272:   priv->cb = callback;\n1273:   return OK;\n1274: }\n1275: \n1276: /****************************************************************************\n1277:  * Name: adc_reset\n1278:  *\n1279:  * Description:\n1280:  *   Reset the ADC device.  Called early to initialize the hardware. This\n1281:  *   is called, before adc_setup() and on error conditions.\n1282:  *\n1283:  * Input Parameters:\n1284:  *\n1285:  * Returned Value:\n1286:  *\n1287:  ****************************************************************************/\n1288: \n1289: static void adc_reset(struct adc_dev_s *dev)\n1290: {\n1291:   struct stm32_dev_s *priv = (struct stm32_dev_s *)dev->ad_priv;\n1292: \n1293:   ainfo(\"intf: ADC%d\\n\", priv->intf);\n1294: \n1295:   /* Enable ADC reset state */\n1296: \n1297:   adc_rccreset(priv, true);\n1298: \n1299:   /* Release ADC from reset state */\n1300: \n1301:   adc_rccreset(priv, false);\n1302: }\n1303: \n1304: /****************************************************************************\n1305:  * Name: adc_setup\n1306:  *\n1307:  * Description:\n1308:  *   Configure the ADC. This method is called the first time that the ADC\n1309:  *   device is opened.  This will occur when the port is first opened.\n1310:  *   This setup includes configuring and attaching ADC interrupts.\n1311:  *   Interrupts are all disabled upon return.\n1312:  *\n1313:  * Input Parameters:\n1314:  *\n1315:  * Returned Value:\n1316:  *\n1317:  ****************************************************************************/\n1318: \n1319: static int adc_setup(struct adc_dev_s *dev)\n1320: {\n1321:   struct stm32_dev_s *priv = (struct stm32_dev_s *)dev->ad_priv;\n1322:   int ret;\n1323:   int i;\n1324:   irqstate_t flags;\n1325:   uint32_t clrbits;\n1326:   uint32_t setbits;\n1327: \n1328:   /* Attach the ADC interrupt */\n1329: \n1330:   ret = irq_attach(priv->irq, priv->isr, NULL);\n1331:   if (ret < 0)\n1332:     {\n1333:       ainfo(\"irq_attach failed: %d\\n\", ret);\n1334:       return ret;\n1335:     }\n1336: \n1337:   flags = enter_critical_section();\n1338: \n1339:   /* Make sure that the ADC device is in the powered up, reset state.\n1340:    * Since reset is shared between ADC1 and ADC2, don't reset one if the\n1341:    * other has already been reset. (We only need to worry about this if both\n1342:    * ADC1 and ADC2 are enabled.)\n1343:    */\n1344: \n1345: #if defined(CONFIG_STM32H7_ADC1) && defined(CONFIG_STM32H7_ADC2)\n1346:   if ((dev == &g_adcdev1 &&\n1347:       !((struct stm32_dev_s *)g_adcdev2.ad_priv)->initialized) ||\n1348:      (dev == &g_adcdev2 &&\n1349:       !((struct stm32_dev_s *)g_adcdev1.ad_priv)->initialized))\n1350: #endif\n1351:     {\n1352:       adc_reset(dev);\n1353:     }\n1354: \n1355:   /* Initialize the same sample time for each ADC.\n1356:    * During sample cycles channel selection bits must remain unchanged.\n1357:    */\n1358: \n1359:   adc_putreg(priv, STM32_ADC_SMPR1_OFFSET, ADC_SMPR1_DEFAULT);\n1360:   adc_putreg(priv, STM32_ADC_SMPR2_OFFSET, ADC_SMPR2_DEFAULT);\n1361: \n1362:   /* Set the resolution of the conversion. */\n1363: \n1364:   clrbits = ADC_CFGR_RES_MASK | ADC_CFGR_DMNGT_MASK;\n1365:   setbits = ADC_CFGR_RES_16BIT;\n1366: \n1367: #ifdef ADC_HAVE_DMA\n1368:   if (priv->hasdma)\n1369:     {\n1370:       /* Enable One shot DMA */\n1371: \n1372:       setbits |= ADC_CFGR_DMNGT_DMA_ONESHOT;\n1373:     }\n1374: #endif\n1375: \n1376: #ifdef ADC_HAVE_DFSDM\n1377:   if (priv->hasdfsdm)\n1378:     {\n1379:       /* Enable routing to DFSDM */\n1380: \n1381:       setbits |= ADC_CFGR_DMNGT_DFSDM;\n1382:     }\n1383: #endif\n1384: \n1385:   /* Disable continuous mode */\n1386: \n1387:   clrbits |= ADC_CFGR_CONT;\n1388: \n1389:   /* Disable external trigger for regular channels */\n1390: \n1391:   clrbits |= ADC_CFGR_EXTEN_MASK;\n1392:   setbits |= ADC_CFGR_EXTEN_NONE;\n1393: \n1394:   /* Set overrun mode to preserve the data register */\n1395: \n1396:   clrbits |= ADC_CFGR_OVRMOD;\n1397: \n1398:   /* Set CFGR configuration */\n1399: \n1400:   adc_modifyreg(priv, STM32_ADC_CFGR_OFFSET, clrbits, setbits);\n1401: \n1402:   /* Set CFGR2 configuration to align right no oversample */\n1403: \n1404:   clrbits = ADC_CFGR2_ROVSE | ADC_CFGR2_JOVSE | ADC_CFGR2_OVSS_MASK \\\n1405:           | ADC_CFGR2_OVSR_MASK | ADC_CFGR2_LSHIFT_MASK;\n1406:   setbits = 0;\n1407: \n1408:   adc_modifyreg(priv, STM32_ADC_CFGR2_OFFSET, clrbits, setbits);\n1409: \n1410:   /* Configuration of the channel conversions */\n1411: \n1412:   adc_set_ch(dev, 0);\n1413: \n1414:   /* ADC CCR configuration */\n1415: \n1416:   clrbits = ADC_CCR_PRESC_MASK | ADC_CCR_VREFEN |\n1417:             ADC_CCR_VSENSEEN | ADC_CCR_VBATEN;\n1418:   setbits = ADC_CCR_CKMODE_ASYCH;\n1419: \n1420:   adc_internal(priv, &setbits);\n1421: \n1422:   adc_modifyregm(priv, STM32_ADC_CCR_OFFSET, clrbits, setbits);\n1423: \n1424:   adc_setupclock(priv);\n1425: \n1426: #ifdef ADC_HAVE_DMA\n1427: \n1428:   /* Enable DMA */\n1429: \n1430:   if (priv->hasdma)\n1431:     {\n1432:       /* Stop and free DMA if it was started before */\n1433: \n1434:       if (priv->dma != NULL)\n1435:         {\n1436:           stm32_dmastop(priv->dma);\n1437:           stm32_dmafree(priv->dma);\n1438:         }\n1439: \n1440:       priv->dma = stm32_dmachannel(priv->dmachan);\n1441: \n1442:       stm32_dmasetup(priv->dma,\n1443:                        priv->base + STM32_ADC_DR_OFFSET,\n1444:                        (uint32_t)priv->dmabuffer,\n1445:                        priv->nchannels,\n1446:                        ADC_DMA_CONTROL_WORD);\n1447: \n1448:       stm32_dmastart(priv->dma, adc_dmaconvcallback, dev, false);\n1449:     }\n1450: \n1451: #endif\n1452: \n1453:   /* Set up the PCSEL bits. */\n1454: \n1455:   setbits = 0;\n1456:   clrbits = ADC_PCSEL_PCSEL_ALL;\n1457:   for (i = 0; i < priv->cchannels; i++)\n1458:     {\n1459:       setbits |= 1 << priv->chanlist[i];\n1460:     }\n1461: \n1462:   setbits &= ADC_PCSEL_PCSEL_ALL;\n1463: \n1464:   adc_modifyreg(priv, STM32_ADC_PCSEL_OFFSET, clrbits, setbits);\n1465: \n1466:   /* Set ADEN to wake up the ADC from Power Down. */\n1467: \n1468:   adc_enable(priv);\n1469: \n1470: #ifdef ADC_HAVE_TIMER\n1471:   if (priv->tbase != 0)\n1472:     {\n1473:       ret = adc_timinit(priv);\n1474:       if (ret < 0)\n1475:         {\n1476:           aerr(\"ERROR: adc_timinit failed: %d\\n\", ret);\n1477:         }\n1478: \n1479:       adc_startconv(priv, ret < 0 ? false : true);\n1480:     }\n1481: #endif\n1482: \n1483:   leave_critical_section(flags);\n1484: \n1485:   ainfo(\"ISR:   0x%08\" PRIx32 \" CR:    0x%08\" PRIx32 \" \"\n1486:         \"CFGR:  0x%08\" PRIx32 \" CFGR2: 0x%08\" PRIx32 \"\\n\",\n1487:         adc_getreg(priv, STM32_ADC_ISR_OFFSET),\n1488:         adc_getreg(priv, STM32_ADC_CR_OFFSET),\n1489:         adc_getreg(priv, STM32_ADC_CFGR_OFFSET),\n1490:         adc_getreg(priv, STM32_ADC_CFGR2_OFFSET));\n1491:   ainfo(\"SQR1:  0x%08\" PRIx32 \" SQR2:  0x%08\" PRIx32 \" \"\n1492:         \"SQR3:  0x%08\" PRIx32 \" SQR4:  0x%08\" PRIx32 \"\\n\",\n1493:         adc_getreg(priv, STM32_ADC_SQR1_OFFSET),\n1494:         adc_getreg(priv, STM32_ADC_SQR2_OFFSET),\n1495:         adc_getreg(priv, STM32_ADC_SQR3_OFFSET),\n1496:         adc_getreg(priv, STM32_ADC_SQR4_OFFSET));\n1497:   ainfo(\"CCR:   0x%08\" PRIx32 \"\\n\", adc_getregm(priv, STM32_ADC_CCR_OFFSET));\n1498: \n1499:   /* Enable the ADC interrupt */\n1500: \n1501:   ainfo(\"Enable the ADC interrupt: irq=%d\\n\", priv->irq);\n1502:   up_enable_irq(priv->irq);\n1503: \n1504:   priv->initialized = true;\n1505: \n1506:   return ret;\n1507: }\n1508: \n1509: /****************************************************************************\n1510:  * Name: adc_shutdown\n1511:  *\n1512:  * Description:\n1513:  *   Disable the ADC.  This method is called when the ADC device is closed.\n1514:  *   This method reverses the operation the setup method.\n1515:  *\n1516:  * Input Parameters:\n1517:  *\n1518:  * Returned Value:\n1519:  *\n1520:  ****************************************************************************/\n1521: \n1522: static void adc_shutdown(struct adc_dev_s *dev)\n1523: {\n1524:   struct stm32_dev_s *priv = (struct stm32_dev_s *)dev->ad_priv;\n1525: \n1526:   /* Stop the ADC */\n1527: \n1528:   adc_startconv(priv, false);\n1529: \n1530:   /* Disable ADC interrupts and detach the ADC interrupt handler */\n1531: \n1532:   up_disable_irq(priv->irq);\n1533:   irq_detach(priv->irq);\n1534: \n1535:   /* Disable and reset the ADC module */\n1536: \n1537:   adc_reset(dev);\n1538: \n1539:   priv->initialized = false;\n1540: }\n1541: \n1542: /****************************************************************************\n1543:  * Name: adc_rxint\n1544:  *\n1545:  * Description:\n1546:  *   Call to enable or disable RX interrupts.\n1547:  *\n1548:  * Input Parameters:\n1549:  *\n1550:  * Returned Value:\n1551:  *\n1552:  ****************************************************************************/\n1553: \n1554: static void adc_rxint(struct adc_dev_s *dev, bool enable)\n1555: {\n1556:   struct stm32_dev_s *priv = (struct stm32_dev_s *)dev->ad_priv;\n1557:   uint32_t regval;\n1558: \n1559:   ainfo(\"intf: %d enable: %d\\n\", priv->intf, enable ? 1 : 0);\n1560: \n1561:   regval = adc_getreg(priv, STM32_ADC_IER_OFFSET);\n1562:   if (enable)\n1563:     {\n1564:       /* Enable end of conversion and overrun interrupts */\n1565: \n1566:       regval |= ADC_INT_EOC | ADC_INT_OVR;\n1567:     }\n1568:   else\n1569:     {\n1570:       /* Disable all interrupts */\n1571: \n1572:       regval &= ~ADC_INT_MASK;\n1573:     }\n1574: \n1575:   adc_putreg(priv, STM32_ADC_IER_OFFSET, regval);\n1576: }\n1577: \n1578: /****************************************************************************\n1579:  * Name: adc_setupclock\n1580:  ****************************************************************************/\n1581: \n1582: static void adc_setupclock(struct stm32_dev_s *priv)\n1583: {\n1584:   uint32_t max_clock = 36000000;\n1585:   uint32_t src_clock;\n1586:   uint32_t adc_clock;\n1587:   uint32_t setbits;\n1588: \n1589:   /* The maximum clock is different for rev Y devices and rev V devices.\n1590:    * rev V can support an ADC clock of up to 50MHz. rev Y only supports\n1591:    * up to 36MHz.\n1592:    */\n1593: \n1594:   if ((getreg32(STM32_DEBUGMCU_BASE) & DBGMCU_IDCODE_REVID_MASK) ==\n1595:       STM32_IDCODE_REVID_V)\n1596:     {\n1597:       /* The max fadc is 50MHz, but there is an always-present /2 divider\n1598:        * after the configurable prescaler.  Therefore, the max clock out of\n1599:        * the prescaler block is 2*50=100MHz\n1600:        */\n1601: \n1602:       max_clock = 100000000;\n1603:     }\n1604: \n1605: #if STM32_RCC_D3CCIPR_ADCSRC == RCC_D3CCIPR_ADCSEL_PLL2\n1606:   src_clock = STM32_PLL2P_FREQUENCY;\n1607: #elif STM32_RCC_D3CCIPR_ADCSRC == RCC_D3CCIPR_ADCSEL_PLL3\n1608:   src_clock = STM32_PLL3R_FREQUENCY;\n1609: #elif STM32_RCC_D3CCIPR_ADCSRC == RCC_D3CCIPR_ADCSEL_PER\n1610: #  error ADCSEL_PER not supported\n1611: #else\n1612:   src_clock = STM32_PLL2P_FREQUENCY;\n1613: #endif\n1614: \n1615:   if (src_clock <= max_clock)\n1616:     {\n1617:       setbits = ADC_CCR_PRESC_NOT_DIV;\n1618:       adc_clock = src_clock;\n1619:     }\n1620:   else if (src_clock / 2 <= max_clock)\n1621:     {\n1622:       setbits = ADC_CCR_PRESC_DIV2;\n1623:       adc_clock = src_clock / 2;\n1624:     }\n1625:   else if (src_clock / 4 <= max_clock)\n1626:     {\n1627:       setbits = ADC_CCR_PRESC_DIV4;\n1628:       adc_clock = src_clock / 4;\n1629:     }\n1630:   else if (src_clock / 6 <= max_clock)\n1631:     {\n1632:       setbits = ADC_CCR_PRESC_DIV6;\n1633:       adc_clock = src_clock / 6;\n1634:     }\n1635:   else if (src_clock / 8 <= max_clock)\n1636:     {\n1637:       setbits = ADC_CCR_PRESC_DIV8;\n1638:       adc_clock = src_clock / 8;\n1639:     }\n1640:   else if (src_clock / 10 <= max_clock)\n1641:     {\n1642:       setbits = ADC_CCR_PRESC_DIV10;\n1643:       adc_clock = src_clock / 10;\n1644:     }\n1645:   else if (src_clock / 12 <= max_clock)\n1646:     {\n1647:       setbits = ADC_CCR_PRESC_DIV12;\n1648:       adc_clock = src_clock / 12;\n1649:     }\n1650:   else if (src_clock / 16 <= max_clock)\n1651:     {\n1652:       setbits = ADC_CCR_PRESC_DIV16;\n1653:       adc_clock = src_clock / 16;\n1654:     }\n1655:   else if (src_clock / 32 <= max_clock)\n1656:     {\n1657:       setbits = ADC_CCR_PRESC_DIV32;\n1658:       adc_clock = src_clock / 32;\n1659:     }\n1660:   else if (src_clock / 64 <= max_clock)\n1661:     {\n1662:       setbits = ADC_CCR_PRESC_DIV64;\n1663:       adc_clock = src_clock / 64;\n1664:     }\n1665:   else if (src_clock / 128 <= max_clock)\n1666:     {\n1667:       setbits = ADC_CCR_PRESC_DIV128;\n1668:       adc_clock = src_clock / 128;\n1669:     }\n1670:   else if (src_clock / 256 <= max_clock)\n1671:     {\n1672:       setbits = ADC_CCR_PRESC_DIV256;\n1673:       adc_clock = src_clock / 256;\n1674:     }\n1675:   else\n1676:     {\n1677:       aerr(\"ERROR: source clock too high\\n\");\n1678:     }\n1679: \n1680:   /* Write the prescaler to the CCR register */\n1681: \n1682:   adc_modifyregm(priv, STM32_ADC_CCR_OFFSET, ADC_CCR_PRESC_MASK, setbits);\n1683: \n1684:   if ((getreg32(STM32_DEBUGMCU_BASE) & DBGMCU_IDCODE_REVID_MASK) ==\n1685:       STM32_IDCODE_REVID_V)\n1686:     {\n1687:       if (adc_clock >= 25000000)\n1688:         {\n1689:           setbits = ADC_CR_BOOST_50_MHZ;\n1690:         }\n1691:       else if (adc_clock >= 12500000)\n1692:         {\n1693:           setbits = ADC_CR_BOOST_25_MHZ;\n1694:         }\n1695:       else if (adc_clock >=  6250000)\n1696:         {\n1697:           setbits = ADC_CR_BOOST_12p5_MHZ;\n1698:         }\n1699:       else\n1700:         {\n1701:           setbits = ADC_CR_BOOST_6p25_MHZ;\n1702:         }\n1703:     }\n1704:   else\n1705:     {\n1706:       if (adc_clock >= 20000000)\n1707:         {\n1708:           setbits = ADC_CR_BOOST;\n1709:         }\n1710:       else\n1711:         {\n1712:           setbits = 0;\n1713:         }\n1714:     }\n1715: \n1716:   adc_modifyregm(priv, STM32_ADC_CR_OFFSET, ADC_CR_BOOST_MASK, setbits);\n1717: }\n1718: \n1719: /****************************************************************************\n1720:  * Name: adc_sqrbits\n1721:  ****************************************************************************/\n1722: \n1723: static uint32_t adc_sqrbits(struct stm32_dev_s *priv, int first,\n1724:                             int last, int offset)\n1725: {\n1726:   uint32_t bits = 0;\n1727:   int i;\n1728: \n1729:   for (i = first - 1;\n1730:        i < priv->nchannels && i < last;\n1731:        i++, offset += ADC_SQ_OFFSET)\n1732:     {\n1733:       bits |= (uint32_t)priv->chanlist[i] << offset;\n1734:     }\n1735: \n1736:   return bits;\n1737: }\n1738: \n1739: /****************************************************************************\n1740:  * Name: adc_internal\n1741:  ****************************************************************************/\n1742: \n1743: static bool adc_internal(struct stm32_dev_s * priv, uint32_t *adc_ccr)\n1744: {\n1745:   int i;\n1746:   bool internal = false;\n1747: \n1748:   if (priv->intf == 3)\n1749:     {\n1750:       for (i = 0; i < priv->nchannels; i++)\n1751:         {\n1752:           if (priv->chanlist[i] > ADC_EXTERNAL_CHAN_MAX)\n1753:             {\n1754:               internal = true;\n1755:               switch (priv->chanlist[i])\n1756:                 {\n1757:                   case 17:\n1758:                     *adc_ccr |= ADC_CCR_VBATEN;\n1759:                     break;\n1760: \n1761:                   case 18:\n1762:                     *adc_ccr |= ADC_CCR_VSENSEEN;\n1763:                     break;\n1764: \n1765:                   case 19:\n1766:                      *adc_ccr |= ADC_CCR_VREFEN;\n1767:                     break;\n1768:                 }\n1769:             }\n1770:         }\n1771:     }\n1772: \n1773:   return internal;\n1774: }\n1775: \n1776: /****************************************************************************\n1777:  * Name: adc_set_offset\n1778:  ****************************************************************************/\n1779: \n1780: #ifdef ADC_HAVE_DFSDM\n1781: static int adc_setoffset(struct stm32_dev_s *priv, uint8_t ch, uint8_t i,\n1782:                          uint16_t offset)\n1783: {\n1784:   uint32_t reg;\n1785:   uint32_t regval;\n1786: \n1787:   if (i >= 4)\n1788:     {\n1789:       /* There are only four offset registers. */\n1790: \n1791:       return -E2BIG;\n1792:     }\n1793: \n1794:   reg = STM32_ADC_OFR1_OFFSET + i * 4;\n1795: \n1796:   regval = ADC_OFR_OFFSETY_EN;\n1797:   adc_putreg(priv, reg, regval);\n1798: \n1799:   regval |= ADC_OFR_OFFSETY_CH(ch) | ADC_OFR_OFFSETY(offset);\n1800:   adc_putreg(priv, reg, regval);\n1801:   return OK;\n1802: }\n1803: #endif\n1804: \n\n(Output capped at 50 KB. Showing lines 1-1804. Use offset=1805 to continue.)\n</content>",
