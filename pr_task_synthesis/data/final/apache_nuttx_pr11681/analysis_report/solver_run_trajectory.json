            "output": "<path>/workspace/boards/arm/stm32h7/nucleo-h745zi/src/nucleo-h745zi.h</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * boards/arm/stm32h7/nucleo-h745zi/src/nucleo-h745zi.h\n3:  *\n4:  * Licensed to the Apache Software Foundation (ASF) under one or more\n5:  * contributor license agreements.  See the NOTICE file distributed with\n6:  * this work for additional information regarding copyright ownership.  The\n7:  * ASF licenses this file to you under the Apache License, Version 2.0 (the\n8:  * \"License\"); you may not use this file except in compliance with the\n9:  * License.  You may obtain a copy of the License at\n10:  *\n11:  *   http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n15:  * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n16:  * License for the specific language governing permissions and limitations\n17:  * under the License.\n18:  *\n19:  ****************************************************************************/\n20: \n21: #ifndef __BOARDS_ARM_STM32H7_NUCLEO_H745ZI_SRC_NUCLEO_H745ZI_H\n22: #define __BOARDS_ARM_STM32H7_NUCLEO_H745ZI_SRC_NUCLEO_H745ZI_H\n23: \n24: /****************************************************************************\n25:  * Included Files\n26:  ****************************************************************************/\n27: \n28: #include <nuttx/config.h>\n29: #include <nuttx/compiler.h>\n30: \n31: #include <stdint.h>\n32: \n33: /****************************************************************************\n34:  * Pre-processor Definitions\n35:  ****************************************************************************/\n36: \n37: /* Configuration ************************************************************/\n38: \n39: #define HAVE_PROC            1\n40: #define HAVE_USBDEV          1\n41: #define HAVE_USBHOST         1\n42: #define HAVE_USBMONITOR      1\n43: #define HAVE_MTDCONFIG       1\n44: #define HAVE_PROGMEM_CHARDEV 1\n45: \n46: /* Can't support USB host or device features if USB OTG FS is not enabled */\n47: \n48: #ifndef CONFIG_STM32H7_OTGFS\n49: #  undef HAVE_USBDEV\n50: #  undef HAVE_USBHOST\n51: #endif\n52: \n53: /* Can't support USB device if USB device is not enabled */\n54: \n55: #ifndef CONFIG_USBDEV\n56: #  undef HAVE_USBDEV\n57: #endif\n58: \n59: /* Can't support USB host is USB host is not enabled */\n60: \n61: #ifndef CONFIG_USBHOST\n62: #  undef HAVE_USBHOST\n63: #endif\n64: \n65: /* Check if we should enable the USB monitor before starting NSH */\n66: \n67: #ifndef CONFIG_USBMONITOR\n68: #  undef HAVE_USBMONITOR\n69: #endif\n70: \n71: #ifndef HAVE_USBDEV\n72: #  undef CONFIG_USBDEV_TRACE\n73: #endif\n74: \n75: #ifndef HAVE_USBHOST\n76: #  undef CONFIG_USBHOST_TRACE\n77: #endif\n78: \n79: #if !defined(CONFIG_USBDEV_TRACE) && !defined(CONFIG_USBHOST_TRACE)\n80: #  undef HAVE_USBMONITOR\n81: #endif\n82: \n83: #if !defined(CONFIG_STM32H7_PROGMEM) || !defined(CONFIG_MTD_PROGMEM)\n84: #  undef HAVE_PROGMEM_CHARDEV\n85: #endif\n86: \n87: /* This is the on-chip progmem memory driver minor number */\n88: \n89: #define PROGMEM_MTD_MINOR 0\n90: \n91: /* flash  */\n92: #if defined(CONFIG_MMCSD)\n93: #  define FLASH_BASED_PARAMS\n94: #endif\n95: \n96: /* procfs File System */\n97: \n98: #ifdef CONFIG_FS_PROCFS\n99: #  ifdef CONFIG_NSH_PROC_MOUNTPOINT\n100: #    define STM32_PROCFS_MOUNTPOINT CONFIG_NSH_PROC_MOUNTPOINT\n101: #  else\n102: #    define STM32_PROCFS_MOUNTPOINT \"/proc\"\n103: #  endif\n104: #endif\n105: \n106: /* Check if we can support the RTC driver */\n107: \n108: #define HAVE_RTC_DRIVER 1\n109: #if !defined(CONFIG_RTC) || !defined(CONFIG_RTC_DRIVER)\n110: #  undef HAVE_RTC_DRIVER\n111: #endif\n112: \n113: /* LED\n114:  *\n115:  * The Nucleo-144 board has numerous LEDs but only three, LD1 a Green LED,\n116:  * LD2 a Blue LED and LD3 a Red LED, that can be controlled by software. The\n117:  * following definitions assume the default Solder Bridges are installed.\n118:  */\n119: \n120: #define GPIO_LD1       (GPIO_OUTPUT | GPIO_PUSHPULL | GPIO_SPEED_50MHz | \\\n121:                         GPIO_OUTPUT_CLEAR | GPIO_PORTB | GPIO_PIN0)\n122: #define GPIO_LD2       (GPIO_OUTPUT | GPIO_PUSHPULL | GPIO_SPEED_50MHz | \\\n123:                         GPIO_OUTPUT_CLEAR | GPIO_PORTB | GPIO_PIN7)\n124: #define GPIO_LD3       (GPIO_OUTPUT | GPIO_PUSHPULL | GPIO_SPEED_50MHz | \\\n125:                         GPIO_OUTPUT_CLEAR | GPIO_PORTB | GPIO_PIN14)\n126: \n127: #define GPIO_LED_GREEN GPIO_LD1\n128: #define GPIO_LED_BLUE  GPIO_LD2\n129: #define GPIO_LED_RED   GPIO_LD3\n130: \n131: #define LED_DRIVER_PATH \"/dev/userleds\"\n132: \n133: /* BUTTONS\n134:  *\n135:  * The Blue pushbutton B1, labeled \"User\", is connected to GPIO PC13.\n136:  * A high value will be sensed when the button is depressed.\n137:  * Note:\n138:  *    1) That the EXTI is included in the definition to enable an interrupt\n139:  *       on this IO.\n140:  *    2) The following definitions assume the default Solder Bridges are\n141:  *       installed.\n142:  */\n143: \n144: #define GPIO_BTN_USER  (GPIO_INPUT | GPIO_FLOAT | GPIO_EXTI | GPIO_PORTC | GPIO_PIN13)\n145: \n146: /* USB OTG FS\n147:  *\n148:  * PA9  OTG_FS_VBUS VBUS sensing (also connected to the green LED)\n149:  * PG6  OTG_FS_PowerSwitchOn\n150:  * PG7  OTG_FS_Overcurrent\n151:  */\n152: \n153: #define GPIO_OTGFS_VBUS   (GPIO_INPUT|GPIO_FLOAT|GPIO_SPEED_100MHz| \\\n154:                            GPIO_OPENDRAIN|GPIO_PORTA|GPIO_PIN9)\n155: \n156: # define GPIO_OTGFS_PWRON  (GPIO_OUTPUT|GPIO_FLOAT|GPIO_SPEED_100MHz|  \\\n157:                            GPIO_PUSHPULL|GPIO_PORTG|GPIO_PIN6)\n158: \n159: #ifdef CONFIG_USBHOST\n160: #  define GPIO_OTGFS_OVER (GPIO_INPUT|GPIO_EXTI|GPIO_FLOAT| \\\n161:                            GPIO_SPEED_100MHz|GPIO_PUSHPULL| \\\n162:                            GPIO_PORTG|GPIO_PIN7)\n163: #else\n164: #  define GPIO_OTGFS_OVER (GPIO_INPUT|GPIO_FLOAT|GPIO_SPEED_100MHz| \\\n165:                            GPIO_PUSHPULL|GPIO_PORTG|GPIO_PIN7)\n166: #endif\n167: \n168: /* GPIO pins used by the GPIO Subsystem */\n169: \n170: #define BOARD_NGPIOIN     1 /* Amount of GPIO Input pins */\n171: #define BOARD_NGPIOOUT    1 /* Amount of GPIO Output pins */\n172: #define BOARD_NGPIOINT    1 /* Amount of GPIO Input w/ Interruption pins */\n173: \n174: /* Example, used free Ports on the board */\n175: \n176: #define GPIO_IN1          (GPIO_INPUT | GPIO_FLOAT | GPIO_PORTE | GPIO_PIN2)\n177: #define GPIO_OUT1         (GPIO_OUTPUT | GPIO_PUSHPULL | GPIO_SPEED_50MHz | \\\n178:                            GPIO_OUTPUT_SET | GPIO_PORTE | GPIO_PIN4)\n179: #define GPIO_INT1         (GPIO_INPUT | GPIO_FLOAT | GPIO_PORTE | GPIO_PIN5)\n180: \n181: /* X-NUCLEO IKS01A2 */\n182: \n183: #define GPIO_LPS22HB_INT1 (GPIO_INPUT | GPIO_FLOAT | GPIO_PORTB | GPIO_PIN10)\n184: #define GPIO_LSM6DSL_INT1 (GPIO_INPUT | GPIO_FLOAT | GPIO_PORTB | GPIO_PIN4)\n185: #define GPIO_LSM6DSL_INT2 (GPIO_INPUT | GPIO_FLOAT | GPIO_PORTB | GPIO_PIN5)\n186: \n187: /* NRF24L01\n188:  * CS  - PA4\n189:  * CE  - PF12 (D8)\n190:  * IRQ - PD15 (D9)\n191:  */\n192: \n193: #define GPIO_NRF24L01_CS   (GPIO_OUTPUT | GPIO_SPEED_50MHz| \\\n194:                             GPIO_OUTPUT_SET | GPIO_PORTA | GPIO_PIN4)\n195: #define GPIO_NRF24L01_CE   (GPIO_OUTPUT | GPIO_SPEED_50MHz| \\\n196:                             GPIO_OUTPUT_CLEAR | GPIO_PORTF | GPIO_PIN12)\n197: #define GPIO_NRF24L01_IRQ  (GPIO_INPUT | GPIO_FLOAT | GPIO_PORTD | GPIO_PIN15)\n198: \n199: /* LMS9DS1 configuration */\n200: \n201: #define LMS9DS1_I2CBUS 1\n202: \n203: /* PCA9635 configuration */\n204: \n205: #define PCA9635_I2CBUS  1\n206: #define PCA9635_I2CADDR 0x40\n207: \n208: /* Oled configuration */\n209: \n210: #define OLED_I2C_PORT   2\n211: \n212: /* PWM */\n213: \n214: #define NUCLEOH745ZI_PWMTIMER 1\n215: \n216: /****************************************************************************\n217:  * Public Function Prototypes\n218:  ****************************************************************************/\n219: \n220: /****************************************************************************\n221:  * Name: stm32_bringup\n222:  *\n223:  * Description:\n224:  *   Perform architecture-specific initialization\n225:  *\n226:  *   CONFIG_BOARD_LATE_INITIALIZE=y :\n227:  *     Called from board_late_initialize().\n228:  *\n229:  *   CONFIG_BOARD_LATE_INITIALIZE=n && CONFIG_BOARDCTL=y &&\n230:  *   CONFIG_NSH_ARCHINIT:\n231:  *     Called from the NSH library\n232:  *\n233:  ****************************************************************************/\n234: \n235: int stm32_bringup(void);\n236: \n237: #endif /* __BOARDS_ARM_STM32H7_NUCLEO_H745ZI_SRC_NUCLEO_H745ZI_H */\n\n(End of file - total 237 lines)\n</content>",
