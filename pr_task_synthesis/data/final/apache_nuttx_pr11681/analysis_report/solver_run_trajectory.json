            "output": "<path>/workspace/boards/arm/stm32h7/nucleo-h743zi/src/stm32_adc.c</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * boards/arm/stm32h7/nucleo-h743zi/src/stm32_adc.c\n3:  *\n4:  * Licensed to the Apache Software Foundation (ASF) under one or more\n5:  * contributor license agreements.  See the NOTICE file distributed with\n6:  * this work for additional information regarding copyright ownership.  The\n7:  * ASF licenses this file to you under the Apache License, Version 2.0 (the\n8:  * \"License\"); you may not use this file except in compliance with the\n9:  * License.  You may obtain a copy of the License at\n10:  *\n11:  *   http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n15:  * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n16:  * License for the specific language governing permissions and limitations\n17:  * under the License.\n18:  *\n19:  ****************************************************************************/\n20: \n21: /****************************************************************************\n22:  * Included Files\n23:  ****************************************************************************/\n24: \n25: #include <nuttx/config.h>\n26: \n27: #include <errno.h>\n28: #include <debug.h>\n29: \n30: #include <nuttx/board.h>\n31: #include <nuttx/analog/adc.h>\n32: #include <arch/board/board.h>\n33: \n34: #include \"chip.h\"\n35: #include \"stm32_gpio.h\"\n36: #include \"stm32_adc.h\"\n37: #include \"nucleo-h743zi.h\"\n38: \n39: #ifdef CONFIG_ADC\n40: \n41: /****************************************************************************\n42:  * Pre-processor Definitions\n43:  ****************************************************************************/\n44: \n45: /* Configuration ************************************************************/\n46: \n47: /* Up to 3 ADC interfaces are supported */\n48: \n49: #if defined(CONFIG_STM32H7_ADC1) || defined(CONFIG_STM32H7_ADC2) || \\\n50:     defined(CONFIG_STM32H7_ADC3)\n51: #ifndef CONFIG_STM32H7_ADC1\n52: #  warning \"Channel information only available for ADC1\"\n53: #endif\n54: \n55: /* The number of ADC channels in the conversion list */\n56: \n57: #define ADC1_NCHANNELS 5\n58: #define ADC3_NCHANNELS 1\n59: \n60: /****************************************************************************\n61:  * Private Data\n62:  ****************************************************************************/\n63: \n64: #ifdef CONFIG_STM32H7_ADC1\n65: /* Identifying number of each ADC channel: Variable Resistor.\n66:  *\n67:  * ADC1: {5, 10, 12, 13, 15};\n68:  */\n69: \n70: static const uint8_t  g_adc1_chanlist[ADC1_NCHANNELS] =\n71: {\n72:   5, 10, 12, 13, 15\n73: };\n74: \n75: /* Configurations of pins used by each ADC channels\n76:  *\n77:  * ADC1:\n78:  * {GPIO_ADC12_INP5, GPIO_ADC123_INP10, GPIO_ADC123_INP12, GPIO_ADC12_INP13,\n79:  *  GPIO_ADC12_INP15};\n80:  */\n81: \n82: static const uint32_t g_adc1_pinlist[ADC1_NCHANNELS] =\n83: {\n84:   GPIO_ADC12_INP5,\n85:   GPIO_ADC123_INP10,\n86:   GPIO_ADC123_INP12,\n87:   GPIO_ADC12_INP13,\n88:   GPIO_ADC12_INP15\n89: };\n90: #endif\n91: \n92: #ifdef CONFIG_STM32H7_ADC3\n93: /* Identifying number of each ADC channel: Variable Resistor.\n94:  *\n95:  * ADC3: {6,};\n96:  */\n97: \n98: static const uint8_t  g_adc3_chanlist[ADC1_NCHANNELS] =\n99: {\n100:   6\n101: };\n102: \n103: /* Configurations of pins used by each ADC channels\n104:  *\n105:  *\n106:  * ADC3: {GPIO_ADC3_INP6}\n107:  */\n108: \n109: static const uint32_t g_adc3_pinlist[ADC3_NCHANNELS] =\n110: {\n111:   GPIO_ADC3_INP6\n112: };\n113: #endif\n114: \n115: /****************************************************************************\n116:  * Private Functions\n117:  ****************************************************************************/\n118: \n119: /****************************************************************************\n120:  * Public Functions\n121:  ****************************************************************************/\n122: \n123: /****************************************************************************\n124:  * Name: stm32_adc_setup\n125:  *\n126:  * Description:\n127:  *   Initialize ADC and register the ADC driver.\n128:  *\n129:  ****************************************************************************/\n130: \n131: int stm32_adc_setup(void)\n132: {\n133: #if defined(CONFIG_STM32H7_ADC1) || defined(CONFIG_STM32H7_ADC3)\n134:   static bool initialized = false;\n135:   struct adc_dev_s *adc;\n136:   int ret;\n137:   int i;\n138:   char devname[] = \"/dev/adc0\";\n139: \n140:   /* Check if we have already initialized */\n141: \n142:   if (!initialized)\n143:     {\n144: #endif\n145: #if defined(CONFIG_STM32H7_ADC1)\n146:       /* Configure the pins as analog inputs for the selected channels */\n147: \n148:       for (i = 0; i < ADC1_NCHANNELS; i++)\n149:         {\n150:           if (g_adc1_pinlist[i] != 0)\n151:             {\n152:               stm32_configgpio(g_adc1_pinlist[i]);\n153:             }\n154:         }\n155: \n156:       /* Call stm32_adcinitialize() to get an instance of the ADC interface */\n157: \n158:       adc = stm32h7_adc_initialize(1, g_adc1_chanlist, ADC1_NCHANNELS);\n159:       if (adc == NULL)\n160:         {\n161:           aerr(\"ERROR: Failed to get ADC1 interface\\n\");\n162:           return -ENODEV;\n163:         }\n164: \n165:       /* Register the ADC driver at \"/dev/adc0\" */\n166: \n167:       ret = adc_register(devname, adc);\n168:       if (ret < 0)\n169:         {\n170:           aerr(\"ERROR: adc_register(%s) failed: %d\\n\", devname, ret);\n171:           return ret;\n172:         }\n173: \n174:       devname[8]++;\n175: #endif\n176: #if defined(CONFIG_STM32H7_ADC3)\n177:       /* Configure the pins as analog inputs for the selected channels */\n178: \n179:       for (i = 0; i < ADC3_NCHANNELS; i++)\n180:         {\n181:           if (g_adc3_pinlist[i] != 0)\n182:             {\n183:               stm32_configgpio(g_adc3_pinlist[i]);\n184:             }\n185:         }\n186: \n187:       /* Call stm32_adcinitialize() to get an instance of the ADC interface */\n188: \n189:       adc = stm32h7_adc_initialize(3, g_adc3_chanlist, ADC3_NCHANNELS);\n190:       if (adc == NULL)\n191:         {\n192:           aerr(\"ERROR: Failed to get ADC3 interface\\n\");\n193:           return -ENODEV;\n194:         }\n195: \n196:       /* Register the ADC driver at \"/dev/adc0 or 1\" */\n197: \n198:       ret = adc_register(devname, adc);\n199:       if (ret < 0)\n200:         {\n201:           aerr(\"ERROR: adc_register(%s) failed: %d\\n\", devname, ret);\n202:           return ret;\n203:         }\n204: #endif\n205: \n206: #if defined(CONFIG_STM32H7_ADC1) || defined(CONFIG_STM32H7_ADC3)\n207:       /* Now we are initialized */\n208: \n209:       initialized = true;\n210:     }\n211: \n212:   return OK;\n213: #else\n214:   return -ENOSYS;\n215: #endif\n216: }\n217: \n218: #endif /* CONFIG_STM32H7_ADC1 || CONFIG_STM32H7_ADC2 || CONFIG_STM32H7_ADC3 */\n219: #endif /* CONFIG_ADC */\n\n(End of file - total 219 lines)\n</content>",
