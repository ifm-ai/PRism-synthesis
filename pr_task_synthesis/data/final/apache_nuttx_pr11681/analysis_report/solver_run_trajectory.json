***************************/\n47: \n48: /****************************************************************************\n49:  * Public Functions\n50:  ****************************************************************************/\n51: \n52: #ifdef CONFIG_RPMSG_UART\n53: /****************************************************************************\n54:  * Name: rpmsg_serialinit\n55:  ****************************************************************************/\n56: \n57: void rpmsg_serialinit(void)\n58: {\n59: #ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM7\n60:   uart_rpmsg_init(\"cm4\", \"proxy\", 4096, false);\n61: #endif\n62: \n63: #ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM4\n64: #  ifdef CONFIG_RPMSG_UART_CONSOLE\n65:   uart_rpmsg_init(\"cm7\", \"proxy\", 4096, true);\n66: #  else\n67:   uart_rpmsg_init(\"cm7\", \"proxy\", 4096, false);\n68: #  endif\n69: #endif\n70: }\n71: #endif\n72: \n73: /****************************************************************************\n74:  * Name: stm32_bringup\n75:  *\n76:  * Description:\n77:  *   Perform architecture-specific initialization\n78:  *\n79:  *   CONFIG_BOARD_LATE_INITIALIZE=y :\n80:  *     Called from board_late_initialize().\n81:  *\n82:  *   CONFIG_BOARD_LATE_INITIALIZE=n && CONFIG_BOARDCTL=y &&\n83:  *   CONFIG_NSH_ARCHINIT:\n84:  *     Called from the NSH library\n85:  *\n86:  ****************************************************************************/\n87: \n88: int stm32_bringup(void)\n89: {\n90:   int ret = OK;\n91: \n92:   UNUSED(ret);\n93: \n94: #ifdef CONFIG_FS_PROCFS\n95:   /* Mount the procfs file system */\n96: \n97:   ret = nx_mount(NULL, STM32_PROCFS_MOUNTPOINT, \"procfs\", 0, NULL);\n98:   if (ret < 0)\n99:     {\n100:       syslog(LOG_ERR,\n101:              \"ERROR: Failed to mount the PROC filesystem: %d\\n\",  ret);\n102:     }\n103: #endif /* CONFIG_FS_PROCFS */\n104: \n105: #ifdef CONFIG_RPTUN\n106: #  ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM7\n107:   stm32_rptun_init(\"cm4\");\n108: #  else\n109:   stm32_rptun_init(\"cm7\");\n110: #  endif\n111: #endif\n112: \n113:   return OK;\n114: }\n\n(End of file - total 114 lines)\n</content>",
