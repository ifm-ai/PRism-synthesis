            "output": "<path>/workspace/boards/arm/stm32h7/nucleo-h745zi/include/board.h</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * boards/arm/stm32h7/nucleo-h745zi/include/board.h\n3:  *\n4:  * Licensed to the Apache Software Foundation (ASF) under one or more\n5:  * contributor license agreements.  See the NOTICE file distributed with\n6:  * this work for additional information regarding copyright ownership.  The\n7:  * ASF licenses this file to you under the Apache License, Version 2.0 (the\n8:  * \"License\"); you may not use this file except in compliance with the\n9:  * License.  You may obtain a copy of the License at\n10:  *\n11:  *   http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n15:  * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n16:  * License for the specific language governing permissions and limitations\n17:  * under the License.\n18:  *\n19:  ****************************************************************************/\n20: \n21: #ifndef __BOARDS_ARM_STM32H7_NUCLEO_H745ZI_INCLUDE_BOARD_H\n22: #define __BOARDS_ARM_STM32H7_NUCLEO_H745ZI_INCLUDE_BOARD_H\n23: \n24: /****************************************************************************\n25:  * Included Files\n26:  ****************************************************************************/\n27: \n28: #include <nuttx/config.h>\n29: \n30: #ifndef __ASSEMBLY__\n31: # include <stdint.h>\n32: #endif\n33: \n34: /* Do not include STM32 H7 header files here */\n35: \n36: /****************************************************************************\n37:  * Pre-processor Definitions\n38:  ****************************************************************************/\n39: \n40: /* Clocking *****************************************************************/\n41: \n42: /* The Nucleo-144  board provides the following clock sources:\n43:  *\n44:  *   MCO: 8 MHz from MCO output of ST-LINK is used as input clock (default)\n45:  *   X2:  32.768 KHz crystal for LSE\n46:  *   X3:  HSE crystal oscillator (not provided)\n47:  *\n48:  * So we have these clock source available within the STM32\n49:  *\n50:  *   HSI: 16 MHz RC factory-trimmed\n51:  *   LSI: 32 KHz RC\n52:  *   HSE: 8 MHz from MCO output of ST-LINK\n53:  *   LSE: 32.768 kHz\n54:  */\n55: \n56: #define STM32_BOARD_XTAL        8000000ul /* ST-LINK MCO */\n57: \n58: #define STM32_HSI_FREQUENCY     16000000ul\n59: #define STM32_LSI_FREQUENCY     32000\n60: #define STM32_HSE_FREQUENCY     STM32_BOARD_XTAL\n61: #define STM32_LSE_FREQUENCY     32768\n62: \n63: /* Main PLL Configuration.\n64:  *\n65:  * PLL source is HSE = 8,000,000\n66:  *\n67:  * When STM32_HSE_FREQUENCY / PLLM <= 2MHz VCOL must be selected.\n68:  * VCOH otherwise.\n69:  *\n70:  * PLL_VCOx = (STM32_HSE_FREQUENCY / PLLM) * PLLN\n71:  * Subject to:\n72:  *\n73:  *     1 <= PLLM <= 63\n74:  *     4 <= PLLN <= 512\n75:  *   150 MHz <= PLL_VCOL <= 420MHz\n76:  *   192 MHz <= PLL_VCOH <= 836MHz\n77:  *\n78:  * SYSCLK  = PLL_VCO / PLLP\n79:  * CPUCLK  = SYSCLK / D1CPRE\n80:  * Subject to\n81:  *\n82:  *   PLLP1   = {2, 4, 6, 8, ..., 128}\n83:  *   PLLP2,3 = {2, 3, 4, ..., 128}\n84:  *   CPUCLK <= 400 MHz\n85:  */\n86: \n87: #define STM32_BOARD_USEHSE\n88: #define STM32_HSEBYP_ENABLE\n89: \n90: #define STM32_PLLCFG_PLLSRC      RCC_PLLCKSELR_PLLSRC_HSE\n91: \n92: /* PLL1, wide 4 - 8 MHz input, enable DIVP, DIVQ, DIVR\n93:  *\n94:  *   PLL1_VCO = (8,000,000 / 2) * 200 = 800 MHz\n95:  *\n96:  *   PLL1P = PLL1_VCO/2  = 800 MHz / 2   = 400 MHz\n97:  *   PLL1Q = PLL1_VCO/4  = 800 MHz / 4   = 200 MHz\n98:  *   PLL1R = PLL1_VCO/8  = 800 MHz / 8   = 100 MHz\n99:  */\n100: \n101: #define STM32_PLLCFG_PLL1CFG     (RCC_PLLCFGR_PLL1VCOSEL_WIDE | \\\n102:                                   RCC_PLLCFGR_PLL1RGE_4_8_MHZ | \\\n103:                                   RCC_PLLCFGR_DIVP1EN | \\\n104:                                   RCC_PLLCFGR_DIVQ1EN | \\\n105:                                   RCC_PLLCFGR_DIVR1EN)\n106: #define STM32_PLLCFG_PLL1M       RCC_PLLCKSELR_DIVM1(2)\n107: #define STM32_PLLCFG_PLL1N       RCC_PLL1DIVR_N1(200)\n108: #define STM32_PLLCFG_PLL1P       RCC_PLL1DIVR_P1(2)\n109: #define STM32_PLLCFG_PLL1Q       RCC_PLL1DIVR_Q1(4)\n110: #define STM32_PLLCFG_PLL1R       RCC_PLL1DIVR_R1(8)\n111: \n112: #define STM32_VCO1_FREQUENCY     ((STM32_HSE_FREQUENCY / 2) * 200)\n113: #define STM32_PLL1P_FREQUENCY    (STM32_VCO1_FREQUENCY / 2)\n114: #define STM32_PLL1Q_FREQUENCY    (STM32_VCO1_FREQUENCY / 4)\n115: #define STM32_PLL1R_FREQUENCY    (STM32_VCO1_FREQUENCY / 8)\n116: \n117: /* PLL2 */\n118: \n119: #define STM32_PLLCFG_PLL2CFG (RCC_PLLCFGR_PLL2VCOSEL_WIDE | \\\n120:                               RCC_PLLCFGR_PLL2RGE_4_8_MHZ | \\\n121:                               RCC_PLLCFGR_DIVP2EN)\n122: #define STM32_PLLCFG_PLL2M       RCC_PLLCKSELR_DIVM2(2)\n123: #define STM32_PLLCFG_PLL2N       RCC_PLL2DIVR_N2(200)\n124: #define STM32_PLLCFG_PLL2P       RCC_PLL2DIVR_P2(40)\n125: #define STM32_PLLCFG_PLL2Q       0\n126: #define STM32_PLLCFG_PLL2R       0\n127: \n128: #define STM32_VCO2_FREQUENCY     ((STM32_HSE_FREQUENCY / 2) * 200)\n129: #define STM32_PLL2P_FREQUENCY    (STM32_VCO2_FREQUENCY / 2)\n130: #define STM32_PLL2Q_FREQUENCY\n131: #define STM32_PLL2R_FREQUENCY\n132: \n133: /* PLL3 */\n134: \n135: #define STM32_PLLCFG_PLL3CFG 0\n136: #define STM32_PLLCFG_PLL3M   0\n137: #define STM32_PLLCFG_PLL3N   0\n138: #define STM32_PLLCFG_PLL3P   0\n139: #define STM32_PLLCFG_PLL3Q   0\n140: #define STM32_PLLCFG_PLL3R   0\n141: \n142: #define STM32_VCO3_FREQUENCY\n143: #define STM32_PLL3P_FREQUENCY\n144: #define STM32_PLL3Q_FREQUENCY\n145: #define STM32_PLL3R_FREQUENCY\n146: \n147: /* SYSCLK = PLL1P = 400 MHz\n148:  * M7 CPUCLK = SYSCLK / 1 = 400 MHz\n149:  * M4 CPUCLK = HCLK / 1 = 200 MHz\n150:  */\n151: \n152: #define STM32_RCC_D1CFGR_D1CPRE  (RCC_D1CFGR_D1CPRE_SYSCLK)\n153: #define STM32_SYSCLK_FREQUENCY   (STM32_PLL1P_FREQUENCY)\n154: #ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM7\n155: #  define STM32_CPUCLK_FREQUENCY (STM32_SYSCLK_FREQUENCY / 1)\n156: #else\n157: #  define STM32_CPUCLK_FREQUENCY (STM32_HCLK_FREQUENCY / 1)\n158: #endif\n159: \n160: /* Configure Clock Assignments */\n161: \n162: /* AHB clock (HCLK) is SYSCLK/2 (240 MHz max)\n163:  * HCLK1 = HCLK2 = HCLK3 = HCLK4\n164:  */\n165: \n166: #define STM32_RCC_D1CFGR_HPRE   RCC_D1CFGR_HPRE_SYSCLKd2        /* HCLK  = SYSCLK / 2 */\n167: #define STM32_ACLK_FREQUENCY    (STM32_SYSCLK_FREQUENCY / 2)    /* ACLK in D1, HCLK3 in D1 */\n168: #define STM32_HCLK_FREQUENCY    (STM32_SYSCLK_FREQUENCY / 2)    /* HCLK in D2, HCLK4 in D3 */\n169: \n170: /* APB1 clock (PCLK1) is HCLK/4 (54 MHz) */\n171: \n172: #define STM32_RCC_D2CFGR_D2PPRE1  RCC_D2CFGR_D2PPRE1_HCLKd4       /* PCLK1 = HCLK / 4 */\n173: #define STM32_PCLK1_FREQUENCY     (STM32_HCLK_FREQUENCY/4)\n174: \n175: /* APB2 clock (PCLK2) is HCLK/4 (54 MHz) */\n176: \n177: #define STM32_RCC_D2CFGR_D2PPRE2  RCC_D2CFGR_D2PPRE2_HCLKd4       /* PCLK2 = HCLK / 4 */\n178: #define STM32_PCLK2_FREQUENCY     (STM32_HCLK_FREQUENCY/4)\n179: \n180: /* APB3 clock (PCLK3) is HCLK/4 (54 MHz) */\n181: \n182: #define STM32_RCC_D1CFGR_D1PPRE   RCC_D1CFGR_D1PPRE_HCLKd4        /* PCLK3 = HCLK / 4 */\n183: #define STM32_PCLK3_FREQUENCY     (STM32_HCLK_FREQUENCY/4)\n184: \n185: /* APB4 clock (PCLK4) is HCLK/4 (54 MHz) */\n186: \n187: #define STM32_RCC_D3CFGR_D3PPRE   RCC_D3CFGR_D3PPRE_HCLKd4       /* PCLK4 = HCLK / 4 */\n188: #define STM32_PCLK4_FREQUENCY     (STM32_HCLK_FREQUENCY/4)\n189: \n190: /* Timer clock frequencies */\n191: \n192: /* Timers driven from APB1 will be twice PCLK1 */\n193: \n194: #define STM32_APB1_TIM2_CLKIN   (2*STM32_PCLK1_FREQUENCY)\n195: #define STM32_APB1_TIM3_CLKIN   (2*STM32_PCLK1_FREQUENCY)\n196: #define STM32_APB1_TIM4_CLKIN   (2*STM32_PCLK1_FREQUENCY)\n197: #define STM32_APB1_TIM5_CLKIN   (2*STM32_PCLK1_FREQUENCY)\n198: #define STM32_APB1_TIM6_CLKIN   (2*STM32_PCLK1_FREQUENCY)\n199: #define STM32_APB1_TIM7_CLKIN   (2*STM32_PCLK1_FREQUENCY)\n200: #define STM32_APB1_TIM12_CLKIN  (2*STM32_PCLK1_FREQUENCY)\n201: #define STM32_APB1_TIM13_CLKIN  (2*STM32_PCLK1_FREQUENCY)\n202: #define STM32_APB1_TIM14_CLKIN  (2*STM32_PCLK1_FREQUENCY)\n203: \n204: /* Timers driven from APB2 will be twice PCLK2 */\n205: \n206: #define STM32_APB2_TIM1_CLKIN   (2*STM32_PCLK2_FREQUENCY)\n207: #define STM32_APB2_TIM8_CLKIN   (2*STM32_PCLK2_FREQUENCY)\n208: #define STM32_APB2_TIM15_CLKIN  (2*STM32_PCLK2_FREQUENCY)\n209: #define STM32_APB2_TIM16_CLKIN  (2*STM32_PCLK2_FREQUENCY)\n210: #define STM32_APB2_TIM17_CLKIN  (2*STM32_PCLK2_FREQUENCY)\n211: \n212: /* Kernel Clock Configuration\n213:  *\n214:  * Note: look at Table 54 in ST Manual\n215:  */\n216: \n217: /* I2C123 clock source - HSI */\n218: \n219: #define STM32_RCC_D2CCIP2R_I2C123SRC RCC_D2CCIP2R_I2C123SEL_HSI\n220: \n221: /* I2C4 clock source - HSI */\n222: \n223: #define STM32_RCC_D3CCIPR_I2C4SRC    RCC_D3CCIPR_I2C4SEL_HSI\n224: \n225: /* SPI123 clock source - PLL1Q */\n226: \n227: #define STM32_RCC_D2CCIP1R_SPI123SRC RCC_D2CCIP1R_SPI123SEL_PLL1\n228: \n229: /* SPI45 clock source - APB (PCLK2?) */\n230: \n231: #define STM32_RCC_D2CCIP1R_SPI45SRC  RCC_D2CCIP1R_SPI45SEL_APB\n232: \n233: /* SPI6 clock source - APB (PCLK4) */\n234: \n235: #define STM32_RCC_D3CCIPR_SPI6SRC    RCC_D3CCIPR_SPI6SEL_PCLK4\n236: \n237: /* USB 1 and 2 clock source - HSI48 */\n238: \n239: #define STM32_RCC_D2CCIP2R_USBSRC    RCC_D2CCIP2R_USBSEL_HSI48\n240: \n241: /* ADC 1 2 3 clock source - pll2_pclk */\n242: \n243: #define STM32_RCC_D3CCIPR_ADCSRC     RCC_D3CCIPR_ADCSEL_PLL2\n244: \n245: /* FLASH wait states\n246:  *\n247:  *  ------------ ---------- -----------\n248:  *  Vcore        MAX ACLK   WAIT STATES\n249:  *  ------------ ---------- -----------\n250:  *  1.15-1.26 V     70 MHz    0\n251:  *  (VOS1 level)   140 MHz    1\n252:  *                 210 MHz    2\n253:  *  1.05-1.15 V     55 MHz    0\n254:  *  (VOS2 level)   110 MHz    1\n255:  *                 165 MHz    2\n256:  *                 220 MHz    3\n257:  *  0.95-1.05 V     45 MHz    0\n258:  *  (VOS3 level)    90 MHz    1\n259:  *                 135 MHz    2\n260:  *                 180 MHz    3\n261:  *                 225 MHz    4\n262:  *  ------------ ---------- -----------\n263:  */\n264: \n265: #define BOARD_FLASH_WAITSTATES 4\n266: \n267: /* SDMMC definitions ********************************************************/\n268: \n269: /* Init 400kHz, PLL1Q/(2*250) */\n270: \n271: #define STM32_SDMMC_INIT_CLKDIV     (250 << STM32_SDMMC_CLKCR_CLKDIV_SHIFT)\n272: \n273: /* Just set these to 25 MHz for now,\n274:  * PLL1Q/(2*4), for default speed 12.5MB/s\n275:  */\n276: \n277: #define STM32_SDMMC_MMCXFR_CLKDIV   (4 << STM32_SDMMC_CLKCR_CLKDIV_SHIFT)\n278: #define STM32_SDMMC_SDXFR_CLKDIV    (4 << STM32_SDMMC_CLKCR_CLKDIV_SHIFT)\n279: \n280: #define STM32_SDMMC_CLKCR_EDGE      STM32_SDMMC_CLKCR_NEGEDGE\n281: \n282: /* Ethernet definitions *****************************************************/\n283: \n284: #define GPIO_ETH_RMII_TXD0    GPIO_ETH_RMII_TXD0_2    /* PG13 */\n285: #define GPIO_ETH_RMII_TXD1    GPIO_ETH_RMII_TXD1_1    /* PB 13 */\n286: #define GPIO_ETH_RMII_TX_EN   GPIO_ETH_RMII_TX_EN_2\n287: \n288: /* LED definitions **********************************************************/\n289: \n290: /* The Nucleo-144 board has numerous LEDs but only three, LD1 a Green LED,\n291:  * LD2 a Blue LED and LD3 a Red LED, that can be controlled by software.\n292:  * The following definitions assume the default Solder Bridges are installed.\n293:  *\n294:  * If CONFIG_ARCH_LEDS is not defined, then the user can control the LEDs in\n295:  * any way.\n296:  * The following definitions are used to access individual LEDs.\n297:  */\n298: \n299: /* LED index values for use with board_userled() */\n300: \n301: #define BOARD_LED1        0\n302: #define BOARD_LED2        1\n303: #define BOARD_LED3        2\n304: #define BOARD_NLEDS       3\n305: \n306: #define BOARD_LED_GREEN   BOARD_LED1\n307: #define BOARD_LED_BLUE    BOARD_LED2\n308: #define BOARD_LED_RED     BOARD_LED3\n309: \n310: /* LED bits for use with board_userled_all() */\n311: \n312: #define BOARD_LED1_BIT    (1 << BOARD_LED1)\n313: #define BOARD_LED2_BIT    (1 << BOARD_LED2)\n314: #define BOARD_LED3_BIT    (1 << BOARD_LED3)\n315: \n316: /* If CONFIG_ARCH_LEDS is defined, the usage by the board port is defined in\n317:  * include/board.h and src/stm32_leds.c.\n318:  * The LEDs are used to encode OS-related events as follows:\n319:  *\n320:  *\n321:  *   SYMBOL                     Meaning                      LED state\n322:  *                                                        Red   Green Blue\n323:  *   ----------------------  --------------------------  ------ ------ ---\n324:  */\n325: \n326: #define LED_STARTED        0 /* NuttX has been started   OFF    OFF   OFF  */\n327: #define LED_HEAPALLOCATE   1 /* Heap has been allocated  OFF    OFF   ON   */\n328: #define LED_IRQSENABLED    2 /* Interrupts enabled       OFF    ON    OFF  */\n329: #define LED_STACKCREATED   3 /* Idle stack created       OFF    ON    ON   */\n330: #define LED_INIRQ          4 /* In an interrupt          N/C    N/C   GLOW */\n331: #define LED_SIGNAL         5 /* In a signal handler      N/C    GLOW  N/C  */\n332: #define LED_ASSERTION      6 /* An assertion failed      GLOW   N/C   GLOW */\n333: #define LED_PANIC          7 /* The system has crashed   Blink  OFF   N/C  */\n334: #define LED_IDLE           8 /* MCU is is sleep mode     ON     OFF   OFF  */\n335: \n336: /* Thus if the Green LED is statically on, NuttX has successfully booted and\n337:  * is, apparently, running normally.  If the Red LED is flashing at\n338:  * approximately 2Hz, then a fatal error has been detected and the system\n339:  * has halted.\n340:  */\n341: \n342: /* Button definitions *******************************************************/\n343: \n344: /* The NUCLEO board supports one button:  Pushbutton B1, labeled \"User\", is\n345:  * connected to GPIO PI11.\n346:  * A high value will be sensed when the button is depressed.\n347:  */\n348: \n349: #define BUTTON_USER        0\n350: #define NUM_BUTTONS        1\n351: #define BUTTON_USER_BIT    (1 << BUTTON_USER)\n352: \n353: /* Alternate function pin selections ****************************************/\n354: \n355: /* USART1 (Arduino Serial Shield) */\n356: \n357: #define GPIO_USART1_RX    (GPIO_USART1_RX_3) /* PB7 */\n358: #define GPIO_USART1_TX    (GPIO_USART1_TX_3) /* PB6 */\n359: \n360: /* USART3 (Nucleo Virtual Console) */\n361: \n362: #define GPIO_USART3_RX     GPIO_USART3_RX_3  /* PD9 */\n363: #define GPIO_USART3_TX     GPIO_USART3_TX_3  /* PD8 */\n364: \n365: #define DMAMAP_USART3_RX DMAMAP_DMA12_USART3RX_0\n366: #define DMAMAP_USART3_TX DMAMAP_DMA12_USART3TX_1\n367: \n368: /****************************************************************************\n369:  * Public Data\n370:  ****************************************************************************/\n371: \n372: #ifndef __ASSEMBLY__\n373: \n374: #undef EXTERN\n375: #if defined(__cplusplus)\n376: #define EXTERN extern \"C\"\n377: extern \"C\"\n378: {\n379: #else\n380: #define EXTERN extern\n381: #endif\n382: \n383: /****************************************************************************\n384:  * Public Function Prototypes\n385:  ****************************************************************************/\n386: \n387: #undef EXTERN\n388: #if defined(__cplusplus)\n389: }\n390: #endif\n391: \n392: #endif /* __ASSEMBLY__ */\n393: #endif /* __BOARDS_ARM_STM32H7_NUCLEO_H745ZI_INCLUDE_BOARD_H */\n\n(End of file - total 393 lines)\n</content>",
