            "output": "<path>/workspace/arch/arm/src/stm32h7/stm32_qencoder.h</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * arch/arm/src/stm32h7/stm32_qencoder.h\n3:  *\n4:  * Licensed to the Apache Software Foundation (ASF) under one or more\n5:  * contributor license agreements.  See the NOTICE file distributed with\n6:  * this work for additional information regarding copyright ownership.  The\n7:  * ASF licenses this file to you under the Apache License, Version 2.0 (the\n8:  * \"License\"); you may not use this file except in compliance with the\n9:  * License.  You may obtain a copy of the License at\n10:  *\n11:  *   http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n15:  * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n16:  * License for the specific language governing permissions and limitations\n17:  * under the License.\n18:  *\n19:  ****************************************************************************/\n20: \n21: #ifndef __ARCH_ARM_SRC_STM32H7_STM32_QENCODER_H\n22: #define __ARCH_ARM_SRC_STM32H7_STM32_QENCODER_H\n23: \n24: /****************************************************************************\n25:  * Included Files\n26:  ****************************************************************************/\n27: \n28: #include <nuttx/config.h>\n29: \n30: #include \"chip.h\"\n31: \n32: #ifdef CONFIG_SENSORS_QENCODER\n33: \n34: /****************************************************************************\n35:  * Included Files\n36:  ****************************************************************************/\n37: \n38: /* Timer devices may be used for different purposes.  One special purpose is\n39:  * as a quadrature encoder input device.  If CONFIG_STM32H7_TIMn is defined\n40:  * then the CONFIG_STM32H7_TIMn_QE must also be defined to indicate that\n41:  * timer \"n\" is intended to be used for as a quadrature encoder.\n42:  */\n43: \n44: #ifndef CONFIG_STM32H7_TIM1\n45: #  undef CONFIG_STM32H7_TIM1_QE\n46: #endif\n47: #ifndef CONFIG_STM32H7_TIM2\n48: #  undef CONFIG_STM32H7_TIM2_QE\n49: #endif\n50: #ifndef CONFIG_STM32H7_TIM3\n51: #  undef CONFIG_STM32H7_TIM3_QE\n52: #endif\n53: #ifndef CONFIG_STM32H7_TIM4\n54: #  undef CONFIG_STM32H7_TIM4_QE\n55: #endif\n56: #ifndef CONFIG_STM32H7_TIM5\n57: #  undef CONFIG_STM32H7_TIM5_QE\n58: #endif\n59: #ifndef CONFIG_STM32H7_TIM8\n60: #  undef CONFIG_STM32H7_TIM8_QE\n61: #endif\n62: \n63: /* Only timers 2-5, and 1 & 8 can be used as a quadrature encoder\n64:  * (at least for the STM32 H7)\n65:  */\n66: \n67: #undef CONFIG_STM32H7_TIM6_QE\n68: #undef CONFIG_STM32H7_TIM7_QE\n69: #undef CONFIG_STM32H7_TIM9_QE\n70: #undef CONFIG_STM32H7_TIM10_QE\n71: #undef CONFIG_STM32H7_TIM11_QE\n72: #undef CONFIG_STM32H7_TIM12_QE\n73: #undef CONFIG_STM32H7_TIM13_QE\n74: #undef CONFIG_STM32H7_TIM14_QE\n75: \n76: /* Clock out frequency.  This value is used to calculation the timer CLKIN in\n77:  * prescaler value.\n78:  */\n79: \n80: #ifndef CONFIG_STM32H7_TIM1_QECLKOUT\n81: #  define CONFIG_STM32H7_TIM1_QECLKOUT 28000000\n82: #endif\n83: \n84: #ifndef CONFIG_STM32H7_TIM2_QECLKOUT\n85: #  define CONFIG_STM32H7_TIM2_QECLKOUT 28000000\n86: #endif\n87: \n88: #ifndef CONFIG_STM32H7_TIM3_QECLKOUT\n89: #  define CONFIG_STM32H7_TIM3_QECLKOUT 28000000\n90: #endif\n91: \n92: #ifndef CONFIG_STM32H7_TIM4_QECLKOUT\n93: #  define CONFIG_STM32H7_TIM4_QECLKOUT 28000000\n94: #endif\n95: \n96: #ifndef CONFIG_STM32H7_TIM5_QECLKOUT\n97: #  define CONFIG_STM32H7_TIM5_QECLKOUT 28000000\n98: #endif\n99: \n100: #ifndef CONFIG_STM32H7_TIM8_QECLKOUT\n101: #  define CONFIG_STM32H7_TIM8_QECLKOUT 28000000\n102: #endif\n103: \n104: /****************************************************************************\n105:  * Included Files\n106:  ****************************************************************************/\n107: \n108: /****************************************************************************\n109:  * Name: stm32_qeinitialize\n110:  *\n111:  * Description:\n112:  *   Initialize a quadrature encoder interface.  This function must be\n113:  *   called from board-specific logic..\n114:  *\n115:  * Input Parameters:\n116:  *   devpath - The full path to the driver to register. E.g., \"/dev/qe0\"\n117:  *   tim     - The timer number to used.  'tim' must be an element of\n118:  *             {1,2,3,4,5,8}\n119:  *\n120:  * Returned Value:\n121:  *   Zero on success; A negated errno value is returned on failure.\n122:  *\n123:  ****************************************************************************/\n124: \n125: int stm32_qeinitialize(const char *devpath, int tim);\n126: \n127: #endif /* CONFIG_SENSORS_QENCODER */\n128: #endif /* __ARCH_ARM_SRC_STM32H7_STM32_QENCODER_H */\n\n(End of file - total 128 lines)\n</content>",
