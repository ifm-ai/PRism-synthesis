:  *   to a class driver.\n99:  *\n100:  * Assumptions:\n101:  * - This function should called in the initialization sequence in order\n102:  *   to initialize the USB device functionality.\n103:  * - Class drivers should be initialized prior to calling this function.\n104:  *   Otherwise, there is a race condition if the device is already connected.\n105:  *\n106:  ****************************************************************************/\n107: \n108: #ifdef CONFIG_USBHOST\n109: struct usbhost_connection_s;\n110: struct usbhost_connection_s *stm32_otgfshost_initialize(int controller);\n111: #endif\n112: \n113: /****************************************************************************\n114:  * Name:  stm32_usbsuspend\n115:  *\n116:  * Description:\n117:  *   Board logic must provide the stm32_usbsuspend logic if the OTG FS\n118:  *   device driver is used.  This function is called whenever the USB enters\n119:  *   or leaves suspend mode. This is an opportunity for the board logic to\n120:  *   shutdown clocks, power, etc. while the USB is suspended.\n121:  *\n122:  ****************************************************************************/\n123: \n124: struct usbdev_s;\n125: void stm32_usbsuspend(struct usbdev_s *dev, bool resume);\n126: \n127: #ifdef CONFIG_STM32H7_OTGHS_EXTERNAL_ULPI\n128: /****************************************************************************\n129:  * Name:  stm32_usbulpireset\n130:  *\n131:  * Description:\n132:  *   Reset external ULPI.\n133:  *\n134:  ****************************************************************************/\n135: \n136: struct usbdev_s;\n137: void stm32_usbulpireset(struct usbdev_s *dev);\n138: #endif\n139: \n140: #undef EXTERN\n141: #if defined(__cplusplus)\n142: }\n143: #endif\n144: \n145: #endif /* __ASSEMBLY__ */\n146: #endif /* CONFIG_STM32H7_OTGFS */\n147: #endif /* __ARCH_ARM_SRC_STM32H7_STM32_OTG_H */\n\n(End of file - total 147 lines)\n</content>",
