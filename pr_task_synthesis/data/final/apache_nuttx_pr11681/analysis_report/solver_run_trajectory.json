board.h>\n42: #  include \"hardware/stm32_tim.h\"\n43: #endif\n44: \n45: /****************************************************************************\n46:  * Pre-processor Definitions\n47:  ****************************************************************************/\n48: \n49: /* Configuration ************************************************************/\n50: \n51: /* Timer devices may be used for different purposes.  One special purpose is\n52:  * to generate modulated outputs for such things as motor control.\n53:  * If CONFIG_STM32H7_TIMn is defined then the CONFIG_STM32H7_TIMn_PWM must\n54:  * also be defined to indicate that timer \"n\" is intended to be used for\n55:  * pulsed output signal generation.\n56:  */\n57: \n58: #ifndef CONFIG_STM32H7_TIM1\n59: #  undef CONFIG_STM32H7_TIM1_PWM\n60: #endif\n61: #ifndef CONFIG_STM32H7_TIM2\n62: #  undef CONFIG_STM32H7_TIM2_PWM\n63: #endif\n64: #ifndef CONFIG_STM32H7_TIM3\n65: #  undef CONFIG_STM32H7_TIM3_PWM\n66: #endif\n67: #ifndef CONFIG_STM32H7_TIM4\n68: #  undef CONFIG_STM32H7_TIM4_PWM\n69: #endif\n70: #ifndef CONFIG_STM32H7_TIM5\n71: #  undef CONFIG_STM32H7_TIM5_PWM\n72: #endif\n73: #ifndef CONFIG_STM32H7_TIM8\n74: #  undef CONFIG_STM32H7_TIM8_PWM\n75: #endif\n76: #ifndef CONFIG_STM32H7_TIM12\n77: #  undef CONFIG_STM32H7_TIM12_PWM\n78: #endif\n79: #ifndef CONFIG_STM32H7_TIM13\n80: #  undef CONFIG_STM32H7_TIM13_PWM\n81: #endif\n82: #ifndef CONFIG_STM32H7_TIM14\n83: #  undef CONFIG_STM32H7_TIM14_PWM\n84: #endif\n85: #ifndef CONFIG_STM32H7_TIM15\n86: #  undef CONFIG_STM32H7_TIM15_PWM\n87: #endif\n88: #ifndef CONFIG_STM32H7_TIM16\n89: #  undef CONFIG_STM32H7_TIM16_PWM\n90: #endif\n91: #ifndef CONFIG_STM32H7_TIM17\n92: #  undef CONFIG_STM32H7_TIM17_PWM\n93: #endif\n94: \n95: /* The basic timers (timer 6 and 7) are not capable of generating output\n96:  * pulses\n97:  */\n98: \n99: #undef CONFIG_STM32H7_TIM6_PWM\n100: #undef CONFIG_STM32H7_TIM7_PWM\n101: \n102: /* Check if PWM support for any channel is enabled. */\n103: \n104: #ifdef CONFIG_STM32H7_PWM\n105: \n106: /* PWM driver channels configuration */\n107: \n108: #ifdef CONFIG_STM32H7_PWM_MULTICHAN\n109: \n110: #ifdef CONFIG_STM32H7_TIM1_CHANNEL1\n111: #  define PWM_TIM1_CHANNEL1 1\n112: #else\n113: #  define PWM_TIM1_CHANNEL1 0\n114: #endif\n115: #ifdef CONFIG_STM32H7_TIM1_CHANNEL2\n116: #  define PWM_TIM1_CHANNEL2 1\n117: #else\n118: #  define PWM_TIM1_CHANNEL2 0\n119: #endif\n120: #ifdef CONFIG_STM32H7_TIM1_CHANNEL3\n121: #  define PWM_TIM1_CHANNEL3 1\n122: #else\n123: #  define PWM_TIM1_CHANNEL3 0\n124: #endif\n125: #ifdef CONFIG_STM32H7_TIM1_CHANNEL4\n126: #  define PWM_TIM1_CHANNEL4 1\n127: #else\n128: #  define PWM_TIM1_CHANNEL4 0\n129: #endif\n130: #ifdef CONFIG_STM32H7_TIM1_CHANNEL5\n131: #  define PWM_TIM1_CHANNEL5 1\n132: #else\n133: #  define PWM_TIM1_CHANNEL5 0\n134: #endif\n135: #ifdef CONFIG_STM32H7_TIM1_CHANNEL6\n136: #  define PWM_TIM1_CHANNEL6 1\n137: #else\n138: #  define PWM_TIM1_CHANNEL6 0\n139: #endif\n140: #define PWM_TIM1_NCHANNELS (PWM_TIM1_CHANNEL1 + PWM_TIM1_CHANNEL2 + \\\n141:                             PWM_TIM1_CHANNEL3 + PWM_TIM1_CHANNEL4 + \\\n142:                             PWM_TIM1_CHANNEL5 + PWM_TIM1_CHANNEL6)\n143: \n144: #ifdef CONFIG_STM32H7_TIM2_CHANNEL1\n145: #  define PWM_TIM2_CHANNEL1 1\n146: #else\n147: #  define PWM_TIM2_CHANNEL1 0\n148: #endif\n149: #ifdef CONFIG_STM32H7_TIM2_CHANNEL2\n150: #  define PWM_TIM2_CHANNEL2 1\n151: #else\n152: #  define PWM_TIM2_CHANNEL2 0\n153: #endif\n154: #ifdef CONFIG_STM32H7_TIM2_CHANNEL3\n155: #  define PWM_TIM2_CHANNEL3 1\n156: #else\n157: #  define PWM_TIM2_CHANNEL3 0\n158: #endif\n159: #ifdef CONFIG_STM32H7_TIM2_CHANNEL4\n160: #  define PWM_TIM2_CHANNEL4 1\n161: #else\n162: #  define PWM_TIM2_CHANNEL4 0\n163: #endif\n164: #define PWM_TIM2_NCHANNELS (PWM_TIM2_CHANNEL1 + PWM_TIM2_CHANNEL2 + \\\n165:                             PWM_TIM2_CHANNEL3 + PWM_TIM2_CHANNEL4)\n166: \n167: #ifdef CONFIG_STM32H7_TIM3_CHANNEL1\n168: #  define PWM_TIM3_CHANNE