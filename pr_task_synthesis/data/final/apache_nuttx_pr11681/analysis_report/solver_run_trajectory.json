 = ADC_CCR_PRESC_DIV4;\n1628:       adc_clock = src_clock / 4;\n1629:     }\n1630:   else if (src_clock / 6 <= max_clock)\n1631:     {\n1632:       setbits = ADC_CCR_PRESC_DIV6;\n1633:       adc_clock = src_clock / 6;\n1634:     }\n1635:   else if (src_clock / 8 <= max_clock)\n1636:     {\n1637:       setbits = ADC_CCR_PRESC_DIV8;\n1638:       adc_clock = src_clock / 8;\n1639:     }\n1640:   else if (src_clock / 10 <= max_clock)\n1641:     {\n1642:       setbits = ADC_CCR_PRESC_DIV10;\n1643:       adc_clock = src_clock / 10;\n1644:     }\n1645:   else if (src_clock / 12 <= max_clock)\n1646:     {\n1647:       setbits = ADC_CCR_PRESC_DIV12;\n1648:       adc_clock = src_clock / 12;\n1649:     }\n1650:   else if (src_clock / 16 <= max_clock)\n1651:     {\n1652:       setbits = ADC_CCR_PRESC_DIV16;\n1653:       adc_clock = src_clock / 16;\n1654:     }\n1655:   else if (src_clock / 32 <= max_clock)\n1656:     {\n1657:       setbits = ADC_CCR_PRESC_DIV32;\n1658:       adc_clock = src_clock / 32;\n1659:     }\n1660:   else if (src_clock / 64 <= max_clock)\n1661:     {\n1662:       setbits = ADC_CCR_PRESC_DIV64;\n1663:       adc_clock = src_clock / 64;\n1664:     }\n1665:   else if (src_clock / 128 <= max_clock)\n1666:     {\n1667:       setbits = ADC_CCR_PRESC_DIV128;\n1668:       adc_clock = src_clock / 128;\n1669:     }\n1670:   else if (src_clock / 256 <= max_clock)\n1671:     {\n1672:       setbits = ADC_CCR_PRESC_DIV256;\n1673:       adc_clock = src_clock / 256;\n1674:     }\n1675:   else\n1676:     {\n1677:       aerr(\"ERROR: source clock too high\\n\");\n1678:     }\n1679: \n1680:   /* Write the prescaler to the CCR register */\n1681: \n1682:   adc_modifyregm(priv, STM32_ADC_CCR_OFFSET, ADC_CCR_PRESC_MASK, setbits);\n1683: \n1684:   if ((getreg32(STM32_DEBUGMCU_BASE) & DBGMCU_IDCODE_REVID_MASK) ==\n1685:       STM32_IDCODE_REVID_V)\n1686:     {\n1687:       if (adc_clock >= 25000000)\n1688:         {\n1689:           setbits = ADC_CR_BOOST_50_MHZ;\n1690:         }\