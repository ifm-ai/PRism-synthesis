              "content": "/****************************************************************************\n * boards/arm/stm32h7/nucleo-h745zi/src/stm32_qencoder.c\n *\n * Licensed to the Apache Software Foundation (ASF) under one or more\n * contributor license agreements.  See the NOTICE file distributed with\n * this work for additional information regarding copyright ownership.  The\n * ASF licenses this file to you under the Apache License, Version 2.0 (the\n * \"License\"); you may not use this file except in compliance with the\n * License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n * License for the specific language governing permissions and limitations\n * under the License.\n *\n ****************************************************************************/\n\n/****************************************************************************\n * Included Files\n ****************************************************************************/\n\n#include <nuttx/config.h>\n\n#include <errno.h>\n#include <debug.h>\n\n#include <nuttx/sensors/qencoder.h>\n#include <arch/board/board.h>\n\n#include \"chip.h\"\n#include \"arm_internal.h\"\n#include \"stm32_qencoder.h\"\n#include \"nucleo-h745zi.h\"\n\n/****************************************************************************\n * Pre-processor Definitions\n ****************************************************************************/\n\n/* Configuration ************************************************************/\n\n#define HAVE_QE 1\n\n#ifndef CONFIG_SENSORS_QENCODER\n#  undef HAVE_QE\n#endif\n\n#ifndef CONFIG_STM32H7_TIM2\n#  undef HAVE_QE\n#endif\n\n#ifndef CONFIG_STM32H7_TIM2_QE\n#  undef HAVE_QE\n#endif\n\n/****************************************************************************\n * Private Data\n ****************************************************************************/\n\n#ifdef HAVE_QE\n/* Timer 2 is used for quadrature encoder on Nucleo-H745ZI */\n\n#define NUCLEOH745ZI_QETIMER 2\n#endif\n\n/****************************************************************************\n * Public Functions\n ****************************************************************************/\n\n/****************************************************************************\n * Name: stm32_qencoder_setup\n *\n * Description:\n *   Initialize quadrature encoder and register the QE device.\n *\n ****************************************************************************/\n\nint stm32_qencoder_setup(void)\n{\n#ifdef HAVE_QE\n  static bool initialized = false;\n  int ret;\n\n  /* Have we already initialized? */\n\n  if (!initialized)\n    {\n      /* Initialize the quadrature encoder interface */\n\n      ret = stm32_qeinitialize(\"/dev/qe0\", NUCLEOH745ZI_QETIMER);\n      if (ret < 0)\n        {\n          snerr(\"ERROR: stm32_qeinitialize failed: %d\\n\", ret);\n          return ret;\n        }\n\n      /* Now we are initialized */\n\n      initialized = true;\n    }\n\n  return OK;\n#else\n  return -ENODEV;\n#endif\n}\n",
              "filePath": "/workspace/boards/arm/stm32h7/nucleo-h745zi/src/stm32_qencoder.c"
            },
