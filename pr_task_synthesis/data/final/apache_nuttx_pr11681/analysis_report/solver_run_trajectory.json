            "output": "<path>/workspace/boards/arm/stm32h7/nucleo-h743zi/src/stm32_usb.c</path>\n<type>file</type>\n<content>\n1: /****************************************************************************\n2:  * boards/arm/stm32h7/nucleo-h743zi/src/stm32_usb.c\n3:  *\n4:  * Licensed to the Apache Software Foundation (ASF) under one or more\n5:  * contributor license agreements.  See the NOTICE file distributed with\n6:  * this work for additional information regarding copyright ownership.  The\n7:  * ASF licenses this file to you under the Apache License, Version 2.0 (the\n8:  * \"License\"); you may not use this file except in compliance with the\n9:  * License.  You may obtain a copy of the License at\n10:  *\n11:  *   http://www.apache.org/licenses/LICENSE-2.0\n12:  *\n13:  * Unless required by applicable law or agreed to in writing, software\n14:  * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n15:  * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n16:  * License for the specific language governing permissions and limitations\n17:  * under the License.\n18:  *\n19:  ****************************************************************************/\n20: \n21: /****************************************************************************\n22:  * Included Files\n23:  ****************************************************************************/\n24: \n25: #include <nuttx/config.h>\n26: \n27: #include <sys/types.h>\n28: #include <stdint.h>\n29: #include <stdbool.h>\n30: #include <sched.h>\n31: #include <errno.h>\n32: #include <assert.h>\n33: #include <debug.h>\n34: \n35: #include <nuttx/kthread.h>\n36: #include <nuttx/usb/usbdev.h>\n37: #include <nuttx/usb/usbhost.h>\n38: #include <nuttx/usb/usbdev_trace.h>\n39: \n40: #include \"arm_internal.h\"\n41: #include \"chip.h\"\n42: #include \"stm32_gpio.h\"\n43: #include \"stm32_otg.h\"\n44: #include \"nucleo-h743zi.h\"\n45: \n46: #ifdef CONFIG_STM32H7_OTGFS\n47: \n48: /****************************************************************************\n49:  * Pre-processor Definitions\n50:  ****************************************************************************/\n51: \n52: #if defined(CONFIG_USBDEV) || defined(CONFIG_USBHOST)\n53: #  define HAVE_USB 1\n54: #else\n55: #  warning \"CONFIG_STM32_OTGFS is enabled but neither CONFIG_USBDEV nor CONFIG_USBHOST\"\n56: #  undef HAVE_USB\n57: #endif\n58: \n59: #ifndef CONFIG_NUCLEOH743ZI_USBHOST_PRIO\n60: #  define CONFIG_NUCLEOH743ZI_USBHOST_PRIO 100\n61: #endif\n62: \n63: #ifndef CONFIG_NUCLEOH743ZI_USBHOST_STACKSIZE\n64: #  define CONFIG_NUCLEOH743ZI_USBHOST_STACKSIZE 1024\n65: #endif\n66: \n67: /****************************************************************************\n68:  * Private Data\n69:  ****************************************************************************/\n70: \n71: #ifdef CONFIG_USBHOST\n72: static struct usbhost_connection_s *g_usbconn;\n73: #endif\n74: \n75: /****************************************************************************\n76:  * Private Functions\n77:  ****************************************************************************/\n78: \n79: /****************************************************************************\n80:  * Name: usbhost_waiter\n81:  *\n82:  * Description:\n83:  *   Wait for USB devices to be connected.\n84:  *\n85:  ****************************************************************************/\n86: \n87: #ifdef CONFIG_USBHOST\n88: static int usbhost_waiter(int argc, char *argv[])\n89: {\n90:   struct usbhost_hubport_s *hport;\n91: \n92:   uinfo(\"Running\\n\");\n93:   for (; ; )\n94:     {\n95:       /* Wait for the device to change state */\n96: \n97:       DEBUGVERIFY(CONN_WAIT(g_usbconn, &hport));\n98:       uinfo(\"%s\\n\", hport->connected ? \"connected\" : \"disconnected\");\n99: \n100:       /* Did we just become connected? */\n101: \n102:       if (hport->connected)\n103:         {\n104:           /* Yes.. enumerate the newly connected device */\n105: \n106:           CONN_ENUMERATE(g_usbconn, hport);\n107:         }\n108:     }\n109: \n110:   /* Keep the compiler from complaining */\n111: \n112:   return 0;\n113: }\n114: #endif\n115: \n116: /****************************************************************************\n117:  * Public Functions\n118:  ****************************************************************************/\n119: \n120: /****************************************************************************\n121:  * Name: stm32_usbinitialize\n122:  *\n123:  * Description:\n124:  *   Called from stm32_usbinitialize very early in inialization to setup\n125:  *   USB-related GPIO pins for the nucleo-144 board.\n126:  *\n127:  ****************************************************************************/\n128: \n129: void stm32_usbinitialize(void)\n130: {\n131:   /* The OTG FS has an internal soft pull-up.\n132:    * No GPIO configuration is required\n133:    */\n134: \n135:   /* Configure the OTG FS VBUS sensing GPIO,\n136:    * Power On, and Overcurrent GPIOs\n137:    */\n138: \n139: #ifdef CONFIG_STM32H7_OTGFS\n140:   stm32_configgpio(GPIO_OTGFS_VBUS);\n141:   stm32_configgpio(GPIO_OTGFS_PWRON);\n142:   stm32_configgpio(GPIO_OTGFS_OVER);\n143: #endif\n144: }\n145: \n146: /****************************************************************************\n147:  * Name: stm32_usbhost_initialize\n148:  *\n149:  * Description:\n150:  *   Called at application startup time to initialize the USB host\n151:  *   functionality.\n152:  *   This function will start a thread that will monitor for device\n153:  *   connection/disconnection events.\n154:  *\n155:  ****************************************************************************/\n156: \n157: #ifdef CONFIG_USBHOST\n158: int stm32_usbhost_initialize(void)\n159: {\n160:   int ret;\n161: \n162:   /* First, register all of the class drivers needed to support the drivers\n163:    * that we care about:\n164:    */\n165: \n166:   uinfo(\"Register class drivers\\n\");\n167: \n168: #ifdef CONFIG_USBHOST_HUB\n169:   /* Initialize USB hub class support */\n170: \n171:   ret = usbhost_hub_initialize();\n172:   if (ret < 0)\n173:     {\n174:       uerr(\"ERROR: usbhost_hub_initialize failed: %d\\n\", ret);\n175:     }\n176: #endif\n177: \n178: #ifdef CONFIG_USBHOST_MSC\n179:   /* Register the USB mass storage class class */\n180: \n181:   ret = usbhost_msc_initialize();\n182:   if (ret != OK)\n183:     {\n184:       uerr(\"ERROR: Failed to register the mass storage class: %d\\n\", ret);\n185:     }\n186: #endif\n187: \n188: #ifdef CONFIG_USBHOST_CDCACM\n189:   /* Register the CDC/ACM serial class */\n190: \n191:   ret = usbhost_cdcacm_initialize();\n192:   if (ret != OK)\n193:     {\n194:       uerr(\"ERROR: Failed to register the CDC/ACM serial class: %d\\n\", ret);\n195:     }\n196: #endif\n197: \n198: #ifdef CONFIG_USBHOST_HIDKBD\n199:   /* Initialize the HID keyboard class */\n200: \n201:   ret = usbhost_kbdinit();\n202:   if (ret != OK)\n203:     {\n204:       uerr(\"ERROR: Failed to register the HID keyboard class\\n\");\n205:     }\n206: #endif\n207: \n208: #ifdef CONFIG_USBHOST_HIDMOUSE\n209:   /* Initialize the HID mouse class */\n210: \n211:   ret = usbhost_mouse_init();\n212:   if (ret != OK)\n213:     {\n214:       uerr(\"ERROR: Failed to register the HID mouse class\\n\");\n215:     }\n216: #endif\n217: \n218:   /* Then get an instance of the USB host interface */\n219: \n220:   uinfo(\"Initialize USB host\\n\");\n221:   g_usbconn = stm32_otgfshost_initialize(0);\n222:   if (g_usbconn)\n223:     {\n224:       /* Start a thread to handle device connection. */\n225: \n226:       uinfo(\"Start usbhost_waiter\\n\");\n227: \n228:       ret = kthread_create(\"usbhost\", CONFIG_NUCLEOH743ZI_USBHOST_PRIO,\n229:                            CONFIG_NUCLEOH743ZI_USBHOST_STACKSIZE,\n230:                            usbhost_waiter, NULL);\n231:       return ret < 0 ? -ENOEXEC : OK;\n232:     }\n233: \n234:   return -ENODEV;\n235: }\n236: #endif\n237: \n238: /****************************************************************************\n239:  * Name: stm32_usbhost_vbusdrive\n240:  *\n241:  * Description:\n242:  *   Enable/disable driving of VBUS 5V output. This function must be\n243:  *   provided be each platform that implements the STM32 OTG FS host\n244:  *   interface\n245:  *\n246:  *   \"On-chip 5 V VBUS generation is not supported. For this reason, a\n247:  *    charge pump or, if 5 V are available on the application board, a\n248:  *    basic power switch, must be added externally to drive the 5 V VBUS\n249:  *    line. The external charge pump can be driven by any GPIO output.\n250:  *    When the application decides to power on VBUS using the chosen GPIO,\n251:  *    it must also set the port power bit in the host port control and status\n252:  *    register (PPWR bit in OTG_FS_HPRT).\n253:  *\n254:  *   \"The application uses this field to control power to this port, and\n255:  *    the core clears this bit on an overcurrent condition.\"\n256:  *\n257:  * Input Parameters:\n258:  *   iface - For future growth to handle multiple USB host interface.\n259:  *           Should be zero.\n260:  *   enable - true: enable VBUS power; false: disable VBUS power\n261:  *\n262:  * Returned Value:\n263:  *   None\n264:  *\n265:  ****************************************************************************/\n266: \n267: #ifdef CONFIG_USBHOST\n268: void stm32_usbhost_vbusdrive(int iface, bool enable)\n269: {\n270:   DEBUGASSERT(iface == 0);\n271: \n272:   /* Set the Power Switch by driving the active high enable pin */\n273: \n274:   stm32_gpiowrite(GPIO_OTGFS_PWRON, enable);\n275: }\n276: #endif\n277: \n278: /****************************************************************************\n279:  * Name: stm32_setup_overcurrent\n280:  *\n281:  * Description:\n282:  *   Setup to receive an interrupt-level callback if an overcurrent\n283:  *   condition is detected.\n284:  *\n285:  * Input Parameters:\n286:  *   handler - New overcurrent interrupt handler\n287:  *   arg     - The argument provided for the interrupt handler\n288:  *\n289:  * Returned Value:\n290:  *   Zero (OK) is returned on success.  Otherwise, a negated errno value\n291:  *   is returned to indicate the nature of the failure.\n292:  *\n293:  ****************************************************************************/\n294: \n295: #ifdef CONFIG_USBHOST\n296: int stm32_setup_overcurrent(xcpt_t handler, void *arg)\n297: {\n298:   return stm32_gpiosetevent(GPIO_OTGFS_OVER, true, true, true, handler, arg);\n299: }\n300: #endif\n301: \n302: /****************************************************************************\n303:  * Name:  stm32_usbsuspend\n304:  *\n305:  * Description:\n306:  *   Board logic must provide the stm32_usbsuspend logic if the USBDEV\n307:  *   driver is used. This function is called whenever the USB enters or\n308:  *   leaves suspend mode. This is an opportunity for the board logic to\n309:  *   shutdown clocks, power, etc. while the USB is suspended.\n310:  *\n311:  ****************************************************************************/\n312: \n313: #ifdef CONFIG_USBDEV\n314: void stm32_usbsuspend(struct usbdev_s *dev, bool resume)\n315: {\n316:   uinfo(\"resume: %d\\n\", resume);\n317: }\n318: #endif\n319: \n320: #endif /* CONFIG_STM32_OTGFS */\n\n(End of file - total 320 lines)\n</content>",
