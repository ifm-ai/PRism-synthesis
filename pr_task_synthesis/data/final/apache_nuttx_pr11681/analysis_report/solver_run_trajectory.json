***************************\n43:  * Name: qe_devinit\n44:  *\n45:  * Description:\n46:  *   All STM32H7 architectures must provide the following interface to work\n47:  *   with examples/qencoder.\n48:  *\n49:  ****************************************************************************/\n50: \n51: int stm32_qencoder_initialize(const char *devpath, int timer)\n52: {\n53:   int ret;\n54: \n55:   /* Initialize a quadrature encoder interface. */\n56: \n57:   sninfo(\"Initializing the quadrature encoder using TIM%d\\n\", timer);\n58:   ret = stm32_qeinitialize(devpath, timer);\n59:   if (ret < 0)\n60:     {\n61:       snerr(\"ERROR: stm32_qeinitialize failed: %d\\n\", ret);\n62:     }\n63: \n64:   return ret;\n65: }\n\n(End of file - total 65 lines)\n</content>",
