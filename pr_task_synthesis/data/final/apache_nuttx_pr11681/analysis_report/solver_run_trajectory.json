: #    undef  ADC1_HAVE_TIMER\n199: #endif\n200: \n201: #ifdef ADC1_HAVE_TIMER\n202: #  ifndef CONFIG_STM32H7_ADC1_SAMPLE_FREQUENCY\n203: #    error \"CONFIG_STM32H7_ADC1_SAMPLE_FREQUENCY not defined\"\n204: #  endif\n205: #  ifndef CONFIG_STM32H7_ADC1_TIMTRIG\n206: #    error \"CONFIG_STM32H7_ADC1_TIMTRIG not defined\"\n207: #    warning \"Values 0:CC1 1:CC2 2:CC3 3:CC4 4:TRGO\"\n208: #  endif\n209: #endif\n210: \n211: #if defined(CONFIG_STM32H7_TIM1_ADC2)\n212: #    define ADC2_HAVE_TIMER           1\n213: #    define ADC2_TIMER_BASE           STM32_TIM1_BASE\n214: #    define ADC2_TIMER_PCLK_FREQUENCY STM32_APB2_TIM1_CLKIN\n215: #    define ADC2_TIMER_RCC_ENR        STM32_RCC_APB2ENR\n216: #    define ADC2_TIMER_RCC_EN         RCC_APB2ENR_TIM1EN\n217: #elif defined(CONFIG_STM32H7_TIM2_ADC2)\n218: #    define ADC2_HAVE_TIMER           1\n219: #    define ADC2_TIMER_BASE           STM32_TIM2_BASE\n220: #    define ADC2_TIMER_PCLK_FREQUENCY STM32_APB1_TIM2_CLKIN\n221: #    define ADC2_TIMER_RCC_ENR        STM32_RCC_APB1LENR\n222: #    define ADC2_TIMER_RCC_EN         RCC_APB1LENR_TIM2EN\n223: #elif defined(CONFIG_STM32H7_TIM3_ADC2)\n224: #    define ADC2_HAVE_TIMER           1\n225: #    define ADC2_TIMER_BASE           STM32_TIM3_BASE\n226: #    define ADC2_TIMER_PCLK_FREQUENCY STM32_APB1_TIM3_CLKIN\n227: #    define ADC2_TIMER_RCC_ENR        STM32_RCC_APB1LENR\n228: #    define ADC2_TIMER_RCC_EN         RCC_APB1LENR_TIM3EN\n229: #elif defined(CONFIG_STM32H7_TIM4_ADC2)\n230: #    define ADC2_HAVE_TIMER           1\n231: #    define ADC2_TIMER_BASE           STM32_TIM4_BASE\n232: #    define ADC2_TIMER_PCLK_FREQUENCY STM32_APB1_TIM4_CLKIN\n233: #    define ADC2_TIMER_RCC_ENR        STM32_RCC_APB1LENR\n234: #    define ADC2_TIMER_RCC_EN         RCC_APB1LENR_TIM4EN\n235: #elif defined(CONFIG_STM32H7_TIM6_ADC2)\n236: #    define ADC2_HAVE_TIMER           1\n237: #    define ADC2_TIMER_BASE           STM32_TIM6_BASE\n238: #    define ADC2_TIMER_PCLK_FREQUENCY STM32_APB1