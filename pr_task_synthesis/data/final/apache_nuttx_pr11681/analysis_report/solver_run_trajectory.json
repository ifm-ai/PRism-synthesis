88: /* Low-level ops helpers ****************************************************/\n789: \n790: #ifdef CONFIG_STM32H7_PWM_LL_OPS\n791: \n792: /* NOTE:\n793:  *   low-level ops accept pwm_lowerhalf_s as first argument, but llops access\n794:  *   can be found in stm32_pwm_dev_s\n795:  */\n796: \n797: #define PWM_SETUP(dev)                                                             \\\n798:         (dev)->ops->setup((struct pwm_lowerhalf_s *)dev)\n799: #define PWM_SHUTDOWN(dev)                                                          \\\n800:         (dev)->ops->shutdown((struct pwm_lowerhalf_s *)dev)\n801: #define PWM_CCR_UPDATE(dev, index, ccr)                                            \\\n802:         (dev)->llops->ccr_update((struct pwm_lowerhalf_s *)dev, index, ccr)\n803: #define PWM_MODE_UPDATE(dev, index, mode)                                          \\\n804:         (dev)->llops->mode_update((struct pwm_lowerhalf_s *)dev, index, mode)\n805: #define PWM_CCR_GET(dev, index)                                                    \\\n806:         (dev)->llops->ccr_get((struct pwm_lowerhalf_s *)dev, index)\n807: #define PWM_ARR_UPDATE(dev, arr)                                                   \\\n808:         (dev)->llops->arr_update((struct pwm_lowerhalf_s *)dev, arr)\n809: #define PWM_ARR_GET(dev)                                                           \\\n810:         (dev)->llops->arr_get((struct pwm_lowerhalf_s *)dev)\n811: #define PWM_OUTPUTS_ENABLE(dev, out, state)                                        \\\n812:         (dev)->llops->outputs_enable((struct pwm_lowerhalf_s *)dev, out, state)\n813: #define PWM_SOFT_UPDATE(dev)                                                       \\\n814:         (dev)->llops->soft_update((struct pwm_lowerhalf_s *)dev)\n815: #define PWM_CONFIGURE(dev)                                                         \\\n816:         (dev)->llops->configure((struct pwm_lowerhalf_s *)dev)\n817: #define PWM_SOFT_BREAK(dev, state)        