          "callID": "call_04d79b31bf2447e8a0c2a3f5",
          "state": {
            "status": "completed",
            "input": {
              "content": "/****************************************************************************\n * boards/arm/stm32h7/nucleo-h745zi/src/stm32_bringup.c\n *\n * Licensed to the Apache Software Foundation (ASF) under one or more\n * contributor license agreements.  See the NOTICE file distributed with\n * this work for additional information regarding copyright ownership.  The\n * ASF licenses this file to you under the Apache License, Version 2.0 (the\n * \"License\"); you may not use this file except in compliance with the\n * License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n * License for the specific language governing permissions and limitations\n * under the License.\n *\n ****************************************************************************/\n\n/****************************************************************************\n * Included Files\n ****************************************************************************/\n\n#include <nuttx/config.h>\n\n#include <sys/types.h>\n#include <syslog.h>\n#include <errno.h>\n\n#include <arch/board/board.h>\n\n#include <nuttx/fs/fs.h>\n\n#ifdef CONFIG_RPTUN\n#  include \"stm32_rptun.h\"\n#endif\n#ifdef CONFIG_RPMSG_UART\n#  include <nuttx/serial/uart_rpmsg.h>\n#endif\n\n#ifdef CONFIG_ADC\n#  include \"stm32_adc.h\"\n#endif\n#ifdef CONFIG_DEV_GPIO\n#  include \"stm32_gpio.h\"\n#endif\n#ifdef CONFIG_PWM\n#  include \"stm32_pwm.h\"\n#endif\n#ifdef CONFIG_SENSORS_QENCODER\n#  include \"stm32_qencoder.h\"\n#endif\n#ifdef CONFIG_STM32H7_OTGFS\n#  include \"stm32_usb.h\"\n#endif\n\n#include \"nucleo-h745zi.h\"\n\n/****************************************************************************\n * Private Functions\n ****************************************************************************/\n\n/****************************************************************************\n * Public Functions\n ****************************************************************************/\n\n#ifdef CONFIG_RPMSG_UART\n/****************************************************************************\n * Name: rpmsg_serialinit\n ****************************************************************************/\n\nvoid rpmsg_serialinit(void)\n{\n#ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM7\n  uart_rpmsg_init(\"cm4\", \"proxy\", 4096, false);\n#endif\n\n#ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM4\n#  ifdef CONFIG_RPMSG_UART_CONSOLE\n  uart_rpmsg_init(\"cm7\", \"proxy\", 4096, true);\n#  else\n  uart_rpmsg_init(\"cm7\", \"proxy\", 4096, false);\n#  endif\n#endif\n}\n#endif\n\n/****************************************************************************\n * Name: stm32_bringup\n *\n * Description:\n *   Perform architecture-specific initialization\n *\n *   CONFIG_BOARD_LATE_INITIALIZE=y :\n *     Called from board_late_initialize().\n *\n *   CONFIG_BOARD_LATE_INITIALIZE=n && CONFIG_BOARDCTL=y &&\n *   CONFIG_NSH_ARCHINIT:\n *     Called from the NSH library\n *\n ****************************************************************************/\n\nint stm32_bringup(void)\n{\n  int ret = OK;\n\n  UNUSED(ret);\n\n#ifdef CONFIG_FS_PROCFS\n  /* Mount the procfs file system */\n\n  ret = nx_mount(NULL, STM32_PROCFS_MOUNTPOINT, \"procfs\", 0, NULL);\n  if (ret < 0)\n    {\n      syslog(LOG_ERR,\n             \"ERROR: Failed to mount the PROC filesystem: %d\\n\",  ret);\n    }\n#endif /* CONFIG_FS_PROCFS */\n\n#ifdef CONFIG_RPTUN\n#  ifdef CONFIG_ARCH_CHIP_STM32H7_CORTEXM7\n  stm32_rptun_init(\"cm4\");\n#  else\n  stm32_rptun_init(\"cm7\");\n#  endif\n#endif\n\n#ifdef CONFIG_ADC\n  /* Initialize ADC */\n\n  ret = stm32_adc_setup();\n  if (ret < 0)\n    {\n      syslog(LOG_ERR, \"ERROR: Failed to initialize ADC: %d\\n\", ret);\n    }\n  else\n    {\n      syslog(LOG_INFO, \"ADC initialized successfully\\n\");\n    }\n#endif\n\n#ifdef CONFIG_DEV_GPIO\n  /* Initialize GPIO */\n\n  ret = stm32_gpio_initialize();\n  if (ret < 0)\n    {\n      syslog(LOG_ERR, \"ERROR: Failed to initialize GPIO: %d\\n\", ret);\n    }\n  else\n    {\n      syslog(LOG_INFO, \"GPIO initialized successfully\\n\");\n    }\n#endif\n\n#ifdef CONFIG_PWM\n  /* Initialize PWM */\n\n  ret = stm32_pwm_setup();\n  if (ret < 0 && ret != -ENODEV)\n    {\n      syslog(LOG_ERR, \"ERROR: Failed to initialize PWM: %d\\n\", ret);\n    }\n  else if (ret == OK)\n    {\n      syslog(LOG_INFO, \"PWM initialized successfully\\n\");\n    }\n#endif\n\n#ifdef CONFIG_SENSORS_QENCODER\n  /* Initialize Quadrature Encoder */\n\n  ret = stm32_qencoder_setup();\n  if (ret < 0 && ret != -ENODEV)\n    {\n      syslog(LOG_ERR, \"ERROR: Failed to initialize Quadrature Encoder: %d\\n\", ret);\n    }\n  else if (ret == OK)\n    {\n      syslog(LOG_INFO, \"Quadrature Encoder initialized successfully\\n\");\n    }\n#endif\n\n#ifdef CONFIG_STM32H7_OTGFS\n  /* Initialize USB - call early pin configuration */\n\n  stm32_usbinitialize();\n\n#ifdef CONFIG_USBHOST\n  /* Initialize USB host */\n\n  ret = stm32_usbhost_initialize();\n  if (ret < 0 && ret != -ENODEV)\n    {\n      syslog(LOG_ERR, \"ERROR: Failed to initialize USB host: %d\\n\", ret);\n    }\n  else if (ret == OK)\n    {\n      syslog(LOG_INFO, \"USB host initialized successfully\\n\");\n    }\n#endif\n#endif\n\n  return OK;\n}\n",
              "filePath": "/workspace/boards/arm/stm32h7/nucleo-h745zi/src/stm32_bringup.c"
            },
