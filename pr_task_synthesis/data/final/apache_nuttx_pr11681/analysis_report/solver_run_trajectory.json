l purpose is\n40:  * to control periodic ADC sampling.  If CONFIG_STM32H7_TIMn is defined then\n41:  * CONFIG_STM32H7_TIMn_ADC must also be defined to indicate that timer \"n\"\n42:  * is intended to be used for that purpose. Timers 1,2,3,6 and 15 may be\n43:  * used on STM32H7X3, while STM32H7X6 adds support for timers 4 and 8 as\n44:  * well.\n45:  */\n46: \n47: #ifndef CONFIG_STM32H7_TIM1\n48: #  undef CONFIG_STM32H7_TIM1_ADC\n49: #  undef CONFIG_STM32H7_TIM1_ADC1\n50: #  undef CONFIG_STM32H7_TIM1_ADC2\n51: #  undef CONFIG_STM32H7_TIM1_ADC3\n52: #endif\n53: #ifndef CONFIG_STM32H7_TIM2\n54: #  undef CONFIG_STM32H7_TIM2_ADC\n55: #  undef CONFIG_STM32H7_TIM2_ADC1\n56: #  undef CONFIG_STM32H7_TIM2_ADC2\n57: #  undef CONFIG_STM32H7_TIM2_ADC3\n58: #endif\n59: #ifndef CONFIG_STM32H7_TIM3\n60: #  undef CONFIG_STM32H7_TIM3_ADC\n61: #  undef CONFIG_STM32H7_TIM3_ADC1\n62: #  undef CONFIG_STM32H7_TIM3_ADC2\n63: #  undef CONFIG_STM32H7_TIM3_ADC3\n64: #endif\n65: #ifndef CONFIG_STM32H7_TIM4\n66: #  undef CONFIG_STM32H7_TIM4_ADC\n67: #  undef CONFIG_STM32H7_TIM4_ADC1\n68: #  undef CONFIG_STM32H7_TIM4_ADC2\n69: #  undef CONFIG_STM32H7_TIM4_ADC3\n70: #endif\n71: #ifndef CONFIG_STM32H7_TIM6\n72: #  undef CONFIG_STM32H7_TIM6_ADC\n73: #  undef CONFIG_STM32H7_TIM6_ADC1\n74: #  undef CONFIG_STM32H7_TIM6_ADC2\n75: #  undef CONFIG_STM32H7_TIM6_ADC3\n76: #endif\n77: #ifndef CONFIG_STM32H7_TIM8\n78: #  undef CONFIG_STM32H7_TIM8_ADC\n79: #  undef CONFIG_STM32H7_TIM8_ADC1\n80: #  undef CONFIG_STM32H7_TIM8_ADC2\n81: #  undef CONFIG_STM32H7_TIM8_ADC3\n82: #endif\n83: #ifndef CONFIG_STM32H7_TIM15\n84: #  undef CONFIG_STM32H7_TIM15_ADC\n85: #  undef CONFIG_STM32H7_TIM15_ADC1\n86: #  undef CONFIG_STM32H7_TIM15_ADC2\n87: #  undef CONFIG_STM32H7_TIM15_ADC3\n88: #endif\n89: \n90: #if defined(CONFIG_STM32H7_ADC1) || defined(CONFIG_STM32H7_ADC2) || \\\n91:     defined(CONFIG_STM32H7_ADC3)\n92: \n93: /* ADC output to DFSDM support. Note that DFSDM and DMA are\n94:  * mutually exclusive.\n95:  */\n96: \n97: #undef ADC_HAVE_DFSDM\n98: #if defined(CONFIG_STM32H7_ADC1_OUTPUT_DFSDM) || \\\n99:     defined(CONFIG_STM32H7_ADC2_OUTPUT_DFSDM) || \\\n100:     defined(CONFIG_STM32H7_ADC3_OUTPUT_DFSDM)\n101: #  define ADC_HAVE_DFSDM\n102: #endif\n103: \n104: #if defined(CONFIG_STM32H7_ADC1_OUTPUT_DFSDM)\n105: #  define ADC1_HAVE_DFSDM 1\n106: #  undef  CONFIG_STM32H7_ADC1_DMA\n107: #else\n108: #  undef  ADC1_HAVE_DFSDM\n109: #endif\n110: \n111: #if defined(CONFIG_STM32H7_ADC2_OUTPUT_DFSDM)\n112: #  define ADC2_HAVE_DFSDM 1\n113: #  undef  CONFIG_STM32H7_ADC2_DMA\n114: #else\n115: #  undef  ADC2_HAVE_DFSDM\n116: #endif\n117: \n118: #if defined(CONFIG_STM32H7_ADC3_OUTPUT_DFSDM)\n119: #  define ADC3_HAVE_DFSDM 1\n120: #  undef  CONFIG_STM32H7_ADC3_DMA\n121: #else\n122: #  undef  ADC3_HAVE_DFSDM\n123: #endif\n124: \n125: /* DMA support */\n126: \n127: #undef ADC_HAVE_DMA\n128: #if defined(CONFIG_STM32H7_ADC1_DMA) || defined(CONFIG_STM32H7_ADC2_DMA) || \\\n129:     defined(CONFIG_STM32H7_ADC3_DMA)\n130: #  define ADC_HAVE_DMA  1\n131: #endif\n132: \n133: #ifdef CONFIG_STM32H7_ADC1_DMA\n134: #  define ADC1_HAVE_DMA 1\n135: #else\n136: #  undef  ADC1_HAVE_DMA\n137: #endif\n138: \n139: #ifdef CONFIG_STM32H7_ADC2_DMA\n140: #  define ADC2_HAVE_DMA 1\n141: #else\n142: #  undef  ADC2_HAVE_DMA\n143: #endif\n144: \n145: #ifdef CONFIG_STM32H7_ADC3_DMA\n146: #  define ADC3_HAVE_DMA 1\n147: #else\n148: #  undef  ADC3_HAVE_DMA\n149: #endif\n150: \n151: /* Timer configuration:  If a timer trigger is specified, then get\n152:  * information about the timer.\n153:  */\n154: \n155: #if defined(CONFIG_STM32H7_TIM1_ADC1)\n156: #    define ADC1_HAVE_TIMER           1\n157: #    define ADC1_TIMER_BASE           STM32_TIM1_BASE\n158: #    define ADC1_TIMER_PCLK_FREQUENCY STM32_APB2_TIM1_CLKIN\n159: #    define ADC1_TIMER_RCC_ENR        STM32_RCC_APB2ENR\n160: #    define ADC1_TIMER_RCC_EN         RCC_APB2ENR_TIM1EN\n161: #elif defined(CONFIG_STM32H7_TIM2_ADC1)\n162: #    define ADC1_HAVE_TIMER       