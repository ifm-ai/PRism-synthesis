fig,\n1531:                 verbose=verbose,\n1532:                 trace_id=trace_id,\n1533:             )\n1534: \n1535:             temp_data_group_uri = f\"{index_group_uri}/{PARTIAL_WRITE_ARRAY_DIR}\"\n1536:             temp_data_group = tiledb.Group(temp_data_group_uri, \"w\")\n1537:             create_partial_write_array_group(\n1538:                 temp_data_group=temp_data_group,\n1539:                 vector_type=vector_type,\n1540:                 dimensions=dimensions,\n1541:                 filters=storage_formats[storage_version][\"DEFAULT_ATTR_FILTERS\"],\n1542:                 create_index_array=False,\n1543:             )\n1544:             temp_data_group.close()\n1545:             temp_data_group = tiledb.Group(temp_data_group_uri)\n1546:             ids_array_uri = temp_data_group[IDS_ARRAY_NAME].uri\n1547:             parts_array_uri = temp_data_group[PARTS_ARRAY_NAME].uri\n1548:             temp_data_group.close()\n1549: \n1550:             parts_array = tiledb.open(\n1551:                 parts_array_uri, mode=\"w\", timestamp=index_timestamp\n1552:             )\n1553:             ids_array = tiledb.open(ids_array_uri, mode=\"w\", timestamp=index_timestamp)\n1554:             # Ingest base data\n1555:             write_offset = 0\n1556:             for part in range(0, size, batch):\n1557:                 part_end = part + batch\n1558:                 if part_end > size:\n1559:                     part_end = size\n1560:                 # First we get each vector and it's external id from the input data.\n1561:                 in_vectors = read_input_vectors(\n1562:                     source_uri=source_uri,\n1563:                     source_type=source_type,\n1564:                     vector_type=vector_type,\n1565:                     dimensions=dimensions,\n1566:                     start_pos=part,\n1567:                     end_pos=part_end,\n1568:                     config=config,\n1569:                     verbose=verbose,\n1570:                     trace_id=trace_id,\n1571:                 )\n1572:                 external_ids = read_external_ids(\n1573:                     external_ids_uri=external_ids_uri,\n1574:                     external_ids_type=external_ids_type,\n1575:                     start_pos=part,\n1576:                     end_pos=part_end,\n1577:                     config=config,\n1578:                     verbose=verbose,\n1579:                     trace_id=trace_id,\n1580:                 )\n1581: \n1582:                 # Then check if the external id is in the updated ids.\n1583:                 updates_filter = np.in1d(\n1584:                     external_ids, updated_ids, assume_unique=True, invert=True\n1585:                 )\n1586:                 # We only keep the vectors and external ids that are not in the updated ids.\n1587:                 in_vectors = in_vectors[updates_filter]\n1588:                 external_ids = external_ids[updates_filter]\n1589:                 vector_len = len(in_vectors)\n1590:                 if vector_len > 0:\n1591:                     end_offset = write_offset + vector_len\n1592:                     logger.debug(\"Vector read: %d\", vector_len)\n1593:                     logger.debug(\"Writing input data to array %s\", parts_array_uri)\n1594:                     # Write the not-updated vectors to the parts array.\n1595:                     parts_array[0:dimensions, write_offset:end_offset] = np.transpose(\n1596:                         in_vectors\n1597:                     )\n1598:                     logger.debug(\"Writing input data to array %s\", ids_array_uri)\n1599:                     # Write the not-updated external ids to the ids array.\n1600:                     ids_array[write_offset:end_offset] = external_ids\n1601:                     write_offset = end_offset\n1602: \n1603:             # Ingest additions\n1604:             additions_vectors, additions_external_ids = read_additions(\n1605:                 updates_uri=updates_uri,\n1606:                 config=config,\n1607:                 verbose=verbose,\n1608:                 trace_id=trace_id,\n1609:             )\n1610:             end = write_offset\n1611:             if additions_vectors is not None:\n1612:                 end += len(additions_external_ids)\n1613:                 logger.debug(\"Writing additions data to array %s\", parts_array_uri)\n1614:                 parts_array[0:dimensions, write_offset:end] = np.transpose(\n1615:                     additions_vectors\n1616:                 )\n1617:                 logger.debug(\"Writing additions  data to array %s\", ids_array_uri)\n1618:                 ids_array[write_offset:end] = additions_external_ids\n1619: \n1620:             group = tiledb.Group(index_group_uri, \"w\")\n1621:             group.meta[\"temp_size\"] = end\n1622:             group.close()\n1623: \n1624:             parts_array.close()\n1625:             ids_array.close()\n1626: \n1627:         # Now that we've ingested the vectors and their IDs, train the index with the data.\n1628: \n1629:         ctx = vspy.Ctx(config)\n1630:         data = vspy.FeatureVectorArray(\n1631:             ctx, parts_array_uri, ids_array_uri, 0, to_temporal_policy(index_timestamp)\n1632:         )\n1633:         if index_type == \"VAMANA\":\n1634:             index = vspy.IndexVamana(ctx, index_group_uri)\n1635:             index.train(data)\n1636:         elif index_type == \"IVF_PQ\":\n1637:             index = vspy.IndexIVFPQ(ctx, index_group_uri)\n1638:             index.train(data, partitions)\n1639:         else:\n1640:             raise ValueError(f\"Unsupported index type: {index_type}\")\n1641:         index.add(data)\n1642:         index.write_index(ctx, index_group_uri, to_temporal_policy(index_timestamp))\n1643: \n1644:     def write_centroids(\n1645:         centroids: np.ndarray,\n1646:         index_group_uri: str,\n1647:         partitions: int,\n1648:         dimensions: int,\n1649:         config: Optional[Mapping[str, Any]] = None,\n1650:         verbose: bool = False,\n1651:         trace_id: Optional[str] = None,\n1652:     ):\n1653:         with tiledb.scope_ctx(ctx_or_config=config):\n1654:             logger = setup(config, verbose)\n1655:             group = tiledb.Group(index_group_uri)\n1656:             centroids_uri = group[CENTROIDS_ARRAY_NAME].uri\n1657:             logger.debug(\"Writing centroids to array %s\", centroids_uri)\n1658:             with tiledb.open(centroids_uri, mode=\"w\", timestamp=index_timestamp) as A:\n1659:                 A[0:dimensions, 0:partitions] = np.transpose(np.array(centroids))\n1660: \n1661:     # --------------------------------------------------------------------\n1662:     # vector ingestion UDFs\n1663:     # --------------------------------------------------------------------\n1664:     def ingest_vectors_udf(\n1665:         index_group_uri: str,\n1666:         source_uri: str,\n1667:         source_type: str,\n1668:         vector_type: np.dtype,\n1669:         external_ids_uri: str,\n1670:         external_ids_type: str,\n1671:         partitions: int,\n1672:         dimensions: int,\n1673:         start: int,\n1674:         end: int,\n1675:         batch: int,\n1676:         threads: int,\n1677:         updates_uri: str = None,\n1678:         config: Optional[Mapping[str, Any]] = None,\n1679:         verbose: bool = False,\n1680:         trace_id: Optional[str] = None,\n1681:     ):\n1682:         import os\n1683:         import random\n1684:         import tempfile\n1685: \n1686:         import tiledb.cloud\n1687:         from tiledb.vector_search.module import StdVector_u64\n1688:         from tiledb.vector_search.module import array_to_matrix\n1689:         from tiledb.vector_search.module import ivf_index\n1690:         from tiledb.vector_search.module import ivf_index_tdb\n1691: \n1692:         logger = setup(config, verbose)\n1693:         group = tiledb.Group(index_group_uri)\n1694:         centroids_uri = group[CENTROIDS_ARRAY_NAME].uri\n1695:         partial_write_array_dir_uri = group[PARTIAL_WRITE_ARRAY_DIR].uri\n1696:         partial_write_array_group = tiledb.Group(partial_write_array_dir_uri)\n1697:         partial_write_array_ids_uri = partial_write_array_group[IDS_ARRAY_NAME].uri\n1698:         partial_write_array_parts_uri = partial_write_array_group[PARTS_ARRAY_NAME].uri\n1699:         partial_write_array_index_uri = partial_write_array_group[INDEX_ARRAY_NAME].uri\n1700:         # Temporary solution until `ivf_index` library change gets released.\n1701:         # TODO(nikos) remove this when the `partition_start` parameter of `ivf_index` gets released.\n1702:         partial_write_array_index_array = tiledb.open(\n1703:             partial_write_array_index_uri, \"w\", timestamp=index_timestamp\n1704:         )\n1705: \n1706:         for part in range(start, end, batch):\n1707:             part_end = part + batch\n1708:             if part_end > end:\n1709:                 part_end = end\n1710: \n1711:             str(part) + \"-\" + str(part_end)\n1712:             part_id = int(part / batch)\n1713: \n1714:             # Temporary solution until `ivf_index` library change gets released. We create a local disk\n1715:             # temporary array to hold the partial indices and write them to the respective range in the main array.\n1716:             # TODO(nikos) remove this when the `partition_start` parameter of `ivf_index` gets released.\n1717:             partial_write_array_index_tmp_uri = os.path.join(\n1718:                 tempfile.gettempdir(),\n1719:                 f\"{random.randint(0,MAX_INT32)}_{part_id}\",\n1720:             )\n1721:             index_array_rows_dim = tiledb.Dim(\n1722:                 name=\"rows\",\n1723:                 domain=(0, MAX_INT32),\n1724:                 tile=100000,\n1725:                 dtype=np.dtype(np.int32),\n1726:             )\n1727:             index_array_dom = tiledb.Domain(index_array_rows_dim)\n1728:             index_attr = tiledb.Attr(\n1729:                 name=\"values\",\n1730:                 dtype=np.dtype(np.uint64),\n1731:             )\n1732:             index_schema = tiledb.ArraySchema(\n1733:                 domain=index_array_dom,\n1734:                 sparse=False,\n1735:                 attrs=[index_attr],\n1736:             )\n1737:             tiledb.Array.create(partial_write_array_index_tmp_uri, index_schema)\n1738:             partition_start = part_id * (partitions + 1)\n1739: \n1740:             logger.debug(\"Input vectors start_pos: %d, end_pos: %d\", part, part_end)\n1741:             updated_ids = read_updated_ids(\n1742:                 updates_uri=updates_uri,\n1743:                 config=config,\n1744:                 verbose=verbose,\n1745:                 trace_id=trace_id,\n1746:             )\n1747:             if source_type == \"TILEDB_ARRAY\":\n1748:                 logger.debug(\"Start indexing\")\n1749:                 ivf_index_tdb(\n1750:                     dtype=vector_type,\n1751:                     db_uri=source_uri,\n1752:                     external_ids_uri=external_ids_uri,\n1753:                     deleted_ids=StdVector_u64(updated_ids),\n1754:                     centroids_uri=centroids_uri,\n1755:                     parts_uri=partial_write_array_parts_uri,\n1756:                     index_array_uri=partial_write_array_index_tmp_uri,\n1757:                     # index_array_uri=partial_write_array_index_uri,\n1758:                     id_uri=partial_write_array_ids_uri,\n1759:                     start=part,\n1760:                     end=part_end,\n1761:                     # partition_start=part_id * (partitions + 1),\n1762:                     nthreads=threads,\n1763:                     **(\n1764:                         {\"timestamp\": index_timestamp}\n1765:                         if index_timestamp is not None\n1766:                         else {}\n1767:                     ),\n1768:                     config=config,\n1769:                 )\n1770:             else:\n1771:                 in_vectors = read_input_vectors(\n1772:                     source_uri=source_uri,\n1773:                     source_type=source_type,\n1774:                     vector_type=vector_type,\n1775:                     dimensions=dimensions,\n1776:                     start_pos=part,\n1777:                     end_pos=part_end,\n1778:                     config=config,\n1779:                     verbose=verbose,\n1780:                     trace_id=trace_id,\n1781:                 )\n1782:                 external_ids = read_external_ids(\n1783:                     external_ids_uri=external_ids_uri,\n1784:                     external_ids_type=external_ids_type,\n1785:                     start_pos=part,\n1786:                     end_pos=part_end,\n1787:                     config=config,\n1788:                     verbose=verbose,\n1789:                     trace_id=trace_id,\n1790:                 )\n1791:                 logger.debug(\"Start indexing\")\n1792:                 ivf_index(\n1793:                     dtype=vector_type,\n1794:                     db=array_to_matrix(np.transpose(in_vectors).astype(vector_type)),\n1795:                     external_ids=StdVector_u64(external_ids),\n1796:                     deleted_ids=StdVector_u64(updated_ids),\n1797:                     centroids_uri=centroids_uri,\n1798:                     parts_uri=partial_write_array_parts_uri,\n1799:                     index_array_uri=partial_write_array_index_tmp_uri,\n1800:                     # index_array_uri=partial_write_array_index_uri,\n1801:                     id_uri=partial_write_array_ids_uri,\n1802:                     start=part,\n1803:                     end=part_end,\n1804:                     # partition_start=part_id * (partitions + 1),\n1805:                     nthreads=threads,\n1806:                     **(\n1807:                         {\"timestamp\": index_timestamp}\n1808:                         if index_timestamp is not None\n1809:                         else {}\n1810:                     ),\n1811:                     config=config,\n1812:                 )\n1813: \n1814:             # Temporary solution until `ivf_index` library change gets released.\n1815:             # TODO(nikos) remove this when the `partition_start` parameter of `ivf_index` gets released.\n1816:             with tiledb.open(partial_write_array_index_tmp_uri) as a:\n1817:                 partial_write_array_index_array[\n1818:                     partition_start : partition_start + partitions + 1\n1819:                 ] = a[0 : partitions + 1]\n1820:             tiledb.Array.delete_array(partial_write_array_index_tmp_uri)\n1821:         partial_write_array_index_array.close()\n1822: \n1823:     def ingest_additions_udf(\n1824:         index_group_uri: str,\n1825:         updates_uri: str,\n1826:         vector_type: np.dtype,\n1827:         partitions: int,\n1828:         write_offset: int,\n1829:         partition_start: int,\n1830:         threads: int,\n1831:         config: Optional[Mapping[str, Any]] = None,\n1832:         verbose: bool = False,\n1833:         trace_id: Optional[str] = None,\n1834:     ):\n1835:         import os\n1836:         import random\n1837:         import tempfile\n1838: \n1839:         import tiledb.cloud\n1840:         from tiledb.vector_search.module import StdVector_u64\n1841:         from tiledb.vector_search.module import array_to_matrix\n1842:         from tiledb.vector_search.module import ivf_index\n1843: \n1844:         logger = setup(config, verbose)\n1845:         group = tiledb.Group(index_group_uri)\n1846:         centroids_uri = group[CENTROIDS_ARRAY_NAME].uri\n1847:         partial_write_array_dir_uri = group[PARTIAL_WRITE_ARRAY_DIR].uri\n1848:         partial_write_array_group = tiledb.Group(partial_write_array_dir_uri)\n1849:         partial_write_array_ids_uri = partial_write_array_group[IDS_ARRAY_NAME].uri\n1850:         partial_write_array_parts_uri = partial_write_array_group[PARTS_ARRAY_NAME].uri\n1851:         partial_write_array_index_uri = partial_write_array_group[INDEX_ARRAY_NAME].uri\n1852: \n1853:         # Temporary solution until `ivf_index` library change gets released. We create a local disk\n1854:         # temporary array to hold the partial indices and write them to the respective range in the main array.\n1855:         # TODO(nikos) remove this when the `partition_start` parameter of `ivf_index` gets released.\n1856:         partial_write_array_index_tmp_uri = os.path.join(\n1857:             tempfile.gettempdir(), f\"{random.randint(0,MAX_INT32)}_{partition_start}\"\n1858:         )\n1859:         index_array_rows_dim = tiledb.Dim(\n1860:             name=\"rows\",\n1861:             domain=(0, MAX_INT32),\n1862:             tile=100000,\n1863:             dtype=np.dtype(np.int32),\n1864:         )\n1865:         index_array_dom = tiledb.Domain(index_array_rows_dim)\n1866:         index_attr = tiledb.Attr(\n1867:             name=\"values\",\n1868:             dtype=np.dtype(np.uint64),\n1869:         )\n1870:         index_schema = tiledb.ArraySchema(\n1871:             domain=index_array_dom,\n1872:             sparse=False,\n1873:             attrs=[index_attr],\n1874:         )\n1875:         tiledb.Array.create(partial_write_array_index_tmp_uri, index_schema)\n1876: \n1877:         additions_vectors, additions_external_ids = read_additions(\n1878:             updates_uri=updates_uri,\n1879:             config=config,\n1880:             verbose=verbose,\n1881:             trace_id=trace_id,\n1882:         )\n1883:         if additions_vectors is None:\n1884:             return\n1885: \n1886:         logger.debug(f\"Ingesting additions {partial_write_array_index_uri}\")\n1887:         ivf_index(\n1888:             dtype=vector_type,\n1889:             db=array_to_matrix(np.transpose(additions_vectors).astype(vector_type)),\n1890:  