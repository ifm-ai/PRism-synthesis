t end up loading the data both on your local machine and in the cloud taskgraph.\n43:     \"\"\"\n44: \n45:     def __init__(\n46:         self,\n47:         uri: str,\n48:         open_for_remote_query_execution: bool,\n49:         config: Optional[Mapping[str, Any]] = None,\n50:         timestamp=None,\n51:     ):\n52:         # If the user passes a tiledb python Config object convert to a dictionary\n53:         if isinstance(config, tiledb.Config):\n54:             config = dict(config)\n55: \n56:         self.uri = uri\n57:         self.open_for_remote_query_execution = open_for_remote_query_execution\n58:         self.config = config\n59:         self.ctx = vspy.Ctx(config)\n60:         self.group = tiledb.Group(self.uri, \"r\", ctx=tiledb.Ctx(config))\n61:         self.storage_version = self.group.meta.get(\"storage_version\", \"0.1\")\n62:         try:\n63:             self.distance_metric = vspy.DistanceMetric(\n64:                 self.group.meta.get(\"distance_metric\", vspy.DistanceMetric.L2)\n65:             )\n66:         except ValueError:\n67:             raise ValueError(\n68:                 f\"Invalid distance metric in metadata: {self.group.meta.get('distance_metric')}.\"\n69:             )\n70:         if (\n71:             not storage_formats[self.storage_version][\"SUPPORT_TIMETRAVEL\"]\n72:             and timestamp is not None\n73:         ):\n74:             raise ValueError(\n75:                 f\"Time traveling is not supported for index storage_version={self.storage_version}\"\n76:             )\n77:         updates_array_name = storage_formats[self.storage_version][\"UPDATES_ARRAY_NAME\"]\n78:         if updates_array_name in self.group:\n79:             self.updates_array_uri = self.group[\n80:                 storage_formats[self.storage_version][\"UPDATES_ARRAY_NAME\"]\n81:             ].uri\n82:         else:\n83:             self.updates_array_uri = f\"{self.group.uri}/{updates_array_name}\"\n84:         self.index_version = self.group.meta.get(\"index_version\", \"\")\n85:         self.ingestion_timestamps = [\n86:             int(x)\n87:             for x in list(json.loads(self.group.meta.get(\"ingestion_timestamps\", \"[]\")))\n88:         ]\n89:         self.history_index = len(self.ingestion_timestamps) - 1\n90:         if self.history_index > -1:\n91:             self.latest_ingestion_timestamp = self.ingestion_timestamps[\n92:                 self.history_index\n93:             ]\n94:         else:\n95:             self.latest_ingestion_timestamp = MAX_UINT64\n96:         self.base_sizes = [\n97:             int(x) for x in list(json.loads(self.group.meta.get(\"base_sizes\", \"[]\")))\n98:         ]\n99:         if len(self.base_sizes) > 0:\n100:             self.base_size = self.base_sizes[self.history_index]\n101:         else:\n102:             self.base_size = -1\n103:         self.base_array_timestamp = self.latest_ingestion_timestamp\n104:         self.query_base_array = True\n105:         self.update_array_timestamp = (self.base_array_timestamp + 1, None)\n106:         if timestamp is None:\n107:             self.base_array_timestamp = 0\n108:         else:\n109:             if isinstance(timestamp, tuple):\n110:                 if len(timestamp) != 2:\n111:                     raise ValueError(\n112:                         \"'timestamp' argument expects either int or tuple(start: int, end: int)\"\n113:                     )\n114:                 if (\n115:                     timestamp[0] is not None\n116:                     and timestamp[0] > self.ingestion_timestamps[0]\n117:                 ):\n118:                     self.query_base_array = False\n119:                     self.update_array_timestamp = timestamp\n120:                 else:\n121:                     if (\n122:                         timestamp[1] is None\n123:                         or timestamp[1] >= self.ingestion_timestamps[0]\n124:                     ):\n125:                         self.history_index = 0\n126:                         self.base_size = self.base_sizes[self.history_index]\n127:                         self.base_array_timestamp = self.ingestion_timestamps[\n128:                             self.history_index\n129:                         ]\n130:                     else:\n131:                         # If the timestamp is before the first ingestion, we'll have no vectors to return.\n132:                         self.history_index = 0\n133:                         self.base_size = 0\n134:                         self.base_array_timestamp = timestamp[1]\n135:                         self.query_base_array = False\n136: \n137:                     self.update_array_timestamp = (\n138:                         self.base_array_timestamp + 1,\n139:                         timestamp[1],\n140:                     )\n141: \n142:             elif isinstance(timestamp, int):\n143:                 # NOTE(paris): We could instead use the same logic as in the else statement above,\n144:                 # but we do it like this as a performance improvment so that we read less from the\n145:                 # updates array and more from ingestions. Above we need to read just the first\n146:                 # ingestion and then from the updates array in case we get a timestamp in between an\n147:                 # ingestion and an update.\n148:                 if timestamp >= self.ingestion_timestamps[0]:\n149:                     self.history_index = 0\n150:                     i = 0\n151:                     for ingestion_timestamp in self.ingestion_timestamps:\n152:                         if ingestion_timestamp <= timestamp:\n153:                             self.base_array_timestamp = ingestion_timestamp\n154:                             self.history_index = i\n155:                             self.base_size = self.base_sizes[self.history_index]\n156:                         i += 1\n157:                 else:\n158:                     # If the timestamp is before the first ingestion, we'll have no vectors to return.\n159:                     self.history_index = 0\n160:                     self.base_size = 0\n161:                     self.base_array_timestamp = timestamp\n162:                     self.query_base_array = False\n163: \n164:                 self.update_array_timestamp = (self.base_array_timestamp + 1, timestamp)\n165:             else:\n166:                 raise TypeError(\n167:                     \"Unexpected argument type for 'timestamp' keyword argument\"\n168:                 )\n169:         self.thread_executor = futures.ThreadPoolExecutor()\n170:         self.has_updates = self._check_has_updates()\n171: \n172:     def _query_with_driver(\n173:         self,\n174:         queries: np.ndarray,\n175:         k: int,\n176:         driver_mode=None,\n177:         driver_resources=None,\n178:         driver_access_credentials_name=None,\n179:         **kwargs,\n180:     ):\n181:         from tiledb.cloud import dag\n182: \n183:         def query_udf(index_type, index_open_kwargs, query_kwargs):\n184:             from tiledb.vector_search.flat_index import FlatIndex\n185:             from tiledb.vector_search.ivf_flat_index import IVFFlatIndex\n186:             from tiledb.vector_search.vamana_index import VamanaIndex\n187: \n188:             # Open index\n189:             if index_type == \"FLAT\":\n190:                 index = FlatIndex(**index_open_kwargs)\n191:             elif index_type == \"IVF_FLAT\":\n192:                 index = IVFFlatIndex(**index_open_kwargs)\n193:             elif index_type == \"VAMANA\":\n194:                 index = VamanaIndex(**index_open_kwargs)\n195: \n196:             # Query index\n197:             return index.query(**query_kwargs)\n198: \n199:         d = dag.DAG(\n200:             name=\"vector-query\",\n201:             mode=driver_mode,\n202:             max_workers=1,\n203:         )\n204:         query_kwargs = {\n205:             \"queries\": queries,\n206:             \"k\": k,\n207:         }\n208:         query_kwargs.update(kwargs)\n209:         node = d.submit(\n210:             query_udf,\n211:             self.index_type,\n212:             self.index_open_kwargs,\n213:             query_kwargs,\n214:             name=\"vector-query-driver\",\n215:             resources=driver_resources,\n216:             image_name=\"vectorsearch\",\n217:             access_credentials_name=driver_access_credentials_name,\n218:         )\n219:         d.compute()\n220:         d.wait()\n221:         return node.result()\n222: \n223:     def query(\n224:         self,\n225:         queries: np.ndarray,\n226:         k: int,\n227:         driver_mode: Optional[Mode] = None,\n228:         driver_resources: Optional[str] = None,\n229:         driver_access_credentials_name: Optional[str] = None,\n230:         **kwargs,\n231:     ):\n232:         \"\"\"\n233:         Queries an index with a set of query vectors, retrieving the `k` most similar vectors for each query.\n234: \n235:         This provides an algorithm-agnostic implementation for updates:\n236: \n237:         - Queries the non-consolidated updates table.\n238:         - Calls the algorithm specific implementation of `query_internal` to query the base data.\n239:         - Merges the results applying the updated data.\n240: \n241:         You can control where the query is executed by setting the `driver_mode` parameter:\n242:         - With `driver_mode = None`, the driver logic for the query will be executed locally.\n243:         - If `driver_mode` is not `None`, we will use a TileDB cloud taskgraph to re-open the index and run the query.\n244:         With both options, certain implementations, i.e. IVF Flat, may let you create further TileDB taskgraphs as defined in the implementation specific `query_internal` methods.\n245: \n246:         Parameters\n247:         ----------\n248:         queries: np.ndarray\n249:             2D array of query vectors. This can be used as a batch query interface by passing multiple queries in one call.\n250:         k: int\n251:             Number of results to return per query vector.\n252:         driver_mode: Mode\n253:             If not `None`, the query will be executed in a TileDB cloud taskgraph using the driver mode specified.\n254:         driver_resources: Optional[str]\n255:             If `driver_mode` was not `None`, the resources to use for the driver execution.\n256:         driver_access_credentials_name: Optional[str]\n257:             If `driver_mode` was not `None`, the access credentials name to use for the driver execution.\n258:         **kwargs\n259:             Extra kwargs passed here are passed to the `query_internal` implementation of the concrete index class.\n260:         \"\"\"\n261:         if queries.ndim != 2:\n262:             raise TypeError(\n263:                 f\"Expected queries to have 2 dimensions (i.e. [[...], etc.]), but it had {queries.ndim} dimensions\"\n264:             )\n265: \n266:         query_dimensions = queries.shape[0] if queries.ndim == 1 else queries.shape[1]\n267:         if query_dimensions != self.get_dimensions():\n268:             raise TypeError(\n269:                 f\"A query in queries has {query_dimensions} dimensions, but the indexed data had {self.dimensions} dimensions\"\n270:             )\n271: \n272:         if queries.dtype != np.float32:\n273:             raise TypeError(\n274:                 f\"Expected queries to have dtype np.float32, but it had dtype {queries.dtype}\"\n275:             )\n276: \n277:         if driver_mode is not None:\n278:             if driver_mode == Mode.LOCAL:\n279:                 # @todo: Fix bug with driver_mode=Mode.LOCAL and remove this check.\n280:                 raise TypeError(\n281:                     \"Cannot pass driver_mode=Mode.LOCAL to query() - use driver_mode=None to query locally.\"\n282:                 )\n283: \n284:             return self._query_with_driver(\n285:                 queries,\n286:                 k,\n287:                 driver_mode,\n288:                 driver_resources,\n289:                 driver_access_credentials_name,\n290:                 **kwargs,\n291:             )\n292: \n293:         if self.open_for_remote_query_execution:\n294:             raise ValueError(\n295:                 \"Cannot query an index with driver_mode=None without loading the index data in main memory. Set open_for_remote_query_execution=False when creating the index to load the index data before query.\"\n296:             )\n297: \n298:         with tiledb.scope_ctx(ctx_or_config=self.config):\n299:             if not self.has_updates:\n300:                 if self.query_base_array:\n301:                     return self.query_internal(queries, k, **kwargs)\n302:                 else:\n303:                     return np.full((queries.shape[0], k), MAX_FLOAT32), np.full(\n304:                         (queries.shape[0], k), MAX_UINT64\n305:                     )\n306: \n307:         # Query with updates\n308:         # Perform the queries in parallel\n309:         retrieval_k = 2 * k\n310:         kwargs[\"nthreads\"] = int(os.cpu_count() / 2)\n311:         future = self.thread_executor.submit(\n312:             Index._query_additions,\n313:             queries,\n314:             k,\n315:             self.dtype,\n316:             self.updates_array_uri,\n317:             self.distance_metric,\n318:             int(os.cpu_count() / 2),\n319:             self.update_array_timestamp,\n320:             self.config,\n321:         )\n322:         if self.query_base_array:\n323:             internal_results_d, internal_results_i = self.query_internal(\n324:                 queries, retrieval_k, **kwargs\n325:             )\n326:         else:\n327:             internal_results_d = np.full((queries.shape[0], k), MAX_FLOAT32)\n328:             internal_results_i = np.full((queries.shape[0], k), MAX_UINT64)\n329:         addition_results_d, addition_results_i, updated_ids = future.result()\n330: \n331:         # Filter updated vectors\n332:         query_id = 0\n333:         for query in internal_results_i:\n334:             res_id = 0\n335:             for res in query:\n336:                 if res in updated_ids:\n337:                     internal_results_d[query_id, res_id] = MAX_FLOAT32\n338:                     internal_results_i[query_id, res_id] = MAX_UINT64\n339:                 res_id += 1\n340:             query_id += 1\n341:         sort_index = np.argsort(internal_results_d, axis=1)\n342:         internal_results_d = np.take_along_axis(internal_results_d, sort_index, axis=1)\n343:         internal_results_i = np.take_along_axis(internal_results_i, sort_index, axis=1)\n344: \n345:         # Merge update results\n346:         if addition_results_d is None:\n347:             return internal_results_d[:, 0:k], internal_results_i[:, 0:k]\n348: \n349:         query_id = 0\n350:         for query in addition_results_d:\n351:             res_id = 0\n352:             for res in query:\n353:                 if (\n354:                     addition_results_d[query_id, res_id] == 0\n355:                     and addition_results_i[query_id, res_id] == 0\n356:                 ):\n357:                     addition_results_d[query_id, res_id] = MAX_FLOAT32\n358:                     addition_results_i[query_id, res_id] = MAX_UINT64\n359:                 res_id += 1\n360:             query_id += 1\n361: \n362:         results_d = np.hstack((internal_results_d, addition_results_d))\n363:         results_i = np.hstack((internal_results_i, addition_results_i))\n364:         sort_index = np.argsort(results_d, axis=1)\n365:         results_d = np.take_along_axis(results_d, sort_index, axis=1)\n366:         results_i = np.take_along_axis(results_i, sort_index, axis=1)\n367:         return results_d[:, 0:k], results_i[:, 0:k]\n368: \n369:     def update(self, vector: np.array, external_id: np.uint64, timestamp: int = None):\n370:         \"\"\"\n371:         Updates a `vector` by its `external_id`.\n372: \n373:         This can be used to add new vectors or update an existing vector with the same `external_id`.\n374: \n375:         Parameters\n376:         ----------\n377:         vector: np.array\n378:             Vector data to be updated.\n379:         external_id: np.uint64\n380:             External ID of the vector.\n381:         timestamp: int\n382:             Timestamp to use for the update to take place at.\n383:         \"\"\"\n384:         self._set_has_updates()\n385:         updates_array = self._open_updates_array(timestamp=timestamp)\n386:         vectors = np.empty((1), dtype=\"O\")\n387:         vectors[0] = vector\n388:         updates_array[external_id] = {\"vector\": vectors}\n389:         updates_array.close()\n390:         self._consolidate_update_fragments()\n391: \n392:     def update_batch(\n393:         self, vectors: np.ndarray, external_ids: np.array, timestamp: int = None\n394:     ):\n395:         \"\"\"\n396:         Updates a set `vectors` by their `external_ids`.\n397: \n398:         This can be used to add new vectors or update existing vectors with the same `external_id`.\n399: \n400:         Parameters\n401:         ----------\n402:         vectors: np.ndarray\n403:             2D array containing the vectors to be updated.\n404:         external_ids: np.uint64\n405:             External IDs of the vectors.\n406:         timestamp: int\n407:             Timestamp to use for the updates to take place at.\n408:         \"\"\"\n409:         self._set_has_updates()\n410:         updates_array = self._open_updates_array(timestamp=timestamp)\n411:         updates_array[external_ids] = {\"vector\": vectors}\n412:         updates_array.close()\n413:         self._consolidate_update_fragments()\n414: \n415:     def delete(self, external_id: np.uint64, timestamp: int = None):\n416:         \"\"\"\n417:         Deletes a vector by its `external_id`.\n418: \n419:         Parameters\n420:         ----------\n421:         external_id: np.uint64\n422:             External ID of the vector to be deleted.\n423:         timestamp: int\n424:             Timestamp to use for the deletes to take place at.\n425:         \"\"\"\n426:         self._set_has_updates()\n427:         updates_array = self._open_updates_array(timestamp=timestamp)\n428:         deletes = np.empty((1), dtype=\"O\")\n429:         deletes[0] = np.array([], dtype=self.dtype)\n430:         updates_array[external_id] = {\"vector\": deletes}\n431:         updates_array.close()\n432:         self._consolidate_update_fragments()\n433: \n434:     def delete_batch(self, external_ids: np.array, timestamp: int = None):\n435:         \"\"\"\n436:         Deletes vectors by their `external_ids`.\n437: \n438:         Parameters\n439:         ----------\n440:         external_ids: np.array\n441:             External IDs of the vectors to be deleted.\n442:         timestamp: int\n443:             Timestamp to use for the deletes to take place at.\n444:         \"\"\"\n445:         self._set_has_updates()\n446:         updates_array = self._open_updates_array(timestamp=timestamp)\n447:         deletes = np.empty((len(external_ids)), dtype=\"O\")\n448:         for i in range(len(external_ids)):\n449:             deletes[i] = np.array([], dtype=self.dtype)\n450:         updates_array[external_ids] = {\"vector\": deletes}\n451:         updates_array.close()\n452:         self._consolidate_update_fragments()\n453: \n454:     def consolidate_updates(self, retrain_index: bool = False, **kwargs):\n455:         \"\"\"\n456:         Consolidates updates by merging updates form the updates table into the base index.\n457: \n458:         The consolidation process is used to avoid query latency degradation as more updates\n459:         are added to the index. It triggers a base index re-indexing, merging the non-consolidated\n460:         updates and the rest of the base vectors.\n