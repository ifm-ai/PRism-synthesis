--------------------------------------------------\n1044:     # centralised kmeans UDFs\n1045:     # --------------------------------------------------------------------\n1046:     def random_sample_from_input_vectors(\n1047:         source_uri: str,\n1048:         source_type: str,\n1049:         vector_type: np.dtype,\n1050:         dimensions: int,\n1051:         source_start_pos: int,\n1052:         source_end_pos: int,\n1053:         batch: int,\n1054:         random_sample_size: int,\n1055:         output_source_uri: str,\n1056:         output_start_pos: int,\n1057:         config: Optional[Mapping[str, Any]] = None,\n1058:         verbose: bool = False,\n1059:     ):\n1060:         \"\"\"\n1061:         Reads a random sample of vectors from the source data and appends them to the output array.\n1062: \n1063:         Parameters\n1064:         ----------\n1065:         source_uri: str\n1066:             Data source URI.\n1067:         source_type: str\n1068:             Type of the source data.\n1069:         vector_type: np.dtype\n1070:             Type of the vectors.\n1071:         dimensions: int\n1072:             Number of dimensions in a vector.\n1073:         vector_start_pos: int\n1074:             Start position of source_uri to read from.\n1075:         vector_end_pos: int\n1076:             End position of source_uri to read to.\n1077:         batch: int\n1078:             Read the source data in batches of this size.\n1079:         random_sample_size: int\n1080:             Number of vectors to randomly sample from the source data.\n1081:         output_source_uri: str\n1082:             URI of the output array.\n1083:         output_start_pos: int\n1084:             Start position of the output array to write to.\n1085:         \"\"\"\n1086:         if random_sample_size == 0:\n1087:             return\n1088: \n1089:         with tiledb.scope_ctx(ctx_or_config=config):\n1090:             source_size = source_end_pos - source_start_pos\n1091:             num_sampled = 0\n1092:             for start in range(source_start_pos, source_end_pos, batch):\n1093:                 # What vectors to read from the source_uri.\n1094:                 end = start + batch\n1095:                 if end > source_end_pos:\n1096:                     end = source_end_pos\n1097: \n1098:                 # How many vectors sample from the vectors read.\n1099:                 percent_of_data_to_read = (end - start) / source_size\n1100:                 num_to_sample = math.ceil(random_sample_size * percent_of_data_to_read)\n1101:                 if num_sampled + num_to_sample > random_sample_size:\n1102:                     num_to_sample = random_sample_size - num_sampled\n1103:                 if num_to_sample == 0:\n1104:                     continue\n1105:                 num_sampled += num_to_sample\n1106: \n1107:                 # Read from the source data.\n1108:                 vectors = read_input_vectors(\n1109:                     source_uri=source_uri,\n1110:                     source_type=source_type,\n1111:                     vector_type=vector_type,\n1112:                     dimensions=dimensions,\n1113:                     start_pos=start,\n1114:                     end_pos=end,\n1115:                     config=config,\n1116:                     verbose=verbose,\n1117:                     trace_id=trace_id,\n1118:                 )\n1119: \n1120:                 # Randomly sample from the data we read.\n1121:                 row_indices = np.random.choice(\n1122:                     vectors.shape[0], size=num_to_sample, replace=False\n1123:                 )\n1124:                 sampled_vectors = vectors[row_indices]\n1125: \n1126:                 # Append to output array.\n1127:                 with tiledb.open(\n1128:                     output_source_uri, mode=\"w\", timestamp=index_timestamp\n1129:                 ) as A:\n1130:                     A[\n1131:                         0:dimensions,\n1132:                         output_start_pos : output_start_pos + num_to_sample,\n1133:                     ] = np.transpose(sampled_vectors)\n1134: \n1135:         if num_sampled != random_sample_size:\n1136:             raise ValueError(\n1137:                 f\"The random sampling within a batch ran into an issue: num_sampled ({num_sampled}) != random_sample_size ({random_sample_size})\"\n1138:             )\n1139: \n1140:     def centralised_kmeans(\n1141:         index_group_uri: str,\n1142:         source_uri: str,\n1143:         source_type: str,\n1144:         vector_type: np.dtype,\n1145:         partitions: int,\n1146:         dimensions: int,\n1147:         training_sample_size: int,\n1148:         training_source_uri: Optional[str],\n1149:         training_source_type: Optional[str],\n1150:         init: str = \"random\",\n1151:         max_iter: int = 10,\n1152:         n_init: int = 1,\n1153:         config: Optional[Mapping[str, Any]] = None,\n1154:         verbose: bool = False,\n1155:         trace_id: Optional[str] = None,\n1156:         use_sklearn: bool = True,\n1157:     ):\n1158:         from sklearn.cluster import KMeans\n1159: \n1160:         from tiledb.vector_search.module import array_to_matrix\n1161: \n1162:         with tiledb.scope_ctx(ctx_or_config=config):\n1163:             logger = setup(config, verbose)\n1164:             group = tiledb.Group(index_group_uri)\n1165:             centroids_uri = group[CENTROIDS_ARRAY_NAME].uri\n1166:             if training_sample_size >= partitions:\n1167:                 if training_source_uri:\n1168:                     if training_source_type is None:\n1169:                         training_source_type = autodetect_source_type(\n1170:                             source_uri=training_source_uri\n1171:                         )\n1172:                     (\n1173:                         training_in_size,\n1174:                         training_dimensions,\n1175:                         training_vector_type,\n1176:                     ) = read_source_metadata(\n1177:                         source_uri=training_source_uri, source_type=training_source_type\n1178:                     )\n1179:                     if dimensions != training_dimensions:\n1180:                         raise ValueError(\n1181:                             f\"When training centroids, the index data dimensions ({dimensions}) != the training data dimensions ({training_dimensions})\"\n1182:                         )\n1183:                     sample_vectors = read_input_vectors(\n1184:                         source_uri=training_source_uri,\n1185:                         source_type=training_source_type,\n1186:                         vector_type=training_vector_type,\n1187:                         dimensions=dimensions,\n1188:                         start_pos=0,\n1189:                         end_pos=training_in_size,\n1190:                         config=config,\n1191:                         verbose=verbose,\n1192:                         trace_id=trace_id,\n1193:                     ).astype(np.float32)\n1194:                 else:\n1195:                     sample_vectors = read_input_vectors(\n1196:                         source_uri=source_uri,\n1197:                         source_type=source_type,\n1198:                         vector_type=vector_type,\n1199:                         dimensions=dimensions,\n1200:                         start_pos=0,\n1201:                         end_pos=training_sample_size,\n1202:                         config=config,\n1203:                         verbose=verbose,\n1204:                         trace_id=trace_id,\n1205:                     ).astype(np.float32)\n1206: \n1207:                 logger.debug(\"Start kmeans training\")\n1208:                 if use_sklearn:\n1209:                     km = KMeans(\n1210:                         n_clusters=partitions,\n1211:                         init=init,\n1212:                         max_iter=max_iter,\n121