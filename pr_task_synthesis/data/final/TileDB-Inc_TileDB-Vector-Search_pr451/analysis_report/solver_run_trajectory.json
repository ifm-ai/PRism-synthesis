           0\n922:                     ][1]\n923:                     + 1\n924:                 ]\n925:                 partition_idx_start = 0\n926:                 partition_idx_end = 0\n927:                 i = 0\n928:                 vectors = None\n929:                 for partition_shape in partitions[\"vectors_shape\"]:\n930:                     partition_id = partitions[\"partition_id\"][i]\n931:                     partition_idx_end += partition_shape[0]\n932:                     intersection_start = max(start_pos, partition_idx_start)\n933:                     intersection_end = min(end_pos, partition_idx_end)\n934:                     if intersection_start < intersection_end:\n935:                         crop_start = intersection_start - partition_idx_start\n936:                         crop_end = intersection_end - partition_idx_start\n937:                         qv = source_array.query(attrs=(\"vectors\",), coords=True)\n938:                         partition_vectors = np.reshape(\n939:                             qv[partition_id : partition_id + 1][\"vectors\"][0],\n940:                             partition_shape,\n941:                         )[crop_start:crop_end]\n942:                         if vectors is None:\n943:                             vectors = partition_vectors\n944:                         else:\n945:                             vectors = np.concatenate((vectors, partition_vectors))\n946:                     partition_idx_start = partition_idx_end\n947:                     i += 1\n948:             return vectors\n949:         elif source_type == \"U8BIN\":\n950:             vfs = tiledb.VFS()\n951:             read_size = end_pos - start_pos\n952:             read_offset = start_pos * dimensions + 8\n953:             with vfs.open(source_uri, \"rb\") as f:\n954:                 f.seek(read_offset)\n955:                 return np.reshape(\n956:                     np.frombuffer(\n957:                         f.read(read_size * dimensi