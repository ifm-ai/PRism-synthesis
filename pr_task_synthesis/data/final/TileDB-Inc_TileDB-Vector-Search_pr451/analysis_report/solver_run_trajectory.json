            "output": "<path>/workspace/apis/python/src/tiledb/vector_search/ingestion.py</path>\n<type>file</type>\n<content>\n1: \"\"\"\n2: Vector Search ingestion Utilities\n3: \n4: This contains the ingestion implementation for different TileDB Vector Search algorithms.\n5: \n6: It enables:\n7: \n8: - Local ingestion:\n9:   - Multi-threaded execution that can leverage all the available local computing resources.\n10: - Distributed ingestion:\n11:   - Distributed ingestion execution with multiple workers in TileDB Cloud. This can be used\n12:   to ingest large datasets and speedup ingestion latency.\n13: \"\"\"\n14: \n15: import enum\n16: from functools import partial\n17: from typing import Any, Mapping, Optional, Tuple\n18: \n19: import numpy as np\n20: \n21: from tiledb.cloud.dag import Mode\n22: from tiledb.vector_search import _tiledbvspy as vspy\n23: from tiledb.vector_search._tiledbvspy import *\n24: from tiledb.vector_search.storage_formats import STORAGE_VERSION\n25: from tiledb.vector_search.storage_formats import validate_storage_version\n26: from tiledb.vector_search.utils import add_to_group\n27: from tiledb.vector_search.utils import is_type_erased_index\n28: from tiledb.vector_search.utils import to_temporal_policy\n29: \n30: \n31: class TrainingSamplingPolicy(enum.Enum):\n32:     FIRST_N = 1\n33:     RANDOM = 2\n34: \n35:     def __str__(self):\n36:         return self.name.replace(\"_\", \" \").title()\n37: \n38: \n39: def ingest(\n40:     index_type: str,\n41:     index_uri: str,\n42:     *,\n43:     input_vectors: Optional[np.ndarray] = None,\n44:     source_uri: Optional[str] = None,\n45:     source_type: Optional[str] = None,\n46:     external_ids: Optional[np.array] = None,\n47:     external_ids_uri: Optional[str] = \"\",\n48:     external_ids_type: Optional[str] = None,\n49:     updates_uri: Optional[str] = None,\n50:     index_timestamp: Optional[int] = None,\n51:     config: Optional[Mapping[str, Any]] = None,\n52:     namespace: Optional[str] = None,\n53:     size: int = -1,\n54:     partitions: int = -1,\n55:     num_subspaces: int = -1,\n56:     l_build: int = -1,\n57:     r_max_degree: int = -1,\n58:     training_sampling_policy: TrainingSamplingPolicy = TrainingSamplingPolicy.FIRST_N,\n59:     copy_centroids_uri: Optional[str] = None,\n60:     training_sample_size: int = -1,\n61:     training_input_vectors: Optional[np.ndarray] = None,\n62:     training_source_uri: Optional[str] = None,\n63:     training_source_type: Optional[str] = None,\n64:     workers: int = -1,\n65:     input_vectors_per_work_item: int = -1,\n66:     max_tasks_per_stage: int = -1,\n67:     input_vectors_per_work_item_during_sampling: int = -1,\n68:     max_sampling_tasks: int = -1,\n69:     storage_version: str = STORAGE_VERSION,\n70:     verbose: bool = False,\n71:     trace_id: Optional[str] = None,\n72:     use_sklearn: bool = True,\n73:     mode: Mode = Mode.LOCAL,\n74:     acn: Optional[str] = None,\n75:     ingest_resources: Optional[Mapping[str, Any]] = None,\n76:     consolidate_partition_resources: Optional[Mapping[str, Any]] = None,\n77:     copy_centroids_resources: Optional[Mapping[str, Any]] = None,\n78:     random_sample_resources: Optional[Mapping[str, Any]] = None,\n79:     kmeans_resources: Optional[Mapping[str, Any]] = None,\n80:     compute_new_centroids_resources: Optional[Mapping[str, Any]] = None,\n81:     assign_points_and_partial_new_centroids_resources: Optional[\n82:         Mapping[str, Any]\n83:     ] = None,\n84:     write_centroids_resources: Optional[Mapping[str, Any]] = None,\n85:     partial_index_resources: Optional[Mapping[str, Any]] = None,\n86:     distance_metric: vspy.DistanceMetric = vspy.DistanceMetric.L2,\n87:     **kwargs,\n88: ):\n89:     \"\"\"\n90:     Ingest vectors into TileDB.\n91: \n92:     Parameters\n93:     ----------\n94:     index_type: str\n95:         Type of vector index (FLAT, IVF_FLAT, IVF_PQ, VAMANA).\n96:     index_uri: str\n97:         Vector index URI (stored as TileDB group).\n98:     input_vectors: np.ndarray\n99:         Input vectors, if this is provided it takes precedence over `source_uri` and `source_type`.\n100:     source_uri: str\n101:         Vectors source URI.\n102:     source_type: str\n103:         Type of the source vectors. If left empty it is auto-detected.\n104:     external_ids: np.array\n105:         Input vector `external_ids`, if this is provided it takes precedence over `external_ids_uri` and `external_ids_type`.\n106:     external_ids_uri: str\n107:         Source URI for `external_ids`.\n108:     external_ids_type: str\n109:         File type of external_ids_uri. If left empty it is auto-detected.\n110:     updates_uri: str\n111:         Updates array URI. Used for consolidation of updates.\n112:     index_timestamp: int\n113:         Timestamp to use for writing and reading data. By default it uses the current unix ms timestamp.\n114:     config: Optional[Mapping[str, Any]]\n115:         TileDB config dictionary.\n116:     namespace: str\n117:         TileDB-Cloud namespace to use for Cloud execution.\n118:     size: int\n119:         Number of input vectors, if not provided use the full size of the input dataset.\n120:         If provided, we filter the first vectors from the input source.\n121:     partitions: int\n122:         For IVF indexes, the number of partitions to load the data with, if not provided, is auto-configured based on the dataset size.\n123:     num_subspaces: int\n124:         For PQ encoded indexes, the number of subspaces to use in the PQ encoding. We will divide the dimensions into\n125:         num_subspaces parts, and PQ encode each part separately. This means dimensions must\n126:         be divisible by num_subspaces.\n127:     l_build: int\n128:         For Vamana indexes, the number of neighbors considered for each node during construction of the graph. Larger values will take more time to build but result in indices that provide higher recall for the same search complexity. l_build should be >= r_max_degree unless you need to build indices quickly and can compromise on quality.\n129:         Typically between 75 and 200. If not provided, use the default value of 100.\n130:     r_max_degree: int\n131:         For Vamana indexes, the maximum degree for each node in the final graph. Larger values will result in larger indices and longer indexing times, but better search quality.\n132:         Typically between 60 and 150. If not provided, use the default value of 64.\n133:     copy_centroids_uri: str\n134:         TileDB array URI to copy centroids from, if not provided, centroids are build running `k-means`.\n135:     training_sample_size: int\n136:         Sample size to use for computing `k-means`. If not provided, is auto-configured based on the dataset sizes.\n137:         Should not be provided if training_source_uri is provided.\n138:     training_input_vectors: np.ndarray\n139:         Training input vectors, if this is provided it takes precedence over `training_source_uri` and `training_source_type`.\n140:         Should not be provided if `training_sample_size` or `training_source_uri` are provided.\n141:     training_source_uri: str\n142:         The source URI to use for training centroids when building a `IVF_FLAT` vector index.\n143:         If not provided, the first `training_sample_size` vectors from `source_uri` are used.\n144:         Should not be provided if training_sample_size or training_input_vectors is provided.\n145:     training_source_type: str\n146:         Type of the training source data in `training_source_uri`.\n147:         If left empty, is auto-detected. Should only be provided when `training_source_uri` is provided.\n148:     workers: int\n149:         Number of distributed workers to use for vector ingestion.\n150:         If not provided, is auto-configured based on the dataset size.\n151:     input_vectors_per_work_item: int\n152:         Number of vectors per ingestion work item.\n153:         If not provided, is auto-configured.\n154:     max_tasks_per_stage: int\n155:         Max number of tasks per execution stage of ingestion.\n156:         If not provided, is auto-configured.\n157:     input_vectors_per_work_item_during_sampling: int\n158:         Number of vectors per sample ingestion work item.\n159:         iIf not provided, is auto-configured.\n160:         Only valid with `training_sampling_policy=TrainingSamplingPolicy.RANDOM`.\n161:     max_sampling_tasks: int\n162:         Max number of tasks per execution stage of sampling.\n163:         If not provided, is auto-configured\n164:         Only valid with `training_sampling_policy=TrainingSamplingPolicy.RANDOM`.\n165:     storage_version: str\n166:         Vector index storage format version. If not provided, defaults to the latest version.\n167:     verbose: bool\n168:         Enables verbose logging.\n169:     trace_id: Optional[str]\n170:         trace ID for logging.\n171:     use_sklearn: bool\n172:         Whether to use scikit-learn's implementation of k-means clustering instead of\n173:         tiledb.vector_search's.\n174:     mode: Mode\n175:         Execution mode, defaults to `LOCAL` use `BATCH` for distributed execution.\n176:     acn: Optional[str]\n177:         Access credential name to be used when running in BATCH mode for object store access\n178:     ingest_resources: Optional[Mapping[str, Any]]\n179:         Resources to request when performing vector ingestion, only applies to BATCH mode\n180:     consolidate_partition_resources: Optional[Mapping[str, Any]]\n181:         Resources to request when performing consolidation of a partition, only applies to BATCH mode\n182:     copy_centroids_resources: Optional[Mapping[str, Any]]\n183:         Resources to request when performing copy of centroids from input array to output array, only applies to BATCH mode\n184:     random_sample_resources: Optional[Mapping[str, Any]]\n185:         Resources to request when performing random sample selection, only applies to BATCH mode\n186:     kmeans_resources: Optional[Mapping[str, Any]]\n187:         Resources to request when performing kmeans task, only applies to BATCH mode\n188:     compute_new_centroids_resources: Optional[Mapping[str, Any]]\n189:         Resources to request when performing centroid computation, only applies to BATCH mode\n190:     assign_points_and_partial_new_centroids_resources: Optional[Mapping[str, Any]]\n191:         Resources to request when performing the computation of partial centroids, only applies to BATCH mode\n192:     write_centroids_resources: Optional[Mapping[str, Any]]\n193:         Resources to request when performing the write of centroids, only applies to BATCH mode\n194:     partial_index_resources: Optional[Mapping[str, Any]]\n195:         Resources to request when performing the computation of partial indexing, only applies to BATCH mode\n196:     distance_metric: vspy.DistanceMetric\n197:         Distance metric to use for the index, defaults to 'vspy.DistanceMetric.L2'. Options are 'vspy.DistanceMetric.L2', 'vspy.DistanceMetric.INNER_PRODUCT', 'vspy.DistanceMetric.COSINE'.\n198:     \"\"\"\n199:     import enum\n200:     import json\n201:     import logging\n202:     import math\n203:     import multiprocessing\n204:     import os\n205:     import random\n206:     import string\n207:     import time\n208:     from typing import Any, Mapping\n209: \n210:     import numpy as np\n211: \n212:     import tiledb\n213:     from tiledb.cloud import dag\n214:     from tiledb.cloud.rest_api import models\n215:     from tiledb.cloud.utilities import get_logger\n216:     from tiledb.cloud.utilities import set_aws_context\n217:     from tiledb.vector_search import flat_index\n218:     from tiledb.vector_search import ivf_flat_index\n219:     from tiledb.vector_search import ivf_pq_index\n220:     from tiledb.vector_search import vamana_index\n221:     from tiledb.vector_search.storage_formats import storage_formats\n222: \n223:     validate_storage_version(storage_version)\n224: \n225:     if source_type and not source_uri:\n226:         raise ValueError(\"source_type should not be provided without source_uri\")\n227:     if source_uri and input_vectors:\n228:         raise ValueError(\"source_uri should not be provided alongside input_vectors\")\n229:     if source_type and input_vectors:\n230:         raise ValueError(\"source_type should not be provided alongside input_vectors\")\n231: \n232:     if training_source_uri and training_sample_size != -1:\n233:         raise ValueError(\n234:             \"training_source_uri and training_sample_size should not both be provided\"\n235:         )\n236:     if training_source_uri and training_input_vectors is not None:\n237:         raise ValueError(\n238:             \"training_source_uri and training_input_vectors should not both be provided\"\n239:         )\n240: \n241:     if training_input_vectors is not None and training_sample_size != -1:\n242:         raise ValueError(\n243:             \"training_input_vectors and training_sample_size should not both be provided\"\n244:         )\n245:     if training_input_vectors is not None and training_source_type:\n246:         raise ValueError(\n247:             \"training_input_vectors and training_source_type should not both be provided\"\n248:         )\n249: \n250:     if training_source_type and not training_source_uri:\n251:         raise ValueError(\n252:             \"training_source_type should not be provided without training_source_uri\"\n253:         )\n254: \n255:     if training_sample_size < -1:\n256:         raise ValueError(\n257:             \"training_sample_size should either be positive or -1 (to auto-configure based on the dataset sizes)\"\n258:         )\n259: \n260:     if copy_centroids_uri is not None and training_sample_size != -1:\n261:         raise ValueError(\n262:             \"training_sample_size should not be provided alongside copy_centroids_uri\"\n263:         )\n264:     if copy_centroids_uri is not None and partitions == -1:\n265:         raise ValueError(\n266:             \"partitions should be provided if copy_centroids_uri is provided (set partitions to the number of centroids in copy_centroids_uri)\"\n267:         )\n268: \n269:     if index_type != \"IVF_FLAT\" and training_sample_size != -1:\n270:         raise ValueError(\n271:             \"training_sample_size should only be provided with index_type IVF_FLAT\"\n272:         )\n273:     for variable in [\n274:         \"copy_centroids_uri\",\n275:         \"training_input_vectors\",\n276:         \"training_source_uri\",\n277:         \"training_source_type\",\n278:     ]:\n279:         if index_type != \"IVF_FLAT\" and locals().get(variable) is not None:\n280:             raise ValueError(\n281:                 f\"{variable} should only be provided with index_type IVF_FLAT\"\n282:             )\n283: \n284:     for variable in [\n285:         \"copy_centroids_uri\",\n286:         \"training_input_vectors\",\n287:         \"training_source_uri\",\n288:         \"training_source_type\",\n289:     ]:\n290:         if (\n291:             training_sampling_policy != TrainingSamplingPolicy.FIRST_N\n292:             and locals().get(variable) is not None\n293:         ):\n294:             raise ValueError(\n295:                 f\"{variable} should not provided alonside training_sampling_policy\"\n296:             )\n297: \n298:     # use index_group_uri for internal clarity\n299:     index_group_uri = index_uri\n300: \n301:     CENTROIDS_ARRAY_NAME = storage_formats[storage_version][\"CENTROIDS_ARRAY_NAME\"]\n302:     INDEX_ARRAY_NAME = storage_formats[storage_version][\"INDEX_ARRAY_NAME\"]\n303:     IDS_ARRAY_NAME = storage_formats[storage_version][\"IDS_ARRAY_NAME\"]\n304:     PARTS_ARRAY_NAME = storage_formats[storage_version][\"PARTS_ARRAY_NAME\"]\n305:     INPUT_VECTORS_ARRAY_NAME = storage_formats[storage_version][\n306:         \"INPUT_VECTORS_ARRAY_NAME\"\n307:     ]\n308:     TRAINING_INPUT_VECTORS_ARRAY_NAME = storage_formats[storage_version][\n309:         \"TRAINING_INPUT_VECTORS_ARRAY_NAME\"\n310:     ]\n311:     EXTERNAL_IDS_ARRAY_NAME = storage_formats[storage_version][\n312:         \"EXTERNAL_IDS_ARRAY_NAME\"\n313:     ]\n314:     PARTIAL_WRITE_ARRAY_DIR = (\n315:         storage_formats[storage_version][\"PARTIAL_WRITE_ARRAY_DIR\"]\n316:         + \"_\"\n317:         + \"\".join(random.choices(string.ascii_letters, k=10))\n318:     )\n319:     DEFAULT_ATTR_FILTERS = storage_formats[storage_version][\"DEFAULT_ATTR_FILTERS\"]\n320: \n321:     # This is used to auto-configure `input_vectors_per_work_item`\n322:     # We set it to a size that based on testing allowed ingestion to complete without\n323:     # OOM errors in small local servers (<16GB). This also avoids large TileDB write\n324:     # operations that can cause a problem with the REST server.\n325:     DEFAULT_PARTITION_BYTE_SIZE = 2**30  # 1GB\n326:     # This is used to auto-configure the resources of vector ingestion DAG tasks.\n327:     # It is not actually enforcing a maximum vector partition size as the client can\n328:     # override `input_vectors_per_work_item` and the UDF resources.\n329:     MAX_PARTITION_BYTE_SIZE = 2**31  # 2GB\n330: \n331:     VECTORS_PER_SAMPLE_WORK_ITEM = 1000000\n332:     MAX_TASKS_PER_STAGE = 100\n333: \n334:     # This is used to auto-configure `kmeans_resources`, `training_sample_size`\n335:     # and `partitions` selected for different datasets. It is based on the kmeans\n336:     # algorithm complexity which is O(vectors * dimensions * centroids).\n337:     # We set this to a value that based on testing allowed kmeans to complete\n338:     # without OOM errors in small local servers (<16GB).\n339:     MAX_CENTRALISED_KMEANS_COMPLEXITY = (\n340:         1000000 * 1024 * 10000\n341:     )  # 1M vectors of 1024 float32 values, 10k partitions\n342:     CENTRALISED_KMEANS_MAX_SAMPLE_SIZE = 1000000\n343: \n344:     DEFAULT_IMG_NAME = \"3.9-vectorsearch\"\n345:     MAX_INT32 = 2**31 - 1\n346: \n347:     class SourceType(enum.Enum):\n348:         \"\"\"SourceType of input vectors\"\"\"\n349: \n350:         TILEDB_ARRAY = enum.auto()\n351:         U8BIN = enum.auto()\n352: \n353:         def __str__(self):\n354:             return self.name.replace(\"_\", \" \").title()\n355: \n356:     def setup(\n357:         config: Optional[Mapping[str, Any]] = None,\n358:         verbose: bool = False,\n359:     ) -> logging.Logger:\n360:         \"\"\"\n361:         Set the default TileDB context, OS environment variables for AWS,\n362:         and return a logger instance.\n363: \n364:         :param config: config dictionary, defaults to None\n365:         :param verbose: verbose logging, defaults to False\n366:         :return: logger instance\n367:         \"\"\"\n368: \n369:         try:\n370:             tiledb.default_ctx(config)\n371:         except tiledb.TileDBError:\n372:             # Ignore error if the default context was already set\n373:             pass\n374: \n375:         set_aws_context(config)\n376: \n377:         level = logging.DEBUG if verbose else logging.NOTSET\n378:         logger = get_logger(level)\n379: \n380:         logger.debug(\n381:             \"tiledb.cloud=%s, tiledb=%s, libtiledb=%s\",\n382:             tiledb.cloud.version.version,\n383:             tiledb.version(),\n384:             tiledb.libtiledb.version(),\n385:         )\n386: \n387:         return logger\n388: \n389:     def autodetect_source_type(source_uri: str) -> str:\n390:         if source_uri.endswith(\".u8bin\"):\n391:             return \"U8BIN\"\n392:         elif source_uri.endswith(\".f32bin\"):\n393:             return \"F32BIN\"\n394:         elif source_uri.endswith(\".fvecs\"):\n395:             return \"FVEC\"\n396:         elif source_uri.endswith(\".ivecs\"):\n397:             return \"IVEC\"\n398:         elif source_uri.endswith(\".bvecs\"):\n399:             return \"BVEC\"\n400:         else:\n401:             return \"TILEDB_ARRAY\"\n402: \n403:     def read_source_metadata(\n404:         source_uri: str, source_type: Optional[str] = None\n405:     ) -> Tuple[int, int, np.dtype]:\n406:         if source_type == \"TILEDB_ARRAY\":\n407:             schema = tiledb.ArraySchema.load(source_uri)\n408:             size = schema.domain.dim(1).domain[1] + 1\n409:             dimensions = schema.domain.dim(0).domain[1] + 1\n410:             return size, dimensions, schema.attr(0).dtype\n411:         if source_type == \"TILEDB_SPARSE_ARRAY\":\n412:             schema = tiledb.ArraySchema.load(source_uri)\n413:             size = schema.domain.dim(0).domain[1] + 1\n414:             dimensions = schema.domain.dim(1).domain[1] + 1\n415:             return size, dimensions, schema.attr(0).dtype\n416:         if source_type == \"TILEDB_PARTITIONED_ARRAY\":\n417:             with tiledb.open(source_uri, \"r\", config=config) as source_array:\n418:                 q = source_array.query(attrs=(\"vectors_shape\",), coords=True)\n419:                 nonempty_object_array_domain = source_array.nonempty_domain()\n420:                 partition_shapes = q[\n421:                     nonempty_object_array_domain[0][0] : nonempty_object_array_domain[\n422:                         0\n423:                     ][1]\n424:                     + 1\n425:                 ][\"vectors_shape\"]\n426:                 size = 0\n427:                 for partition_shape in partition_shapes:\n428:                     size += partition_shape[0]\n429:                     dimensions = partition_shape[1]\n430:                 return size, dimensions, source_array.schema.attr(\"vectors\").dtype\n431:         elif source_type == \"U8BIN\":\n432:             vfs = tiledb.VFS()\n433:             with vfs.open(source_uri, \"rb\") as f:\n434:                 size = int.from_bytes(f.read(4), \"little\")\n435:                 dimensions = int.from_bytes(f.read(4), \"little\")\n436:                 return size, dimensions, np.uint8\n437:         elif source_type == \"F32BIN\":\n438:             vfs = tiledb.VFS()\n439:             with vfs.open(source_uri, \"rb\") as f:\n440:                 size = int.from_bytes(f.read(4), \"little\")\n441:                 dimensions = int.from_bytes(f.read(4), \"little\")\n442:                 return size, dimensions, np.float32\n443:         elif source_type == \"FVEC\":\n444:             vfs = tiledb.VFS()\n445:             with vfs.open(source_uri, \"rb\") as f:\n446:                 dimensions = int.from_bytes(f.read(4), \"little\")\n447:                 vector_size = 4 + dimensions * 4\n448:                 f.seek(0, os.SEEK_END)\n449:                 file_size = f.tell()\n450:                 size = int(file_size / vector_size)\n451:                 return size, dimensions, np.float32\n452:         elif source_type == \"IVEC\":\n453:             vfs = tiledb.VFS()\n454:             with vfs.open(source_uri, \"rb\") as f:\n455:                 dimensions = int.from_bytes(f.read(4), \"little\")\n456:                 vector_size = 4 + dimensions * 4\n457:                 f.seek(0, os.SEEK_END)\n458:                 file_size = f.tell()\n459:                 size = int(file_size / vector_size)\n460:                 return size, dimensions, np.int32\n461:         elif source_type == \"BVEC\":\n462:             vfs = tiledb.VFS()\n463:             with vfs.open(source_uri, \"rb\") as f:\n464:                 dimensions = int.from_bytes(f.read(4), \"little\")\n465:                 vector_size = 4 + dimensions\n466:                 f.seek(0, os.SEEK_END)\n467:                 file_size = f.tell()\n468:                 size = int(file_size / vector_size)\n469:                 return size, dimensions, np.uint8\n470:         else:\n471:             raise ValueError(\n472:                 f\"Not supported source_type {source_type} - valid types are [TILEDB_ARRAY, TILEDB_SPARSE_ARRAY, U8BIN, F32BIN, FVEC, IVEC, BVEC]\"\n473:             )\n474: \n475:     def create_array(\n476:         group: tiledb.Group,\n477:         size: int,\n478:         dimensions: int,\n479:         vector_type: np.dtype,\n480:         array_name: str,\n481:     ) -> str:\n482:         input_vectors_array_uri = f\"{group.uri}/{array_name}\"\n483:         if tiledb.array_exists(input_vectors_array_uri):\n484:             raise ValueError(f\"Array exists {input_vectors_array_uri}\")\n485:         tile_size = min(\n486:             size,\n487:             int(\n488:                 flat_index.TILE_SIZE_BYTES / np.dtype(vector_type).itemsize / dimensions\n489:             ),\n490:         )\n491: \n492:         logger.debug(\"Creating input vectors array\")\n493:         input_vectors_array_rows_dim = tiledb.Dim(\n494:             name=\"rows\",\n495:             domain=(0, dimensions - 1),\n496:             tile=dimensions,\n497:             dtype=np.dtype(np.int32),\n498:         )\n499:         input_vectors_array_cols_dim = tiledb.Dim(\n500:             name=\"cols\",\n501:             domain=(0, size - 1),\n502:             tile=tile_size,\n503:             dtype=np.dtype(np.int32),\n504:         )\n505:         input_vectors_array_dom = tiledb.Domain(\n506:             input_vectors_array_rows_dim, input_vectors_array_cols_dim\n507:         )\n508:         input_vectors_array_attr = tiledb.Attr(\n509:             name=\"values\", dtype=vector_type, filters=DEFAULT_ATTR_FILTERS\n510:         )\n511:         input_vectors_array_schema = tiledb.ArraySchema(\n512:             domain=input_vectors_array_dom,\n513:             sparse=False,\n514:             attrs=[input_vectors_array_attr],\n515:             cell_order=\"col-major\",\n516:             tile_order=\"col-major\",\n517:         )\n518:         logger.debug(input_vectors_array_schema)\n519:         tiledb.Array.create(input_vectors_array_uri, input_vectors_array_schema)\n520:         add_to_group(group, input_vectors_array_uri, array_name)\n521: \n522:         return input_vectors_array_uri\n523: \n524:     def write_input_vectors(\n525:         group: tiledb.Group,\n526:         input_vectors: np.ndarray,\n527:         size: int,\n528:         dimensions: int,\n529:         vector_type: np.dtype,\n530:         array_name: str,\n531:     ) -> str:\n532:         input_vectors_array_uri = create_array(\n533:             group=group,\n534:             size=size,\n535:             dimensions=dimensions,\n536:             vector_type=vector_type,\n537:             array_name=array_name,\n538:         )\n539: \n540:         input_vectors_array = tiledb.open(\n541:             input_vectors_array_uri, \"w\", timestamp=index_timestamp\n542:         )\n543:         input_vectors_array[:, :] = np.transpose(input_vectors)\n544:         input_vectors_array.close()\n545: \n546:         return input_vectors_array_uri\n547: \n548:     def write_external_ids(\n549:         group: tiledb.Group,\n550:         external_ids: np.array,\n551:         size: int,\n552:         partitions: int,\n553:     ) -> str:\n554:         external_ids_array_uri = f\"{group.uri}/{EXTERNAL_IDS_ARRAY_NAME}\"\n555:         if tiledb.array_exists(external_ids_array_uri):\n556:             raise ValueError(f\"Array exists {external_ids_array_uri}\")\n557: \n558:         logger.debug(\"Creating external IDs array\")\n559:         ids_array_rows_dim = tiledb.Dim(\n560:             name=\"rows\",\n561:             domain=(0, size - 1),\n562:             tile=int(size / partitions),\n563:             dtype=np.dtype(np.int32),\n564:         )\n565:         ids_array_dom = tiledb.Domain(ids_array_rows_dim)\n566:         ids_attr = tiledb.Attr(\n567:             name=\"values\",\n568:             dtype=np.dtype(np.uint64),\n569:             filters=DEFAULT_ATTR_FILTERS,\n570:         )\n571:         ids_schema = tiledb.ArraySchema(\n572:             domain=ids_array_dom,\n573:             sparse=False,\n574:             attrs=[ids_attr],\n575:             capacity=int(size / partitions),\n576:             cell_order=\"col-major\",\n577:             tile_order=\"col-major\",\n578:         )\n579:         logger.debug(ids_schema)\n580:         tiledb.Array.create(external_ids_array_uri, ids_schema)\n581:         add_to_group(group, external_ids_array_uri, EXTERNAL_IDS_ARRAY_NAME)\n582: \n583:         external_ids_array = tiledb.open(\n584:             external_ids_array_uri, \"w\", timestamp=index_timestamp\n585:         )\n586:         external_ids_array[:] = external_ids\n587:         external_ids_array.close()\n588: \n589:         return external_ids_array_uri\n590: \n591:     def create_temp_data_group(\n592:         group: tiledb.Group,\n593:     ) -> tiledb.Group:\n594:         partial_write_array_dir_uri = f\"{group.uri}/{PARTIAL_WRITE_ARRAY_DIR}\"\n595:         try:\n596:             tiledb.group_create(partial_write_array_dir_uri)\n597:             add_to_group(group, partial_write_array_dir_uri, PARTIAL_WRITE_ARRAY_DIR)\n598:         except tiledb.TileDBError as err:\n599:             message = str(err)\n600:             if \"already exists\" not in message:\n601:                 raise err\n602:         return tiledb.Group(partial_write_array_dir_uri, \"w\")\n603: \n604:     def create_partial_write_array_group(\n605:         temp_data_group: tiledb.Group,\n606:         vector_type: np.dtype,\n607:         dimensions: int,\n608:         filters: Any,\n609:         create_index_array: bool,\n610:     ) -> str:\n611:         tile_size = int(\n612:             ivf_flat_index.TILE_SIZE_BYTES / np.dtype(vector_type).itemsize / dimensions\n613:         )\n614:         partial_write_array_index_uri = f\"{temp_data_group.uri}/{INDEX_ARRAY_NAME}\"\n615:         partial_write_array_ids_uri = f\"{temp_data_group.uri}/{IDS_ARRAY_NAME}\"\n616:         partial_write_array_parts_uri = f\"{temp_data_group.uri}/{PARTS_ARRAY_NAME}\"\n617: \n618:         if not tiledb.array_exists(partial_write_array_index_uri):\n619:             logger.debug(\"Creating temp index array\")\n620:             index_array_rows_dim = tiledb.Dim(\n621:                 name=\"rows\",\n622:                 domain=(0, MAX_INT32),\n623:                 tile=100000,\n624:                 dtype=np.dtype(np.int32),\n625:             )\n626:             index_array_dom = tiledb.Domain(index_array_rows_dim)\n627:             index_attr = tiledb.Attr(\n628:                 name=\"values\",\n629:                 dtype=np.dtype(np.uint64),\n630:                 filters=filters,\n631:             )\n632:             index_schema = tiledb.ArraySchema(\n633:                 domain=index_array_dom,\n634:                 sparse=False,\n635:                 attrs=[index_attr],\n636:                 cell_order=\"col-major\",\n637:                 tile_order=\"col-major\",\n638:             )\n639:             tiledb.Array.create(partial_write_array_index_uri, index_schema)\n640:             add_to_group(\n641:                 temp_data_group,\n642:                 partial_write_array_index_uri,\n643:                 INDEX_ARRAY_NAME,\n644:             )\n645: \n646:         if not tiledb.array_exists(partial_write_array_ids_uri):\n647:             logger.debug(\"Creating temp ids array\")\n648:             ids_array_rows_dim = tiledb.Dim(\n649:                 name=\"rows\",\n650:                 domain=(0, MAX_INT32),\n651:                 tile=tile_size,\n652:                 dtype=np.dtype(np.int32),\n653:             )\n654:             ids_array_dom = tiledb.Domain(ids_array_rows_dim)\n655:             ids_attr = tiledb.Attr(\n656:                 name=\"values\",\n657:                 dtype=np.dtype(np.uint64),\n658:                 filters=filters,\n659:             )\n660:             ids_schema = tiledb.ArraySchema(\n661:                 domain=ids_array_dom,\n662:                 sparse=False,\n663:                 attrs=[ids_attr],\n664:                 capacity=tile_size,\n665:                 cell_order=\"col-major\",\n666:                 tile_order=\"col-major\",\n667:             )\n668:             logger.debug(ids_schema)\n669:             tiledb.Array.create(partial_write_array_ids_uri, ids_schema)\n670:             add_to_group(\n671:                 temp_data_group,\n672:                 partial_write_array_ids_uri,\n673:                 IDS_ARRAY_NAME,\n674:             )\n675: \n676:         if not tiledb.array_exists(partial_write_array_parts_uri):\n677:             logger.debug(\"Creating temp parts array\")\n678:             parts_array_rows_dim = tiledb.Dim(\n679:                 name=\"rows\",\n680:                 domain=(0, dimensions - 1),\n681:                 tile=dimensions,\n682:                 dtype=np.dtype(np.int32),\n683:             )\n684:             parts_array_cols_dim = tiledb.Dim(\n685:                 name=\"cols\",\n686:                 domain=(0, MAX_INT32),\n687:                 tile=tile_size,\n688:                 dtype=np.dtype(np.int32),\n689:             )\n690:             parts_array_dom = tiledb.Domain(parts_array_rows_dim, parts_array_cols_dim)\n691:             parts_attr = tiledb.Attr(name=\"values\", dtype=vector_type, filters=filters)\n692:             parts_schema = tiledb.ArraySchema(\n693:                 domain=parts_array_dom,\n694:                 sparse=False,\n695:                 attrs=[parts_attr],\n696:                 cell_order=\"col-major\",\n697:                 tile_order=\"col-major\",\n698:             )\n699:             logger.debug(parts_schema)\n700:             logger.debug(partial_write_array_parts_uri)\n701:             tiledb.Array.create(partial_write_array_parts_uri, parts_schema)\n702:             add_to_group(\n703:                 temp_data_group,\n704:                 partial_write_array_parts_uri,\n705:                 PARTS_ARRAY_NAME,\n706:             )\n707:         return partial_write_array_index_uri\n708: \n709:     def create_arrays(\n710:         group: tiledb.Group,\n711:         temp_data_group: tiledb.Group,\n712:         arrays_created: bool,\n713:         index_type: str,\n714:         dimensions: int,\n715:         input_vectors_work_items: int,\n716:         vector_type: np.dtype,\n717:         logger: logging.Logger,\n718:         storage_version: str,\n719:     ) -> None:\n720:         if index_type == \"FLAT\":\n721:             if not arrays_created:\n722:                 flat_index.create(\n723:                     uri=group.uri,\n724:                     dimensions=dimensions,\n725:                     vector_type=vector_type,\n726:                     group_exists=True,\n727:                     config=config,\n728:                     storage_version=storage_version,\n729:                     distance_metric=distance_metric,\n730:                 )\n731:         elif index_type == \"IVF_FLAT\":\n732:             if not arrays_created:\n733:                 ivf_flat_index.create(\n734:                     uri=group.uri,\n735:                     dimensions=dimensions,\n736:                     vector_type=vector_type,\n737:                     group_exists=True,\n738:                     config=config,\n739:                     storage_version=storage_version,\n740:                     distance_metric=distance_metric,\n741:                 )\n742:             create_partial_write_array_group(\n743:                 temp_data_group=temp_data_group,\n744:                 vector_type=vector_type,\n745:                 dimensions=dimensions,\n746:                 filters=DEFAULT_ATTR_FILTERS,\n747:                 create_index_array=True,\n748:             )\n749: \n750:         # Note that we don't create type-erased indexes (i.e. Vamana) here. Instead we create them\n751:         # at very start of ingest() in C++.\n752:         elif not is_type_erased_index(index_type):\n753:             raise ValueError(f\"Not supported index_type {index_type}\")\n754: \n755:     def read_external_ids(\n756:         external_ids_uri: str,\n757:         external_ids_type: str,\n758:         start_pos: int,\n759:         end_pos: int,\n760:         config: Optional[Mapping[str, Any]] = None,\n761:         verbose: bool = False,\n762:         trace_id: Optional[str] = None,\n763:     ) -> np.array:\n764:         logger = setup(config, verbose)\n765:         logger.debug(\n766:             \"Reading external_ids start_pos: %i, end_pos: %i\", start_pos, end_pos\n767:         )\n768:         if external_ids_uri == \"\":\n769:             return np.arange(start_pos, end_pos).astype(np.uint64)\n770:         if external_ids_type == \"TILEDB_ARRAY\":\n771:             with tiledb.open(\n772:                 external_ids_uri, mode=\"r\", timestamp=index_timestamp\n773:             ) as external_ids_array:\n774:                 return external_ids_array[start_pos:end_pos][\"values\"]\n775:         elif source_type == \"TILEDB_PARTITIONED_ARRAY\":\n776:             with tiledb.open(source_uri, \"r\") as source_array:\n777:                 q = source_array.query(attrs=(\"vectors_shape\",), coords=True)\n778:                 nonempty_object_array_domain = source_array.nonempty_domain()\n779:                 partitions = q[\n780:                     nonempty_object_array_domain[0][0] : nonempty_object_array_domain[\n781:                         0\n782:                     ][1]\n783:                     + 1\n784:                 ]\n785:                 partition_idx_start = 0\n786:                 partition_idx_end = 0\n787:                 i = 0\n788:                 external_ids = None\n789:                 for partition_shape in partitions[\"vectors_shape\"]:\n790:                     partition_id = partitions[\"partition_id\"][i]\n791:                     partition_idx_end += partition_shape[0]\n792:                     intersection_start = max(start_pos, partition_idx_start)\n793:                     intersection_end = min(end_pos, partition_idx_end)\n794:                     if intersection_st