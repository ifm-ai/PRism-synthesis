cm.(*clusterMesh).newRemoteCluster(name, path)\n63: \n64: \tstatusErrors := make(chan error, 1)\n65: \trc.backendFactory = func(ctx context.Context, backendName string, opts map[string]string,\n66: \t\toptions *kvstore.ExtraOptions) (kvstore.BackendOperations, chan error) {\n67: \t\tbackend, errch := kvstore.NewClient(ctx, backendName, opts, options)\n68: \t\treturn &fakeBackend{backend, statusErrors}, errch\n69: \t}\n70: \n71: \tvar cl *clusterLock\n72: \trc.clusterLockFactory = func() *clusterLock {\n73: \t\tcl = newClusterLock()\n74: \t\treturn cl\n75: \t}\n76: \n77: \trc.connect()\n78: \tt.Cleanup(rc.onStop)\n79: \n80: \t// Wait until the cluster is ready\n81: \twait(t, ready, \"Remote cluster didn't turn ready for the first time\")\n82: \tstatus := statusfn()\n83: \trequire.True(t, status.Ready, \"Cluster status should report ready\")\n84: \trequire.Zero(t, status.NumFailures, \"Cluster status should report no failures\")\n85: \trequire.Zero(t, status.LastFailure, \"Cluster status should report no failures\")\n86: \n87: \t// Trigger a status error to force a reconnection\n88: \tstatusErrors <- errors.New(\"error\")\n89: \n90: \t// Wait until the cluster turns ready again\n91: \twait(t, ready, \"Remote cluster didn't turn ready after kvstore error\")\n92: \tstatus = statusfn()\n93: \trequire.True(t, status.Ready, \"Cluster status should report ready\")\n94: \trequire.EqualValues(t, 1, status.NumFailures, \"Cluster status should report one failure\")\n95: \trequire.NotZero(t, status.LastFailure, \"Cluster status should report one failure\")\n96: \n97: \t// Trigger a cluster lock error to force a reconnection\n98: \tcl.errors <- errors.New(\"error\")\n99: \n100: \t// Wait until the cluster turns ready again\n101: \twait(t, ready, \"Remote cluster didn't turn ready after clusterlock error\")\n102: \tstatus = statusfn()\n103: \trequire.True(t, status.Ready, \"Cluster status should report ready\")\n104: \trequire.EqualValues(t, 2, status.NumFailures, \"Cluster status