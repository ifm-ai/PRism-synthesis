            "output": "<path>/workspace/pkg/clustermesh/common/remote_cluster.go</path>\n<type>file</type>\n<content>\n1: // SPDX-License-Identifier: Apache-2.0\n2: // Copyright Authors of Cilium\n3: \n4: package common\n5: \n6: import (\n7: \t\"context\"\n8: \t\"errors\"\n9: \t\"fmt\"\n10: \t\"sync\"\n11: \t\"time\"\n12: \n13: \t\"github.com/go-openapi/strfmt\"\n14: \t\"github.com/prometheus/client_golang/prometheus\"\n15: \t\"github.com/sirupsen/logrus\"\n16: \t\"google.golang.org/grpc\"\n17: \n18: \t\"github.com/cilium/cilium/api/v1/models\"\n19: \t\"github.com/cilium/cilium/pkg/clustermesh/types\"\n20: \tcmutils \"github.com/cilium/cilium/pkg/clustermesh/utils\"\n21: \t\"github.com/cilium/cilium/pkg/controller\"\n22: \t\"github.com/cilium/cilium/pkg/dial\"\n23: \t\"github.com/cilium/cilium/pkg/kvstore\"\n24: \t\"github.com/cilium/cilium/pkg/lock\"\n25: \t\"github.com/cilium/cilium/pkg/logging/logfields\"\n26: \t\"github.com/cilium/cilium/pkg/metrics\"\n27: \t\"github.com/cilium/cilium/pkg/option\"\n28: )\n29: \n30: var (\n31: \tremoteConnectionControllerGroup = controller.NewGroup(\"clustermesh-remote-cluster\")\n32: \tclusterConfigControllerGroup    = controller.NewGroup(\"clustermesh-cluster-config\")\n33: )\n34: \n35: type RemoteCluster interface {\n36: \t// Run implements the actual business logic once the connection to the remote cluster has been established.\n37: \t// The ready channel shall be closed when the initialization tasks completed, possibly returning an error.\n38: \tRun(ctx context.Context, backend kvstore.BackendOperations, config types.CiliumClusterConfig, ready chan<- error)\n39: \n40: \tStop()\n41: \tRemove(ctx context.Context)\n42: }\n43: \n44: // backendFactoryFn is the type of the function to create the etcd client.\n45: type backendFactoryFn func(ctx context.Context, backend string, opts map[string]string,\n46: \toptions *kvstore.ExtraOptions) (kvstore.BackendOperations, chan error)\n47: \n48: // remoteCluster represents another cluster other than the cluster the agent is\n49: // running in\n50: type remoteCluster struct {\n51: \tRemoteCluster\n52: \n53: \t// name is the name of the cluster\n54: \tname string\n55: \n56: \t// configPath is the path to the etcd configuration to be used to\n57: \t// connect to the etcd cluster of the remote cluster\n58: \tconfigPath string\n59: \n60: \t// clusterSizeDependantInterval allows to calculate intervals based on cluster size.\n61: \tclusterSizeDependantInterval kvstore.ClusterSizeDependantIntervalFunc\n62: \n63: \t// resolvers are the set of resolvers used to create the custom dialer.\n64: \tresolvers []dial.Resolver\n65: \n66: \tcontrollers *controller.Manager\n67: \n68: \t// wg is used to wait for the termination of the goroutines spawned by the\n69: \t// controller upon reconnection for long running background tasks.\n70: \twg sync.WaitGroup\n71: \n72: \t// remoteConnectionControllerName is the name of the backing controller\n73: \t// that maintains the remote connection\n74: \tremoteConnectionControllerName string\n75: \n76: \t// mutex protects the following variables\n77: \t// - backend\n78: \t// - config\n79: \t// - etcdClusterID\n80: \t// - failures\n81: \t// - lastFailure\n82: \tmutex lock.RWMutex\n83: \n84: \t// backend is the kvstore backend being used\n85: \tbackend kvstore.BackendOperations\n86: \n87: \t// config contains the information about the cluster config for status reporting\n88: \tconfig *models.RemoteClusterConfig\n89: \n90: \t// etcdClusterID contains the information about the etcd cluster ID for status\n91: \t// reporting. It is used to distinguish which instance of the clustermesh-apiserver\n92: \t// we are connected to when running in HA mode.\n93: \tetcdClusterID string\n94: \n95: \t// failures is the number of observed failures\n96: \tfailures int\n97: \n98: \t// lastFailure is the timestamp of the last failure\n99: \tlastFailure time.Time\n100: \n101: \tlogger logrus.FieldLogger\n102: \n103: \t// backendFactory allows to override the function to create the etcd client\n104: \t// for testing purposes.\n105: \tbackendFactory backendFactoryFn\n106: \t// clusterLockFactory allows to override the function to create the clusterLock\n107: \t// for testing purposes.\n108: \tclusterLockFactory func() *clusterLock\n109: \n110: \tmetricLastFailureTimestamp prometheus.Gauge\n111: \tmetricReadinessStatus      prometheus.Gauge\n112: \tmetricTotalFailures        prometheus.Gauge\n113: }\n114: \n115: // releaseOldConnection releases the etcd connection to a remote cluster\n116: func (rc *remoteCluster) releaseOldConnection() {\n117: \trc.metricReadinessStatus.Set(metrics.BoolToFloat64(false))\n118: \n119: \t// Make sure that all child goroutines terminated before performing cleanup.\n120: \trc.wg.Wait()\n121: \n122: \trc.mutex.Lock()\n123: \tbackend := rc.backend\n124: \trc.backend = nil\n125: \trc.config = nil\n126: \trc.etcdClusterID = \"\"\n127: \trc.mutex.Unlock()\n128: \n129: \tif backend != nil {\n130: \t\tbackend.Close()\n131: \t}\n132: }\n133: \n134: func (rc *remoteCluster) restartRemoteConnection() {\n135: \trc.controllers.UpdateController(\n136: \t\trc.remoteConnectionControllerName,\n137: \t\tcontroller.ControllerParams{\n138: \t\t\tGroup: remoteConnectionControllerGroup,\n139: \t\t\tDoFunc: func(ctx context.Context) error {\n140: \t\t\t\trc.releaseOldConnection()\n141: \n142: \t\t\t\tclusterLock := rc.clusterLockFactory()\n143: \t\t\t\textraOpts := rc.makeExtraOpts(clusterLock)\n144: \t\t\t\tbackend, errChan := rc.backendFactory(ctx, kvstore.EtcdBackendName, rc.makeEtcdOpts(), &extraOpts)\n145: \n146: \t\t\t\t// Block until either an error is returned or\n147: \t\t\t\t// the channel is closed due to success of the\n148: \t\t\t\t// connection\n149: \t\t\t\trc.logger.Debugf(\"Waiting for connection to be established\")\n150: \n151: \t\t\t\tvar err error\n152: \t\t\t\tselect {\n153: \t\t\t\tcase err = <-errChan:\n154: \t\t\t\tcase err = <-clusterLock.errors:\n155: \t\t\t\t}\n156: \n157: \t\t\t\tif err != nil {\n158: \t\t\t\t\tif backend != nil {\n159: \t\t\t\t\t\tbackend.Close()\n160: \t\t\t\t\t}\n161: \t\t\t\t\trc.logger.WithError(err).Warning(\"Unable to establish etcd connection to remote cluster\")\n162: \t\t\t\t\treturn err\n163: \t\t\t\t}\n164: \n165: \t\t\t\tetcdClusterID := fmt.Sprintf(\"%x\", clusterLock.etcdClusterID.Load())\n166: \n167: \t\t\t\trc.mutex.Lock()\n168: \t\t\t\trc.backend = backend\n169: \t\t\t\trc.etcdClusterID = etcdClusterID\n170: \t\t\t\trc.mutex.Unlock()\n171: \n172: \t\t\t\tctx, cancel := context.WithCancel(ctx)\n173: \t\t\t\trc.wg.Add(1)\n174: \t\t\t\tgo func() {\n175: \t\t\t\t\trc.watchdog(ctx, backend, clusterLock)\n176: \t\t\t\t\tcancel()\n177: \t\t\t\t\trc.wg.Done()\n178: \t\t\t\t}()\n179: \n180: \t\t\t\trc.logger.WithField(logfields.EtcdClusterID, etcdClusterID).Info(\"Connection to remote cluster established\")\n181: \n182: \t\t\t\tconfig, err := rc.getClusterConfig(ctx, backend)\n183: \t\t\t\tif err != nil {\n184: \t\t\t\t\tlgr := rc.logger\n185: \t\t\t\t\tif errors.Is(err, cmutils.ErrClusterConfigNotFound) {\n186: \t\t\t\t\t\tlgr = lgr.WithField(logfields.Hint,\n187: \t\t\t\t\t\t\t\"If KVStoreMesh is enabled, check whether it is connected to the target cluster.\"+\n188: \t\t\t\t\t\t\t\t\" Additionally, ensure that the cluster name is correct.\")\n189: \t\t\t\t\t}\n190: \n191: \t\t\t\t\tlgr.WithError(err).Warning(\"Unable to get remote cluster configuration\")\n192: \t\t\t\t\tcancel()\n193: \t\t\t\t\treturn err\n194: \t\t\t\t}\n195: \t\t\t\trc.logger.Info(\"Found remote cluster configuration\")\n196: \n197: \t\t\t\tready := make(chan error)\n198: \n199: \t\t\t\t// Let's execute the long running logic in background. This allows\n200: \t\t\t\t// to return early from the controller body, so that the statistics\n201: \t\t\t\t// are updated correctly. Instead, blocking until rc.Run terminates\n202: \t\t\t\t// would prevent a previous failure from being cleared out.\n203: \t\t\t\trc.wg.Add(1)\n204: \t\t\t\tgo func() {\n205: \t\t\t\t\trc.Run(ctx, backend, config, ready)\n206: \t\t\t\t\tcancel()\n207: \t\t\t\t\trc.wg.Done()\n208: \t\t\t\t}()\n209: \n210: \t\t\t\tif err := <-ready; err != nil {\n211: \t\t\t\t\trc.logger.WithError(err).Warning(\"Connection to remote cluster failed\")\n212: \t\t\t\t\treturn err\n213: \t\t\t\t}\n214: \n215: \t\t\t\trc.metricReadinessStatus.Set(metrics.BoolToFloat64(true))\n216: \t\t\t\treturn nil\n217: \t\t\t},\n218: \t\t\tStopFunc: func(ctx context.Context) error {\n219: \t\t\t\trc.releaseOldConnection()\n220: \t\t\t\trc.logger.Info(\"Connection to remote cluster stopped\")\n221: \t\t\t\treturn nil\n222: \t\t\t},\n223: \t\t\tCancelDoFuncOnUpdate: true,\n224: \t\t},\n225: \t)\n226: }\n227: \n228: func (rc *remoteCluster) watchdog(ctx context.Context, backend kvstore.BackendOperations, clusterLock *clusterLock) {\n229: \thandleErr := func(err error) {\n230: \t\trc.logger.WithError(err).Warning(\"Error observed on etcd connection, reconnecting etcd\")\n231: \t\trc.mutex.Lock()\n232: \t\trc.failures++\n233: \t\trc.lastFailure = time.Now()\n234: \t\trc.metricLastFailureTimestamp.SetToCurrentTime()\n235: \t\trc.metricTotalFailures.Set(float64(rc.failures))\n236: \t\trc.metricReadinessStatus.Set(metrics.BoolToFloat64(rc.isReadyLocked()))\n237: \t\trc.mutex.Unlock()\n238: \n239: \t\trc.restartRemoteConnection()\n240: \t}\n241: \n242: \tselect {\n243: \tcase err, ok := <-backend.StatusCheckErrors():\n244: \t\tif ok && err != nil {\n245: \t\t\thandleErr(err)\n246: \t\t}\n247: \tcase err, ok := <-clusterLock.errors:\n248: \t\tif ok && err != nil {\n249: \t\t\thandleErr(err)\n250: \t\t}\n251: \tcase <-ctx.Done():\n252: \t\treturn\n253: \t}\n254: }\n255: \n256: func (rc *remoteCluster) getClusterConfig(ctx context.Context, backend kvstore.BackendOperations) (types.CiliumClusterConfig, error) {\n257: \tvar (\n258: \t\tclusterConfigRetrievalTimeout = 3 * time.Minute\n259: \t\tlastError                     = context.Canceled\n260: \t\tlastErrorLock                 lock.Mutex\n261: \t)\n262: \n263: \tctx, cancel := context.WithTimeout(ctx, clusterConfigRetrievalTimeout)\n264: \tdefer cancel()\n265: \n266: \trc.mutex.Lock()\n267: \trc.config = &models.RemoteClusterConfig{Required: true}\n268: \trc.mutex.Unlock()\n269: \n270: \tcfgch := make(chan types.CiliumClusterConfig)\n271: \tdefer close(cfgch)\n272: \n273: \t// We retry here rather than simply returning an error and relying on the external\n274: \t// controller backoff period to avoid recreating every time a new connection to the remote\n275: \t// kvstore, which would introduce an unnecessary overhead. Still, we do return in case of\n276: \t// consecutive failures, to ensure that we do not retry forever if something strange happened.\n277: \tctrlname := rc.remoteConnectionControllerName + \"-cluster-config\"\n278: \tdefer rc.controllers.RemoveControllerAndWait(ctrlname)\n279: \trc.controllers.UpdateController(ctrlname, controller.ControllerParams{\n280: \t\tGroup: clusterConfigControllerGroup,\n281: \t\tDoFunc: func(ctx context.Context) error {\n282: \t\t\trc.logger.Debug(\"Retrieving cluster configuration from remote kvstore\")\n283: \t\t\tconfig, err := cmutils.GetClusterConfig(ctx, rc.name, backend)\n284: \t\t\tif err != nil {\n285: \t\t\t\tlastErrorLock.Lock()\n286: \t\t\t\tlastError = err\n287: \t\t\t\tlastErrorLock.Unlock()\n288: \t\t\t\treturn err\n289: \t\t\t}\n290: \n291: \t\t\tcfgch <- config\n292: \t\t\treturn nil\n293: \t\t},\n294: \t\tContext:          ctx,\n295: \t\tMaxRetryInterval: 30 * time.Second,\n296: \t})\n297: \n298: \t// Wait until either the configuration is retrieved, or the context expires\n299: \tselect {\n300: \tcase config := <-cfgch:\n301: \t\trc.mutex.Lock()\n302: \t\trc.config.Retrieved = true\n303: \t\trc.config.ClusterID = int64(config.ID)\n304: \t\trc.config.Kvstoremesh = config.Capabilities.Cached\n305: \t\trc.config.SyncCanaries = config.Capabilities.SyncedCanaries\n306: \t\trc.mutex.Unlock()\n307: \n308: \t\treturn config, nil\n309: \tcase <-ctx.Done():\n310: \t\tlastErrorLock.Lock()\n311: \t\tdefer lastErrorLock.Unlock()\n312: \t\treturn types.CiliumClusterConfig{}, fmt.Errorf(\"failed to retrieve cluster configuration: %w\", lastError)\n313: \t}\n314: }\n315: \n316: func (rc *remoteCluster) makeEtcdOpts() map[string]string {\n317: \topts := map[string]string{\n318: \t\tkvstore.EtcdOptionConfig: rc.configPath,\n319: \t}\n320: \n321: \tfor key, value := range option.Config.KVStoreOpt {\n322: \t\tswitch key {\n323: \t\tcase kvstore.EtcdRateLimitOption, kvstore.EtcdMaxInflightOption, kvstore.EtcdListLimitOption,\n324: \t\t\tkvstore.EtcdOptionKeepAliveHeartbeat, kvstore.EtcdOptionKeepAliveTimeout:\n325: \t\t\topts[key] = value\n326: \t\t}\n327: \t}\n328: \n329: \treturn opts\n330: }\n331: \n332: func (rc *remoteCluster) makeExtraOpts(clusterLock *clusterLock) kvstore.ExtraOptions {\n333: \tvar dialOpts []grpc.DialOption\n334: \n335: \tdialOpts = append(dialOpts, grpc.WithStreamInterceptor(newStreamInterceptor(clusterLock)), grpc.WithUnaryInterceptor(newUnaryInterceptor(clusterLock)))\n336: \n337: \t// Allow to resolve service names without depending on the DNS. This prevents the need\n338: \t// for setting the DNSPolicy to ClusterFirstWithHostNet when running in host network.\n339: \tdialOpts = append(dialOpts, grpc.WithContextDialer(dial.NewContextDialer(rc.logger, rc.resolvers...)))\n340: \n341: \treturn kvstore.ExtraOptions{\n342: \t\tNoLockQuorumCheck:            true,\n343: \t\tClusterName:                  rc.name,\n344: \t\tClusterSizeDependantInterval: rc.clusterSizeDependantInterval,\n345: \t\tDialOption:                   dialOpts,\n346: \t\tNoEndpointStatusChecks:       true,\n347: \t}\n348: }\n349: \n350: func (rc *remoteCluster) connect() {\n351: \trc.logger.Info(\"Connecting to remote cluster\")\n352: \trc.restartRemoteConnection()\n353: }\n354: \n355: // onStop is executed when the clustermesh subsystem is being stopped.\n356: // In this case, we don't want to drain the known entries, otherwise\n357: // we would break existing connections when the agent gets restarted.\n358: func (rc *remoteCluster) onStop() {\n359: \t_ = rc.controllers.RemoveControllerAndWait(rc.remoteConnectionControllerName)\n360: \trc.Stop()\n361: }\n362: \n363: // onRemove is executed when a remote cluster is explicitly disconnected\n364: // (i.e., its configuration is removed). In this case, we need to drain\n365: // all known entries, to properly cleanup the status without requiring to\n366: // restart the agent.\n367: func (rc *remoteCluster) onRemove(ctx context.Context) {\n368: \trc.onStop()\n369: \trc.Remove(ctx)\n370: \n371: \trc.logger.Info(\"Remote cluster disconnected\")\n372: }\n373: \n374: func (rc *remoteCluster) isReady() bool {\n375: \trc.mutex.RLock()\n376: \tdefer rc.mutex.RUnlock()\n377: \n378: \treturn rc.isReadyLocked()\n379: }\n380: \n381: func (rc *remoteCluster) isReadyLocked() bool {\n382: \treturn rc.backend != nil && rc.config != nil && (!rc.config.Required || rc.config.Retrieved)\n383: }\n384: \n385: func (rc *remoteCluster) status() *models.RemoteCluster {\n386: \trc.mutex.RLock()\n387: \tdefer rc.mutex.RUnlock()\n388: \n389: \t// This can happen when the controller in restartRemoteConnection is waiting\n390: \t// for the first connection to succeed.\n391: \tvar backendStatus = \"Waiting for initial connection to be established\"\n392: \tif rc.backend != nil {\n393: \t\tvar backendError error\n394: \t\tbackendStatus, backendError = rc.backend.Status()\n395: \t\tif backendError != nil {\n396: \t\t\tbackendStatus = backendError.Error()\n397: \t\t}\n398: \n399: \t\tif rc.etcdClusterID != \"\" {\n400: \t\t\tbackendStatus += \", ID: \" + rc.etcdClusterID\n401: \t\t}\n402: \t}\n403: \n404: \tstatus := &models.RemoteCluster{\n405: \t\tName:        rc.name,\n406: \t\tReady:       rc.isReadyLocked(),\n407: \t\tConnected:   rc.backend != nil,\n408: \t\tStatus:      backendStatus,\n409: \t\tConfig:      rc.config,\n410: \t\tNumFailures: int64(rc.failures),\n411: \t\tLastFailure: strfmt.DateTime(rc.lastFailure),\n412: \t}\n413: \n414: \treturn status\n415: }\n\n(End of file - total 415 lines)\n</content>",
