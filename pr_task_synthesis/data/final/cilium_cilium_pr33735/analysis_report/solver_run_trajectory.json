              "newString": "\trequire.EqualValues(t, 2, status.NumFailures, \"Cluster status should report two failures\")\n\trequire.NotZero(t, status.LastFailure, \"Cluster status should report two failures\")\n}\n\nfunc TestGetClusterConfigNoDeadlock(t *testing.T) {\n\ttestutils.IntegrationTest(t)\n\tkvstore.SetupDummy(t, \"etcd\")\n\n\tconst name = \"remote\"\n\tpath := filepath.Join(t.TempDir(), name)\n\twriteFile(t, path, fmt.Sprintf(\"endpoints:\\n- %s\\n\", kvstore.EtcdDummyAddress()))\n\trequire.NoError(t, utils.SetClusterConfig(context.Background(), name, types.CiliumClusterConfig{ID: 2}, kvstore.Client()))\n\n\tvar cl *clusterLock\n\trc := &remoteCluster{\n\t\tname:         name,\n\t\tconfigPath:   path,\n\t\tcontrollers:  controller.NewManager(),\n\t\tlogger:       log,\n\t\tclusterLockFactory: func() *clusterLock {\n\t\t\tcl = newClusterLock()\n\t\t\treturn cl\n\t\t},\n\t}\n\n\tstatusErrors := make(chan error, 1)\n\trc.backendFactory = func(ctx context.Context, backendName string, opts map[string]string,\n\t\toptions *kvstore.ExtraOptions) (kvstore.BackendOperations, chan error) {\n\t\tbackend, errch := kvstore.NewClient(ctx, backendName, opts, options)\n\t\treturn &fakeBackend{backend, statusErrors}, errch\n\t}\n\n\tctx, cancel := context.WithCancel(context.Background())\n\tdefer cancel()\n\n\tbackend, errChan := rc.backendFactory(ctx, kvstore.EtcdBackendName, rc.makeEtcdOpts(), &kvstore.ExtraOptions{\n\t\tClusterName:                  name,\n\t\tClusterSizeDependantInterval: kvstore.DefaultClusterSizeDependantInterval,\n\t\tDialOption:                   nil,\n\t})\n\trequire.NoError(t, <-errChan)\n\tdefer backend.Close()\n\n\tdone := make(chan struct{})\n\tgo func() {\n\t\tdefer close(done)\n\t\tconfig, err := rc.getClusterConfig(ctx, backend)\n\t\tif err != nil {\n\t\t\tt.Logf(\"getClusterConfig returned error (expected in race scenario): %v\", err)\n\t\t} else {\n\t\t\trequire.Equal(t, uint32(2), config.ID)\n\t\t}\n\t}()\n\n\tselect {\n\tcase <-done:\n\t\t// Test passed - no deadlock occurred\n\tcase <-time.After(10 * time.Second):\n\t\tt.Fatal(\"getClusterConfig appears to be deadlocked\")\n\t}\n\n\tcancel()\n\t<-done\n}"
