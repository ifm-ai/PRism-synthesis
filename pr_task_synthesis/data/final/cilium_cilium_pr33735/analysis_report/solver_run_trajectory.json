            "output": "<path>/workspace/pkg/clustermesh/common/clustermesh_test.go</path>\n<type>file</type>\n<content>\n1: // SPDX-License-Identifier: Apache-2.0\n2: // Copyright Authors of Cilium\n3: \n4: package common\n5: \n6: import (\n7: \t\"context\"\n8: \t\"errors\"\n9: \t\"fmt\"\n10: \t\"os\"\n11: \t\"path/filepath\"\n12: \t\"testing\"\n13: \n14: \t\"github.com/cilium/hive/hivetest\"\n15: \t\"github.com/stretchr/testify/assert\"\n16: \t\"github.com/stretchr/testify/require\"\n17: \n18: \t\"github.com/cilium/cilium/api/v1/models\"\n19: \t\"github.com/cilium/cilium/pkg/clustermesh/types\"\n20: \t\"github.com/cilium/cilium/pkg/clustermesh/utils\"\n21: \t\"github.com/cilium/cilium/pkg/kvstore\"\n22: \t\"github.com/cilium/cilium/pkg/lock\"\n23: \t\"github.com/cilium/cilium/pkg/testutils\"\n24: )\n25: \n26: type fakeRemoteCluster struct{ onRun, onStop, onRemove func(ctx context.Context) }\n27: \n28: func (f *fakeRemoteCluster) Run(ctx context.Context, _ kvstore.BackendOperations, _ types.CiliumClusterConfig, ready chan<- error) {\n29: \tif f.onRun != nil {\n30: \t\tf.onRun(ctx)\n31: \t}\n32: \tclose(ready)\n33: \t<-ctx.Done()\n34: }\n35: \n36: func (f *fakeRemoteCluster) Stop() {\n37: \tif f.onStop != nil {\n38: \t\tf.onStop(context.Background())\n39: \t}\n40: }\n41: \n42: func (f *fakeRemoteCluster) Remove(ctx context.Context) {\n43: \tif f.onRemove != nil {\n44: \t\tf.onRemove(ctx)\n45: \t}\n46: }\n47: \n48: func TestClusterMesh(t *testing.T) {\n49: \ttestutils.IntegrationTest(t)\n50: \tkvstore.SetupDummy(t, \"etcd\")\n51: \n52: \tbaseDir := t.TempDir()\n53: \tpath := func(name string) string { return filepath.Join(baseDir, name) }\n54: \tdata := fmt.Sprintf(\"endpoints:\\n- %s\\n\", kvstore.EtcdDummyAddress())\n55: \n56: \tcapabilities := types.CiliumClusterConfigCapabilities{Cached: true, MaxConnectedClusters: 511}\n57: \tfor i, cluster := range []string{\"cluster1\", \"cluster2\", \"cluster3\"} {\n58: \t\tcfg := types.CiliumClusterConfig{ID: uint32(i + 1), Capabilities: capabilities}\n59: \t\trequire.NoError(t, utils.SetClusterConfig(context.Background(), cluster, cfg, kvstore.Client()))\n60: \t}\n61: \n62: \tvar ready, stopped, removed lock.Map[string, bool]\n63: \tis := func(state *lock.Map[string, bool], name string) bool {\n64: \t\tst, _ := state.Load(name)\n65: \t\treturn st\n66: \t}\n67: \n68: \tvar statuses lock.Map[string, StatusFunc]\n69: \tassertStatus := func(t *testing.T, name string, id uint32) {\n70: \t\tt.Helper()\n71: \n72: \t\tsf, _ := statuses.Load(name)\n73: \t\trequire.NotNil(t, sf, \"The status function for %s should have been registered\", name)\n74: \t\tstatus := sf()\n75: \n76: \t\trequire.Equal(t, name, status.Name, \"The status for %s should propagate the cluster name\", name)\n77: \t\trequire.True(t, status.Connected, \"The status for %s should be reported as connected\", name)\n78: \t\trequire.True(t, status.Ready, \"The status for %s should be reported as ready\", name)\n79: \t\trequire.Zero(t, status.NumFailures, \"The status for %s should not report failures\", name)\n80: \t\trequire.Zero(t, status.LastFailure, \"The status for %s should not report a last failure\", name)\n81: \n82: \t\tcfg := models.RemoteClusterConfig{ClusterID: int64(id), Kvstoremesh: true, Required: true, Retrieved: true, SyncCanaries: false}\n83: \t\trequire.Equal(t, &cfg, status.Config, \"The status for %s should propagate the cluster configuration\", name)\n84: \t}\n85: \n86: \t// clusters is not protected by a mutex, as always guaranteed to be accessed\n87: \t// by a thread at a time only.\n88: \tvar clusters []*fakeRemoteCluster\n89: \n90: \tcm := NewClusterMesh(Configuration{\n91: \t\tConfig:      Config{ClusterMeshConfig: baseDir},\n92: \t\tClusterInfo: types.ClusterInfo{ID: 255, Name: \"local\"},\n93: \t\tNewRemoteCluster: func(name string, sf StatusFunc) RemoteCluster {\n94: \t\t\tstatuses.Store(name, sf)\n95: \t\t\trc := &fakeRemoteCluster{\n96: \t\t\t\tonRun:    func(context.Context) { ready.Store(name, true) },\n97: \t\t\t\tonStop:   func(context.Context) { stopped.Store(name, true) },\n98: \t\t\t\tonRemove: func(context.Context) { removed.Store(name, true) },\n99: \t\t\t}\n100: \n101: \t\t\tclusters = append(clusters, rc)\n102: \t\t\treturn rc\n103: \t\t},\n104: \t\tMetrics: MetricsProvider(\"clustermesh\")(),\n105: \t})\n106: \n107: \tassertForEachRemoteCluster := func(t *testing.T, expected uint) {\n108: \t\tt.Helper()\n109: \t\tvar count uint\n110: \t\trequire.NoError(t, cm.ForEachRemoteCluster(func(rc RemoteCluster) error {\n111: \t\t\trequire.Contains(t, clusters, rc, \"ForEachRemoteCluster triggered for unknown cluster\")\n112: \t\t\tcount++\n113: \t\t\treturn nil\n114: \t\t}), \"ForEachRemoteCluster should not have returned an error\")\n115: \t\trequire.EqualValues(t, expected, count, \"ForEachRemoteCluster not triggered for all expected clusters\")\n116: \t}\n117: \n118: \t// Verify that the onStop method of remote clusters is called upon clustermesh\n119: \t// stop, but not the onRemove one (which is triggered only when the configuration\n120: \t// is explicitly removed).\n121: \tt.Cleanup(func() {\n122: \t\tfor _, cluster := range []string{\"cluster1\", \"cluster3\", \"cluster4\"} {\n123: \t\t\trequire.True(t, is(&stopped, cluster), \"Cluster %s should have been stopped\", cluster)\n124: \t\t\trequire.False(t, is(&removed, cluster), \"Cluster %s should not have been removed\", cluster)\n125: \t\t}\n126: \t})\n127: \n128: \t// The configuration matching the local cluster should be ignored\n129: \twriteFile(t, path(\"local\"), data)\n130: \n131: \twriteFile(t, path(\"cluster1\"), data)\n132: \twriteFile(t, path(\"cluster2\"), data)\n133: \n134: \thivetest.Lifecycle(t).Append(cm)\n135: \n136: \t// Clusters whose configuration is already present before starting clustermesh should eventually turn ready\n137: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, is(&ready, \"cluster1\")) }, timeout, tick, \"Cluster1 is not ready\")\n138: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, is(&ready, \"cluster2\")) }, timeout, tick, \"Cluster2 is not ready\")\n139: \tassertStatus(t, \"cluster1\", 1)\n140: \tassertStatus(t, \"cluster2\", 2)\n141: \trequire.EqualValues(t, 2, cm.NumReadyClusters(), \"Number of ready remote clusters reported incorrectly\")\n142: \tassertForEachRemoteCluster(t, 2)\n143: \n144: \t// A cluster whose configuration is subsequently added should eventually turn ready\n145: \twriteFile(t, path(\"cluster3\"), data)\n146: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, is(&ready, \"cluster3\")) }, timeout, tick, \"Cluster3 is not ready\")\n147: \tassertStatus(t, \"cluster3\", 3)\n148: \trequire.EqualValues(t, 3, cm.NumReadyClusters(), \"Number of ready remote clusters reported incorrectly\")\n149: \tassertForEachRemoteCluster(t, 3)\n150: \n151: \t// A cluster whose configuration is changed should eventually turn ready again\n152: \tready.Store(\"cluster3\", false)\n153: \twriteFile(t, path(\"cluster3\"), data+\"\\n\")\n154: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, is(&ready, \"cluster3\")) }, timeout, tick, \"Cluster3 is not ready\")\n155: \tassertStatus(t, \"cluster3\", 3)\n156: \trequire.EqualValues(t, 3, cm.NumReadyClusters(), \"Number of ready remote clusters reported incorrectly\")\n157: \tassertForEachRemoteCluster(t, 3)\n158: \n159: \t// A cluster for which etcd does not contain the cluster configuration should not turn ready\n160: \twriteFile(t, path(\"cluster4\"), data)\n161: \trequire.EventuallyWithT(t, func(c *assert.CollectT) {\n162: \t\tsf, _ := statuses.Load(\"cluster4\")\n163: \t\tif !assert.NotNil(c, sf, \"The status function for cluster4 should have been registered\") {\n164: \t\t\treturn\n165: \t\t}\n166: \n167: \t\tstatus := sf()\n168: \t\tassert.Equal(c, \"cluster4\", status.Name, \"The status for cluster4 should propagate the cluster name\")\n169: \t\tassert.True(c, status.Connected, \"The status for cluster4 should be reported as connected\")\n170: \t\tassert.False(c, status.Ready, \"The status for cluster4 should be reported as not ready\")\n171: \n172: \t\tcfg := models.RemoteClusterConfig{Required: true, Retrieved: false}\n173: \t\tassert.Equal(c, &cfg, status.Config, \"The status for cluster4 should report the cluster config as required but not found\")\n174: \t}, timeout, tick, \"Status incorrectly reported for cluster4\")\n175: \trequire.False(t, is(&ready, \"cluster4\"), \"Cluster4 should not be ready\")\n176: \trequire.EqualValues(t, 3, cm.NumReadyClusters(), \"Number of ready remote clusters reported incorrectly\")\n177: \tassertForEachRemoteCluster(t, 4)\n178: \n179: \t// A cluster whose configuration is removed should be stopped and removed\n180: \trequire.NoError(t, os.Remove(path(\"cluster2\")))\n181: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, is(&stopped, \"cluster2\")) }, timeout, tick, \"Cluster2 has not been stopped\")\n182: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, is(&removed, \"cluster2\")) }, timeout, tick, \"Cluster2 has not been removed\")\n183: \trequire.EqualValues(t, 2, cm.NumReadyClusters(), \"Number of ready remote clusters reported incorrectly\")\n184: \tassertForEachRemoteCluster(t, 3)\n185: \n186: \t// ForEachRemoteCluster should correctly propagate errors\n187: \terr := errors.New(\"error\")\n188: \trequire.ErrorIs(t, cm.ForEachRemoteCluster(func(rc RemoteCluster) error { return err }), err)\n189: }\n190: \n191: func TestClusterMeshMultipleAddRemove(t *testing.T) {\n192: \ttestutils.IntegrationTest(t)\n193: \tkvstore.SetupDummy(t, \"etcd\")\n194: \n195: \tbaseDir := t.TempDir()\n196: \tpath := func(name string) string { return filepath.Join(baseDir, name) }\n197: \n198: \tfor i, cluster := range []string{\"cluster1\", \"cluster2\", \"cluster3\", \"cluster4\"} {\n199: \t\twriteFile(t, path(cluster), fmt.Sprintf(\"endpoints:\\n- %s\\n\", kvstore.EtcdDummyAddress()))\n200: \t\tcfg := types.CiliumClusterConfig{ID: uint32(i + 1)}\n201: \t\trequire.NoError(t, utils.SetClusterConfig(context.Background(), cluster, cfg, kvstore.Client()))\n202: \t}\n203: \n204: \tvar ready lock.Map[string, bool]\n205: \tisReady := func(name string) bool {\n206: \t\trdy, _ := ready.Load(name)\n207: \t\treturn rdy\n208: \t}\n209: \n210: \tvar blockRemoval lock.Map[string, chan struct{}]\n211: \tblockRemoval.Store(\"cluster1\", make(chan struct{}))\n212: \tblockRemoval.Store(\"cluster2\", make(chan struct{}))\n213: \tblockRemoval.Store(\"cluster3\", make(chan struct{}))\n214: \tblockRemoval.Store(\"cluster4\", make(chan struct{}))\n215: \n216: \tgcm := NewClusterMesh(Configuration{\n217: \t\tConfig:      Config{ClusterMeshConfig: baseDir},\n218: \t\tClusterInfo: types.ClusterInfo{ID: 255, Name: \"local\"},\n219: \t\tNewRemoteCluster: func(name string, _ StatusFunc) RemoteCluster {\n220: \t\t\treturn &fakeRemoteCluster{\n221: \t\t\t\tonRun: func(context.Context) { ready.Store(name, true) },\n222: \t\t\t\tonRemove: func(ctx context.Context) {\n223: \t\t\t\t\twait, _ := blockRemoval.Load(name)\n224: \t\t\t\t\tselect {\n225: \t\t\t\t\tcase <-wait:\n226: \t\t\t\t\tcase <-ctx.Done():\n227: \t\t\t\t\t}\n228: \t\t\t\t},\n229: \t\t\t}\n230: \t\t},\n231: \t\tMetrics: MetricsProvider(\"clustermesh\")(),\n232: \t})\n233: \thivetest.Lifecycle(t).Append(gcm)\n234: \tcm := gcm.(*clusterMesh)\n235: \n236: \t// Directly call the add/remove methods, rather than creating/removing the\n237: \t// files to prevent race conditions due to the interplay with the watcher.\n238: \tcm.add(\"cluster1\", path(\"cluster1\"))\n239: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, isReady(\"cluster1\")) }, timeout, tick, \"Cluster1 is not ready\")\n240: \n241: \t// A blocked cluster removal operation should not block parallel cluster additions\n242: \tcm.remove(\"cluster1\")\n243: \n244: \tcm.add(\"cluster2\", path(\"cluster2\"))\n245: \tcm.add(\"cluster3\", path(\"cluster3\"))\n246: \n247: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, isReady(\"cluster2\")) }, timeout, tick, \"Cluster2 is not ready\")\n248: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, isReady(\"cluster3\")) }, timeout, tick, \"Cluster3 is not ready\")\n249: \n250: \t// Unblock the cluster removal\n251: \tblock, _ := blockRemoval.Load(\"cluster1\")\n252: \tclose(block)\n253: \n254: \t// Multiple removals and additions, ending with an addition should lead to a ready cluster\n255: \tready.Store(\"cluster2\", false)\n256: \tcm.remove(\"cluster2\")\n257: \tcm.add(\"cluster2\", path(\"cluster2\"))\n258: \tcm.remove(\"cluster2\")\n259: \tcm.add(\"cluster2\", path(\"cluster2\"))\n260: \n261: \trequire.False(t, isReady(\"cluster2\"), \"Cluster2 is ready, although it shouldn't\")\n262: \n263: \t// Unblock the cluster removal\n264: \tblock, _ = blockRemoval.Load(\"cluster2\")\n265: \tclose(block)\n266: \n267: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, isReady(\"cluster2\")) }, timeout, tick, \"Cluster2 is not ready\")\n268: \n269: \t// Multiple removals and additions, ending with a removal should lead to a non-ready cluster\n270: \tready.Store(\"cluster3\", false)\n271: \tcm.remove(\"cluster3\")\n272: \tcm.add(\"cluster3\", path(\"cluster3\"))\n273: \tcm.remove(\"cluster3\")\n274: \tcm.add(\"cluster3\", path(\"cluster3\"))\n275: \tcm.remove(\"cluster3\")\n276: \n277: \trequire.False(t, isReady(\"cluster3\"), \"Cluster3 is ready, although it shouldn't\")\n278: \n279: \t// Unblock the cluster removal\n280: \tblock, _ = blockRemoval.Load(\"cluster3\")\n281: \tclose(block)\n282: \n283: \t// Make sure that the deletion go routine terminated before checking\n284: \tcm.wg.Wait()\n285: \trequire.False(t, isReady(\"cluster3\"), \"Cluster3 is ready, although it shouldn't\")\n286: \n287: \tcm.add(\"cluster4\", path(\"cluster4\"))\n288: \trequire.EventuallyWithT(t, func(c *assert.CollectT) { assert.True(c, isReady(\"cluster4\")) }, timeout, tick, \"Cluster4 is not ready\")\n289: \n290: \t// Never unblock the cluster removal, and assert that the stop hook terminates\n291: \t// regardless due to the context being closed.\n292: \tcm.remove(\"cluster4\")\n293: }\n\n(End of file - total 293 lines)\n</content>",
