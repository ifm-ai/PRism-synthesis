              "patch": "Index: src/en/voyceme/build.gradle\n===================================================================\n--- src/en/voyceme/build.gradle\t\n+++ src/en/voyceme/build.gradle\t\n@@ -1,7 +1,8 @@\n ext {\n     extName = 'Voyce.Me'\n     extClass = '.VoyceMe'\n-    extVersionCode = 3\n+    extVersionCode = 4\n+    isNsfw = false\n }\n \n apply from: \"$rootDir/common.gradle\"\n",
