n> columns = postTransformChangeInfo.getPostTransformedSchema().getColumns();\n119: \n120:         for (int i = 0; i < columns.size(); i++) {\n121:             ProjectionColumnProcessor projectionColumnProcessor =\n122:                     cachedProjectionColumnProcessors.get(i);\n123:             if (projectionColumnProcessor != null) {\n124:                 ProjectionColumn projectionColumn = projectionColumnProcessor.getProjectionColumn();\n125:                 valueList.add(\n126:                         DataTypeConverter.convert(\n127:                                 projectionColumnProcessor.evaluate(payload, epochTime),\n128:                                 projectionColumn.getDataType()));\n129:             } else {\n130:                 Column column = columns.get(i);\n131:                 valueList.add(\n132:                         getValueFromBinaryRecordData(\n133:                                 column.getName(),\n134:                                 column.getType(),\n135:                                 payload,\n136:                                 postTransformChangeInfo.getPreTransformedSchema().getColumns(),\n137:                                 postTransformChangeInfo.getPreTransformedFieldGetters()));\n138:             }\n139:         }\n140: \n141:         return postTransformChangeInfo\n142:                 .getRecordDataGenerator()\n143:                 .generate(valueList.toArray(new Object[0]));\n144:     }\n145: \n146:     private Object getValueFromBinaryRecordData(\n147:             String columnName,\n148:             DataType expectedType,\n149:             BinaryRecordData binaryRecordData,\n150:             List<Column> columns,\n151:             RecordData.FieldGetter[] fieldGetters) {\n152:         for (int i = 0; i < columns.size(); i++) {\n153:             if (columnName.equals(columns.get(i).getName())) {\n154:                 return DataTypeConverter.convert(\n155:                         fieldGetters[i].getFieldOrNull(binaryR