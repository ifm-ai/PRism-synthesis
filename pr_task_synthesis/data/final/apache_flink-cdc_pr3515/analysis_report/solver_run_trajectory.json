import org.apache.flink.streaming.api.operators.OneInputStreamOperator;\n35: import org.apache.flink.streaming.api.operators.Output;\n36: import org.apache.flink.streaming.runtime.streamrecord.StreamRecord;\n37: import org.apache.flink.streaming.runtime.tasks.StreamTask;\n38: \n39: import javax.annotation.Nullable;\n40: \n41: import java.io.Serializable;\n42: import java.lang.reflect.InvocationTargetException;\n43: import java.time.ZoneId;\n44: import java.util.ArrayList;\n45: import java.util.List;\n46: import java.util.Map;\n47: import java.util.Objects;\n48: import java.util.Optional;\n49: import java.util.concurrent.ConcurrentHashMap;\n50: import java.util.stream.Collectors;\n51: \n52: /**\n53:  * A data process function that performs column filtering, calculated column evaluation & final\n54:  * projection.\n55:  */\n56: public class PostTransformOperator extends AbstractStreamOperator<Event>\n57:         implements OneInputStreamOperator<Event, Event>, Serializable {\n58: \n59:     private static final long serialVersionUID = 1L;\n60: \n61:     private final String timezone;\n62:     private final List<TransformRule> transformRules;\n63:     private transient List<PostTransformer> transforms;\n64: \n65:     /** keep the relationship of TableId and table information. */\n66:     private final Map<TableId, PostTransformChangeInfo> postTransformChangeInfoMap;\n67: \n68:     private final List<Tuple2<String, String>> udfFunctions;\n69:     private List<UserDefinedFunctionDescriptor> udfDescriptors;\n70:     private transient Map<String, Object> udfFunctionInstances;\n71: \n72:     private transient Map<Tuple2<TableId, TransformProjection>, TransformProjectionProcessor>\n73:             transformProjectionProcessorMap;\n74:     private transient Map<Tuple2<TableId, TransformFilter>, TransformFilterProcessor>\n75:             transformFilterProcessorMap;\n76: \n77:     public static PostTransformOperator.Builder newBuilder() {\n78:         return new PostTransformOperator.Builder();\n79:     }\n80: \n81:     /** Builder of {@link PostTransformOperator}. */\n82:     public static class Builder {\n83:         private final List<TransformRule> transformRules = new ArrayList<>();\n84:         private String timezone;\n85:         private final List<Tuple2<String, String>> udfFunctions = new ArrayList<>();\n86: \n87:         public PostTransformOperator.Builder addTransform(\n88:                 String tableInclusions,\n89:                 @Nullable String projection,\n90:                 @Nullable String filter,\n91:                 String primaryKey,\n92:                 String partitionKey,\n93:                 String tableOptions) {\n94:             transformRules.add(\n95:                     new TransformRule(\n96:                             tableInclusions,\n97:                             projection,\n98:                             filter,\n99:                             primaryKey,\n100:                             partitionKey,\n101:                             tableOptions));\n102:             return this;\n103:         }\n104: \n105:         public PostTransformOperator.Builder addTransform(\n106:                 String tableInclusions, @Nullable String projection, @Nullable String filter) {\n107:             transformRules.add(new TransformRule(tableInclusions, projection, filter, \"\", \"\", \"\"));\n108:             return this;\n109:         }\n110: \n111:         public PostTransformOperator.Builder addTimezone(String timezone) {\n112:             if (PipelineOptions.PIPELINE_LOCAL_TIME_ZONE.defaultValue().equals(timezone)) {\n113:                 this.timezone = ZoneId.systemDefault().toString();\n114:             } else {\n115:                 this.timezone = timezone;\n116:             }\n117:             return this;\n118:         }\n119: \n120:         public PostTransformOperator.Builder addUdfFunctions(\n121:                 List<Tuple2<String, String>> udfFunctions) {\n122:             this.udfFunctions.addAll(udfFunctions);\n123:             return this;\n124:         }\n125: \n126:         public PostTransformOperator build() {\n127:             return new PostTransformOperator(transformRules, timezone, udfFunctions);\n128:         }\n129:     }\n130: \n131:     private PostTransformOperator(\n132:             List<TransformRule> transformRules,\n133:             String timezone,\n134:             List<Tuple2<String, String>> udfFunctions) {\n135:         this.transformRules = transformRules;\n136:         this.timezone = timezone;\n137:         this.postTransformChangeInfoMap = new ConcurrentHashMap<>();\n138:         this.transformFilterProcessorMap = new ConcurrentHashMap<>();\n139:         this.transformProjectionProcessorMap = new ConcurrentHashMap<>();\n140:         this.udfFunctions = udfFunctions;\n141:         this.udfFunctionInstances = new ConcurrentHashMap<>();\n142:     }\n143: \n144:     @Override\n145:     public void setup(\n146:             StreamTask<?, ?> containingTask,\n147:             StreamConfig config,\n148:             Output<StreamRecord<Event>> output) {\n149:         super.setup(containingTask, config, output);\n150:         udfDescriptors =\n151:                 udfFunctions.stream()\n152:                         .map(\n153:                                 udf -> {\n154:                                     return new UserDefinedFunctionDescriptor(udf.f0, udf.f1);\n155:                                 })\n156:                         .collect(Collectors.toList());\n157:     }\n158: \n159:     @Override\n160:     public void open() throws Exception {\n161:         super.open();\n162:         transforms =\n163:                 transformRules.stream()\n164:                         .map(\n165:                                 tuple3 -> {\n166:                                     String tableInclusions = tuple3.getTableInclusions();\n167:                                     String projection = tuple3.getProjection();\n168:                                     String filterExpression = tuple3.getFilter();\n169: \n170:                                     Selectors selectors =\n171:                                             new Selectors.SelectorsBuilder()\n172:                                                     .includeTables(tableInclusions)\n173:                                                     .build();\n174:                                     return new PostTransformer(\n175:                                             selectors,\n176:                                             TransformProjection.of(projection).orElse(null),\n177:                                             TransformFilter.of(filterExpression, udfDescriptors)\n178:                                                     .orElse(null));\n179:                                 })\n180:                         .collect(Collectors.toList());\n181:         this.transformProjectionProcessorMap = new ConcurrentHashMap<>();\n182:         this.transformFilterProcessorMap = new ConcurrentHashMap<>();\n183:         this.udfFunctionInstances = new ConcurrentHashMap<>();\n184:         udfDescriptors.forEach(\n185:                 udf -> {\n186:                     try {\n187:                         Class<?> clazz = Class.forName(udf.getClasspath());\n188:                         udfFunctionInstances.put(udf.getName(), clazz.newInstance());\n189:                     } catch (ClassNotFoundException\n190:                             | InstantiationException\n191:                             | IllegalAccessException e) {\n192:                         throw new RuntimeException(\"Failed to instantiate UDF function \" + udf);\n193:                     }\n194:                 });\n195:         initializeUdf();\n196:     }\n197: \n198:     @Override\n199:     public void finish() throws Exception {\n200:         super.finish();\n201:         clearOperator();\n202:     }\n203: \n204:     @Override\n205:     public void close() throws Exception {\n206:         super.close();\n207:         clearOperator();\n208: \n209:         // Clean up UDF instances\n210:         destroyUdf();\n211:         udfFunctionInstances.clear();\n212:     }\n213: \n214:     @Override\n215:     public void processElement(StreamRecord<Event> element) throws Exception {\n216:         Event event = element.getValue();\n217:         if (event instanceof SchemaChangeEvent) {\n218:             SchemaChangeEvent schemaChangeEvent = (SchemaChangeEvent) event;\n219:             transformProjectionProcessorMap\n220:                     .keySet()\n221:                     .removeIf(e -> Objects.equals(e.f0, schemaChangeEvent.tableId()));\n222:             event = cacheSchema(schemaChangeEvent);\n223:             output.collect(new StreamRecord<>(event));\n224:         } else if (event instanceof DataChangeEvent) {\n225:             Optional<DataChangeEvent> dataChangeEventOptional =\n226:                     processDataChangeEvent(((DataChangeEvent) event));\n227:             if (dataChangeEventOptional.isPresent()) {\n228:                 output.collect(new StreamRecord<>(dataChangeEventOptional.get()));\n229:             }\n230:         }\n231:     }\n232: \n233:     private SchemaChangeEvent cacheSchema(SchemaChangeEvent event) throws Exception {\n234:         TableId tableId = event.tableId();\n235:         Schema schema;\n236:         if (event instanceof CreateTableEvent) {\n237:             CreateTableEvent createTableEvent = (CreateTableEvent) event;\n238:             schema = createTableEvent.getSchema();\n239:         } else {\n240:             schema =\n241:                     SchemaUtils.applySchemaChangeEvent(\n242:                             getPostTransformChangeInfo(tableId).getPreTransformedSchema(), event);\n243:         }\n244: \n245:         Schema projectedSchema = transformSchema(tableId, schema);\n246:         postTransformChangeInfoMap.put(\n247:                 tableId, PostTransformChangeInfo.of(tableId, projectedSchema, schema));\n248: \n249:         if (event instanceof CreateTableEvent) {\n250:             return new CreateTableEvent(event.tableId(), projectedSchema);\n251:         }\n252:         return event;\n253:     }\n254: \n255:     private PostTransformChangeInfo getPostTransformChangeInfo(TableId tableId) {\n256:         PostTransformChangeInfo tableInfo = postTransformChangeInfoMap.get(tableId);\n257:         if (tableInfo == null) {\n258:             throw new RuntimeException(\n259:                     \"Schema for \" + tableId + \" not found. This shouldn't happen.\");\n260:         }\n261:         return tableInfo;\n262:     }\n263: \n264:     private Schema transformSchema(TableId tableId, Schema schema) throws Exception {\n265:         List<Schema> newSchemas = new ArrayList<>();\n266:         for (PostTransformer transform : transforms) {\n267:             Selectors selectors = transform.getSelectors();\n268:             if (selectors.isMatch(tableId) && transform.getProjection().isPresent()) {\n269:                 TransformProjection transformProjection = transform.getProjection().get();\n270:                 if (transformProjection.isValid()) {\n271:                     if (!transformProjectionProcessorMap.containsKey(\n272:                             Tuple2.of(tableId, transformProjection))) {\n273:                         transformProjectionProcessorMap.put(\n274:                                 Tuple2.of(tableId, transformProjection),\n275:                                 TransformProjectionProcessor.of(\n276:                                         transformProjection,\n277:                                         timezone,\n278:                                         udfDescriptors,\n279:                                         getUdfFunctionInstances()));\n280:                     }\n281:                     TransformProjectionProcessor postTransformProcessor =\n282:                             transformProjectionProcessorMap.get(\n283:                                     Tuple2.of(tableId, transformProjection));\n284:                     // update the columns of projection and add the column of projection into Schema\n285:                     newSchemas.add(postTransformProcessor.processSchemaChangeEvent(schema));\n286:                 }\n287:             }\n288:         }\n289:         if (newSchemas.isEmpty()) {\n290:             return schema;\n291:         }\n292: \n293:         return SchemaUtils.inferWiderSchema(newSchemas);\n294:     }\n295: \n296:     private List<Object> getUdfFunctionInstances() {\n297:         return udfDescriptors.stream()\n298:                 .map(e -> udfFunctionInstances.get(e.getName()))\n299:                 .collect(Collectors.toList());\n300:     }\n301: \n302:     private Optional<DataChangeEvent> processDataChangeEvent(DataChangeEvent dataChangeEvent)\n303:             throws Exception {\n304:         TableId tableId = dataChangeEvent.tableId();\n305:         PostTransformChangeInfo tableInfo = getPostTransformChangeInfo(tableId);\n306:         List<Optional<DataChangeEvent>> transformedDataChangeEventOptionalList = new ArrayList<>();\n307:         long epochTime = System.currentTimeMillis();\n308:         for (PostTransformer transform : transforms) {\n309:             Selectors selectors = transform.getSelectors();\n310: \n311:             if (selectors.isMatch(tableId)) {\n312:                 Optional<DataChangeEvent> dataChangeEventOptional = Optional.of(dataChangeEvent);\n313:                 Optional<TransformProjection> transformProjectionOptional =\n314:                         transform.getProjection();\n315:                 Optional<TransformFilter> transformFilterOptional = transform.getFilter();\n316: \n317:                 if (transformFilterOptional.isPresent()\n318:                         && transformFilterOptional.get().isVaild()) {\n319:                     TransformFilter transformFilter = transformFilterOptional.get();\n320:                     if (!transformFilterProcessorMap.containsKey(\n321:                             Tuple2.of(tableId, transformFilter))) {\n322:                         transformFilterProcessorMap.put(\n323:                                 Tuple2.of(tableId, transformFilter),\n324:                                 TransformFilterProcessor.of(\n325:                                         tableInfo,\n326:                                         transformFilter,\n327:                                         timezone,\n328:                                         udfDescriptors,\n329:                                         getUdfFunctionInstances()));\n330:                     }\n331:                     TransformFilterProcessor transformFilterProcessor =\n332:                             transformFilterProcessorMap.get(Tuple2.of(tableId, transformFilter));\n333:                     dataChangeEventOptional =\n334:                             processFilter(\n335:                                     transformFilterProcessor,\n336:                                     dataChangeEventOptional.get(),\n337:                                     epochTime);\n338:                 }\n339:                 if (dataChangeEventOptional.isPresent()\n340:                         && transformProjectionOptional.isPresent()\n341:                         && transformProjectionOptional.get().isValid()) {\n342:                     TransformProjection transformProjection = transformProjectionOptional.get();\n343:                     if (!transformProjectionProcessorMap.containsKey(\n344:                                     Tuple2.of(tableId, transformProjection))\n345:                             || !transformProjectionProcessorMap\n346:                                     .get(Tuple2.of(tableId, transformProjection))\n347:                                     .hasTableInfo()) {\n348:                         transformProjectionProcessorMap.put(\n349:                                 Tuple2.of(tableId, transformProjection),\n350:                                 TransformProjectionProcessor.of(\n351:                                         tableInfo,\n352:                                         transformProjection,\n353:                                         timezone,\n354:                                         udfDescriptors,\n355:                                         getUdfFunctionInstances()));\n356:                     }\n357:                     TransformProjectionProcessor postTransformProcessor =\n358:                             transformProjectionProcessorMap.get(\n359:                                     Tuple2.of(tableId, transformProjection));\n360:                     dataChangeEventOptional =\n361:                             processProjection(\n362:                                     postTransformProcessor,\n363:                                     dataChangeEventOptional.get(),\n364:                                     epochTime);\n365:                 }\n366:                 transformedDataChangeEventOptionalList.add(dataChangeEventOptional);\n367:             }\n368:         }\n369: \n370:         if (transformedDataChangeEventOptionalList.isEmpty()) {\n371:             return processPostProjection(tableInfo, dataChangeEvent);\n372:         } else {\n373:             for (Optional<DataChangeEvent> dataChangeEventOptional :\n374:                     transformedDataChangeEventOptionalList) {\n375:                 if (dataChangeEventOptional.isPresent()) {\n376:                     return processPostProjection(tableInfo, dataChangeEventOptional.get());\n377:                 }\n378:             }\n379:             return Optional.empty();\n380:         }\n381:     }\n382: \n383:     private Optional<DataChangeEvent> processFilter(\n384:             TransformFilterProcessor transformFilterProcessor,\n385:             DataChangeEvent dataChangeEvent,\n386:             long epochTime)\n387:             throws Exception {\n388:         BinaryRecordData before = (BinaryRecordData) dataChangeEvent.before();\n389:         BinaryRecordData after = (BinaryRecordData) dataChangeEvent.after();\n390:         // insert and update event only process afterData, delete only process beforeData\n391:         if (after != null) {\n392:             if (transformFilterProcessor.process(after, epochTime)) {\n393:                 return Optional.of(dataChangeEvent);\n394:             } else {\n395:                 return Optional.empty();\n396:             }\n397:         } else if (before != null) {\n398:             if (transformFilterProcessor.process(before, epochTime)) {\n399:                 return Optional.of(dataChangeEvent);\n400:             } else {\n401:                 return Optional.empty();\n402:             }\n403:         }\n404:         return Optional.empty();\n405:     }\n406: \n407:     private Optional<DataChangeEvent> processProjection(\n408:             TransformProjectionProcessor postTransformProcessor,\n409:             DataChangeEvent dataChangeEvent,\n410:             long epochTime) {\n411:         BinaryRecordData before = (BinaryRecordData) dataChangeEvent.before();\n412:         BinaryRecordData after = (BinaryRecordData) dataChangeEvent.after();\n413:         if (before != null) {\n414:             BinaryRecordData projectedBefore =\n415:                     postTransformProcessor.processData(before, epochTime);\n416:             dataChangeEvent = DataChangeEvent.projectBefore(dataChangeEvent, projectedBefore);\n417:         }\n418:         if (after != null) {\n419:             BinaryRecordData projectedAfter = postTransformProcessor.processData(after, epochTime);\n420:             dataChangeEvent = DataChangeEvent.projectAfter(dataChangeEvent, projectedAfter);\n421:         }\n422:         return Optional.of(dataChangeEvent);\n423:     }\n424: \n425:     private Optional<DataChangeEvent> processPostProjection(\n426:             PostTransformChangeInfo tableInfo, DataChangeEvent dataChangeEvent) throws Exception {\n427:         BinaryRecordData before = (BinaryRecordData) dataChangeEvent.before();\n428:         BinaryRecordData after = (BinaryRecordData) dataChangeEvent.after();\n429:         if (before != null) {\n430:             BinaryRecordData projectedBefore = projectRecord(tableInfo, before);\n431:             dataChangeEvent = DataChangeEvent.projectBefore(dataChangeEvent, projectedBefore);\n432:         }\n433:         if (after != null) {\n434:             BinaryRecordData projectedAfter = projectRecord(tableInfo, after);\n435:             dataChangeEvent = DataChangeEvent.projectAfter(dataChangeEvent, projectedAfter);\n436:         }\n437:         return Optional.of(dataChangeEvent);\n438:     }\n439: \n440:     private BinaryRecordData projectRecord(\n441:             PostTransformChangeInfo tableInfo, BinaryRecordData recordData) {\n442:         List<Object> valueList = new ArrayList<>();\n443:         RecordData.FieldGetter[] fieldGetters = tableInfo.getPostTransformedFieldGetters();\n444: \n445:         for (RecordData.FieldGetter fieldGetter : fieldGetters) {\n446:             valueList.add(fieldGetter.getFieldOrNull(recordData));\n447:         }\n448: \n449:         return tableInfo\n450:                 .getRecordDataGenerator()\n451:                 .generate(valueList.toArray(new Object[valueList.size()]));\n452:     }\n453: \n454:     private void clearOperator() {\n455:         this.transforms = null;\n456:         this.transformProjectionProcessorMap = null;\n457:         this.transformFilterProcessorMap = null;\n458:         TransformExpressionCompiler.cleanUp();\n459:     }\n460: \n461:     private void initializeUdf() {\n462:         udfDescriptors.forEach(\n463:                 udf -> {\n464:                     try {\n465:                         if (udf.isCdcPipelineUdf()) {\n466:                             // We use reflection to invoke UDF methods since we may add more methods\n467:                             // into UserDefinedFunction interface, thus the provided UDF classes\n468:                             // might not be compatible with the interface definition in CDC common.\n469:                             Object udfInstance = udfFunctionInstances.get(udf.getName());\n470:                             udfInstance.getClass().getMethod(\"open\").invoke(udfInstance);\n471:                         } else {\n472:                             // Do nothing, Flink-style UDF lifecycle hooks are not supported\n473:                         }\n474:                     } catch (InvocationTargetException\n475:                             | NoSuchMethodException\n476:                             | IllegalAccessException ex) {\n477:                         throw new RuntimeException(\"Failed to initialize UDF \" + udf, ex);\n478:                     }\n479:                 });\n480:     }\n481: \n482:     private void destroyUdf() {\n483:         udfDescriptors.forEach(\n484:                 udf -> {\n485:                     try {\n486:                         if (udf.isCdcPipelineUdf()) {\n487:                             // We use reflection to invoke UDF methods since we may add more methods\n488:                             // into UserDefinedFunction interface, thus the provided UDF classes\n489:                             // might not be compatible with the interface definition in CDC common.\n490:                             Object udfInstance = udfFunctionInstances.get(udf.getName());\n491:                             udfInstance.getClass().getMethod(\"close\").invoke(udfInstance);\n492:                         } else {\n493:                             // Do nothing, Flink-style UDF lifecycle hooks are not supported\n494:                         }\n495:                     } catch (InvocationTargetException\n496:                             | NoSuchMethodException\n497:                             | IllegalAccessException ex) {\n498:                         throw new RuntimeException(\"Failed to destroy UDF \" + udf, ex);\n499:                     }\n500:                 });\n501:     }\n502: }\n\n(End of file - total 502 lines)\n</content>",
