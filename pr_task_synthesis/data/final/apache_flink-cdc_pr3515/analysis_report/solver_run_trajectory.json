teEvent(\n276:                         CUSTOMERS_TABLEID,\n277:                         recordDataGenerator.generate(\n278:                                 new Object[] {\n279:                                     new BinaryStringData(\"1\"), new BinaryStringData(\"2\"), null\n280:                                 }),\n281:                         recordDataGenerator.generate(\n282:                                 new Object[] {\n283:                                     new BinaryStringData(\"1\"), new BinaryStringData(\"3\"), null\n284:                                 }));\n285:         DataChangeEvent updateEventExpect =\n286:                 DataChangeEvent.updateEvent(\n287:                         CUSTOMERS_TABLEID,\n288:                         recordDataGenerator.generate(\n289:                                 new Object[] {\n290:                                     new BinaryStringData(\"1\"),\n291:                                     new BinaryStringData(\"2\"),\n292:                                     new BinaryStringData(\"12\")\n293:                                 }),\n294:                         recordDataGenerator.generate(\n295:                                 new Object[] {\n296:                                     new BinaryStringData(\"1\"),\n297:                                     new BinaryStringData(\"3\"),\n298:                                     new BinaryStringData(\"13\")\n299:                                 }));\n300: \n301:         transform.processElement(new StreamRecord<>(createTableEvent));\n302:         Assertions.assertThat(\n303:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n304:                 .isEqualTo(\n305:                         new StreamRecord<>(\n306:                                 new CreateTableEvent(CUSTOMERS_TABLEID, CUSTOMERS_SCHEMA)));\n307:         transform.processElement(new StreamRecord<>(insertEvent));\n308:         Assertions.assertThat(\n309:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n310:                 .isEqualTo(new StreamRecord<>(insertEventExpect));\n311:         transform.processElement(new StreamRecord<>(updateEvent));\n312:         Assertions.assertThat(\n313:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n314:                 .isEqualTo(new StreamRecord<>(updateEventExpect));\n315:     }\n316: \n317:     @Test\n318:     void testDataChangeEventTransformTwice() throws Exception {\n319:         PostTransformOperator transform =\n320:                 PostTransformOperator.newBuilder()\n321:                         .addTransform(\n322:                                 CUSTOMERS_TABLEID.identifier(),\n323:                                 \"*, concat(col1, '1') col12\",\n324:                                 \"col1 = '1'\")\n325:                         .addTransform(\n326:                                 CUSTOMERS_TABLEID.identifier(),\n327:                                 \"*, concat(col1, '2') col12\",\n328:                                 \"col1 = '2'\")\n329:                         .build();\n330:         EventOperatorTestHarness<PostTransformOperator, Event>\n331:                 transformFunctionEventEventOperatorTestHarness =\n332:                         new EventOperatorTestHarness<>(transform, 1);\n333:         // Initialization\n334:         transformFunctionEventEventOperatorTestHarness.open();\n335:         // Create table\n336:         CreateTableEvent createTableEvent =\n337:                 new CreateTableEvent(CUSTOMERS_TABLEID, CUSTOMERS_SCHEMA);\n338:         BinaryRecordDataGenerator recordDataGenerator =\n339:                 new BinaryRecordDataGenerator(((RowType) CUSTOMERS_SCHEMA.toRowDataType()));\n340:         // Insert\n341:         DataChangeEvent insertEvent =\n342:                 DataChangeEvent.insertEvent(\n343:                         CUSTOMERS_TABLEID,\n344:           