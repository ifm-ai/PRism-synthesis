t()) {\n254:             if (sqlNode instanceof SqlIdentifier && ((SqlIdentifier) sqlNode).isStar()) {\n255:                 expandedNodes.addAll(\n256:                         columns.stream()\n257:                                 .map(c -> new SqlIdentifier(c.getName(), SqlParserPos.QUOTED_ZERO))\n258:                                 .collect(Collectors.toList()));\n259:             } else {\n260:                 expandedNodes.add(sqlNode);\n261:             }\n262:         }\n263:         sqlSelect.setSelectList(new SqlNodeList(expandedNodes, SqlParserPos.ZERO));\n264:     }\n265: \n266:     // Returns projected columns based on given projection expression.\n267:     // For example, given projection expression \"a, b, c, upper(a) as d, b as e\" and columns array\n268:     // [a, b, c, x, y, z], returns projection column array [a, b, c, d, e].\n269:     public static List<ProjectionColumn> generateProjectionColumns(\n270:             String projectionExpression,\n271:             List<Column> columns,\n272:             List<UserDefinedFunctionDescriptor> udfDescriptors) {\n273:         if (isNullOrWhitespaceOnly(projectionExpression)) {\n274:             return new ArrayList<>();\n275:         }\n276:         SqlSelect sqlSelect = parseProjectionExpression(projectionExpression);\n277:         if (sqlSelect.getSelectList().isEmpty()) {\n278:             return new ArrayList<>();\n279:         }\n280:         expandWildcard(sqlSelect, columns);\n281:         RelNode relNode = sqlToRel(columns, sqlSelect, udfDescriptors);\n282:         Map<String, RelDataType> relDataTypeMap =\n283:                 relNode.getRowType().getFieldList().stream()\n284:                         .collect(\n285:                                 Collectors.toMap(\n286:                                         RelDataTypeField::getName, RelDataTypeField::getType));\n287: \n288:         Map<String, DataType> rawDataTypeMap =\n289:                 columns.stream().collect(Collectors.toMap(Column::