er.CompileException;\n37: import org.codehaus.commons.compiler.Location;\n38: import org.codehaus.janino.ExpressionEvaluator;\n39: import org.codehaus.janino.Java;\n40: \n41: import java.util.ArrayList;\n42: import java.util.Arrays;\n43: import java.util.List;\n44: import java.util.Optional;\n45: \n46: /**\n47:  * Use Janino compiler to compiler the statement of flink cdc pipeline transform into the executable\n48:  * code of Janino. For example, compiler 'string1 || string2' into 'concat(string1, string2)'. The\n49:  * core logic is to traverse SqlNode tree and transform to Atom tree. Janino documents:\n50:  * https://www.janino.net/index.html#properties\n51:  */\n52: public class JaninoCompiler {\n53: \n54:     private static final List<SqlTypeName> SQL_TYPE_NAME_IGNORE = Arrays.asList(SqlTypeName.SYMBOL);\n55:     private static final List<String> TIMEZONE_FREE_TEMPORAL_FUNCTIONS =\n56:             Arrays.asList(\"CURRENT_TIMESTAMP\", \"NOW\");\n57: \n58:     private static final List<String> TIMEZONE_REQUIRED_TEMPORAL_FUNCTIONS =\n59:             Arrays.asList(\"LOCALTIME\", \"LOCALTIMESTAMP\", \"CURRENT_TIME\", \"CURRENT_DATE\");\n60: \n61:     private static final List<String> TIMEZONE_FREE_TEMPORAL_CONVERSION_FUNCTIONS =\n62:             Arrays.asList(\"DATE_FORMAT\");\n63: \n64:     private static final List<String> TIMEZONE_REQUIRED_TEMPORAL_CONVERSION_FUNCTIONS =\n65:             Arrays.asList(\"TO_DATE\", \"TO_TIMESTAMP\");\n66: \n67:     public static final String DEFAULT_EPOCH_TIME = \"__epoch_time__\";\n68:     public static final String DEFAULT_TIME_ZONE = \"__time_zone__\";\n69: \n70:     public static String loadSystemFunction(String expression) {\n71:         return \"import static org.apache.flink.cdc.runtime.functions.SystemFunctionUtils.*;\"\n72:                 + expression;\n73:     }\n74: \n75:     public static ExpressionEvaluator compileExpression(\n76:             String expression,\n77:             List<String> argumentNames,\n78:             List<Class<?>> argumentClasses,\n79:             Class<?> returnClass) {\n80:         ExpressionEvaluator expressionEvaluator = new ExpressionEvaluator();\n81:         expressionEvaluator.setParameters(\n82:                 argumentNames.toArray(new String[0]), argumentClasses.toArray(new Class[0]));\n83:         expressionEvaluator.setExpressionType(returnClass);\n84:         try {\n85:             expressionEvaluator.cook(expression);\n86:             return expressionEvaluator;\n87:         } catch (CompileException e) {\n88:             throw new InvalidProgramException(\n89:                     \"Expression cannot be compiled. This is a bug. Please file an issue.\\nExpression: \"\n90:                             + expression,\n91:                     e);\n92:         }\n93:     }\n94: \n95:     public static String translateSqlNodeToJaninoExpression(\n96:             SqlNode transform, List<UserDefinedFunctionDescriptor> udfDescriptors) {\n97:         Java.Rvalue rvalue = translateSqlNodeToJaninoRvalue(transform, udfDescriptors);\n98:         if (rvalue != null) {\n99:             return rvalue.toString();\n100:         }\n101:         return \"\";\n102:     }\n103: \n104:     public static Java.Rvalue translateSqlNodeToJaninoRvalue(\n105:             SqlNode transform, List<UserDefinedFunctionDescriptor> udfDescriptors) {\n106:         if (transform instanceof SqlIdentifier) {\n107:             return translateSqlIdentifier((SqlIdentifier) transform);\n108:         } else if (transform instanceof SqlBasicCall) {\n109:             return translateSqlBasicCall((SqlBasicCall) transform, udfDescriptors);\n110:         } else if (transform instanceof SqlCase) {\n111:             return translateSqlCase((SqlCase) transform, udfDescriptors);\n112:         } else if (transform instanceof SqlLiteral) {\n113:             return translateSqlSqlLiteral((SqlLiteral) transform);\n114:         }\n115:         return null;\n116:     }\n117: \n118:     private static Java.Rvalue translateSqlIdentifier(SqlIdentifier sqlIdentifier) {\n119:         String columnName = sqlIdentifier.names.get(sqlIdentifier.names.size() - 1);\n120:         if (TIMEZONE_FREE_TEMPORAL_FUNCTIONS.contains(columnName)) {\n121:             return generateTimezoneFreeTemporalFunctionOperation(columnName);\n122:         } else if (TIMEZONE_REQUIRED_TEMPORAL_FUNCTIONS.contains(columnName)) {\n123:             return generateTimezoneRequiredTemporalFunctionOperation(columnName);\n124:         } else if (TIMEZONE_FREE_TEMPORAL_CONVERSION_FUNCTIONS.contains(columnName)) {\n125:             return generateTimezoneFreeTemporalConversionFunctionOperation(columnName);\n126:         } else if (TIMEZONE_REQUIRED_TEMPORAL_CONVERSION_FUNCTIONS.contains(columnName)) {\n127:             return generateTimezoneRequiredTemporalConversionFunctionOperation(columnName);\n128:         } else {\n129:             return new Java.AmbiguousName(Location.NOWHERE, new String[] {columnName});\n130:         }\n131:     }\n132: \n133:     private static Java.Rvalue translateSqlSqlLiteral(SqlLiteral sqlLiteral) {\n134:         if (sqlLiteral.getValue() == null) {\n135:             return new Java.NullLiteral(Location.NOWHERE);\n136:         }\n137:         String value = sqlLiteral.getValue().toString();\n138:         if (sqlLiteral instanceof SqlCharStringLiteral) {\n139:             // Double quotation marks represent strings in Janino.\n140:             value = \"\\\"\" + value.substring(1, value.length() - 1) + \"\\\"\";\n141:         }\n142:         if (SQL_TYPE_NAME_IGNORE.contains(sqlLiteral.getTypeName())) {\n143:             value = \"\\\"\" + value + \"\\\"\";\n144:         }\n145:         return new Java.AmbiguousName(Location.NOWHERE, new String[] {value});\n146:     }\n147: \n148:     private static Java.Rvalue translateSqlBasicCall(\n149:             SqlBasicCall sqlBasicCall, List<UserDefinedFunctionDescriptor> udfDescriptors) {\n150:         List<SqlNode> operandList = sqlBas