umnName = sqlIdentifier.names.get(sqlIdentifier.names.size() - 1);\n425:                         }\n426:                     }\n427:                     if (columnNames.contains(columnName)) {\n428:                         throw new ParseException(\"Duplicate column definitions: \" + columnName);\n429:                     }\n430:                     columnNames.add(columnName);\n431:                 } else {\n432:                     throw new ParseException(\"Unrecognized projection: \" + sqlBasicCall.toString());\n433:                 }\n434:             } else if (sqlNode instanceof SqlIdentifier) {\n435:                 String columnName = sqlNode.toString();\n436:                 if (isMetadataColumn(columnName) && !columnNames.contains(columnName)) {\n437:                     columnNames.add(columnName);\n438:                 } else {\n439:                     continue;\n440:                 }\n441:             } else {\n442:                 throw new ParseException(\"Unrecognized projection: \" + sqlNode.toString());\n443:             }\n444:         }\n445:         return columnNames;\n446:     }\n447: \n448:     public static List<String> parseFilterColumnNameList(String filterExpression) {\n449:         if (isNullOrWhitespaceOnly(filterExpression)) {\n450:             return new ArrayList<>();\n451:         }\n452:         SqlSelect sqlSelect = parseFilterExpression(filterExpression);\n453:         if (!sqlSelect.hasWhere()) {\n454:             return new ArrayList<>();\n455:         }\n456:         SqlNode where = sqlSelect.getWhere();\n457:         return parseColumnNameList(where);\n458:     }\n459: \n460:     private static List<String> parseColumnNameList(SqlNode sqlNode) {\n461:         List<String> columnNameList = new ArrayList<>();\n462:         if (sqlNode instanceof SqlIdentifier) {\n463:             SqlIdentifier sqlIdentifier = (SqlIdentifier) sqlNode;\n464:             String columnName = sqlIdentifier.names.get(sqlIdentifier.names.size() - 1);\n465:             columnNameList.add(columnName);\n466:         } else if (sqlNode instanceof SqlCall) {\n467:             SqlCall sqlCall = (SqlCall) sqlNode;\n468:             findSqlIdentifier(sqlCall.getOperandList(), columnNameList);\n469:         } else if (sqlNode instanceof SqlNodeList) {\n470:             SqlNodeList sqlNodeList = (SqlNodeList) sqlNode;\n471:             findSqlIdentifier(sqlNodeList.getList(), columnNameList);\n472:         }\n473:         return columnNameList;\n474:     }\n475: \n476:     private static void findSqlIdentifier(List<SqlNode> sqlNodes, List<String> columnNameList) {\n477:         for (SqlNode sqlNode : sqlNodes) {\n478:             if (sqlNode instanceof SqlIdentifier) {\n479:                 SqlIdentifier sqlIdentifier = (SqlIdentifier) sqlNode;\n480:                 String columnName = sqlIdentifier.names.get(sqlIdentifier.names.size() - 1);\n481:                 columnNameList.add(columnName);\n482:             } else if (sqlNode instanceof SqlCall) {\n483:                 SqlCall sqlCall = (SqlCall) sqlNode;\n484:                 findSqlIdentifier(sqlCall.getOperandList(), columnNameList);\n485:             } else if (sqlNode instanceof SqlNodeList) {\n486:                 SqlNodeList sqlNodeList = (SqlNodeList) sqlNode;\n487:                 findSqlIdentifier(sqlNodeList.getList(), columnNameList);\n488:             }\n489:         }\n490:     }\n491: \n492:     private static SqlSelect parseProjectionExpression(String projection) {\n493:         StringBuilder statement = new StringBuilder();\n494:         statement.append(\"SELECT \");\n495:         statement.append(projection);\n496:         statement.append(\" FROM \");\n497:         statement.append(DEFAULT_TABLE);\n498:         return parseSelect(statement.toString());\n499:     }\n500: \n501:     private static List<Column> copyFillMetadataColumn(\n502:             String transformStatement, List<Column> columns) {\n503:         List<Column> columnsWithMetadata = new ArrayList<>(columns);\n504:         if (transformStatement.contains(DEFAULT_NAMESPACE_NAME)\n505:                 && !containsMetadataColumn(columnsWithMetadata, DEFAULT_NAMESPACE_NAME)) {\n506:             columnsWithMetadata.add(\n507:                     Column.physicalColumn(DEFAULT_NAMESPACE_NAME, DataTypes.STRING()));\n508:         }\n509:         if (transformStatement.contains(DEFAULT_SCHEMA_NAME)\n510:                 && !containsMetadataColumn(columnsWithMetadata, DEFAULT_SCHEMA_NAME)) {\n511:             columnsWithMetadata.add(Column.physicalColumn(DEFAULT_SCHEMA_NAME, DataTypes.STRING()));\n512:         }\n513:         if (transformStatement.contains(DEFAULT_TABLE_NAME)\n514:                 && !containsMetadataColumn(columnsWithMetadata, DEFAULT_TABLE_NAME)) {\n515:             columnsWithMetadata.add(Column.physicalColumn(DEFAULT_TABLE_NAME, DataTypes.STRING()));\n516:         }\n517:         return columnsWithMetadata;\n518:     }\n519: \n520:     private static boolean containsMetadataColumn(List<Column> columns, String columnName) {\n521:         return columns.stream().anyMatch(column -> column.getName().equals(columnName));\n522:     }\n523: \n524:     private static boolean isMetadataColumn(String columnName) {\n525:         return DEFAULT_TABLE_NAME.equals(columnName)\n526:                 || DEFAULT_SCHEMA_NAME.equals(columnName)\n527:                 || DEFAULT_NAMESPACE_NAME.equals(columnName);\n528:     }\n529: \n530:     public static SqlSelect parseFilterExpression(String filterExpression) {\n531:         StringBuilder statement = new StringBuilder();\n532:         statement.append(\"SELECT * FROM \");\n533:         statement.append(DEFAULT_TABLE);\n534:         if (!isNullOrWhitespaceOnly(filterExpression)) {\n535:             statement.append(\" WHERE \");\n536:             statement.append(filterExpression);\n537:         }\n538:         return parseSelect(statement.toString());\n539:     }\n540: \n541:     public static SqlNode rewriteExpression(SqlNode sqlNode, Map<String, SqlNode> replaceMap) {\n542:         if (sqlNode instanceof SqlCall) {\n543:             SqlCall sqlCall = (SqlCall) sqlNode;\n544: \n545:             List<SqlNode> operands = sqlCall.getOperandList();\n546:             IntStream.range(0, sqlCall.operandCount())\n547:                     .forEach(\n548:                             i ->\n549:                                     sqlCall.setOperand(\n550:                                             i, rewriteExpression(operands.get(i), replaceMap)));\n551:             return sqlCall;\n552:         } else if (sqlNode instanceof SqlIdentifier) {\n553:             SqlIdentifier sqlIdentifier = (SqlIdentifier) sqlNode;\n554:             if (sqlIdentifier.names.size() == 1) {\n555:                 String name = sqlIdentifier.names.get(0);\n556:                 if (replaceMap.containsKey(name)) {\n557:                     return replaceMap.get(name);\n558:                 }\n559:             }\n560:             return sqlIdentifier;\n561:         } else if (sqlNode instanceof SqlNodeList) {\n562:             SqlNodeList sqlNodeList = (SqlNodeList) sqlNode;\n563:             IntStream.range(0, sqlNodeList.size())\n564:                     .forEach(\n565:                             i ->\n566:                                     sqlNodeList.set(\n567:                                             i, rewriteExpression(sqlNodeList.get(i), replaceMap)));\n568:             return sqlNodeList;\n569:         } else {\n570:             return sqlNode;\n571:         }\n572:     }\n573: \n574:     // Filter expression might hold reference to a calculated column, which causes confusion about\n575:     // the sequence of projection and filtering operations. This function rewrites filtering about\n576:     // calculated columns to circumvent this problem.\n577:     public static String normalizeFilter(String projection, String filter) {\n578:         if (isNullOrWhitespaceOnly(projection) || isNullOrWhitespaceOnly(filter)) {\n579:             return filter;\n580:         }\n581: \n582:         SqlSelect sqlSelect = parseProjectionExpression(projection);\n583:         if (sqlSelect.getSelectList().isEmpty()) {\n584:             return filter;\n585:         }\n586: \n587:         Map<String, SqlNode> calculatedExpression = new HashMap<>();\n588:         for (SqlNode sqlNode : sqlSelect.getSelectList()) {\n589:             if (sqlNode instanceof SqlBasicCall) {\n590:                 SqlBasicCall sqlBasicCall = (SqlBasicCall) sqlNode;\n591:                 if (SqlKind.AS.equals(sqlBasicCall.getOperator().kind)) {\n592:                     List<SqlNode> operandList = sqlBasicCall.getOperandList();\n593:                     if (operandList.size() == 2) {\n594:                         SqlIdentifier alias = (SqlIdentifier) operandList.get(1);\n595:                         String name = alias.names.get(alias.names.size() - 1);\n596:                         SqlNode expression = operandList.get(0);\n597:                         calculatedExpression.put(name, expression);\n598:                     }\n599:                 }\n600:             }\n601:         }\n602: \n603:         SqlNode sqlFilter = parseFilterExpression(filter).getWhere();\n604:         sqlFilter = rewriteExpression(sqlFilter, calculatedExpression);\n605:         if (sqlFilter != null) {\n606:             return sqlFilter.toString();\n607:         } else {\n608:             return filter;\n609:         }\n610:     }\n611: }\n\n(End of file - total 611 lines)\n</content>",
