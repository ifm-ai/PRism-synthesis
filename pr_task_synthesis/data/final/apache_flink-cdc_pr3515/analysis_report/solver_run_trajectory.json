ger LOG = LoggerFactory.getLogger(ProjectionColumnProcessor.class);\n41: \n42:     private PostTransformChangeInfo tableInfo;\n43:     private ProjectionColumn projectionColumn;\n44:     private String timezone;\n45:     private TransformExpressionKey transformExpressionKey;\n46:     private final List<UserDefinedFunctionDescriptor> udfDescriptors;\n47:     private final transient List<Object> udfFunctionInstances;\n48:     private transient ExpressionEvaluator expressionEvaluator;\n49: \n50:     public ProjectionColumnProcessor(\n51:             PostTransformChangeInfo tableInfo,\n52:             ProjectionColumn projectionColumn,\n53:             String timezone,\n54:             List<UserDefinedFunctionDescriptor> udfDescriptors,\n55:             final List<Object> udfFunctionInstances) {\n56:         this.tableInfo = tableInfo;\n57:         this.projectionColumn = projectionColumn;\n58:         this.timezone = timezone;\n59:         this.udfDescriptors = udfDescriptors;\n60:         this.transformExpressionKey = generateTransformExpressionKey();\n61:         this.expressionEvaluator =\n62:                 TransformExpressionCompiler.compileExpression(\n63:                         transformExpressionKey, udfDescriptors);\n64:         this.udfFunctionInstances = udfFunctionInstances;\n65:     }\n66: \n67:     public static ProjectionColumnProcessor of(\n68:             PostTransformChangeInfo tableInfo,\n69:             ProjectionColumn projectionColumn,\n70:             String timezone,\n71:             List<UserDefinedFunctionDescriptor> udfDescriptors,\n72:             List<Object> udfFunctionInstances) {\n73:         return new ProjectionColumnProcessor(\n74:                 tableInfo, projectionColumn, timezone, udfDescriptors, udfFunctionInstances);\n75:     }\n76: \n77:     public ProjectionColumn getProjectionColumn() {\n78:         return projectionColumn;\n79:     }\n80: \n81:     public Object evaluate(BinaryRecordData after, long epochTime) {\n82:         try {\n83:             return expressionEvaluator.evaluate(generateParams(after, epochTime));\n84:         } catch (InvocationTargetException e) {\n85:             LOG.error(\n86:                     \"Table:{} column:{} projection:{} execute failed. {}\",\n87:                     tableInfo.getName(),\n88:                     projectionColumn.getColumnName(),\n89:                     projectionColumn.getScriptExpression(),\n90:                     e);\n91:             throw new RuntimeException(e);\n92:         }\n93:     }\n94: \n95:     private Object[] generateParams(BinaryRecordData after, long epochTime) {\n96:         List<Object> params = new ArrayList<>();\n97:         List<Column> columns = tableInfo.getPreTransformedSchema().getColumns();\n98: \n99:         // 1 - Add referenced columns\n100:         RecordData.FieldGetter[] fieldGetters = tableInfo.getPreTransformedFieldGetters();\n101:         for (String originalColumnName : projectionColumn.getOriginalColumnNames()) {\n102:             switch (originalColumnName) {\n103:                 case TransformParser.DEFAULT_NAMESPACE_NAME:\n104:                     params.add(tableInfo.getNamespace());\n105:                     continue;\n106:                 case TransformParser.DEFAULT_SCHEMA_NAME:\n107:                     params.add(tableInfo.getSchemaName());\n108:                     continue;\n109:                 case TransformParser.DEFAULT_TABLE_NAME:\n110:                     params.add(tableInfo.getTableName());\n111:                     continue;\n112:             }\n113: \n114:             boolean argumentFound = false;\n115:             for (int i = 0; i < columns.size(); i++) {\n116:                 Column column = columns.get(i);\n117:                 if (column.getName().equals(originalColumnName)) {\n118:                     params.add(\n119:                             DataTypeConverter.convertToOriginal(\n120:                                     fieldGetters[i].getFieldOrNull(after), column.getType()));\n121:                     argumentFound = true;\n122:                     break;\n123:                 }\n124:             }\n125:             if (!argumentFound) {\n126:                 throw new IllegalArgumentException(\n127:                         \"Failed to evaluate argument \" + originalColumnName);\n128:             }\n129:         }\n130: \n131:         // 2 - Add time-sensitive function arguments\n132:         params.add(timezone);\n133:         params.add(epochTime);\n134: \n135:         // 3 - Add UDF function instances\n136:         params.addAll(udfFunctionInstances);\n137:         return params.toArray();\n138:     }\n139: \n140:     private TransformExpressionKey generateTransformExpressionKey() {\n141:         List<String> argumentNames = new ArrayList<>();\n142:         List<Class<?>> paramTypes = new ArrayList<>();\n143:         List<Column> columns = tableInfo.getPreTransformedSchema().getColumns();\n144:         String scriptExpression = projectionColumn.getScriptExpression();\n145:         List<String> originalColumnNames = projectionColumn.getOriginalColumnNames();\n146:         for (String originalColumnName : originalColumnNames) {\n147:             for (Column column : columns) {\n148:                 if (column.getName().equals(originalColumnName)) {\n149:                     argumentNames.add(originalColumnName);\n150:                     paramTypes.add(DataTypeConverter.convertOriginalClass(column.getType()));\n151:                     break;\n152:                 }\n153:             }\n154:         }\n155:         if (scriptExpression.contains(TransformParser.DEFAULT_NAMESPACE_NAME)\n156:                 && !argumentNames.contains(TransformParser.DEFAULT_NAMESPACE_NAME)) {\n157:             argumentNames.add(TransformParser.DEFAULT_NAMESPACE_NAME);\n158:             paramTypes.add(String.class);\n159:         }\n160: \n161:         if (scriptExpression.contains(TransformParser.DEFAULT_SCHEMA_NAME)\n162:                 && !argumentNames.contains(TransformParser.DEFAULT_SCHEMA_NAME)) {\n163:             argumentNames.add(TransformParser.DEFAULT_SCHEMA_NAME);\n164:             paramTypes.add(String.class);\n165:         }\n166: \n167:         if (scriptExpression.contains(TransformParser.DEFAULT_TABLE_NAME)\n168:                 && !argumentNames.contains(TransformParser.DEFAULT_TABLE_NAME)) {\n169:             argumentNames.add(TransformParser.DEFAULT_TABLE_NAME);\n170:             paramTypes.add(String.class);\n171:         }\n172: \n173:         argumentNames.add(JaninoCompiler.DEFAULT_TIME_ZONE);\n174:         paramTypes.add(String.class);\n175:         argumentNames.add(JaninoCompiler.DEFAULT_EPOCH_TIME);\n176:         paramTypes.add(Long.class);\n177: \n178:         return TransformExpressionKey.of(\n179:                 JaninoCompiler.loadSystemFunction(scriptExpression),\n180:                 argumentNames,\n181:                 paramTypes,\n182:                 DataTypeConverter.convertOriginalClass(projectionColumn.getDataType()));\n183:     }\n184: }\n\n(End of file - total 184 lines)\n</content>",
