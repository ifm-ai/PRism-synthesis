transform.processElement(new StreamRecord<>(insertEvent2));\n413:         Assertions.assertThat(\n414:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n415:                 .isEqualTo(new StreamRecord<>(insertEvent2Expect));\n416:         transform.processElement(new StreamRecord<>(updateEvent));\n417:         Assertions.assertThat(\n418:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n419:                 .isEqualTo(new StreamRecord<>(updateEventExpect));\n420:     }\n421: \n422:     @Test\n423:     void testDataChangeEventTransformProjectionDataTypeConvert() throws Exception {\n424:         PostTransformOperator transform =\n425:                 PostTransformOperator.newBuilder()\n426:                         .addTransform(DATATYPE_TABLEID.identifier(), \"*\", null, null, null, null)\n427:                         .build();\n428:         EventOperatorTestHarness<PostTransformOperator, Event>\n429:                 transformFunctionEventEventOperatorTestHarness =\n430:                         new EventOperatorTestHarness<>(transform, 1);\n431:         // Initialization\n432:         transformFunctionEventEventOperatorTestHarness.open();\n433:         // Create table\n434:         CreateTableEvent createTableEvent = new CreateTableEvent(DATATYPE_TABLEID, DATATYPE_SCHEMA);\n435:         BinaryRecordDataGenerator recordDataGenerator =\n436:                 new BinaryRecordDataGenerator(((RowType) DATATYPE_SCHEMA.toRowDataType()));\n437:         // Insert\n438:         DataChangeEvent insertEvent =\n439:                 DataChangeEvent.insertEvent(\n440:                         DATATYPE_TABLEID,\n441:                         recordDataGenerator.generate(\n442:                                 new Object[] {\n443:                                     new BinaryStringData(\"3.14\"),\n444:                                     new Boolean(true),\n445:                                     new Byte(\"1\"),\n446:                                     new Short(\"1\"),\n447:                                     new Integer(1),\n448:                                     new Long(1),\n449:                                     new Integer(1704471599),\n450:                                     new Integer(1704471599),\n451:                                     TimestampData.fromMillis(1704471599),\n452:                                     new Float(3.14f),\n453:                                     new Double(3.14d),\n454:                                     DecimalData.fromBigDecimal(new BigDecimal(3.14), 6, 2),\n455:                                 }));\n456:         transform.processElement(new StreamRecord<>(createTableEvent));\n457:         Assertions.assertThat(\n458:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n459:                 .isEqualTo(\n460:                         new StreamRecord<>(\n461:                                 new CreateTableEvent(DATATYPE_TABLEID, DATATYPE_SCHEMA)));\n462:         transform.processElement(new StreamRecord<>(insertEvent));\n463:         Assertions.assertThat(\n464:                         transformFunctionEventEventOperatorTestHarness.getOutputRecords().poll())\n465:                 .isEqualTo(new StreamRecord<>(insertEvent));\n466:     }\n467: \n468:     @Test\n469:     void testMetadataTransform() throws Exception {\n470:         PostTransformOperator transform =\n471:                 PostTransformOperator.newBuilder()\n472:                         .addTransform(\n473:                                 METADATA_TABLEID.identifier(),\n474:                                 \"*, __namespace_name__ || '.' || __schema_name__ || '.' || __table_name__ identifier_name, __namespace_name__, __schema_name__, __table_name__\",\n475:                                 \" __table_name__ = 'metadata_table' \")\n476:                         .build();\n477:         EventOperatorT