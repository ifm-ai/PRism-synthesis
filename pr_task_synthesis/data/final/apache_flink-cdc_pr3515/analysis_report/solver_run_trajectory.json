taTypes.STRING())\n167:                     .primaryKey(\"col1\")\n168:                     .build();\n169: \n170:     private static final TableId CONDITION_TABLEID =\n171:             TableId.tableId(\"my_company\", \"my_branch\", \"condition_table\");\n172:     private static final Schema CONDITION_SCHEMA =\n173:             Schema.newBuilder()\n174:                     .physicalColumn(\"col1\", DataTypes.STRING())\n175:                     .physicalColumn(\"condition_result\", DataTypes.BOOLEAN())\n176:                     .primaryKey(\"col1\")\n177:                     .build();\n178: \n179:     private static final TableId REDUCE_TABLEID =\n180:             TableId.tableId(\"my_company\", \"my_branch\", \"reduce_table\");\n181: \n182:     private static final Schema REDUCE_SCHEMA =\n183:             Schema.newBuilder()\n184:                     .physicalColumn(\"id\", DataTypes.STRING().notNull())\n185:                     .physicalColumn(\"age\", DataTypes.INT())\n186:                     .physicalColumn(\"ref1\", DataTypes.STRING())\n187:                     .physicalColumn(\"ref2\", DataTypes.INT())\n188:                     .primaryKey(\"id\")\n189:                     .partitionKey(\"id\")\n190:                     .options(ImmutableMap.of(\"key1\", \"value1\", \"key2\", \"value2\"))\n191:                     .build();\n192: \n193:     private static final Schema EXPECTED_REDUCE_SCHEMA =\n194:             Schema.newBuilder()\n195:                     .physicalColumn(\"id\", DataTypes.STRING().notNull())\n196:                     .physicalColumn(\"uid\", DataTypes.STRING())\n197:                     .physicalColumn(\"newage\", DataTypes.INT())\n198:                     .physicalColumn(\"ref1\", DataTypes.STRING())\n199:                     .physicalColumn(\"seventeen\", DataTypes.INT())\n200:                     .primaryKey(\"id\")\n201:                     .partitionKey(\"id\")\n202:                     .options(ImmutableMap.of(\"key1\", \"value1\", \"key2\", \"value2\"))\n203:                     .build();\n204: \n205:     private static final TableId WILDCARD_TABLEID =\n206:             TableId.tableId(\"my_company\", \"my_branch\", \"wildcard_table\");\n207: \n208:     private static final Schema WILDCARD_SCHEMA =\n209:             Schema.newBuilder()\n210:                     .physicalColumn(\"id\", DataTypes.STRING().notNull())\n211:                     .physicalColumn(\"age\", DataTypes.INT())\n212:                     .physicalColumn(\"name\", DataTypes.STRING())\n213:                     .primaryKey(\"id\")\n214:                     .partitionKey(\"id\")\n215:                     .options(ImmutableMap.of(\"key1\", \"value1\", \"key2\", \"value2\"))\n216:                     .build();\n217: \n218:     private static final Schema EXPECTED_WILDCARD_SCHEMA =\n219:             Schema.newBuilder()\n220:                     .physicalColumn(\"id\", DataTypes.STRING().notNull())\n221:                     .physicalColumn(\"age\", DataTypes.INT())\n222:                     .physicalColumn(\"name\", DataTypes.STRING())\n223:                     .physicalColumn(\"newage\", DataTypes.INT())\n224:                     .primaryKey(\"id\")\n225:                     .partitionKey(\"id\")\n226:                     .options(ImmutableMap.of(\"key1\", \"value1\", \"key2\", \"value2\"))\n227:                     .build();\n228: \n229:     @Test\n230:     void testDataChangeEventTransform() throws Exception {\n231:         PostTransformOperator transform =\n232:                 PostTransformOperator.newBuilder()\n233:                         .addTransform(\n234:                                 CUSTOMERS_TABLEID.identifier(),\n235:                                 \"*, concat(col1,col2) col12\",\n236:                                 \"col1 = '1'\")\n237:                         .build();\n238:         EventOperatorTestHarness<PostTransformOperator, Event>\n239:                 transformFunctionEventEventOperatorTestHarness =\n240:    