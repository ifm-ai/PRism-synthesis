            "output": "<path>/workspace/docker/pytorch-aarch64/patches/mlcommons_rnnt.patch</path>\n<type>file</type>\n<content>\n1: # *******************************************************************************\n2: # Copyright 2021-2023 Arm Limited and affiliates.\n3: # SPDX-License-Identifier: Apache-2.0\n4: #\n5: # Licensed under the Apache License, Version 2.0 (the \"License\");\n6: # you may not use this file except in compliance with the License.\n7: # You may obtain a copy of the License at\n8: #\n9: #     http://www.apache.org/licenses/LICENSE-2.0\n10: #\n11: # Unless required by applicable law or agreed to in writing, software\n12: # distributed under the License is distributed on an \"AS IS\" BASIS,\n13: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n14: # See the License for the specific language governing permissions and\n15: # limitations under the License.\n16: # *******************************************************************************\n17: #\n18: # This patch file includes commit 077f823ece09e37d9d40540d8acd504bf138e880\n19: # from the MLCommons inference repository, and further additions to make\n20: # the shell scripts suitable for building and running on AArch64 systems\n21: # without Conda installed.\n22: #\n23: # *******************************************************************************\n24: diff --git a/speech_recognition/rnnt/README.md b/speech_recognition/rnnt/README.md\n25: index 27fbabd..2794bed 100644\n26: --- a/speech_recognition/rnnt/README.md\n27: +++ b/speech_recognition/rnnt/README.md\n28: @@ -4,18 +4,12 @@ character transcription, without an external language model.\n29:  \n30:  # 2. Directions\n31:  \n32: -Open `run.sh`. Set the stage variable to \"-1\". Set \"work_dir\" to a\n33: -path backed by a disk with at least 30 GB of space. Most space is used\n34: -by loadgen logs, not the data or model. You need conda and a C/C++\n35: -compiler on your PATH. I used conda 4.8.2. This script is responsible\n36: -for downloading dependencies, data, and the model.\n37: -\n38: -Run `./run.sh` from this directory. Note that stage 3 runs all of the\n39: -scenarios for the reference implementation, which will take a long\n40: -time, so you may want to exist before then.\n41: -\n42: -As you complete individual stages, you can set the variable \"stage\" to\n43: -a higher number for restarting from a later stage.\n44: +To download the dataset and model, run `download_dataset_model.sh`.\n45: +To run the model, use `run.sh`; this shell script runs the SingleStream\n46: +scenario by default if no others are specified. Use `run.sh --help` to\n47: +view the full list of available flags and a usage example. Note that\n48: +the RNNT directory will need to be a path backed by a disk with at least 30\n49: +GB of space. Most space is used by loadgen logs, not the data or model.\n50:  \n51:  # 3. Dataset/Environment\n52:  ### Publication/Attribution\n53: @@ -113,4 +107,4 @@ The differences are as follows:\n54:  ### Quality metric\n55:  7.452253714852645% Word Error Rate (WER) across all words in the output text of\n56:  all samples less than 15 seconds in length in the dev-clean set, using a greedy\n57: -decoder and a fully FP32 model.\n58: \\ No newline at end of file\n59: +decoder and a fully FP32 model.\n60: diff --git a/speech_recognition/rnnt/download_dataset_model.sh b/speech_recognition/rnnt/download_dataset_model.sh\n61: new file mode 100755\n62: index 0000000..8d4ac05\n63: --- /dev/null\n64: +++ b/speech_recognition/rnnt/download_dataset_model.sh\n65: @@ -0,0 +1,46 @@\n66: +#!/bin/bash\n67: +# *******************************************************************************\n68: +# Copyright 2021 Arm Limited and affiliates.\n69: +# SPDX-License-Identifier: Apache-2.0\n70: +#\n71: +# Licensed under the Apache License, Version 2.0 (the \"License\");\n72: +# you may not use this file except in compliance with the License.\n73: +# You may obtain a copy of the License at\n74: +#\n75: +#     http://www.apache.org/licenses/LICENSE-2.0\n76: +#\n77: +# Unless required by applicable law or agreed to in writing, software\n78: +# distributed under the License is distributed on an \"AS IS\" BASIS,\n79: +# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n80: +# See the License for the specific language governing permissions and\n81: +# limitations under the License.\n82: +# *******************************************************************************\n83: +set -euo pipefail\n84: +\n85: +base=\"$(dirname \"${BASH_SOURCE[0]}\")\"\n86: +work_dir=$base/temp_work\n87: +local_data_dir=$work_dir/local_data\n88: +librispeech_download_dir=$local_data_dir/LibriSpeech\n89: +\n90: +mkdir -p $librispeech_download_dir\n91: +\n92: +# if venv not active, activate\n93: +if [[ $(python -c \"import sys; print(sys.prefix)\") != \"/home/ubuntu/python3-venv\" ]]; then\n94: +    source /home/ubuntu/python3-venv/bin/activate\n95: +fi\n96: +\n97: +# stage 0: download model. Check checksum to skip?\n98: +wget https://zenodo.org/record/3662521/files/DistributedDataParallel_1576581068.9962234-epoch-100.pt?download=1 -O $work_dir/rnnt.pt\n99: +\n100: +# stage 1: download data. This will have a non-zero exit code if the\n101: +# checksum is incorrect.\n102: +python pytorch/utils/download_librispeech.py \\\n103: +     pytorch/utils/librispeech-inference.csv \\\n104: +     $librispeech_download_dir \\\n105: +     -e $local_data_dir\n106: +\n107: +# stage 2: perform necessary conversions on data\n108: +python pytorch/utils/convert_librispeech.py \\\n109: +  --input_dir $librispeech_download_dir/dev-clean \\\n110: +  --dest_dir $local_data_dir/dev-clean-wav \\\n111: +  --output_json $local_data_dir/dev-clean-wav.json\n112: diff --git a/speech_recognition/rnnt/run.sh b/speech_recognition/rnnt/run.sh\n113: index 7538df9..d65a87c 100755\n114: --- a/speech_recognition/rnnt/run.sh\n115: +++ b/speech_recognition/rnnt/run.sh\n116: @@ -1,90 +1,108 @@\n117: -#/bin/bash\n118: -\n119: +#!/bin/bash\n120: +# *******************************************************************************\n121: +# Copyright 2021 Arm Limited and affiliates.\n122: +# SPDX-License-Identifier: Apache-2.0\n123: +#\n124: +# Licensed under the Apache License, Version 2.0 (the \"License\");\n125: +# you may not use this file except in compliance with the License.\n126: +# You may obtain a copy of the License at\n127: +#\n128: +#     http://www.apache.org/licenses/LICENSE-2.0\n129: +#\n130: +# Unless required by applicable law or agreed to in writing, software\n131: +# distributed under the License is distributed on an \"AS IS\" BASIS,\n132: +# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n133: +# See the License for the specific language governing permissions and\n134: +# limitations under the License.\n135: +# *******************************************************************************\n136:  set -euo pipefail\n137:  \n138: -work_dir=/export/b07/ws15dgalvez/mlperf-rnnt-librispeech\n139: -local_data_dir=$work_dir/local_data\n140: -librispeech_download_dir=$local_data_dir/LibriSpeech\n141: -stage=3\n142: -\n143: -mkdir -p $work_dir $local_data_dir $librispeech_download_dir\n144: -\n145: -install_dir=third_party/install\n146: -mkdir -p $install_dir\n147: -install_dir=$(readlink -f $install_dir)\n148: -\n149: -set +u\n150: -source \"$($CONDA_EXE info --base)/etc/profile.d/conda.sh\"\n151: -set -u\n152: -\n153: -# stage -1: install dependencies\n154: -if [[ $stage -le -1 ]]; then\n155: -    conda env create --force -v --file environment.yml\n156: -\n157: -    set +u\n158: -    source \"$(conda info --base)/etc/profile.d/conda.sh\"\n159: -    conda activate mlperf-rnnt\n160: -    set -u\n161: -\n162: -    # We need to convert .flac files to .wav files via sox. Not all sox installs have flac support, so we install from source.\n163: -    wget https://ftp.osuosl.org/pub/xiph/releases/flac/flac-1.3.2.tar.xz -O third_party/flac-1.3.2.tar.xz\n164: -    (cd third_party; tar xf flac-1.3.2.tar.xz; cd flac-1.3.2; ./configure --prefix=$install_dir && make && make install)\n165: -\n166: -    wget https://sourceforge.net/projects/sox/files/sox/14.4.2/sox-14.4.2.tar.gz -O third_party/sox-14.4.2.tar.gz\n167: -    (cd third_party; tar zxf sox-14.4.2.tar.gz; cd sox-14.4.2; LDFLAGS=\"-L${install_dir}/lib\" CFLAGS=\"-I${install_dir}/include\" ./configure --prefix=$install_dir --with-flac && make && make install)\n168: -\n169: -    (cd $(git rev-parse --show-toplevel)/loadgen; python setup.py install)\n170: +################################################################################\n171: +function print_usage_and_exit {\n172: +  echo \"Usage: run.sh [OPTIONS]\"\n173: +  echo \"\"\n174: +  echo \"Options:\"\n175: +  echo \"  -h, --help                   Display this message\"\n176: +  echo \"  --accuracy                   Run accuracy tests instead of performance tests\"\n177: +  echo \"  --all                        Run all tests: SingleStream, Offline, Server\"\n178: +  echo \"  --single-stream              Run SingleStream scenario (default if no other specified)\"\n179: +  echo \"  --offline                    Run Offline scenario\"\n180: +  echo \"  --server                     Run Server scenario\"\n181: +  echo \"\"\n182: +  echo \"Example:\"\n183: +  echo \"  run.sh --offline --server --accuracy\"\n184: +  exit $1\n185: +}\n186: +################################################################################\n187: +\n188: +# default args\n189: +all_flag=false\n190: +acc_flag=''\n191: +scenarios=''\n192: +\n193: +while [ $# -gt 0 ]\n194: +do\n195: +  case $1 in\n196: +    --single-stream )\n197: +      scenarios=\"$scenarios SingleStream\"\n198: +      shift\n199: +      ;;\n200: +    --offline )\n201: +      scenarios=\"$scenarios Offline\"\n202: +      shift\n203: +      ;;\n204: +    --server )\n205: +      scenarios=\"$scenarios Server\"\n206: +      shift\n207: +      ;;\n208: +    --all )\n209: +      all_flag=true\n210: +      shift\n211: +      ;;\n212: +    --accuracy )\n213: +      acc_flag='--accuracy'\n214: +      shift\n215: +      ;;\n216: +    -h | --help )\n217: +      print_usage_and_exit 0\n218: +      ;;\n219: +  esac\n220: +done\n221: +\n222: +# set scenarios here if --all to avoid duplication\n223: +if $all_flag; then\n224: +  scenarios='SingleStream Offline Server'\n225:  fi\n226:  \n227: -export PATH=\"$install_dir/bin/:$PATH\"\n228: -\n229: -set +u\n230: -conda activate mlperf-rnnt\n231: -set -u\n232: -\n233: -# stage 0: download model. Check checksum to skip?\n234: -if [[ $stage -le 0 ]]; then\n235: -  wget https://zenodo.org/record/3662521/files/DistributedDataParallel_1576581068.9962234-epoch-100.pt?download=1 -O $work_dir/rnnt.pt\n236: +# set SingleStream default if no scenario specified\n237: +if [ -z \"$scenarios\" ]; then\n238: +  scenarios=\"SingleStream\"\n239:  fi\n240:  \n241: -# stage 1: download data. This will hae a non-zero exit code if the\n242: -# checksum is incorrect.\n243: -if [[ $stage -le 1 ]]; then\n244: -  python pytorch/utils/download_librispeech.py \\\n245: -         pytorch/utils/librispeech-inference.csv \\\n246: -         $librispeech_download_dir \\\n247: -         -e $local_data_dir\n248: -fi\n249: +base=\"$(dirname \"${BASH_SOURCE[0]}\")\"\n250: +work_dir=$base/temp_work\n251: +local_data_dir=$work_dir/local_data\n252:  \n253: -if [[ $stage -le 2 ]]; then\n254: -  python pytorch/utils/convert_librispeech.py \\\n255: -      --input_dir $librispeech_download_dir/dev-clean \\\n256: -      --dest_dir $local_data_dir/dev-clean-wav \\\n257: -      --output_json $local_data_dir/dev-clean-wav.json\n258: +# if venv not active, activate\n259: +if [[ $(python -c \"import sys; print(sys.prefix)\") != \"/home/ubuntu/python3-venv\" ]]; then\n260: +    source /home/ubuntu/python3-venv/bin/activate\n261:  fi\n262:  \n263: -if [[ $stage -le 3 ]]; then\n264: -  for backend in pytorch; do\n265: -    for accuracy in \"--accuracy\" \"\"; do\n266: -      for scenario in SingleStream Offline Server; do\n267: -        log_dir=${work_dir}/${scenario}_${backend}\n268: -        if [ ! -z ${accuracy} ]; then\n269: -          log_dir+=_accuracy\n270: -        fi\n271: -        log_dir+=rerun\n272: -\n273: -        python run.py --backend pytorch \\\n274: -               --dataset_dir $local_data_dir \\\n275: -               --manifest $local_data_dir/dev-clean-wav.json \\\n276: -               --pytorch_config_toml pytorch/configs/rnnt.toml \\\n277: -               --pytorch_checkpoint $work_dir/rnnt.pt \\\n278: -               --scenario ${scenario} \\\n279: -               --backend ${backend} \\\n280: -               --log_dir ${log_dir} \\\n281: -               ${accuracy} &\n282: -\n283: -      done\n284: -    done\n285: -  done\n286: -  wait\n287: -fi\n288: +for scenario in $scenarios; do\n289: +  log_dir=${work_dir}/${scenario}_pytorch\n290: +  if [ ! -z ${acc_flag} ]; then\n291: +    log_dir+=_accuracy\n292: +  fi\n293: +  log_dir+=rerun\n294: +\n295: +  python run.py --backend pytorch \\\n296: +       --dataset_dir $local_data_dir \\\n297: +       --manifest $local_data_dir/dev-clean-wav.json \\\n298: +       --pytorch_config_toml pytorch/configs/rnnt.toml \\\n299: +       --pytorch_checkpoint $work_dir/rnnt.pt \\\n300: +       --scenario ${scenario} \\\n301: +       --backend pytorch \\\n302: +       --log_dir ${log_dir} \\\n303: +       ${acc_flag} &\n304: +done\n305: +wait\n\n(End of file - total 305 lines)\n</content>",
