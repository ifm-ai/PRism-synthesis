\t        dtype = x.dtype\n   149\t\n   150\t        seq_len = self.get_seq_len(seq_len)\n   151\t\n   152\t        # dither\n   153\t        if self.dither > 0 and not self.use_deterministic_dithering:\n   154\t            x += self.dither * torch.randn_like(x)\n   155\t\n   156\t        # do preemphasis\n   157\t        # Ideally, we would mask immediately after this... Ugh :(\n   158\t        if self.preemph is not None:\n   159\t            x = torch.cat((x[:, 0].unsqueeze(1), x[:, 1:] - self.preemph * x[:, :-1]),\n   160\t                          dim=1)\n",
