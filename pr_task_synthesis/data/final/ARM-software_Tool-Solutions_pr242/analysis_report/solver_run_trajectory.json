55: \n56:     def update_bar(self, block_num, block_size, total_size):\n57:         \"\"\"\n58:         Updates progress bar based on how much of the file was downloaded\n59:         :param block_num: Number of blocks downloaded\n60:         :param block_size: Size in bytes of single block\n61:         :param total_size: Total size of the file in bytes\n62:         :return: returns nothing\n63:         \"\"\"\n64:         if not self.pbar:\n65:             self.pbar = tqdm(\n66:                 desc=self.msg, unit=\"b\", unit_scale=True, total=total_size\n67:             )\n68:             self.downloaded = 0\n69: \n70:         downloaded = block_num * block_size\n71:         if downloaded < total_size:\n72:             self.pbar.update(downloaded - self.downloaded)\n73:             self.downloaded = downloaded\n74:         else:\n75:             self.pbar.close()\n76: \n77:     def __call__(self, block_num, block_size, total_size):\n78:         self.update_bar(block_num, block_size, total_size)\n79: \n80: \n81: class Model:\n82:     \"\"\"\n83:     Wrap around TensorFlow session and run inference\n84:     \"\"\"\n85: \n86:     def __init__(self):\n87:         self._model = None\n88: \n89:     def _download_model(self, model_descriptor):\n90:         model_url = model_descriptor[\"model\"][\"source\"]\n91:         # check if source starts with http\n92:         if model_url is not None and not model_url.startswith('http'):\n93:             return None\n94: \n95:         # we need to download the model\n96:         model_file = urlparse(model_url).path.split(\"/\")[-1]\n97:         is_zip = model_file.endswith(\".zip\")\n98: \n99:         if is_zip:\n100:             model_name = model_file\n101:         else:\n102:             model_name = model_descriptor[\"model\"][\"name\"]\n103: \n104:         # check to see whether the model exists in the\n105:         # current directory and if it exists then we do\n106:         # not need to download it\n107:         if os.path.isfile(model_name):\n108:             # it exists we do not need to download it\n109:             if is_zip:\n110:                 model_name = _zip_file(model_file, model_descriptor[\"model\"][\"name\"], False)\n111:                 if os.path.isfile(model_name):\n112:                     return model_name\n113:             else:\n114:                 return model_name\n115: \n116:         # Download the model\n117:         urllib.request.urlretrieve(\n118:             model_url,\n119:             model_name,\n120:             DownloadProgressBar(\"Downloading: \" + model_name + \"...\"),\n121:         )\n122: \n123:         # once it is downloaded and if it is archive then\n124:         # find the model and extract it\n125:         if is_zip:\n126:             model_name = _zip_file(model_name, model_descriptor[\"model\"][\"name\"], True)\n127: \n128:         return model_name\n129: \n130:     def load(self, model_file, model_descriptor):\n131:         \"\"\"\n132:         Downloads the model from given URL and builds frozen function\n133:         that can be used for inference\n134:         :param model_file: File describing model to build\n135:         :param model_descriptor: Parsed yaml file describing model to build\n136:         :returns: Function to be used for inference\n137:         \"\"\"\n138: \n139:         if self._model is not None:\n140:             return True\n141: \n142:         # downloading the model, only done if it exists\n143:         model_name = self._download_model(model_descriptor)\n144: \n145:         if \"class\" in model_descriptor[\"model\"]:\n146:             model_class = model_descriptor[\"model\"][\"class\"]\n147:             if model_class == \"retinanet_resnext50_32x4d_fpn\":\n148:                 # The RetinaNet model is loaded from a different module\n149:                 class_ = getattr(torch_models.detection, model_class)\n150:                 self._model = class_()\n151:                 state_dict = torch.load(model_name, map_location=\"cpu\")[\"model\"]\n152:             else:\n153:                 # Loading a given state dict into the provided class\n154:                 class_ = getattr(torch_models, model_class)\n155:                 self._model = class_()\n156:                 state_dict = torch.load(model_name, map_location=\"cpu\")\n157:             self._model.load_state_dict(state_dict)\n158: \n159:         elif \"script\" in model_descriptor[\"model\"]:\n160:             warnings.filterwarnings(\"ignore\")\n161:             script_path = os.path.join(\n162:                 \"/\".join(model_file.split(\"/\")[:-1]),\n163:                 model_descriptor[\"model\"][\"script\"],\n164:             )\n165:             # the script for preparing files to run\n166:             runpy.run_path(script_path, run_name=\"__main__\")\n167:             self._model = torch.load(model_name, map_location=\"cpu\")\n168: \n169:         else:\n170:             assert (\n171:                 False\n172:             ), \"Cannot load module as there is no Python code of model class\"\n173: \n174:         self._model.eval()\n175: \n176:         return True\n177: \n178:     def run(self, image, tries):\n179:         \"\"\"\n180:         Runs inference multiple times\n181:         :param image: Input image\n182:         :param tries: Number of times to run inference\n183:         \"\"\"\n184:         inference_times = []\n185:         for _ in range(tries):\n186:             start = time.time_ns()\n187:             with torch.no_grad():\n188:                 predictions = self._model(image)\n189:             end = time.time_ns()\n190: \n191:             inference_time = np.round((end - start) / 1e6, 2)\n192:             inference_times.append(inference_time)\n193: \n194:         print(\"---------------------------------\")\n195:         print(\"Inference time: %d ms\" % np.min(inference_times))\n196:         print(\"---------------------------------\")\n197: \n198:         return predictions\n\n(