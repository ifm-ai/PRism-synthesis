ex}\\s*(el)?\\s*$)\n   references: [ MonthRegex ]\n WeekDayEnd: !nestedRegex\n   def: '{WeekDayRegex}\\s*,?\\s*$'\n   references: [ WeekDayRegex ]\n WeekDayStart: !simpleRegex\n   def: ^\\b$\n DateYearRegex: !nestedRegex\n   def: (?<year>{YearRegex}|(?<!,\\s?){TwoDigitYearRegex}|{TwoDigitYearRegex}(?=(\\.(?!\\d)|[?!;]|$)))\n   references: [ YearRegex, TwoDigitYearRegex ]\n DateExtractor1: !nestedRegex\n   # (domingo,)? 5 de Abril\n   def: \\b({WeekDayRegex}(\\s+|\\s*,\\s*))?(?<!\\d[.,]){DayRegex}((\\s*(d[eo])|[/\\\\\\.\\-])\\s*)?{MonthRegex}\\b\n   references: [ WeekDayRegex, DayRegex, MonthRegex ]\n DateExtractor2: !nestedRegex\n   # (domingo,)? (6 de Abril, 2016 | 2016, 6 de Abril)\n   def: \\b((el\\s+d[ií]a|{WeekDayRegex})(\\s+|\\s*,\\s*))?(?<!\\d[.,])(({DayRegex}((\\s+(d[eo]\\s+)?|\\s*[.,/-]\\s*){MonthRegex}((\\s+(del?\\s+)?|\\s*[.,/-]\\s*){DateYearRegex}\\b)?|\\s+(d[eo]\\s+){MonthNumRegex}\\s+(del?\\s+{DateYearRegex}\\b)))|{BaseDateTime.FourDigitYearRegex}\\s*[.,/-]?\\s*(el\\s+d[ií]a\\s+)?{DayRegex}(\\s+(d[eo]\\s+)?|\\s*[.,/-]\\s*){MonthRegex})\n   references: [ DayRegex, MonthRegex, MonthNumRegex, WeekDayRegex, DateYearRegex, BaseDateTime.FourDigitYearRegex ]\n DateExtractor3: !nestedRegex\n   # (domingo,)? Abril 5, 2016\n   def: \\b({WeekDayRegex}(\\s+|\\s*,\\s*))?{MonthRegex}(\\s*[.,/-]?\\s*)(el\\s+d[ií]a\\s+)?{DayRegex}(?!\\s*\\-\\s*\\d{2}\\b)((\\s+(del?\\s+)?|\\s*[.,/-]\\s*){DateYearRegex})?\\b\n   references: [ MonthRegex, DayRegex, DateYearRegex, WeekDayRegex ]\n # The final lookahead in DateExtractor4|5|A avoids extracting as date \"10/1-11\" from an input like \"10/1-11/2/2017\" \n DateExtractor4: !nestedRegex\n   # 3-23-2017\n   def: \\b(?<!\\d[.,]){MonthNumRegex}\\s*[/\\\\\\-]\\s*{DayRegex}\\s*[/\\\\\\-]\\s*{DateYearRegex}(?!\\s*[/\\\\\\-\\.]\\s*\\d+)\n   references: [ MonthNumRegex, DayRegex, DateYearRegex ]\n DateExtractor5: !nestedRegex\n   # 23-3-2015\n   def: \\b(?<!\\d[.,]){DayRegex}\\s*[/\\\\\\-\\.]\\s*({MonthNumRegex}|{MonthRegex})\\s*[/\\\\\