              "content": "#!/usr/bin/env python3\n\"\"\"Test script to verify Spanish decade and age recognition fixes.\"\"\"\n\nimport sys\nsys.path.insert(0, '/workspace/Python/libraries/recognizers-date-time')\nsys.path.insert(0, '/workspace/Python/libraries/recognizers-number-with-unit')\nsys.path.insert(0, '/workspace/Python/libraries/recognizers-number')\nsys.path.insert(0, '/workspace/Python/libraries/recognizers-text')\n\nfrom recognizers_text import Culture\nfrom recognizers_date_time import recognize_datetime\nfrom recognizers_number_with_unit import recognize_number_with_unit\nfrom recognizers_number_with_unit.number_with_unit import NumberWithUnitModelTypes\n\ndef test_decade_recognition():\n    \"\"\"Test decade recognition with various forms of 'años'.\"\"\"\n    print(\"=\" * 80)\n    print(\"Testing Decade Recognition\")\n    print(\"=\" * 80)\n    \n    test_cases = [\n        \"escrito en los años 90\",\n        \"los años setenta\",\n        \"¿Cuáles fueron los presidentes de Estados Unidos en la década de 1990?\",\n        \"en los anos 80\",\n        \"en los anos cuarenta\",\n        \"durante los años 2000\",\n    ]\n    \n    for text in test_cases:\n        print(f\"\\nInput: '{text}'\")\n        results = recognize_datetime(text, Culture.Spanish)\n        if results:\n            for result in results:\n                print(f\"  Type: {result.type_name}\")\n                print(f\"  Text: {result.text}\")\n                print(f\"  Timex: {result.timex}\")\n                if result.resolution:\n                    print(f\"  Resolution: {result.resolution}\")\n        else:\n            print(\"  No results found\")\n\ndef test_age_recognition():\n    \"\"\"Test age recognition with various forms of 'año'.\"\"\"\n    print(\"\\n\" + \"=\" * 80)\n    print(\"Testing Age Recognition\")\n    print(\"=\" * 80)\n    \n    test_cases = [\n        \"Tengo diez anos\",\n        \"Tiene veinte años\",\n        \"El niño tiene cinco año\",\n        \"Mi abuelo tiene ochenta anos\",\n    ]\n    \n    for text in test_cases:\n        print(f\"\\nInput: '{text}'\")\n        results = recognize_number_with_unit(text, Culture.Spanish, NumberWithUnitModelTypes.AGE)\n        if results:\n            for result in results:\n                print(f\"  Type: {result.type_name}\")\n                print(f\"  Text: {result.text}\")\n                print(f\"  Value: {result.resolution.get('value', 'N/A')}\")\n                print(f\"  Unit: {result.resolution.get('unit', 'N/A')}\")\n        else:\n            print(\"  No results found\")\n\nif __name__ == \"__main__\":\n    test_decade_recognition()\n    test_age_recognition()\n    print(\"\\n\" + \"=\" * 80)\n    print(\"Test completed\")\n    print(\"=\" * 80)\n"
