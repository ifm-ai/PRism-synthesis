nitMap\n    \n    for key in ['años', 'año', 'anos', 'ano']:\n        if key in unit_map:\n            print(f\"  '{key}': Found in UnitMap = {unit_map[key]}\")\n        else:\n            print(f\"  '{key}': NOT found in UnitMap\")\n\ndef test_unit_value_map():\n    \"\"\"Test that UnitValueMap includes both accented and unaccented forms.\"\"\"\n    from recognizers_date_time.resources.spanish_date_time import SpanishDateTime\n    \n    print(\"\\nTesting UnitValueMap:\")\n    print(\"=\" * 80)\n    unit_value_map = SpanishDateTime.UnitValueMap\n    \n    for key in ['años', 'año', 'anos', 'ano']:\n        if key in unit_value_map:\n            print(f\"  '{key}': Found in UnitValueMap = {unit_value_map[key]}\")\n        else:\n            print(f\"  '{key}': NOT found in UnitValueMap\")\n\nif __name__ == \"__main__\":\n    test_decade_pattern()\n    test_age_pattern()\n    test_unit_map()\n    test_unit_value_map()\n    print(\"\\n\" + \"=\" * 80)\n    print(\"Simple tests completed\")\n    print(\"=\" * 80)\n"
