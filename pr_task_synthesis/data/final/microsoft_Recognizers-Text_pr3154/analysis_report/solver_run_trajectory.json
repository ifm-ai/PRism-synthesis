              "patch": "Index: simple_test.py\n===================================================================\n--- simple_test.py\t\n+++ simple_test.py\t\n@@ -0,0 +1,83 @@\n+#!/usr/bin/env python3\n+\"\"\"Simple test to verify Spanish patterns work.\"\"\"\n+\n+import sys\n+import re\n+\n+# Test the regex patterns directly\n+def test_decade_pattern():\n+    \"\"\"Test the DecadeWithCenturyRegex pattern.\"\"\"\n+    # From the generated spanish_date_time.py\n+    pattern = r'(los\\s+)?((((d[ée]cada(\\s+de)?)\\s+)(((?<century>\\d|1\\d|2\\d)?(?<decade>\\d0))))|a[ñn]os?\\s+((((dos\\s+)?mil\\s+)?({WrittenOneHundredToNineHundredRegex}\\s+)?{DecadeRegex})|((dos\\s+)?mil\\s+)?({WrittenOneHundredToNineHundredRegex})(\\s+{DecadeRegex}?)|((dos\\s+)?mil)(\\s+{WrittenOneHundredToNineHundredRegex}\\s+)?{DecadeRegex}?))'\n+    \n+    # Simplified test - just check if pattern matches\n+    test_cases = [\n+        \"los años 90\",\n+        \"los anos 90\",\n+        \"años 90\",\n+        \"anos 90\",\n+        \"los años setenta\",\n+        \"los anos setenta\",\n+    ]\n+    \n+    print(\"Testing Decade Pattern:\")\n+    print(\"=\" * 80)\n+    for test in test_cases:\n+        # The actual pattern is complex, so we'll just check if it contains the right parts\n+        has_anos = 'anos' in test.lower() or 'años' in test.lower()\n+        print(f\"  '{test}': Contains año/anos = {has_anos}\")\n+\n+def test_age_pattern():\n+    \"\"\"Test the AgeSuffixList pattern.\"\"\"\n+    # From the generated spanish_numeric_with_unit.py\n+    pattern = r'a[ñn]os?|anos|ano'\n+    \n+    test_cases = [\n+        \"años\",\n+        \"año\",\n+        \"anos\",\n+        \"ano\",\n+    ]\n+    \n+    print(\"\\nTesting Age Pattern:\")\n+    print(\"=\" * 80)\n+    for test in test_cases:\n+        match = re.search(pattern, test, re.IGNORECASE)\n+        print(f\"  '{test}': Matched = {bool(match)}\")\n+\n+def test_unit_map():\n+    \"\"\"Test that UnitMap includes both accented and unaccented forms.\"\"\"\n+    from recognizers_date_time.resources.spanish_date_time import SpanishDateTime\n+    \n+    print(\"\\nTesting UnitMap:\")\n+    print(\"=\" * 80)\n+    unit_map = SpanishDateTime.UnitMap\n+    \n+    for key in ['años', 'año', 'anos', 'ano']:\n+        if key in unit_map:\n+            print(f\"  '{key}': Found in UnitMap = {unit_map[key]}\")\n+        else:\n+            print(f\"  '{key}': NOT found in UnitMap\")\n+\n+def test_unit_value_map():\n+    \"\"\"Test that UnitValueMap includes both accented and unaccented forms.\"\"\"\n+    from recognizers_date_time.resources.spanish_date_time import SpanishDateTime\n+    \n+    print(\"\\nTesting UnitValueMap:\")\n+    print(\"=\" * 80)\n+    unit_value_map = SpanishDateTime.UnitValueMap\n+    \n+    for key in ['años', 'año', 'anos', 'ano']:\n+        if key in unit_value_map:\n+            print(f\"  '{key}': Found in UnitValueMap = {unit_value_map[key]}\")\n+        else:\n+            print(f\"  '{key}': NOT found in UnitValueMap\")\n+\n+if __name__ == \"__main__\":\n+    test_decade_pattern()\n+    test_age_pattern()\n+    test_unit_map()\n+    test_unit_value_map()\n+    print(\"\\n\" + \"=\" * 80)\n+    print(\"Simple tests completed\")\n+    print(\"=\" * 80)\n",
