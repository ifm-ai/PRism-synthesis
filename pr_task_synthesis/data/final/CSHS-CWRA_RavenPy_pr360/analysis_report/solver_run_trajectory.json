:     source: Optional[str] = None\n89:     to: Sequence[str] = ()\n90: \n91:     _sub = \"\"\n92: \n93:     @field_validator(\"to\", mode=\"before\")\n94:     @classmethod\n95:     def is_list(cls, v):\n96:         if isinstance(v, str):\n97:             return [\n98:                 v,\n99:             ]\n100:         return v\n101: \n102:     @field_validator(\"source\")\n103:     @classmethod\n104:     def is_source_state_variable(cls, v: str):\n105:         if v is not None:\n106:             if re.split(r\"\\[\", v)[0] not in get_args(options.StateVariables):\n107:                 raise ValueError(f\"{v} not recognized as a state variable.\")\n108:         return v\n109: \n110:     @field_validator(\"to\")\n111:     @classmethod\n112:     def is_to_state_variable(cls, v: Sequence):\n113:         for x in v:\n114:             if re.split(r\"\\[\", x)[0] not in get_args(options.StateVariables):\n115:                 raise ValueError(f\"{x} not recognized as a state variable.\")\n116:         return v\n117: \n118:     def to_rv(self):\n119:         t = \" \".join(map(\"{:<19}\".format, self.to))\n120:         p = getattr(self, \"p\", None)\n121:         p = p if p is not None else \"\"\n122:         cmd = self._sub + self.__class__.__name__\n123:         return f\":{cmd:<20} {self.algo:<19} {self.source:<19} {t} {p}\".strip()\n124: \n125: \n126: class SoilModel(RootCommand):\n127:     root: int\n128: \n129:     def to_rv(self):\n130:         cmd = \"SoilModel\"\n131:         return f\":{cmd:<20} SOIL_MULTILAYER {self.root}\\n\"\n132: \n133: \n134: class LinearTransform(Command):\n135:     scale: float = 1\n136:     offset: float = 0\n137: \n138:     def to_rv(self):\n139:         cmd = \"LinearTransform\"\n140:         if (self.scale != 1) or (self.offset != 0):\n141:             return f\":{cmd:<20} {self.scale:.15f} {self.offset:.15f}\\n\"\n142:         return \"\"\n143: \n144: \n145: class RainSnowTransition(Command):\n146:     \"\"\"Specify the range of temperatures over which there will be a rain/snow mix when partitioning total precipitation into rain and snow components.\"\"\"\n147: \n148:     temp: Sym\n149:     \"\"\"Midpoint of the temperature range [C].\"\"\"\n150:     delta: Sym\n151:     \"\"\"Range [C].\"\"\"\n152: \n153:     def to_rv(self):\n154:         cmd = \"RainSnowTransition\"\n155:         return f\":{cmd:<20} {self.temp} {self.delta}\\n\"\n156: \n157: \n158: class EvaluationPeriod(LineCommand):\n159:     \"\"\":EvaluationPeriod [period_name] [start yyyy-mm-dd] [end yyyy-mm-dd]\"\"\"\n160: \n161:     name: str\n162:     start: dt.date\n163:     end: dt.date\n164: \n165: \n166: class CustomOutput(FlatCommand):\n167:     \"\"\"\n168:     Create custom output file to track a single variable, parameter or forcing function over time at a number of\n169:     basins, HRUs, or across the watershed.\n170: \n171:     Parameters\n172:     ----------\n173:     time_per : {'DAILY', 'MONTHLY', 'YEARLY', 'WATER_YEARLY', 'CONTINUOUS'}\n174:         Time period.\n175:     stat : {'AVERAGE', 'MAXIMUM', 'MINIMUM', 'RANGE', 'MEDIAN', 'QUARTILES', 'HISTOGRAM [min] [max] [# bins]'\n176:         Statistic reported for each time interval.\n177:     variable : str\n178:         Variable or parameter name. Consult the Raven documentation for the list of allowed names.\n179:     space_agg : {'BY_BASIN', 'BY_HRU', 'BY_HRU_GROUP', 'BY_SB_GROUP', 'ENTIRE_WATERSHED'}\n180:         Spatial evaluation domain.\n181:     filename : str\n182:         Output file name. Defaults to something approximately like\n183:         `<run name>_<variable>_<time_per>_<stat>_<space_agg>.nc`\n184:     \"\"\"\n185: \n186:     time_per: Literal[\"DAILY\", \"MONTHLY\", \"YEARLY\", \"WATER_YEARLY\", \"CONTINUOUS\"]\n187:     stat: Literal[\"AVERAGE\", \"MAXIMUM\", \"MINIMUM\", \"RANGE\", \"MEDIAN\", \"QUARTILES\"]\n188:     variable: str\n189:     space_agg: Literal[\n190:         \"BY_BASIN\", \"BY_HRU\", \"BY_HRU_GROUP\", \"BY_SB_GROUP\", \"ENTIRE_WATERSHED\"\n191:     ]\n192:     filename: str = \"\"\n193: \n194: \n195: class SoilProfile(Record):\n196:     name: str = \"\"\n197:     soil_classes: Sequence[str] = ()\n198:     thicknesses: Sequence[Sym] = ()\n199: \n200:     def __str__(self):\n201:         # From the Raven manual: {profile_name,#horizons,{soil_class_name,thick.}x{#horizons}}x[NP]\n202:         n_horizons = len(self.soil_classes)\n203:         horizon_data = list(itertools.chain(*zip(self.soil_classes, self.thicknesses)))\n204:         fmt = \"{:<16},{:>4},\" + \",\".join(n_horizons * [\"{:>12}, {:>8}\"])\n205:         return fmt.format(self.name, n_horizons, *horizon_data)\n206: \n207: \n208: class SoilProfiles(ListCommand):\n209:     root: Sequence[SoilProfile]\n210: \n211: \n212: class SubBasin(Record):\n213:     \"\"\"Record to populate RVH :SubBasins command internal table.\"\"\"\n214: \n215:     subbasin_id: PositiveInt = 1\n216:     name: str = \"sub_001\"\n217:     downstream_id: int = -1\n218:     profile: str = \"NONE\"\n219:     reach_length: float = 0\n220:     gauged: bool = True\n221:     gauge_id: Optional[str] = \"\"  # This attribute is not rendered to RVH\n222: \n223:     def __str__(self):\n224:         d = self.model_dump()\n225:         d[\"reach_length\"] = d[\"reach_length\"]  # if d[\"reach_length\"] else \"ZERO-\"\n226:         d[\"gauged\"] = int(d[\"gauged\"])\n227:         del d[\"gauge_id\"]\n228:         return \" \".join(f\"{v: <{VALUE_PADDING}}\" for v in d.values())\n229: \n230:     model_config = ConfigDict(coerce_numbers_to_str=True)\n231: \n232: \n233: class SubBasins(ListCommand):\n234:     \"\"\"SubBasins command (RVH).\"\"\"\n235: \n236:     root: Sequence[SubBasin]\n237:     _Attributes: Sequence[str] = PrivateAttr(\n238:         [\"ID\", \"NAME\", \"DOWNSTREAM_ID\", \"PROFILE\", \"REACH_LENGTH\", \"GAUGED\"]\n239:     )\n240:     _Units: Sequence[str] = PrivateAttr([\"none\", \"none\", \"none\", \"none\", \"km\", \"none\"])\n241: \n242: \n243: class HRU(Record):\n244:     \"\"\"Record to populate :HRUs command internal table (RVH).\"\"\"\n245: \n246:     hru_id: PositiveInt = 1\n247:     area: Sym = 0  # km^2\n248:     elevation: float = 0  # meters\n249:     latitude: float = 0\n250:     longitude: float = 0\n251:     subbasin_id: PositiveInt = 1\n252:     land_use_class: str = \"[NONE]\"\n253:     veg_class: str = \"[NONE]\"\n254:     soil_profile: str = \"[NONE]\"\n255:     aquifer_profile: str = \"[NONE]\"\n256:     terrain_class: str = \"[NONE]\"\n257:     slope: NonNegativeFloat = 0.0\n258:     aspect: Annotated[float, Field(ge=0, le=360)] = 0.0\n259:     # This field is not part of the Raven config, it is needed for serialization,\n260:     # to specify which HRU subclass to use when necessary\n261:     hru_type: Optional[str] = None\n262: \n263:     def __str__(self):\n264:         import numpy as np\n265: \n266:         d = self.model_dump()\n267:         del d[\"hru_type\"]\n268: \n269:         # Adjust horizontal spacing to match attributes names\n270:         attrs = [\"HRU_ID\"] + HRUs._Attributes.default\n271:         ns = np.array(list(map(len, attrs)))\n272:         ns[1:] += 1\n273: \n274:         # In Py3.10 zip(strict=True) can be used instead.\n275:         if len(d) != len(attrs):\n276:             raise ValueError(\n277:                 f\"HRU record has {len(d)} attributes, but {len(attrs)} are expected.\"\n278:             )\n279:         return \" \".join(f\"{v:<{n}}\" for v, n in zip(d.values(), ns))\n280: \n281: \n282: class HRUs(ListCommand):\n283:     \"\"\"HRUs command (RVH).\"\"\"\n284: \n285:     root: Sequence[HRU]\n286:     _Attributes: Sequence[str] = PrivateAttr(\n287:         [\n288:             \"AREA\",\n289:             \"ELEVATION\",\n290:             \"LATITUDE\",\n291:             \"LONGITUDE\",\n292:             \"BASIN_ID\",\n293:             \"LAND_USE_CLASS\",\n294:             \"VEG_CLASS\",\n295:             \"SOIL_PROFILE\",\n296:             \"AQUIFER_PROFILE\",\n297:             \"TERRAIN_CLASS\",\n298:             \"SLOPE\",\n299:             \"ASPECT\",\n300:         ]\n301:     )\n302:     _Units: Sequence[str] = PrivateAttr(\n303:         [\n304:             \"km2\",\n305:             \"m\",\n306:             \"deg\",\n307:             \"deg\",\n308:             \"none\",\n309:             \"none\",\n310:             \"none\",\n311:             \"none\",\n312:             \"none\",\n313:             \"none\",\n314:             \"deg\",\n315:             \"degN\",\n316:         ]\n317:     )\n318: \n319:     @field_validator(\"root\", mode=\"before\")\n320:     @classmethod\n321:     def ignore_unrecognized_hrus(cls, values):\n322:         \"\"\"Ignore HRUs with unrecognized hru_type.\n323: \n324:         HRUs are ignored only if all allowed HRU classes define `hru_type`, and if the values passed include it.\n325:         \"\"\"\n326:         import collections\n327:         import warnings\n328: \n329:         a = cls.model_fields[\"root\"].annotation\n330: \n331:         # Annotation should be a sequence\n332:         if get_origin(a) != collections.abc.Sequence:\n333:             return values\n334: \n335:         # Extract allowed HRU types\n336:         allowed = [hru.model_fields[\"hru_type\"].default for hru in get_annotations(a)]\n337: \n338:         # If some HRU classes do not define rhu_type, skip filtering\n339:         if None in allowed:\n340:             return values\n341: \n342:         allowed.append(None)\n343: \n344:         out = [value for value in values if getattr(value, \"hru_type\", None) in allowed]\n345:         if len(out) != len(values):\n346:             warnings.warn(\n347:                 \"HRUs with an unrecognized `hru_type` attribute were ignored.\"\n348:             )\n349:         return out\n350: \n351: \n352: class HRUGroup(FlatCommand):\n353:     class _Rec(RootRecord):\n354:         root: Sequence[str]\n355: \n356:         def __str__(self):\n357:             return \",\".join(self.root)\n358: \n359:     name: str\n360:     groups: _Rec\n361: \n362:     @property\n363:     def _template(self):\n364:         return \"\"\"\n365:         :{_cmd} {name}\n366:         {_records}\n367:         :End{_cmd}\n368:         \"\"\"\n369: \n370: \n371: class Reservoir(FlatCommand):\n372:     \"\"\"Reservoir command (RVH).\"\"\"\n373: \n374:     name: str = \"Lake_XXX\"\n375:     subbasin_id: int = Field(0, alias=\"SubBasinID\")\n376:     hru_id: int = Field(0, alias=\"HRUID\")\n377:     type: str = Field(\"RESROUTE_STANDARD\", alias=\"Type\")\n378:     weir_coefficient: float = Field(0, alias=\"WeirCoefficient\")\n379:     crest_width: float = Field(0, alias=\"CrestWidth\")\n380:     max_depth: float = Field(0, alias=\"MaxDepth\")\n381:     lake_area: float = Field(0, alias=\"LakeArea\", description=\"Lake area in m2\")\n382: \n383:     @property\n384:     def _template(self):\n385:         return \"\"\"\n386:             :Reservoir {name}\n387:             {_commands}\n388:             :EndReservoir\n389:             \"\"\"\n390: \n391: \n392: class SubBasinGroup(FlatCommand):\n393:     \"\"\"SubBasinGroup command (RVH).\"\"\"\n394: \n395:     name: str = \"\"\n396:     sb_ids: Sequence[int] = ()\n397: \n398:     def to_rv(self):\n399:         template = \"\"\"\n400:             :SubBasinGroup {name}\n401:               {sb_ids}\n402:             :EndSubBasinGroup\n403:             \"\"\"\n404:         d = self.model_dump()\n405:         n_per_line = 10\n406:         sbids = sorted(self.sb_ids)\n407:         sbids_lines = [\n408:             map(str, sbids[i : i + n_per_line])\n409:             for i in range(0, len(sbids), n_per_line)\n410:         ]\n411:         d[\"sb_ids\"] = \"\\n  \".join([\", \".join(sbids) for sbids in sbids_lines])\n412:         return dedent(template).format(**d)\n413: \n414: \n415: class SBGroupPropertyMultiplier(LineCommand):\n416:     group_name: str\n417:     parameter_name: str\n418:     mult: float\n419: \n420: \n421: # TODO: Convert to new config\n422: class ChannelProfile(FlatCommand):\n423:     \"\"\"ChannelProfile command (RVP).\"\"\"\n424: \n425:     name: str = \"chn_XXX\"\n426:     bed_slope: float = 0\n427:     survey_points: Tuple[Tuple[float, float], ...] = ()\n428:     roughness_zones: Tuple[Tuple[float, float], ...] = ()\n429: \n430:     def to_rv(self):\n431:         template = \"\"\"\n432:             :ChannelProfile {name}\n433:               :Bedslope {bed_slope}\n434:               :SurveyPoints\n435:             {survey_points}\n436:               :EndSurveyPoints\n437:               :RoughnessZones\n438:             {roughness_zones}\n439:               :EndRoughnessZones\n440:             :EndChannelProfile\n441:             \"\"\"\n442:         d = self.model_dump()\n443:         d[\"survey_points\"] = \"\\n\".join(\n444:             f\"{INDENT * 2}{p[0]} {p[1]}\" for p in d[\"survey_points\"]\n445:         )\n446:         d[\"roughness_zones\"] = \"\\n\".join(\n447:             f\"{INDENT * 2}{z[0]} {z[1]}\" for z in d[\"roughness_zones\"]\n448:         )\n449:         return dedent(template).format(**d)\n450: \n451: \n452: class GridWeights(Command):\n453:     \"\"\"GridWeights command.\n454: \n455:     Notes\n456:     -----\n457:     command can be embedded in both a `GriddedForcing` or a `StationForcing`.\n458: \n459:     The default is to have a single cell that covers an entire single HRU, with a\n460:     weight of 1.\n461:     \"\"\"\n462: \n463:     number_hrus: int = Field(1, alias=\"NumberHRUs\")\n464:     number_grid_cells: int = Field(1, alias=\"NumberGridCells\")\n465: \n466:     class GWRecord(RootRecord):\n467:         root: Tuple[int, int, float] = (1, 0, 1.0)\n468: \n469:         def __iter__(self):\n470:             return iter(self.root)\n471: \n472:         def __getitem__(self, item):\n473:             return self.root[item]\n474: \n475:         def __str__(self):\n476:             return \" \".join(map(str, self.root))\n477: \n478:         model_config = ConfigDict(arbitrary_types_allowed=True, populate_by_name=True)\n479: \n480:     data: Sequence[GWRecord] = Field((GWRecord(),))\n481: \n482:     @classmethod\n483:     def parse(cls, s):\n484:         pat = r\"\"\"\n485:         :GridWeights\n486:         \\s*:NumberHRUs\\s+(\\d+)\n487:         \\s*:NumberGridCells\\s+(\\d+)\n488:         \\s*(.+)\n489:         :EndGridWeights\n490:         \"\"\"\n491:         m = re.match(dedent(pat).strip(), s.strip(), re.DOTALL)\n492:         n_hrus, n_grid_cells, data = m.groups()  # type: ignore\n493:         data = [d.strip().split() for d in data.split(\"\\n\")]\n494:         data = tuple((int(h), int(c), float(w)) for h, c, w in data)\n495:         return cls(\n496:             number_hrus=int(n_hrus), number_grid_cells=int(n_grid_cells), data=data\n497:         )\n498: \n499: \n500: class RedirectToFile(RootCommand):\n501:     \"\"\"RedirectToFile command (RVT).\n502: \n503:     Notes\n504:     -----\n505:     For the moment, this command can only be used in the context of a `GriddedForcingCommand`\n506:     or a `StationForcingCommand`, as a `grid_weights` field replacement when inlining is not\n507:     desired.\n508:     \"\"\"\n509: \n510:     root: FilePath\n511: \n512:     def to_rv(self):\n513:         cmd = \"RedirectToFile\"\n514:         return f\":{cmd:<20} {self.root}\\n\"\n515: \n516: \n517: class ReadFromNetCDF(FlatCommand):\n518:     # TODO: When encoding Path, return only path.name\n519:     # Order of HttpUrl, Path is important to avoid casting strings to Path.\n520:     file_name_nc: Union[HttpUrl, Path] = Field(\n521:         ..., alias=\"FileNameNC\", description=\"NetCDF file name.\"\n522:     )\n523:     var_name_nc: str = Field(\n524:         ..., alias=\"VarNameNC\", description=\"NetCDF variable name.\"\n525:     )\n526:     dim_names_nc: Sequence[str] = Field(..., alias=\"DimNamesNC\")\n527:     station_idx: int = Field(\n528:         1,\n529:         alias=\"StationIdx\",\n530:         description=\"NetCDF index along station dimension. Starts at 1.\",\n531:     )\n532:     time_shift: Optional[float] = Field(\n533:         None, alias=\"TimeShift\", description=\"Time stamp shift in days.\"\n534:     )\n535:     linear_transform: Optional[LinearTransform] = Field(None, alias=\"LinearTransform\")\n536:     deaccumulate: Optional[bool] = Field(None, alias=\"Deaccumulate\")\n537: \n538:     latitude_var_name_nc: Optional[str] = Field(None, alias=\"LatitudeVarNameNC\")\n539:     longitude_var_name_nc: Optional[str] = Field(None, alias=\"LongitudeVarNameNC\")\n540:     elevation_var_name_nc: Optional[str] = Field(None, alias=\"ElevationVarNameNC\")\n541: \n542:     @field_validator(\"dim_names_nc\")\n543:     @classmethod\n544:     def reorder_time(cls, v):\n545:         \"\"\"TODO: Return dimensions as x, y, t. Currently only puts time at the end.\"\"\"\n546:         dims = list(v)\n547:         for time_dim in (\"t\", \"time\"):\n548:             if time_dim in dims:\n549:                 dims.remove(time_dim)\n550:                 dims.append(time_dim)\n551:                 break\n552:         else:\n553:             raise ValidationError(\"No time dimension found in dim_names_nc tuple.\")\n554: \n555:         return tuple(dims)\n556: \n557:     @classmethod\n558:     def from_nc(\n559:         cls, fn, data_type, station_idx=1, alt_names=(), engine=\"h5netcdf\", **kwds\n560:     ):\n561:         \"\"\"Instantiate class from netCDF dataset.\"\"\"\n562:         specs = nc_specs(\n563:             fn,\n564:             data_type,\n565:             station_idx=station_idx,\n566:             alt_names=alt_names,\n567:             engine=engine,\n568:         )\n569:         specs.update(kwds)\n570:         attrs = filter_for(cls, specs)\n571:         return cls(**attrs)\n572: \n573:     @property\n574:     def da(self) -> xr.DataArray:\n575:         \"\"\"Return DataArray from configuration.\"\"\"\n576:         # TODO: Apply linear transform and time shift\n577:         da = xr.open_dataset(self.file_name_nc)[self.var_name_nc]\n578:         if len(self.dim_names_nc) == 1:\n579:             return da\n580:         elif len(self.dim_names_nc) == 2:\n581:             return da.isel({self.dim_names_nc[0]: self.station_idx})\n582:         else:\n583:             raise NotImplementedError()\n584: \n585: \n586: class GriddedForcing(ReadFromNetCDF):\n587:     \"\"\"GriddedForcing command (RVT).\"\"\"\n588: \n589:     name: str = \"\"\n590:     forcing_type: Optional[options.Forcings] = Field(None, alias=\"ForcingType\")\n591:     grid_weights: Union[GridWeights, RedirectToFile] = Field(\n592:         GridWeights(), alias=\"GridWeights\"\n593:     )\n594:     # StationIdx is not relevant to GriddedForcing\n595:     station_idx: Optional[int] = None\n596: \n597:     @property\n598:     def _template(self):\n599:         return \"\"\"\n600:         :{_cmd} {name}\n601:         {_commands}\n602:         :End{_cmd}\n603:         \"\"\"\n604: \n605:     @field_validator(\"dim_names_nc\")\n606:     @classmethod\n607:     def check_dims(cls, v):\n608:         if len(v) != 3:\n609:             raise ValueError(\n610:                 \"GriddedForcing netCDF datasets should have  three dimensions (lon, lat, time).\"\n611:             )\n612:         return v\n613: \n614: \n615: class StationForcing(GriddedForcing):\n616:     \"\"\"StationForcing command (RVT).\"\"\"\n617: \n618:     @field_validator(\"dim_names_nc\")\n619:     @classmethod\n620:     def check_dims(cls, v):\n621:         if len(v) != 2:\n622:             raise ValueError(\n623:                 \"StationForcing netCDF datasets should have two dimensions (station, time).\"\n624:             )\n625:         return v\n626: \n627:     @classmethod\n628:     def from_nc(cls, fn, data_type, alt_names=(), **kwds):\n629:         \"\"\"Instantiate class from netCDF dataset.\"\"\"\n630:         specs = nc_specs(fn, data_type, station_idx=None, alt_names=alt_names)\n631:         specs.update(kwds)\n632: \n633:         attrs = filter_for(cls, specs)\n634: \n635:         # Build default gridweights\n636:         if \"grid_weights\" not in kwds and \"GridWeights\" not in kwds:\n637:             size = specs[\"_dim_size_nc\"]\n638:             size.pop(specs[\"_time_dim_name_nc\"])\n639:             nstations = list(size.values())[0]\n640:             data = [[i + 1, i + 1, 1] for i in range(nstations)]\n641:             gw = GridWeights(\n642:                 number_hrus=nstations, number_grid_cells=nstations, data=data\n643:             )\n644:             attrs[\"grid_weights\"] = gw\n645: \n646:         return cls(**attrs)\n647: \n648: \n649: class Data(FlatCommand):\n650:     data_type: options.Forcings = \"\"\n651:     units: str = \"\"\n652:     read_from_netcdf: ReadFromNetCDF = Field(..., alias=\"ReadFromNetCDF\")\n653: \n654:     @property\n655:     def _template(self):\n656:         return \"\"\"\n657:                :{_cmd} {data_type} {units}\n658:                {_commands}\n659:                :End{_cmd}\n660:                \"\"\"\n661: \n662:     _nested: bool = False\n663: \n664:     @classmethod\n665:     def from_nc(cls, fn, data_type, station_idx=1, alt_names=(), **kwds):\n666:         specs = nc_specs(fn, data_type, station_idx, alt_names)\n667:         specs.update(kwds)\n668:         attrs = filter_for(cls, specs)\n669:         return cls(**attrs)\n670: \n671: \n672: class Gauge(FlatCommand):\n673:     name: str = \"default\"\n674:     latitude: float = Field(..., alias=\"Latitude\")\n675:     longitude: float = Field(..., alias=\"Longitude\")\n676:     elevation: Optional[float] = Field(None, alias=\"Elevation\")\n677: \n678:     rain_correction: Optional[Sym] = Field(\n679:         None, alias=\"RainCorrection\", description=\"Rain correction\"\n680:     )\n681:     snow_correction: Optional[Sym] = Field(\n682:         None, alias=\"SnowCorrection\", description=\"Snow correction\"\n683:     )\n684: \n685:     monthly_ave_evaporation: Optional[Sequence] = Field(\n686:         None, alias=\"MonthlyAveEvaporation\"\n687:     )\n688:     monthly_ave_temperature: Optional[Sequence] = Field(\n689:         None, alias=\"MonthlyAveTemperature\"\n690:     )\n691:     monthly_min_temperature: Optional[Sequence] = Field(\n692:         None, alias=\"MonthlyMinTemperature\"\n693:     )\n694:     monthly_max_temperature: Optional[Sequence] = Field(\n695:         None, alias=\"MonthlyMaxTemperature\"\n696:     )\n697: \n698:     data: Optional[Sequence[Data]] = Field(None, alias=\"Data\")\n699: \n700:     _nested: bool = False\n701: \n702:     @property\n703:     def _template(self):\n704:         return \"\"\"\n705:         :Gauge {name}\n706:         {_commands}\n707:         :EndGauge\n708:         \"\"\"\n709: \n710:     @field_validator(\"monthly_ave_evaporation\", \"monthly_ave_temperature\")\n711:     @classmethod\n712:     def confirm_monthly(cls, v):\n713:         if v is not None and len(v) != 12:\n714:             raise ValidationError(\"One value per month needed.\")\n715:         return v\n716: \n717:     @classmethod\n718:     def from_nc(\n719:         cls,\n720:         fn: Union[str, Path, Sequence[Path]],\n721:         data_type: Optional[Sequence[str]] = None,\n722:         station_idx: int = 1,\n723:         alt_names: Optional[Dict[str, str]] = None,\n724:         mon_ave: bool = False,\n725:         data_kwds: Optional[Dict[str, Any]] = None,\n726:         engine: str = \"h5netcdf\",\n727:         **kwds,\n728:     ) -> \"Gauge\":\n729:         \"\"\"Return Gauge instance with configuration options inferred from the netCDF itself.\n730: \n731:         Parameters\n732:         ----------\n733:         fn : str or Path or Sequence[Path]\n734:             NetCDF file path or paths.\n735:         data_type : Sequence[str], optional\n736:             Raven data types to extract from netCDF files, e.g. 'PRECIP', 'AVE_TEMP'. The algorithm tries to find all\n737:             forcings in each file until one is found, then it stops searching for it in the following files.\n738:         station_idx : int\n739:             Index along station dimension. Starts at 1. Should be the same for all netCDF files.\n740:         alt_names : dict\n741:             Alternative variable names keyed by data type.\n742:             Use this if variables do not correspond to CF standard defaults.\n743:         mon_ave : bool\n744:             If True, compute the monthly average.\n745:         data_kwds : dict[options.Forcings, dict[str, str]]\n746:             Additional `:Data` parameters keyed by forcing type and station id. Overrides inferred parameters.\n747:             Use keyword \"ALL\" to pass parameters to all variables.\n748:         engine : {\"h5netcdf\", \"netcdf4\", \"pydap\"}\n749:             The engine used to open the dataset. Default is 'h5netcdf'.\n750:         **kwds\n751:             Additional arguments for Gauge.\n752: \n753:         Returns\n754:         -------\n755:         Gauge\n756:             Gauge instance.\n757:         \"\"\"\n758:         if alt_names is None:\n759:             alt_names = {}\n760:         if data_kwds is None:\n761:             data_kwds = {}\n762: \n763:         if isinstance(fn, (str, Path)):\n764:             fn = [fn]\n765: \n766:         idx = station_idx\n767:         data = {}\n768:         attrs = {}\n769: \n770:         forcings = set(data_type or get_args(options.Forcings))\n771: \n772:         for f in fn:\n773:             for dtype in forcings:\n774:                 try:\n775:                     specs = nc_specs(\n776:                         f,\n777:                         dtype,\n778:                         idx,\n779:                         alt_names.get(dtype, ()),\n780:                         mon_ave=mon_ave,\n781:                         engine=engine,\n782:                     )\n783:                 except ValueError:\n784:                     pass\n785: \n786:                 else:\n787:                     # Add extra keywords\n788:                     ex_f = {**data_kwds.get(dtype, {}), **data_kwds.get(\"ALL\", {})}\n789: \n790:                     # Filter data attributes\n791:                     data[dtype] = filter_for(Data, specs, **ex_f)\n792: \n793:                     attrs.update(filter_for(cls, specs))\n794: \n795:             # Remove forcings that have been found, so that they're not searched in the following files.\n796:             forcings.difference_update(data)\n797: \n798:         if len(data) == 0:\n799:             raise ValueError(\"No data found in netCDF files.\")\n800: \n801:         # Default Gauge name\n802:         attrs[\"name\"] = attrs.get(\"name\", f\"Gauge_{idx}\")\n803: \n804:         attrs = filter_for(cls, attrs, **kwds, data=list(data.values()))\n805:         return cls(**attrs)\n806: \n807:     @property\n808:     def ds(self) -> xr.Dataset:\n809:         \"\"\"Return xarray Dataset with forcing variables keyed by Raven forcing names.\"\"\"\n810:         ds = {}\n811:         for data in self.data:\n812:             ds[data.data_type] = data.read_from_netcdf.da\n813:         return xr.Dataset(ds)\n814: \n815: \n816: class ObservationData(Data, coerce_numbers_to_str=True):\n817:     uid: str = \"1\"  # Basin ID or HRU ID\n818:     data_type: Literal[\"HYDROGRAPH\"] = \"HYDROGRAPH\"\n819: \n820:     @property\n821:     def _template(self):\n822:         return \"\"\"\n823:         :ObservationData {data_type} {uid} {units}\n824:         {_commands}\n825:         :EndObservationData\n826:         \"\"\"\n827: \n828:     @classmethod\n829:     def from_nc(cls, fn, station_idx: int = 1, alt_names=(), engine=\"h5netcdf\", **kwds):\n830:         specs = nc_specs(\n831:             fn,\n832:             \"HYDROGRAPH\",\n833:             station_idx=station_idx,\n834:             alt_names=alt_names,\n835:             engine=engine,\n836:         )\n837:         attrs = filter_for(cls, specs, **kwds, data_type=\"HYDROGRAPH\")\n838:         return cls(**attrs)\n839: \n840: \n841: class HRUState(Record):\n842:     hru_id: int = 1\n843:     data: Dict[str, Sym] = Field(default_factory=dict)\n844: \n845:     def __str__(self):\n846:         return \",\".join(map(str, (self.hru_id,) + tuple(self.data.values())))\n847: \n848:     @classmethod\n849:     def parse(cls, sol, names=None):\n850:         idx, *values = re.split(r\",|\\s+\", sol.strip())\n851:         if names is None:\n852:             names = [f\"S{i}\" for i in range(len(values))]\n853:         return cls(hru_id=idx, data=dict(zip(names, values)))\n854: \n855: \n856: class HRUStateVariableTable(ListCommand):\n857:     \"\"\"Table of HRU state variables.\n858: \n859:     If the HRUState include different attributes, the states will be modified to include all attributes.\n860:     \"\"\"\n861: \n862:     root: Sequence[HRUState]\n863:     _Attributes: Sequence[str] = PrivateAttr(None)\n864: \n865:     @model_validator(mode=\"after\")\n866:     def set_attributes(self):\n867:         from itertools import chain\n868: \n869:         # Get all attribute names from HRUStates\n870:         names = (\n871:             sorted(list(set(chain(*[tuple(s.data.keys()) for s in self.root])))) or None\n872:         )\n873: \n874:         self.root = [\n875:             HRUState(hru_id=s.hru_id, data={n: s.data.get(n, 0.0) for n in names})\n876:             for s in self.root\n877:         ]\n878: \n879:         # Store names in private class attribute\n880:         self._Attributes = names\n881:         return self\n882: \n883:     @classmethod\n884:     def parse(cls, sol: str):\n885:         from collections import defaultdict\n886: \n887:         pat = re.compile(\n888:             r\"^:HRUStateVariableTable$\\s*:Attributes,(?P<atts>.+)$\\s*:Units,.*$\\s*(?:(\"\n889:             r\"?P<vars>.+)$)+\\s*:EndHRUStateVariableTable\",\n890:             re.MULTILINE,\n891:         )\n892:         matches = pat.findall(sol)\n893: \n894:         d = defaultdict(dict)\n895:         for m in matches:\n896:             atts = [a.strip() for a in m[0].strip(\",\").split(\",\")]\n897:             vals = [re.split(r\",|\\s+\", line.strip(\",\")) for line in m[1:]]\n898: \n899:             for val in vals:\n900:                 idx, *values = val\n901:             d[idx].update(dict(zip(atts, values)))\n902: \n903:         out = []\n904:         for idx, data in d.items():\n905:             out.append(HRUState(hru_id=idx, data=data))\n906:         return cls(out)\n907: \n908: \n909: class BasinIndex(Command, coerce_numbers_to_str=True):\n910:     \"\"\"Initial conditions for a flow segment.\"\"\"\n911: \n912:     # TODO: Check that qout and cie can be written with separating commas.\n913:     sb_id: int = 1\n914:     name: str = \"watershed\"\n915:     channel_storage: float = Field(0.0, alias=\"ChannelStorage\")\n916:     rivulet_storage: float = Field(0.0, alias=\"RivuletStorage\")\n917:     qout: Sequence[float] = Field((1.0, 0.0, 0.0), alias=\"Qout\")\n918:     qlat: Optional[Sequence[float]] = Field(None, alias=\"Qlat\")\n919:     qin: Optional[Sequence[float]] = Field(None, alias=\"Qin\")\n920: \n921:     # model_config = ConfigDict(coerce_numbers_to_str=True)\n922: \n923:     @property\n924:     def _template(self):\n925:         return \"\"\"\n926:          :BasinIndex {sb_id} {name}\n927:          {_commands}\n928:           \"\"\"\n929: \n930:     @classmethod\n931:     @no_type_check\n932:     def parse(cls, s):\n933:         pat = r\"\"\"\n934:         :BasinIndex (.+?)\n935:         (.+)\n936:         \"\"\"\n937:         m = re.search(dedent(pat).strip(), s, re.DOTALL)\n938:         index_name = re.split(r\",|\\s+\", m.group(1).strip())\n939:         rec_values = {\"sb_id\": index_name[0], \"name\": index_name[1]}\n940:         for line in m.group(2).strip().splitlines():\n941:             all_values = filter(None, re.split(r\",|\\s+\", line.strip()))\n942:             cmd, *values = all_values\n943:             if cmd in [\":ChannelStorage\", \":RivuletStorage\"]:\n944:                 # FIXME: assertions should not be found outside of testing code. Replace with conditional logic.\n945:                 assert len(values) == 1\n946:                 rec_values[cmd[1:]] = float(values[0])\n947:             else:\n948:                 rec_values[cmd[1:]] = tuple(values)\n949:         return cls(**rec_values)\n950: \n951: \n952: class BasinStateVariables(ListCommand):\n953:     root: Sequence[BasinIndex]\n954: \n955:     @classmethod\n956:     @no_type_check\n957:     def parse(cls, sol):\n958:         pat = r\"\"\"\n959:         :BasinStateVariables\n960:         (.+)\n961:         :EndBasinStateVariables\n962:         \"\"\"\n963:         m = re.search(dedent(pat).strip(), sol, re.DOTALL)\n964:         bis = filter(None, m.group(1).strip().split(\":BasinIndex\"))\n965:         bs = [BasinIndex.parse(f\":BasinIndex {bi}\") for bi in bis]\n966:         return cls(bs)\n967: \n968: \n969: class SoilClasses(ListCommand):\n970:     class SoilClass(Record):\n971:         name: str\n972:         mineral: Optional[Tuple[float, float, float]] = None\n973:         organic: Optional[float] = None\n974: \n975:         @field_validator(\"mineral\")\n976:         @classmethod\n977:         def validate_mineral(cls, v):\n978:             \"\"\"Assert sum of mineral fraction is 1.\"\"\"\n979:             if v is not None:\n980:                 # FIXME: assertions should not be found outside of testing code. Replace with conditional logic.\n981:                 assert sum(v) == 1, \"Mineral fraction should sum to 1.\"\n982:             return v\n983: \n984:         @field_validator(\"mineral\")\n985:         @classmethod\n986:         def validate_mineral_pct(cls, v: Tuple):\n987:             if v is not None:\n988:                 for x in v:\n989:                     assert (x >= 0) and (x <= 1), \"Value should be in [0,1].\"\n990:             return v\n991: \n9