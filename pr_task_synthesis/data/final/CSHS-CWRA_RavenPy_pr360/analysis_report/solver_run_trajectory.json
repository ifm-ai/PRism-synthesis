              "command": "python3 << 'EOF'\n\"\"\"\nDemonstration of CustomOutput functionality\n\nThis shows how CustomOutput can be used in Raven model configurations.\n\"\"\"\n\nfrom ravenpy.config.commands import CustomOutput\nfrom ravenpy.config.rvs import RVI\n\n# Example 1: Basic usage\nprint(\"Example 1: Basic CustomOutput\")\nprint(\"-\" * 60)\nco1 = CustomOutput(\n    time_per='YEARLY',\n    stat='AVERAGE',\n    variable='PRECIP',\n    space_agg='ENTIRE_WATERSHED'\n)\nprint(f\"Output: {co1.to_rv().strip()}\")\n\n# Example 2: With custom filename\nprint(\"\\nExample 2: CustomOutput with filename\")\nprint(\"-\" * 60)\nco2 = CustomOutput(\n    time_per='DAILY',\n    stat='MAXIMUM',\n    variable='TEMPERATURE',\n    space_agg='BY_BASIN',\n    filename='daily_max_temp.nc'\n)\nprint(f\"Output: {co2.to_rv().strip()}\")\n\n# Example 3: In a model configuration\nprint(\"\\nExample 3: CustomOutput in RVI configuration\")\nprint(\"-\" * 60)\nconf = RVI(\n    run_name=\"MyModel\",\n    calendar=\"PROLEPTIC_GREGORIAN\",\n    start_date=\"2000-01-01\",\n    end_date=\"2000-12-31\",\n    time_step=1.0,\n    custom_output=[\n        CustomOutput(time_per='YEARLY', stat='AVERAGE', variable='PRECIP', space_agg='ENTIRE_WATERSHED'),\n        CustomOutput(time_per='MONTHLY', stat='AVERAGE', variable='SNOWFALL', space_agg='BY_HRU'),\n    ]\n)\nprint(conf.to_rv())\nEOF\n",
