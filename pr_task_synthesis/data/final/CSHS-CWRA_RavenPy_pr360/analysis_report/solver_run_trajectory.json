ame=True)\n214: \n215: \n216: class FlatCommand(Command):\n217:     \"\"\"Only used to discriminate Commands that should not be nested.\"\"\"\n218: \n219: \n220: class LineCommand(FlatCommand):\n221:     \"\"\"A non-nested Command on a single line.\n222: \n223:     :CommandName {field_1} {field_2} ... {field_n}\\n\n224:     \"\"\"\n225: \n226:     def to_rv(self):\n227:         out = [f\":{self.__class__.__name__:<20}\"]\n228:         for field in self.model_fields.keys():\n229:             out.append(str(getattr(self, field)))\n230: \n231:         return \" \".join(out) + \"\\n\"\n232: \n233: \n234: class ListCommand(RootModel, _Command):\n235:     \"\"\"Use so that commands with __root__: Sequence[Command] behave like a list.\"\"\"\n236: \n237:     root: Sequence[Any]\n238: \n239:     def __iter__(self):\n240:         return iter(self.root)\n241: \n242:     def __getitem__(self, item):\n243:         return self.root[item]\n244: \n245:     def __len__(self):\n246:         return len(self.root)\n247: \n248:     model_config = ConfigDict(arbitrary_types_allowed=True, populate_by_name=True)\n249: \n250: \n251: class ParameterList(Record):\n252:     name: str = \"\"\n253:     values: Sequence[Union[Sym, str, None]] = ()\n254: \n255:     @model_validator(mode=\"before\")\n256:     @classmethod\n257:     def no_none_in_default(cls, data):\n258:         \"\"\"Make sure that no values are None for the [DEFAULT] record.\"\"\"\n259:         if data[\"name\"] == \"[DEFAULT]\" and None in data[\"values\"]:\n260:             raise ValueError(\"Default record can not contain None.\")\n261:         return data\n262: \n263:     def __str__(self):\n264:         fmt = \"{name:<16}\" + len(self.values) * \",{:>18}\"\n265:         evals = []\n266:         for v in self.values:\n267:             ev = \"_DEFAULT\" if v is None else v\n268:             evals.append(ev)\n269: \n270:         return fmt.format(name=self.name, *evals)\n271: \n272: \n273: class GenericParameterList(Command):\n274:     parameters: Sequence[str] = Field(alias=\"Parameters\", description=\"Parameter names\")\n275:     units: Optional[Sequence[str]] = Field(None, alias=\"Units\")\n276:     pl: Sequence[ParameterList]\n277: \n278:     @model_validator(mode=\"after\")\n279:     def num_values_equal_num_names(self):\n280:         \"\"\"Check that the length of the parameter list equals the number of given parameter names.\"\"\"\n281:         n = len(self.parameters)\n282: \n283:         for pl in self.pl:\n284:             if len(pl.values) != n:\n285:                 raise ValueError(\"Number of values should match number of parameters.\")\n286: \n287:         return self\n288: \n289:     @model_validator(mode=\"after\")\n290:     def set_default_units(self):\n291:         n = len(self.parameters)\n292:         if self.units is None:\n293:             self.units = (\"none\",) * n\n294:         return self\n295: \n296: \n297: class RV(Command):\n298:     \"\"\"Base class for RV configuration objects.\"\"\"\n299: \n300:     __rv__ = \"\"\n301: \n302:     @property\n303:     def _template(self):\n304:         return \"{_commands}\\n\"\n305: \n306:     @property\n307:     def _indent(self):\n308:         return \"\"\n309: \n310:     model_config = ConfigDict(\n311:         populate_by_name=True, validate_default=True, validate_assignment=True\n312:     )\n313: \n314: \n315: def parse_symbolic(value, **kwds):\n316:     \"\"\"Inject values of symbolic variables into object and return object.\n317: \n318:     Note that parsing the output of `model_dump` can cause problems because there is not always enough information in the\n319:     dictionary to recreate the correct model.\n320:     \"\"\"\n321:     from pymbolic.mapper.evaluator import EvaluationMapper as EM\n322:     from pymbolic.primitives import Expression, Variable\n323: \n324:     if isinstance(value, dict):\n325:         return {k: parse_symbolic(v, **kwds) for k, v in value.items()}\n326: \n327:     elif isinstance(value