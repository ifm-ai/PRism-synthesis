uence: complicated\n57:         - Any other: ':{cmd} {obj}'\n58:     \"\"\"\n59:     import warnings\n60: \n61:     for cmd, obj in v.items():\n62:         if obj is None:\n63:             continue\n64:         elif isinstance(obj, bool):\n65:             # :Command\\n\n66:             out = f\":{cmd}\\n\" if obj else \"\"\n67:         elif isinstance(obj, dict):\n68:             # :Command key value\\n\n69:             out = (\n70:                 \"\\n\".join([f\":{cmd} {key} {value}\" for (key, value) in obj.items()])\n71:                 + \"\\n\\n\"\n72:             )\n73:         elif isinstance(obj, Enum):\n74:             # :Command value\\n\n75:             out = f\":{cmd:<20} {obj.value}\\n\"\n76: \n77:         elif hasattr(obj, \"to_rv\"):\n78:             # Custom\n79:             out = obj.to_rv()\n80:         elif issubclass(obj.__class__, _Record):\n81:             out = str(obj)\n82:         elif isinstance(obj, (list, tuple)):\n83:             s = map(str, obj)\n84:             o0 = obj[0]\n85:             if cmd == \"root\" or issubclass(o0.__class__, FlatCommand):\n86:                 out = \"\".join(s)\n87:             # elif cmd == \"Attributes\":\n88:             #     out = f\":{cmd},\" + \",\".join(s) + \"\\n\"\n89:             elif cmd in [\"Parameters\", \"Attributes\", \"Units\"]:\n90:                 fmt = \":{cmd:<15}\" + len(obj) * \",{:>18}\" + \"\\n\"\n91:                 out = fmt.format(cmd=cmd, *obj)\n92:             elif issubclass(o0.__class__, (_Command, _Record)):\n93:                 rec = indent(\"\\n\".join(s), o0._indent)\n94:                 out = f\":{cmd}\\n{rec}\\n:End{cmd}\\n\"\n95:             elif isinstance(o0, Enum):\n96:                 seq = \" \".join([o.value for o in obj])\n97:                 out = f\":{cmd:<20} {seq}\\n\"\n98:             else:\n99:                 seq = \" \".join(s)\n100:                 out = f\":{cmd:<20} {seq}\\n\"\n101:         else:\n102:             out = f\":{cmd:<20} {obj}\\n\"\n103: \n104:         v[cmd] = str(out)\n105: \n106:     return v\n107: \n108: \n109: class _Record(BaseModel):\n110:     \"\"\"A Record has no nested Command or Record objects.\"\"\"\n111: \n112:     pass\n113: \n114: \n115: class Record(_Record):\n116:     model_config = ConfigDict(\n117:         extra=\"forbid\", arbitrary_types_allowed=True, populate_by_name=True\n118:     )\n119: \n120: \n121: class RootRecord(RootModel, _Record):\n122:     model_config = ConfigDict(arbitrary_types_allowed=True, populate_by_name=True)\n123: \n124: \n125: class _Command(BaseModel):\n126:     \"\"\"Base class for Raven commands.\"\"\"\n127: \n128:     @property\n129:     def _indent(self):\n130:         return \"  \"\n131: \n132:     @property\n133:     def _template(self):\n134:         return \"\"\"\n135:                :{_cmd}\n136:                {_commands}{_records}\n137:                :End{_cmd}\n138:                \"\"\"\n139: \n140:     def __str__(self):\n141:         return self.to_rv()\n142: \n143:     def __subcommands__(self) -> Tuple[Dict[str, str], list]:\n144:         \"\"\"Return dictionary of class attributes that are Raven models.\"\"\"\n145:         cmds = {}\n146:         recs = []\n147:         for key, field in self.model_fields.items():\n148:             obj = self.__dict__[key]\n149:             if obj is not None:\n150:                 if issubclass(obj.__class__, _Record):\n151:                     recs = [obj]\n152:                 elif issubclass(obj.__class__, _Command):\n153:                     cmds[field.alias] = self.__dict__[key]\n154:                 else:\n155:                     try:\n156:                         o = obj[0]\n157:                     except (TypeError, IndexError, KeyError):\n158:                         o = None\n159:                     if issubclass(o.__class__, _Record):\n160:                         recs = obj\n161:                     elif field.alias is not None:\n162:                         cmds[field.alias] = self.__