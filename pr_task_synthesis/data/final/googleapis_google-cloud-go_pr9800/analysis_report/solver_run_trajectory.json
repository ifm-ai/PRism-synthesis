eason to do so would be to bind custom telemetry that overrides the\n52: \t// defaults.\n53: \tDisableTelemetry bool\n54: \t// DisableAuthentication specifies that no authentication should be used. It\n55: \t// is suitable only for testing and for accessing public resources, like\n56: \t// public Google Cloud Storage buckets.\n57: \tDisableAuthentication bool\n58: \t// Endpoint overrides the default endpoint to be used for a service.\n59: \tEndpoint string\n60: \t// Metadata is extra gRPC metadata that will be appended to every outgoing\n61: \t// request.\n62: \tMetadata map[string]string\n63: \t// GRPCDialOpts are dial options that will be passed to `grpc.Dial` when\n64: \t// establishing a`grpc.Conn``\n65: \tGRPCDialOpts []grpc.DialOption\n66: \t// PoolSize is specifies how many connections to balance between when making\n67: \t// requests. If unset or less than 1, the value defaults to 1.\n68: \tPoolSize int\n69: \t// Credentials used to add Authorization metadata to all requests. If set\n70: \t// DetectOpts are ignored.\n71: \tCredentials *auth.Credentials\n72: \t// DetectOpts configures settings for detect Application Default\n73: \t// Credentials.\n74: \tDetectOpts *credentials.DetectOptions\n75: \t// UniverseDomain is the default service domain for a given Cloud universe.\n76: \t// The default value is \"googleapis.com\". This is the universe domain\n77: \t// configured for the client, which will be compared to the universe domain\n78: \t// that is separately configured for the credentials.\n79: \tUniverseDomain string\n80: \n81: \t// InternalOptions are NOT meant to be set directly by consumers of this\n82: \t// package, they should only be set by generated client code.\n83: \tInternalOptions *InternalOptions\n84: }\n85: \n86: // client returns the client a user set for the detect options or nil if one was\n87: // not set.\n88: func (o *Options) client() *http.Client {\n89: \tif o.DetectOpts != nil && o.DetectOpts.Client != nil {\n90: \t\treturn o.DetectOpts.Client\n91: \t}\n92: \treturn nil\n93: }\n94: \n95: func (o *Options) validate() error {\n96: \tif o == nil {\n97: \t\treturn errors.New(\"grpctransport: opts required to be non-nil\")\n98: \t}\n99: \thasCreds := o.Credentials != nil ||\n100: \t\t(o.DetectOpts != nil && len(o.DetectOpts.CredentialsJSON) > 0) ||\n101: \t\t(o.DetectOpts != nil && o.DetectOpts.CredentialsFile != \"\")\n102: \tif o.DisableAuthentication && hasCreds {\n103: \t\treturn errors.New(\"grpctransport: DisableAuthentication is incompatible with options that set or detect credentials\")\n104: \t}\n105: \treturn nil\n106: }\n107: \n108: func (o *Options) resolveDetectOptions() *credentials.DetectOptions {\n109: \tio := o.InternalOptions\n110: \t// soft-clone these so we are not updating a ref the user holds and may reuse\n111: \tdo := transport.CloneDetectOptions(o.DetectOpts)\n112: \n113: \t// If scoped JWTs are enabled user provided an aud, allow self-signed JWT.\n114: \tif (io != nil && io.EnableJWTWithScope) || do.Audience != \"\" {\n115: \t\tdo.UseSelfSignedJWT = true\n116: \t}\n117: \t// Only default scopes if user did not also set an audience.\n118: \tif len(do.Scopes) == 0 && do.Audience == \"\" && io != nil && len(io.DefaultScopes) > 0 {\n119: \t\tdo.Scopes = make([]string, len(io.DefaultScopes))\n120: \t\tcopy(do.Scopes, io.DefaultScopes)\n121: \t}\n122: \tif len(do.Scopes) == 0 && do.Audience == \"\" && io != nil {\n123: \t\tdo.Audience = o.InternalOptions.DefaultAudience\n124: \t}\n125: \treturn do\n126: }\n127: \n128: // InternalOptions are only meant to be set by generated client code. These are\n129: // not meant to be set directly by consumers of this package. Configuration in\n130: // this type is considered EXPERIMENTAL and may be removed at any time in the\n131: // future without warning.\n132: type InternalOptions struct {\n133: \t// EnableNonDefaultSAForDirectPath overrides the default requirement for\n134: \t// using the default service account for DirectPath.\n135: \tEnableNonDefaultSAForDirectPath bool\n136: \t// EnableDirectPath overrides the default attempt to use DirectPath.\n137: \tEnableDirectPath bool\n138: \t// EnableDirectPathXds overrides the default DirectPath type. It is only\n139: \t// valid when DirectPath is enabled.\n140: \tEnableDirectPathXds bool\n141: \t// EnableJWTWithScope specifies if scope can be used with self-signed JWT.\n142: \tEnableJWTWithScope bool\n143: \t// DefaultAudience specifies a default audience to be used as the audience\n144: \t// field (\"aud\") for the JWT token authentication.\n145: \tDefaultAudience string\n146: \t// DefaultEndpointTemplate combined with UniverseDomain specifies\n147: \t// the default endpoint.\n148: \tDefaultEndpointTemplate string\n149: \t// DefaultMTLSEndpoint specifies the default mTLS endpoint.\n150: \tDefaultMTLSEndpoint string\n151: \t// DefaultScopes specifies the default OAuth2 scopes to be used for a\n152: \t// service.\n153: \tDefaultScopes []string\n154: }\n155: \n156: // Dial returns a GRPCClientConnPool that can be used to communicate with a\n157: // Google cloud service, configured with the provided [Options]. It\n158: // automatically appends Authorization metadata to all outgoing requests.\n159: func Dial(ctx context.Context, secure bool, opts *Options) (GRPCClientConnPool, error) {\n160: \tif err := opts.validate(); err != nil {\n161: \t\treturn nil, err\n162: \t}\n163: \tif opts.PoolSize <= 1 {\n164: \t\tconn, err := dial(ctx, secure, opts)\n165: \t\tif err != nil {\n166: \t\t\treturn nil, err\n167: \t\t}\n168: \t\treturn &singleConnPool{conn}, nil\n169: \t}\n170: \tpool := &roundRobinConnPool{}\n171: \tfor i := 0; i < opts.PoolSize; i++ {\n172: \t\tconn, err := dial(ctx, false, opts)\n173: \t\tif err != nil {\n174: \t\t\t// ignore close error, if any\n175: \t\t\tdefer pool.Close()\n176: \t\t\treturn nil, err\n177: \t\t}\n178: \t\tpool.conns = append(pool.conns, conn)\n179: \t}\n180: \treturn pool, nil\n181: }\n182: \n183: // return a GRPCClientConnPool if pool == 1 or else a pool of of them if >1\n184: func dial(ctx context.Context, secure bool, opts *Options) (*grpc.ClientConn, error) {\n185: \ttOpts := &transport.Options{\n186: \t\tEndpoint:       opts.Endpoint,\n187: \t\tClient:         opts.client(),\n188: \t\tUniverseDomain: opts.UniverseDomain,\n189: \t}\n190: \tif io := opts.InternalOptions; io != nil {\n191: \t\ttOpts.DefaultEndpointTemplate = io.DefaultEndpointTemplate\n192: \t\ttOpts.DefaultMTLSEndpoint = io.DefaultMTLSEndpoint\n193: \t}\n194: \ttransportCreds, endpoint, err := transport.GetGRPCTransportCredsAndEndpoint(tOpts)\n195: \tif err != nil {\n196: \t\treturn nil, err\n197: \t}\n198: \n199: \tif !secure {\n200: \t\ttransportCreds = grpcinsecure.NewCredentials()\n201: \t}\n202: \n203: \t// Initialize gRPC dial options with transport-level security options.\n204: \tgrpcOpts := []grpc.DialOption{\n205: \t\tgrpc.WithTransportCredentials(transportCreds),\n206: \t}\n207: \n208: \t// Authentication can only be sent when communicating over a secure connection.\n209: \tif !opts.DisableAuthentication {\n210: \t\tmetadata := opts.Metadata\n211: \t\tcreds, err := credentials.DetectDefault(opts.resolveDetectOptions())\n212: \t\tif err != nil {\n213: \t\t\treturn nil, err\n214: \t\t}\n215: \t\tif opts.Credentials != nil {\n216: \t\t\tcreds = opts.Credentials\n217: \t\t}\n218: \n219: \t\tqp, err := creds.QuotaProjectID(ctx)\n220: \t\tif err != nil {\n221: \t\t\treturn nil, err\n222: \t\t}\n223: \t\tif qp != \"\" {\n224: \t\t\tif metadata == nil {\n225: \t\t\t\tmetadata = make(map[string]string, 1)\n226: \t\t\t}\n227: \t\t\tmetadata[quotaProjectHeaderKey] = qp\n228: \t\t}\n229: \t\tgrpcOpts = append(grpcOpts,\n230: \t\t\tgrpc.WithPerRPCCredentials(&grpcCredentialsProvider{\n231: \t\t\t\tcreds:                creds,\n232: \t\t\t\tmetadata:             metadata,\n233: \t\t\t\tclientUniverseDomain: opts.UniverseDomain,\n234: \t\t\t}),\n235: \t\t)\n236: \n237: \t\t// Attempt Direct Path\n238: \t\tgrpcOpts, endpoint = configureDirectPath(grpcOpts, opts, endpoint, creds)\n239: \t}\n240: \n241: \t// Add tracing, but before the other options, so that clients can override the\n242: \t// gRPC stats handler.\n243: \t// This assumes that gRPC options are processed in order, left to right.\n244: \tgrpcOpts = addOCStatsHandler(grpcOpts, opts)\n245: \tgrpcOpts = append(grpcOpts, opts.GRPCDialOpts...)\n246: \n247: \treturn grpc.DialContext(ctx, endpoint, grpcOpts...)\n248: }\n249: \n250: // grpcCredentialsProvider satisfies https://pkg.go.dev/google.golang.org/grpc/credentials#PerRPCCredentials.\n251: type grpcCredentialsProvider struct {\n252: \tcreds *auth.Credentials\n253: \n254: \tsecure bool\n255: \n256: \t// Additional metadata attached as headers.\n257: \tmetadata             map[string]string\n258: \tclientUniverseDomain string\n259: }\n260: \n261: // getClientUniverseDomain returns the default service domain for a given Cloud universe.\n262: // The default value is \"googleapis.com\". This is the universe domain\n263: // configured for the client, which will be compared to the universe domain\n264: // that is separately configured for the credentials.\n265: func (c *grpcCredentialsProvider) getClientUniverseDomain() string {\n266: \tif c.clientUniverseDomain == \"\" {\n267: \t\treturn internal.DefaultUniverseDomain\n268: \t}\n269: \treturn c.clientUniverseDomain\n270: }\n271: \n272: func (c *grpcCredentialsProvider) GetRequestMetadata(ctx context.Context, uri ...string) (map[string]string, error) {\n273: \tcredentialsUniverseDomain, err := c.creds.UniverseDomain(ctx)\n274: \tif err != nil {\n275: \t\treturn nil, err\n276: \t}\n277: \tif err := transport.ValidateUniverseDomain(c.getClientUniverseDomain(), credentialsUniverseDomain); err != nil {\n278: \t\treturn nil, err\n279: \t}\n280: \ttoken, err := c.creds.Token(ctx)\n281: \tif err != nil {\n282: \t\treturn nil, err\n283: \t}\n284: \tif c.secure {\n285: \t\tri, _ := grpccreds.RequestInfoFromContext(ctx)\n286: \t\tif err = grpccreds.CheckSecurityLevel(ri.AuthInfo, grpccreds.PrivacyAndIntegrity); err != nil {\n287: \t\t\treturn nil, fmt.Errorf(\"unable to transfer credentials PerRPCCredentials: %v\", err)\n288: \t\t}\n289: \t}\n290: \tmetadata := map[string]string{\n291: \t\t\"authorization\": token.Type + \" \" + token.Value,\n292: \t}\n293: \tfor k, v := range c.metadata {\n294: \t\tmetadata[k] = v\n295: \t}\n296: \treturn metadata, nil\n297: }\n298: \n299: func (c *grpcCredentialsProvider) RequireTransportSecurity() bool {\n300: \treturn c.secure\n301: }\n302: \n303: func addOCStatsHandler(dialOpts []grpc.DialOption, opts *Options) []grpc.DialOption {\n304: \tif opts.DisableTelemetry {\n305: \t\treturn dialOpts\n306: \t}\n307: \treturn append(dialOpts, grpc.WithStatsHandler(&ocgrpc.ClientHandler{}))\n308: }\n\n(End of file - total 308 lines)\n</content>",
