{
  "base_image": "mcr.microsoft.com/dotnet/sdk:8.0",
  "build_context_files": [
    "setup_runtime.sh",
    "repo_setup.sh"
  ],
  "build_args": [],
  "target_platform": "linux/amd64",
  "system_packages": [
    "git",
    "curl",
    "wget",
    "apt-transport-https"
  ],
  "build_steps": [
    {
      "step": 1,
      "action": "base_image",
      "description": "Use .NET 8.0 SDK base image"
    },
    {
      "step": 2,
      "action": "install_system_packages",
      "description": "Install git, curl, wget, apt-transport-https"
    },
    {
      "step": 3,
      "action": "copy_scripts",
      "description": "Copy setup_runtime.sh and repo_setup.sh to /opt/benchmark/"
    },
    {
      "step": 4,
      "action": "run_repo_setup",
      "description": "Execute repo_setup.sh to materialize /workspace from git"
    },
    {
      "step": 5,
      "action": "run_runtime_setup",
      "description": "Execute setup_runtime.sh to configure .NET runtime and pre-restore NuGet packages"
    }
  ],
  "runtime_profile": {
    "ecosystem": ".NET",
    "package_manager": "NuGet (via dotnet CLI)",
    "cache_dirs": [
      "/root/.nuget/packages",
      "/root/.nuget/frameworks"
    ]
  },
  "notes": "Dockerfile.final is the single authoritative packaging spec. eval.sh and tests are runtime-mounted, not baked into the image."
}
