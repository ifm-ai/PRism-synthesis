            "output": "<path>/workspace/osu.Game.Tests/Visual/Editing/TestSceneOpenEditorTimestamp.cs</path>\n<type>file</type>\n<content>\n1: // Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.\n2: // See the LICENCE file in the repository root for full licence text.\n3: \n4: using System.Linq;\n5: using NUnit.Framework;\n6: using osu.Framework.Extensions;\n7: using osu.Framework.Extensions.ObjectExtensions;\n8: using osu.Framework.Testing;\n9: using osu.Game.Beatmaps;\n10: using osu.Game.Database;\n11: using osu.Game.Localisation;\n12: using osu.Game.Online.Chat;\n13: using osu.Game.Rulesets;\n14: using osu.Game.Rulesets.Osu;\n15: using osu.Game.Screens.Edit;\n16: using osu.Game.Screens.Menu;\n17: using osu.Game.Screens.Select;\n18: using osu.Game.Tests.Resources;\n19: \n20: namespace osu.Game.Tests.Visual.Editing\n21: {\n22:     public partial class TestSceneOpenEditorTimestamp : OsuGameTestScene\n23:     {\n24:         private Editor? editor => Game.ScreenStack.CurrentScreen as Editor;\n25:         private EditorBeatmap editorBeatmap => editor.ChildrenOfType<EditorBeatmap>().Single();\n26:         private EditorClock editorClock => editor.ChildrenOfType<EditorClock>().Single();\n27: \n28:         [Test]\n29:         public void TestErrorNotifications()\n30:         {\n31:             RulesetInfo rulesetInfo = new OsuRuleset().RulesetInfo;\n32: \n33:             addStepClickLink(\"00:00:000\", waitForSeek: false);\n34:             AddUntilStep(\"received 'must be in edit'\",\n35:                 () => Game.Notifications.AllNotifications.Count(x => x.Text == EditorStrings.MustBeInEditorToHandleLinks),\n36:                 () => Is.EqualTo(1));\n37: \n38:             AddStep(\"enter song select\", () => Game.ChildrenOfType<ButtonSystem>().Single().OnSolo?.Invoke());\n39:             AddUntilStep(\"entered song select\", () => Game.ScreenStack.CurrentScreen is PlaySongSelect);\n40: \n41:             addStepClickLink(\"00:00:000 (1)\", waitForSeek: false);\n42:             AddUntilStep(\"received 'must be in edit'\",\n43:                 () => Game.Notifications.AllNotifications.Count(x => x.Text == EditorStrings.MustBeInEditorToHandleLinks),\n44:                 () => Is.EqualTo(2));\n45: \n46:             setUpEditor(rulesetInfo);\n47:             AddAssert(\"ruleset is osu!\", () => editorBeatmap.BeatmapInfo.Ruleset.Equals(rulesetInfo));\n48: \n49:             addStepClickLink(\"00:000\", \"invalid link\", waitForSeek: false);\n50:             AddUntilStep(\"received 'failed to process'\",\n51:                 () => Game.Notifications.AllNotifications.Count(x => x.Text == EditorStrings.FailedToParseEditorLink),\n52:                 () => Is.EqualTo(1));\n53: \n54:             addStepClickLink(\"50000:00:000\", \"too long link\", waitForSeek: false);\n55:             AddUntilStep(\"received 'failed to process'\",\n56:                 () => Game.Notifications.AllNotifications.Count(x => x.Text == EditorStrings.FailedToParseEditorLink),\n57:                 () => Is.EqualTo(2));\n58:         }\n59: \n60:         [Test]\n61:         public void TestHandleCurrentScreenChanges()\n62:         {\n63:             RulesetInfo rulesetInfo = new OsuRuleset().RulesetInfo;\n64: \n65:             setUpEditor(rulesetInfo);\n66:             AddAssert(\"is osu! ruleset\", () => editorBeatmap.BeatmapInfo.Ruleset.Equals(rulesetInfo));\n67: \n68:             addStepClickLink(\"100:00:000\", \"long link\");\n69:             AddUntilStep(\"moved to end of track\", () => editorClock.CurrentTime, () => Is.EqualTo(editorClock.TrackLength));\n70: \n71:             addStepScreenModeTo(EditorScreenMode.SongSetup);\n72:             addStepClickLink(\"00:00:000\");\n73:             assertOnScreenAt(EditorScreenMode.SongSetup, 0);\n74: \n75:             addStepClickLink(\"00:05:000 (0|0)\");\n76:             assertMovedScreenTo(EditorScreenMode.Compose);\n77: \n78:             addStepScreenModeTo(EditorScreenMode.Design);\n79:             addStepClickLink(\"00:10:000\");\n80:             assertOnScreenAt(EditorScreenMode.Design, 10_000);\n81: \n82:             addStepClickLink(\"00:15:000 (1)\");\n83:             assertMovedScreenTo(EditorScreenMode.Compose);\n84: \n85:             addStepScreenModeTo(EditorScreenMode.Timing);\n86:             addStepClickLink(\"00:20:000\");\n87:             assertOnScreenAt(EditorScreenMode.Timing, 20_000);\n88: \n89:             addStepClickLink(\"00:25:000 (0,1)\");\n90:             assertMovedScreenTo(EditorScreenMode.Compose);\n91: \n92:             addStepScreenModeTo(EditorScreenMode.Verify);\n93:             addStepClickLink(\"00:30:000\");\n94:             assertOnScreenAt(EditorScreenMode.Verify, 30_000);\n95: \n96:             addStepClickLink(\"00:35:000 (0,1)\");\n97:             assertMovedScreenTo(EditorScreenMode.Compose);\n98: \n99:             addStepClickLink(\"00:00:000\");\n100:             assertOnScreenAt(EditorScreenMode.Compose, 0);\n101:         }\n102: \n103:         private void addStepClickLink(string timestamp, string step = \"\", bool waitForSeek = true)\n104:         {\n105:             AddStep($\"{step} {timestamp}\", () =>\n106:                 Game.HandleLink(new LinkDetails(LinkAction.OpenEditorTimestamp, timestamp))\n107:             );\n108: \n109:             if (waitForSeek)\n110:                 AddUntilStep(\"wait for seek\", () => editorClock.SeekingOrStopped.Value);\n111:         }\n112: \n113:         private void addStepScreenModeTo(EditorScreenMode screenMode) =>\n114:             AddStep(\"change screen to \" + screenMode, () => editor!.Mode.Value = screenMode);\n115: \n116:         private void assertOnScreenAt(EditorScreenMode screen, double time)\n117:         {\n118:             AddAssert($\"stayed on {screen} at {time}\", () =>\n119:                 editor!.Mode.Value == screen\n120:                 && editorClock.CurrentTime == time\n121:             );\n122:         }\n123: \n124:         private void assertMovedScreenTo(EditorScreenMode screen, string text = \"moved to\") =>\n125:             AddAssert($\"{text} {screen}\", () => editor!.Mode.Value == screen);\n126: \n127:         private void setUpEditor(RulesetInfo ruleset)\n128:         {\n129:             BeatmapSetInfo beatmapSet = null!;\n130: \n131:             AddStep(\"Import test beatmap\", () =>\n132:                 Game.BeatmapManager.Import(TestResources.GetTestBeatmapForImport()).WaitSafely()\n133:             );\n134:             AddStep(\"Retrieve beatmap\", () =>\n135:                 beatmapSet = Game.BeatmapManager.QueryBeatmapSet(set => !set.Protected).AsNonNull().Value.Detach()\n136:             );\n137:             AddStep(\"Present beatmap\", () => Game.PresentBeatmap(beatmapSet));\n138:             AddUntilStep(\"Wait for song select\", () =>\n139:                 Game.Beatmap.Value.BeatmapSetInfo.Equals(beatmapSet)\n140:                 && Game.ScreenStack.CurrentScreen is PlaySongSelect songSelect\n141:                 && songSelect.IsLoaded\n142:             );\n143:             AddStep(\"Switch ruleset\", () => Game.Ruleset.Value = ruleset);\n144:             AddStep(\"Open editor for ruleset\", () =>\n145:                 ((PlaySongSelect)Game.ScreenStack.CurrentScreen)\n146:                 .Edit(beatmapSet.Beatmaps.Last(beatmap => beatmap.Ruleset.Name == ruleset.Name))\n147:             );\n148:             AddUntilStep(\"Wait for editor open\", () => editor?.ReadyForUse == true);\n149:         }\n150:     }\n151: }\n\n(End of file - total 151 lines)\n</content>",
