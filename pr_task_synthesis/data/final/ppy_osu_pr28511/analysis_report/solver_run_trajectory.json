            {
              "file": "osu.Game/Rulesets/Edit/EditorTimestampParser.cs",
              "patch": "Index: osu.Game/Rulesets/Edit/EditorTimestampParser.cs\n===================================================================\n--- osu.Game/Rulesets/Edit/EditorTimestampParser.cs\t\n+++ osu.Game/Rulesets/Edit/EditorTimestampParser.cs\t\n@@ -1,50 +1,160 @@\n // Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.\n // See the LICENCE file in the repository root for full licence text.\n \n using System;\n using System.Diagnostics.CodeAnalysis;\n using System.Text.RegularExpressions;\n \n namespace osu.Game.Rulesets.Edit\n {\n+    /// <summary>\n+    /// Parses editor timestamp strings into time spans and optional selection clauses.\n+    /// Supports multiple timestamp formats including full (mm:ss:mmm), abbreviated (mm:ss), and milliseconds-only.\n+    /// </summary>\n     public static class EditorTimestampParser\n     {\n-        // 00:00:000 (...) - test\n-        // original osu-web regex: https://github.com/ppy/osu-web/blob/3b1698639244cfdaf0b41c68bfd651ea729ec2e3/resources/js/utils/beatmapset-discussion-helper.ts#L78\n-        public static readonly Regex TIME_REGEX = new Regex(@\"\\b(((?<minutes>\\d{2,}):(?<seconds>[0-5]\\d)[:.](?<milliseconds>\\d{3}))(?<selection>\\s\\([^)]+\\))?)\", RegexOptions.Compiled);\n+        /// <summary>\n+        /// Regular expression matching various timestamp formats with optional selection clauses.\n+        /// Supports:\n+        /// - Full format: mm:ss:mmm or mm:ss.mmm (e.g., \"01:23:456\" or \"01:23.456\")\n+        /// - Abbreviated format: mm:ss (e.g., \"01:23\")\n+        /// - Milliseconds only: numeric value (e.g., \"12345\")\n+        /// - Optional selection clause in parentheses (e.g., \"01:23:456 (1,2,3)\")\n+        /// </summary>\n+        /// <remarks>\n+        /// Original osu-web regex: https://github.com/ppy/osu-web/blob/3b1698639244cfdaf0b41c68bfd651ea729ec2e3/resources/js/utils/beatmapset-discussion-helper.ts#L78\n+        /// </remarks>\n+        public static readonly Regex TIME_REGEX = new Regex(\n+            @\"\\b(?:\" +\n+            // Full format: mm:ss:mmm or mm:ss.mmm (minutes required, seconds and milliseconds optional)\n+            @\"(?<full>(?<minutes>\\d{1,}):(?<seconds>[0-5]?\\d)?[:.](?<milliseconds>\\d{1,3})?)|\" +\n+            // Abbreviated format: mm:ss (minutes and seconds required, no milliseconds)\n+            @\"(?<abbreviated>(?<abbrMinutes>\\d{1,}):(?<abbrSeconds>[0-5]?\\d))|\" +\n+            // Milliseconds only: pure number (1-10 digits)\n+            @\"(?<millisecondsOnly>\\d{1,10})\" +\n+            @\")\" +\n+            @\"(?<selection>\\s\\([^)]+\\))?\",\n+            RegexOptions.Compiled);\n \n+        /// <summary>\n+        /// Attempts to parse a timestamp string into a time span and optional selection clause.\n+        /// </summary>\n+        /// <param name=\"timestamp\">The timestamp string to parse.</param>\n+        /// <param name=\"parsedTime\">The parsed time span if successful, null otherwise.</param>\n+        /// <param name=\"parsedSelection\">The parsed selection clause (without parentheses) if present, null otherwise.</param>\n+        /// <returns>True if parsing was successful, false otherwise.</returns>\n+        /// <remarks>\n+        /// Accepts the following formats:\n+        /// - Full: \"mm:ss:mmm\" or \"mm:ss.mmm\" (e.g., \"01:23:456\")\n+        /// - Abbreviated: \"mm:ss\" (e.g., \"01:23\" meaning 1 minute 23 seconds)\n+        /// - Milliseconds only: numeric value (e.g., \"12345\" meaning 12.345 seconds)\n+        /// - With selection: Any of the above followed by \" (selection)\" (e.g., \"01:23:456 (1,2,3)\")\n+        /// \n+        /// Validates that minutes are less than 600 (10 hours), seconds are less than 60, and milliseconds are less than 1000.\n+        /// </remarks>\n         public static bool TryParse(string timestamp, [NotNullWhen(true)] out TimeSpan? parsedTime, out string? parsedSelection)\n         {\n             Match match = TIME_REGEX.Match(timestamp);\n \n             if (!match.Success)\n             {\n                 parsedTime = null;\n                 parsedSelection = null;\n                 return false;\n             }\n \n-            bool result = true;\n+            // Extract selection clause if present\n+            string selectionValue = match.Groups[@\"selection\"].Value;\n+            if (!string.IsNullOrEmpty(selectionValue))\n+            {\n+                parsedSelection = selectionValue.Trim()[1..^1];\n+            }\n+            else\n+            {\n+                parsedSelection = null;\n+            }\n \n-            result &= int.TryParse(match.Groups[@\"minutes\"].Value, out int timeMin);\n-            result &= int.TryParse(match.Groups[@\"seconds\"].Value, out int timeSec);\n-            result &= int.TryParse(match.Groups[@\"milliseconds\"].Value, out int timeMsec);\n+            // Try full format first (mm:ss:mmm or mm:ss.mmm)\n+            if (match.Groups[@\"full\"].Success)\n+            {\n+                int timeMin = 0;\n+                int timeSec = 0;\n+                int timeMsec = 0;\n \n-            // somewhat sane limit for timestamp duration (10 hours).\n-            result &= timeMin < 600;\n+                if (!string.IsNullOrEmpty(match.Groups[@\"minutes\"].Value))\n+                    timeMin = int.Parse(match.Groups[@\"minutes\"].Value);\n \n-            if (!result)\n+                if (!string.IsNullOrEmpty(match.Groups[@\"seconds\"].Value))\n+                    timeSec = int.Parse(match.Groups[@\"seconds\"].Value);\n+\n+                if (!string.IsNullOrEmpty(match.Groups[@\"milliseconds\"].Value))\n+                {\n+                    string msecStr = match.Groups[@\"milliseconds\"].Value;\n+                    // Pad or truncate to 3 digits for proper millisecond parsing\n+                    if (msecStr.Length > 3)\n+                        msecStr = msecStr.Substring(0, 3);\n+                    else if (msecStr.Length < 3)\n+                        msecStr = msecStr.PadRight(3, '0');\n+\n+                    timeMsec = int.Parse(msecStr);\n+                }\n+\n+                // Validate ranges\n+                if (timeMin >= 600 || timeSec >= 60 || timeMsec >= 1000)\n+                {\n+                    parsedTime = null;\n+                    return false;\n+                }\n+\n+                parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec) + TimeSpan.FromMilliseconds(timeMsec);\n+                return true;\n+            }\n+\n+            // Try abbreviated format (mm:ss)\n+            if (match.Groups[@\"abbreviated\"].Success)\n             {\n-                parsedTime = null;\n-                parsedSelection = null;\n-                return false;\n+                int timeMin = 0;\n+                int timeSec = 0;\n+\n+                if (!string.IsNullOrEmpty(match.Groups[@\"abbrMinutes\"].Value))\n+                    timeMin = int.Parse(match.Groups[@\"abbrMinutes\"].Value);\n+\n+                if (!string.IsNullOrEmpty(match.Groups[@\"abbrSeconds\"].Value))\n+                    timeSec = int.Parse(match.Groups[@\"abbrSeconds\"].Value);\n+\n+                // Validate ranges\n+                if (timeMin >= 600 || timeSec >= 60)\n+                {\n+                    parsedTime = null;\n+                    return false;\n+                }\n+\n+                parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec);\n+                return true;\n             }\n \n-            parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec) + TimeSpan.FromMilliseconds(timeMsec);\n-            parsedSelection = match.Groups[@\"selection\"].Value.Trim();\n-            if (!string.IsNullOrEmpty(parsedSelection))\n-                parsedSelection = parsedSelection[1..^1];\n-            return true;\n+            // Try milliseconds only format\n+            if (match.Groups[@\"millisecondsOnly\"].Success)\n+            {\n+                if (!int.TryParse(match.Groups[@\"millisecondsOnly\"].Value, out int milliseconds))\n+                {\n+                    parsedTime = null;\n+                    return false;\n+                }\n+\n+                // Validate reasonable range (up to 10 hours in milliseconds)\n+                if (milliseconds < 0 || milliseconds >= 36000000)\n+                {\n+                    parsedTime = null;\n+                    return false;\n+                }\n+\n+                parsedTime = TimeSpan.FromMilliseconds(milliseconds);\n+                return true;\n+            }\n+\n+            parsedTime = null;\n+            return false;\n         }\n     }\n }\n",
