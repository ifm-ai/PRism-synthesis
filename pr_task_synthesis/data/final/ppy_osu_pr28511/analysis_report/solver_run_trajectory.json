            "output": "<path>/workspace/osu.Game/Rulesets/Edit/EditorTimestampParser.cs</path>\n<type>file</type>\n<content>\n1: // Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.\n2: // See the LICENCE file in the repository root for full licence text.\n3: \n4: using System;\n5: using System.Diagnostics.CodeAnalysis;\n6: using System.Text.RegularExpressions;\n7: \n8: namespace osu.Game.Rulesets.Edit\n9: {\n10:     public static class EditorTimestampParser\n11:     {\n12:         // Matches various timestamp formats with optional selection clause:\n13:         // - mm:ss:mmm (...) - full format with minutes, seconds, milliseconds\n14:         // - mm:ss (...) - abbreviated format with minutes and seconds\n15:         // - mmmmm - milliseconds only\n16:         // original osu-web regex: https://github.com/ppy/osu-web/blob/3b1698639244cfdaf0b41c68bfd651ea729ec2e3/resources/js/utils/beatmapset-discussion-helper.ts#L78\n17:         public static readonly Regex TIME_REGEX = new Regex(\n18:             @\"\\b(?:\" +\n19:             // Full format: mm:ss:mmm or mm:ss.mmm\n20:             @\"(?<full>(?<minutes>\\d{1,}):(?<seconds>[0-5]?\\d)?[:.](?<milliseconds>\\d{1,3})?)|\" +\n21:             // Abbreviated format: mm:ss\n22:             @\"(?<abbreviated>(?<abbrMinutes>\\d{1,}):(?<abbrSeconds>[0-5]?\\d))|\" +\n23:             // Milliseconds only\n24:             @\"(?<millisecondsOnly>\\d{1,10})\" +\n25:             @\")\" +\n26:             @\"(?<selection>\\s\\([^)]+\\))?\",\n27:             RegexOptions.Compiled);\n28: \n29:         public static bool TryParse(string timestamp, [NotNullWhen(true)] out TimeSpan? parsedTime, out string? parsedSelection)\n30:         {\n31:             Match match = TIME_REGEX.Match(timestamp);\n32: \n33:             if (!match.Success)\n34:             {\n35:                 parsedTime = null;\n36:                 parsedSelection = null;\n37:                 return false;\n38:             }\n39: \n40:             // Extract selection clause if present\n41:             string selectionValue = match.Groups[@\"selection\"].Value;\n42:             if (!string.IsNullOrEmpty(selectionValue))\n43:             {\n44:                 parsedSelection = selectionValue.Trim()[1..^1];\n45:             }\n46:             else\n47:             {\n48:                 parsedSelection = null;\n49:             }\n50: \n51:             // Try full format first (mm:ss:mmm or mm:ss.mmm)\n52:             if (match.Groups[@\"full\"].Success)\n53:             {\n54:                 int timeMin = 0;\n55:                 int timeSec = 0;\n56:                 int timeMsec = 0;\n57: \n58:                 if (!string.IsNullOrEmpty(match.Groups[@\"minutes\"].Value))\n59:                     timeMin = int.Parse(match.Groups[@\"minutes\"].Value);\n60: \n61:                 if (!string.IsNullOrEmpty(match.Groups[@\"seconds\"].Value))\n62:                     timeSec = int.Parse(match.Groups[@\"seconds\"].Value);\n63: \n64:                 if (!string.IsNullOrEmpty(match.Groups[@\"milliseconds\"].Value))\n65:                 {\n66:                     string msecStr = match.Groups[@\"milliseconds\"].Value;\n67:                     // Pad or truncate to 3 digits for proper millisecond parsing\n68:                     if (msecStr.Length > 3)\n69:                         msecStr = msecStr.Substring(0, 3);\n70:                     else if (msecStr.Length < 3)\n71:                         msecStr = msecStr.PadRight(3, '0');\n72: \n73:                     timeMsec = int.Parse(msecStr);\n74:                 }\n75: \n76:                 // Validate ranges\n77:                 if (timeMin >= 600 || timeSec >= 60 || timeMsec >= 1000)\n78:                 {\n79:                     parsedTime = null;\n80:                     return false;\n81:                 }\n82: \n83:                 parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec) + TimeSpan.FromMilliseconds(timeMsec);\n84:                 return true;\n85:             }\n86: \n87:             // Try abbreviated format (mm:ss)\n88:             if (match.Groups[@\"abbreviated\"].Success)\n89:             {\n90:                 int timeMin = 0;\n91:                 int timeSec = 0;\n92: \n93:                 if (!string.IsNullOrEmpty(match.Groups[@\"abbrMinutes\"].Value))\n94:                     timeMin = int.Parse(match.Groups[@\"abbrMinutes\"].Value);\n95: \n96:                 if (!string.IsNullOrEmpty(match.Groups[@\"abbrSeconds\"].Value))\n97:                     timeSec = int.Parse(match.Groups[@\"abbrSeconds\"].Value);\n98: \n99:                 // Validate ranges\n100:                 if (timeMin >= 600 || timeSec >= 60)\n101:                 {\n102:                     parsedTime = null;\n103:                     return false;\n104:                 }\n105: \n106:                 parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec);\n107:                 return true;\n108:             }\n109: \n110:             // Try milliseconds only format\n111:             if (match.Groups[@\"millisecondsOnly\"].Success)\n112:             {\n113:                 if (!int.TryParse(match.Groups[@\"millisecondsOnly\"].Value, out int milliseconds))\n114:                 {\n115:                     parsedTime = null;\n116:                     return false;\n117:                 }\n118: \n119:                 // Validate reasonable range (up to 10 hours in milliseconds)\n120:                 if (milliseconds < 0 || milliseconds >= 36000000)\n121:                 {\n122:                     parsedTime = null;\n123:                     return false;\n124:                 }\n125: \n126:                 parsedTime = TimeSpan.FromMilliseconds(milliseconds);\n127:                 return true;\n128:             }\n129: \n130:             parsedTime = null;\n131:             return false;\n132:         }\n133:     }\n134: }\n\n(End of file - total 134 lines)\n</content>",
