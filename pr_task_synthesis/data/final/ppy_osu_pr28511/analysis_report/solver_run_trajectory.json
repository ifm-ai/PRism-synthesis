          "callID": "call_b4fd18362640426b9adc8372",
          "state": {
            "status": "completed",
            "input": {
              "filePath": "/workspace/osu.Game.Tests/Rulesets/Edit/EditorTimestampParserTest.cs",
              "content": "// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.\n// See the LICENCE file in the repository root for full licence text.\n\nusing System;\nusing NUnit.Framework;\nusing osu.Game.Rulesets.Edit;\n\nnamespace osu.Game.Tests.Rulesets.Edit\n{\n    [TestFixture]\n    public class EditorTimestampParserTest\n    {\n        [TestCase(\"00:00:000\", 0, 0, 0)]\n        [TestCase(\"00:00:001\", 0, 0, 1)]\n        [TestCase(\"00:01:000\", 0, 1, 0)]\n        [TestCase(\"01:00:000\", 1, 0, 0)]\n        [TestCase(\"10:44:500\", 10, 44, 500)]\n        [TestCase(\"99:59:999\", 99, 59, 999)]\n        [TestCase(\"00:00.000\", 0, 0, 0)]\n        [TestCase(\"00:01.500\", 0, 1, 500)]\n        [TestCase(\"1:2:3\", 1, 2, 300)]\n        [TestCase(\"1:2:30\", 1, 2, 30)]\n        [TestCase(\"1:2:300\", 1, 2, 300)]\n        [TestCase(\"0:0:0\", 0, 0, 0)]\n        public void TestFullFormatTimestamps(string timestamp, int expectedMinutes, int expectedSeconds, int expectedMilliseconds)\n        {\n            Assert.That(EditorTimestampParser.TryParse(timestamp, out var timeSpan, out var selection), Is.True);\n            Assert.That(timeSpan, Is.Not.Null);\n            Assert.That(timeSpan.Value.Minutes, Is.EqualTo(expectedMinutes));\n            Assert.That(timeSpan.Value.Seconds, Is.EqualTo(expectedSeconds));\n            Assert.That(timeSpan.Value.Milliseconds, Is.EqualTo(expectedMilliseconds));\n            Assert.That(selection, Is.Null);\n        }\n\n        [TestCase(\"00:00\", 0, 0)]\n        [TestCase(\"00:01\", 0, 1)]\n        [TestCase(\"01:00\", 1, 0)]\n        [TestCase(\"10:44\", 10, 44)]\n        [TestCase(\"99:59\", 99, 59)]\n        [TestCase(\"0:0\", 0, 0)]\n        [TestCase(\"5:30\", 5, 30)]\n        [TestCase(\"1:5\", 1, 5)]\n        public void TestAbbreviatedFormatTimestamps(string timestamp, int expectedMinutes, int expectedSeconds)\n        {\n            Assert.That(EditorTimestampParser.TryParse(timestamp, out var timeSpan, out var selection), Is.True);\n            Assert.That(timeSpan, Is.Not.Null);\n            Assert.That(timeSpan.Value.Minutes, Is.EqualTo(expectedMinutes));\n            Assert.That(timeSpan.Value.Seconds, Is.EqualTo(expectedSeconds));\n            Assert.That(timeSpan.Value.Milliseconds, Is.EqualTo(0));\n            Assert.That(selection, Is.Null);\n        }\n\n        [TestCase(\"0\", 0)]\n        [TestCase(\"1\", 1)]\n        [TestCase(\"1000\", 1000)]\n        [TestCase(\"12345\", 12345)]\n        [TestCase(\"1234567\", 1234567)]\n        [TestCase(\"50000\", 50000)]\n        [TestCase(\"3600000\", 3600000)]\n        public void TestMillisecondsOnlyFormatTimestamps(string timestamp, int expectedMilliseconds)\n        {\n            Assert.That(EditorTimestampParser.TryParse(timestamp, out var timeSpan, out var selection), Is.True);\n            Assert.That(timeSpan, Is.Not.Null);\n            Assert.That(timeSpan.Value.TotalMilliseconds, Is.EqualTo(expectedMilliseconds));\n            Assert.That(selection, Is.Null);\n        }\n\n        [TestCase(\"00:00:000 (1)\", 0, 0, 0, \"1\")]\n        [TestCase(\"00:01:500 (1,2,3)\", 0, 1, 500, \"1,2,3\")]\n        [TestCase(\"10:44:500 (test)\", 10, 44, 500, \"test\")]\n        [TestCase(\"00:30:000 (0|0)\", 0, 30, 0, \"0|0\")]\n        [TestCase(\"01:00:000 (combo 1)\", 1, 0, 0, \"combo 1\")]\n        [TestCase(\"5:30 (selection)\", 5, 30, 0, \"selection\")]\n        [TestCase(\"0:0 (a)\", 0, 0, 0, \"a\")]\n        [TestCase(\"5000 (test)\", 5000, 0, 0, \"test\")]\n        public void TestTimestampsWithSelectionClause(string timestamp, int expectedMinutes, int expectedSeconds, int expectedMilliseconds, string expectedSelection)\n        {\n            Assert.That(EditorTimestampParser.TryParse(timestamp, out var timeSpan, out var selection), Is.True);\n            Assert.That(timeSpan, Is.Not.Null);\n            Assert.That(timeSpan.Value.Minutes, Is.EqualTo(expectedMinutes));\n            Assert.That(timeSpan.Value.Seconds, Is.EqualTo(expectedSeconds));\n            Assert.That(timeSpan.Value.Milliseconds, Is.EqualTo(expectedMilliseconds));\n            Assert.That(selection, Is.EqualTo(expectedSelection));\n        }\n\n        [TestCase(\"\")]\n        [TestCase(\"invalid\")]\n        [TestCase(\":00:000\")]\n        [TestCase(\"00::000\")]\n        [TestCase(\"00:00:\")]\n        [TestCase(\"abc:def:ghi\")]\n        [TestCase(\"00:60:000\")]\n        [TestCase(\"00:00:1000\")]\n        [TestCase(\"600:00:000\")]\n        [TestCase(\"abc\")]\n        [TestCase(\"::\")]\n        public void TestInvalidTimestamps(string timestamp)\n        {\n            Assert.That(EditorTimestampParser.TryParse(timestamp, out var timeSpan, out var selection), Is.False);\n            Assert.That(timeSpan, Is.Null);\n            Assert.That(selection, Is.Null);\n        }\n\n        [TestCase(\"599:59:999\")]\n        [TestCase(\"0:59:999\")]\n        [TestCase(\"0:0:999\")]\n        [TestCase(\"123:45:678\")]\n        public void TestValidEdgeCaseTimestamps(string timestamp)\n        {\n            Assert.That(EditorTimestampParser.TryParse(timestamp, out var timeSpan, out var selection), Is.True);\n            Assert.That(timeSpan, Is.Not.Null);\n            Assert.That(selection, Is.Null);\n        }\n\n        [Test]\n        public void TestRegexExposure()\n        {\n            Assert.That(EditorTimestampParser.TIME_REGEX, Is.Not.Null);\n            Assert.That(EditorTimestampParser.TIME_REGEX.IsMatch(\"00:00:000\"), Is.True);\n            Assert.That(EditorTimestampParser.TIME_REGEX.IsMatch(\"00:00\"), Is.True);\n            Assert.That(EditorTimestampParser.TIME_REGEX.IsMatch(\"12345\"), Is.True);\n            Assert.That(EditorTimestampParser.TIME_REGEX.IsMatch(\"invalid\"), Is.False);\n        }\n    }\n}\n"
