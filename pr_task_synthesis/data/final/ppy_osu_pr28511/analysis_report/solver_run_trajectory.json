            "output": "<path>/workspace/osu.Game/Rulesets/Edit/EditorTimestampParser.cs</path>\n<type>file</type>\n<content>\n1: // Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.\n2: // See the LICENCE file in the repository root for full licence text.\n3: \n4: using System;\n5: using System.Diagnostics.CodeAnalysis;\n6: using System.Text.RegularExpressions;\n7: \n8: namespace osu.Game.Rulesets.Edit\n9: {\n10:         /// <summary>\n11:         /// Parses editor timestamp strings into time spans and optional selection clauses.\n12:         /// Supports multiple timestamp formats including full (mm:ss:mmm), abbreviated (mm:ss), and milliseconds-only.\n13:         /// </summary>\n14:         public static class EditorTimestampParser\n15:     {\n16:         /// <summary>\n17:         /// Regular expression matching various timestamp formats with optional selection clauses.\n18:         /// Supports:\n19:         /// - Full format: mm:ss:mmm or mm:ss.mmm (e.g., \"01:23:456\" or \"01:23.456\")\n20:         /// - Abbreviated format: mm:ss (e.g., \"01:23\")\n21:         /// - Milliseconds only: numeric value (e.g., \"12345\")\n22:         /// - Optional selection clause in parentheses (e.g., \"01:23:456 (1,2,3)\")\n23:         /// </summary>\n24:         /// <remarks>\n25:         /// Original osu-web regex: https://github.com/ppy/osu-web/blob/3b1698639244cfdaf0b41c68bfd651ea729ec2e3/resources/js/utils/beatmapset-discussion-helper.ts#L78\n26:         /// </remarks>\n27:         public static readonly Regex TIME_REGEX = new Regex(\n28:             @\"\\b(?:\" +\n29:             // Full format: mm:ss:mmm or mm:ss.mmm (minutes required, seconds and milliseconds optional)\n30:             @\"(?<full>(?<minutes>\\d{1,}):(?<seconds>[0-5]?\\d)?[:.](?<milliseconds>\\d{1,3})?)|\" +\n31:             // Abbreviated format: mm:ss (minutes and seconds required, no milliseconds)\n32:             @\"(?<abbreviated>(?<abbrMinutes>\\d{1,}):(?<abbrSeconds>[0-5]?\\d))|\" +\n33:             // Milliseconds only: pure number (1-10 digits)\n34:             @\"(?<millisecondsOnly>\\d{1,10})\" +\n35:             @\")\" +\n36:             @\"(?<selection>\\s\\([^)]+\\))?\",\n37:             RegexOptions.Compiled);\n38: \n39:         /// <summary>\n40:         /// Attempts to parse a timestamp string into a time span and optional selection clause.\n41:         /// </summary>\n42:         /// <param name=\"timestamp\">The timestamp string to parse.</param>\n43:         /// <param name=\"parsedTime\">The parsed time span if successful, null otherwise.</param>\n44:         /// <param name=\"parsedSelection\">The parsed selection clause (without parentheses) if present, null otherwise.</param>\n45:         /// <returns>True if parsing was successful, false otherwise.</returns>\n46:         /// <remarks>\n47:         /// Accepts the following formats:\n48:         /// - Full: \"mm:ss:mmm\" or \"mm:ss.mmm\" (e.g., \"01:23:456\")\n49:         /// - Abbreviated: \"mm:ss\" (e.g., \"01:23\" meaning 1 minute 23 seconds)\n50:         /// - Milliseconds only: numeric value (e.g., \"12345\" meaning 12.345 seconds)\n51:         /// - With selection: Any of the above followed by \" (selection)\" (e.g., \"01:23:456 (1,2,3)\")\n52:         /// \n53:         /// Validates that minutes are less than 600 (10 hours), seconds are less than 60, and milliseconds are less than 1000.\n54:         /// </remarks>\n55:         public static bool TryParse(string timestamp, [NotNullWhen(true)] out TimeSpan? parsedTime, out string? parsedSelection)\n56:         {\n57:             Match match = TIME_REGEX.Match(timestamp);\n58: \n59:             if (!match.Success)\n60:             {\n61:                 parsedTime = null;\n62:                 parsedSelection = null;\n63:                 return false;\n64:             }\n65: \n66:             // Extract selection clause if present\n67:             string selectionValue = match.Groups[@\"selection\"].Value;\n68:             if (!string.IsNullOrEmpty(selectionValue))\n69:             {\n70:                 parsedSelection = selectionValue.Trim()[1..^1];\n71:             }\n72:             else\n73:             {\n74:                 parsedSelection = null;\n75:             }\n76: \n77:             // Try full format first (mm:ss:mmm or mm:ss.mmm)\n78:             if (match.Groups[@\"full\"].Success)\n79:             {\n80:                 int timeMin = 0;\n81:                 int timeSec = 0;\n82:                 int timeMsec = 0;\n83: \n84:                 if (!string.IsNullOrEmpty(match.Groups[@\"minutes\"].Value))\n85:                     timeMin = int.Parse(match.Groups[@\"minutes\"].Value);\n86: \n87:                 if (!string.IsNullOrEmpty(match.Groups[@\"seconds\"].Value))\n88:                     timeSec = int.Parse(match.Groups[@\"seconds\"].Value);\n89: \n90:                 if (!string.IsNullOrEmpty(match.Groups[@\"milliseconds\"].Value))\n91:                 {\n92:                     string msecStr = match.Groups[@\"milliseconds\"].Value;\n93:                     // Pad or truncate to 3 digits for proper millisecond parsing\n94:                     if (msecStr.Length > 3)\n95:                         msecStr = msecStr.Substring(0, 3);\n96:                     else if (msecStr.Length < 3)\n97:                         msecStr = msecStr.PadRight(3, '0');\n98: \n99:                     timeMsec = int.Parse(msecStr);\n100:                 }\n101: \n102:                 // Validate ranges\n103:                 if (timeMin >= 600 || timeSec >= 60 || timeMsec >= 1000)\n104:                 {\n105:                     parsedTime = null;\n106:                     return false;\n107:                 }\n108: \n109:                 parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec) + TimeSpan.FromMilliseconds(timeMsec);\n110:                 return true;\n111:             }\n112: \n113:             // Try abbreviated format (mm:ss)\n114:             if (match.Groups[@\"abbreviated\"].Success)\n115:             {\n116:                 int timeMin = 0;\n117:                 int timeSec = 0;\n118: \n119:                 if (!string.IsNullOrEmpty(match.Groups[@\"abbrMinutes\"].Value))\n120:                     timeMin = int.Parse(match.Groups[@\"abbrMinutes\"].Value);\n121: \n122:                 if (!string.IsNullOrEmpty(match.Groups[@\"abbrSeconds\"].Value))\n123:                     timeSec = int.Parse(match.Groups[@\"abbrSeconds\"].Value);\n124: \n125:                 // Validate ranges\n126:                 if (timeMin >= 600 || timeSec >= 60)\n127:                 {\n128:                     parsedTime = null;\n129:                     return false;\n130:                 }\n131: \n132:                 parsedTime = TimeSpan.FromMinutes(timeMin) + TimeSpan.FromSeconds(timeSec);\n133:                 return true;\n134:             }\n135: \n136:             // Try milliseconds only format\n137:             if (match.Groups[@\"millisecondsOnly\"].Success)\n138:             {\n139:                 if (!int.TryParse(match.Groups[@\"millisecondsOnly\"].Value, out int milliseconds))\n140:                 {\n141:                     parsedTime = null;\n142:                     return false;\n143:                 }\n144: \n145:                 // Validate reasonable range (up to 10 hours in milliseconds)\n146:                 if (milliseconds < 0 || milliseconds >= 36000000)\n147:                 {\n148:                     parsedTime = null;\n149:                     return false;\n150:                 }\n151: \n152:                 parsedTime = TimeSpan.FromMilliseconds(milliseconds);\n153:                 return true;\n154:             }\n155: \n156:             parsedTime = null;\n157:             return false;\n158:         }\n159:     }\n160: }\n\n(End of file - total 160 lines)\n</content>",
