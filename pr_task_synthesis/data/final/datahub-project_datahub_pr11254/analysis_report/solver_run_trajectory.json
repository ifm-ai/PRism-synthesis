448:     @classmethod\n449:     def create(cls, config_dict: dict, ctx: PipelineContext) -> Self:\n450:         config = SnowflakeQueriesSourceConfig.parse_obj(config_dict)\n451:         return cls(ctx, config)\n452: \n453:     def get_workunits_internal(self) -> Iterable[MetadataWorkUnit]:\n454:         self.report.window = self.config.window\n455: \n456:         # TODO: Disable auto status processor?\n457:         return self.queries_extractor.get_workunits_internal()\n458: \n459:     def get_report(self) -> SnowflakeQueriesSourceReport:\n460:         return self.report\n461: \n462: \n463: # Make sure we don't try to generate too much info for a single query.\n464: _MAX_TABLES_PER_QUERY = 20\n465: \n466: \n467: def _build_enriched_query_log_query(\n468:     start_time: datetime,\n469:     end_time: datetime,\n470:     bucket_duration: BucketDuration,\n471:     deny_usernames: Optional[List[str]],\n472: ) -> str:\n473:     start_time_millis = int(start_time.timestamp() * 1000)\n474:     end_time_millis = int(end_time.timestamp() * 1000)\n475: \n476:     users_filter = \"\"\n477:     if deny_usernames:\n478:         user_not_in = \",\".join(f\"'{user.upper()}'\" for user in deny_usernames)\n479:         users_filter = f\"user_name NOT IN ({user_not_in})\"\n480: \n481:     time_bucket_size = bucket_duration.value\n482:     assert time_bucket_size in (\"HOUR\", \"DAY\", \"MONTH\")\n483: \n484:     return f\"\"\"\\\n485: WITH\n486: fingerprinted_queries as (\n487:     SELECT *,\n488:         -- TODO: Generate better fingerprints for each query by pushing down regex logic.\n489:         query_history.query_parameterized_hash as query_fingerprint\n490:     FROM\n491:         snowflake.account_usage.query_history\n492:     WHERE\n493:         query_history.start_time >= to_timestamp_ltz({start_time_millis}, 3)\n494:         AND query_history.start_time < to_timestamp_ltz({end_time_millis}, 3)\n495:         AND execution_status = 'SUCCESS'\n496:         AND {users_filter or 'TRUE'}\n497: )\n498: , deduplicated_queries as (\n499:     SELECT\n500:         *,\n501:         DATE_TRUNC(\n502:             {time_bucket_size},\n503:             CONVERT_TIMEZONE('UTC', start_time)\n504:         ) AS bucket_start_time,\n505:         COUNT(*) OVER (PARTITION BY bucket_start_time, query_fingerprint) AS query_count,\n506:     FROM\n507:         fingerprinted_queries\n508:     QUALIFY\n509:         ROW_NUMBER() OVER (PARTITION BY bucket_start_time, query_fingerprint ORDER BY start_time DESC) = 1\n510: )\n511: , raw_access_history AS (\n512:     SELECT\n513:         query_id,\n514:         query_start_time,\n515:         user_name,\n516:         direct_objects_accessed,\n517:         objects_modified,\n518:     FROM\n519:         snowflake.account_usage.access_history\n520:     WHERE\n521:         query_start_time >= to_timestamp_ltz({start_time_millis}, 3)\n522:         AND query_start_time < to_timestamp_ltz({end_time_millis}, 3)\n523:         AND {users_filter or 'TRUE'}\n524:         AND query_id IN (\n525:             SELECT query_id FROM deduplicated_queries\n526:         )\n527: )\n528: , filtered_access_history AS (\n529:     -- TODO: Add table filter clause.\n530:     SELECT\n531:         query_id,\n532:         query_start_time,\n533:         ARRAY_SLICE(\n534:             FILTER(direct_objects_accessed, o -> o:objectDomain IN {SnowflakeQuery.ACCESS_HISTORY_TABLE_VIEW_DOMAINS_FILTER}),\n535:             0, {_MAX_TABLES_PER_QUERY}\n536:         ) as direct_objects_accessed,\n537:         -- TODO: Drop the columns.baseSources subfield.\n538:         FILTER(objects_modified, o -> o:objectDomain IN {SnowflakeQuery.ACCESS_HISTORY_TABLE_VIEW_DOMAINS_FILTER}) as objects_modified,\n539:     FROM raw_access_history\n540:     WHERE ( array_size(direct_objects_accessed) > 0 or array_size(objects_modified) > 0 )\n541: )\n542: , query_access_history AS (\n543:     SELECT\n544:         q.bucket_start_time,\n545:         q.query_id,\n546:         q.query_fingerprint,\n547:         q.query_count,\n548:         q.session_id AS \"SESSION_ID\",\n549:         q.start_time AS \"QUERY_START_TIME\",\n550:         q.total_elapsed_time AS \"QUERY_DURATION\",\n551:         q.query_text AS \"QUERY_TEXT\",\n552:         q.query_type AS \"QUERY_TYPE\",\n553:         q.database_name as \"DEFAULT_DB\",\n554:         q.schema_name as \"DEFAULT_SCHEMA\",\n555:         q.rows_inserted AS \"ROWS_INSERTED\",\n556:         q.rows_updated AS \"ROWS_UPDATED\",\n557:         q.rows_deleted AS \"ROWS_DELETED\",\n558:         q.user_name AS \"USER_NAME\",\n559:         q.role_name AS \"ROLE_NAME\",\n560:         a.direct_objects_accessed,\n561:         a.objects_modified,\n562:     FROM deduplicated_queries q\n563:     JOIN filtered_access_history a USING (query_id)\n564: )\n565: SELECT * FROM query_access_history\n566: \"\"\"\n567: \n568: \n569: SNOWFLAKE_QUERY_TYPE_MAPPING = {\n570:     \"INSERT\": QueryType.INSERT,\n571:     \"UPDATE\": QueryType.UPDATE,\n572:     \"DELETE\": QueryType.DELETE,\n573:     \"CREATE\": QueryType.CREATE_OTHER,\n574:     \"CREATE_TABLE\": QueryType.CREATE_DDL,\n575:     \"CREATE_VIEW\": QueryType.CREATE_VIEW,\n576:     \"CREATE_TABLE_AS_SELECT\": QueryType.CREATE_TABLE_AS_SELECT,\n577:     \"MERGE\": QueryType.MERGE,\n578:     \"COPY\": QueryType.UNKNOWN,\n579:     \"TRUNCATE_TABLE\": QueryType.UNKNOWN,\n580: }\n\n(End of file - total 580 lines)\n</content>",
