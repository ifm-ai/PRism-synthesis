2Report\n51: from datahub.ingestion.source.snowflake.snowflake_schema import (\n52:     SnowflakeDataDictionary,\n53:     SnowflakeQuery,\n54: )\n55: from datahub.ingestion.source.snowflake.snowflake_schema_gen import (\n56:     SnowflakeSchemaGenerator,\n57: )\n58: from datahub.ingestion.source.snowflake.snowflake_shares import SnowflakeSharesHandler\n59: from datahub.ingestion.source.snowflake.snowflake_usage_v2 import (\n60:     SnowflakeUsageExtractor,\n61: )\n62: from datahub.ingestion.source.snowflake.snowflake_utils import (\n63:     SnowflakeCommonMixin,\n64:     SnowflakeFilter,\n65:     SnowflakeIdentifierBuilder,\n66:     SnowsightUrlBuilder,\n67: )\n68: from datahub.ingestion.source.state.profiling_state_handler import ProfilingHandler\n69: from datahub.ingestion.source.state.redundant_run_skip_handler import (\n70:     RedundantLineageRunSkipHandler,\n71:     RedundantUsageRunSkipHandler,\n72: )\n73: from datahub.ingestion.source.state.stale_entity_removal_handler import (\n74:     StaleEntityRemovalHandler,\n75: )\n76: from datahub.ingestion.source.state.stateful_ingestion_base import (\n77:     StatefulIngestionSourceBase,\n78: )\n79: from datahub.ingestion.source_report.ingestion_stage import (\n80:     LINEAGE_EXTRACTION,\n81:     METADATA_EXTRACTION,\n82:     QUERIES_EXTRACTION,\n83: )\n84: from datahub.sql_parsing.sql_parsing_aggregator import SqlParsingAggregator\n85: from datahub.utilities.registries.domain_registry import DomainRegistry\n86: \n87: logger: logging.Logger = logging.getLogger(__name__)\n88: \n89: \n90: @platform_name(\"Snowflake\", doc_order=1)\n91: @config_class(SnowflakeV2Config)\n92: @support_status(SupportStatus.CERTIFIED)\n93: @capability(SourceCapability.PLATFORM_INSTANCE, \"Enabled by default\")\n94: @capability(SourceCapability.DOMAINS, \"Supported via the `domain` config field\")\n95: @capability(SourceCapability.CONTAINERS, \"Enabled by default\")\n96: @capability(SourceCapability.SCHEMA_METADATA, \"Enabled by default\")\n97: @capability(\n98:     SourceCapability.DATA_PROFILING,\n99:     \"Optionally enabled via configuration `profiling.enabled`\",\n100: )\n101: @capability(SourceCapability.DESCRIPTIONS, \"Enabled by default\")\n102: @capability(\n103:     SourceCapability.LINEAGE_COARSE,\n104:     \"Enabled by default, can be disabled via configuration `include_table_lineage` and `include_view_lineage`\",\n105: )\n106: @capability(\n107:     SourceCapability.LINEAGE_FINE,\n108:     \"Enabled by default, can be disabled via configuration `include_column_lineage`\",\n109: )\n110: @capability(\n111:     SourceCapability.USAGE_STATS,\n112:     \"Enabled by default, can be disabled via configuration `include_usage_stats`\",\n113: )\n114: @capability(\n115:     SourceCapability.DELETION_DETECTION,\n116:     \"Optionally enabled via `stateful_ingestion.remove_stale_metadata`\",\n117:     supported=True,\n118: )\n119: @capability(\n120:     SourceCapability.TAGS,\n121:     \"Optionally enabled via `extract_tags`\",\n122:     supported=True,\n123: )\n124: @capability(\n125:     SourceCapability.CLASSIFICATION,\n126:     \"Optionally enabled via `classification.enabled`\",\n127:     supported=True,\n128: )\n129: class SnowflakeV2Source(\n130:     SnowflakeCommonMixin,\n131:     StatefulIngestionSourceBase,\n132:     TestableSource,\n133: ):\n134:     def __init__(self, ctx: PipelineContext, config: SnowflakeV2Config):\n135:         super().__init__(config, ctx)\n136:         self.config: SnowflakeV2Config = config\n137:         self.report: SnowflakeV2Report = SnowflakeV2Report()\n138: \n139:         self.filters = SnowflakeFilter(\n140:             filter_config=self.config, structured_reporter=self.report\n141:         )\n142:         self.identifiers = SnowflakeIdentifierBuilder(\n143:             identifier_config=self.config, structured_reporter=self.report\n144:         )\n145: \n146:         self.domain_registry: Optional[DomainRegistry] = None\n147:         if self.config.domain:\n148:             self.domain_registry = DomainRegistry(\n149:                 cached_domains=[k for k in self.config.domain], graph=self.ctx.graph\n150:             )\n151: \n152:         self.connection = self.config.get_connection()\n153: \n154:         # For database, schema, tables, views, etc\n155:         self.data_dictionary = SnowflakeDataDictionary(connection=self.connection)\n156:         self.lineage_extractor: Optional[SnowflakeLineageExtractor] = None\n157:         self.aggregator: Optional[SqlParsingAggregator] = None\n158: \n159:         if self.config.use_queries_v2 or self.config.include_table_lineage:\n160:             self.aggregator = SqlParsingAggregator(\n161:                 platform=self.identifiers.platform,\n162:                 platform_instance=self.config.platform_instance,\n163:                 env=self.config.env,\n164:                 graph=self.ctx.graph,\n165:                 eager_graph_load=(\n166:                     # If we're ingestion schema metadata for tables/views, then we will populate\n167:                     # schemas into the resolver as we go. We only need to do a bulk fetch\n168:                     # if we're not ingesting schema metadata as part of ingestion.\n169:                     (\n170:                         self.config.include_technical_schema\n171:                         and self.config.include_tables\n172:                         and self.config.include_views\n173:                     )\n174:                     and not self.config.lazy_schema_resolver\n175:                 ),\n176:                 generate_usage_statistics=False,\n177:                 generate_operations=False,\n178:                 format_queries=self.config.format_sql_queries,\n179:             )\n180:             self.report.sql_aggregator = self.aggregator.report\n181: \n182:         if self.config.include_table_lineage:\n183:             assert self.aggregator is not None\n184:             redundant_lineage_run_skip_handler: Optional[\n185:                 RedundantLineageRunSkipHandler\n186:             ] = None\n187:             if self.config.enable_stateful_lineage_ingestion:\n188:                 redundant_lineage_run_skip_handler = RedundantLineageRunSkipHandler(\n189:                     source=self,\n190:                     config=self.config,\n191:                     pipeline_name=self.ctx.pipeline_name,\n192:                     run_id=self.ctx.run_id,\n193:                 )\n194:             self.lineage_extractor = SnowflakeLineageExtractor(\n195:                 config,\n196:                 self.report,\n197:                 connection=self.connection,\n198:                 filters=self.filters,\n199:                 identifiers=self.identifiers,\n200:                 redundant_run_skip_handler=redundant_lineage_run_skip_handler,\n201:                 sql_aggregator=self.aggregator,\n202:             )\n203: \n204:         self.usage_extractor: Optional[SnowflakeUsageExtractor] = None\n205:         if self.config.include_usage_stats or self.config.include_operational_stats:\n206:             redundant_usage_run_skip_handler: Optional[\n207:                 RedundantUsageRunSkipHandler\n208:             ] = None\n209:             if self.config.enable_stateful_usage_ingestion:\n210:                 redundant_usage_run_skip_handler = RedundantUsageRunSkipHandler(\n211:                     source=self,\n212:                     config=self.config,\n213:                     pipeline_name=self.ctx.pipeline_name,\n214:                     run_id=self.ctx.run_id,\n215:                 )\n216:             self.usage_extractor = SnowflakeUsageExtractor(\n217:                 config,\n218:                 self.report,\n219:                 connection=self.connection,\n220:                 filter=self.filters,\n221:                 identifiers=self.identifiers,\n222:                 redundant_run_skip_handler=redundant_usage_run_skip_handler,\n223:             )\n224: \n225:         self.profiling_state_handler: Optional[ProfilingHandler] = None\n226:         if self.config.enable_stateful_profiling:\n227:             self.profiling_state_handler = ProfilingHandler(\n228:                 source=self,\n229:                 config=self.config,\n230:                 pipeline_name=self.ctx.pipeline_name,\n231:                 run_id=self.ctx.run_id,\n232:             )\n233: \n234:         # For profiling\n235:         self.profiler: Optional[SnowflakeProfiler] = None\n236:         if config.is_profiling_enabled():\n237:             self.profiler = SnowflakeProfiler(\n238:                 config, self.report, self.profiling_state_handler\n239:             )\n240: \n241:         self.add_config_to_report()\n242: \n243:     @classmethod\n244:     def create(cls, config_dict: dict, ctx: PipelineContext) -> \"Source\":\n245:         config = SnowflakeV2Config.parse_obj(config_dict)\n246:         return cls(ctx, config)\n247: \n248:     @staticmethod\n249:     def test_connection(config_dict: dict) -> TestConnectionReport:\n250:         test_report = TestConnectionReport()\n251: \n252:         try:\n253:             connection_conf = SnowflakeConnectionConfig.parse_obj_allow_extras(\n254:                 config_dict\n255:             )\n256: \n257:             connection: SnowflakeConnection = connection_conf.get_connection()\n258:             assert connection\n259: \n260:             test_report.basic_connectivity = CapabilityReport(capable=True)\n261: \n262:             test_report.capability_report = SnowflakeV2Source.check_capabilities(\n263:                 connection, connection_conf\n264:             )\n265:             connection.close()\n266: \n267:         except Exception as e:\n268:             logger.error(f\"Failed to test connection due to {e}\", exc_info=e)\n269:             if test_report.basic_connectivity is None:\n270:                 test_report.basic_connectivity = CapabilityReport(\n271:                     capable=False, failure_reason=f\"{e}\"\n272:                 )\n273:             else:\n274:                 test_report.internal_failure = True\n275:                 test_report.internal_failure_reason = f\"{e}\"\n276: \n277:         return test_report\n278: \n279:     @staticmethod\n280:     def check_capabilities(\n281:         conn: SnowflakeConnection, connection_conf: SnowflakeConnectionConfig\n282:     ) -> Dict[Union[SourceCapability, str], CapabilityReport]:\n283:         # Currently only overall capabilities are reported.\n284:         # Resource level variations in capabilities are not considered.\n285: \n286:         @dataclass\n287:         class SnowflakePrivilege:\n288:             privilege: str\n289:             object_name: str\n290:             object_type: str\n291: \n292:         _report: Dict[Union[SourceCapability, str], CapabilityReport] = dict()\n293:         privileges: List[SnowflakePrivilege] = []\n294:         capabilities: List[SourceCapability] = [c.capability for c in SnowflakeV2Source.get_capabilities() if c.capability not in (SourceCapability.PLATFORM_INSTANCE, SourceCapability.DOMAINS, SourceCapability.DELETION_DETECTION)]  # type: ignore\n295: \n296:         cur = conn.query(\"select current_role()\")\n297:         current_role = [row[\"CURRENT_ROLE()\"] for row in cur][0]\n298: \n299:         cur = conn.query(\"select current_secondary_roles()\")\n300:         secondary_roles_str = json.loads(\n301:             [row[\"CURRENT_SECONDARY_ROLES()\"] for row in cur][0]\n302:         )[\"roles\"]\n303:         secondary_roles = (\n304:             [] if secondary_roles_str == \"\" else secondary_roles_str.split(\",\")\n305:         )\n306: \n307:         roles = [current_role] + secondary_roles\n308: \n309:         # PUBLIC role is automatically granted to every role\n310:         if \"PUBLIC\" not in roles:\n311:             roles.append(\"PUBLIC\")\n312:         i = 0\n313: \n314:         while i < len(roles):\n315:             role = roles[i]\n316:             i = i + 1\n317:             # for some roles, quoting is necessary. for example test-role\n318:             cur = conn.query(f'show grants to role \"{role}\"')\n319:             for row in cur:\n320:                 privilege = SnowflakePrivilege(\n321:                     privilege=row[\"privilege\"],\n322:                     object_type=row[\"granted_on\"],\n323:                     object_name=row[\"name\"],\n324:                 )\n325:                 privileges.append(privilege)\n326: \n327:                 if privilege.object_type in (\n328:                     \"DATABASE\",\n329:                     \"SCHEMA\",\n330:                 ) and privilege.privilege in (\"OWNERSHIP\", \"USAGE\"):\n331:                     _report[SourceCapability.CONTAINERS] = CapabilityReport(\n332:                         capable=True\n333:                     )\n334:                     _report[SourceCapability.TAGS] = CapabilityReport(capable=True)\n335:                 elif privilege.object_type in (\n336:                     \"TABLE\",\n337:                     \"VIEW\",\n338:                     \"MATERIALIZED_VIEW\",\n339:                 ):\n340:                     _report[SourceCapability.SCHEMA_METADATA] = CapabilityReport(\n341:                         capable=True\n342:                     )\n343:                     _report[SourceCapability.DESCRIPTIONS] = CapabilityReport(\n344:                         capable=True\n345:                     )\n346: \n347:                     # Table level profiling is supported without SELECT access\n348:                     # if privilege.privilege in (\"SELECT\", \"OWNERSHIP\"):\n349:                     _report[SourceCapability.DATA_PROFILING] = CapabilityReport(\n350:                         capable=True\n351:                     )\n352:                     _report[SourceCapability.CLASSIFICATION] = CapabilityReport(\n353:                         capable=True\n354:                     )\n355: \n356:                     if privilege.object_name.startswith(\"SNOWFLAKE.ACCOUNT_USAGE.\"):\n357:                         # if access to \"snowflake\" shared database, access to all account_usage views is automatically granted\n358:                         # Finer access control is not yet supported for shares\n359:                         # https://community.snowflake.com/s/article/Error-Granting-individual-privileges-on-imported-database-is-not-allowed-Use-GRANT-IMPORTED-PRIVILEGES-instead\n360:                         _report[SourceCapability.LINEAGE_COARSE] = CapabilityReport(\n361:                             capable=True\n362:                         )\n363: \n364:                         _report[SourceCapability.LINEAGE_FINE] = CapabilityReport(\n365:                             capable=True\n366:                         )\n367: \n368:                         _report[SourceCapability.USAGE_STATS] = CapabilityReport(\n369:                             capable=True\n370:                         )\n371:                         _report[SourceCapability.TAGS] = CapabilityReport(capable=True)\n372: \n373:                 # If all capabilities supported, no need to continue\n374:                 if set(capabilities) == set(_report.keys()):\n375:                     break\n376: \n377:                 # Due to this, entire role hierarchy is considered\n378:                 if (\n379:                     privilege.object_type == \"ROLE\"\n380:                     and privilege.privilege == \"USAGE\"\n381:                     and privilege.object_name not in roles\n382:                 ):\n383:                     roles.append(privilege.object_name)\n384: \n385:         cur = conn.query(\"select current_warehouse()\")\n386:         current_warehouse = [row[\"CURRENT_WAREHOUSE()\"] for row in cur][0]\n387: \n388:         default_failure_messages = {\n389:             SourceCapability.SCHEMA_METADATA: \"Either no tables exist or current role does not have permissions to access them\",\n390:             SourceCapability.DESCRIPTIONS: \"Either no tables exist or current role does not have permissions to access them\",\n391:             SourceCapability.DATA_PROFILING: \"Either no tables exist or current role does not have permissions to access them\",\n392:             SourceCapability.CLASSIFICATION: \"Either no tables exist or current role does not have permissions to access them\",\n393:             SourceCapability.CONTAINERS: \"Current role does not have permissions to use any database\",\n394:             SourceCapability.LINEAGE_COARSE: \"Current role does not have permissions to snowflake account usage views\",\n395:             SourceCapability.LINEAGE_FINE: \"Current role does not have permissions to snowflake account usage views\",\n396:             SourceCapability.USAGE_STATS: \"Current role does not have permissions to snowflake account usage views\",\n397:             SourceCapability.TAGS: \"Either no tags have been applied to objects, or the current role does not have permission to access the objects or to snowflake account usage views \",\n398:         }\n399: \n400:         for c in capabilities:  # type:ignore\n401:             # These capabilities do not work without active warehouse\n402:             if current_warehouse is None and c in (\n403:                 SourceCapability.SCHEMA_METADATA,\n404:                 SourceCapability.DESCRIPTIONS,\n405:                 SourceCapability.DATA_PROFILING,\n406:                 SourceCapability.CLASSIFICATION,\n407:                 SourceCapability.LINEAGE_COARSE,\n408:                 SourceCapability.LINEAGE_FINE,\n409:                 SourceCapability.USAGE_STATS,\n410:                 SourceCapability.TAGS,\n411:             ):\n412:                 failure_message = (\n413:                     f\"Current role {current_role} does not have permissions to use warehouse {connection_conf.warehouse}. Please check the grants associated with this role.\"\n414:                     if connection_conf.warehouse is not None\n415:                     else \"No default warehouse set for user. Either set default warehouse for user or configure warehouse in recipe\"\n416:                 )\n417:                 _report[c] = CapabilityReport(\n418:                     capable=False,\n419:                     failure_reason=failure_message,\n420:                 )\n421: \n422:             if c in _report.keys():\n423:                 continue\n424: \n425:             # If some capabilities are missing, then mark them as not capable\n426:             _report[c] = CapabilityReport(\n427:                 capable=False,\n428:                 failure_reason=default_failure_messages[c],\n429:             )\n430: \n431:         return _report\n432: \n433:     def get_workunit_processors(self) -> List[Optional[MetadataWorkUnitProcessor]]:\n434:         return [\n435:             *super().get_workunit_processors(),\n436:             functools.partial(\n437:                 auto_incremental_lineage, self.config.incremental_lineage\n438:             ),\n439:             StaleEntityRemovalHandler.create(\n440:                 self, self.config, self.ctx\n441:             ).workunit_processor,\n442:         ]\n443: \n444:     def get_workunits_internal(self) -> Iterable[MetadataWorkUnit]:\n445:         self._snowflake_clear_ocsp_cache()\n446: \n447:         self.connection = self.config.get_connection()\n448:         if self.connection is None:\n449:             return\n450: \n451:         self.inspect_session_metadata(self.connection)\n452: \n453:         snowsight_url_builder = None\n454:         if self.config.include_external_url:\n455:             snowsight_url_builder = self.get_snowsight_url_builder()\n456: \n457:         if self.report.default_warehouse is None:\n458:             self.report_warehouse_failure()\n459:             return\n460: \n461:         schema_extractor = SnowflakeSchemaGenerator(\n462:             config=self.config,\n463:             report=self.report,\n464:             connection=self.connection,\n465:             domain_registry=self.domain_registry,\n466:             profiler=self.profiler,\n467:             aggregator=self.aggregator,\n468:             snowsight_url_builder=snowsight_url_builder,\n469:             filters=self.filters,\n470:             identifiers=self.identifiers,\n471:         )\n472: \n473:         self.report.set_ingestion_stage(\"*\", METADATA_EXTRACTION)\n474:         yield from schema_extractor.get_workunits_internal()\n475: \n476:         databases = schema_extractor.databases\n477: \n478:         # TODO: The checkpoint state for stale entity detection can be committed here.\n479: \n480:         if self.config.shares:\n481:             yield from SnowflakeSharesHandler(\n482:                 self.config, self.report\n483:             ).get_shares_workunits(databases)\n484: \n485:         discovered_tables: List[str] = [\n486:             self.identifiers.get_dataset_identifier(table_name, schema.name, db.name)\n487:             for db in databases\n488:             for schema in db.schemas\n489:             for table_name in schema.tables\n490:         ]\n491:         discovered_views: List[str] = [\n492:             self.identifiers.get_dataset_identifier(table_name, schema.name, db.name)\n493:             for db in databases\n494:             for schema in db.schemas\n495:             for table_name in schema.views\n496:         ]\n497: \n498:         if len(discovered_tables) == 0 and len(discovered_views) == 0:\n499:             self.structured_reporter.failure(\n500:                 GENERIC_PERMISSION_ERROR_KEY,\n501:                 \"No tables/views found. Please check permissions.\",\n502:             )\n503:             return\n504: \n505:         discovered_datasets = discovered_tables + discovered_views\n506: \n507:         if self.config.use_queries_v2:\n508:             self.report.set_ingestion_stage(\"*\", \"View Parsing\")\n509:             assert self.aggregator is not None\n510:             yield from auto_workunit(self.aggregator.gen_metadata())\n511: \n512:             self.report.set_ingestion_stage(\"*\", QUERIES_EXTRACTION)\n513: \n514:             schema_resolver = self.aggregator._schema_resolver\n515: \n516:             queries_extractor = SnowflakeQueriesExtractor(\n517:                 connection=self.connection,\n518:                 config=SnowflakeQueriesExtractorConfig(\n519:                     window=self.config,\n520:                     temporary_tables_pattern=self.config.temporary_tables_pattern,\n521:                     include_lineage=self.config.include_table_lineage,\n522:                     include_usage_statistics=self.config.include_usage_stats,\n523:                     include_operations=self.config.include_operational_stats,\n524:                 ),\n525:                 structured_report=self.report,\n526:                 filters=self.filters,\n527:                 identifiers=self.identifiers,\n528:                 schema_resolver=schema_resolver,\n529:                 discovered_tables=discovered_datasets,\n530:             )\n531: \n532:             # TODO: This is slightly suboptimal because we create two SqlParsingAggregator instances with different configs\n533:             # but a shared schema resolver. That's fine for now though - once we remove the old lineage/usage extractors,\n534:             # it should be pretty straightforward to refactor this and only initialize the aggregator once.\n535:             self.report.queries_extractor = queries_extractor.report\n536:             yield from queries_extractor.get_workunits_internal()\n537: \n538:         else:\n539:             if self.config.include_table_lineage and self.lineage_extractor:\n540:                 self.report.set_ingestion_stage(\"*\", LINEAGE_EXTRACTION)\n541:                 yield from self.lineage_extractor.get_workunits(\n542:                     discovered_tables=discovered_tables,\n543:                     discovered_views=discovered_views,\n544:                 )\n545: \n546:             if (\n547:                 self.config.include_usage_stats or self.config.include_operational_stats\n548:             ) and self.usage_extractor:\n549:                 yield from self.usage_extractor.get_usage_workunits(discovered_datasets)\n550: \n551:         if self.config.include_assertion_results:\n552:             yield from SnowflakeAssertionsHandler(\n553:                 self.config, self.report, self.connection, self.identifiers\n554:             ).get_assertion_workunits(discovered_datasets)\n555: \n556:         self.connection.close()\n557: \n558:     def report_warehouse_failure(self) -> None:\n559:         if self.config.warehouse is not None:\n560:             self.structured_reporter.failure(\n561:                 GENERIC_PERMISSION_ERROR_KEY,\n562:                 f\"Current role does not have permissions to use warehouse {self.config.warehouse}. Please update permissions.\",\n563:             )\n564:         else:\n565:             self.structured_reporter.failure(\n566:                 \"Could not use a Snowflake warehouse\",\n567:                 \"No default warehouse set for user. Either set a default warehouse for the user or configure a warehouse in the recipe.\",\n568:             )\n569: \n570:     def get_report(self) -> SourceReport:\n571:         return self.report\n572: \n573:     def add_config_to_report(self) -> None:\n574:         self.report.cleaned_account_id = self.config.get_account()\n575:         self.report.ignore_start_time_lineage = self.config.ignore_start_time_lineage\n576:         self.report.upstream_lineage_in_report = self.config.upstream_lineage_in_report\n577:         self.report.include_technical_schema = self.config.include_technical_schema\n578:         self.report.include_usage_stats = self.config.include_usage_stats\n579:         self.report.include_operational_stats = self.config.include_operational_stats\n580:         self.report.incl