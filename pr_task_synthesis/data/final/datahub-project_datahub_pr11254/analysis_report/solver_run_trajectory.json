ering_key = None\")\nprint(f\"  Output: customProperties = {result2}\")\nassert result2 == {}, \"FAILED!\"\n\n# Test 3: View (should never have clustering key)\nview1 = SnowflakeView(\"VIEW_1\")\nresult3 = get_custom_properties(view1)\nprint(f\"\\n✓ Test 3 - View:\")\nprint(f\"  Input: View object (no clustering_key attribute)\")\nprint(f\"  Output: customProperties = {result3}\")\nassert result3 == {}, \"FAILED!\"\n\n# Test 4: Table with different clustering key format\ntable3 = SnowflakeTable(\"TABLE_3\", \"LINEAR(COL_1, COL_2)\")\nresult4 = get_custom_properties(table3)\nprint(f\"\\n✓ Test 4 - Table with complex clustering key:\")\nprint(f\"  Input: clustering_key = 'LINEAR(COL_1, COL_2)'\")\nprint(f\"  Output: customProperties = {result4}\")\nassert result4 == {\"CLUSTERING_KEY\": \"LINEAR(COL_1, COL_2)\"}, \"FAILED!\"\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"All tests passed! ✓\")\nprint(\"=\" * 70)\nprint(\"\\nImplementation correctly:\")\nprint(\"  • Adds CLUSTERING_KEY to customProperties for tables with non-null values\")\nprint(\"  • Keeps customProperties empty for tables with null clustering_key\")\nprint(\"  • Never adds CLUSTERING_KEY to views\")\nprint(\"  • Preserves the exact string value from the query\")\nEOF\npython3 /tmp/verify_clustering_key.py\n",
