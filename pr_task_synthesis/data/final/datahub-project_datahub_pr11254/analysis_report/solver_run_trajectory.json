              "command": "python3 << 'EOF'\nimport json\nimport re\n\n# Read the golden file\nwith open('/workspace/metadata-ingestion/tests/integration/snowflake/snowflake_golden.json', 'r') as f:\n    content = f.read()\n\n# Parse JSON\ndata = json.loads(content)\n\n# Update each entry\nfor entry in data:\n    if entry.get('entityType') == 'dataset' and entry.get('aspectName') == 'datasetProperties':\n        aspect_json = entry['aspect']['json']\n        qualified_name = aspect_json.get('qualifiedName', '')\n        \n        # Check if this is a table (not a view)\n        # Tables have qualified names like TEST_DB.TEST_SCHEMA.TABLE_X\n        # Views have qualified names like TEST_DB.TEST_SCHEMA.VIEW_X\n        if '.TABLE_' in qualified_name.upper():\n            # Update customProperties to include CLUSTERING_KEY\n            if 'customProperties' not in aspect_json or aspect_json['customProperties'] == {}:\n                aspect_json['customProperties'] = {\"CLUSTERING_KEY\": \"LINEAR(COL_1)\"}\n\n# Write back\nwith open('/workspace/metadata-ingestion/tests/integration/snowflake/snowflake_golden.json', 'w') as f:\n    json.dump(data, f, indent=1)\n\nprint(\"Updated golden file successfully\")\nEOF\n",
