owflakeTag,\n49:     SnowflakeView,\n50: )\n51: from datahub.ingestion.source.snowflake.snowflake_tag import SnowflakeTagExtractor\n52: from datahub.ingestion.source.snowflake.snowflake_utils import (\n53:     SnowflakeFilter,\n54:     SnowflakeIdentifierBuilder,\n55:     SnowflakeStructuredReportMixin,\n56:     SnowsightUrlBuilder,\n57: )\n58: from datahub.ingestion.source.sql.sql_utils import (\n59:     add_table_to_schema_container,\n60:     gen_database_container,\n61:     gen_database_key,\n62:     gen_schema_container,\n63:     gen_schema_key,\n64:     get_dataplatform_instance_aspect,\n65:     get_domain_wu,\n66: )\n67: from datahub.ingestion.source_report.ingestion_stage import (\n68:     METADATA_EXTRACTION,\n69:     PROFILING,\n70: )\n71: from datahub.metadata.com.linkedin.pegasus2avro.common import (\n72:     GlobalTags,\n73:     Status,\n74:     SubTypes,\n75:     TagAssociation,\n76:     TimeStamp,\n77: )\n78: from datahub.metadata.com.linkedin.pegasus2avro.dataset import (\n79:     DatasetProperties,\n80:     ViewProperties,\n81: )\n82: from datahub.metadata.com.linkedin.pegasus2avro.schema import (\n83:     ArrayType,\n84:     BooleanType,\n85:     BytesType,\n86:     DateType,\n87:     ForeignKeyConstraint,\n88:     MySqlDDL,\n89:     NullType,\n90:     NumberType,\n91:     RecordType,\n92:     SchemaField,\n93:     SchemaFieldDataType,\n94:     SchemaMetadata,\n95:     StringType,\n96:     TimeType,\n97: )\n98: from datahub.metadata.com.linkedin.pegasus2avro.tag import TagProperties\n99: from datahub.sql_parsing.sql_parsing_aggregator import SqlParsingAggregator\n100: from datahub.utilities.registries.domain_registry import DomainRegistry\n101: from datahub.utilities.threaded_iterator_executor import ThreadedIteratorExecutor\n102: \n103: logger = logging.getLogger(__name__)\n104: \n105: # https://docs.snowflake.com/en/sql-reference/intro-summary-data-types.html\n106: SNOWFLAKE_FIELD_TYPE_MAPPINGS = {\n107:     \"DATE\": DateType,\n108:     \"BIGINT\": NumberType,\n109:     \"BINARY\": BytesType,\n110:     # 'BIT': BIT,\n111:     \"BOOLEAN\": BooleanType,\n112:     \"CHAR\": NullType,\n113:     \"CHARACTER\": NullType,\n114:     \"DATETIME\": TimeType,\n115:     \"DEC\": NumberType,\n116:     \"DECIMAL\": NumberType,\n117:     \"DOUBLE\": NumberType,\n118:     \"FIXED\": NumberType,\n119:     \"FLOAT\": NumberType,\n120:     \"INT\": NumberType,\n121:     \"INTEGER\": NumberType,\n122:     \"NUMBER\": NumberType,\n123:     # 'OBJECT': ?\n124:     \"REAL\": NumberType,\n125:     \"BYTEINT\": NumberType,\n126:     \"SMALLINT\": NumberType,\n127:     \"STRING\": StringType,\n128:     \"TEXT\": StringType,\n129:     \"TIME\": TimeType,\n130:     \"TIMESTAMP\": TimeType,\n131:     \"TIMESTAMP_TZ\": TimeType,\n132:     \"TIMESTAMP_LTZ\": TimeType,\n133:     \"TIMESTAMP_NTZ\": TimeType,\n134:     \"TINYINT\": NumberType,\n135:     \"VARBINARY\": BytesType,\n136:     \"VARCHAR\": StringType,\n137:     \"VARIANT\": RecordType,\n138:     \"OBJECT\": NullType,\n139:     \"ARRAY\": ArrayType,\n140:     \"GEOGRAPHY\": NullType,\n141: }\n142: \n143: \n144: class SnowflakeSchemaGenerator(SnowflakeStructuredReportMixin):\n145:     platform = \"snowflake\"\n146: \n147:     def __init__(\n148:         self,\n149:         config: SnowflakeV2Config,\n150:         report: SnowflakeV2Report,\n151:         connection: SnowflakeConnection,\n152:         filters: SnowflakeFilter,\n153:         identifiers: SnowflakeIdentifierBuilder,\n154:         domain_registry: Optional[DomainRegistry],\n155:         profiler: Optional[SnowflakeProfiler],\n156:         aggregator: Optional[SqlParsingAggregator],\n157:         snowsight_url_builder: Optional[SnowsightUrlBuilder],\n158:     ) -> None:\n159:         self.config: SnowflakeV2Config = config\n160:         self.report: SnowflakeV2Report = report\n161:         self.connection: SnowflakeConnection = connection\n162:         self.filters: SnowflakeFilter = filters\n163:         self.identifiers: SnowflakeIdentifierBuilder = identifiers\n164: \n165:         self.data_dictionary: SnowflakeDataDictionary = SnowflakeDataDictionary(\n166:             connection=self.connection\n167:         )\n168:         self.report.data_dictionary_cache = self.data_dictionary\n169: \n170:         self.domain_registry: Optional[DomainRegistry] = domain_registry\n171:         self.classification_handler = ClassificationHandler(self.config, self.report)\n172:         self.tag_extractor = SnowflakeTagExtractor(\n173:             config, self.data_dictionary, self.report\n174:         )\n175:         self.profiler: Optional[SnowflakeProfiler] = profiler\n176:         self.snowsight_url_builder: Optional[\n177:             SnowsightUrlBuilder\n178:         ] = snowsight_url_builder\n179: \n180:         # These are populated as side-effects of get_workunits_internal.\n181:         self.databases: List[SnowflakeDatabase] = []\n182:         self.aggregator: Optional[SqlParsingAggregator] = aggregator\n183: \n184:     def get_connection(self) -> SnowflakeConnection:\n185:         return self.connection\n186: \n187:     @property\n188:     def structured_reporter(self) -> SourceReport:\n189:         return self.report\n190: \n191:     def gen_dataset_urn(self, dataset_identifier: str) -> str:\n192:         return self.identifiers.gen_dataset_urn(dataset_identifier)\n193: \n194:     def snowflake_identifier(self, identifier: str) -> str:\n195:         return self.identifiers.snowflake_identifier(identifier)\n196: \n197:     def get_workunits_internal(self) -> Iterable[MetadataWorkUnit]:\n198:         self.databases = []\n199:         for database in self.get_databases() or []:\n200:             self.report.report_entity_scanned(database.name, \"database\")\n201:             if not self.filters.filter_config.database_pattern.allowed(database.name):\n202:                 self.report.report_dropped(f\"{database.name}.*\")\n203:             else:\n204:                 self.databases.append(database)\n205: \n206:         if len(self.databases) == 0:\n207:             return\n208: \n209:         try:\n210:             for snowflake_db in self.databases:\n211:                 self.report.set_ingestion_stage(snowflake_db.name, METADATA_EXTRACTION)\n212:                 yield from self._process_database(snowflake_db)\n213: \n214:         except SnowflakePermissionError as e:\n215:             self.structured_reporter.failure(\n216:                 GENERIC_PERMISSION_ERROR_KEY,\n217:                 exc=e,\n218:             )\n219:             return\n220: \n221:     def get_databases(self) -> Optional[List[SnowflakeDatabase]]:\n222:         try:\n223:             # `show databases` is required only to get one  of the databases\n224:             # whose information_schema can be queried to start with.\n225:             databases = self.data_dictionary.show_databases()\n226:         except Exception as e:\n227:             self.structured_reporter.failure(\n228:                 \"Failed to list databases\",\n229:                 exc=e,\n230:             )\n231:             return None\n232:         else:\n233:             ischema_databases: List[\n234:                 SnowflakeDatabase\n235:             ] = self.get_databases_from_ischema(databases)\n236: \n237:             if len(ischema_databases) == 0:\n238:                 self.structured_reporter.failure(\n239:                     GENERIC_PERMISSION_ERROR_KEY,\n240:                     \"No databases found. Please check permissions.\",\n241:                 )\n242:             return ischema_databases\n243: \n244:     def get_databases_from_ischema(\n245:         self, databases: List[SnowflakeDatabase]\n246:     ) -> List[SnowflakeDatabase]:\n247:         ischema_databases: List[SnowflakeDatabase] = []\n248:         for database in databases:\n249:             try:\n250:                 ischema_databases = self.data_dictionary.get_databases(database.name)\n251:                 break\n252:             except Exception:\n253:                 # query fails if \"USAGE\" access is not granted for database\n254:                 # This is okay, because `show databases` query lists all databases irrespective of permission,\n255:                 # if role has `MANAGE GRANTS` privilege. (not advisable)\n256:                 logger.debug(\n257:                     f\"Failed to list databases {database.name} information_schema\"\n258:                 )\n259:                 # SNOWFLAKE database always shows up even if permissions are missing\n260:                 if database == SNOWFLAKE_DATABASE:\n261:                     continue\n262:                 logger.info(\n263:                     f\"The role {self.report.role} has `MANAGE GRANTS` privilege. This is not advisable and also not required.\"\n264:                 )\n265: \n266:         return ischema_databases\n267: \n268:     def _process_database(\n269:         self, snowflake_db: SnowflakeDatabase\n270:     ) -> Iterable[MetadataWorkUnit]:\n271:         db_name = snowflake_db.name\n272: \n273:         try:\n274:             pass\n275:             # self.query(SnowflakeQuery.use_database(db_name))\n276:         except Exception as e:\n277:             if isinstance(e, SnowflakePermissionError):\n278:                 # This may happen if REFERENCE_USAGE permissions are set\n279:                 # We can not run show queries on database in such case.\n280:                 # This need not be a failure case.\n281:                 self.structured_reporter.warning(\n282:                     \"Insufficient privileges to operate on database, skipping. Please grant USAGE permissions on database to extract its metadata.\",\n283:                     db_name,\n284:                 )\n285:             else:\n286:                 logger.debug(\n287:                     f\"Failed to use database {db_name} due to error {e}\",\n288:                     exc_info=e,\n289:                 )\n290:                 self.structured_reporter.warning(\n291:                     \"Failed to get schemas for database\", db_name, exc=e\n292:                 )\n293:             return\n294: \n295:         if self.config.extract_tags != TagOption.skip:\n296:             snowflake_db.tags = self.tag_extractor.get_tags_on_object(\n297:                 domain=\"database\", db_name=db_name\n298:             )\n299: \n300:         if self.config.include_technical_schema:\n301:             yield from self.gen_database_containers(snowflake_db)\n302: \n303:         self.fetch_schemas_for_database(snowflake_db, db_name)\n304: \n305:         if self.config.include_technical_schema and snowflake_db.tags:\n306:             for tag in snowflake_db.tags:\n307:                 yield from self._process_tag(tag)\n308: \n309:         # Caches tables for a single database. Consider moving to disk or S3 when possible.\n310:         db_tables: Dict[str, List[SnowflakeTable]] = {}\n311:         yield from self._process_db_schemas(snowflake_db, db_tables)\n312: \n313:         if self.profiler and db_tables:\n314:             self.report.set_ingestion_stage(snowflake_db.name, PROFILING)\n315:             yield from self.profiler.get_workunits(snowflake_db, db_tables)\n316: \n317:     def _process_db_schemas(\n318:         self,\n319:         snowflake_db: SnowflakeDatabase,\n320:         db_tables: Dict[str, List[SnowflakeTable]],\n321:     ) -> Iterable[MetadataWorkUnit]:\n322:         def _process_schema_worker(\n323:             snowflake_schema: SnowflakeSchema,\n324:         ) -> Iterable[MetadataWorkUnit]:\n325:             for wu in self._process_schema(\n326:                 snowflake_schema, snowflake_db.name, db_tables\n327:             ):\n328:                 yield wu\n329: \n330:         for wu in ThreadedIteratorExecutor.process(\n331:             worker_func=_process_schema_worker,\n332:             args_list=[\n333:                 (snowflake_schema,) for snowflake_schema in snowflake_db.schemas\n334:             ],\n335:             max_workers=SCHEMA_PARALLELISM,\n336:         ):\n337:             yield wu\n338: \n339:     def fetch_schemas_for_database(\n340:         self, snowflake_db: SnowflakeDatabase, db_name: str\n341:     ) -> None:\n342:         schemas: List[SnowflakeSchema] = []\n343:         try:\n344:             for schema in self.data_dictionary.get_schemas_for_database(db_name):\n345:                 self.report.report_entity_scanned(schema.name, \"schema\")\n346:                 if not is_schema_allowed(\n347:                     self.filters.filter_config.schema_pattern,\n348:                     schema.name,\n349:                     db_name,\n350:                     self.filters.filter_config.match_fully_qualified_names,\n351:                 ):\n352:                     self.report.report_dropped(f\"{db_name}.{schema.name}.*\")\n353:                 else:\n354:                     schemas.append(schema)\n355:         except Exception as e:\n356:             if isinstance(e, SnowflakePermissionError):\n357:                 error_msg = f\"Failed to get schemas for database {db_name}. Please check permissions.\"\n358:                 # Ideal implementation would use PEP 678 – Enriching Exceptions with Notes\n359:                 raise SnowflakePermissionError(error_msg) from e.__cause__\n360:             else:\n361:                 self.structured_reporter.warning(\n362:                     \"Failed to get schemas for database\",\n363:                     db_name,\n364:                     exc=e,\n365:                 )\n366: \n367:         if not schemas:\n368:             self.structured_reporter.warning(\n369:                 \"No schemas found in database. If schemas exist, please grant USAGE permissions on them.\",\n370:                 db_name,\n371:             )\n372:         else:\n373:             snowflake_db.schemas = schemas\n374: \n375:     def _process_schema(\n376:         self,\n377:         snowflake_schema: SnowflakeSchema,\n378:         db_name: str,\n379:         db_tables: Dict[str, List[SnowflakeTable]],\n380:     ) -> Iterable[MetadataWorkUnit]:\n381:         schema_name = snowflake_schema.name\n382: \n383:         if self.config.extract_tags != TagOption.skip:\n384:             snowflake_schema.tags = self.tag_extractor.get_tags_on_object(\n385:                 schema_name=schema_name, db_name=db_name, domain=\"schema\"\n386:             )\n387: \n388:         if self.config.include_technical_schema:\n389:             yield from self.gen_schema_containers(snowflake_schema, db_name)\n390: \n391:         # We need to do this first so that we can use it when fetching columns.\n392:         if self.config.include_tables:\n393:             tables = self.fetch_tables_for_schema(\n394:                 snowflake_schema, db_name, schema_name\n395:             )\n396:         if self.config.include_views:\n397:             views = self.fetch_views_for_schema(snowflake_schema, db_name, schema_name)\n398: \n399:         if self.config.include_tables:\n400:             db_tables[schema_name] = tables\n401: \n402:             if self.config.include_technical_schema:\n403:                 data_reader = self.make_data_reader()\n404:                 for table in tables:\n405:                     table_wu_generator = self._process_table(\n406:                         table, snowflake_schema, db_name\n407:                     )\n408: \n409:                     yield from classification_workunit_processor(\n410:                         table_wu_generator,\n411:                         self.classification_handler,\n412:                         data_reader,\n413:                         [db_name, schema_name, table.name],\n414:                     )\n415: \n416:         if self.config.include_views:\n417:             if (\n418:                 self.aggregator\n419:                 and self.config.include_view_lineage\n420:                 and self.config.parse_view_ddl\n421:             ):\n422:                 for view in views:\n423:                     view_identifier = self.identifiers.get_dataset_identifier(\n424:                         view.name, schema_name, db_name\n425:                     )\n426:                     if view.view_definition:\n427:                         self.aggregator.add_view_definition(\n428:                             view_urn=self.identifiers.gen_dataset_urn(view_identifier),\n429:                             view_definition=view.view_definition,\n430:                             default_db=db_name,\n431:                             default_schema=schema_name,\n432:                         )\n433: \n434:             if self.config.include_technical_schema:\n435:                 for view in views:\n436:                     yield from self._process_view(view, snowflake_schema, db_name)\n437: \n438:         if self.config.include_technical_schema and snowflake_schema.tags:\n439:             for tag in snowflake_schema.tags:\n440:                 yield from self._process_tag(tag)\n441: \n442:         if not snowflake_schema.views and not snowflake_schema.tables:\n443:             self.structured_reporter.info(\n444:                 title=\"No tables/views found in schema\",\n445:                 message=\"If tables exist, please grant REFERENCES or SELECT permissions on them.\",\n446:                 context=f\"{db_name}.{schema_name}\",\n447:             )\n448: \n449:     def fetch_views_for_schema(\n450:         self, snowflake_schema: SnowflakeSchema, db_name: str, schema_name: str\n451:     ) -> List[SnowflakeView]:\n452:         try:\n453:             views: List[SnowflakeView] = []\n454:             for view in self.get_views_for_schema(schema_name, db_name):\n455:                 view_name = self.identifiers.get_dataset_identifier(\n456:                     view.name, schema_name, db_name\n457:                 )\n458: \n459:                 self.report.report_entity_scanned(view_name, \"view\")\n460: \n461:                 if not self.filters.filter_config.view_pattern.allowed(view_name):\n462:                     self.report.report_dropped(view_name)\n463:                 else:\n464:                     views.append(view)\n465:             snowflake_schema.views = [view.name for view in views]\n466:             return views\n467:         except Exception as e:\n468:             if isinstance(e, SnowflakePermissionError):\n469:                 # Ideal implementation would use PEP 678 – Enriching Exceptions with Notes\n470:                 error_msg = f\"Failed to get views for schema {db_name}.{schema_name}. Please check permissions.\"\n471: \n472:                 raise SnowflakePermissionError(error_msg) from e.__cause__\n473:             else:\n474:                 self.structured_reporter.warning(\n475:                     \"Failed to get views for schema\",\n476:                     f\"{db_name}.{schema_name}\",\n477:                     exc=e,\n478:                 )\n479:                 return []\n480: \n481:     def fetch_tables_for_schema(\n482:         self, snowflake_schema: SnowflakeSchema, db_name: str, schema_name: str\n483:     ) -> List[SnowflakeTable]:\n484:         try:\n485:             tables: List[SnowflakeTable] = []\n486:             for table in self.get_tables_for_schema(schema_name, db_name):\n487:                 table_identifier = self.identifiers.get_dataset_identifier(\n488:                     table.name, schema_name, db_name\n489:                 )\n490:                 self.report.report_entity_scanned(table_identifier)\n491:                 if not self.filters.filter_config.table_pattern.allowed(\n492:                     table_identifier\n493:                 ):\n494:                     self.report.report_dropped(table_identifier)\n495:                 else:\n496:                     tables.append(table)\n497:             snowflake_schema.tables = [table.name for table in tables]\n498:             return tables\n499:         except Exception as e:\n500:             if isinstance(e, SnowflakePermissionError):\n501:                 # Ideal implementation would use PEP 678 – Enriching Exceptions with Notes\n502:                 error_msg = f\"Failed to get tables for schema {db_name}.{schema_name}. Please check permissions.\"\n503:                 raise SnowflakePermissionError(error_msg) from e.__cause__\n504:             else:\n505:                 self.structured_reporter.warning(\n506:                     \"Failed to get tables for schema\",\n507:                     f\"{db_name}.{schema_name}\",\n508:                     exc=e,\n509:                 )\n510:                 return []\n511: \n512:     def make_data_reader(self) -> Optional[SnowflakeDataReader]:\n513:         if self.classification_handler.is_classification_enabled() and self.connection:\n514:             return SnowflakeDataReader.create(\n515:                 self.connection, self.snowflake_identifier\n516:             )\n517: \n518:         return None\n519: \n520:     def _process_table(\n521:         self,\n522:         table: SnowflakeTable,\n523:         snowflake_schema: SnowflakeSchema,\n524:         db_name: str,\n525:     ) -> Iterable[MetadataWorkUnit]:\n526:         schema_name = snowflake_schema.name\n527:         table_identifier = self.identifiers.get_dataset_identifier(\n528:             table.name, schema_name, db_name\n529:         )\n530: \n531:         try:\n532:             table.columns = self.get_columns_for_table(\n533:                 table.name, snowflake_schema, db_name\n534:             )\n535:             table.column_count = len(table.columns)\n536:             if self.config.extract_tags != TagOption.skip:\n537:                 table.column_tags = self.tag_extractor.get_column_tags_for_table(\n538:                     table.name, schema_name, db_name\n539:                 )\n540:         except Exception as e:\n541:             self.structured_reporter.warning(\n542:                 \"Failed to get columns for table\", table_identifier, exc=e\n543:             )\n544: \n545:         if self.config.extract_tags != TagOption.skip:\n546:             table.tags = self.tag_extractor.get_tags_on_object(\n547:                 table_name=table.name,\n548:                 schema_name=schema_name,\n549:                 db_name=db_name,\n550:                 domain=\"table\",\n551:             )\n552: \n553:         if self.config.include_technical_schema:\n554:             if self.config.include_primary_keys:\n555:                 self.fetch_pk_for_table(table, schema_name, db_name, table_identifier)\n556: \n557:             if self.config.include_foreign_keys:\n558:                 self.fetch_foreign_keys_for_table(\n559:                     table, schema_name, db_name, table_identifier\n560:                 )\n561: \n562:             yield from self.gen_dataset_workunits(table, schema_name, db_name)\n563: \n564:     def fetch_foreign_keys_for_table(\n565:         self,\n566:         table: SnowflakeTable,\n567:         schema_name: str,\n568:         db_name: str,\n569:         table_identifier: str,\n570:     ) -> None:\n571:         try:\n572:             table.foreign_keys = self.get_fk_constraints_for_table(\n573:                 table.name, schema_name, db_name\n574:             )\n575:         except Exception as e:\n576:             self.structured_reporter.warning(\n577:                 \"Failed to get foreign keys for table\", table_identifier, exc=e\n578:             )\n579: \n580:     def fetch_pk_for_table(\n581:         self,\n582:         table: SnowflakeTable,\n583:         schema_name: str,\n584:         db_name: str,\n585:         table_identifier: str,\n586:     ) -> None:\n587:         try:\n588:             table.pk = self.get_pk_constraints_for_table(\n589:                 table.name, schema_name, db_name\n590:             )\n591:         except Exception as e:\n592:             self.structured_reporter.warning(\n593:                 \"Failed to get primary key for table\", table_identifier, exc=e\n594:             )\n595: \n596:     def _process_view(\n597:         self,\n598:         view: SnowflakeView,\n599:         snowflake_schema: SnowflakeSchema,\n600:         db_name: str,\n601:     ) -> Iterable[MetadataWorkUnit]:\n602:         schema_name = snowflake_schema.name\n603:         view_name = self.identifiers.get_dataset_identifier(\n604:             view.name, schema_name, db_name\n605:         )\n606: \n607:         try:\n608:             view.columns = self.get_columns_for_table(\n609:                 view.name, snowflake_schema, db_name\n610:             )\n611:             if self.config.extract_tags != TagOption.skip:\n612:                 view.column_tags = self.tag_extractor.get_column_tags_for_table(\n613:                     view.name, schema_name, db_name\n614:                 )\n615:         except Exception as e:\n616:             self.structured_reporter.warning(\n617:                 \"Failed to get columns for view\", view_name, exc=e\n618:             )\n619: \n620:         if self.config.extract_tags != TagOption.skip:\n621:             view.tags = self.tag_extractor.get_tags_on_object(\n622:                 table_name=view.name,\n623:                 schema_name=schema_name,\n624:                 db_name=db_name,\n625:                 domain=\"table\",\n626:             )\n627: \n628:         if self.config.include_technical_schema:\n629:             yield from self.gen_dataset_workunits(view, schema_name, db_name)\n630: \n631:     def _process_tag(self, tag: SnowflakeTag) -> Iterable[MetadataWorkUnit]:\n632:         tag_identifier = tag.identifier()\n633: \n634:         if self.report.is_tag_processed(tag_identifier):\n635:             return\n636: \n637:         self.report.report_tag_processed(tag_identifier)\n638: \n639:         yield from self.gen_tag_workunits(tag)\n640: \n641:     def gen_dataset_workunits(\n642:         self,\n643:         table: Union[SnowflakeTable, SnowflakeView],\n644:         schema_name: str,\n645:         db_name: str,\n646:     ) -> Iterable[MetadataWorkUnit]:\n647:         if table.tags:\n648:             for tag in table.tags:\n649:                 yield from self._process_tag(tag)\n650:         for column_name in table.column_tags:\n651:             for tag in table.column_tags[column_name]:\n652:                 yield from self._process_tag(tag)\n653: \n654:         dataset_name = self.identifiers.get_dataset_identifier(\n655:             table.name, schema_name, db_name\n656:         )\n657:         dataset_urn = self.identifiers.gen_dataset_urn(dataset_name)\n658: \n659:         status = Status(removed=False)\n660:         yield MetadataChangeProposalWrapper(\n661:             entityUrn=dataset_urn, aspect=status\n662:         ).as_workunit()\n663: \n664:         schema_metadata = self.gen_schema_metadata(table, schema_name, db_name)\n665: \n666:         yield MetadataChangeProposalWrapper(\n667:             entityUrn=dataset_urn, aspect=schema_metadata\n668:         ).as_workunit()\n669: \n670:         dataset_properties = self.get_dataset_properties(table, schema_name, db_name)\n671: \n672:         yield MetadataChangeProposalWrapper(\n673:             entityUrn=dataset_urn, aspect=dataset_properties\n674:         ).as_workunit()\n675: \n676:         schema_container_key = gen_schema_key(\n677:             db_name=self.snowflake_identifier(db_name),\n678:             schema=self.snowflake_identifier(schema_name),\n679:             platform=self.platform,\n680:             platform_instance=self.config.platform_instance,\n681:             env=self.config.env,\n682:         )\n683: \n684:         yield from add_table_to_schema_container(\n685:             dataset_urn=dataset_urn,\n686:             parent_container_key=schema_container_key,\n687:         )\n688:         dpi_aspect = get_dataplatform_instance_aspect(\n689:             dataset_urn=dataset_urn,\n690:             platform=self.platform,\n691:             platform_instanc