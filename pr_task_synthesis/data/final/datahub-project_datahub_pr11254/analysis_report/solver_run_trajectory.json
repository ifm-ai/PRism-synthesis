 = {}\n316:         for key, value in row.items():\n317:             if key in json_fields and value:\n318:                 value = json.loads(value)\n319:             key = key.lower()\n320:             res[key] = value\n321: \n322:         direct_objects_accessed = res[\"direct_objects_accessed\"]\n323:         objects_modified = res[\"objects_modified\"]\n324: \n325:         upstreams = []\n326:         column_usage = {}\n327: \n328:         for obj in direct_objects_accessed:\n329:             dataset = self.identifiers.gen_dataset_urn(\n330:                 self.identifiers.get_dataset_identifier_from_qualified_name(\n331:                     obj[\"objectName\"]\n332:                 )\n333:             )\n334: \n335:             columns = set()\n336:             for modified_column in obj[\"columns\"]:\n337:                 columns.add(\n338:                     self.identifiers.snowflake_identifier(modified_column[\"columnName\"])\n339:                 )\n340: \n341:             upstreams.append(dataset)\n342:             column_usage[dataset] = columns\n343: \n344:         downstream = None\n345:         column_lineage = None\n346:         for obj in objects_modified:\n347:             # We don't expect there to be more than one object modified.\n348:             if downstream:\n349:                 self.structured_reporter.report_warning(\n350:                     message=\"Unexpectedly got multiple downstream entities from the Snowflake audit log.\",\n351:                     context=f\"{row}\",\n352:                 )\n353: \n354:             downstream = self.identifiers.gen_dataset_urn(\n355:                 self.identifiers.get_dataset_identifier_from_qualified_name(\n356:                     obj[\"objectName\"]\n357:                 )\n358:             )\n359:             column_lineage = []\n360:             for modified_column in obj[\"columns\"]:\n361:                 column_lineage.append(\n362:                     ColumnLineageInfo(\n363:                         downstream=DownstreamColumnRef(\n364:                             dataset=downstream,\n365:                             column=self.identifiers.snowflake_identifier(\n366:                                 modified_column[\"columnName\"]\n367:                             ),\n368:                         ),\n369:                         upstreams=[\n370:                             ColumnRef(\n371:                                 table=self.identifiers.gen_dataset_urn(\n372:                                     self.identifiers.get_dataset_identifier_from_qualified_name(\n373:                                         upstream[\"objectName\"]\n374:                                     )\n375:                                 ),\n376:                                 column=self.identifiers.snowflake_identifier(\n377:                                     upstream[\"columnName\"]\n378:                                 ),\n379:                             )\n380:                             for upstream in modified_column[\"directSources\"]\n381:                             if upstream[\"objectDomain\"]\n382:                             in SnowflakeQuery.ACCESS_HISTORY_TABLE_VIEW_DOMAINS\n383:                         ],\n384:                     )\n385:                 )\n386: \n387:         # TODO: Fetch email addresses from Snowflake to map user -> email\n388:         # TODO: Support email_domain fallback for generating user urns.\n389:         user = CorpUserUrn(self.identifiers.snowflake_identifier(res[\"user_name\"]))\n390: \n391:         timestamp: datetime = res[\"query_start_time\"]\n392:         timestamp = timestamp.astimezone(timezone.utc)\n393: \n394:         # TODO need to map snowflake query types to ours\n395:         query_type = SNOWFLAKE_QUERY_TYPE_MAPPING.get(\n396:             res[\"query_type\"], QueryType.UNKNOWN\n397:         )\n398: \n399:         entry = PreparsedQuery(\n400:             # Despite having Snowflake's fingerprints available