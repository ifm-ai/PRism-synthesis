              "patch": "Index: test/cti-stix-visualizer.yaml\n===================================================================\n--- test/cti-stix-visualizer.yaml\t\n+++ test/cti-stix-visualizer.yaml\t\n@@ -1,30 +1,44 @@\n apiVersion: apps/v1\n kind: Deployment\n metadata:\n   name: stix-visualizer\n   namespace: redpanda\n spec:\n   replicas: 1\n   selector:\n     matchLabels:\n       app: stix-visualizer\n   template:\n     metadata:\n       labels:\n         app: stix-visualizer\n     spec:\n       containers:\n       - name: stix-visualizer\n         image: ghcr.io/k8sstormcenter/cti-stix-visualizer:0.0.2\n         imagePullPolicy: Always\n         ports:\n         - containerPort: 3000\n         env:\n         - name: PORT\n           value: \"3000\"\n         - name: REDIS_HOST\n           value: \"redis-headless.redpanda.svc.cluster.local\"\n         - name: REDIS_PORT\n           value: \"6379\"\n         - name: REDIS_KEY_PREFIX\n-          value: \"tetrastix\"\n\\ No newline at end of file\n+          value: \"tetrastix\"\n+---\n+apiVersion: v1\n+kind: Service\n+metadata:\n+  name: stix-visualizer\n+  namespace: redpanda\n+spec:\n+  type: ClusterIP\n+  selector:\n+    app: stix-visualizer\n+  ports:\n+  - protocol: TCP\n+    port: 80\n+    targetPort: 3000\n\\ No newline at end of file\n",
              "additions": 15,
