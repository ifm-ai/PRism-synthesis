#  apptainer build --fakeroot sandbox.sif sandbox.def
#
# The sandbox the chain agent works in: opencode, a git new enough for `clone --revision`,
# and a private Python at /.environ that the trajectory export runs under.

Bootstrap: docker
From: node:25-slim

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget git jq ripgrep unzip rsync \
        procps psmisc lsof less vim \
        python3 python3-pip build-essential
    rm -rf /var/lib/apt/lists/*

    # opencode is the coding agent; agent.py drives it one `opencode run` per chain turn.
    npm install -g opencode-ai@1.4.6

    # agent.py ships a small script into the sandbox to turn `opencode export` output into a
    # trajectory, and runs it under this interpreter. It is deliberately separate from any
    # Python the task's repository might install or break, and opencode is denied access to it.
    mkdir -p /.environ
    curl -fsSL -o /tmp/miniconda.sh \
        https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
    bash /tmp/miniconda.sh -b -p /.environ/miniconda
    rm /tmp/miniconda.sh
    . /.environ/miniconda/bin/activate
    conda create -y -n venv python=3.11
    conda activate venv
    pip install --no-cache-dir cloudpickle

    mkdir -p /chains

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH=/usr/local/bin:$PATH

%labels
    Description Sandbox for pr_agent_gen — solving a chain of PRs with opencode
